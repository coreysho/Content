[login,_]
mes("Welcome to Death Plateau.");
cam_reset;

%musicplay = 1; // set to auto on login
if (%option_brightness = 0) {
    // sane defaults for game controls
    %option_brightness = 2;
    %option_music = 2;
    %option_sounds = 2;
    %option_areasounds = 2;
}

if(~wilderness_level(coord) > 0) {
    set_player_op("Attack", 2, ^false);

    if(coordz(coord) >= ^wilderness_starting_underground_z) {
        if_openoverlay(wilderness_underground_overlay);
    } else {
        if_openoverlay(wilderness_overlay);
    }

} else {
    set_player_op(null, 2, ^false);
}

set_player_op(null, 2, ^false);
set_player_op("Follow", 3, ^false);
set_player_op("Trade with", 4, ^false);
set_player_op(null, 5, ^false);

minimap_toggle(0); //reset minimap state on login

// register the soft timer that handles replenishing stats
settimer(stat_regen, 100);
settimer(stat_boost_restore, 100);
// same for health
settimer(health_regen, 100);
// random event timer
settimer(general_macro_events, 500);
// chest macro gas 
~check_chest_macro_gas;

// for logout out during a general macro event, they respawn when you log back in
// queue: 
// - https://youtu.be/T0ulsgorBkY?list=PLn23LiLYLb1Y3P9S9qZbijcJihiD416jT
// - https://youtu.be/HwGAzcmvF9k?list=PLn23LiLYLb1Y3P9S9qZbijcJihiD416jT
// npc spawns only after interface is closed
queue(macro_event_login, 0, 0);
// TODO: Find out if these run on login?
~macro_cube_login;

// The stats tab's hover panels say which skills refuse experience. The client loads the tab's
// text from the cache on login, so a locked skill has to be re-marked; ~xplock_restore returns
// immediately when nothing is locked, which is every account that has not used the feature.
~xplock_restore;
// so pk skulls persist after logging back in
~set_pk_skull_login;
// so antifire persists after logging back in
~set_antifire_login;
// if player is in a duel, they are removed from the duel
~duel_arena_login;
// if player is in a gnomeball game, they login outside of the arena
~gnomeball_login;
~wguild_login;
// logged out inside a house instance that no longer exists -> back to the Rimmington portal
~poh_login;
// two or more 99s: swap any untrimmed skill capes for trimmed ones
~skillcape_login;
// if player is on a trawler ship, they login at port sarim
~trawler_login;
// logging out when posioned would continue to poison you after logging back in in 2006
// https://forum.tip.it/topic/76167-poison-effect-on-f2p/
~set_poison_login;
// update weight-reduction equipment (in the case where you switch from f2p <-> p2p)
~update_weight_equipment;
~ferment_wines_login;
~thieving_stall_timers_login;
~stat_boost_login; // f2p boost reset
~sa_login; // start timer if low sa energy

if(inzone(movecoord(^grandtree_jail_coord, 0, 0, -2), movecoord(^grandtree_jail_coord, 3, 0, 2), coord) = true) {
    ~grandtree_spawn_charlie;
}

if (%tutorial < ^tutorial_complete & ~in_tutorial_island(coord) = true) {
    ~update_bas;
    @start_tutorial;
}

~castlewars_login;
// Replay whatever the player's crops did while they were logged out, then keep them ticking.
~farming_login;
// Anything that happened on the trading post while they were away.
~tp_login;

~initalltabs;
~update_all(inv_getobj(worn, ^wearpos_rhand));
cam_reset;
queue(follower_login, 0, 0);
// Monkey Madness: p_transmogrify is player state and is not saved, but the worn greegree is. Without
// this a player who logged out as a monkey logs back in as a human still holding one, and every
// guard on Ape Atoll reacts to that.
~mm_greegree_login;
// The run toggle: option_run is scope=perm so the SAVED value comes back and lights the orb, but
// the engine's run-mode is player state that is not saved. p_run is to option_run exactly what
// p_transmogrify is to the worn greegree above - without this the orb says "run" while the player
// walks, and the only way out is toggling run off and back on. p_run writes the varp itself, so
// there is deliberately no varp assignment here.
if (%option_run = ^player_run_on) {
    if (runenergy < 100) {
        // mirrors the guard on the run button (player_controls.rs2): no energy, no run
        p_run(^player_run_off);
    } else {
        p_run(^player_run_on);
    }
}
if (map_live = true) {
    if_openfull(inter_353, inter_313);
    // the message of the week, two lines of the scroll under the play button
    if_settext(inter_353:com_1,"Did you know, you can type K or M for thousands or millions");
    if_settext(inter_353:com_2,"whenever you are asked to enter an amount?");
    if_settext(inter_313:com_19, ~bankpin_welcome_text);
    last_login_info;
}


[proc,initalltabs]
~update_weapon_category(inv_getobj(worn, ^wearpos_rhand));
if_settab(stats, ^tab_skills);
if_settab(questlist, ^tab_quest_journal);
~update_questlist;

inv_transmit(inv, inventory:inv);
inv_transmit(worn, wornitems:worn);
// The rune pouch's mirror, for the whole session: it is what lets a spell's client-side greying
// script count a rune that is in the pouch rather than the pack. storage_items/scripts/rune_pouch_ui.rs2
// has the why; nothing ever opens that interface.
~rune_pouch_mirror_start;

if_settab(inventory, ^tab_inventory);
if_settab(wornitems, ^tab_wornitems);

if_settab(prayer, ^tab_prayer);
// restore whichever spellbook the player was last on - normal, Ancient or Lunar. A book borrowed by
// Spellbook Swap is not kept through a logout: that player goes back to Lunar (lunar/lunar_contact.rs2).
if (%spellbook_swapped = true) {
    %spellbook_swapped = false;
    %spellbook = ^spellbook_lunar;
}
~spellbook_tab;
if_settab(friends, ^tab_friends);
if_settab(ignore, ^tab_ignore);
if_settab(clanchat, ^tab_clan_chat);
if_settab(logout, ^tab_logout);
if_settab(emotes, ^tab_emotes);
// 474 gave low detail the same two tabs (its cache has no low-detail versions); music simply does
// not play there. options_ld / music_ld are the 377 ones, no longer sent.
if_settab(options, ^tab_game_options);
if_settab(music, ^tab_musicplayer);
// which of each Options toggle's two tooltips is true (game_options.rs2)
~options_tooltips;
