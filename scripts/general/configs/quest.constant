// matches the final stage value in quests/quest_horror/configs/quest_horror.constant (6 = fully done,
// i.e. a damaged prayer book has been chosen from Jossik). Renumbered from an earlier 10-stage
// version: bridge repair/key/lighting/wall-puzzle sub-steps were pulled out of the linear %horror
// stage into their own independent perm varps (horror_bridges/horror_lighting/horror_wall), since
// they're reachable in any order in-world and a strictly increasing %horror value made an
// out-of-order completion (e.g. visiting Gunnjorn before repairing the bridges) desync the gating
// checks in quest_horror.rs2.
^horror_complete = 6
// Rag and Bone Man. Part one only - three states, see
// quests/quest_rag/configs/quest_rag.constant.
^rag_complete = 2
// The Lost Tribe. 7 is fixed by the cache, not chosen - see
// quests/quest_lost_tribe/configs/quest_lost_tribe.constant.
^lost_tribe_complete = 11
^mdaughter_complete = 90
// Creature of Fenkenstrain. 8 is fixed by the cache - see the quest's own constant file.
^fenk_complete = 8
// Devious Minds. %devious_main is free - nothing switches on it - so it runs in tens.
^devious_complete = 70
// Eadgar's Ruse. Nothing in the cache switches on %eadgar_quest, so the stages are free.
^eadgar_complete = 70
// Spirits of the Elid. 60 is fixed by the Nardah fountain and shrine multilocs - see the quest's
// own constant file for the full list of legal values.
^elid_complete = 60
// Zogre Flesh Eaters. Nothing switches on %zogre, so the stages are free.
^zogre_complete = 16
// Icthlarin's Little Helper. 26 is chosen so the burial party (19-25) clears once it is over;
// Icthlarin himself renders at 24 and nowhere else. See the quest's own constant file.
^icslittle_complete = 26

