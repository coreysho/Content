// Imported from a modern OSRS cache by tools/models/importosrs.py.
// Models are RE-ENCODED from OSRS model format into the 317-family format
// (tools/models/osrs2ob2.py); every one is round-trip verified before writing.
// wearpos/wearpos2/wearpos3 come from the cache - do not hand-edit them.

[arkan_blade]
name=Arkan blade
desc=A powerful sword imbued with the fire of the sun.
model=obj_arkan_blade
manwear=obj_arkan_blade_manwear,0
womanwear=obj_arkan_blade_womanwear,0
wearpos=righthand
2dzoom=1678
2dxan=694
2dyan=2047
2dzan=2047
2dxof=-11
2dyof=0
weight=1814g
cost=250000
members=yes
tradeable=no
iop2=Wield
// OSRS's stats (cache obj 30955): a 4-tick slash sword, 60 Attack. Its special, Flames of Ralos, is
// not implemented yet - it needs a burn effect this build does not have.
category=weapon_slash
param=stabattack,55
param=slashattack,70
param=strengthbonus,64
param=prayerbonus,1
// Flames of Ralos, 30% (skill_combat/scripts/player/specs/scripts/arkan_blade.rs2)
param=specwep,^true
param=sa_energy,300
param=slashattack_anim,human_sword_slash
param=stabattack_anim,human_sword_stab
param=defend_anim,human_sword_def
param=slash_sound,hacksword_slash
param=stab_sound,hacksword_stab

