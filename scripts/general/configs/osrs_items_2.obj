[twinflame_staff]
name=Twinflame staff
desc=A magical staff imbued with the power of ice and fire.
model=obj_twinflame_staff
manwear=obj_twinflame_staff_manwear,0
womanwear=obj_twinflame_staff_womanwear,0
wearpos=righthand
2dzoom=2171
2dxan=424
2dyan=0
2dzan=2047
2dxof=0
2dyof=0
weight=2267g
cost=50000
members=yes
iop2=Wield
iop3=Inspect
// OSRS's stats (cache obj 30634): 60 Magic, 6 ticks, a staff's three crush styles. It is an
// unlimited source of water and fire runes, as in OSRS (magic_staff.dbrow, genstaffruneops.py). Its
// passives - the second, 40% cast a tick later, and +10% on standard spells - are not implemented.
category=weapon_staff
param=stabattack,7
param=slashattack,-1
param=crushattack,28
param=magicattack,12
param=stabdefence,2
param=slashdefence,3
param=crushdefence,1
param=magicdefence,12
param=strengthbonus,22
param=attackrate,6
param=ready_baseanim,human_staffready
param=crushattack_anim,human_stafforb_pummel
param=defend_anim,human_stafforb_block
param=crush_sound,staff_hit
