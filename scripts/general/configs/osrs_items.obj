[magic_secateurs]
name=Magic secateurs
desc=The only way to kill a Tanglefoot.
model=obj_magic_secateurs
manwear=obj_magic_secateurs_manwear,0
womanwear=obj_magic_secateurs_womanwear,0
wearpos=righthand
2dzoom=710
2dxan=312
2dyan=320
2dxof=-1
2dyof=11
recol1s=15855
recol1d=1698
recol2s=10570
recol2d=352
recol3s=5217
recol3d=1602
weight=453g
members=yes
tradeable=no
iop2=Wield
category=weapon_slash
param=slashattack,10
param=strengthbonus,10
// weapon_slash is swung stab and slash, and this had no sound for either - sound_synth takes a
// null and the session ends. The animations were missing too, so it was swung invisibly. Both
// are what the other 33 weapon_slash objs use. rs2check rule 19.
param=stabattack_anim,human_sword_stab
param=slashattack_anim,human_sword_slash
param=stab_sound,hacksword_stab
param=slash_sound,hacksword_slash
// No equip requirement in OSRS.
// NOT IMPLEMENTED: the +10% herb yield when wielded - that is Farming-script work.

[imbued_heart]
name=Imbued heart
desc=This heart holds a magical power within.
model=obj_imbued_heart
wearpos=righthand
2dzoom=1168
2dxan=96
2dyan=1690
2dxof=1
2dyof=-1
weight=350g
cost=500000
members=yes
iop1=Invigorate
// No wearpos in practice - it is an inventory item with an Invigorate option.
// Invigorate is in skill_slayer/scripts/superiors.rs2 (dropped by superior slayer monsters).


// Slayer helmet (i). Same models as the plain helmet - the imbued one looks identical in OSRS.
//
// The DEFENCES are the plain helmet's, unchanged. What the imbue adds to the stat table is
// magicattack +3 and rangeattack +3, and nothing else: the wiki's bonus table for the imbued helm
// is stab/slash/crush +0, magic +3, ranged +3, defences 30/32/27/10/30 - and the plain helmet above
// is already 30/32/27/10/30. So this is the plain helmet plus two attack lines.
//
// The 15% on-task ranged and magic boost is behaviour, not a stat, and lives in
// skill_slayer/scripts/black_mask.rs2 with the two combat paths that read it.
//
// It inherits everything the plain helmet does - the earmuffs, the nose peg, the facemask, the
// melee bonus - because ~slayer_helm_worn and ~black_mask_on_task both know about it, and every
// one of the eight places those are called is unchanged.

[slayer_helm_i]
name=Slayer helmet (i)
// The cache's own examine text for obj 11865, which is the plain helmet's with one word added.
desc=You really don't want to wear it inside-out.
// The imbued helmet is its OWN model in OSRS (obj 11865, model 42702), not the plain one with a
// different name - the eye is grey rather than red. It shipped pointing at the plain helmet's
// models because nothing had looked; the set below was imported with the fourteen colours.
model=obj_slayer_helm_i
manwear=obj_slayer_helm_i_manwear,0
womanwear=obj_slayer_helm_i_womanwear,0
manhead=obj_slayer_helm_i_manhead
womanhead=obj_slayer_helm_i_womanhead
wearpos=hat
wearpos2=head
wearpos3=jaw
2dzoom=779
2dxan=30
2dyan=1773
2dxof=-4
2dyof=-3
weight=2267g
cost=40000
members=yes
tradeable=no
iop2=Wear
iop3=Check
iop4=Disassemble
category=armour_helmet
param=magicattack,3
param=rangeattack,3
param=stabdefence,30
param=slashdefence,32
param=crushdefence,27
param=magicdefence,10
param=rangedefence,30
// Equip gate: 10 Defence, the same tier10 entry the plain helmet uses.
param=slayer_headgear,yes
param=slayer_helmet,yes
param=slayer_imbued,yes
param=imbue_from,slayer_helm
