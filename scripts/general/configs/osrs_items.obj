// Imported from a modern OSRS cache by tools/models/importosrs.py.
// Models are RE-ENCODED from OSRS model format into the 317-family format
// (tools/models/osrs2ob2.py); every one is round-trip verified before writing.
// wearpos/wearpos2/wearpos3 come from the cache - do not hand-edit them.

[slayer_helm]
name=Slayer helmet
desc=You don't want to wear it inside-out.
model=obj_slayer_helm
manwear=obj_slayer_helm_manwear,0
womanwear=obj_slayer_helm_womanwear,0
manhead=obj_slayer_helm_manhead
womanhead=obj_slayer_helm_womanhead
wearpos=hat
wearpos2=head
wearpos3=jaw
2dzoom=779
2dxan=30
2dyan=1791
2dxof=-4
2dyof=-5
weight=2267g
cost=40000
members=yes
tradeable=no
iop2=Wear
iop3=Check
iop4=Disassemble
category=armour_helmet
param=stabdefence,30
param=slashdefence,32
param=crushdefence,27
param=magicdefence,10
param=rangedefence,30
// Equip gate: 10 Defence, levelrequire/scripts/tier10.rs2.
// On-task bonus: shares the black mask proc, skill_slayer/scripts/black_mask.rs2. Assembly,
// disassembly, Check and the inherited earmuffs/nose peg/facemask protection:
// skill_slayer/scripts/slayer_helm.rs2.

[dragon_pickaxe]
name=Dragon pickaxe
desc=If rocks could feel fear, they'd fear this.
model=obj_dragon_pickaxe
manwear=obj_dragon_pickaxe_manwear,0
womanwear=obj_dragon_pickaxe_womanwear,6
wearpos=righthand
2dzoom=1070
2dxan=224
2dyan=1056
2dxof=-2
2dyof=-19
weight=2400g
cost=97950
members=yes
iop2=Wield
category=weapon_pickaxe
// OSRS stats. Equip gate 60 Attack (tier60.rs2); mines from 61 Mining. Mining speed: rune's
// rate, with a 1-in-9 chance per swing of one tick less (~5.9% faster, as OSRS) - mining.rs2.
// Special attack Rock Knocker: specwep.rs2.
param=stabattack,38
param=slashattack,-2
param=crushattack,32
param=slashdefence,1
param=strengthbonus,42
param=levelrequire,61
param=mining_rate,2
param=mining_animation,human_mining_rune_pickaxe
param=attackrate,5
param=stabattack_anim,human_blunt_pound
param=crushattack_anim,human_blunt_spike
param=defend_anim,human_axe_block
param=stab_sound,baxe_slash
param=crush_sound,baxe_crush
param=specwep,^true
param=sa_energy,1000

