[proc,book](string $title, string $string)
split_init($string, 175, 22, q8_full);
def_int $page = 0;
def_int $pagetotal = split_pagecount;
while ($page < $pagetotal) {
    ~book_page($title, $page);
    $page = calc($page + 1);
}

[proc,book_obj](string $title, component $obj_com, namedobj $obj, int $zoom, string $string)
split_init($string, 175, 22, q8_full);
def_int $page = 0;
def_int $pagetotal = split_pagecount;
while ($page < $pagetotal) {
    ~book_page_obj($title, $obj_com, $obj, $zoom, $page);
    $page = calc($page + 1);
}

[proc,book_doubleobj](string $title, component $obj_com1, namedobj $obj1, int $zoom1, component $obj_com2, namedobj $obj2, int $zoom2, string $string)
split_init($string, 175, 22, q8_full);
def_int $page = 0;
def_int $pagetotal = split_pagecount;
while ($page < $pagetotal) {
    ~book_page_doubleobj($title, $obj_com1, $obj1, $zoom1, $obj_com2, $obj2, $zoom2, $page);
    $page = calc($page + 1);
}

// Each of the 22 lines of a spread (com_88..com_109) sits beside a hidden layer (com_40, com_42 ...
// com_82) holding an item model (com_41, com_43 ... com_83). A page of plain text hides every one of
// them again, so a picture from the page before (the Castle Wars manual's) does not stay on screen.
[proc,book_page](string $title, int $page)
if_settext(book:com_88, split_get($page, 0));
if_sethide(book:com_40, true);
if_settext(book:com_89, split_get($page, 1));
if_sethide(book:com_42, true);
if_settext(book:com_90, split_get($page, 2));
if_sethide(book:com_44, true);
if_settext(book:com_91, split_get($page, 3));
if_sethide(book:com_46, true);
if_settext(book:com_92, split_get($page, 4));
if_sethide(book:com_48, true);
if_settext(book:com_93, split_get($page, 5));
if_sethide(book:com_50, true);
if_settext(book:com_94, split_get($page, 6));
if_sethide(book:com_52, true);
if_settext(book:com_95, split_get($page, 7));
if_sethide(book:com_54, true);
if_settext(book:com_96, split_get($page, 8));
if_sethide(book:com_56, true);
if_settext(book:com_97, split_get($page, 9));
if_sethide(book:com_58, true);
if_settext(book:com_98, split_get($page, 10));
if_sethide(book:com_60, true);
if_settext(book:com_99, split_get($page, 11));
if_sethide(book:com_62, true);
if_settext(book:com_100, split_get($page, 12));
if_sethide(book:com_64, true);
if_settext(book:com_101, split_get($page, 13));
if_sethide(book:com_66, true);
if_settext(book:com_102, split_get($page, 14));
if_sethide(book:com_68, true);
if_settext(book:com_103, split_get($page, 15));
if_sethide(book:com_70, true);
if_settext(book:com_104, split_get($page, 16));
if_sethide(book:com_72, true);
if_settext(book:com_105, split_get($page, 17));
if_sethide(book:com_74, true);
if_settext(book:com_106, split_get($page, 18));
if_sethide(book:com_76, true);
if_settext(book:com_107, split_get($page, 19));
if_sethide(book:com_78, true);
if_settext(book:com_108, split_get($page, 20));
if_sethide(book:com_80, true);
if_settext(book:com_109, split_get($page, 21));
if_sethide(book:com_82, true);
if_settext(book:book_title, $title);
if_settext(book:com_110, ""); // Set page number to blank (left side) - Not used until way past 377
if_settext(book:com_111, ""); // Set page number to blank (right side) - Not used until way past 377
if_openmain(book);

// A page with one item pictured beside a line: $obj_com is the model component (com_41 .. com_83)
// and the layer holding it is shown. Written line by line to keep the order the client is sent it.
[proc,book_page_obj](string $title, component $obj_com, namedobj $obj, int $zoom, int $page)
if_settext(book:com_88, split_get($page, 0));
if ($obj_com = book:com_41) {
    if_sethide(book:com_40, false);
    if_setobject(book:com_41, $obj, $zoom);
} else {
    if_sethide(book:com_40, true);
}
if_settext(book:com_89, split_get($page, 1));
if ($obj_com = book:com_43) {
    if_sethide(book:com_42, false);
