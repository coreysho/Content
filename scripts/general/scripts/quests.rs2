[proc,update_questlist]
~update_questpoints;
// counted here, coloured by ~questtab_show when the Quests page is the one on show (a hidden page
// is reloaded from the cache when it comes back, so colours sent to it now would be lost)
~questlist_recolour(false);
~questtab_show;

if (%drunkmonkquest >= ^drunkmonk_spoken_to_omad) {
    settimer(blanket_ladder, 1);
}

// Tears of Guthix arms a [timer] for the length of a run and timers do not survive a logout. A
// player who logged out inside the cave would come back with tog_minigame_collecting still set
// and no timer to turn it off, and could then stand at the walls indefinitely. ~update_questlist
// runs from login.rs2, so this is where the stranded flag gets cleared.
~tog_clear_stranded_run;

// Every quest row coloured red, yellow or green - or, with $send false, only counted: the count is
// what the Character Summary's "Quests Done" reads (%questlist_done of %questlist_total), and
// ~send_quest_complete recounts without re-sending the colours.
[proc,questlist_recolour](boolean $send)
%questlist_total = 0;
%questlist_done = 0;
~questlist_row(questlist:runemysteries, %runemysteries, ^runemysteries_complete, $send);
~questlist_row(questlist:doric, %doricquest, ^doric_complete, $send);
~questlist_row(questlist:cook, %cookquest, ^cook_complete, $send);
~questlist_row(questlist:romeojuliet, %rjquest, ^romeojuliet_complete, $send);
~questlist_row(questlist:hetty, %hetty, ^hetty_complete, $send);
~questlist_row(questlist:chompybird, %chompybird, ^chompybird_complete, $send);
