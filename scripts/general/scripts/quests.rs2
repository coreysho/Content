[proc,questlist_row](component $component, int $progress, int $complete_progress, boolean $send)
%questlist_total = add(%questlist_total, 1);
if ($progress >= $complete_progress) {
    %questlist_done = add(%questlist_done, 1);
}
if ($send = true) {
    ~send_quest_progress_colour($component, $progress, $complete_progress);
}

