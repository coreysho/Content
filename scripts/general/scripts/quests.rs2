[proc,send_quest_progress](component $component, int $progress, int $complete_progress)
~send_quest_progress_colour($component, $progress, $complete_progress);
// the quest tab as it was - whichever of its pages the player is on, with its numbers brought up
// to date - rather than the quest list, which is one of five pages now
~questtab_show;

[proc,send_quest_progress_colour](component $component, int $progress, int $complete_progress)
// if_setcolor uses 5 bits per color
if ($progress = 0) {
    if_setcolour($component, ^red_rgb);
} else if ($progress >= $complete_progress) {
    if_setcolour($component, ^green_rgb);
} else {
    if_setcolour($component, ^yellow_rgb);
}

[proc,send_quest_complete](component $component, namedobj $obj, int $objscale, int $questpoints, string $questmessage, string $rewardtext)
// Random quest complete jingle.
def_int $random = random(128);
if ($random < 32) {       // The least common music that plays when completing a quest.
    midi_jingle("quest complete 3");
} else if ($random < 64) {// A less common music that plays when completing a quest.
    midi_jingle("quest complete 2");
} else {                 // The most common music that plays when completing a quest.
    midi_jingle("quest complete 1");
}
// Send Quest Scroll
switch_component ($component) {
    case questlist:itgronigen ://Obveratory: Updates QP before quest scroll is queued & uses custom quest scroll
        if_openmain(questscroll_itgronigen);
    // Gertrude's Cat used to open questscroll_fluffs here, with nothing written into it. That is
    // interface 2302 - and 2302 is not the scroll the name suggests. Every well-formed interface in
    // content/pack/interface.pack has contiguous children (questscroll is 297 with com_0..com_7 at
    // 298-305); questscroll_fluffs claims 2302 with "children" scattered across 2303, 2305, 2308,
    // 2309 and 3215, interleaved with music:com_10..13. Opening it renders whatever actually lives
    // at that id, which is why the reward screen came up as a shape-puzzle random event.
    //
    // It was split out of the default branch for a real reason, though: Gertrude's Cat is one of
    // only two quests that passed null as the reward obj, and if_setobject does
    // check(obj, ObjTypeValid) (PlayerOps.ts:695), so a null would throw and disconnect the player
    // on completion. Fixed at the source instead - quest_fluffs.rs2 now passes kittenobject, which
    // is the reward its own text already advertises - so this case is no longer needed at all and
    // Gertrude's Cat goes through the same inter_238 screen as every other quest.
    //
    // questlist:itgronigen above is the other null-obj quest and points at questscroll_itgronigen
    // (1689, children at 1690/1692/1695/1696 - also non-contiguous). Same suspect, not reported yet,
    // so left alone deliberately rather than changed on a hunch. If the Observatory reward screen
    // ever comes up wrong too, the fix is the same shape: give it a real reward obj and delete
    // its case.
    case questlist:seaslug, questlist:itwatchtower ://Seaslug & Watchtower: Updates QP before quest scroll is queued
        if_settext(questscroll:com_3, $questmessage);
        if_settext(questscroll:com_9, tostring($questpoints));
        if_settext(questscroll:com_10, "Quest points.");
        if_setobject(questscroll:com_4, $obj, $objscale);
        if_openmain(questscroll);
    case default ://All other quests
        ~update_questpoints;
        split_init($rewardtext, 200, 5, q8_full);
        if_settext(inter_238:com_3, $questmessage);
        if_settext(inter_238:com_9, "<~pluralise($questpoints, "Quest Point")>");
        if_settext(inter_238:com_10, split_get(0, 0));
        if_settext(inter_238:com_11, split_get(0, 1));
        if_settext(inter_238:com_12, split_get(0, 2));
        if_settext(inter_238:com_13, split_get(0, 3));
        if_settext(inter_238:com_14, split_get(0, 4));
        if_setobject(inter_238:com_4, $obj, $objscale);
        if_openmain(inter_238);
}
// Update Quest Tab color
if_setcolour($component, ^green_rgb);
// and the Character Summary's Quests Done, by counting again - without re-sending the colours,
// because not every quest sets its varp to complete before it gets here
~questlist_recolour(false);
~questtab_show;
switch_component ($component) {
    case questlist:troll_love : 
        mes("Congratulations! You've helped a lonely troll find love. Quest complete!");
    case default : 
        mes("Congratulations! Quest complete!");
}

[proc,update_questpoints]
def_int $questpointrecount = ~count_questpoints;
//Only update if the count has changed
if ($questpointrecount ! %qp) {
    %qp = $questpointrecount;
}

