[opheld4,_necklace_of_minigames]
// https://youtu.be/sB2oqPgruaM?si=7EKqWR-U07U1ncoR&t=272
mes("You rub the necklace...");
def_obj $item = last_item;
def_int $slot = last_slot;
p_delay(1);
def_int $choice = ~p_choice3_header("Burthorpe Games Rooms.", 1, "Barbarian Outpost.", 2, "Nowhere.", 3, "Where would you like to teleport to?");
if($choice = 3) {
    mes("You remain where you were.");
    return;
}
@necklace_of_minigames_teleport($item, $slot, $choice, false);

// WORN: the two destinations are the Worn Equipment tab's own options, as OSRS's games necklace has
// its (oldschool.runescape.wiki/w/Games_necklace), with no rub and no menu. The charge comes off the
// necklace round the neck (player/scripts/wearop.rs2).
[label,wearop1__necklace_of_minigames] @necklace_of_minigames_teleport(last_item, last_slot, 1, true);
[label,wearop2__necklace_of_minigames] @necklace_of_minigames_teleport(last_item, last_slot, 2, true);

// $choice: 1 Burthorpe, 2 the Barbarian Outpost. $worn: $slot is in worn, not inv.
[label,necklace_of_minigames_teleport](obj $item, int $slot, int $choice, boolean $worn)
if (~wilderness_level(coord) > 20) {
    // yes it actually says this in osrs
    mes("A mysterious force blocks your teleport spell!");
    mes("You can't use this teleport after level 20 wilderness.");
    return;
}
if (~pre_tele_checks(coord) = false) {
    return;
}
def_coord $destination;
if ($choice = 1) {
    $destination = map_findsquare(0_34_77_31_12, 0, 2, ^map_findsquare_lineofwalk);
} else if ($choice = 2) {
    // outside the Barbarian Outpost gate; the agility course itself is live in m39_55
    $destination = map_findsquare(0_39_55_23_51, 0, 2, ^map_findsquare_lineofwalk);
}
~player_teleport_normal($destination);
def_namedobj $new_necklace = oc_param($item, next_obj_stage);
if ($worn = true) {
    ~worn_replace($slot, $item, $new_necklace);
} else if ($new_necklace = null) {
    inv_delslot(inv, $slot);
} else {
    inv_setslot(inv, $slot, $new_necklace, 1);
}
if ($new_necklace = null) {
    mes("Your Games Necklace crumbles to dust.");
} else {
    mes("Your Games Necklace has <~pluralise(oc_param($new_necklace, charges), "use")> left.");
}
