[opheld4,amulet_of_glory_4] @amulet_of_glory_interface("Your amulet has three charges left.");
[opheld4,amulet_of_glory_3] @amulet_of_glory_interface("Your amulet has two charges left.");
[opheld4,amulet_of_glory_2] @amulet_of_glory_interface("Your amulet has one charge left.");
[opheld4,amulet_of_glory_1] @amulet_of_glory_interface("You use your amulet's last charge.");
[opheld4,amulet_of_glory] mes("The amulet has lost its charge.");

// THE CHOICE AND THE TELEPORT ARE A PROC, and the charge is eaten by the caller. The mounted glory
// in a quest hall (skill_construction/scripts/poh_costume.rs2's neighbour, poh_tablets.rs2) is the
// same four destinations with nothing to charge, and it cannot call a label that ends by writing to
// last_slot - that slot belongs to whatever the player happens to be holding.
//
// $message is printed immediately before the teleport: the charge count for an amulet, and
// something else entirely for the one on the wall.
[proc,glory_teleport](string $message)(boolean)
// https://youtu.be/Zv7Wh3TIDOc
mes("You rub the amulet...");
// Space after "to" is intentional. Based off of this screenshot: https://storage.googleapis.com/tannerdino/images/rstransport9.gif
def_int $choice = ~p_choice5_header("Edgeville.", 1, "Karamja.", 2, "Draynor Village.", 3, "Al Kharid.", 4, "Nowhere.", 5, "Where would you like to teleport to ?");
// https://i.imgur.com/HsKKBnr.png
if ($choice = 5) {
    mes("You remain where you were.");
    return(false);
}
return(~glory_teleport_to($choice, $message));

// One of the four destinations, 1-4 in the menu's order, with no menu: the dialogue above ends here,
// and so does a worn amulet's own option (below), which names its destination outright.
[proc,glory_teleport_to](int $choice, string $message)(boolean)
if (~wilderness_level(coord) > 30) {
    // osrs
    mes("A mysterious force blocks your teleport.");
    mes("You can't use this teleport after level 30 wilderness.");
    return(false);
}
if (~pre_tele_checks(coord) = false) {
    return(false);
}
mes($message);
switch_int($choice) {
    case 1 : ~player_teleport_normal(0_48_54_15_40);
    case 2 : ~player_teleport_normal(0_45_49_38_40);
    case 3 : ~player_teleport_normal(0_48_50_33_51);
    case 4 : ~player_teleport_normal(0_51_49_29_27);
}
return(true);

[label,amulet_of_glory_interface](string $message)
def_obj $item = last_item;
def_int $slot = last_slot;
if (~glory_teleport($message) = false) {
    return;
}
inv_setslot(inv, $slot, oc_param($item, next_obj_stage), 1);

// WORN: the Worn Equipment tab offers the four destinations straight off, OSRS's own worn options
// (oldschool.runescape.wiki/w/Amulet_of_glory: "Edgeville, Karamja, Draynor Village, Al Kharid"),
// no rub and no menu. The charge comes off the amulet where it hangs, so it stays worn as the next
// charge down, and the last one leaves the uncharged amulet on the neck, as OSRS does.
// category_557 is the four charged amulets; the uncharged one has no worn options.
[label,wearop1__category_557] @amulet_of_glory_worn(1);
[label,wearop2__category_557] @amulet_of_glory_worn(2);
[label,wearop3__category_557] @amulet_of_glory_worn(3);
[label,wearop4__category_557] @amulet_of_glory_worn(4);

[label,amulet_of_glory_worn](int $choice)
def_obj $item = last_item;
def_int $slot = last_slot;
if (~glory_teleport_to($choice, ~glory_charges_message($item)) = false) {
    return;
}
~worn_replace($slot, $item, oc_param($item, next_obj_stage));

// what the backpack's opheld4 lines above say, for the same amulet
[proc,glory_charges_message](obj $item)(string)
switch_obj ($item) {
    case amulet_of_glory_4 : return("Your amulet has three charges left.");
    case amulet_of_glory_3 : return("Your amulet has two charges left.");
    case amulet_of_glory_2 : return("Your amulet has one charge left.");
}
return("You use your amulet's last charge.");
