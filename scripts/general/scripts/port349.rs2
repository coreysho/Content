// Called from [login,_] before the quest tab is drawn. Each proc translates a save made against
// this server's old version of that quest into the stage numbers of the ported original, once.
[proc,port349_login]
~port349_migrate_mm;
~port349_migrate_tbwt;
~port349_migrate_routequest;
~port349_migrate_mortton;
~port349_migrate_eadgar;
~port349_migrate_horror;
~port349_migrate_regicide;
~port349_migrate_viking;
