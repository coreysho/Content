// The toxic blowpipe's contents (scripts/blowpipe.rs2) - the PLAYER's, not the item's, exactly as
// the trident's charges are (areas/area_kraken_cove/scripts/trident.rs2): an obj here carries no
// per-item state, which is why the charged blowpipe is untradeable (OSRS's is too) and the empty
// one, which holds nothing, can be traded. Perm, so they survive a logout.
[blowpipe_scales]
scope=perm

[blowpipe_darts]
scope=perm

// the kind of dart loaded; only ever one kind, as in OSRS
[blowpipe_dart_type]
scope=perm
type=namedobj

// VENOM (scripts/venom.rs2) on a player: 0 not envenomed; above 0 the damage of the next venom hit
// (6, 8, ... 20); below 0 a venom immunity counting back up to 0, one step per 30 ticks, as %poison's
// does. Perm like %poison, so logging out does not cure it.
[venom]
scope=perm
