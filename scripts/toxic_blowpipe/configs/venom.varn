// VENOM (scripts/venom.rs2) on a monster: the damage of its next venom hit, 6 rising by 2 to 20, or
// 0. It rides the same ai_timer as %npc_poison - OSRS: "Venom and Poison make use of the same timer
// mechanic. As such, monsters can not simultaneously be envenomed and poisoned." Cleared for us on
// respawn - Npc.resetEntity zeroes every varn.
[npc_venom]
type=int
