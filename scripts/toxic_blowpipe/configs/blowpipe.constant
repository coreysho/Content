// The toxic blowpipe (scripts/blowpipe.rs2, blowpipe_combat.rs2) - OSRS wiki figures.
^blowpipe_max_scales = 16383
^blowpipe_max_darts = 16383
^blowpipe_level = 75
// The owner's call: the blowpipe as it was made in 2015-2024, 53 Fletching (OSRS raised it to 78 in
// May 2024's Project Rebalance). 120 experience either way.
^blowpipe_fletching_level = 53
^blowpipe_fletching_xp = 1200
// Dismantling a tanzanite fang or an empty blowpipe gives 20,000 scales
^blowpipe_dismantle_scales = 20000
// "in player versus monster encounters its attack speed is 3 ... during player versus player combat
// its attack speed is 4" - one faster on Rapid in both
^blowpipe_attackrate = 3
^blowpipe_attackrate_pvp = 4

// VENOM (scripts/venom.rs2): "Damage starts at one hit of 6 per 18 seconds and increases by 2 each
// time it hits, capping at 20". 18 seconds is 30 ticks, the poison timer's own interval.
^venom_start = 6
^venom_step = 2
^venom_max = 20
^venom_interval = 30
// what enum venom_immunity says of a monster
^venom_susceptible = 0
^venom_immune_poisoned_instead = 1
^venom_immune = 2
// A venom-immune monster that poison still works on is poisoned instead, starting at the venom's own
// 6 a hit: npc poison hits for (severity + 4) / 5 (skill_combat/scripts/npc/npc_poison.rs2).
^venom_poison_severity = 26
