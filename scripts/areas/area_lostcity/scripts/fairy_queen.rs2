// fairy_queen_multi (multivar=fairy_queen_check, multinpc=0,fairy_queen) is what Zanaris places;
// fairy_queen is only what it resolves to. engine/entity/Player.ts:1001 looks the trigger up on the
// placed type without resolving the multi, so this dialogue never ran. Declared on both.
[opnpc1,fairy_queen_multi] @fairy_queen_chat;
[opnpc1,fairy_queen] @fairy_queen_chat;

[label,fairy_queen_chat]
def_int $option = ~p_choice2("How do crops and such survive down here?", 1, "What's so good about this place?", 2);
if($option = 1) {
    ~chatplayer("<p,quiz>How do crops and such survive down here?|Surely they need a bit of sunlight?");
    ~chatnpc("<p,neutral>Clearly you come from a plane dependent on sunlight.|Down here, the plants grow in the aura of faerie.");
} else if($option = 2) {
    ~chatplayer("<p,neutral>What's so good about this place?");
    ~chatnpc("<p,neutral>Zanaris is a meeting point of cultures.|Those from many worlds converge here to exchange knowledge and goods.");
}
