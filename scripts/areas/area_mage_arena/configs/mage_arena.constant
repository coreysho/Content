// WHICH GOD, as a number, so a cape or a staff can be asked rather than listed. god_cape.enum
// and god_staff_god map every one of them to these, and a thing in neither table answers
// ^god_none - which is how "no cape" and "an ordinary cape" come out the same.
//
// The order matters only in that tools/genmaxvariants.py writes the tables in it; the battery
// checks the two agree rather than trusting that they do.
^god_none = 0
^god_saradomin = 1
^god_guthix = 2
^god_zamorak = 3
