// Imbued god capes - the Mage Arena II reward.
//
// No new art: each is the same obj_red_cape model its plain counterpart uses, recoloured so the
// god's own colour sits at full intensity while the base cape keeps the muted 2006 palette. The
// recolour SOURCE values (15360 / 8386 / 31649 / 8320) are obj_red_cape's four face colours and
// must not be changed - they are what the packer matches against. The four map to the cape in
// this order: body (74 faces), lining (54), trim (20), trim shadow (12).
//
// Stats: the plain god capes are +10 magic attack / +10 magic defence in this cache. The imbued
// versions go to +15/+15, which is the OSRS magic attack figure and keeps the imbue a real but
// not absurd upgrade. There is no magic damage % field in 377, so the imbued cape's +2% damage
// from OSRS has no equivalent here and is simply not modelled.

[saradomin_cape_i]
name=Imbued saradomin cape
desc=A cape from the almighty god Saradomin, charged in his arena.
recol1s=15360
recol1d=32767
recol2s=8386
recol2d=511
recol3s=31649
recol3d=32767
recol4s=8320
recol4d=511
cost=100
model=obj_red_cape
2dxof=3
2dyof=6
2dzoom=2140
2dyan=948
2dxan=400
iop2=Wear
wearpos=back
weight=1lb
manwear=obj_red_cape_manwear,0
womanwear=obj_red_cape_womanwear,0
members=yes
category=armour_godcape
tradeable=no
param=magicattack,15
param=stabdefence,1
param=slashdefence,1
param=crushdefence,2
param=magicdefence,15
param=destroy_death,^true
param=lose_cape_message,Saradomin reclaims the cape as it touches the ground.

