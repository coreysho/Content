// Mage Arena II
// =============
//
// The real MA2 is a deep-wilderness area with three bespoke bosses (Porazdir, Derwen, Justiciar
// Zachariah) and its own cave. None of that exists in a 2006 cache, and building it would mean
// new maps, new npcs and new models. This is the arena-rematch version instead: Kolodion offers
// a second trial once you have finished the Mage Arena and reached 75 Magic, and the trial is to
// defeat the champions of all three gods - the saradomin, guthix and zamorak battle mages that
// already stand in the arena. Beat all three, then pray at the statue of your own god and it
// upgrades your cape.
//
// The shape is faithful even though the venue is not: three god-aligned opponents, a magic
// requirement, and the statue as the thing that actually hands over the cape.
//
// Progress lives in two varps (configs/mage_arena2.varp):
//   %magearena2            stage - see ^ma2_* in configs/mage_arena2.constant
//   %magearena2_champions  bitfield of which of the three have been beaten
//
// Nothing here touches the MA1 flow. %magearena is read but never written.

// ---------------------------------------------------------------------------------------------
// Eligibility
// ---------------------------------------------------------------------------------------------

// MA1 is finished once the player has prayed at a statue (stage 7) or been given a staff (8);
// ^mage_arena_complete (6) means the fights are done but no cape has been claimed yet, and MA2
// has nothing to upgrade at that point.
[proc,ma2_finished_mage_arena]()(boolean)
if (%magearena >= ^mage_arena_prayed_at_statue) {
    return(true);
}
return(false);

[proc,ma2_can_start]()(boolean)
if (~ma2_finished_mage_arena = false) {
    return(false);
}
if (%magearena2 ! ^ma2_not_started) {
    return(false);
}
return(true);

// ---------------------------------------------------------------------------------------------
// Kolodion offers the trial
// ---------------------------------------------------------------------------------------------
// Reached from the default branch of [opnpc1,arenamage1] in kolodion.rs2.

[label,ma2_kolodion_offer]
~chatplayer("<p,quiz>Is there a greater challenge here?");
if (~ma2_finished_mage_arena = false) {
    ~chatnpc("<p,neutral>Finish what you started, young mage. Claim a cape from|one of the statues first.");
    return;
}
if (%magearena2 = ^ma2_cape_claimed) {
    ~chatnpc("<p,happy>You have already taken all this arena can give you. Your|cape is charged; wear it well.");
    return;
}
if (%magearena2 = ^ma2_champions_defeated) {
    ~chatnpc("<p,happy>You have bested all three champions. Go to the statue of|your god and kneel - it will charge your cape.");
    return;
}
if (%magearena2 = ^ma2_started) {
    @ma2_progress_report;
}
~chatnpc("<p,shifty>There is. The three gods each keep a champion in my|arena. No wizard has ever bested all three.");
if (stat_base(magic) < ^ma2_magic_requirement) {
    ~chatnpc("<p,angry>Not that it matters to you. Come back when your magic is|worthy - level <tostring(^ma2_magic_requirement)>, no less.");
    return;
}
~chatnpc("<p,quiz>Defeat the champions of Saradomin, Guthix and Zamorak,|then kneel before your own god's statue. Your cape will|come back charged with his power.");
def_int $choice = ~p_choice2("I'll do it.", 1, "That sounds like a bad idea.", 2);
if ($choice = 2) {
    ~chatplayer("<p,bored>That sounds like a bad idea.");
    ~chatnpc("<p,happy>Most good ideas do.");
    return;
}
~chatplayer("<p,happy>I'll do it.");
%magearena2 = ^ma2_started;
%magearena2_champions = 0;
~chatnpc("<p,shifty>Then go. They are waiting for you.");

[label,ma2_progress_report]
~chatnpc("<p,neutral>Three champions. Show me you can beat them all.");
@ma2_mesbox_progress;

[label,ma2_mesbox_progress]
if_close;
~mesbox("Champions defeated:|Saradomin: <~ma2_champion_word(^ma2_champion_saradomin)>|Guthix: <~ma2_champion_word(^ma2_champion_guthix)>|Zamorak: <~ma2_champion_word(^ma2_champion_zamorak)>");

[proc,ma2_champion_word](int $bit)(string)
if (and(%magearena2_champions, $bit) ! 0) {
    return("yes");
}
return("not yet");

// ---------------------------------------------------------------------------------------------
// Beating a champion
// ---------------------------------------------------------------------------------------------
// The three battle mages had no [ai_queue3] of their own, so they were falling through to
// [ai_queue3,_] gosub(npc_default_death) in skill_combat/scripts/npc/npc_combat.rs2. These
// triggers keep that behaviour and record the kill first.

[ai_queue3,saradomin_mage] @ma2_champion_death(^ma2_champion_saradomin);
[ai_queue3,guthix_mage] @ma2_champion_death(^ma2_champion_guthix);
[ai_queue3,zamorak_mage] @ma2_champion_death(^ma2_champion_zamorak);

[label,ma2_champion_death](int $bit)
if (npc_findhero = ^true) {
    ~ma2_record_champion($bit);
}
gosub(npc_default_death);

[proc,ma2_record_champion](int $bit)
if (%magearena2 ! ^ma2_started) {
    return;
}
if (and(%magearena2_champions, $bit) ! 0) {
    return; // already beaten this one - killing it again changes nothing
}
%magearena2_champions = or(%magearena2_champions, $bit);
if (and(%magearena2_champions, ^ma2_champions_all) = ^ma2_champions_all) {
    %magearena2 = ^ma2_champions_defeated;
    mes("You have defeated all three champions.");
    mes("Kneel at the statue of your god to claim your reward.");
    return;
}
def_int $beaten = bitcount(and(%magearena2_champions, ^ma2_champions_all));
def_int $left = sub(3, $beaten);
mes("A champion falls. <tostring($left)> more to go.");

// ---------------------------------------------------------------------------------------------
// Claiming the imbued cape
// ---------------------------------------------------------------------------------------------
// Called from pray_at_statue in chamber.rs2, which knows which god's statue was used.

[proc,ma2_holds_cape](namedobj $cape)(boolean)
if (inv_total(inv, $cape) > 0 | inv_total(worn, $cape) > 0) {
    return(true);
}
return(false);

[proc,ma2_ready_to_charge](namedobj $cape)(boolean)
if (%magearena2 ! ^ma2_champions_defeated) {
    return(false);
}
def_boolean $holds = ~ma2_holds_cape($cape);
return($holds);

[label,ma2_charge_cape](string $name, namedobj $cape, namedobj $imbued_cape)
if (inv_freespace(inv) < 1 & inv_total(inv, $cape) < 1) {
    ~mesbox("You need a free inventory space to receive the charged cape.");
    return;
}
anim(human_pray, 10);
p_delay(2);
~mesbox("You kneel and begin to chant to <$name>...");
if (inv_total(inv, $cape) > 0) {
    inv_del(inv, $cape, 1);
} else {
    inv_del(worn, $cape, 1);
}
inv_add(inv, $imbued_cape, 1);
%magearena2 = ^ma2_cape_claimed;
spotanim_pl(smokepuff_large, 60, 0);
sound_synth(smokepuff, 1, 0);
~mesbox("<$name> answers. The cape burns cold in your hands, and|the power of his arena is bound into it forever.");
