// THE KRAKEN COVE (2026-09-21) - getting about. The cove is OSRS's m35_156 (maps/m35_156.jm2); its
// surface square, southwest of the Piscatoris Fishing Colony, is not in this map, so there is no
// cave entrance yet and the way out goes to Edgeville for now. Where the way IN goes is Corey's call.

// The cave exit, (36,3).
[oploc1,osrsloc_30178]
mes("You climb out of the cove.");
p_teleport(0_48_54_15_40);

// The crevice from the cave into the Kraken's chamber, (40,33), and the one back out, (40,37).
// OSRS's crevice also offers a private instance and a peek; there are no instances here, so both
// of those options are gone from the loc and everyone shares the one chamber.
[oploc1,osrsloc_537]
p_delay(0);
anim(human_pickupfloor, 0);
p_delay(1);
p_teleport(0_35_156_38_39);
mes("You squeeze through the crevice into the Kraken's chamber.");

[oploc1,osrsloc_538]
p_delay(0);
anim(human_pickupfloor, 0);
p_delay(1);
p_teleport(0_35_156_40_32);
mes("You squeeze back out through the crevice.");
