// THE KRAKEN COVE (2026-09-21) - drop tables. Rates are the OSRS wiki's (Kraken, Cave_kraken, Sept 2026)
// in the shape drop_tables/scripts/dagannoth_rex.rs2 uses: the uniques and tertiaries on their own
// rolls, then one cascade over the main table. What this 377 cache lacks is swapped or left out, and
// its weight left as "nothing" rather than spread over the rest, so no listed rate moves:
//   Kraken: oak plank -> plank (377 has one kind); Sanfew serum -> super restore; antidote++, the
//     rusty sword, the elite clue and the brimstone key are not here.
//   Cave kraken: see its own table below.
// Everything lands under the player, not the monster: both die in water nobody can walk into.

// ---------------------------------------------------------------- the Kraken
[ai_queue3,kraken]
// its tentacles go under with it (kraken_combat.rs2), before the death animation, not after it
~kraken_sink_tentacles(npc_coord);
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}
// under the PLAYER, as the cave krakens do: it died in the water
def_coord $at = ~kraken_loot_coord;
// ~bosspet_roll's rule and rate, at $at: that proc drops at npc_coord, which here is the water
if (random(^bosspet_droprate) = 0 & ~pet_owned(bosspet_kraken_item) = false) {
    obj_add($at, bosspet_kraken_item, 1, ^lootdrop_duration);
    mes("You have a funny feeling like you're being followed.");
    ~broadcast_pet(bosspet_kraken_item);
}
obj_add($at, coins, ~random_range(10000, 19999), ^lootdrop_duration);
if (random(400) = 0) {
    ~kraken_rare_at($at, kraken_tentacle_item, 1);
}
if (random(1000) = 0) {
    ~kraken_rare_at($at, jar_of_dirt, 1);
}
// 1/512, and it takes the main drop's place, as OSRS's "1/512 in the main table" does
if (random(512) = 0) {
    ~kraken_rare_at($at, trident_of_the_seas_full, 1);
    return;
}
def_int $r = random(128);
// weapons and armour - 9/128
if ($r < 3) {
    obj_add($at, mystic_water_staff, 1, ^lootdrop_duration);
} else if ($r < 5) {
    obj_add($at, rune_warhammer, 1, ^lootdrop_duration);
} else if ($r < 7) {
    obj_add($at, rune_longsword, 1, ^lootdrop_duration);
} else if ($r < 8) {
    obj_add($at, mystic_robe_top, 1, ^lootdrop_duration);
} else if ($r < 9) {
    obj_add($at, mystic_robe_bottom, 1, ^lootdrop_duration);
// runes - 51/128
} else if ($r < 19) {
    obj_add($at, waterrune, 400, ^lootdrop_duration);
} else if ($r < 23) {
    obj_add($at, mistrune, 100, ^lootdrop_duration);
} else if ($r < 33) {
    obj_add($at, chaosrune, 200, ^lootdrop_duration);
} else if ($r < 43) {
    obj_add($at, deathrune, 150, ^lootdrop_duration);
} else if ($r < 53) {
    obj_add($at, bloodrune, 60, ^lootdrop_duration);
} else if ($r < 60) {
    obj_add($at, soulrune, 50, ^lootdrop_duration);
// seeds - 5/128
} else if ($r < 63) {
    obj_add($at, watermelon_seed, 24, ^lootdrop_duration);
} else if ($r < 64) {
    obj_add($at, torstol_seed, 2, ^lootdrop_duration);
} else if ($r < 65) {
    obj_add($at, magic_tree_seed, 1, ^lootdrop_duration);
// materials - 20/128
} else if ($r < 68) {
    obj_add($at, cert_seaweed, 125, ^lootdrop_duration);
} else if ($r < 72) {
    obj_add($at, cert_battlestaff, 10, ^lootdrop_duration);
} else if ($r < 74) {
    obj_add($at, cert_stafforb, 50, ^lootdrop_duration);
} else if ($r < 75) {
    obj_add($at, cert_diamond, 8, ^lootdrop_duration);
} else if ($r < 78) {
    obj_add($at, cert_woodplank, 60, ^lootdrop_duration);
} else if ($r < 80) {
    obj_add($at, cert_raw_shark, 50, ^lootdrop_duration);
} else if ($r < 82) {
    obj_add($at, cert_raw_monkfish, 100, ^lootdrop_duration);
} else if ($r < 84) {
    obj_add($at, cert_unidentified_snapdragon, 6, ^lootdrop_duration);
} else if ($r < 85) {
    obj_add($at, runite_bar, 2, ^lootdrop_duration);
// other - 24/128
} else if ($r < 92) {
    obj_add($at, shark, 5, ^lootdrop_duration);
} else if ($r < 96) {
    obj_add($at, pirate_boots, 1, ^lootdrop_duration);
} else if ($r < 100) {
    obj_add($at, 4dose2restore, 2, ^lootdrop_duration);
} else if ($r < 103) {
    obj_add($at, edible_seaweed, 5, ^lootdrop_duration);
} else if ($r < 104) {
    obj_add($at, harpoon, 1, ^lootdrop_duration);
} else if ($r < 105) {
    obj_add($at, bucket_empty, 1, ^lootdrop_duration);
} else if ($r < 106) {
    obj_add($at, crystal_key, 1, ^lootdrop_duration);
} else if ($r < 107) {
    obj_add($at, dragonstone_ring, 1, ^lootdrop_duration);
} else if ($r < 109) {
    obj_add($at, ~randomjewel, ^lootdrop_duration);
}
// 109..127: nothing but the coins

// ---------------------------------------------------------------- cave krakens
// The wiki's whole table (Cave_kraken, Sept 2026), on a /400 base so its half-weights stay exact
// (rune med helm 6.5/200 = 13/400; the bucket's 1/240 rounds to 2/400). Antidote++ -> super
// antipoison, which is what 377 has; the elite clue and brimstone key are not here.
[ai_queue3,cave_kraken]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}
// under the PLAYER: it died in the water, where nobody could pick anything up
def_coord $at = ~kraken_loot_coord;
~trail_hardcluedrop(100, $at);
if (random(1200) = 0) {
    ~kraken_rare_at($at, kraken_tentacle_item, 1);
}
def_int $r = random(400);
// weapons and armour - 59/400
if ($r < 8) {
    obj_add($at, staff_of_water, 1, ^lootdrop_duration);
} else if ($r < 21) {
    obj_add($at, rune_med_helm, 1, ^lootdrop_duration);
} else if ($r < 29) {
    obj_add($at, adamant_spear, 1, ^lootdrop_duration);
} else if ($r < 37) {
    obj_add($at, rune_warhammer, 1, ^lootdrop_duration);
} else if ($r < 45) {
    obj_add($at, battlestaff, 1, ^lootdrop_duration);
} else if ($r < 53) {
    obj_add($at, water_battlestaff, 1, ^lootdrop_duration);
} else if ($r < 57) {
    obj_add($at, mystic_water_staff, 1, ^lootdrop_duration);
} else if ($r < 59) {
    ~kraken_rare_at($at, trident_of_the_seas_uncharged, 1);
// runes - 172/400
} else if ($r < 71) {
    obj_add($at, steamrune, 7, ^lootdrop_duration);
} else if ($r < 91) {
    obj_add($at, waterrune, 15, ^lootdrop_duration);
} else if ($r < 111) {
    obj_add($at, waterrune, 30, ^lootdrop_duration);
} else if ($r < 131) {
    obj_add($at, waterrune, 75, ^lootdrop_duration);
} else if ($r < 151) {
    obj_add($at, firerune, 30, ^lootdrop_duration);
} else if ($r < 183) {
    obj_add($at, deathrune, 30, ^lootdrop_duration);
} else if ($r < 215) {
    obj_add($at, chaosrune, 50, ^lootdrop_duration);
} else if ($r < 231) {
    obj_add($at, bloodrune, 5, ^lootdrop_duration);
// herbs and rare seeds - 24/400
} else if ($r < 243) {
    obj_add($at, ~randomherb, ^lootdrop_duration);
} else if ($r < 255) {
    obj_add($at, ~kraken_rare_seed, ^lootdrop_duration);
// other - 133/400
} else if ($r < 263) {
    obj_add($at, old_boot, 1, ^lootdrop_duration);
} else if ($r < 271) {
    obj_add($at, swamp_tar, 60, ^lootdrop_duration);
} else if ($r < 279) {
    // nothing, 4/200
} else if ($r < 291) {
    obj_add($at, cert_seaweed, 30, ^lootdrop_duration);
} else if ($r < 311) {
    obj_add($at, coins, ~random_range(120, 300), ^lootdrop_duration);
} else if ($r < 313) {
    obj_add($at, bucket_empty, 1, ^lootdrop_duration);
} else if ($r < 321) {
    obj_add($at, cert_raw_lobster, 3, ^lootdrop_duration);
} else if ($r < 329) {
    obj_add($at, cert_water_orb, 2, ^lootdrop_duration);
} else if ($r < 337) {
    obj_add($at, oystershell, 1, ^lootdrop_duration);
} else if ($r < 349) {
    obj_add($at, swordfish, 2, ^lootdrop_duration);
} else if ($r < 361) {
    obj_add($at, shark, 1, ^lootdrop_duration);
} else if ($r < 373) {
    obj_add($at, cert_4dose2antipoison, 4, ^lootdrop_duration);
} else if ($r < 381) {
    obj_add($at, cert_vial_water, 50, ^lootdrop_duration);
} else if ($r < 389) {
    obj_add($at, water_talisman, 1, ^lootdrop_duration);
// the gem table - 12/400 (the last 1 of the 400 rounds into it)
} else {
    obj_add($at, ~randomjewel, ^lootdrop_duration);
}

// The rare seed table, in the wiki's proportions (Rare_seed_drop_table), with the seeds 377 has.
[proc,kraken_rare_seed]()(namedobj, int)
def_int $r = random(217);
if ($r < 47) return(toadflax_seed, 1);
if ($r < 79) return(irit_seed, 1);
if ($r < 110) return(belladonna_seed, 1);
if ($r < 132) return(avantoe_seed, 1);
if ($r < 154) return(poisonivy_bush_seed, 1);
if ($r < 175) return(cactus_seed, 1);
if ($r < 190) return(kwuarm_seed, 1);
if ($r < 200) return(snapdragon_seed, 1);
if ($r < 207) return(cadantine_seed, 1);
if ($r < 212) return(lantadyme_seed, 1);
if ($r < 215) return(dwarf_weed_seed, 1);
return(torstol_seed, 1);

// Loot goes under the player who gets it - both krakens die in water nobody can walk into. After
// npc_findhero the active player is that player, so coord is where they stand.
[proc,kraken_loot_coord]()(coord)
return(coord);

[proc,kraken_rare_at](coord $at, namedobj $obj, int $count)
obj_add($at, $obj, $count, ^lootdrop_duration);
~broadcast_drop($obj);

// The tentacles drop nothing, in OSRS as here; they still die properly.
[ai_queue3,kraken_tentacle] gosub(npc_death);
