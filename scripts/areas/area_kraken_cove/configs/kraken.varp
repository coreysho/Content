// The trident of the seas' charges (scripts/trident.rs2) - the player's, not the item's. 0..2,500.
[trident_charges]
scope=perm

// The abyssal tentacle's charges (scripts/abyssal_tentacle.rs2), the player's like the trident's.
// 10,000 per kraken tentacle, up to 20,000; one is used by every swing.
[abyssal_tentacle_charges]
scope=perm
