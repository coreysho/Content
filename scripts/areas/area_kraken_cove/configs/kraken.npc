// THE KRAKEN COVE (2026-09-21). OSRS npcs imported by tools/models/importosrsnpc.py; models re-encoded
// by osrs2ob2.py with the npc recolours baked in. Stats from the cache, bonuses from the wiki
// (oldschool.runescape.wiki/w/Cave_kraken, /w/Kraken, /w/Enormous_Tentacle), the rest by hand.
//
// HOW THE WHIRLPOOLS WORK. Each whirlpool is the npc that is actually spawned. "Disturb" turns it
// into what lives under it with npc_changetype (area_kraken_cove/scripts/kraken_combat.rs2), and
// when that dies the engine respawns the npc as the whirlpool it started as - Npc.resetEntity puts
// back baseType - after the respawnrate OF THE FORM THAT DIED (NpcOps npc_del reads the current
// type). So the respawnrate that matters is on the risen forms, not the whirlpools.
//
// All of them stand in water, so none can move (moverestrict=nomove) and melee cannot reach them.

[cave_kraken]
// OSRS npc 492. Magic only to kill: ranged does a seventh of its damage, and melee cannot reach.
name=Cave kraken
desc=A kraken from the depths of the cove.
model1=npc_cave_kraken_1
size=2
readyanim=osrs_seq_3989
walkanim=osrs_seq_3989
resizeh=55
resizev=55
op2=Attack
vislevel=127
moverestrict=nomove
wanderrange=0
respawnrate=25
attackrange=8
maxrange=10
attack=1
defence=150
strength=1
hitpoints=125
ranged=1
magic=120
param=attackrate,6
param=magicdefence,-63
param=rangedefence,100
param=attack_anim,osrs_seq_3991
param=defend_anim,osrs_seq_3990
param=death_anim,osrs_seq_3993
param=death_drop,null
param=slayer_category,^slayer_cavekraken

