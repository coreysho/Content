// Imported from a modern OSRS cache by tools/models/importosrs.py.
// Models are RE-ENCODED from OSRS model format into the 317-family format
// (tools/models/osrs2ob2.py); every one is round-trip verified before writing.
// wearpos/wearpos2/wearpos3 come from the cache - do not hand-edit them.
//
// The Kraken Cove (2026-09-21): the trident in its three states, the Kraken's two trophies and its pet.

[trident_of_the_seas]
name=Trident of the Seas
desc=A weapon from the deep.
model=obj_trident_of_the_seas
manwear=obj_trident_of_the_seas_manwear,0
womanwear=obj_trident_of_the_seas_womanwear,0
wearpos=righthand
2dzoom=2421
2dxan=1535
2dyan=1778
2dzan=108
2dxof=-7
2dyof=8
weight=1814g
cost=68500
members=yes
tradeable=no
iop2=Wield
iop3=Check
iop4=Uncharge
wearop1=Check
// OSRS's: +15 magic attack, +15 magic defence, +2/+3/+1 stab/slash/crush defence. 75 Magic to
// wield (area_kraken_cove/scripts/trident.rs2). Its own combat tab: Accurate, Accurate, Longrange,
// and no autocast (combat_powered_staff.if); a staff's animations.
category=weapon_powered_staff
param=magicattack,15
param=stabdefence,2
param=slashdefence,3
param=crushdefence,1
param=magicdefence,15
param=attackrate,4
param=ready_baseanim,human_staffready
param=crushattack_anim,human_stafforb_pummel
param=defend_anim,human_stafforb_block
param=crush_sound,staff_hit
param=attackrange,7

