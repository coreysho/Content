// TzHaar-Xil (ranged) and TzHaar-Mej (magic) in the TzHaar City.
//
// Both were typed for their real attack style but had no ranged AI, so they closed to melee.
// TzHaar-Ket and TzHaar-Hur are genuine melee attackers and correctly need nothing here.
// tzhaar_ring_throw_attack is the cache\'s own thrown-ring projectile for the Xil.

[ai_queue1,tzhaar_xil6] ~npc_default_retaliate_ap;
[ai_applayer2,tzhaar_xil6] ~npc_rangeattack;
[ai_opplayer2,tzhaar_xil6] ~npc_rangeattack;

[ai_queue1,tzhaar_mej1] ~npc_default_retaliate_ap;
[ai_queue1,tzhaar_mej2] ~npc_default_retaliate_ap;
[ai_queue1,tzhaar_mej5] ~npc_default_retaliate_ap;
[ai_queue1,tzhaar_mej7] ~npc_default_retaliate_ap;
[ai_applayer2,tzhaar_mej1] ~tzhaar_mej_attack;
[ai_applayer2,tzhaar_mej2] ~tzhaar_mej_attack;
[ai_applayer2,tzhaar_mej5] ~tzhaar_mej_attack;
[ai_applayer2,tzhaar_mej7] ~tzhaar_mej_attack;
[ai_opplayer2,tzhaar_mej1] ~tzhaar_mej_attack;
[ai_opplayer2,tzhaar_mej2] ~tzhaar_mej_attack;
[ai_opplayer2,tzhaar_mej5] ~tzhaar_mej_attack;
[ai_opplayer2,tzhaar_mej7] ~tzhaar_mej_attack;

[proc,tzhaar_mej_attack]
~npc_cast_spell_with_forced_max_hit(^fire_blast, npc_param(attackrate), 13);
