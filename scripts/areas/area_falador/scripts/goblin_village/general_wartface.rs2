[opnpc1,general_wartface]
// Recipe for Disaster, Freeing the Goblin generals, gets first refusal - the proc returns
// whether it did the talking. It lives in quest_100/scripts/hundred_goblins.rs2; wired in here
// because this trigger may only be declared once.
if (~hundred_goblin_chat(1) = true) {
    return;
}
switch_int (%goblinquest) {
    case 6 : @goblin_diplomacy_completed;
    case default : @goblin_diplomacy_greet_general_wartface;
}
