[oploc1,abyss_exit_to_air]
p_telejump(0_44_75_30_36);

[oploc1,abyss_exit_to_mind]
p_telejump(0_43_75_32_43);

[oploc1,abyss_exit_to_water]
p_telejump(0_42_75_26_38);

[oploc1,abyss_exit_to_earth]
p_telejump(0_41_75_36_43);

[oploc1,abyss_exit_to_fire]
p_telejump(0_40_75_27_36);

[oploc1,abyss_exit_to_body]
// FIXED 2026-09-08 (landing-coord audit): was (24,46), a tile buried inside the temple's north
// wall with every neighbour blocked - the player was sealed in stone. Every other abyss exit lands
// 3-4 tiles off its altar (earth altar (33,40) -> (36,43), fire (24,37) -> (27,36), water (27,35)
// -> (26,38), cosmic (29,32) -> (30,36)); body_altar is at (28,31), so (31,34) matches earth's
// offset exactly and is clear of locs.
p_telejump(0_39_75_31_34);

[oploc1,abyss_exit_to_cosmic]
// The Cosmic altar is in Zanaris: its rift wants Lost City done, as its ruins do by where they
// stand (both wikis' Cosmic rift pages). The line is 2009Scape's; no 2006 source records one.
if (%zanaris < ^zanaris_complete) {
    mes("You need to have completed the Lost City quest in order to do that.");
    return;
}
p_telejump(0_33_75_30_36);

[oploc1,abyss_exit_to_chaos]
p_telejump(0_35_75_29_40);

[oploc1,abyss_exit_to_nature]
p_telejump(0_37_75_32_44);

[oploc1,abyss_exit_to_law]
// The Law altar is on Entrana, and its rift keeps Entrana's law: no weapons or armour, worn or
// carried. RuneHQ's Abyss guide ("no weapons may be equipped or in the inventory to enter") and
// Old School (the law rift "has the same restrictions as entering Entrana") agree; only
// RuneScape 3 later let you through and stopped you at the temple's portal instead. The list is the
// Port Sarim monks' own (has_entrana_restricted_items), so an axe or a pickaxe kept from the outer
// ring counts. The line is 2009Scape's for the Law altar from the Abyss.
if (~has_entrana_restricted_items = true) {
    mes("The power of Saradomin prevents you from taking armour or weaponry to Entrana.");
    return;
}
// FIXED 2026-09-25: this rift sent you to the Nature altar (it had nature's landing tile). It now
// lands where the Law altar's mysterious ruins put you (runecraft.dbrow's runecraft_law enter_coord).
p_telejump(0_38_75_32_19);

[oploc1,abyss_exit_to_death]
// The Death altar is at the end of the Temple of Light: its rift wants Mourning's End Part II done
// (both wikis' Death rift pages). Until a 9 November 2009 patch made "the Death Altar portal in the
// Abyss ... a little more informative if you don't have the requirements" (RS wiki, Death rift), it
// said no more than the rifts that lead nowhere yet, so it says what the Blood and Soul rifts say.
if (%mourning_quest_main < ^mt_complete) {
    mes("A strange power blocks your exit.");
    return;
}
// FIXED 2026-09-25: this sent you to Lumbridge (0_50_50_0_0, a placeholder). It now lands where the
// Death altar's ruins put you (runecraft.dbrow's runecraft_death enter_coord).
p_telejump(0_34_75_32_29);

[oploc1,abyss_exit_to_blood]
mes("A strange power blocks your exit.");

[oploc1,abyss_exit_to_soul]
mes("A strange power blocks your exit.");
