[debugproc,teleabyss]
if (p_finduid(uid) = false) return;
@rcu_teleport_to_abyss;

[label,rcu_teleport_to_abyss]
%rcu_abyssal_generator = randominc(^rcu_abyss_layout_count);
def_coord $base_coord = enum(int, coord, rcu_abyss_entry_coords, %rcu_abyssal_generator);
p_telejump(map_findsquare($base_coord, 0, 5, ^map_findsquare_lineofwalk));

stat_drain(prayer, 99, 0);
~pk_skull(^rcu_pk_skull_duration);

// OSRS - Delays the player for a tick after tp'ing in
anim(null, 0);
p_delay(0);

[label,rcu_break_rock]
// The best pickaxe you have the Mining level for, worn or carried - Mining's own choice
// (skill_mining/scripts/pickaxe_checker.rs2) - swung with its own animation. Which pickaxe it is
// changes only the swing: every one has the same chance at the rock (OSRS wiki, Rock (Abyss)).
def_obj $pickaxe = ~pickaxe_checker;

if ($pickaxe = null) {
    mes("You need a pickaxe for which you have the required Mining level to mine this rock.");
    return;
}
mes("You attempt to mine your way through...");
anim(oc_param($pickaxe, mining_animation), 0);
sound_synth(mining_3, 1, 0); // guess
~rcu_loc_face_center;
p_delay(7);

if (stat_random(mining, 0, 255) = true) {
    cam_moveto(coord, 2500, 0, 0);
    cam_lookat(loc_coord, 0, 10, 10);

    %rcu_abyssal_generator = 12;
    p_delay(1);
    %rcu_abyssal_generator = 13;
    
    p_teleport(loc_param(rcu_outer_enter_coord));
    p_delay(2);

    p_telejump(loc_param(rcu_outer_inner_coord));
    p_delay(0);
    cam_reset;

    clearqueue(damage_player);
    %rcu_abyssal_generator = 0;
    ~mining_xp(250);
    mes("...and manage to break through the rock.");
} else {
    clearqueue(damage_player);
    mes("...but fail to break-up the rock.");
}

[label,rcu_chop_tendrils]
mes("You attempt to chop your way through...");

~rcu_loc_face_center;
p_delay(3);

// The best axe you have the Woodcutting level for, worn or carried - Woodcutting's own choice
// (woodcut.rs2's woodcutting_best_axe, the quiet half of woodcutting_axe_checker, whose messages
// are about trees) - swung with its own animation. Like the rock, the axe does not change the odds.
def_namedobj $axe = ~woodcutting_best_axe;

if ($axe = null) {
    mes("You need an axe to chop through the tendrils.");
    mes("You do not have an axe that you have the Woodcutting level to use.");
    return;
}
def_seq $chop = struct_param(oc_param($axe, woodcutting_struct), skill_anim);
anim($chop, 0);
sound_synth(woodchop_quick, 1, 0); // guess
p_delay(1);

if (stat_random(woodcutting, 0, 255) = true) {
    anim($chop, 0);
    sound_synth(woodchop_quick, 1, 0); // guess
    cam_moveto(coord, 2500, 0, 0);
    cam_lookat(loc_coord, 0, 10, 10);
    p_delay(1);

    %rcu_abyssal_generator = 14;
    anim($chop, 0);
    sound_synth(woodchop_quick, 1, 0); // guess
    p_delay(1);
    
    %rcu_abyssal_generator = 15;
    p_teleport(loc_param(rcu_outer_enter_coord));
    p_delay(1);

    mes("...and manage to cut a way through the tendrils.");
    p_delay(0);

    p_telejump(loc_param(rcu_outer_inner_coord));
    p_delay(0);

    cam_reset;
    clearqueue(damage_player);
    %rcu_abyssal_generator = 0;
    ~woodcutting_xp(250);
} else {
    clearqueue(damage_player);
    mes("...but fail to cut through the tendrils.");
}

[label,rcu_distract_eyes]
mes("You use your thieving skills to misdirect the eyes...");
~rcu_loc_face_center;
p_delay(1);

if (stat_random(thieving, 0, 255) = true) {
    anim(~rcu_distract_eyes_rand_anim, 0);
    cam_moveto(coord, 2500, 0, 0);
    cam_lookat(loc_coord, 0, 10, 10);
    p_delay(1);

    anim(~rcu_distract_eyes_rand_anim, 0);
    %rcu_abyssal_generator = 18;
    p_delay(1);

    %rcu_abyssal_generator = 19;
    p_teleport(loc_param(rcu_outer_enter_coord));
    p_delay(1);

    p_telejump(loc_param(rcu_outer_inner_coord));
    mes("...and sneak past while they're not looking.");
    p_delay(0);

    cam_reset;
    clearqueue(damage_player);
    %rcu_abyssal_generator = 0;
    ~thieving_xp(250);
} else {
    clearqueue(damage_player);
    mes("...but fail to distract them enough to get past.");
}

// Misdirecting the eyes plays a random emote, unlocked or not (2009Scape's AbyssPlugin draws from
// the whole emote list the same way). The list is every emote on this server's Emotes tab
// (interface_controls/scripts/emotes.rs2) that has an animation in 377 - not Slap Head or Idea
// (Stronghold emotes with no 377 animation), nor Zombie Hand or Bunny Hop (no animation wired).
[proc,rcu_distract_eyes_rand_anim]()(seq)
switch_int (random(33)) {
    case 0 : return (emote_yes);
    case 1 : return (emote_no);
    case 2 : return (emote_bow);
    case 3 : return (emote_angry);
    case 4 : return (emote_think);
    case 5 : return (emote_wave);
    case 6 : return (emote_shrug);
    case 7 : return (emote_cheer);
    case 8 : return (emote_beckon);
    case 9 : return (emote_laugh);
    case 10 : return (emote_jump_with_joy);
    case 11 : return (emote_yawn);
    case 12 : return (emote_dance);
    case 13 : return (emote_dance_scottish);
    case 14 : return (emote_dance_spin);
    case 15 : return (emote_dance_headbang);
    case 16 : return (emote_cry);
    case 17 : return (emote_blow_kiss);
    case 18 : return (emote_panic);
    case 19 : return (emote_ya_boo_sucks);
    case 20 : return (emote_clap);
    case 21 : return (emote_fremmenik_salute);
    case 22 : return (human_cave_goblin_bow);
    case 23 : return (human_cave_goblin_dance);
    case 24 : return (emote_glass_box);
    case 25 : return (emote_climbing_rope);
    case 26 : return (emote_mime_lean);
    case 27 : return (emote_glass_wall);
    case 28 : return (human_stamp);
    case 29 : return (human_chicken_dance);
    case 30 : return (zombie_walk_emote);
    case 31 : return (zombie_dance);
    case default : return (terrified_emote);
}

[label,rcu_squeeze_through_gap]
mes("You attempt to squeeze through the narrow gap...");
~rcu_loc_face_center;
p_delay(1);

anim(viking_drop_to_knee, 0);
p_delay(3);

if (stat_random(agility, 0, 255) = true) {
    // https://youtu.be/IhfNuSQukOQ?si=CwEgAlQhLc91mAPd&t=70
    // Due to camera packet buffering this looks very broken (matches osrs through), should camera packets be buffered?
    cam_moveto(coord, 2500, 0, 0);
    cam_lookat(loc_coord, 0, 10, 10);
    anim(human_crawling, 0);
    mes("...and you manage to crawl through.");
    p_telejump(loc_param(rcu_outer_inner_coord));
    sound_synth(abyssal_squeezethrough, 4, 0);
    p_delay(0);

    clearqueue(damage_player);
    %rcu_abyssal_generator = 0;
    cam_reset;
    ~agility_xp(250);
} else {
    anim(viking_drop_to_knee_and_backtoready, 0);
    mes("...but you are not agile enough to get through the gap.");
}

[label,rcu_burn_down_boil]
mes("You attempt to set the blockade on fire...");
~rcu_loc_face_center;
p_delay(2);

if (inv_total(inv, tinderbox) = 0) {
    mes("...but you don't have a tinderbox to burn it!");
    return;
}

if (stat_random(firemaking, 0, 255) = true) {
    anim(human_createfire, 0);
    cam_moveto(coord, 2500, 0, 0);
    cam_lookat(loc_coord, 0, 10, 10);
    p_delay(5);

    %rcu_abyssal_generator = 16;
    anim(human_createfire, 0);
    p_delay(5);

    %rcu_abyssal_generator = 17;
    spotanim_map(firewave_impact, loc_coord, 128, 0);
    p_teleport(loc_param(rcu_outer_enter_coord));
    sound_synth(boil_burst, 1, 0);
    p_delay(1);

    mes("...and manage to burn it down and get past.");
    p_delay(0);

    p_telejump(loc_param(rcu_outer_inner_coord));
    p_delay(0);

    clearqueue(damage_player);
    %rcu_abyssal_generator = 0;
    cam_reset;
    ~firemaking_xp(250);
} else {
    clearqueue(damage_player);
    mes("...but fail to burn it out of your way.");
}

[label,rcu_go_through_passage]
clearqueue(damage_player);
p_telejump(loc_param(rcu_outer_inner_coord));

[proc,rcu_loc_face_center]
def_int $x_off = calc(lc_width(loc_type) / 2);
def_int $z_off = calc(lc_length(loc_type) / 2);

facesquare(movecoord(loc_coord, $x_off, 0, $z_off));
