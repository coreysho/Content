// --- Door-support puzzle (dagannoth_weak_door_south/west/north, m39_158) ---
// Genuine, separate mechanic from the pressure-door room above - see the corrected header note.
// Corey confirmed (2026-09-03) killing the support already works via the generic combat pipeline
// (op2=Destroy functions as this npc's Attack-equivalent slot, same as any other monster - no
// per-npc opnpc2 trigger needed, matching how dagcave_melee_boss etc never needed one either), but
// the path stayed blocked afterwards. Found why: each corridor has a real, separate invisible
// collision loc (dagcave_invisibleblocking, id 8967, desc "A sturdy looking door, propped shut with
// a support") placed on the SAME tile as its npc - killing the npc alone never touched it. Its
// unnamed neighbour loc_8968 (id 8968, same blank model, never independently placed anywhere in the
// 660-region sweep) is the passable pair - given blockwalk=no this pass (see all.loc) and swapped to
// on death, which is what actually opens the corridor.
// Not yet modelled: the real fallen-door visual (the cache's _falling_/_fallen_ npc states) -
// spawning a fresh npc from script wasn't something I could confirm a primitive for this pass, so
// the support just vanishes on death like a normal kill for now rather than leaving fallen wreckage.
[ai_queue3,dagannoth_weak_door_south]
gosub(npc_death);
if (loc_find(^waterbirth_weakdoor_south_blocker, dagcave_invisibleblocking) = true) {
    loc_change(loc_8968, ^max_32bit_int);
}

[ai_queue3,dagannoth_weak_door_west]
gosub(npc_death);
if (loc_find(^waterbirth_weakdoor_west_blocker, dagcave_invisibleblocking) = true) {
    loc_change(loc_8968, ^max_32bit_int);
}

[ai_queue3,dagannoth_weak_door_north]
gosub(npc_death);
if (loc_find(^waterbirth_weakdoor_north_blocker, dagcave_invisibleblocking) = true) {
    loc_change(loc_8968, ^max_32bit_int);
}
