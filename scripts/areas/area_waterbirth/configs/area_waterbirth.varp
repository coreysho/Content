// dagganoth_area_project - moved out of _unpack/377/all.varp so it can be perm-scoped.
//
// This is the base varp behind [dag_island_quick_travel] (bit 13, _unpack/377/all.varbit), which is
// the multivar on Jarvald's Rellekka-side shell npc: at 0 he resolves to
// viking_dagganoth_cave_ferryman_1op (Talk-to only), at 1 to viking_dagganoth_cave_ferryman_island
// (Talk-to + Travel). The cache ships it with transmit=yes and no scope, i.e. scope=temp, so the
// quick-travel option the player unlocks by making the trip once would be forgotten on every
// logout. transmit=yes is kept - the client needs the value to resolve the multi and draw the
// right-click menu.
[dagganoth_area_project]
scope=perm
transmit=yes
