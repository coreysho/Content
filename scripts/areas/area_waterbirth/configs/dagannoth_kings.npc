[dagcave_ranged_boss]
name=Dagannoth Supreme
desc=The dagannoth king responsible for the death of the Bukalla.
model1=npc_2881
model2=npc_2881i2
vislevel=303
size=3
walkanim=dagannoth_meganoth_walk
readyanim=dagannoth_meganoth_ready
resizeh=167
resizev=165
contrast=30
ambient=30
op2=Attack
param=slayer_category,^slayer_dagannoth
hitpoints=255
attack=255
strength=255
defence=128
magic=255
ranged=255
param=rangeattack,255
param=rangebonus,255
param=stabdefence,10
param=slashdefence,10
param=crushdefence,10
param=magicdefence,255
param=rangedefence,255
param=damagetype,^ranged_style
param=attackrate,4
param=attackrange,7
param=attack_anim,dagannoth_meganoth_attack_range
// TODO: confirm a real synth name for rangeattack_sound - no all.synth dump was available to verify
// one against the 377 cache, leaving it at its param default (null) rather than guessing.
param=proj_travel,dagannoth_arrow_spotanim_travel
param=proj_height,40
param=defend_anim,dagannoth_meganoth_defend
param=death_anim,dagannoth_meganoth_death
param=death_drop,dagannoth_king_bones
// severity 16 -> first poison_damage tick = (16+4)/5 = 4, matching Supreme's real starting poison hit
param=poison_severity,16
param=retreat,0
huntmode=cowardly
huntrange=10
