// Dagannoth Kings - Waterbirth Island Dungeon (Horror from the Deep)
// Internal cache names (dagcave_*_boss) sourced from _unpack/377/all.npc, migrated here with full
// combat configuration. Base appearance/model/size/vislevel fields are the untouched raw cache values;
// everything below "op2=Attack" is new, added to wire these into the skill_combat framework.
//
// Stats sourced from the OSRS wiki (2005 launch values, i.e. explicitly EXCLUDING the 19 Jan 2017
// Dagannoth Supreme ranged defence buff 255->550, and EXCLUDING the 25 Jun 2025 "35% earth spell
// weakness" added to all three - neither existed in the 2006 era this server targets).
// Released 7 November 2005 (https://oldschool.runescape.wiki/w/Dagannoth_Rex) - predates our Jan 2006
// cutoff, so the trio is authentic content to add.
//
// Combat triangle (wiki-confirmed): Rex (melee) is weak to Magic; Prime (magic) is weak to Ranged;
// Supreme (ranged) is weak to Melee. This falls straight out of each one's low defence stat below.

// Corey (2026-09-03): "the kings need to be aggressive too" - none of the three had a huntmode, so
// none of them would ever initiate combat on their own (Rex only "worked great" because clicking
// Attack on him drives the fight entirely through retaliation, which doesn't need huntmode at all).
// huntmode=cowardly is this codebase's real, already-proven convention for "always aggressive,
// ignore the wilderness too-strong-opponent check" - confirmed via king_dragon/green_dragon in
// content/scripts/npc/configs/dragons.npc (both genuinely aggressive monsters, both use this exact
// value - the "cowardly" name is a leftover guess-label from the original cache dump, not literal
// flee behaviour, per content/scripts/_unpack/377/all.hunt's own header comments).
[dagcave_melee_boss]
name=Dagannoth Rex
desc=Firstborn of the legendary dagannoth kings.
model1=npc_2881
recol1s=6373
recol1d=8421
recol2s=7430
recol2d=9478
recol3s=1122
recol3d=10567
recol4s=16646
recol4d=13508
vislevel=303
size=3
resizeh=220
resizev=190
contrast=30
ambient=30
walkanim=dagannoth_meganoth_walk
readyanim=dagannoth_meganoth_ready
op2=Attack
param=slayer_category,^slayer_dagannoth
hitpoints=255
attack=255
strength=255
defence=255
magic=0
ranged=255
param=attackbonus,255
param=strengthbonus,255
param=stabdefence,255
param=slashdefence,255
param=crushdefence,255
param=magicdefence,10
param=rangedefence,255
param=damagetype,^slash_style
param=attackrate,4
param=attackrange,1
param=attack_anim,dagannoth_meganoth_attack_melee
param=defend_anim,dagannoth_meganoth_defend
param=death_anim,dagannoth_meganoth_death
param=death_drop,dagannoth_king_bones
param=retreat,0
huntmode=cowardly
huntrange=10

