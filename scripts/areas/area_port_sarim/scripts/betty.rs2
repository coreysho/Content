[opnpc1,betty]
~chatnpc("<p,happy>Welcome to the magic emporium.");
// The Hand in the Sand. She is the only source of the bottled water the rose lens needs, and the
// counter she stands it on is a multiloc keyed to handsand_counter_multi, so the vial is visibly
// there until it is taken. @handsand_betty is in quests/quest_handsand/scripts/handsand_npcs.rs2.
if (~handsand_betty_wanted = true) {
    @handsand_betty;
}
def_int $option = ~p_choice2("Can I see your wares?", 1, "Sorry I'm not into magic.", 2);
if($option = 1) {
    ~chatplayer("<p,quiz>Can I see your wares?");
    ~chatnpc("<p,happy>Yes.");
    ~openshop_activenpc;
} else if($option = 2) {
    ~chatplayer("<p,neutral>Sorry I'm not into magic.");
    ~chatnpc("<p,happy>Send anyone my way who is.");
}
