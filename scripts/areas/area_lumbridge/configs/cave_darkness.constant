// Darkness under Lumbridge - scripts/cave_darkness.rs2.

// OSRS wiki, Darkness: the warning after 9 seconds in the dark with no light, the insects after
// another 9 (30 ticks in all), and then a point of damage every tick in the Lumbridge Swamp Caves.
^darkness_warning_ticks = 15
^darkness_insect_ticks = 30

// The three dark squares under Lumbridge, level 0: the Lumbridge Swamp Caves (m49_149, m50_149),
// the Lost Tribe's tunnels and the goblin maze (m50_150, east of the castle cellar's hole in the
// wall), and the Dorgeshuun mine (m51_150).
^darkness_swamp_sw = 0_49_149_0_0
^darkness_swamp_ne = 0_50_149_63_63
^darkness_tunnels_sw = 0_50_150_21_0
^darkness_tunnels_ne = 0_51_150_63_63

// The Swamp Caves' way in from the swamp (swamp_cave_climbing_rope, 3169,9572) and the top of it.
// Anyone within 3 tiles of it when the insects come finds their way out instead (OSRS wiki).
^darkness_swamp_rope = 0_49_149_33_36
^darkness_swamp_rope_top = 0_49_49_32_36
