// Darkness under Lumbridge (scripts/cave_darkness.rs2). Both are written from the darkness
// softtimer, which runs without protected access, so both are protect=no; neither is saved - "the
// timer can be reset by logging out" (OSRS wiki, Light sources).

// Ticks spent in the dark with no light: the warning at 15, the insects from 30.
[darkness_insect_ticks]
protect=no

// How dark the screen is being drawn right now, 0-3 - so the overlay is only ever cleared by the
// darkness code when the darkness code put one up.
[darkness_shown]
protect=no
