// The Barrows chest: opening it, what it pays, and the brother it lets out.
//
// THE OPS ARE THE CACHE'S. barrows_stone_chest is a multiloc on barrows_chest_open: closed it
// carries Open, open it carries Search and Close. So this is a two-stage chest rather than the
// one-click loot Old School has, and each op does something - Open lets the last brother out and
// starts the shaking, Search pays, Close shuts it again.
//
// BUT THE TRIGGER GOES ON THE SHELL, not on either child. Player.getOpTrigger looks the script up
// on the type that is ON THE MAP and does not resolve the multiloc, so [oploc1,barrows_stone_chest_
// closed] is a script that compiles and can never run - which is exactly what shipped, and why the
// chest could not be opened at all. One op1 handler serves both states and branches on the same
// bit the multiloc does.
//
// WHAT IT PAYS is tools/barrowschestspec.json, which quotes the wiki: one roll plus one per
// brother killed to a ceiling of seven; per roll a piece of Barrows equipment at
// 1/(450 - 58 * brothers) and only from brothers actually killed; otherwise a value rolled in
// 1..potential and read against the bands, which ARE the "reward potential required" column.

[oploc1,barrows_stone_chest]
if (%barrows_chest_open = ^true) {
    ~barrows_chest_search;
    return;
}
p_arrivedelay;
p_stopaction;
facesquare(loc_coord);
if (%barrows_entry_crypt = ^barrows_entry_none) {
    // Nobody's run: no brothers, no potential, nothing owed. The chest still opens.
    mes("You open the chest. It is empty.");
    %barrows_chest_open = ^true;
    return;
}
mes("You open the chest...");
anim(human_openchest, 0);
p_delay(1);
%barrows_chest_open = ^true;
// THE BROTHER WHOSE CRYPT YOU CAME IN BY. He was never in his sarcophagus - the passage was - so
// this is where he turns up, unless a door already sent him or he is already dead.
def_int $bit = sub(%barrows_entry_crypt, 1);
def_npc $brother = ~barrows_brother_npc($bit);
if (testbit(%barrows_kills, $bit) = ^false & ~barrows_brother_here($brother) = ^false) {
    ~barrows_wake(coord, $brother);
    ~mesbox("<nc_name($brother)> bursts out of the darkness!");
} else {
    mes("The tunnels begin to shake and dust falls from the ceiling.");
}

[oploc2,barrows_stone_chest]
p_arrivedelay;
p_stopaction;
facesquare(loc_coord);
%barrows_chest_open = ^false;
mes("You close the chest.");

// Is he already out? A door can send the entry brother before the chest is ever opened - "if he
// did not already appear while travelling through the tunnels" - and two of him would be two sets
// of armour for one fight. The sarcophagi ask this too, for the same reason.
//
// 64 tiles reaches a whole map square and no brother stands anywhere else in the world. The last
// argument is HuntVis and it must be 0 = OFF: 1 is LINEOFSIGHT, which would answer "no" for a
// brother two rooms away and hand out a second one.
[proc,barrows_brother_here](npc $brother)(boolean)
npc_findall(coord, $brother, 64, 0);
if (npc_findnext = true) {
    return(^true);
}
return(^false);

// ---------------------------------------------------------------------------------------------
// The reward
// ---------------------------------------------------------------------------------------------
[proc,barrows_chest_search]
p_arrivedelay;
p_stopaction;
facesquare(loc_coord);
if (%barrows_entry_crypt = ^barrows_entry_none | %barrows_chest_paid = ^true) {
    mes("You search the chest and find nothing of interest.");
    return;
}
def_int $brothers = ~barrows_brothers_killed;
def_int $potential = min(add(%barrows_killed_monster,
                             multiply($brothers, ^barrows_potential_brother)),
                         ^barrows_potential_max);
if ($potential <= 0) {
    mes("You search the chest, but you have done nothing to earn its contents.");
    return;
}
anim(human_openchest, 0);
p_delay(1);
%barrows_chest_paid = ^true;
// Anything still sitting in the store belongs to a previous chest - a player who disconnected
// with the window open. It goes to the bank before this chest rolls, so the window only ever
// shows one chest's loot and there is always room for it.
~barrows_reward_flush;
def_int $rolls = min(add(^barrows_rolls_base, $brothers), ^barrows_rolls_max);
def_int $n = 0;
while ($n < $rolls) {
    ~barrows_reward_roll($brothers, $potential);
    $n = add($n, 1);
}
// COREY'S ADDITION, and the one thing here Old School does not have.
if (random(^barrows_tele_rate) = 0) {
    ~barrows_reward_add(barrows_teleport,
                        ~barrows_between(^barrows_tele_low, ^barrows_tele_high));
}
~barrows_chest_window($rolls, $potential);

// ---------------------------------------------------------------------------------------------
// The reward window
// ---------------------------------------------------------------------------------------------
// The chest pays into barrows_reward_store and the window IS that store - an inv component, so
// the client draws the icons, the stack counts and the hover names for nothing. The alternative,
// which is what shipped first, was a chatbox line and items appearing in the inventory: you could
// not see what the run had paid, and a full inventory quietly sent things to the bank.
//
// The store is scope=perm for the same reason: a disconnect between the roll and the last click
// must not lose a set piece out of a run that is already over.
[proc,barrows_chest_window](int $rolls, int $potential)
inv_transmit(barrows_reward_store, barrows_chest:loot);
if_settext(barrows_chest:subtitle,
           "<~pluralise($rolls, "roll")> at <tostring($potential)> reward potential");
if_openmain(barrows_chest);

[if_close,barrows_chest]
inv_stoptransmit(barrows_chest:loot);
~barrows_reward_flush;

[inv_button1,barrows_chest:loot] ~barrows_reward_take(last_slot);
[inv_button2,barrows_chest:loot] ~barrows_reward_takeall;
[inv_button3,barrows_chest:loot] ~barrows_reward_bank(last_slot);
[if_button,barrows_chest:takeall] ~barrows_reward_takeall;

[proc,barrows_reward_add](namedobj $obj, int $count)
inv_add(barrows_reward_store, $obj, $count);

// One slot, as much of it as will fit. A stack that will not fit at all says so and stays put
// rather than half-vanishing.
[proc,barrows_reward_take](int $slot)
def_obj $obj = inv_getobj(barrows_reward_store, $slot);
if ($obj = null) {
    return;
}
def_int $count = inv_getnum(barrows_reward_store, $slot);
def_int $take = $count;
if (oc_stackable($obj) = ^false) {
    $take = min($count, inv_freespace(inv));
} else if (inv_itemspace(inv, $obj, $count, inv_size(inv)) = ^false) {
    $take = 0;
}
if ($take <= 0) {
    mes("You do not have enough room to take that.");
    return;
}
inv_moveitem(barrows_reward_store, inv, $obj, $take);

[proc,barrows_reward_takeall]
~storage_empty_to_inv(barrows_reward_store, "chest");

[proc,barrows_reward_bank](int $slot)
def_obj $obj = inv_getobj(barrows_reward_store, $slot);
if ($obj = null) {
    return;
}
inv_moveitem(barrows_reward_store, bank, $obj, inv_getnum(barrows_reward_store, $slot));
mes("<oc_name($obj)> has been sent to your bank.");

// WHAT IS LEFT IS NOT LOST. Closing the window banks the remainder, which is the only ending that
// cannot cost a player a set piece: the inventory may be full, the run is over, and the chest
// will not pay twice.
[proc,barrows_reward_flush]
def_int $slot = 0;
def_int $moved = 0;
while ($slot < inv_size(barrows_reward_store)) {
    def_obj $obj = inv_getobj(barrows_reward_store, $slot);
    if ($obj ! null) {
        def_int $count = inv_getnum(barrows_reward_store, $slot);
        inv_moveitem(barrows_reward_store, bank, $obj, $count);
        $moved = add($moved, 1);
    }
    $slot = add($slot, 1);
}
if ($moved > 0) {
    mes("The chest sent <~pluralise($moved, "item")> to your bank.");
}

[proc,barrows_reward_roll](int $brothers, int $potential)
// A PIECE OF ARMOUR FIRST, and only from a brother who was killed: 1/(450 - 58 * brothers), which
// is 1/392 with one down and 1/102 with all six. With none down there is no piece to give.
def_int $odds = sub(^barrows_equip_base, multiply(^barrows_equip_step, $brothers));
if ($brothers > 0 & random($odds) = 0) {
    def_int $bit = ~barrows_nth_killed(random($brothers));
    def_int $piece = add(multiply($bit, ^barrows_equip_pieces), random(^barrows_equip_pieces));
    ~barrows_reward_add(enum(int, namedobj, barrows_equipment, $piece), 1);
    return;
}
// "A roll is performed for a value between 1 and your reward potential (each inclusive)", and the
// reward is the last band that roll reached.
def_int $roll = add(random($potential), 1);
if ($roll >= ^barrows_rp_dragonmed) {
    ~barrows_reward_add(dragon_med_helm, 1);
} else if ($roll >= ^barrows_rp_keyhalf) {
    // "Key halves, 1 each" - the crystal key's tooth end and loop end, one or the other.
    if (random(2) = 0) {
        ~barrows_reward_add(keyhalf1, 1);
    } else {
        ~barrows_reward_add(keyhalf2, 1);
    }
} else if ($roll >= ^barrows_rp_boltrack) {
    ~barrows_reward_add(barrows_karil_ammo,
                    ~barrows_between(^barrows_loot_boltrack_low, ^barrows_loot_boltrack_high));
} else if ($roll >= ^barrows_rp_blood) {
    ~barrows_reward_add(bloodrune, ~barrows_between(^barrows_loot_blood_low, ^barrows_loot_blood_high));
} else if ($roll >= ^barrows_rp_death) {
    ~barrows_reward_add(deathrune, ~barrows_between(^barrows_loot_death_low, ^barrows_loot_death_high));
} else if ($roll >= ^barrows_rp_chaos) {
    ~barrows_reward_add(chaosrune, ~barrows_between(^barrows_loot_chaos_low, ^barrows_loot_chaos_high));
} else if ($roll >= ^barrows_rp_mind) {
    ~barrows_reward_add(mindrune, ~barrows_between(^barrows_loot_mind_low, ^barrows_loot_mind_high));
} else {
    ~barrows_reward_add(coins, ~barrows_between(^barrows_loot_coins_low, ^barrows_loot_coins_high));
}

// Inclusive both ends, which is how every quantity in the wiki's table is written.
[proc,barrows_between](int $low, int $high)(int)
return(add($low, random(add(sub($high, $low), 1))));

// The $n-th brother who IS dead, counting from 0 - the mirror of ~barrows_nth_unkilled, and what
// makes the equipment table reachable only through a brother the player actually beat.
[proc,barrows_nth_killed](int $n)(int)
def_int $bit = 0;
while ($bit < ^barrows_brothers) {
    if (testbit(%barrows_kills, $bit) = ^true) {
        if ($n = 0) {
            return($bit);
        }
        $n = sub($n, 1);
    }
    $bit = add($bit, 1);
}
return(-1);
