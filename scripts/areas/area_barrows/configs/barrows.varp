// Which of the six brothers this player has killed on the run they are on. One bit each,
// ^barrows_bit_* in barrows.constant.
//
// scope=perm rather than temp: a run survives a logout in Old School, and a player who logs out
// mid-Barrows and comes back to six live brothers has lost the run they were doing.
//
// protect=no because the writer is a brother's death, which runs in npc context: npc_findhero
// gives that script the player, but not PROTECTED access to him, and a protected var refuses the
// write - "Attempt to access uninitialized pointer [ 'p_active_player' ]" at compile time. The
// alternative is temple_guardian.rs2's p_finduid-or-queue dance, which is what a protected var
// forces; protect=no is both shorter and more reliable here, because the bit then lands even when
// the player is in the middle of another protected script, and mage_arena_2.rs2 marks its own
// npc-death-written progress var exactly the same way.
[barrows_killed]
protect=no
scope=perm
