// Lokar Searunner - imported from the rev 474 cache (npc 4536) by tools/models/importnpc474.py.
// Models copied byte-for-byte, recolours through the RGB15 preimage table. His own stance and walk
// (474 seqs 7188/7191) are one frame group of 452 frames, so he stands and walks as a plain human.
//
// In 2007 he sailed Rellekka to Pirates' Cove, and Lunar Diplomacy took you on from there. This
// build has neither the quest nor the cove, so he sails straight to Lunar Isle
// (area_lunar_isle/scripts/lunar_isle.rs2) - one Lokar on each pier, both the same config.

[lokar_searunner]
name=Lokar Searunner
desc=A Fremennik sailor, who apparently had a stint as a pirate.
model1=npc_lokar_searunner_1
model2=npc_lokar_searunner_2
model3=npc_lokar_searunner_3
model4=npc_lokar_searunner_4
model5=npc_lokar_searunner_5
model6=npc_lokar_searunner_6
