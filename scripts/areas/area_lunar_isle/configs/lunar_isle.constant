// Lunar Isle (area_lunar_isle/scripts/lunar_isle.rs2).

// The Magic level the Astral altar asks before it gives you the Lunar spellbook - this server's choice,
// in place of Lunar Diplomacy's 65 Magic and the quest itself.
^lunar_unlock_magic = 65

// Lokar's two ends. Lunar Isle is everything north of z 3800, Rellekka everything south: which way he
// sails is which side of that you are on.
^lunar_isle_south_z = 3800
// the shore at the west end of Lunar Isle's pier (2113,3892) - the pier itself is 474's plane-1 walkway
// with no bridge flag, so it cannot be walked onto from the ground and is not landed on
^lunar_isle_pier = 0_33_60_1_52
// the end of Rellekka's long pier (2628,3700), beside the Miscellania sailor
^lunar_isle_rellekka_pier = 0_41_57_4_52
