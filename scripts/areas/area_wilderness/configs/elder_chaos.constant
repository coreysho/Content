// The elder chaos druid, and the robes it drops.

// Its maximum hit. OSRS's own 17, and the only damage number it has: the npc carries no attack or
// defence bonuses at all, so the roll is 110 Magic against your defence and this is the spread.
^elder_chaos_maxhit = 17

// The robe drop, as OSRS builds it: one kill in 129 reaches the robe table, and three of its eleven
// slots are elder chaos pieces - one each. 129 x 11 / 3 = 473 per piece if it were flat, but the
// pieces are one slot each out of eleven, which is 1 in 1,419 for any one of them. Both numbers
// are here because the table below rolls them in that order, exactly as the wiki describes it.
^elder_chaos_table = 129
^elder_chaos_slots = 11
