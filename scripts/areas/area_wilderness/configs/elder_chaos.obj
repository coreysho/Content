// The elder chaos druid robes - top, robe and hood.
//
// IMPORTED from a modern OSRS cache (objs 20517, 20520 and 20595) by tools/models/importosrs.py,
// which re-encodes the models into the 317-family format. Models, recolours, the 2d camera, weight
// and the wearpos rows are the cache's own; the ops, the params and the equip gate are by hand.
//
// The set is best-in-slot magic armour for anything with no Defence, which is the whole point of it:
// the bonuses below are OSRS's own and there is no Defence requirement, only 40 Magic
// (levelrequire/scripts/tier40.rs2). OSRS also gives each piece +1% magic damage; this build has no
// magic damage system to hang that on, so it is the one bonus that could not come across.
//
// They drop from the elder chaos druid at the Chaos altar in level 13 Wilderness - one piece in
// 1,419 kills each, as in OSRS. See scripts/elder_chaos_druid.rs2 and claude/max-cape.md.

[elder_chaos_top]
name=Elder chaos top
desc=The robes worn by the dangerous elder druids.
model=obj_elder_chaos_top
manwear=obj_elder_chaos_top_manwear,0
manwear2=obj_elder_chaos_top_manwear2
womanwear=obj_elder_chaos_top_womanwear,0
womanwear2=obj_elder_chaos_top_womanwear2
wearpos=torso
wearpos2=arms
2dzoom=1503
2dxan=553
2dxof=-1
2dyof=3
recol1s=32767
recol1d=15425
iop2=Wear
weight=200g
cost=800
members=yes
param=magicattack,10
param=magicdefence,8
param=levelrequire,40

[elder_chaos_robe]
name=Elder chaos robe
desc=The robes worn by the dangerous elder druids.
model=obj_elder_chaos_robe
manwear=obj_elder_chaos_robe_manwear,0
womanwear=obj_elder_chaos_robe_womanwear,0
wearpos=legs
2dzoom=2281
2dxan=512
2dyan=14
2dzan=69
2dxof=-3
2dyof=-11
iop2=Wear
weight=180g
cost=700
members=yes
param=magicattack,6
param=magicdefence,6
param=levelrequire,40

[elder_chaos_hood]
name=Elder chaos hood
desc=The hood worn by the dangerous elder druids.
model=obj_elder_chaos_hood
manwear=obj_elder_chaos_hood_manwear,0
womanwear=obj_elder_chaos_hood_womanwear,0
manhead=obj_elder_chaos_hood_manhead
womanhead=obj_elder_chaos_hood_womanhead
wearpos=hat
wearpos2=head
wearpos3=jaw
2dzoom=789
2dxan=346
2dyan=55
2dzan=1757
2dxof=-4
2dyof=-7
iop2=Wear
weight=180g
cost=500
members=yes
param=magicattack,5
param=magicdefence,4
param=levelrequire,40
