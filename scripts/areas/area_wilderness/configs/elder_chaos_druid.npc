// The elder chaos druid.
//
// IMPORTED from a modern OSRS cache (npc 6607) by tools/models/importosrsnpc.py, which re-encodes
// the models with the npc's recolours baked in. The models, the name, the level and all six combat
// stats below are the cache's own numbers; the animations are 377's human set (OSRS's are the same
// 2004 animations under different ids, so there is nothing to convert), and the lines under the
// stats are by hand from the wiki's monster block: aggressive and staying that way, 4-tick attack
// speed, magic only, and not one attack or defence bonus anywhere on it - all of its threat is in
// the 110 Magic and the 17s it hits for.
//
// It drops the elder chaos robes, one piece in 1,419 kills each, which is what it is for. The
// drop table is in drop_tables/scripts/elder_chaos_druid.rs2 and the casting is in
// scripts/elder_chaos_druid.rs2, both beside the ordinary chaos druid's.
//
// ERA NOTE: the robes are a 2018 Old School item and the druid that drops them a 2015 one, which
// makes this the third knowing anachronism in the repo after the boss pets and the Max cape. What
// is NOT an anachronism is where it stands: the Chaos altar at 3239,3608 is in this 2006 map
// already, in level 13 Wilderness, exactly where OSRS later built the temple around it.

[elder_chaos_druid]
// OSRS npc 6607
name=Elder Chaos druid
model1=npc_elder_chaos_druid_1
model2=npc_elder_chaos_druid_2
model3=npc_elder_chaos_druid_3
model4=npc_elder_chaos_druid_4
model5=npc_elder_chaos_druid_5
model6=npc_elder_chaos_druid_6
model7=npc_elder_chaos_druid_7
readyanim=human_ready
walkanim=human_walk_f
op2=Attack
vislevel=129
attack=98
defence=65
strength=98
hitpoints=150
ranged=1
magic=110
respawnrate=50
attackrange=8
huntrange=8
huntmode=ranged
param=attackrate,4
param=damagetype,^magic_style
