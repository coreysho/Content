~skillguide_row(13, $lvl, 15, trout, "Trout");
~skillguide_row(14, $lvl, 18, cod, "Cod");
~skillguide_row(15, $lvl, 20, meat_pie, "Meat pie");
~skillguide_row(16, $lvl, 20, pike, "Pike");
~skillguide_row(17, $lvl, 25, salmon, "Salmon");
~skillguide_row(18, $lvl, 25, stew, "Stew");
