// Cooking skill guide, shown on the original RS2 skill guide interface
// (see content/scripts/interfaces/skill_guide.rs2 for the generic driver).
// Three category buttons, so it needs the open/render split: the buttons call
// ~cooking_guide_render through ~skillguide_selectpage without resetting the page.
[proc,open_cooking_guide]
%skillguide_page = 2;
~cooking_guide_render;

[proc,cooking_guide_render]
~skillguide_begin(^guide_cooking, "Cooking");
~skillguide_panels(3);
~skillguide_button(2, "Food");
~skillguide_button(3, "Drinks");
~skillguide_button(4, "Misc");
def_int $lvl = stat(cooking);
switch_int (%skillguide_page) {
    case 3 : ~cooking_guide_drinks($lvl);
    case 4 : ~cooking_guide_misc($lvl);
    case default : ~cooking_guide_food($lvl);
}
~skillguide_show;

[proc,cooking_guide_food](int $lvl)
~skillguide_row(1, $lvl, 1, cooked_meat, "Cooked meat");
~skillguide_row(2, $lvl, 1, shrimp, "Shrimp");
~skillguide_row(3, $lvl, 1, anchovies, "Anchovies");
~skillguide_row(4, $lvl, 1, sardine, "Sardine");
~skillguide_row(5, $lvl, 1, cooked_ugthanki_meat, "Ugthanki meat");
~skillguide_row(6, $lvl, 1, cooked_chicken, "Cooked chicken");
~skillguide_row(7, $lvl, 1, bread, "Bread");
~skillguide_row(8, $lvl, 5, herring, "Herring");
~skillguide_row(9, $lvl, 7, potato_baked, "Baked potato");
~skillguide_row(10, $lvl, 10, redberry_pie, "Redberry pie");
~skillguide_row(11, $lvl, 10, mackerel, "Mackerel");
