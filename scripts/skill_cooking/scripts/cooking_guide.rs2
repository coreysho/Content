// Cooking skill guide, shown on the original RS2 skill guide interface
// (see content/scripts/interfaces/skill_guide.rs2 for the generic driver).
// Replaces the old single-page ~book(...) popup.
[proc,open_cooking_guide]
~skillguide_begin("Cooking");
def_int $lvl = stat(cooking);
~skillguide_row(1, $lvl, 1, cooked_meat, "Cooked meat");
~skillguide_row(2, $lvl, 1, shrimp, "Shrimp");
~skillguide_row(3, $lvl, 1, anchovies, "Anchovies");
~skillguide_row(4, $lvl, 1, cooked_ugthanki_meat, "Ugthanki meat");
~skillguide_row(5, $lvl, 1, cooked_chicken, "Cooked chicken");
~skillguide_row(6, $lvl, 1, bread, "Bread");
~skillguide_row(7, $lvl, 1, soda_ash, "Soda ash");
~skillguide_row(8, $lvl, 1, swamppaste, "Swamp paste");
~skillguide_row(9, $lvl, 5, herring, "Herring");
~skillguide_row(10, $lvl, 7, potato_baked, "Baked potato");
~skillguide_row(11, $lvl, 10, redberry_pie, "Redberry pie");
~skillguide_row(12, $lvl, 10, mackerel, "Mackerel");
~skillguide_row(13, $lvl, 10, giant_carp, "Giant carp");
~skillguide_row(14, $lvl, 15, trout, "Trout");
~skillguide_row(15, $lvl, 18, cod, "Cod");
~skillguide_row(16, $lvl, 20, meat_pie, "Meat pie");
~skillguide_row(17, $lvl, 20, pike, "Pike");
~skillguide_row(18, $lvl, 25, salmon, "Salmon");
~skillguide_row(19, $lvl, 25, stew, "Stew");
~skillguide_row(20, $lvl, 30, apple_pie, "Apple pie");
~skillguide_row(21, $lvl, 30, tuna, "Tuna");
~skillguide_row(22, $lvl, 35, plain_pizza, "Plain pizza");
~skillguide_row(23, $lvl, 40, cake, "Cake");
~skillguide_row(24, $lvl, 40, lobster, "Lobster");
~skillguide_row(25, $lvl, 43, bass, "Bass");
~skillguide_row(26, $lvl, 45, swordfish, "Swordfish");
~skillguide_row(27, $lvl, 50, cooked_oomlie, "Cooked oomlie wrap");
~skillguide_row(28, $lvl, 53, lava_eel, "Lava eel");
~skillguide_row(29, $lvl, 58, pitta_bread, "Pitta bread");
~skillguide_row(30, $lvl, 60, curry, "Curry");
~skillguide_row(31, $lvl, 80, shark, "Shark");
~skillguide_row(32, $lvl, 82, seaturtle, "Sea turtle");
~skillguide_row(33, $lvl, 91, mantaray, "Manta ray");
~skillguide_show;
