// Opens the new scrollable, icon-based Cooking Guide (content/scripts/skill_cooking/interfaces/cooking_guide.if).
// Replaces the old single-page ~book(...) popup for Cooking only - pilot for the other skill guides.
[proc,open_cooking_guide]
if_setobject(cooking_guide:r1_icon, cooked_meat, 500);
if_setobject(cooking_guide:r2_icon, shrimp, 500);
if_setobject(cooking_guide:r3_icon, anchovies, 500);
if_setobject(cooking_guide:r4_icon, cooked_ugthanki_meat, 500);
if_setobject(cooking_guide:r5_icon, cooked_chicken, 500);
if_setobject(cooking_guide:r6_icon, bread, 500);
if_setobject(cooking_guide:r7_icon, soda_ash, 500);
if_setobject(cooking_guide:r8_icon, swamppaste, 500);
if_setobject(cooking_guide:r9_icon, herring, 500);
if_setobject(cooking_guide:r10_icon, potato_baked, 500);
if_setobject(cooking_guide:r11_icon, redberry_pie, 500);
if_setobject(cooking_guide:r12_icon, mackerel, 500);
if_setobject(cooking_guide:r13_icon, giant_carp, 500);
if_setobject(cooking_guide:r14_icon, trout, 500);
if_setobject(cooking_guide:r15_icon, cod, 500);
if_setobject(cooking_guide:r16_icon, meat_pie, 500);
if_setobject(cooking_guide:r17_icon, pike, 500);
if_setobject(cooking_guide:r18_icon, salmon, 500);
if_setobject(cooking_guide:r19_icon, stew, 500);
if_setobject(cooking_guide:r20_icon, apple_pie, 500);
if_setobject(cooking_guide:r21_icon, tuna, 500);
if_setobject(cooking_guide:r22_icon, plain_pizza, 500);
if_setobject(cooking_guide:r23_icon, cake, 500);
if_setobject(cooking_guide:r24_icon, lobster, 500);
if_setobject(cooking_guide:r25_icon, bass, 500);
if_setobject(cooking_guide:r26_icon, swordfish, 500);
if_setobject(cooking_guide:r27_icon, cooked_oomlie, 500);
if_setobject(cooking_guide:r28_icon, lava_eel, 500);
if_setobject(cooking_guide:r29_icon, pitta_bread, 500);
if_setobject(cooking_guide:r30_icon, curry, 500);
if_setobject(cooking_guide:r31_icon, shark, 500);
if_setobject(cooking_guide:r32_icon, seaturtle, 500);
if_setobject(cooking_guide:r33_icon, mantaray, 500);
if_openmain(cooking_guide);

[if_button,cooking_guide:close]
if_close;

