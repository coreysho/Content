// Cooking skill guide. Five category buttons. Pies and Pizzas are recipe pages -
// they walk the actual implemented chain in order (dough -> shell -> filling ->
// cook), so the level column is the level that step needs, repeating where a step
// has none.
[proc,open_cooking_guide]
%skillguide_page = 2;
~cooking_guide_render;

[proc,cooking_guide_render]
~skillguide_begin(^guide_cooking, "Cooking");
~skillguide_panels(5);
~skillguide_button(2, "Food");
~skillguide_button(3, "Drinks");
~skillguide_button(4, "Misc");
~skillguide_button(5, "Pies");
~skillguide_button(6, "Pizzas");
def_int $lvl = stat(cooking);
switch_int (%skillguide_page) {
    case 3 : ~cooking_guide_drinks($lvl);
    case 4 : ~cooking_guide_misc($lvl);
    case 5 : ~cooking_guide_pies($lvl);
    case 6 : ~cooking_guide_pizzas($lvl);
    case default : ~cooking_guide_food($lvl);
}
~skillguide_show;

[proc,cooking_guide_food](int $lvl)
~skillguide_row(1, $lvl, 1, cooked_meat, "Cooked meat");
~skillguide_row(2, $lvl, 1, shrimp, "Shrimp");
