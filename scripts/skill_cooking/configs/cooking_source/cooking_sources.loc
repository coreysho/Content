// ---------------------------------------------------------------------------------------------
// The ranges that looked like ranges and were not
// ---------------------------------------------------------------------------------------------
// Reported from play as "Rimmington range isn't coded", and it was one of five. Cooking is driven
// entirely off category: [oplocu,_cooking_oven] in skill_cooking/scripts/cooking.rs2 fires for
// anything categorised cooking_oven and for nothing else. These five sat in all.loc with no
// category at all - each one named Range or Cooking range, each one describing itself as ideal for
// cooking on, each one placed on a real map square, and not one of them able to cook anything.
//
//   rimmington_poor_range   m46_50 (Rimmington), m47_57, m51_61
//   ahoy_range              m57_54
//   elf_village_range       m36_49 (Lletya)
//   fairy_range             m37_69 (Zanaris)
//   loc_14919               m36_57
//
// They are moved here rather than categorised where they lay, because this file is already where
// the cooking sources live - [range] and its three siblings were taken out of all.loc the same way.
//
// THREE OTHER UNCATEGORISED RANGES ARE LEFT ALONE, deliberately: carnilleanrange, newbierange and
// viking_seer_range each have their own [oplocu] handler in a quest or the tutorial, and a specific
// trigger beats a category one - so categorising them would change nothing except to suggest a
// second path that can never run.
bgsound=fire_crackling_small,5

[rimmington_poor_range]
name=Range
desc=Ideal for cooking on.
model=rimmington_poor_range
length=2
forceapproach=east
category=cooking_oven

[ahoy_range]
name=Cooking range
desc=An appliance for cooking with.
