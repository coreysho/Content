// Cooking skill guide. Restyled 2026-09-05 to match the modern OSRS skill-guide look Corey
// referenced: a titlescroll banner, a parchment (chatback) sheet, and rows read level-first
// (level | item icon | name) instead of the old icon | name | level order on a black slab.
// Every row now uses its real item model rather than the com_i32 placeholder all 33 shared.
// Row data and the per-row unlocked/locked colour script are carried over unchanged.
type=overlay

[backdrop]
type=rect
x=0
y=0
width=512
height=334
fill=yes
colour=0x000000

[bg1]
type=graphic
x=6
y=48
width=479
height=96
graphic=chatback,0

[bg2]
type=graphic
x=6
y=144
width=479
height=96
graphic=chatback,0

[bg3]
type=graphic
x=6
y=240
width=479
height=96
graphic=chatback,0

[banner]
type=graphic
x=4
y=0
width=503
height=47
graphic=titlescroll,0

[title]
type=text
x=8
y=14
width=496
height=16
center=yes
font=b12_full
text=Cooking
colour=0x3A2612

[subtitle]
type=text
x=8
y=30
width=496
height=14
center=yes
font=p11_full
text=Food
colour=0x5A4C32

