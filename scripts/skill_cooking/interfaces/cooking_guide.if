// Cooking skill guide, restyled 2026-09-05 to match the OSRS skill-guide screenshot Corey
// referenced. Geometry and colours are measured off that screenshot rather than guessed: its
// parchment is 0xB29C77 on a 0xA38F6E page, item text 0x3A2400, the list panel spans x18-338 with
// the scrollbar inside its right edge, the category box sits at x352, and rows are 28px apart.
// Flat fills instead of tiled chatback - tiling that 479x96 sprite banded the sheet and left a
// black strip past x485, which is what made the first attempt look wrong.
type=overlay

[backdrop]
type=rect
x=0
y=0
width=512
height=334
fill=yes
colour=0xA38F6E

[bg1]
type=rect
x=18
y=58
width=320
height=268
fill=yes
colour=0xB29C77

[bg2]
type=rect
x=18
y=58
width=320
height=268
fill=no
colour=0x5A4423

[bg3]
type=rect
x=352
y=58
width=148
height=92
fill=yes
colour=0xB29C77

[side_panel]
type=rect
x=352
y=58
width=148
height=92
fill=no
colour=0x5A4423

[banner]
type=graphic
x=4
y=0
width=503
height=47
graphic=titlescroll,0

[title]
type=text
x=8
y=16
width=496
height=18
center=yes
font=b12_full
text=Cooking
colour=0x3A2400

