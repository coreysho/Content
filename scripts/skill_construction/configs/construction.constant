// Construction room templates, imported from the rev 474 cache (tools/models/import474map.py).
// Each house style is one level of one square; each room one 8x8 zone at the same offset in every style.
//   m29_79 levels 0-3 and m30_79 levels 0-1 = the six styles.
^poh_templates_a = 0_29_79_0_0
^poh_templates_b = 0_30_79_0_0
// Where a player lands leaving a house: 9,24 - the OSRS house portal's own tile (2953,3224), which
// is now the tile directly east of the rotated portal's east edge.
^poh_exit = 0_46_50_9_24

// ---- the saved house layout (poh.rs2, 2026-09-11) ----
// The grid is ^poh_grid x ^poh_grid rooms on the ground floor. Eight is more than OSRS ever needs
// and still fits four rooms to a varp with the 8x8-zone instance slot to spare.
^poh_grid = 8
// Where the grid starts inside the 16x16-zone instance slot. The margin matters: a wall on a room's
// edge flags the tile across that edge, so the outermost rooms need somewhere to spill into.
^poh_grid_origin = 4
// Where inside a room the player lands. (3,2) is what the test house used and is proven walkable in
// a garden; it is floor in every room template that has one.
^poh_spawn_x = 3
^poh_spawn_z = 2

// Door sides. The order is the rotation order - rotating a room 90 degrees rotates the mask left
// by one - so these four values may not be renumbered independently.
^poh_door_n = 1
^poh_door_e = 2
^poh_door_s = 4
^poh_door_w = 8

// Room types; the tables live in poh_rooms.enum.
^poh_room_garden = 1
^poh_room_parlour = 2
^poh_room_kitchen = 3
^poh_room_dining_room = 4
^poh_room_bedroom = 5
^poh_room_workshop = 6
^poh_room_chapel = 7
^poh_room_study = 8
^poh_room_throne_room = 9
^poh_room_portal_chamber = 10
^poh_room_combat_room = 11
^poh_room_games_room = 12
^poh_room_skill_hall = 13
^poh_room_quest_hall = 14
^poh_room_costume_room = 15
// How many room types there are. Anything that walks the list reads this rather than 15.
^poh_room_count = 15

// ---- the portal round (poh_portal.rs2, 2026-09-11) ----
// What the estate agent charges for the plot, the garden and the parlour.
^poh_house_cost = 1000
// Where the exit portal stands inside the entry room, in that room's own 8x8 tiles: (3,3) to (4,4),
// the middle. That is the garden's CENTREPIECE slot - loc474_15361 "Centrepiece space", 2x2, sits on
// exactly those tiles in the template - and OSRS loc 4525 is a centrepiece, one of the same family as
// the Tree, Pond and Statue in category 206. Putting it in a corner (the first attempt) was avoiding
// the door hotspots, which sit in the MIDDLE of each SIDE (x 3-4 north and south, z 3-4 east and
// west) and are nowhere near the middle of the room.
// The player lands at (3,2), directly south of it.
^poh_exit_portal_x = 3
^poh_exit_portal_z = 3
// How long a spawned loc inside a house lasts. loc_add rejects 0, and there is no "forever" - but
// the instance is purged on the way out, which takes the portal with it, so this only has to
// outlast one visit. Two million cycles is about a fortnight.
^poh_loc_duration = 2000000

// How long ::~pohportal's probe stands. 300 ticks is three minutes - long enough to walk round it
// and look, short enough that a forgotten one does not block the road.
^poh_portal_probe_ticks = 300

// ---- the sawmill (sawmill.rs2, 2026-09-11) ----
// What the operator charges to cut one plank. These are NOT invented: they are the `cost` the OSRS
// cache carries on each plank item (oak 250, teak 500, mahogany 1500). Obj 960 "Plank" has no cost
// at all in the cache, so 100 is the one number here that is a choice.
^sawmill_fee_plank = 100
^sawmill_fee_oak = 250
^sawmill_fee_teak = 500
^sawmill_fee_mahogany = 1500
// The two tools Construction needs. The saw's cache cost is 10, which is a shop's buy price rather
// than what a player pays; both are priced to be a non-event next to a 1000-coin house.
^sawmill_cost_saw = 100
^sawmill_cost_hammer = 100

// ---- furniture (poh_furniture.rs2) ----
// GENERATED by tools/genfurn.py from tools/furnspec.json, along with the varps, the enum
// tables and all of poh_furniture.rs2.
//
// How many pieces one house can hold, and how many buildable things there are.
^poh_furn_slots = 256
^poh_furn_items = 238

// The bit layout of one packed piece. 23 bits, so it fits an int with room to spare.
^poh_furn_bit_rx = 0
^poh_furn_bit_rz = 3
^poh_furn_bit_lx = 6
^poh_furn_bit_lz = 9
^poh_furn_bit_angle = 12
^poh_furn_bit_item = 14
^poh_furn_bit_lit = 22

// Construction experience per plank. OSRS's furniture xp is very nearly planks x this, so it
// is one rule rather than 238 rows of remembered numbers - and it is the obvious thing to tune.
^poh_xp_plank = 29
^poh_xp_oak = 60
^poh_xp_teak = 90
^poh_xp_mahogany = 140


// ---- what the furniture does (poh_furn_ops.rs2) ----
// What a house altar pays for bones, as a percentage of the burying experience: the base for
// the plainest altar, a step per tier above it, and a bonus for every lit thing in the same
// room. OSRS pays 250% to 350% and another 50% a burner. NOT cache data - tune away.
^poh_altar_base = 250
^poh_altar_step = 15
^poh_altar_burner = 25

// The furniture families, one per hotspot kind. A hotspot's trigger passes its own family in,
// so nothing has to look one up. NEVER REORDER: item numbers follow family order and item
// numbers are what is stored in a save.
^poh_fam_stove = 1
^poh_fam_sink = 2
^poh_fam_larder = 3
^poh_fam_shelves = 4
^poh_fam_kitchentable = 5
^poh_fam_barrel = 6
^poh_fam_diningtable = 7
^poh_fam_bench = 8
^poh_fam_bellpull = 9
^poh_fam_bed = 10
^poh_fam_wardrobe = 11
^poh_fam_clock = 12
^poh_fam_chair = 13
^poh_fam_bookcase = 14
^poh_fam_fireplace = 15
^poh_fam_dresser = 16
^poh_fam_catbasket = 17
^poh_fam_workbench = 18
^poh_fam_tool = 19
^poh_fam_clockmaking = 20
^poh_fam_repair = 21
^poh_fam_heraldry = 22
^poh_fam_altar = 23
^poh_fam_icon = 24
^poh_fam_torch = 25
^poh_fam_statue = 26
^poh_fam_musical = 27
^poh_fam_lectern = 28
^poh_fam_globe = 29
^poh_fam_crystalball = 30
^poh_fam_telescope = 31
^poh_fam_wallchart = 32
^poh_fam_throne = 33
^poh_fam_throneseat = 34
^poh_fam_lever = 35
^poh_fam_thronedecor = 36
^poh_fam_game = 37
^poh_fam_prizechest = 38
^poh_fam_attackstone = 39
^poh_fam_elemental = 40
^poh_fam_ranging = 41
^poh_fam_armourstand = 42
^poh_fam_runecase = 43
^poh_fam_headtrophy = 44
^poh_fam_fishtrophy = 45
^poh_fam_portrait = 46
^poh_fam_landscape = 47
^poh_fam_guildtrophy = 48
^poh_fam_sword = 49
^poh_fam_map = 50
^poh_fam_treasurechest = 51

// ---- the build windows (poh_roommenu.if, poh_furnmenu.if) ----
// The camera the model icons are drawn with. The two angles are shared; the ZOOM is not, because
// zoom is a divisor and a bed and a bell-pull cannot share one - tools/ifmodels.py solves a zoom
// per model from its own geometry into ~poh_room_zoom and ~poh_furn_zoom.
^poh_menu_xan = 150
^poh_menu_yan = 40
// How many entries each window shows at once. These are the window's geometry, not a preference:
// tools/genmenus.py lays out exactly this many rows and slots and writes the same numbers here.
^poh_menu_rows = 6
^poh_menu_slots = 8

// How a row is drawn, and it is drawn at all either way: the windows list the whole ladder and dim
// what is out of reach, so 0 is buildable, 1 is buildable-if-you-had-the-money-or-the-planks, and 2
// is above your Construction level. poh_menus.enum turns these into @xxx@ colour tags.
^poh_state_ready = 0
^poh_state_poor = 1
^poh_state_locked = 2
