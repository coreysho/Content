// The costume room's treasure chest: OSRS's costume storage, for treasure trail reward items.
//
// THE LIST IS DERIVED, NOT REMEMBERED. Every obj below appears in one of the three clue reward
// tables - scripts/minigames/game_trail/scripts/*/trail_clue_*_reward.rs2 - and every one of them
// is a clue VARIANT rather than something a shop sells: the god, gold-trimmed, trimmed and
// heraldic armour by name, plus the costume pieces clues are the only source of. Battery group 55
// re-derives that set from the reward tables on every run, so a clue reward added later that
// belongs in the chest cannot be quietly left out of it.
//
// The plain rune, adamant and black armour that clues also drop is deliberately NOT here, and
// neither are the bows, dragonhide, studded leather, amulets, coins, runes or noted fish. The
// chest is costume storage, not a second bank.
//
// 72 items in 16 sets. They are stored in SET ORDER and the first/last tables below are what make
// a set addressable without an enum per set - the same idiom poh_fam_first/poh_fam_last uses for
// the furniture families.

[poh_costume_item]
inputtype=int
outputtype=namedobj
default=null
val=0,rune_full_helm_saradomin
val=1,rune_platebody_saradomin
val=2,rune_platelegs_saradomin
val=3,rune_kiteshield_saradomin
val=4,rune_full_helm_zamorak
val=5,rune_platebody_zamorak
