// The Stonemason, OSRS npc 3098 - the dwarf in western Keldagrim who sells the stone Construction is
// built out of - via tools/models/importosrsnpc.py, models re-encoded by osrs2ob2.py with his
// recolours baked in and round-trip verified. Nine models; rendered and looked at before shipping
// (green cap, apron, a slab under his arm).
//
// OSRS npc 3889 is also called Stonemason and is not him. He animates on the 377 DWARF seqs, which
// is what he is.
//
// 500/1000 of an item's own cache cost is exactly the OSRS price for all four things he sells - see
// poh_stone.inv. The two multipliers are literals because no config param in this repo takes a
// ^constant; ^poh_stone_sell / ^poh_stone_buy carry the same numbers and battery 48 compares them.

[poh_stonemason]
// OSRS npc 3098
name=Stonemason
model1=npc_poh_stonemason_1
model2=npc_poh_stonemason_2
model3=npc_poh_stonemason_3
model4=npc_poh_stonemason_4
model5=npc_poh_stonemason_5
model6=npc_poh_stonemason_6
model7=npc_poh_stonemason_7
head1=npc_poh_stonemason_head1
head2=npc_poh_stonemason_head2
desc=He sells the stone that houses are built from.
readyanim=dwarf_ready
walkanim=dwarf_walk
vislevel=hide
wanderrange=3
maxrange=5
op1=Talk-to
op3=Trade
param=owned_shop,poh_stone_shop
param=shop_sell_multiplier,500
param=shop_buy_multiplier,300
param=shop_delta,0
param=shop_title,Stonemason's Store
