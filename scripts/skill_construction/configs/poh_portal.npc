// The estate agent, OSRS npc 3097 - the one who stands beside the Rimmington house portal - via
// tools/models/importosrsnpc.py, models re-encoded by osrs2ob2.py with his recolours baked in and
// round-trip verified. Ten body models and three chathead models; rendered and looked at before
// shipping (bowler hat, moustache, long coat).
//
// OSRS npc 13343 is also called Estate Agent and is NOT this one - that is the Varlamore agent, in
// a laurel crown and a toga.
//
// He animates on the 377 human seqs, which is what every other OSRS humanoid in this build does
// (tools/models/batch_skillcape_npcs.txt). Relocate and Redecorate are his real OSRS ops and are
// deliberately absent: moving house is not implemented, and the six house styles exist but which
// template level is which OSRS style was never established.

[poh_estate_agent]
name=Estate agent
desc=He sells houses.
model1=npc_poh_estate_agent_1
model2=npc_poh_estate_agent_2
model3=npc_poh_estate_agent_3
model4=npc_poh_estate_agent_4
model5=npc_poh_estate_agent_5
model6=npc_poh_estate_agent_6
model7=npc_poh_estate_agent_7
model8=npc_poh_estate_agent_8
model9=npc_poh_estate_agent_9
model10=npc_poh_estate_agent_10
head1=npc_poh_estate_agent_head1
head2=npc_poh_estate_agent_head2
head3=npc_poh_estate_agent_head3
vislevel=hide
readyanim=human_ready
walkanim=human_walk_f
op1=Talk-to
wanderrange=0
maxrange=2
moverestrict=nomove
