// What the lectern window shows, and what the tablet scripts look up.
//
// GENERATED by tools/gentablets.py. Edit the generator.
//
// poh_tab_level and poh_tab_need are COPIES of magic_spell_table - the window has to draw a level
// and a shopping list without running a db_find per row per frame - and battery check 40 reads both
// back out of the spell rows and fails if they have drifted. Nothing else here is a copy of
// anything: the make and break scripts ask the db directly.

// Which obj each tablet is. The window draws it with if_setobject, which takes the obj
// and works the icon camera out from the obj config, so there is no zoom table here.
[poh_tab_obj]
inputtype=int
outputtype=obj
val=1,poh_tab_enchant_sapphire
val=2,poh_tab_enchant_emerald
val=3,poh_tab_enchant_ruby
val=4,poh_tab_enchant_diamond
val=5,poh_tab_enchant_dragonstone
val=6,poh_tab_varrock
val=7,poh_tab_lumbridge
val=8,poh_tab_falador
val=9,poh_tab_camelot
val=10,poh_tab_ardougne
val=11,poh_tab_watchtower
val=12,poh_tab_house
val=13,poh_tab_bones_bananas
val=14,poh_tab_bones_peaches

// The name as the window writes it - the same string as the obj's name=.
[poh_tab_name]
inputtype=int
outputtype=string
val=1,Enchant sapphire
val=2,Enchant emerald
val=3,Enchant ruby
val=4,Enchant diamond
val=5,Enchant dragonstone
val=6,Varrock teleport
val=7,Lumbridge teleport
val=8,Falador teleport
val=9,Camelot teleport
val=10,Ardougne teleport
val=11,Watchtower teleport
val=12,Teleport to house
val=13,Bones to bananas
val=14,Bones to peaches

// The spell each tablet stores. Everything else about it - level, runes, experience,
// destination - is read from that row at runtime.
[poh_tab_spell]
inputtype=int
outputtype=int
val=1,^enchant_lvl1
val=2,^enchant_lvl2
val=3,^enchant_lvl3
val=4,^enchant_lvl4
val=5,^enchant_lvl5
val=6,^varrock_teleport
val=7,^lumbridge_teleport
val=8,^falador_teleport
val=9,^camelot_teleport
val=10,^ardougne_teleport
val=11,^watchtower_teleport
val=12,^teleport_to_house
val=13,^bones_to_bananas
val=14,^bones_to_peaches

// The Magic level to MAKE one. Breaking one needs no level at all.
[poh_tab_level]
inputtype=int
outputtype=int
val=1,7
val=2,27
val=3,49
val=4,57
val=5,68
val=6,25
val=7,31
val=8,37
val=9,45
val=10,51
val=11,58
val=12,40
val=13,15
val=14,60

// The shopping list, in the window's own words. Measured against the 176px column by the
// generator, which refuses to emit one that overflows.
[poh_tab_need]
inputtype=int
outputtype=string
val=1,1 water, 1 cosmic, 1 soft clay
val=2,3 air, 1 cosmic, 1 soft clay
val=3,5 fire, 1 cosmic, 1 soft clay
val=4,10 earth, 1 cosmic, 1 soft clay
val=5,15 earth, 15 water, 1 cosmic, 1 soft clay
val=6,1 fire, 3 air, 1 law, 1 soft clay
val=7,1 earth, 3 air, 1 law, 1 soft clay
val=8,1 water, 3 air, 1 law, 1 soft clay
val=9,5 air, 1 law, 1 soft clay
val=10,2 water, 2 law, 1 soft clay
val=11,2 earth, 2 law, 1 soft clay
val=12,1 law, 1 air, 1 earth, 1 soft clay
val=13,2 earth, 2 water, 1 nature, 1 soft clay
val=14,4 earth, 4 water, 2 nature, 1 soft clay

// The seven lecterns by their real names. The window's subtitle is 488px wide, so unlike
// the furniture row labels these do not have to be shortened.
[poh_lectern_name]
inputtype=int
outputtype=string
val=1,Oak lectern
val=2,Eagle lectern
val=3,Demon lectern
val=4,Teak eagle lectern
val=5,Teak demon lectern
val=6,Mahogany eagle lectern
val=7,Mahogany demon lectern
