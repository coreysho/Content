// ---------------------------------------------------------------------------------------------
// House guests (scripts/poh_guests.rs2), added 2026-09-23. In a file of their own because
// tools/genfurn.py writes construction.varp from the furniture varps down.
// ---------------------------------------------------------------------------------------------

// The owner's: where a guest lands (the owner's own landing tile), and a count Expel Guests bumps.
[poh_entry]
type=coord

[poh_expel]
protect=no

// The guest's: whose house (their uid), which instance it was when they came in, the expel count
// then, and where the way out lands. The last is perm so that logging out in someone's house comes
// back outside their portal rather than your own.
[poh_host]
type=player_uid

[poh_visiting]
type=coord

[poh_visit_expel]

[poh_visit_exit]
type=coord
scope=perm
