desc=Good for cutting wood.
model=obj_saw
manwear=obj_saw_manwear,0
womanwear=obj_saw_womanwear,6
wearpos=righthand
2dzoom=1232
2dxan=534
2dyan=2036
2dxof=-1
2dyof=2
weight=1000g
cost=10
members=yes

// Bolt of cloth. OSRS builds beds, curtains, rugs and the combat room's rings out of it and sells
// it at the Sawmill operator for 650 - which is where this one is stocked, because that shop is
// already here and is already where the planks come from.
//
// The 377 cache has no Construction bolt of cloth. It DOES have obj 3224 "Cloth", whose
// description is literally "A bolt of cloth" - but that is the Regicide quest item, gated behind
// the quest and spent by it, so this is its own obj on the same model rather than a second use of
// a quest item.
[bolt_of_cloth]
name=Bolt of cloth
desc=A bolt of cloth.
model=obj_childs_blanket
recol1s=27412
recol1d=25372
2dyof=-15
2dzoom=1360
2dxan=368
cost=650
members=yes
weight=12oz

[cert_bolt_of_cloth]
certlink=bolt_of_cloth
certtemplate=template_for_cert
