// The Garden Centre in Falador Park - the Garden supplier's stock.
//
// Twenty of each with a one-minute restock (rate 100 = 100 ticks), which is what the shop does in
// OSRS. The PRICES are not here and are not invented: ^poh_garden_sell is 1000, and a shop charges
// cost x multiplier / 1000 (~calc_shop_value), so every one of these comes out at exactly the
// item's own cache cost - which is its value, and which is what the Garden Centre charges for it
// in the live game, item for item.
//
// THE MULTIPLIER WAS 400 UNTIL 2026-09-15 and everything here sold for 40% of the real price. 400
// is the ratio the shop BUYS at; the wiki row has a sell column and a buy column and the buy one
// was what got written down, into the constant, into the npc param and into battery 46's table of
// "OSRS prices" - which is why three things agreed with each other and all three were wrong.
//
// THE SIX FLOWERS were BUILDABLE AND UNOBTAINABLE. The formal garden shipped with flowerbeds that
// cost a bagged flower, and nothing in the game sold one - the header here used to say the flowers
// were deliberately left out because "the formal garden has no hotspots wired", and that stopped
// being true when the formal garden round wired them. They are stocked now.
//
// THE SEVEN HEDGES are new, and are what the Hedging hotspot is built from.

[poh_garden_shop]
scope=shared
size=40
restock=yes
allstock=no
stackall=no
stock1=poh_bag_dead_tree,20,100
stock2=poh_bag_nice_tree,20,100
stock3=poh_bag_oak_tree,20,100
stock4=poh_bag_willow_tree,20,100
stock5=poh_bag_maple_tree,20,100
stock6=poh_bag_yew_tree,20,100
stock7=poh_bag_magic_tree,20,100
stock8=poh_bag_plant_1,20,100
stock9=poh_bag_plant_2,20,100
stock10=poh_bag_plant_3,20,100
stock11=poh_bag_flower,20,100
stock12=poh_bag_daffodils,20,100
stock13=poh_bag_bluebells,20,100
stock14=poh_bag_sunflower,20,100
stock15=poh_bag_marigolds,20,100
stock16=poh_bag_roses,20,100
stock17=poh_bag_thorny_hedge,20,100
stock18=poh_bag_nice_hedge,20,100
stock19=poh_bag_small_box_hedge,20,100
stock20=poh_bag_topiary_hedge,20,100
stock21=poh_bag_fancy_hedge,20,100
stock22=poh_bag_tall_fancy_hedge,20,100
stock23=poh_bag_tall_box_hedge,20,100
