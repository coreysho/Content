// The Garden Centre in Falador Park - the Garden supplier's stock.
//
// Twenty of each with a one-minute restock (rate 100 = 100 ticks), which is what the shop does in
// OSRS. The PRICES are not here and are not invented: ^poh_garden_sell is 400, and a shop charges
// cost x multiplier / 1000 (~calc_shop_value), so every one of these comes out at exactly 40% of
// the item's own cache cost - which is the OSRS price, item for item, all ten of them.
//
// The hedges and the flowers (OSRS 8437-8461) are deliberately NOT stocked yet: they belong to the
// formal garden, which has no hotspots wired, and a shop that sells what nothing can build is a
// dead end with a price tag.

[poh_garden_shop]
scope=shared
size=40
restock=yes
allstock=no
stackall=no
stock1=poh_bag_dead_tree,20,100
stock2=poh_bag_nice_tree,20,100
stock3=poh_bag_oak_tree,20,100
stock4=poh_bag_willow_tree,20,100
stock5=poh_bag_maple_tree,20,100
stock6=poh_bag_yew_tree,20,100
stock7=poh_bag_magic_tree,20,100
stock8=poh_bag_plant_1,20,100
stock9=poh_bag_plant_2,20,100
stock10=poh_bag_plant_3,20,100
