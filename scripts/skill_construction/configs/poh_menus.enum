// What colour each part of a row is drawn in, by state: 0 you can build it, 1 you can build it but
// cannot pay for it, 2 your Construction level is too low. These are PixFont @xxx@ tags, read
// mid-string by drawStringTag, so one if_settext colours a whole row.
//
// The name of a locked row is BLACK rather than grey: PixFont.evaluateTag has no grey, and black on
// the stone panel recedes the way a disabled entry should. Checked by rendering it - see
// tools/menupreview.py.
[poh_tint_name]
inputtype=int
outputtype=string
val=0,@whi@
val=1,@whi@
val=2,@bla@
// The level requirement, red when you have not got it. This is the one OSRS shows in red too.
[poh_tint_level]
inputtype=int
outputtype=string
val=0,@whi@
val=1,@whi@
val=2,@red@
// What it costs: green when you have it, red when you have not, black when the level puts it out of
// reach anyway. Green-for-have and red-for-have-not is the smithing interface's own convention
// (its bar counts are colour=0xC00000 with activecolour=0x00C000).
[poh_tint_need]
inputtype=int
outputtype=string
val=0,@gre@
val=1,@red@
val=2,@bla@
