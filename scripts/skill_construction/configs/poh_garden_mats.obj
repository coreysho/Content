// The garden's materials: the ten bagged trees and plants the Garden supplier sells.
//
// Imported from the OSRS rev 240 cache by tools/models/importosrs.py (objs 8417-8435), models
// re-encoded into the 317-family format by osrs2ob2.py and round-trip verified. Name, description,
// 2d camera, weight and cost are the cache's own - the cost is what the shop charges.
//
// All ten are ONE model (OSRS 12307, a sack with a shoot coming out of it): OSRS ships them that
// way and they are told apart by name, so the importer's ten identical copies were collapsed into
// obj_poh_bagged. Rendered and looked at before shipping.

[poh_bag_dead_tree]
name=Bagged dead tree
desc=You can plant this in your garden.
model=obj_poh_bagged
2dzoom=919
2dxan=249
2dyof=-100
weight=10000g
cost=1000
members=yes
// TODO by hand: category, param= combat bonuses, equip requirement

