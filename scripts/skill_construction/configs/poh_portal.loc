// The house entrance in Rimmington and the exit portal inside the house.
//
// Both come out of the OSRS cache (rev 240) via tools/models/importosrslocs.py, models re-encoded
// by osrs2ob2.py and round-trip verified. The first attempt built them from 377 art instead - the
// undirected marble frame that shipped with the 474 construction import plus the Draynor killerwatt
// swirl - and in game that renders as a flat blue disc lying on the grass, because the 474 "frame"
// is a floor ring and the swirl is a disc with nothing to stand it up. The OSRS models carry their
// own arch.
//
//   poh_house_portal   OSRS loc 15477 - the stone arch on the 5x2 base that stands in Rimmington
//   poh_exit_portal    OSRS loc 4525  - the 2x2 twisted-root ring that is the garden's way out
//
// Both animate with osrsloc_anim_3174 (poh_portal.seq), the OSRS seq the OSRS models are rigged
// for. 377's own seq 3174 is also called poh_portal and came from the 474 import, but it belongs to
// the 474 models and is not what these are labelled against.
//
// OPS ARE ONLY WHAT WORKS. OSRS gives 15477 Enter / Home / Build mode / Friend's house and 4525
// Enter / Lock / Remove board advert / Remove. Home needs a house teleport, Friend's house needs an
// instance two players can be in, and the rest are build-mode furniture ops - none of which exist
// yet - so they are left off rather than shipped dead (claude/dead-op-audit.md).

[poh_house_portal]
name=Portal
desc=A portal to a player-owned house.
model=osrsloc_15477
model2=osrsloc_15477_2
width=5
length=2
mapscene=64
ambient=40
anim=osrsloc_anim_3174
op1=Enter
op2=Build mode

[poh_exit_portal]
name=Portal
desc=A portal out of the house.
model=osrsloc_4525
model2=osrsloc_4525_2
width=2
length=2
ambient=40
anim=osrsloc_anim_3174
op1=Enter
// op5=Remove because the exit portal is now the garden's level-1 centrepiece and is built and
// taken out like any other furniture (claude/poh-garden.md). ~poh_furn_remove refuses to take out
// the LAST one, which is what stops a player sealing themselves in.
op5=Remove
