// The house entrance in Rimmington and the exit portal inside the house.
//
// 377 has no house portal of its own - the 561 poh_ locs imported from 474 are the portals that go
// INSIDE a portal chamber, each already pointed at a city. These two are built from the same art:
// the marble frame that ships undirected (poh_portal_marble_empty) with the killerwatt swirl inside
// it, which is what every one of those imported portals already uses as its first model.
//
// Both are centrepiece_straight (shape 10) and two tiles wide, so wherever one is placed it takes
// that tile and the one to its east at angle 0.

[poh_house_portal]
name=Portal
desc=A portal to a player-owned house.
model=draynor_killerwatt_portal
model2=poh_portal_marble_empty
anim=poh_portal
width=2
op1=Enter
op2=Build mode

[poh_exit_portal]
name=Portal
desc=A portal out of the house.
model=draynor_killerwatt_portal
model2=poh_portal_marble_empty
anim=poh_portal
width=2
op1=Enter
