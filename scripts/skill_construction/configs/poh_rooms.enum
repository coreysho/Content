// Room types for the player-owned house. Type 0 means "no room" and is never listed here.
//
// The zone value packs the room's template zone inside a style square as tx * 8 + tz. Every style
// keeps the same room at the same offset, so one table serves all six (claude/poh-instancing.md).
//
// Doors are a bitmask of the sides that have a door hotspot, UNROTATED: N 1, E 2, S 4, W 8. That
// order is the rotation order, so rotating a room 90 degrees rotates this mask left by one - see
// ~poh_rot_doors. Rooms may only be joined door to door, which is what makes the mask load-bearing
// rather than decoration.
//
// The dungeon rooms, the treasure room and the formal garden are deliberately absent: the 474
// hotspot names gave no door sides for them, and a room whose doors are guessed would join into
// houses that cannot be walked through.

[poh_room_zone]
inputtype=int
outputtype=int
val=1,1
val=2,7
val=3,23
val=4,39
val=5,55
val=6,5
val=7,21
val=8,37
val=9,53
val=10,12
val=11,28
val=12,44
val=13,14
val=14,46
val=15,49

[poh_room_doors]
inputtype=int
outputtype=int
val=1,15
val=2,14
val=3,12
val=4,14
val=5,12
val=6,5
val=7,12
val=8,14
val=9,4
val=10,4
val=11,14
val=12,14
val=13,15
val=14,15
val=15,4

[poh_room_name]
inputtype=int
outputtype=string
val=1,Garden
val=2,Parlour
val=3,Kitchen
val=4,Dining room
val=5,Bedroom
val=6,Workshop
val=7,Chapel
val=8,Study
val=9,Throne room
val=10,Portal chamber
val=11,Combat room
val=12,Games room
val=13,Skill hall
val=14,Quest hall
val=15,Costume room

// What a room costs to build, in coins, and the Construction level it needs. OSRS values.
//
// NOT FROM THE CACHE. Every other table in this file was read out of the 474 map data and then
// checked against it - poh_room_doors matches the door hotspots in all 90 room/style pairs. Room
// prices and level requirements are server-side in OSRS and are in no cache, so these two are the
// only numbers here that rest on knowledge rather than on data. Treat them as the tunable ones.
[poh_room_cost]
inputtype=int
outputtype=int
val=1,1000
val=2,1000
val=3,5000
val=4,5000
val=5,10000
val=6,10000
val=7,50000
val=8,50000
val=9,150000
val=10,100000
val=11,25000
val=12,25000
val=13,15000
val=14,25000
val=15,50000

[poh_room_level]
inputtype=int
outputtype=int
val=1,1
val=2,1
val=3,5
val=4,10
val=5,20
val=6,15
val=7,45
val=8,40
val=9,60
val=10,50
val=11,32
val=12,30
val=13,25
val=14,35
val=15,42
