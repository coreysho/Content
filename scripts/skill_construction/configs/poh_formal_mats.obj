// The formal garden's materials: the six bagged flowers, and the marble block the fountains are cut
// from.
//
// Imported from the OSRS rev 240 cache by tools/models/importosrs.py (objs 8451-8461 and 8786),
// models re-encoded into the 317-family format by osrs2ob2.py and round-trip verified. Name,
// description, 2d camera, weight and cost are the cache's own, and the cost is what the shops
// charge: 400/1000 of it at the Garden supplier, 500/1000 at the Stonemason, which is the OSRS
// price in both cases (battery 46 and 48).
//
// The six flowers are the same sack model as the ten bagged plants before them (OSRS 12307), so
// they point at obj_poh_bagged rather than carrying six more copies of it.

[poh_marble_block]
name=Marble block
desc=A beautifully carved marble block.
model=obj_poh_marble_block
2dxan=220
2dyan=164
2dxof=-7
2dyof=-41
recol1s=11488
recol1d=15852
weight=13607g
cost=250000
members=yes
// TODO by hand: category, param= combat bonuses, equip requirement

[poh_bag_flower]
name=Bagged flower
desc=You can plant this in your garden.
model=obj_poh_bagged
