// The Garden supplier, OSRS npc 3102 - the one who runs the Garden Centre in Falador Park - via
// tools/models/importosrsnpc.py, models re-encoded by osrs2ob2.py with her recolours baked in and
// round-trip verified. Nine body models and two chatheads; rendered and looked at before shipping
// (straw hat, green top, long skirt).
//
// OSRS npc 3103 is also called Garden supplier: it is the same person again for the Farming Guild,
// and its models hash identical to these, so there is nothing to choose between them.
//
// She animates on the 377 human seqs, like every other OSRS humanoid in this build.
//
// The prices are the cache's: a shop charges cost x multiplier / 1000, and 400 makes every bagged
// plant exactly the 40% of its own cost that OSRS charges. shop_delta is 0 because this is a
// fixed-price shop - haggling would drift it off the OSRS number as stock moved. 240 is what she
// pays to take one back, the same 60%-of-selling ratio the slayer shop uses.
//
// These three are literals rather than ^poh_garden_* constants: nothing in this repo puts a user
// constant in a config param (only ^true, which is built in), and this is not the round to find out
// whether the packer resolves one. ^poh_garden_sell / ^poh_garden_buy carry the same numbers for the
// scripts, and battery check 46 fails if the two ever disagree.

[poh_garden_supplier]
// OSRS npc 3102
name=Garden supplier
model1=npc_poh_garden_supplier_1
model2=npc_poh_garden_supplier_2
model3=npc_poh_garden_supplier_3
model4=npc_poh_garden_supplier_4
model5=npc_poh_garden_supplier_5
model6=npc_poh_garden_supplier_6
model7=npc_poh_garden_supplier_7
model8=npc_poh_garden_supplier_8
model9=npc_poh_garden_supplier_9
head1=npc_poh_garden_supplier_head1
head2=npc_poh_garden_supplier_head2
desc=She sells bagged plants and trees for player-owned houses.
readyanim=human_ready
walkanim=human_walk_f
vislevel=hide
wanderrange=3
maxrange=5
op1=Talk-to
op3=Trade
param=owned_shop,poh_garden_shop
param=shop_sell_multiplier,400
param=shop_buy_multiplier,240
param=shop_delta,0
param=shop_title,Garden Centre
