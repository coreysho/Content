// The beam is three tiles of the seven the template keeps blank inside the ring. The other
// four are OSRS's Ranging pedestals, and this cache has no art for them.
[proc,poh_ring_beam](coord $base, int $rot)
~poh_ring_wall($base, $rot, 3, 4, 1, poh_balancebeam_endl);
~poh_ring_wall($base, $rot, 4, 4, 1, poh_balancebeam_middle);
~poh_ring_wall($base, $rot, 5, 4, 1, poh_balancebeam_endr);

// =========================================================================== show and remove

// $base is the room's local (0,0) - the anchor the piece is stored at - so the whole ring is
// laid from it without needing to know which hotspot was clicked.
[proc,poh_combat_ring_place](coord $base, int $angle, int $tier)
def_int $rot = ~poh_ring_room_rot($base);
switch_int ($tier) {
    case 1 : ~poh_ring_boxing($base, $rot);
    case 2 : ~poh_ring_fencing($base, $rot);
    case 3 : ~poh_ring_combat($base, $rot);
    case 4 : ~poh_ring_beam($base, $rot);
}

// The room a coord is in, and how that room was turned. The ring is laid in template space
// and turned to match, so this is the only thing the table needs from the house.
[proc,poh_ring_room_rot](coord $spot)(int)
if (%poh_instance = null) {
    return(0);
}
def_int $gx = calc(coordx($spot) - coordx(%poh_instance));
def_int $gz = calc(coordz($spot) - coordz(%poh_instance));
return(~poh_room_rot(calc(divide($gx, 8) - ^poh_grid_origin), calc(divide($gz, 8) - ^poh_grid_origin)));

// Taking one out. Any tile of the ring is a valid click, so the slot is looked up at the
// anchor rather than under the piece that was clicked - which is the whole reason for the
// anchor. ~poh_furn_relay then re-lays the room, which clears all 36 locs at once.
[proc,poh_combat_ring_remove]
if (%poh_instance = null | instance_find(loc_coord) ! %poh_instance) {
    return;
}
def_int $gx = calc(coordx(loc_coord) - coordx(%poh_instance));
def_int $gz = calc(coordz(loc_coord) - coordz(%poh_instance));
def_int $rx = calc(divide($gx, 8) - ^poh_grid_origin);
def_int $rz = calc(divide($gz, 8) - ^poh_grid_origin);
def_int $slot = ~poh_furn_at($rx, $rz, 0, 0);
if ($slot < 0) {
    mes("That isn't yours to take out.");
    return;
}
def_int $item = ~poh_furn_item(~poh_furn_get($slot));
def_int $option = ~p_choice2("Take out the <enum(int, string, poh_furn_name, $item)>.", 1, "Leave it.", 2);
if ($option ! 1) {
    return;
}
~poh_furn_set($slot, 0);
~poh_furn_relay($rx, $rz);
mes("You take out the <enum(int, string, poh_furn_name, $item)>.");

// =========================================================================== the triggers

[oploc5,poh_balancebeam_endl] ~poh_combat_ring_remove;
[oploc5,poh_balancebeam_endr] ~poh_combat_ring_remove;
[oploc5,poh_boxing_ring_mat_corner] ~poh_combat_ring_remove;
[oploc5,poh_boxing_ring_mat_middle] ~poh_combat_ring_remove;
[oploc5,poh_boxing_ring_mat_side] ~poh_combat_ring_remove;
[oploc5,poh_boxing_ringwall_blue] ~poh_combat_ring_remove;
[oploc5,poh_boxing_ringwall_corner] ~poh_combat_ring_remove;
[oploc5,poh_boxing_ringwall_red] ~poh_combat_ring_remove;
[oploc5,poh_combat_mat_corner] ~poh_combat_ring_remove;
[oploc5,poh_combat_mat_middle] ~poh_combat_ring_remove;
[oploc5,poh_combat_mat_side] ~poh_combat_ring_remove;
[oploc5,poh_fencing_ring_mat_corner] ~poh_combat_ring_remove;
[oploc5,poh_fencing_ring_mat_middle] ~poh_combat_ring_remove;
[oploc5,poh_fencing_ring_mat_side] ~poh_combat_ring_remove;

// Climbing into the ring. Every ring type has the same wall op, and the wall is what you
// climb - the mats have no op of their own.
[oploc1,poh_boxing_ringwall_blue] ~poh_ring_climb;
[oploc1,poh_boxing_ringwall_corner] ~poh_ring_climb;
[oploc1,poh_boxing_ringwall_red] ~poh_ring_climb;
[oploc1,poh_boxing_ringwall_white] ~poh_ring_climb;
[oploc1,poh_combat_ringwall] ~poh_ring_climb;
[oploc1,poh_fencing_ringwall] ~poh_ring_climb;

[oploc1,poh_balancebeam_endl] ~poh_ring_beam_stand;
[oploc1,poh_balancebeam_middle] ~poh_ring_beam_stand;
[oploc1,poh_balancebeam_endr] ~poh_ring_beam_stand;
[oploc4,poh_balancebeam_endl] ~poh_ring_beam_down;
[oploc4,poh_balancebeam_middle] ~poh_ring_beam_down;
[oploc4,poh_balancebeam_endr] ~poh_ring_beam_down;
