~poh_ring_mat($base, $rot, 3, 4, 0, poh_boxing_ring_mat_middle);
~poh_ring_mat($base, $rot, 4, 4, 0, poh_boxing_ring_mat_middle);
~poh_ring_mat($base, $rot, 5, 4, 2, poh_boxing_ring_mat_side);
~poh_ring_mat($base, $rot, 2, 5, 1, poh_boxing_ring_mat_corner);
~poh_ring_mat($base, $rot, 3, 5, 1, poh_boxing_ring_mat_side);
