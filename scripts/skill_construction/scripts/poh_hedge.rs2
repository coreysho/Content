// Hedging: the Formal garden's other perimeter.
//
// GENERATED by tools/genhedge.py from the six template squares and tools/furnspec.json.
// Do not edit by hand.
//
// The garden's twenty perimeter tiles carry TWO hotspots, not one. Fencing sits on the wall
// boundary and the hedge stands on the tile, so a garden can have both - which is what OSRS
// does, and why the fence round's twenty tiles and these twenty are the same twenty.
//
// Seven tiers, three pieces each: two straights and a corner, named by the three hotspot
// ghosts, which the thorny hedge's own three models match vertex for vertex. Like the rugs
// and the fence this is one piece over many tiles, so it goes through the "show" hand-off
// and an anchor, and shares ~poh_ring_tile / ~poh_ring_angle out of poh_combat_ring.rs2.
//
// THE ANCHOR IS IN furnspec.json AND NOWHERE ELSE - (1, 4), which carries no hotspot in
// the formal garden and is not the fence's, so a garden can store one of each.

[proc,poh_hedge_loc](int $tier, int $kind)(loc)
switch_int (calc($tier * 3 + $kind)) {
    case 0 : return(loc_13456);   // thorny hedge, a
    case 1 : return(loc_13457);   // thorny hedge, corner
    case 2 : return(loc_13458);   // thorny hedge, b
    case 3 : return(loc_13459);   // nice hedge, a
    case 4 : return(loc_13460);   // nice hedge, corner
    case 5 : return(loc_13461);   // nice hedge, b
    case 6 : return(loc_13462);   // small box hedge, a
    case 7 : return(loc_13463);   // small box hedge, corner
    case 8 : return(loc_13464);   // small box hedge, b
    case 9 : return(loc_13465);   // topiary hedge, a
    case 10 : return(loc_13466);   // topiary hedge, corner
    case 11 : return(loc_13467);   // topiary hedge, b
    case 12 : return(loc_13468);   // fancy hedge, a
    case 13 : return(loc_13469);   // fancy hedge, corner
    case 14 : return(loc_13470);   // fancy hedge, b
    case 15 : return(loc_13471);   // tall fancy hedge, a
    case 16 : return(loc_13472);   // tall fancy hedge, corner
    case 17 : return(loc_13473);   // tall fancy hedge, b
    case 18 : return(loc_13474);   // tall box hedge, a
    case 19 : return(loc_13475);   // tall box hedge, corner
    case 20 : return(loc_13476);   // tall box hedge, b
    case default : return(null);
}

[proc,poh_hedge_lay](coord $base, int $rot, int $x, int $z, int $angle, int $tier, int $kind)
loc_add(~poh_ring_tile($base, $rot, $x, $z), ~poh_hedge_loc($tier, $kind), ~poh_ring_angle($angle, $rot), centrepiece_straight, ^poh_loc_duration);

[proc,poh_hedge_place](coord $spot, int $angle, int $tier)
def_coord $base = movecoord($spot, -1, 0, -4);
def_int $rot = ~poh_ring_room_rot($base);
~poh_hedge_lay($base, $rot, 0, 0, 3, $tier, ^poh_hedge_corner);
~poh_hedge_lay($base, $rot, 0, 1, 3, $tier, ^poh_hedge_b);
~poh_hedge_lay($base, $rot, 0, 2, 3, $tier, ^poh_hedge_a);
~poh_hedge_lay($base, $rot, 0, 5, 1, $tier, ^poh_hedge_a);
~poh_hedge_lay($base, $rot, 0, 6, 3, $tier, ^poh_hedge_b);
~poh_hedge_lay($base, $rot, 0, 7, 0, $tier, ^poh_hedge_corner);
~poh_hedge_lay($base, $rot, 1, 0, 2, $tier, ^poh_hedge_b);
~poh_hedge_lay($base, $rot, 1, 7, 0, $tier, ^poh_hedge_b);
~poh_hedge_lay($base, $rot, 2, 0, 0, $tier, ^poh_hedge_a);
~poh_hedge_lay($base, $rot, 2, 7, 0, $tier, ^poh_hedge_a);
~poh_hedge_lay($base, $rot, 5, 0, 2, $tier, ^poh_hedge_a);
~poh_hedge_lay($base, $rot, 5, 7, 2, $tier, ^poh_hedge_a);
~poh_hedge_lay($base, $rot, 6, 0, 2, $tier, ^poh_hedge_b);
~poh_hedge_lay($base, $rot, 6, 7, 0, $tier, ^poh_hedge_b);
~poh_hedge_lay($base, $rot, 7, 0, 2, $tier, ^poh_hedge_corner);
~poh_hedge_lay($base, $rot, 7, 1, 1, $tier, ^poh_hedge_b);
~poh_hedge_lay($base, $rot, 7, 2, 3, $tier, ^poh_hedge_a);
~poh_hedge_lay($base, $rot, 7, 5, 1, $tier, ^poh_hedge_a);
~poh_hedge_lay($base, $rot, 7, 6, 1, $tier, ^poh_hedge_b);
~poh_hedge_lay($base, $rot, 7, 7, 1, $tier, ^poh_hedge_corner);

[proc,poh_hedge_remove]
~poh_decor_remove(1, 4);

// The seven pieces furnspec NAMES are wired by genfurn.py, which emits one [oploc5] per
// buildable loc and reads the family's own "remove" for the proc. These are the other
// fourteen - the corner and the second straight of each tier, which are not in the spec
// because the build window only ever shows one of the three. A trigger declared twice
// does not compile, so the split has to be exact; battery group 63 checks both halves.
[oploc5,loc_13457] ~poh_hedge_remove;
[oploc5,loc_13458] ~poh_hedge_remove;
[oploc5,loc_13460] ~poh_hedge_remove;
[oploc5,loc_13461] ~poh_hedge_remove;
[oploc5,loc_13463] ~poh_hedge_remove;
[oploc5,loc_13464] ~poh_hedge_remove;
[oploc5,loc_13466] ~poh_hedge_remove;
[oploc5,loc_13467] ~poh_hedge_remove;
[oploc5,loc_13469] ~poh_hedge_remove;
[oploc5,loc_13470] ~poh_hedge_remove;
[oploc5,loc_13472] ~poh_hedge_remove;
[oploc5,loc_13473] ~poh_hedge_remove;
[oploc5,loc_13475] ~poh_hedge_remove;
[oploc5,loc_13476] ~poh_hedge_remove;
