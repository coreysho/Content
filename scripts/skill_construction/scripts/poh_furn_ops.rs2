[oploc1,poh_telescope_1]
switch_int (random(4)) {
    case 0 : mes("You gaze at the stars. You feel very small.");
    case 1 : mes("You look through the telescope. A shooting star crosses the sky.");
    case 2 : mes("You watch the clouds drift past. Nothing much is happening up there.");
    case 3 : mes("You peer through the telescope and see the moon, very close up.");
    case default : mes("You gaze at the stars. You feel very small.");
}

