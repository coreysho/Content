// Fencing, the throne room floor and the chapel windows.
//
// GENERATED by tools/gendecor.py from the six template squares and tools/furnspec.json.
// Do not edit by hand. Each of the three is one piece over several tiles, so each goes
// through the "show" hand-off and an anchor, the way the combat ring and the rugs do, and
// each shares their rotation maths - ~poh_ring_tile and ~poh_ring_angle in
// poh_combat_ring.rs2, which are the engine's own zone arithmetic.
//
// THE ANCHOR IS IN furnspec.json AND NOWHERE ELSE. The click reads it there and the numbers
// below are written from it, so the two cannot drift - which is the mistake the rug round
// left open and a mutation caught.

// =========================================================================== the fence

// Seven tiers, one loc each, over the garden's twenty perimeter tiles - sixteen straight and
// four corners, which is why there are two helpers: the shape picks the LAYER a loc goes on.
[proc,poh_fence_loc](int $tier)(loc)
switch_int ($tier) {
    case 1 : return(loc_13449);
    case 2 : return(loc_13450);
    case 3 : return(loc_13451);
    case 4 : return(loc_13452);
    case 5 : return(loc_13453);
    case 6 : return(loc_13454);
    case 7 : return(loc_13455);
    case default : return(null);
}

[proc,poh_fence_wall](coord $base, int $rot, int $x, int $z, int $angle, int $tier)
loc_add(~poh_ring_tile($base, $rot, $x, $z), ~poh_fence_loc($tier), ~poh_ring_angle($angle, $rot), wall_straight, ^poh_loc_duration);

[proc,poh_fence_corner](coord $base, int $rot, int $x, int $z, int $angle, int $tier)
loc_add(~poh_ring_tile($base, $rot, $x, $z), ~poh_fence_loc($tier), ~poh_ring_angle($angle, $rot), wall_l, ^poh_loc_duration);

[proc,poh_fence_place](coord $spot, int $angle, int $tier)
def_coord $base = movecoord($spot, -1, 0, -3);
def_int $rot = ~poh_ring_room_rot($base);
~poh_fence_corner($base, $rot, 0, 0, 3, $tier);
~poh_fence_wall($base, $rot, 0, 1, 0, $tier);
~poh_fence_wall($base, $rot, 0, 2, 0, $tier);
~poh_fence_wall($base, $rot, 0, 5, 0, $tier);
~poh_fence_wall($base, $rot, 0, 6, 0, $tier);
~poh_fence_corner($base, $rot, 0, 7, 0, $tier);
~poh_fence_wall($base, $rot, 1, 0, 3, $tier);
~poh_fence_wall($base, $rot, 1, 7, 1, $tier);
~poh_fence_wall($base, $rot, 2, 0, 3, $tier);
~poh_fence_wall($base, $rot, 2, 7, 1, $tier);
~poh_fence_wall($base, $rot, 5, 0, 3, $tier);
~poh_fence_wall($base, $rot, 5, 7, 1, $tier);
~poh_fence_wall($base, $rot, 6, 0, 3, $tier);
~poh_fence_wall($base, $rot, 6, 7, 1, $tier);
~poh_fence_corner($base, $rot, 7, 0, 2, $tier);
~poh_fence_wall($base, $rot, 7, 1, 2, $tier);
~poh_fence_wall($base, $rot, 7, 2, 2, $tier);
~poh_fence_wall($base, $rot, 7, 5, 2, $tier);
~poh_fence_wall($base, $rot, 7, 6, 2, $tier);
~poh_fence_corner($base, $rot, 7, 7, 1, $tier);

[proc,poh_fence_remove]
~poh_decor_remove(1, 3);

// =========================================================================== the throne floor

// One tier - OSRS's other four are a steel cage, a trapdoor and two magic cages, and all of
// them drop the loser into an oubliette this one-storey build does not have. The ART is your
// house style's: six floor decorations, one per style, named after the same six towns the
// windows are.
[proc,poh_thronefloor_loc](int $style)(loc)
switch_int ($style) {
    case 0 : return(poh_floordecor_rimmington);   // rimmington
    case 1 : return(poh_floordecor_lumbridge);   // lumbridge
    case 2 : return(poh_floordecor_pollnivneach);   // pollnivneach
    case 3 : return(poh_floordecor_rellekka);   // rellekka
    case 4 : return(poh_floordecor_brimhaven);   // brimhaven
    case 5 : return(poh_floordecor_yanille);   // yanille
    case default : return(poh_floordecor_rimmington);
}

[proc,poh_thronefloor_mat](coord $base, int $rot, int $x, int $z, int $angle)
loc_add(~poh_ring_tile($base, $rot, $x, $z), ~poh_thronefloor_loc(%poh_style), ~poh_ring_angle($angle, $rot), grounddecor, ^poh_loc_duration);

[proc,poh_thronefloor_place](coord $spot, int $angle, int $tier)
def_coord $base = movecoord($spot, 0, 0, -6);
def_int $rot = ~poh_ring_room_rot($base);
~poh_thronefloor_mat($base, $rot, 3, 3, 3);
~poh_thronefloor_mat($base, $rot, 3, 4, 0);
~poh_thronefloor_mat($base, $rot, 4, 3, 2);
~poh_thronefloor_mat($base, $rot, 4, 4, 1);

[proc,poh_thronefloor_remove]
~poh_decor_remove(0, 6);

// =========================================================================== the windows

// Fifty-four: six styles times nine glazings, in poh_dynamic_window's own child order,
// because that order IS the low digit of %poh_window.
[proc,poh_window_loc](int $style, int $choice)(loc)
switch_int (calc($style * ^poh_window_kinds + $choice)) {
    case 0 : return(poh_rimmington_window_shutters);
    case 1 : return(poh_rimmington_window_bob);
    case 2 : return(poh_rimmington_window_saradomin);
    case 3 : return(poh_rimmington_window_guthix);
    case 4 : return(poh_rimmington_window_zamorak);
    case 5 : return(poh_rimmington_window_bob2);
    case 6 : return(poh_rimmington_window_saradomin2);
    case 7 : return(poh_rimmington_window_guthix2);
    case 8 : return(poh_rimmington_window_zamorak2);
    case 9 : return(poh_lumbridge_window_shutters);
    case 10 : return(poh_lumbridge_window_bob);
    case 11 : return(poh_lumbridge_window_saradomin);
    case 12 : return(poh_lumbridge_window_guthix);
    case 13 : return(poh_lumbridge_window_zamorak);
    case 14 : return(poh_lumbridge_window_bob2);
    case 15 : return(poh_lumbridge_window_saradomin2);
    case 16 : return(poh_lumbridge_window_guthix2);
    case 17 : return(poh_lumbridge_window_zamorak2);
    case 18 : return(poh_pollnivneach_window_shutters);
    case 19 : return(poh_pollnivneach_window_bob);
    case 20 : return(poh_pollnivneach_window_saradomin);
    case 21 : return(poh_pollnivneach_window_guthix);
    case 22 : return(poh_pollnivneach_window_zamorak);
    case 23 : return(poh_pollnivneach_window_bob2);
    case 24 : return(poh_pollnivneach_window_saradomin2);
    case 25 : return(poh_pollnivneach_window_guthix2);
    case 26 : return(poh_pollnivneach_window_zamorak2);
    case 27 : return(poh_rellekka_window_shutters);
    case 28 : return(poh_rellekka_window_bob);
    case 29 : return(poh_rellekka_window_saradomin);
    case 30 : return(poh_rellekka_window_guthix);
    case 31 : return(poh_rellekka_window_zamorak);
    case 32 : return(poh_rellekka_window_bob2);
    case 33 : return(poh_rellekka_window_saradomin2);
    case 34 : return(poh_rellekka_window_guthix2);
    case 35 : return(poh_rellekka_window_zamorak2);
    case 36 : return(poh_brimhaven_window_shutters);
    case 37 : return(poh_brimhaven_window_bob);
    case 38 : return(poh_brimhaven_window_saradomin);
    case 39 : return(poh_brimhaven_window_guthix);
    case 40 : return(poh_brimhaven_window_zamorak);
    case 41 : return(poh_brimhaven_window_bob2);
    case 42 : return(poh_brimhaven_window_saradomin2);
    case 43 : return(poh_brimhaven_window_guthix2);
    case 44 : return(poh_brimhaven_window_zamorak2);
    case 45 : return(poh_yanille_window_shutters);
    case 46 : return(poh_yanille_window_bob);
    case 47 : return(poh_yanille_window_saradomin);
    case 48 : return(poh_yanille_window_guthix);
    case 49 : return(poh_yanille_window_zamorak);
    case 50 : return(poh_yanille_window_bob2);
    case 51 : return(poh_yanille_window_saradomin2);
    case 52 : return(poh_yanille_window_guthix2);
    case 53 : return(poh_yanille_window_zamorak2);
    case default : return(poh_rimmington_window_shutters);
}

[proc,poh_window_pane](coord $base, int $rot, int $x, int $z, int $angle, int $choice)
loc_add(~poh_ring_tile($base, $rot, $x, $z), ~poh_window_loc(%poh_style, $choice), ~poh_ring_angle($angle, $rot), wall_straight, ^poh_loc_duration);

// The tier IS the choice, one to nine, so the whole house reglazes to whatever was built
// here. That is what %poh_window is for, and ~poh_window_refresh already carries the choice
// across a redecorate while swapping the style.
[proc,poh_window_place](coord $spot, int $angle, int $tier)
def_coord $base = movecoord($spot, 0, 0, -6);
def_int $rot = ~poh_ring_room_rot($base);
def_int $choice = calc($tier - 1);
%poh_window = calc(%poh_style * ^poh_window_kinds + $choice);
~poh_window_pane($base, $rot, 0, 2, 0, $choice);
~poh_window_pane($base, $rot, 0, 5, 0, $choice);
~poh_window_pane($base, $rot, 2, 7, 1, $choice);
~poh_window_pane($base, $rot, 5, 7, 1, $choice);
~poh_window_pane($base, $rot, 7, 2, 2, $choice);
~poh_window_pane($base, $rot, 7, 5, 2, $choice);

[proc,poh_window_remove]
~poh_decor_remove(0, 6);

// A window in any other wall of the house is the shell, not a piece of furniture. It has
// carried a Remove since the shell was resolved - a multiloc shows its active child's ops -
// and until now nothing answered it, which is the engine's "Nothing interesting happens" on
// every window in the house.
[oploc5,poh_dynamic_window]
mes("The windows are part of the house itself.");
mes("Build a window in a chapel to change them, or ask the estate agent to redecorate.");

// =========================================================================== shared

// All three are stored at their room's anchor rather than under the tile that was clicked,
// so all three come out the same way: find the slot at the anchor, clear it, re-lay the room.
[proc,poh_decor_remove](int $ax, int $az)
if (%poh_instance = null | instance_find(loc_coord) ! %poh_instance) {
    return;
}
def_int $gx = calc(coordx(loc_coord) - coordx(%poh_instance));
def_int $gz = calc(coordz(loc_coord) - coordz(%poh_instance));
def_int $rx = calc(divide($gx, 8) - ^poh_grid_origin);
def_int $rz = calc(divide($gz, 8) - ^poh_grid_origin);
def_int $slot = ~poh_furn_at($rx, $rz, $ax, $az);
if ($slot < 0) {
    mes("That isn't yours to take out.");
    return;
}
def_int $item = ~poh_furn_item(~poh_furn_get($slot));
def_int $option = ~p_choice2("Take out the <enum(int, string, poh_furn_name, $item)>.", 1, "Leave it.", 2);
if ($option ! 1) {
    return;
}
~poh_furn_set($slot, 0);
~poh_furn_relay($rx, $rz);
mes("You take out the <enum(int, string, poh_furn_name, $item)>.");

// =========================================================================== the triggers


[oploc5,poh_floordecor_lumbridge] ~poh_thronefloor_remove;
[oploc5,poh_floordecor_pollnivneach] ~poh_thronefloor_remove;
[oploc5,poh_floordecor_rellekka] ~poh_thronefloor_remove;
[oploc5,poh_floordecor_brimhaven] ~poh_thronefloor_remove;
[oploc5,poh_floordecor_yanille] ~poh_thronefloor_remove;

