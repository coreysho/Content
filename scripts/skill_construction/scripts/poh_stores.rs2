// The costume room's five storage spaces: the cape rack, the magic wardrobe, the armour case, the
// toy box and the fancy dress box.
//
// ONE MECHANISM, FIVE SPACES. The treasure chest next door already does storage the way this repo
// does storage - a perm inv and a chat menu, no new interface, the same shape as the herb sack and
// the looting bag (storage_items/scripts/storage_items.rs2). These five are that again, so rather
// than five near-identical copies of poh_costume.rs2 there is one copy here and an $store index
// that picks which run of the item list a click is allowed to see.
//
// WHY AN INDEX RATHER THAN FIVE INVS: all five share poh_store_inv and each store owns a
// contiguous run of it. poh_store_first/_last are that run; poh_store_setfirst/_setlast are the
// sets inside it. The index into poh_store_item is also the slot, so nothing has to search.
//
// THE REASON ORIGINALLY GIVEN HERE WAS WRONG. It said an inv cannot be handed to a proc and that
// nothing in the repo does it. ~inv_slotspace(inv $from_inv, inv $to_inv, enum $slots) in
// general/scripts/misc/inv_procs.rs2 takes two, and has for as long as that file has existed - so
// five invs and one set of procs was available all along and was not considered. The shape here
// still stands on its own: the item list has to be flat either way, because "take out a set" needs
// first/last windows into it, and one 307-slot perm inv is no worse than five adding up to 307.
// But it stands on that, not on a limitation that does not exist.
//
//   Store    every item this space takes that you are carrying, one of each
//   Check    what is in it, by set
//   Take out a whole set at a time, which is how OSRS withdraws from costume storage and also the
//            only way to pick one of eighty-seven capes out of a chat menu
//
// The lists are in configs/poh_store.enum, generated by tools/genstores.py from tools/storespec.json
// against pack/obj.pack and against the treasure chest's own list. Battery group 62 re-derives them.

// $store is which of the five this is and $item is the piece that was clicked - the generated
// trigger passes both, the same way the treasure chest's passes its piece - and the piece's tier
// is what decides the capacity.
[proc,poh_store_open](int $store, int $item)
if (%poh_instance = null | instance_find(loc_coord) ! %poh_instance) {
    mes("You can only use that in your own house.");
    return;
}
def_int $cap = enum(int, int, poh_store_cap, calc($store * 8 + enum(int, int, poh_furn_tier, $item)));
if ($cap = null) {
    return;
}
def_int $have = ~poh_store_count($store);
mes("The <enum(int, string, poh_store_name, $store)> holds <tostring($have)> of <tostring($cap)> pieces.");
def_int $pick = ~p_choice4("Store what I'm carrying.", 1, "See what's in it.", 2,
                           "Take out a set.", 3, "Nothing.", 4);
if ($pick = 1) {
    ~poh_store_put($store, $cap);
} else if ($pick = 2) {
    ~poh_store_check($store);
} else if ($pick = 3) {
    ~poh_store_take($store);
}

[proc,poh_store_count](int $store)(int)
def_int $i = enum(int, int, poh_store_first, $store);
def_int $last = enum(int, int, poh_store_last, $store);
def_int $n = 0;
while ($i <= $last) {
    if (inv_total(poh_store_inv, enum(int, namedobj, poh_store_item, $i)) > 0) {
        $n = calc($n + 1);
    }
    $i = calc($i + 1);
}
return($n);

// One of each: a second pair of mystic boots is not part of a costume, so it stays in your pack.
// The capacity is checked per item rather than up front, so a nearly-full space still takes what it
// can instead of refusing the lot.
[proc,poh_store_put](int $store, int $cap)
def_int $i = enum(int, int, poh_store_first, $store);
def_int $last = enum(int, int, poh_store_last, $store);
def_int $moved = 0;
def_int $full = 0;
def_int $held = ~poh_store_count($store);
while ($i <= $last) {
    def_namedobj $item = enum(int, namedobj, poh_store_item, $i);
    if (inv_total(inv, $item) > 0 & inv_total(poh_store_inv, $item) = 0) {
        if ($held < $cap) {
            inv_moveitem(inv, poh_store_inv, $item, 1);
            $held = calc($held + 1);
            $moved = calc($moved + 1);
        } else {
            $full = 1;
        }
    }
    $i = calc($i + 1);
}
if ($moved = 0 & $full = 0) {
    mes("You aren't carrying anything the <enum(int, string, poh_store_name, $store)> will take.");
    return;
}
if ($moved > 0) {
    mes("You put <tostring($moved)> piece(s) into the <enum(int, string, poh_store_name, $store)>.");
}
if ($full = 1) {
    mes("It's full. A better one would hold more.");
}

[proc,poh_store_check](int $store)
def_int $s = enum(int, int, poh_store_setfirst, $store);
def_int $last = enum(int, int, poh_store_setlast, $store);
def_int $named = 0;
while ($s <= $last) {
    def_int $in = ~poh_store_set_count($s);
    if ($in > 0) {
        mes("<enum(int, string, poh_store_set_name, $s)>: <tostring($in)> of <tostring(calc(enum(int, int, poh_store_set_last, $s) - enum(int, int, poh_store_set_first, $s) + 1))>.");
        $named = calc($named + 1);
    }
    $s = calc($s + 1);
}
if ($named = 0) {
    mes("It's empty.");
}

[proc,poh_store_set_count](int $set)(int)
def_int $i = enum(int, int, poh_store_set_first, $set);
def_int $last = enum(int, int, poh_store_set_last, $set);
def_int $n = 0;
while ($i <= $last) {
    if (inv_total(poh_store_inv, enum(int, namedobj, poh_store_item, $i)) > 0) {
        $n = calc($n + 1);
    }
    $i = calc($i + 1);
}
return($n);

// Only the sets that actually have something in them are offered, four at a time, so the menu is
// short in practice even though the fancy dress box has twelve of them. The page counter is a
// bounded loop: while (true) has no precedent in this repo.
[proc,poh_store_take](int $store)
def_int $from = enum(int, int, poh_store_setfirst, $store);
def_int $home = $from;
def_int $turns = 0;
while ($turns < 8) {
    $turns = calc($turns + 1);
    def_int $a = ~poh_store_nth($store, $from, 0);
    if ($a < 0) {
        if ($from = $home) {
            mes("It's empty.");
        }
        return;
    }
    def_int $b = ~poh_store_nth($store, $from, 1);
    def_int $c = ~poh_store_nth($store, $from, 2);
    def_int $d = ~poh_store_nth($store, $from, 3);
    def_int $pick = ~p_choice5(
        "<enum(int, string, poh_store_set_name, $a)>", 1,
        "<enum(int, string, poh_store_set_name, max($b, 0))>", 2,
        "<enum(int, string, poh_store_set_name, max($c, 0))>", 3,
        "<enum(int, string, poh_store_set_name, max($d, 0))>", 4,
        "More sets...", 5);
    if ($pick = 1) {
        ~poh_store_withdraw($a);
        return;
    }
    if ($pick = 2 & $b >= 0) {
        ~poh_store_withdraw($b);
        return;
    }
    if ($pick = 3 & $c >= 0) {
        ~poh_store_withdraw($c);
        return;
    }
    if ($pick = 4 & $d >= 0) {
        ~poh_store_withdraw($d);
        return;
    }
    if ($pick ! 5) {
        return;
    }
    if ($d < 0) {
        $from = $home;
    } else {
        $from = calc($d + 1);
    }
}

// The $skip-th set at or after $from, WITHIN THIS STORE, that has anything in it, or -1 if there is
// no such set. The store bound is what stops a full cape rack paging on into the magic wardrobe's
// sets, which share the same flat table.
[proc,poh_store_nth](int $store, int $from, int $skip)(int)
def_int $s = $from;
def_int $last = enum(int, int, poh_store_setlast, $store);
def_int $seen = 0;
while ($s <= $last) {
    if (~poh_store_set_count($s) > 0) {
        if ($seen = $skip) {
            return($s);
        }
        $seen = calc($seen + 1);
    }
    $s = calc($s + 1);
}
return(-1);

[proc,poh_store_withdraw](int $set)
def_int $i = enum(int, int, poh_store_set_first, $set);
def_int $last = enum(int, int, poh_store_set_last, $set);
def_int $moved = 0;
def_int $left = 0;
while ($i <= $last) {
    def_namedobj $item = enum(int, namedobj, poh_store_item, $i);
    if (inv_total(poh_store_inv, $item) > 0) {
        if (inv_freespace(inv) > 0) {
            inv_moveitem(poh_store_inv, inv, $item, 1);
            $moved = calc($moved + 1);
        } else {
            $left = 1;
        }
    }
    $i = calc($i + 1);
}
if ($moved > 0) {
    mes("You take the <enum(int, string, poh_store_set_name, $set)> pieces out.");
}
if ($left = 1) {
    mes("You can't carry any more; the rest is still in there.");
}
