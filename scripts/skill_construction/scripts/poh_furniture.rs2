[proc,poh_furn_pack](int $rx, int $rz, int $lx, int $lz, int $angle, int $item)(int)
def_int $v = 0;
$v = setbit_range_toint($v, $rx, ^poh_furn_bit_rx, calc(^poh_furn_bit_rx + 2));
$v = setbit_range_toint($v, $rz, ^poh_furn_bit_rz, calc(^poh_furn_bit_rz + 2));
$v = setbit_range_toint($v, $lx, ^poh_furn_bit_lx, calc(^poh_furn_bit_lx + 2));
$v = setbit_range_toint($v, $lz, ^poh_furn_bit_lz, calc(^poh_furn_bit_lz + 2));
$v = setbit_range_toint($v, modulo($angle, 4), ^poh_furn_bit_angle, calc(^poh_furn_bit_angle + 1));
return(setbit_range_toint($v, $item, ^poh_furn_bit_item, calc(^poh_furn_bit_item + 7)));

[proc,poh_furn_field](int $v, int $bit, int $width)(int)
return(getbit_range($v, $bit, calc($bit + $width - 1)));

// The slot holding the piece on this tile, or -1. A linear scan over 64 is nothing next to the
// menus it sits behind, and it is the only lookup this design needs.
[proc,poh_furn_at](int $rx, int $rz, int $lx, int $lz)(int)
def_int $i = 0;
while ($i < ^poh_furn_slots) {
    def_int $v = ~poh_furn_get($i);
    if ($v ! 0) {
        if (~poh_furn_field($v, ^poh_furn_bit_rx, 3) = $rx & ~poh_furn_field($v, ^poh_furn_bit_rz, 3) = $rz) {
            if (~poh_furn_field($v, ^poh_furn_bit_lx, 3) = $lx & ~poh_furn_field($v, ^poh_furn_bit_lz, 3) = $lz) {
                return($i);
            }
        }
    }
    $i = calc($i + 1);
}
return(-1);

[proc,poh_furn_free]()(int)
def_int $i = 0;
while ($i < ^poh_furn_slots) {
    if (~poh_furn_get($i) = 0) {
        return($i);
    }
    $i = calc($i + 1);
}
return(-1);

// Everything in one room goes when the room does.
[proc,poh_furn_clear_cell](int $rx, int $rz)
def_int $i = 0;
while ($i < ^poh_furn_slots) {
    def_int $v = ~poh_furn_get($i);
    if ($v ! 0) {
        if (~poh_furn_field($v, ^poh_furn_bit_rx, 3) = $rx & ~poh_furn_field($v, ^poh_furn_bit_rz, 3) = $rz) {
            ~poh_furn_set($i, 0);
        }
    }
    $i = calc($i + 1);
}

// =========================================================================== materials

[proc,poh_furn_plank_total](int $wood)(int)
switch_int ($wood) {
    case 2 : return(inv_total(inv, oak_plank));
    case 3 : return(inv_total(inv, teak_plank));
    case 4 : return(inv_total(inv, mahogany_plank));
    case default : return(inv_total(inv, plank));
}

[proc,poh_furn_plank_take](int $wood, int $count)
switch_int ($wood) {
    case 2 : inv_del(inv, oak_plank, $count);
    case 3 : inv_del(inv, teak_plank, $count);
    case 4 : inv_del(inv, mahogany_plank, $count);
    case default : inv_del(inv, plank, $count);
}

[proc,poh_furn_xp](int $wood, int $count)(int)
switch_int ($wood) {
    case 2 : return(calc($count * ^poh_xp_oak));
    case 3 : return(calc($count * ^poh_xp_teak));
    case 4 : return(calc($count * ^poh_xp_mahogany));
    case default : return(calc($count * ^poh_xp_plank));
}

// =========================================================================== putting it there

// One case per buildable thing. The loc AND its shape are literals here, so a piece can only ever be
// placed as the shape its own hotspot was - there is no shape to store and none to get wrong.
[proc,poh_furn_show](int $item, coord $spot, int $angle)
switch_int ($item) {
    case 1 : loc_add($spot, poh_stove_1, $angle, centrepiece_straight, ^poh_loc_duration);
    case 2 : loc_add($spot, poh_stove_2, $angle, centrepiece_straight, ^poh_loc_duration);
    case 3 : loc_add($spot, poh_stove_3, $angle, centrepiece_straight, ^poh_loc_duration);
    case 4 : loc_add($spot, poh_stove_4, $angle, centrepiece_straight, ^poh_loc_duration);
    case 5 : loc_add($spot, poh_stove_5, $angle, centrepiece_straight, ^poh_loc_duration);
    case 6 : loc_add($spot, poh_stove_6, $angle, centrepiece_straight, ^poh_loc_duration);
    case 7 : loc_add($spot, poh_stove_7, $angle, centrepiece_straight, ^poh_loc_duration);
    case 8 : loc_add($spot, poh_sink_1, $angle, centrepiece_straight, ^poh_loc_duration);
    case 9 : loc_add($spot, poh_sink_2, $angle, centrepiece_straight, ^poh_loc_duration);
    case 10 : loc_add($spot, poh_sink_3, $angle, centrepiece_straight, ^poh_loc_duration);
    case 11 : loc_add($spot, poh_larder_1, $angle, centrepiece_straight, ^poh_loc_duration);
    case 12 : loc_add($spot, poh_larder_2, $angle, centrepiece_straight, ^poh_loc_duration);
    case 13 : loc_add($spot, poh_larder_3, $angle, centrepiece_straight, ^poh_loc_duration);
    case 14 : loc_add($spot, poh_kitchen_shelves_1, $angle, walldecor_straight_offset, ^poh_loc_duration);
    case 15 : loc_add($spot, poh_kitchen_shelves_2, $angle, walldecor_straight_offset, ^poh_loc_duration);
    case 16 : loc_add($spot, poh_kitchen_shelves_3, $angle, walldecor_straight_offset, ^poh_loc_duration);
    case 17 : loc_add($spot, poh_kitchen_shelves_4, $angle, walldecor_straight_offset, ^poh_loc_duration);
