    case 61 : loc_add($spot, poh_clock_1, $angle, centrepiece_diagonal, ^poh_loc_duration);
    case 62 : loc_add($spot, poh_clock_2, $angle, centrepiece_diagonal, ^poh_loc_duration);
    case 63 : loc_add($spot, poh_clock_3, $angle, centrepiece_diagonal, ^poh_loc_duration);
    case default : return;
