    case 10 : return(%poh_furn_10);
    case 11 : return(%poh_furn_11);
    case 12 : return(%poh_furn_12);
    case 13 : return(%poh_furn_13);
    case 14 : return(%poh_furn_14);
    case 15 : return(%poh_furn_15);
    case 16 : return(%poh_furn_16);
    case 17 : return(%poh_furn_17);
    case 18 : return(%poh_furn_18);
    case 19 : return(%poh_furn_19);
    case 20 : return(%poh_furn_20);
    case 21 : return(%poh_furn_21);
    case 22 : return(%poh_furn_22);
    case 23 : return(%poh_furn_23);
    case 24 : return(%poh_furn_24);
    case 25 : return(%poh_furn_25);
    case 26 : return(%poh_furn_26);
    case 27 : return(%poh_furn_27);
    case 28 : return(%poh_furn_28);
    case 29 : return(%poh_furn_29);
    case 30 : return(%poh_furn_30);
    case 31 : return(%poh_furn_31);
    case 32 : return(%poh_furn_32);
    case 33 : return(%poh_furn_33);
    case 34 : return(%poh_furn_34);
    case 35 : return(%poh_furn_35);
