    case 61 : return(%poh_furn_61);
    case 62 : return(%poh_furn_62);
    case 63 : return(%poh_furn_63);
    case default : return(0);
}

[proc,poh_furn_set](int $i, int $value)
switch_int ($i) {
    case 0 : %poh_furn_0 = $value;
    case 1 : %poh_furn_1 = $value;
    case 2 : %poh_furn_2 = $value;
    case 3 : %poh_furn_3 = $value;
