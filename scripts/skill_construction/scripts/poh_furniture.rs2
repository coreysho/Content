    case 49 : loc_add($spot, poh_bed_3, $angle, centrepiece_straight, ^poh_loc_duration);
    case 50 : loc_add($spot, poh_bed_4, $angle, centrepiece_straight, ^poh_loc_duration);
    case 51 : loc_add($spot, poh_bed_5, $angle, centrepiece_straight, ^poh_loc_duration);
    case 52 : loc_add($spot, poh_bed_6, $angle, centrepiece_straight, ^poh_loc_duration);
    case 53 : loc_add($spot, poh_bed_7, $angle, centrepiece_straight, ^poh_loc_duration);
    case 54 : loc_add($spot, poh_wardrobe_1, $angle, centrepiece_straight, ^poh_loc_duration);
    case 55 : loc_add($spot, poh_wardrobe_2, $angle, centrepiece_straight, ^poh_loc_duration);
    case 56 : loc_add($spot, poh_wardrobe_3, $angle, centrepiece_straight, ^poh_loc_duration);
    case 57 : loc_add($spot, poh_wardrobe_4, $angle, centrepiece_straight, ^poh_loc_duration);
    case 58 : loc_add($spot, poh_wardrobe_5, $angle, centrepiece_straight, ^poh_loc_duration);
