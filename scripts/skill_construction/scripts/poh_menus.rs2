// Six rooms a page, three pages, which is every room type twice over. The page loop is
// bounded rather than while(true): a menu that cannot end would hang the player script.
[proc,poh_pick_room](int $rx, int $rz, int $side)(int)
def_int $page = 0;
while ($page < 3) {
    def_int $a = ~poh_nth_room($rx, $rz, $side, calc($page * ^poh_menu_rows + 0));
    def_int $b = ~poh_nth_room($rx, $rz, $side, calc($page * ^poh_menu_rows + 1));
    def_int $c = ~poh_nth_room($rx, $rz, $side, calc($page * ^poh_menu_rows + 2));
    def_int $d = ~poh_nth_room($rx, $rz, $side, calc($page * ^poh_menu_rows + 3));
    def_int $e = ~poh_nth_room($rx, $rz, $side, calc($page * ^poh_menu_rows + 4));
    def_int $f = ~poh_nth_room($rx, $rz, $side, calc($page * ^poh_menu_rows + 5));
    def_int $more = ~poh_nth_room($rx, $rz, $side, calc($page * ^poh_menu_rows + ^poh_menu_rows));
    if ($a = 0) {
        return(0);
    }
    if_settext(poh_roommenu:subtitle, "Select a room to build");
    ~poh_room_row0($a);
    ~poh_room_row1($b);
    ~poh_room_row2($c);
    ~poh_room_row3($d);
    ~poh_room_row4($e);
    ~poh_room_row5($f);
    if ($more = 0) {
        if_sethide(poh_roommenu:more, true);
    } else {
        if_sethide(poh_roommenu:more, false);
    }
    if_openmain(poh_roommenu);
    if ($a ! 0) {
        if_addresumebutton(poh_roommenu:r0box);
    }
    if ($b ! 0) {
        if_addresumebutton(poh_roommenu:r1box);
    }
    if ($c ! 0) {
        if_addresumebutton(poh_roommenu:r2box);
    }
    if ($d ! 0) {
        if_addresumebutton(poh_roommenu:r3box);
    }
    if ($e ! 0) {
        if_addresumebutton(poh_roommenu:r4box);
    }
    if ($f ! 0) {
        if_addresumebutton(poh_roommenu:r5box);
    }
    if ($more ! 0) {
        if_addresumebutton(poh_roommenu:morebtn);
    }
    if_addresumebutton(poh_roommenu:cancel);
    p_pausebutton;
    switch_component (last_com) {
        case poh_roommenu:r0box : if_close; return($a);
        case poh_roommenu:r1box : if_close; return($b);
        case poh_roommenu:r2box : if_close; return($c);
        case poh_roommenu:r3box : if_close; return($d);
        case poh_roommenu:r4box : if_close; return($e);
        case poh_roommenu:r5box : if_close; return($f);
        case poh_roommenu:morebtn : $page = calc($page + 1);
        case default : if_close; return(0);
    }
}
if_close;
return(0);

