// Six rooms a page, three pages, which is every room type twice over. The page loop is
// bounded rather than while(true): a menu that cannot end would hang the player script.
//
// The list arrives as a bitmask from ~poh_fit_mask, worked out once before the window opens.
// Paging used to re-ask the geometry per row per page and cost a house its 500,000-opcode
// budget on page two - claude/poh-menu-opcount.md. Reading bits out of a mask is free.
//
// A click on a room you have the level for returns it and the caller does the paying. A click
// on one you do not says so and leaves the window open - money is a thing you go and fix, a
// level is a thing you go on browsing past.
[proc,poh_pick_room](int $mask)(int)
def_int $page = 0;
while ($page < 3) {
    def_int $a = ~poh_nth_fit($mask, calc($page * ^poh_menu_rows + 0));
    def_int $b = ~poh_nth_fit($mask, calc($page * ^poh_menu_rows + 1));
    def_int $c = ~poh_nth_fit($mask, calc($page * ^poh_menu_rows + 2));
    def_int $d = ~poh_nth_fit($mask, calc($page * ^poh_menu_rows + 3));
    def_int $e = ~poh_nth_fit($mask, calc($page * ^poh_menu_rows + 4));
    def_int $f = ~poh_nth_fit($mask, calc($page * ^poh_menu_rows + 5));
    def_int $more = ~poh_nth_fit($mask, calc($page * ^poh_menu_rows + ^poh_menu_rows));
    if ($a = 0) {
        return(0);
    }
    if_settext(poh_roommenu:subtitle, "Select a room to build");
    ~poh_room_row0($a);
    ~poh_room_row1($b);
    ~poh_room_row2($c);
    ~poh_room_row3($d);
    ~poh_room_row4($e);
    ~poh_room_row5($f);
    if ($more = 0) {
        if_sethide(poh_roommenu:more, true);
    } else {
        if_sethide(poh_roommenu:more, false);
    }
    if_openmain(poh_roommenu);
    if ($a ! 0) {
        if_addresumebutton(poh_roommenu:r0box);
    }
    if ($b ! 0) {
        if_addresumebutton(poh_roommenu:r1box);
    }
    if ($c ! 0) {
        if_addresumebutton(poh_roommenu:r2box);
    }
    if ($d ! 0) {
        if_addresumebutton(poh_roommenu:r3box);
    }
    if ($e ! 0) {
        if_addresumebutton(poh_roommenu:r4box);
    }
    if ($f ! 0) {
        if_addresumebutton(poh_roommenu:r5box);
    }
    if ($more ! 0) {
        if_addresumebutton(poh_roommenu:morebtn);
    }
    if_addresumebutton(poh_roommenu:cancel);
    p_pausebutton;
    def_int $pick = 0;
    switch_component (last_com) {
        case poh_roommenu:r0box : $pick = $a;
        case poh_roommenu:r1box : $pick = $b;
        case poh_roommenu:r2box : $pick = $c;
        case poh_roommenu:r3box : $pick = $d;
        case poh_roommenu:r4box : $pick = $e;
        case poh_roommenu:r5box : $pick = $f;
        case poh_roommenu:morebtn : $page = calc($page + 1);
        case default : if_close; return(0);
    }
    if ($pick > 0) {
        if (stat(construction) >= enum(int, int, poh_room_level, $pick)) {
            if_close;
            return($pick);
        }
        mes("You need a Construction level of <tostring(enum(int, int, poh_room_level, $pick))> to build a <enum(int, string, poh_room_name, $pick)>.");
    }
}
if_close;
return(0);

// =========================================================================== furniture

// A framed picture has no depth: seen three-quarters on it is a one-pixel sliver, so the
// families that are pictures get turned face-on. Everything else keeps the shared camera.
// tools/furnspec.json holds the list and says why each one is on it.
[proc,poh_furn_xan](int $fam)(int)
switch_int ($fam) {
    case 32 : return(120);   // wallchart
    case 36 : return(120);   // thronedecor
    case 46 : return(120);   // portrait
    case 47 : return(120);   // landscape
    case 48 : return(120);   // guildtrophy
    case 49 : return(120);   // sword
    case 50 : return(120);   // map
    case default : return(^poh_menu_xan);
}

[proc,poh_furn_yan](int $fam)(int)
switch_int ($fam) {
    case 32 : return(1536);   // wallchart
    case 36 : return(1536);   // thronedecor
    case 46 : return(1536);   // portrait
    case 47 : return(1536);   // landscape
    case 48 : return(1536);   // guildtrophy
    case 49 : return(1536);   // sword
    case 50 : return(1536);   // map
    case default : return(^poh_menu_yan);
}

