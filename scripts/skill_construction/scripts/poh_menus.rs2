[proc,poh_furn_slot0](int $item)
if ($item = 0) {
    if_sethide(poh_furnmenu:slot0, true);
    return;
}
if_sethide(poh_furnmenu:slot0, false);
def_int $state = ^poh_state_ready;
if (~poh_furn_have($item) = false) {
    $state = ^poh_state_poor;
}
if (stat(construction) < enum(int, int, poh_furn_level, $item)) {
    $state = ^poh_state_locked;
}
def_int $fam = enum(int, int, poh_furn_fam, $item);
if_setmodel(poh_furnmenu:s0model, ~poh_furn_model($item));
if_setangle(poh_furnmenu:s0model, ~poh_furn_xan($fam), ~poh_furn_yan($fam), ~poh_furn_zoom($item));
if_settext(poh_furnmenu:s0lvl, "<enum(int, string, poh_tint_level, $state)>Level <tostring(enum(int, int, poh_furn_level, $item))>");
if_settext(poh_furnmenu:s0name, "<enum(int, string, poh_tint_name, $state)><enum(int, string, poh_furn_name, $item)>");
if_settext(poh_furnmenu:s0need, "<enum(int, string, poh_tint_need, $state)><enum(int, string, poh_furn_need, $item)>");

