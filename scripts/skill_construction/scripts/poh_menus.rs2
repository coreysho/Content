}

[proc,poh_room_row0](int $type)
if ($type = 0) {
    if_sethide(poh_roommenu:row0, true);
    return;
}
if_sethide(poh_roommenu:row0, false);
def_int $state = ^poh_state_ready;
if (inv_total(inv, coins) < enum(int, int, poh_room_cost, $type)) {
    $state = ^poh_state_poor;
}
if (stat(construction) < enum(int, int, poh_room_level, $type)) {
    $state = ^poh_state_locked;
}
if_setmodel(poh_roommenu:r0model, ~poh_room_model($type));
if_setangle(poh_roommenu:r0model, ^poh_menu_xan, ^poh_menu_yan, ~poh_room_zoom($type));
if_settext(poh_roommenu:r0name, "<enum(int, string, poh_tint_name, $state)><enum(int, string, poh_room_name, $type)>: <enum(int, string, poh_tint_level, $state)>Lvl <tostring(enum(int, int, poh_room_level, $type))>");
if_settext(poh_roommenu:r0cost, "<enum(int, string, poh_tint_need, $state)><enum(int, string, poh_room_cost_text, $type)> coins");

