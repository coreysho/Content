// Eight slots is one more than the largest family has tiers, so the More button is dead
// weight today and there anyway: the tables are data, and a family can grow.
//
// Level is not a filter - the whole family is listed and the tiers above you are dimmed, so
// the window is also where you find out what the next twenty levels are for.
[proc,poh_furn_pick](int $fam)(int)
def_int $page = 0;
while ($page < 3) {
    def_int $a = ~poh_furn_nth($fam, calc($page * ^poh_menu_slots + 0));
    def_int $b = ~poh_furn_nth($fam, calc($page * ^poh_menu_slots + 1));
    def_int $c = ~poh_furn_nth($fam, calc($page * ^poh_menu_slots + 2));
    def_int $d = ~poh_furn_nth($fam, calc($page * ^poh_menu_slots + 3));
    def_int $e = ~poh_furn_nth($fam, calc($page * ^poh_menu_slots + 4));
    def_int $f = ~poh_furn_nth($fam, calc($page * ^poh_menu_slots + 5));
    def_int $g = ~poh_furn_nth($fam, calc($page * ^poh_menu_slots + 6));
    def_int $h = ~poh_furn_nth($fam, calc($page * ^poh_menu_slots + 7));
    def_int $more = ~poh_furn_nth($fam, calc($page * ^poh_menu_slots + ^poh_menu_slots));
    if ($a = 0) {
        return(0);
    }
    if_settext(poh_furnmenu:title, "<enum(int, string, poh_fam_name, $fam)>");
    if_settext(poh_furnmenu:subtitle, "Select what you want to build");
    ~poh_furn_slot0($a);
    ~poh_furn_slot1($b);
    ~poh_furn_slot2($c);
    ~poh_furn_slot3($d);
    ~poh_furn_slot4($e);
    ~poh_furn_slot5($f);
    ~poh_furn_slot6($g);
    ~poh_furn_slot7($h);
    if ($more = 0) {
        if_sethide(poh_furnmenu:more, true);
    } else {
        if_sethide(poh_furnmenu:more, false);
    }
    if_openmain(poh_furnmenu);
    if ($a ! 0) {
        if_addresumebutton(poh_furnmenu:s0box);
    }
    if ($b ! 0) {
        if_addresumebutton(poh_furnmenu:s1box);
    }
    if ($c ! 0) {
        if_addresumebutton(poh_furnmenu:s2box);
    }
    if ($d ! 0) {
        if_addresumebutton(poh_furnmenu:s3box);
    }
    if ($e ! 0) {
        if_addresumebutton(poh_furnmenu:s4box);
    }
    if ($f ! 0) {
        if_addresumebutton(poh_furnmenu:s5box);
    }
    if ($g ! 0) {
        if_addresumebutton(poh_furnmenu:s6box);
    }
    if ($h ! 0) {
        if_addresumebutton(poh_furnmenu:s7box);
    }
    if ($more ! 0) {
        if_addresumebutton(poh_furnmenu:morebtn);
    }
    if_addresumebutton(poh_furnmenu:cancel);
    p_pausebutton;
    def_int $pick = 0;
    switch_component (last_com) {
        case poh_furnmenu:s0box : $pick = $a;
        case poh_furnmenu:s1box : $pick = $b;
        case poh_furnmenu:s2box : $pick = $c;
        case poh_furnmenu:s3box : $pick = $d;
        case poh_furnmenu:s4box : $pick = $e;
        case poh_furnmenu:s5box : $pick = $f;
        case poh_furnmenu:s6box : $pick = $g;
        case poh_furnmenu:s7box : $pick = $h;
        case poh_furnmenu:morebtn : $page = calc($page + 1);
        case default : if_close; return(0);
    }
    if ($pick > 0) {
        if (stat(construction) >= enum(int, int, poh_furn_level, $pick)) {
            if_close;
            return($pick);
        }
        mes("You need a Construction level of <tostring(enum(int, int, poh_furn_level, $pick))> to build that.");
    }
}
if_close;
return(0);

// =========================================================================== tablets

// The lectern window. Same three tints and the same whole-row button as the other two; the
// difference is the icon, which is an OBJ and not a loc model. if_setobject takes the obj and
// the client reads xan, yan and zoom off the ObjType itself - zoom = the obj's own 2dzoom x
// 100 / scale - so there is no zoom table here and nothing to solve. 90 is the scale that puts
// a tablet in a 34px box; it was rendered and looked at, like the other two windows.
//
// State 1 here means "you have the level but not the runes", which is the same shape as not
// being able to afford a room - so the needs line goes red and the row stays clickable, and
// clicking it tells you exactly what is missing.
[proc,poh_tab_row0](int $tab)
if ($tab = 0) {
    if_sethide(poh_tabletmenu:row0, true);
    return;
}
if_sethide(poh_tabletmenu:row0, false);
def_int $state = ^poh_state_ready;
if (~poh_tab_have($tab) = false) {
    $state = ^poh_state_poor;
}
if (stat(magic) < enum(int, int, poh_tab_level, $tab)) {
    $state = ^poh_state_locked;
}
if_setobject(poh_tabletmenu:t0model, enum(int, namedobj, poh_tab_obj, $tab), 90);
if_settext(poh_tabletmenu:t0name, "<enum(int, string, poh_tint_name, $state)><enum(int, string, poh_tab_name, $tab)>");
if_settext(poh_tabletmenu:t0need, "<enum(int, string, poh_tint_need, $state)><enum(int, string, poh_tab_need, $tab)>");
if_settext(poh_tabletmenu:t0lvl, "<enum(int, string, poh_tint_level, $state)>Level <tostring(enum(int, int, poh_tab_level, $tab))>");

