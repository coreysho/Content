// Eight slots is one more than the largest family has tiers, so the More button is dead
// weight today and there anyway: the tables are data, and a family can grow.
[proc,poh_furn_pick](int $fam, int $level)(int)
def_int $page = 0;
while ($page < 3) {
    def_int $a = ~poh_furn_nth($fam, calc($page * ^poh_menu_slots + 0), $level);
    def_int $b = ~poh_furn_nth($fam, calc($page * ^poh_menu_slots + 1), $level);
    def_int $c = ~poh_furn_nth($fam, calc($page * ^poh_menu_slots + 2), $level);
    def_int $d = ~poh_furn_nth($fam, calc($page * ^poh_menu_slots + 3), $level);
    def_int $e = ~poh_furn_nth($fam, calc($page * ^poh_menu_slots + 4), $level);
    def_int $f = ~poh_furn_nth($fam, calc($page * ^poh_menu_slots + 5), $level);
    def_int $g = ~poh_furn_nth($fam, calc($page * ^poh_menu_slots + 6), $level);
    def_int $h = ~poh_furn_nth($fam, calc($page * ^poh_menu_slots + 7), $level);
    def_int $more = ~poh_furn_nth($fam, calc($page * ^poh_menu_slots + ^poh_menu_slots), $level);
    if ($a = 0) {
        return(0);
    }
    if_settext(poh_furnmenu:title, "<enum(int, string, poh_fam_name, $fam)>");
    if_settext(poh_furnmenu:subtitle, "Select what you want to build");
    ~poh_furn_slot0($a);
    ~poh_furn_slot1($b);
    ~poh_furn_slot2($c);
    ~poh_furn_slot3($d);
    ~poh_furn_slot4($e);
    ~poh_furn_slot5($f);
    ~poh_furn_slot6($g);
    ~poh_furn_slot7($h);
    if ($more = 0) {
        if_sethide(poh_furnmenu:more, true);
    } else {
        if_sethide(poh_furnmenu:more, false);
    }
    if_openmain(poh_furnmenu);
    if ($a ! 0) {
        if_addresumebutton(poh_furnmenu:s0box);
    }
    if ($b ! 0) {
        if_addresumebutton(poh_furnmenu:s1box);
    }
    if ($c ! 0) {
        if_addresumebutton(poh_furnmenu:s2box);
    }
    if ($d ! 0) {
        if_addresumebutton(poh_furnmenu:s3box);
    }
    if ($e ! 0) {
        if_addresumebutton(poh_furnmenu:s4box);
    }
    if ($f ! 0) {
        if_addresumebutton(poh_furnmenu:s5box);
    }
    if ($g ! 0) {
        if_addresumebutton(poh_furnmenu:s6box);
    }
    if ($h ! 0) {
        if_addresumebutton(poh_furnmenu:s7box);
    }
    if ($more ! 0) {
        if_addresumebutton(poh_furnmenu:morebtn);
    }
    if_addresumebutton(poh_furnmenu:cancel);
    p_pausebutton;
    switch_component (last_com) {
        case poh_furnmenu:s0box : if_close; return($a);
        case poh_furnmenu:s1box : if_close; return($b);
        case poh_furnmenu:s2box : if_close; return($c);
        case poh_furnmenu:s3box : if_close; return($d);
        case poh_furnmenu:s4box : if_close; return($e);
        case poh_furnmenu:s5box : if_close; return($f);
        case poh_furnmenu:s6box : if_close; return($g);
        case poh_furnmenu:s7box : if_close; return($h);
        case poh_furnmenu:morebtn : $page = calc($page + 1);
        case default : if_close; return(0);
    }
}
if_close;
return(0);
