// Debug commands for the player-owned house. The house itself is poh.rs2; this is only how it gets
// driven; the portal in Rimmington and the estate agent beside it are poh_portal.rs2.
//
//   ::~pohenter                   build your saved house and walk in
//   ::~pohbuild                   the same, in build mode - the hotspots stay up
//   ::~pohbuy                     grant the house the estate agent sells, without the coins
//   ::~pohportal <rot>            drop a real house portal where you stand, rotated <rot> x90, for
//                                 3 minutes - how to choose a tile and a facing without a deploy
//   ::~pohleave                   back to Rimmington; the instance is freed, the layout is kept
//   ::~pohset <rx> <rz> <t> <rot> put room type <t> (0 clears) at grid <rx>,<rz>, rotated <rot> x90
//   ::~pohwipe                    empty the grid, then hand out the starter house again
//   ::~pohstyle <0-5>             change which of the six house styles it is built from
//   ::~pohlist                    print the saved layout
//   ::~pohtown <0-5>              jump to the house portal in each of the six towns
//
// Room types are in poh_rooms.enum: 1 garden, 2 parlour, 3 kitchen, 4 dining room, 5 bedroom,
// 6 workshop, 7 chapel, 8 study, 9 throne room, 10 portal chamber, 11 combat room, 12 games room,
// 13 skill hall, 14 quest hall, 15 costume room.

[debugproc,pohenter]
// debugprocs run without protected access; the teleport and the varps need it
if (p_finduid(uid) = true) {
    ~poh_enter(false);
}

[debugproc,pohbuild]
if (p_finduid(uid) = true) {
    ~poh_enter(true);
}

[debugproc,pohbuy]
if (p_finduid(uid) = true) {
    ~poh_grant_starter;
    mes("You own a house in Rimmington.");
}

// Siting the portal by eye costs a commit, a push and a restart per guess, and it took two of those
// to find out that the OSRS portal is FIVE tiles wide and the ground west of the Rimmington road
// drops about a tile and a half across those five. This drops the real thing at your feet so the
// next tile can be chosen by looking at it. It stands for 3 minutes and then goes.
//
// IT CENTRES ON YOU NOW. It used to anchor at your feet, because loc_add anchors at the south-west
// corner - so the portal ran five tiles east of wherever you were standing and you were at a corner
// of it, not in the middle. Standing where you want the MIDDLE and reading a corner coordinate off
// the chat is how a placement ends up two tiles from where it was judged. The anchor is printed
// below as well, because the anchor is what goes in the map.
//
// The 5-wide face is centred on you exactly. The 2-deep dimension cannot be - it is even - so your
// tile is the near row and it runs one tile away from you; say if it wants to be the other one.
[debugproc,pohportal](int $rot)
if (p_finduid(uid) = true) {
    def_int $r = modulo($rot, 4);
    def_coord $anchor = movecoord(coord, -2, 0, 0);
    if (modulo($r, 2) = 1) {
        $anchor = movecoord(coord, 0, 0, -2);
    }
    loc_add($anchor, poh_house_portal, $r, centrepiece_straight, ^poh_portal_probe_ticks);
    mes("Centred on <tostring(divide(coordx(coord), 64))>_<tostring(divide(coordz(coord), 64))>_<tostring(modulo(coordx(coord), 64))>_<tostring(modulo(coordz(coord), 64))>, rotated <tostring($r)>.");
    mes("Anchor <tostring(divide(coordx($anchor), 64))>_<tostring(divide(coordz($anchor), 64))>_<tostring(modulo(coordx($anchor), 64))>_<tostring(modulo(coordz($anchor), 64))> - this is the number I need.");
    // width and length swap on an odd rotation, and loc_add anchors at the south-west corner
    if (modulo($r, 2) = 0) {
        mes("5 wide east-west, 2 deep, running north from you. Goes in 3 minutes.");
    } else {
        mes("5 wide north-south, 2 deep, running east from you. Goes in 3 minutes.");
    }
}

[debugproc,pohleave]
if (p_finduid(uid) = true) {
    ~poh_leave;
}

[debugproc,pohset](int $rx, int $rz, int $type, int $rot)
if (p_finduid(uid) = true) {
    if ($type < 0 | $type > 15) {
        mes("Room type must be 0-15.");
        return;
    }
    if (~poh_can_place($rx, $rz, $type, $rot) = false) {
        mes("That room would not join anything door to door.");
        return;
    }
    ~poh_room_set($rx, $rz, $type, $rot);
    %poh_owned = 1;
    if ($type = 0) {
        mes("Cleared <tostring($rx)>, <tostring($rz)>.");
    } else {
        mes("<enum(int, string, poh_room_name, $type)> at <tostring($rx)>, <tostring($rz)> rotated <tostring(modulo($rot, 4))>.");
    }
}

[debugproc,pohwipe]
if (p_finduid(uid) = true) {
    ~poh_grant_starter;
    mes("Layout reset to the starter house.");
}

[debugproc,pohstyle](int $style)
if (p_finduid(uid) = true) {
    if ($style < 0 | $style > 5) {
        mes("House style must be 0-5.");
        return;
    }
    %poh_style = $style;
    ~poh_window_refresh;
    mes("House style <tostring($style)>.");
}

[debugproc,pohlist]
if (p_finduid(uid) = true) {
    mes("House style <tostring(%poh_style)>, <tostring(~poh_room_total)> room(s):");
    def_int $rz = 0;
    while ($rz < ^poh_grid) {
        def_int $rx = 0;
        while ($rx < ^poh_grid) {
            def_int $type = ~poh_room_type($rx, $rz);
            if ($type ! 0) {
                mes("  <tostring($rx)>, <tostring($rz)>: <enum(int, string, poh_room_name, $type)> rotated <tostring(~poh_room_rot($rx, $rz))>");
            }
            $rx = calc($rx + 1);
        }
        $rz = calc($rz + 1);
    }
}

// Lands you on the tile you come out of each of the six real portals onto. The five new ones were
// sited by tools/portalsite.py proposing and Corey looking: the tool can say a footprint is level,
// clear and off the road, but not whether a five-tile portal LOOKS right on a given slope, and
// getting that wrong cost five shipped placements the first time round.
[debugproc,pohtown](int $town)
if (p_finduid(uid) = true) {
    switch_int ($town) {
        case 0 : p_telejump(0_46_50_9_24);   mes("Rimmington - level 1, 5000 coins.");
        case 1 : p_telejump(0_45_54_6_2);   mes("Taverley - level 10, 5000 coins.");
        case 2 : p_telejump(0_52_46_12_58);  mes("Pollnivneach - level 20, 7500 coins.");
        case 3 : p_telejump(0_41_56_43_47);  mes("Rellekka - level 30, 10000 coins.");
        case 4 : p_telejump(0_43_49_6_42);   mes("Brimhaven - level 40, 15000 coins.");
        case 5 : p_telejump(0_39_48_47_29);  mes("Yanille - level 50, 25000 coins.");
        case default : mes("Towns are 0 Rimmington, 1 Taverley, 2 Pollnivneach, 3 Rellekka, 4 Brimhaven, 5 Yanille.");
    }
    mes("Your house is in <enum(int, string, poh_loc_name, %poh_location)>.");
}
