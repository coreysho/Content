// Flatpacks: making furniture at a workbench and carrying it out of the house.
//
// The objs and the poh_furn_flat table are GENERATED by tools/genfurn.py from the "flatpack": true
// families in tools/furnspec.json - 84 of the 285 pieces, across 15 families, on 15 shared models
// re-encoded out of the rev240 OSRS cache. See configs/poh_flatpacks.obj for how that set was found.
//
// This file is NOT generated. It is the click: the workbench's own Work-at, a family grid built out
// of the existing Furniture window, and the make. Spending a flatpack at a hotspot is in
// poh_furniture.rs2, which IS generated - see ~poh_furn_click.
//
// WHERE THE EXPERIENCE IS PAID. On assembly, not on making. That is what makes a flatpack worth
// buying in OSRS and it is the only thing keeping this from paying twice for one set of planks: the
// workbench takes the materials and gives an item, ~poh_furn_click takes the item and gives the xp.
//
// WHY THE FAMILY GRID EXISTS. ~poh_furn_pick shows one family's ladder, because it is opened from a
// hotspot that already says which family you meant. A workbench does not, and 84 pieces at 8 a page
// is eleven pages of "more". So Work-at asks for the family first, in the same window, drawn with
// the family's first piece as its icon - which is also the row the ladder would have started on.

// --- The workbench ---
// All five tiers carry op1=Work-at in poh.loc. A trigger on an op a loc does not carry never fires
// and is not a compile error, so this list is the whole of what Work-at can reach.

[oploc1,loc_13704] ~poh_flat_workat;
[oploc1,loc_13705] ~poh_flat_workat;
[oploc1,loc_13706] ~poh_flat_workat;
[oploc1,loc_13707] ~poh_flat_workat;
[oploc1,loc_13708] ~poh_flat_workat;

[proc,poh_flat_workat]
if (%poh_instance = null) {
    mes("You can only build in your own house.");
    return;
}
if (instance_find(loc_coord) ! %poh_instance) {
    mes("You can only build in your own house.");
    return;
}
if (inv_total(inv, hammer) < 1 | inv_total(inv, saw) < 1) {
    mes("You need a hammer and a saw to make a flatpack.");
    return;
}
def_int $fam = ~poh_flat_pick;
if ($fam = 0) {
    return;
}
def_int $item = ~poh_furn_pick($fam, "Select what you want to flatpack");
if ($item = 0) {
    return;
}
~poh_flat_make($item);

// The level was already tested by ~poh_furn_pick, which refuses to return a piece you cannot build.
// Everything else is re-tested here because both windows suspend and the inventory can change while
// they are open.
[proc,poh_flat_make](int $item)
def_namedobj $flat = enum(int, namedobj, poh_furn_flat, $item);
if ($flat = null) {
    mes("That is not something that comes apart into a flatpack.");
    return;
}
// Two windows have suspended since Work-at was clicked, so the house is re-tested here as well.
if (%poh_instance = null | instance_find(coord) ! %poh_instance) {
    return;
}
if (~poh_furn_have($item) = false) {
    mes("You need <enum(int, string, poh_furn_need, $item)> to make that.");
    return;
}
// The room test comes AFTER the materials are taken, and the flatpack goes on the floor rather
// than being refused. Checking first would refuse an inventory that is full of the very planks
// about to be spent - which is the ordinary way to arrive at a workbench.
~poh_furn_take($item);
anim(human_hammer_hit, 0);
sound_synth(hammer_and_build, 1, 0);
if (inv_freespace(inv) > 0) {
    inv_add(inv, $flat, 1);
    mes("You make a flatpack of the <enum(int, string, poh_furn_name, $item)>.");
    return;
}
obj_add(coord, $flat, 1, ^lootdrop_duration);
mes("You make a flatpack of the <enum(int, string, poh_furn_name, $item)> and set it down - your hands are full.");

// --- The family grid ---
// The same poh_furnmenu window the Furniture creation menu uses, paged over poh_flat_fam instead of
// over one family's pieces. Each row is the family's FIRST piece - its model, its level and its
// materials - with the family's name written over the piece's, so the row reads "Chair / Level 8 /
// 3 planks" and opens the chair ladder.
//
// poh_flat_fam is an int table with no default=, and 0 past the end is the answer the pager wants -
// the same thing ~poh_furn_nth returns. See the note on it in poh_furniture.enum.

[proc,poh_flat_pick]()(int)
def_int $page = 0;
while ($page < 3) {
    def_int $a = enum(int, int, poh_flat_fam, calc($page * ^poh_menu_slots + 1));
    def_int $b = enum(int, int, poh_flat_fam, calc($page * ^poh_menu_slots + 2));
    def_int $c = enum(int, int, poh_flat_fam, calc($page * ^poh_menu_slots + 3));
    def_int $d = enum(int, int, poh_flat_fam, calc($page * ^poh_menu_slots + 4));
    def_int $e = enum(int, int, poh_flat_fam, calc($page * ^poh_menu_slots + 5));
    def_int $f = enum(int, int, poh_flat_fam, calc($page * ^poh_menu_slots + 6));
    def_int $g = enum(int, int, poh_flat_fam, calc($page * ^poh_menu_slots + 7));
    def_int $h = enum(int, int, poh_flat_fam, calc($page * ^poh_menu_slots + 8));
    def_int $more = enum(int, int, poh_flat_fam, calc($page * ^poh_menu_slots + ^poh_menu_slots + 1));
    if ($a = 0) {
        return(0);
    }
    if_settext(poh_furnmenu:title, "Workbench");
    if_settext(poh_furnmenu:subtitle, "Select what you want to flatpack");
    ~poh_flat_famslot0($a);
    ~poh_flat_famslot1($b);
    ~poh_flat_famslot2($c);
    ~poh_flat_famslot3($d);
    ~poh_flat_famslot4($e);
    ~poh_flat_famslot5($f);
    ~poh_flat_famslot6($g);
    ~poh_flat_famslot7($h);
    if ($more = 0) {
        if_sethide(poh_furnmenu:more, true);
    } else {
        if_sethide(poh_furnmenu:more, false);
    }
    if_openmain(poh_furnmenu);
    if ($a ! 0) {
        if_addresumebutton(poh_furnmenu:s0box);
    }
    if ($b ! 0) {
        if_addresumebutton(poh_furnmenu:s1box);
    }
    if ($c ! 0) {
        if_addresumebutton(poh_furnmenu:s2box);
    }
    if ($d ! 0) {
        if_addresumebutton(poh_furnmenu:s3box);
    }
    if ($e ! 0) {
        if_addresumebutton(poh_furnmenu:s4box);
    }
    if ($f ! 0) {
        if_addresumebutton(poh_furnmenu:s5box);
    }
    if ($g ! 0) {
        if_addresumebutton(poh_furnmenu:s6box);
    }
    if ($h ! 0) {
        if_addresumebutton(poh_furnmenu:s7box);
    }
    if ($more ! 0) {
        if_addresumebutton(poh_furnmenu:morebtn);
    }
    if_addresumebutton(poh_furnmenu:cancel);
    p_pausebutton;
    def_int $pick = 0;
    switch_component (last_com) {
        case poh_furnmenu:s0box : $pick = $a;
        case poh_furnmenu:s1box : $pick = $b;
        case poh_furnmenu:s2box : $pick = $c;
        case poh_furnmenu:s3box : $pick = $d;
        case poh_furnmenu:s4box : $pick = $e;
        case poh_furnmenu:s5box : $pick = $f;
        case poh_furnmenu:s6box : $pick = $g;
        case poh_furnmenu:s7box : $pick = $h;
        case poh_furnmenu:morebtn : $page = calc($page + 1);
        case default : if_close; return(0);
    }
    if ($pick > 0) {
        if_close;
        return($pick);
    }
}
if_close;
return(0);

// One per slot, because a component id cannot be held in a variable. Each defers to the ordinary
// piece row for the icon, the level and the materials, then writes the family's name over the
// piece's - the tint is recomputed rather than read back, because there is nothing to read it from.

[proc,poh_flat_famslot0](int $fam)
if ($fam = 0) {
    if_sethide(poh_furnmenu:slot0, true);
    return;
}
def_int $item = enum(int, int, poh_fam_first, $fam);
~poh_furn_slot0($item);
if_settext(poh_furnmenu:s0name, "<enum(int, string, poh_tint_name, ~poh_flat_state($item))><enum(int, string, poh_fam_name, $fam)>");

[proc,poh_flat_famslot1](int $fam)
if ($fam = 0) {
    if_sethide(poh_furnmenu:slot1, true);
    return;
}
def_int $item = enum(int, int, poh_fam_first, $fam);
~poh_furn_slot1($item);
if_settext(poh_furnmenu:s1name, "<enum(int, string, poh_tint_name, ~poh_flat_state($item))><enum(int, string, poh_fam_name, $fam)>");

