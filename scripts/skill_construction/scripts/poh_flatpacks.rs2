if_settext(poh_furnmenu:s7name, "<enum(int, string, poh_tint_name, ~poh_flat_state($item))><enum(int, string, poh_fam_name, $fam)>");

// The same three states the Furniture window uses, worked out again for the family row.
[proc,poh_flat_state](int $item)(int)
if (stat(construction) < enum(int, int, poh_furn_level, $item)) {
    return(^poh_state_locked);
}
if (~poh_furn_have($item) = false) {
    return(^poh_state_poor);
}
return(^poh_state_ready);
