// The anvil window's crossbow column (474): unfinished bolts, then limbs - smithing.rs2 sends the
// one for the bar in hand.

[smithing_bronze_bolts]
size=2
stock1=bronze_bolts_unf,10
stock2=bronze_limbs,1

