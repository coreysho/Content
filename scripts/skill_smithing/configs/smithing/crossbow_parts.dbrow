// Crossbow parts at the anvil (474): ten unfinished bolts or a pair of limbs from one bar. The window
// shows them in its sixth column (skill_smithing/interfaces/smithing.if); blurite, which makes nothing
// else, asks which (smithing.rs2). Levels are OSRS's, which are 2006's.

[smith_bronze_bolts_unf]
table=smithing
data=ifproduct,bronze_bolts_unf
data=product,bronze_bolts_unf
data=product_amount,10
data=levelrequired,3
data=end_message,ten unfinished bolts
data=levelfailmessage,Bronze Bolts
data=bar,bronze_bar
data=bar_amount,1

[smith_bronze_limbs]
table=smithing
data=ifproduct,bronze_limbs
data=product,bronze_limbs
data=product_amount,1
data=levelrequired,6
data=end_message,a pair of crossbow limbs
data=levelfailmessage,Bronze Crossbow Limbs
data=bar,bronze_bar
data=bar_amount,1

