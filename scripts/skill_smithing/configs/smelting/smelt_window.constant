// if_setobject's third argument is a scale: the client works out zoom as the ObjType's own
// 2dzoom * 100 / scale, so 100 means "draw it exactly as the item icon does". The cache panel's
// own models are authored at zoom=550 with obj_bronze_bar in every slot, which is a placeholder -
// the server has to set all eight anyway, and setting them by obj is how every other window in
// this fork does it. Rendered before shipping; see claude/four-cache-windows.md.
^smelt_window_scale = 100
