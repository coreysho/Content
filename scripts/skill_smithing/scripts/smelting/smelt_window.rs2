// The furnace's Smelt window.
// 
// GENERATED by tools/genwindows.py. Edit tools/adoptspec.json, not this file.
// 
// THE FURNACE HAS SAID "Smelt" SINCE THE FORK BEGAN. Seven locs in the 377 cache carry
// op2=Smelt and nothing answered oploc2 on any of them, so right-clicking a furnace offered
// the option and clicking it did nothing - no error, no log line. Same shape as Lvl-6
// Enchant and the four unwired spellbook buttons: the cache is ahead of the content and the
// symptom is silence.
// 
// Nothing here knows a level, an ore or an experience figure. ~smelt_bar in smelting.rs2 is
// the one place a bar is smelted, and it reads the bar obj's own smelting_struct, which is
// what using an ore on the furnace has always read.

[oploc2,_smithing_furnace]
~smelt_window_open;

// The eight icons ship as obj_bronze_bar in the cache, so the server sets each one.
// if_setobject copies xan/yan/zoom off the ObjType, so there is no zoom table here.
[proc,smelt_window_open]
if_setobject(smelt_window:icon1, bronze_bar, ^smelt_window_scale);
if_setobject(smelt_window:icon2, iron_bar, ^smelt_window_scale);
if_setobject(smelt_window:icon3, silver_bar, ^smelt_window_scale);
if_setobject(smelt_window:icon4, steel_bar, ^smelt_window_scale);
if_setobject(smelt_window:icon5, gold_bar, ^smelt_window_scale);
if_setobject(smelt_window:icon6, mithril_bar, ^smelt_window_scale);
if_setobject(smelt_window:icon7, adamantite_bar, ^smelt_window_scale);
if_setobject(smelt_window:icon8, runite_bar, ^smelt_window_scale);
if_openchat(smelt_window);

[if_button,smelt_window:smelt_1_bronze]
if (p_finduid(uid) = true) {
    @smelt_window_go(bronze_bar, 1);
}

[if_button,smelt_window:smelt_5_bronze]
if (p_finduid(uid) = true) {
    @smelt_window_go(bronze_bar, 5);
}

[if_button,smelt_window:smelt_10_bronze]
if (p_finduid(uid) = true) {
    @smelt_window_go(bronze_bar, 10);
}

[if_button,smelt_window:smelt_x_bronze]
if (p_finduid(uid) = true) {
    @smelt_window_ask(bronze_bar);
