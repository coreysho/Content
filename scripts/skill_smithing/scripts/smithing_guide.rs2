// Smithing skill guide. Seven category buttons - the only guide that genuinely
// needs them, since the six metal tiers plus smelting run to 134 entries, far
// past the interface's 40-row list. These are the same seven categories, in the
// same order, that the 377 cache shipped hard-coded into the interface.
[proc,open_smithing_guide]
%skillguide_page = 1;
~smithing_guide_render;

[proc,smithing_guide_render]
~skillguide_begin(^guide_smithing, "Smithing");
~skillguide_panels(7);
~skillguide_button(1, "Smelting");
~skillguide_button(2, "Bronze");
~skillguide_button(3, "Iron");
~skillguide_button(4, "Steel");
~skillguide_button(5, "Mithril");
~skillguide_button(6, "Adamant");
~skillguide_button(7, "Rune");
def_int $lvl = stat(smithing);
switch_int (%skillguide_page) {
    case 2 : ~smithing_guide_bronze($lvl);
    case 3 : ~smithing_guide_iron($lvl);
    case 4 : ~smithing_guide_steel($lvl);
    case 5 : ~smithing_guide_mithril($lvl);
    case 6 : ~smithing_guide_adamant($lvl);
    case 7 : ~smithing_guide_rune($lvl);
    case default : ~smithing_guide_smelting($lvl);
}
~skillguide_show;

[proc,smithing_guide_smelting](int $lvl)
~skillguide_row(1, $lvl, 1, bronze_bar, "Bronze bar");
~skillguide_row(2, $lvl, 15, iron_bar, "Iron bar");
~skillguide_row(3, $lvl, 20, silver_bar, "Silver bar");
~skillguide_row(4, $lvl, 30, steel_bar, "Steel bar");
~skillguide_row(5, $lvl, 35, mcannonball, "Cannonball");
~skillguide_row(6, $lvl, 40, gold_bar, "Gold bar");
~skillguide_row(7, $lvl, 50, mithril_bar, "Mithril bar");
~skillguide_row(8, $lvl, 70, adamantite_bar, "Adamantite bar");
~skillguide_row(9, $lvl, 85, runite_bar, "Runite bar");

