// The bottomless compost bucket. Models and 2d cameras imported from the OSRS cache by
// tools/models/importosrs.py; OSRS ships an empty and a filled version and both come across, so
// the inventory icon shows whether there is anything in it - the same trick as the herb sack's
// open and closed models.
//
// The filled one's single recolour pair matches no face on the converted mesh and is dropped
// rather than carried as a no-op; the two models already differ.
//
// There is no param for what is inside: the store's one slot holds the compost itself, so the OBJ
// in that slot is the tier and its COUNT is the charges. One type at a time, as in OSRS.

[bottomless_bucket]
name=Bottomless compost bucket
desc=It can hold a lot of compost.
model=obj_bottomless_bucket
2dzoom=1020
2dxan=204
2dyan=1660
2dyof=-18
weight=2000g
cost=10000
members=yes
iop1=Fill
iop2=Check

// Same item with something in it. Untradeable while full - emptying it back into buckets is not a
// thing OSRS allows, so trading it would be trading the compost.
[bottomless_bucket_filled]
name=Bottomless compost bucket
desc=It can hold a lot of compost.
model=obj_bottomless_bucket_filled
2dzoom=1020
2dxan=204
2dyan=1660
2dyof=-18
weight=2000g
cost=10000
members=yes
tradeable=no
iop1=Fill
iop2=Check
iop5=Destroy
