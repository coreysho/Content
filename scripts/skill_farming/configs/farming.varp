// Last world minute the whole farming state was brought up to date for this player.
[farming_last_tick]
scope=perm

// Tool leprechaun storage. He keeps things for you anywhere in the world, so this is one
// player-wide store rather than one per farming area.
//   bits 0-2 rakes, 3-5 seed dibbers, 6-8 spades, 9-11 gardening trowels, 12-14 secateurs,
//   bits 15-18 watering can (0 = none stored, 1..9 = a can holding 0..8 doses)
[farming_store_tools]
scope=perm

// World minute the last tree seedling was watered. One value covers every seedling in the
// inventory: they all take the same five minutes, so the only effect of sharing it is that a
// second seedling watered while the first is still going finishes at the same time as it.
[farming_seedling_time]
scope=perm

[farming_store_buckets]
scope=perm

[farming_store_compost]
scope=perm

[farming_store_supercompost]
scope=perm

