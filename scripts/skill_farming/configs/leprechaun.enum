// What belongs in each slot of leprechaun_store, by slot number.
//
// Two jobs. It is the PLACEHOLDER art - an empty slot shows a faded icon of the thing that goes
// there, so the window tells you what he will take before you have given him any - and it is the
// order Deposit-everything sweeps in. The can's row is a full can because that is the icon a
// player reads as "a watering can"; any of the nine doses can actually be stored there.
[leprechaun_items]
inputtype=int
outputtype=namedobj
default=null
val=0,rake
val=1,spade
val=2,dibber
val=3,secateurs
val=4,fairy_enchanted_secateurs
val=5,gardening_trowel
val=6,watering_can_8
val=7,bottomless_bucket
val=8,plant_cure
val=9,bucket_empty
val=10,bucket_compost
val=11,bucket_supercompost
