// GENERATED by tools/farming/gen.py - do not hand-edit; regenerate instead.
// Corey, 2026-09-05. See claude/farming-skill.md.


// Crop data lives on the seed (or, for trees and fruit trees, on the sapling you actually plant),
// so "what does this seed grow into" is one oc_param lookup rather than a switch with 56 arms.
//
// Every *_state value below was read out of the 377 cache's multiloc tables, not invented. The rule
// they all follow is: visible state = base_state + stage, with stage 0 = just planted and
// stage == stages = fully grown. Diseased and dead blocks are indexed by stage - 1.

// Which patch a farming loc is. Added to every patch and compost bin in
// skill_farming/configs/farming.loc so that one set of triggers can serve all 43 of them.
[farming_patch]
type=int
default=0

// Non-zero marks an item as plantable, and identifies the crop everywhere else.
[farming_crop]
type=int
default=0

// One of ^farming_family_*.
[farming_family]
type=int
default=0

[farming_level]
type=int
default=1

// All xp values are stored x10 so 8.5 xp survives as 85.
[farming_plant_xp]
type=int
default=0

[farming_harvest_xp]
type=int
default=0

// Awarded once, for the Check-health action on trees, fruit trees, bushes, cactus and calquat.
[farming_check_xp]
type=int
default=0

// Number of growth cycles from planted to fully grown.
[farming_stages]
type=int
default=4

// Minutes per growth cycle.
[farming_cycle]
type=int
default=10

[farming_base_state]
type=int
default=0

[farming_diseased_state]
type=int
default=0

[farming_dead_state]
type=int
default=0

// 0 where the family cannot be watered.
[farming_watered_state]
type=int
default=0

// First state of the harvest-count run that follows fully-grown, for crops that hold produce.
[farming_produce_state]
type=int
default=0

// How many berries/fruit/spines the crop holds when full.
[farming_produce_max]
type=int
default=0

[farming_produce]
type=namedobj
default=null

// Chance-to-save endpoints, x10, out of 256.
[farming_cts_low]
type=int
default=0

[farming_cts_high]
type=int
default=0

// Disease chance per vulnerable cycle, out of 128. 0 = cannot be diseased.
[farming_disease]
type=int
default=0

// What the patch's farmer wants, and how many. null = this crop cannot be protected.
[farming_protect_obj]
type=namedobj
default=null

[farming_protect_count]
type=int
default=0

// Seeds consumed to plant one patch.
[farming_seed_count]
type=int
default=1

// What a fully grown but unchecked tree/bush/cactus shows, i.e. the Check-health appearance.
// 0 where the family has no check action.
[farming_check_state]
type=int
default=0

// What it shows once checked. For ordinary trees this is a second fully-grown model carrying
// Chop down; for everything else it is the plain fully-grown state.
[farming_checked_state]
type=int
default=0

// What is left after a tree is chopped down, cleared with a spade. 0 where there is no stump.
[farming_stump_state]
type=int
default=0
