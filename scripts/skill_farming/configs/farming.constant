// Weeds. State 0 is a fully overgrown patch, 3 is bare soil ready to plant; raking counts up,
// weeds regrow counting down. Regrowth is deliberately slow so a patch you cleared last night is
// still usable in the morning.
^farming_state_weeds_full = 0
^farming_state_weeded = 3
^farming_weed_regrow_minutes = 100

// Condition, as stored implicitly by which state block the patch is sitting in.
^farming_healthy = 0
^farming_diseased = 1
^farming_dead = 2
// Not a real condition, but what a chopped-down tree leaves behind until it is dug out.
^farming_stump = 3

// Compost tiers.
^farming_compost_none = 0
^farming_compost_normal = 1
^farming_compost_super = 2

// Base harvest lives before compost. Compost adds 1, supercompost adds 2.
^farming_base_lives = 3

// Disease is rolled out of 128 once per growth cycle, except on the cycle that finishes the crop.
^farming_disease_scale = 128
^farming_compost_disease_num = 1
^farming_compost_disease_div = 2
^farming_supercompost_disease_num = 1
^farming_supercompost_disease_div = 5

// Chance-to-save is out of 256, interpolated from cts_low at level 1 to cts_high at 99.
// Both are stored x10 on the seed so the published half-points survive.
^farming_cts_scale = 256
^farming_magic_secateurs_num = 11
^farming_magic_secateurs_div = 10

// How often a logged-in player's patches are brought up to date. 100 ticks = 60s, and since every
// growth cycle is a multiple of 5 minutes nothing can be missed at this resolution.
^farming_tick_interval = 100

// Compost bin: 15 items in, one rot cycle, 15 buckets out.
^farming_compost_bin_size = 15
^farming_compost_rot_minutes = 45
^farming_compost_xp = 45
^farming_supercompost_xp = 85
^farming_rake_xp = 40

// Compost bin states inside its own 8-bit varbit: 0 empty/open, 1..15 filling, 16 closed+rotting,
// 17 rotted compost ready, 18 rotted supercompost ready. The bin loc's own multiloc only draws
// open/closed/full, so anything above 16 renders as a closed bin until it is opened.
^farming_bin_empty = 0
^farming_bin_rotting = 16
^farming_bin_compost = 17
^farming_bin_supercompost = 18

// Speed knob for testing. Every growth cycle is divided by this, so 10 turns a 40-minute allotment
// into 4 minutes. 1 = authentic. ::~farmgrow forces one cycle on every patch regardless.
^farming_speed_divisor = 1
