// What is in the bottomless compost bucket, and how much of it.
//
// ONE slot, holding the compost itself: the obj is the tier and the count is the number of uses
// left. That is why there is no varp for either - a slot already stores an obj and a number, and
// "one type at a time" falls out of there being one slot rather than being enforced anywhere.
[compost_bucket_store]
scope=perm
size=1
stackall=yes
protect=no
