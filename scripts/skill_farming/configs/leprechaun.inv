// The tool leprechaun's store: one slot per thing he will hold, in ^leprechaun_slot_* order.
//
// stackall because he holds a hundred rakes and a rake does not stack on its own - the count in
// the slot IS how many he has, which is the whole reason this is an inv rather than a varp.
// scope=perm because it is the player's, and he holds it anywhere in the world.
[leprechaun_store]
scope=perm
size=^leprechaun_slots
stackall=yes
