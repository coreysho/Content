// Farming: gardeners and the tool leprechaun (Corey, 2026-09-05) - see claude/farming-skill.md.
//
// Every farming site in the 377 cache already has its gardener standing beside it, named and
// spawned - Elstan at Falador, Dantaera at Catherby, Kragen at Ardougne, Lyra at Port Phasmatys,
// and the numbered gardener npcs at the hops, bush, tree and fruit tree patches. Their spawn
// coordinates were checked against the patch coordinates, so the pairings below are the map's, not
// a guess.
//
// Herbs and flowers have no protection payment in 2006, which is why the four allotment gardeners
// only ever offer to look after their two allotments even though they stand next to a herb and a
// flower patch as well. The cactus and calquat patches have no gardener in this cache at all.

// ============================================================================ protection

// Everything a gardener needs to know about one patch, so the dialogue can stay short.
[proc,farming_protectable](int $patch)(boolean)
def_int $crop = ~farming_crop_id($patch);
if ($crop = 0) {
    return(false);
}
if (~farming_protected($patch) = true) {
    return(false);
}
def_namedobj $seed = ~farming_crop_obj($crop);
if ($seed = null | oc_param($seed, farming_protect_obj) = null) {
    return(false);
}
def_int $stage;
def_int $condition;
def_int $watered;
$stage, $condition, $watered = ~farming_decode($patch, $seed);
// Paying after the plant is already diseased does not save it, and there is nothing to protect once
// it is fully grown.
if ($condition ! ^farming_healthy | $stage >= oc_param($seed, farming_stages)) {
    return(false);
}
return(true);

// Gardeners take payment noted or unnoted, and will happily take a mix of the two - which matters,
// because 40 cabbages for a redberry bush do not fit in an inventory alongside your tools otherwise.
// oc_cert returns the item itself when it has no banknote form, hence the guard.
[proc,farming_payment_held](namedobj $want)(int)
def_obj $plain = $want;
def_obj $noted = oc_cert($plain);
def_int $total = inv_total(inv, $plain);
if ($noted ! $plain) {
    $total = add($total, inv_total(inv, $noted));
}
return($total);

// Spends the loose ones first, then makes up the difference out of the notes.
[proc,farming_payment_take](namedobj $want, int $count)
def_obj $plain = $want;
def_int $loose = min(inv_total(inv, $plain), $count);
if ($loose > 0) {
    inv_del(inv, $plain, $loose);
    $count = sub($count, $loose);
}
if ($count <= 0) {
    return;
}
def_obj $noted = oc_cert($plain);
if ($noted ! $plain) {
    inv_del(inv, $noted, $count);
}

[proc,farming_offer_protection](int $patch)
def_namedobj $seed = ~farming_crop_obj(~farming_crop_id($patch));
def_namedobj $want = oc_param($seed, farming_protect_obj);
def_int $count = oc_param($seed, farming_protect_count);

~chatnpc("<p,happy>I'll look after your <lowercase(oc_name($seed))> for <tostring($count)> <lowercase(oc_name($want))>. Noted ones are fine. Deal?");
def_int $choice = ~p_choice2("Yes, here you go.", 1, "No thanks.", 2);
if ($choice ! 1) {
    ~chatplayer("<p,neutral>No thanks.");
    return;
}
if (~farming_payment_held($want) < $count) {
    ~chatnpc("<p,sad>You don't have <tostring($count)> <lowercase(oc_name($want))> on you.");
    return;
}
// Re-check: the crop could have grown, died or been paid for while the dialogue was open.
if (~farming_protectable($patch) = false) {
    ~chatnpc("<p,neutral>Never mind - that patch doesn't need me any more.");
    return;
}
~farming_payment_take($want, $count);
~farming_set_protected($patch, 1);
~chatnpc("<p,happy>Lovely. I'll keep an eye on it for you.");

// Two patches is the most any one gardener covers, so one choice covers every case.
[proc,farming_farmer](int $a, int $b)
~farming_update($a);
~farming_update($b);
def_boolean $can_a = ~farming_protectable($a);
def_boolean $can_b = ~farming_protectable($b);

if ($can_a = false & $can_b = false) {
    ~chatnpc("<p,neutral>Nothing of yours needs looking after just now. Come back when you've something growing.");
    return;
}
if ($can_a = true & $can_b = false) {
    ~farming_offer_protection($a);
    return;
}
if ($can_a = false & $can_b = true) {
    ~farming_offer_protection($b);
    return;
}

def_namedobj $seed_a = ~farming_crop_obj(~farming_crop_id($a));
def_namedobj $seed_b = ~farming_crop_obj(~farming_crop_id($b));
~chatnpc("<p,quiz>Which patch would you like me to look after?");
def_int $choice = ~p_choice3(
    append("The ", lowercase(oc_name($seed_a))), 1,
    append("The ", lowercase(oc_name($seed_b))), 2,
    "Neither, thanks.", 3);
if ($choice = 1) {
    ~farming_offer_protection($a);
} else if ($choice = 2) {
    ~farming_offer_protection($b);
}

// One patch only - the hops, bush, tree and fruit tree gardeners.
[proc,farming_farmer_single](int $a)
~farming_update($a);
if (~farming_protectable($a) = false) {
    ~chatnpc("<p,neutral>Nothing of yours needs looking after just now. Come back when you've something growing.");
    return;
}
~farming_offer_protection($a);

// ---------------------------------------------------------------- allotment gardeners
[opnpc1,elstan]   ~farming_farmer(^farming_patch_veg_patch_1, ^farming_patch_veg_patch_2);
[opnpc1,dantaera] ~farming_farmer(^farming_patch_veg_patch_3, ^farming_patch_veg_patch_4);
[opnpc1,kragen]   ~farming_farmer(^farming_patch_veg_patch_5, ^farming_patch_veg_patch_6);
[opnpc1,lyra]     ~farming_farmer(^farming_patch_veg_patch_7, ^farming_patch_veg_patch_8);

// ---------------------------------------------------------------- hops
// francis is Entrana; the numbered npcs are Yanille, Lumbridge and McGrubor's Wood.
[opnpc1,farming_gardener_hops_1] ~farming_farmer_single(^farming_patch_hops_patch_1);
[opnpc1,francis]                 ~farming_farmer_single(^farming_patch_hops_patch_2);
[opnpc1,farming_gardener_hops_3] ~farming_farmer_single(^farming_patch_hops_patch_3);
[opnpc1,farming_gardener_hops_4] ~farming_farmer_single(^farming_patch_hops_patch_4);

// ---------------------------------------------------------------- bushes
[opnpc1,farming_gardener_bush_1] ~farming_farmer_single(^farming_patch_bush_patch_1);
[opnpc1,farming_gardener_bush_2] ~farming_farmer_single(^farming_patch_bush_patch_2);
[opnpc1,farming_gardener_bush_3] ~farming_farmer_single(^farming_patch_bush_patch_3);
[opnpc1,farming_gardener_bush_4] ~farming_farmer_single(^farming_patch_bush_patch_4);

// ---------------------------------------------------------------- trees
[opnpc1,farming_gardener_tree_1] ~farming_farmer_single(^farming_patch_tree_patch_1);
[opnpc1,farming_gardener_tree_2] ~farming_farmer_single(^farming_patch_tree_patch_2);
[opnpc1,farming_gardener_tree_3] ~farming_farmer_single(^farming_patch_tree_patch_3);
[opnpc1,farming_gardener_tree_4] ~farming_farmer_single(^farming_patch_tree_patch_4);

// ---------------------------------------------------------------- fruit trees
[opnpc1,farming_gardener_fruit_1] ~farming_farmer_single(^farming_patch_fruit_tree_patch_1);
[opnpc1,farming_gardener_fruit_2] ~farming_farmer_single(^farming_patch_fruit_tree_patch_2);
[opnpc1,farming_gardener_fruit_3] ~farming_farmer_single(^farming_patch_fruit_tree_patch_3);
[opnpc1,farming_gardener_fruit_4] ~farming_farmer_single(^farming_patch_fruit_tree_patch_4);

// ============================================================================ tool leprechaun
//
// He stores your tools anywhere in the world (there is one store, not one per patch), fills your
// watering can, and turns farming produce into banknotes. Twenty-five of him are already spawned.

[proc,farming_store_get](int $bit_start, int $bit_end)(int)
return(getbit_range(%farming_store_tools, $bit_start, $bit_end));

[proc,farming_store_set](int $value, int $bit_start, int $bit_end)
%farming_store_tools = setbit_range_toint(%farming_store_tools, $value, $bit_start, $bit_end);

[proc,farming_store_tool](namedobj $tool, int $bit_start, int $bit_end)
if (inv_total(inv, $tool) < 1) {
    ~chatnpc("<p,neutral>You haven't got <lowercase(oc_name($tool))> to give me.");
    return;
}
def_int $held = ~farming_store_get($bit_start, $bit_end);
if ($held >= 7) {
    ~chatnpc("<p,neutral>I'm not carrying any more of those for you.");
    return;
}
inv_del(inv, $tool, 1);
~farming_store_set(add($held, 1), $bit_start, $bit_end);
mes("You hand the <lowercase(oc_name($tool))> to the leprechaun.");

[proc,farming_withdraw_tool](namedobj $tool, int $bit_start, int $bit_end)
def_int $held = ~farming_store_get($bit_start, $bit_end);
if ($held < 1) {
    ~chatnpc("<p,neutral>I'm not holding one of those for you.");
    return;
}
if (inv_freespace(inv) < 1) {
    ~chatnpc("<p,neutral>You've no room for it.");
    return;
}
~farming_store_set(sub($held, 1), $bit_start, $bit_end);
inv_add(inv, $tool, 1);
mes("The leprechaun hands you <lowercase(oc_name($tool))>.");

[proc,farming_leprechaun_tools]
def_int $choice = ~p_choice3("Rake", 1, "Seed dibber", 2, "Spade", 3);
switch_int($choice) {
    case 1 : ~farming_leprechaun_toolmenu(rake, 0, 2);
    case 2 : ~farming_leprechaun_toolmenu(dibber, 3, 5);
    case 3 : ~farming_leprechaun_toolmenu(spade, 6, 8);
    case default : return;
}

[proc,farming_leprechaun_toolmenu](namedobj $tool, int $bit_start, int $bit_end)
~chatnpc(append(append("<p,neutral>I'm holding ", tostring(~farming_store_get($bit_start, $bit_end))), " of those for you."));
def_int $choice = ~p_choice2("Take one out.", 1, "Put one in.", 2);
if ($choice = 1) {
    ~farming_withdraw_tool($tool, $bit_start, $bit_end);
    return;
}
~farming_store_tool($tool, $bit_start, $bit_end);

[opnpc1,farming_tools_leprechaun]
~chatnpc("<p,happy>Top o' the mornin'! Need a hand with your tools?");
def_int $choice = ~p_choice3("My tools, please.", 1, "Fill my watering can.", 2, "Nothing, thanks.", 3);
switch_int($choice) {
    case 1 : ~farming_leprechaun_tools;
    case 2 : ~farming_leprechaun_fill_can;
    case default : ~chatplayer("<p,neutral>Nothing, thanks.");
}

[opnpc3,farming_tools_leprechaun]
~chatnpc("<p,neutral>Use any of your farming produce on me and I'll turn it into a banknote for you.");

// He fills a watering can straight to eight doses, which is the whole reason to look for him.
[proc,farming_leprechaun_fill_can]
def_int $slot = 0;
def_boolean $found = false;
while ($slot < inv_size(inv) & $found = false) {
    def_obj $item = inv_getobj(inv, $slot);
    if ($item = watering_can_0 | $item = watering_can_1 | $item = watering_can_2 | $item = watering_can_3
        | $item = watering_can_4 | $item = watering_can_5 | $item = watering_can_6 | $item = watering_can_7) {
        inv_setslot(inv, $slot, watering_can_8, 1);
        $found = true;
    }
    $slot = add($slot, 1);
}
if ($found = false) {
    ~chatnpc("<p,neutral>You've no watering can that needs filling.");
    return;
}
mes("The leprechaun fills your watering can.");

// Noting produce. oc_cert returns an obj, but inv_add takes a namedobj and the compiler will not
// narrow one to the other, so the mapping is spelled out. That is no bad thing here: it also keeps
// him to actual farming produce rather than anything that merely happens to be compostable.
// Woad leaf and cave nightshade have no banknote form in this cache and are left out.
[proc,farming_note_obj](obj $item)(namedobj)
switch_obj($item) {
    case potato : return(cert_potato);
    case onion : return(cert_onion);
    case cabbage : return(cert_cabbage);
    case tomato : return(cert_tomato);
    case sweetcorn : return(cert_sweetcorn);
    case strawberry : return(cert_strawberry);
    case watermelon : return(cert_watermelon);
    case barley : return(cert_barley);
    case jute_fibre : return(cert_jute_fibre);
    case hammerstone_hops : return(cert_hammerstone_hops);
    case asgarnian_hops : return(cert_asgarnian_hops);
    case yanillian_hops : return(cert_yanillian_hops);
    case krandorian_hops : return(cert_krandorian_hops);
    case wildblood_hops : return(cert_wildblood_hops);
    case marigold : return(cert_marigold);
    case rosemary : return(cert_rosemary);
    case nasturtium : return(cert_nasturtium);
    case limpwurt_root : return(cert_limpwurt_root);
    case redberries : return(cert_redberries);
    case cadavaberries : return(cert_cadavaberries);
    case dwellberries : return(cert_dwellberries);
    case jangerberries : return(cert_jangerberries);
    case white_berries : return(cert_white_berries);
    case poisonivy_berries : return(cert_poisonivy_berries);
    case cooking_apple : return(cert_cooking_apple);
    case banana : return(cert_banana);
    case orange : return(cert_orange);
    case curry_leaf : return(cert_curry_leaf);
    case pineapple : return(cert_pineapple);
    case papaya : return(cert_papaya);
    case coconut : return(cert_coconut);
    case calquat_fruit : return(cert_calquat_fruit);
    case cactus_spine : return(cert_cactus_spine);
    case bittercap_mushroom : return(cert_bittercap_mushroom);
    case weeds : return(cert_weeds);
    case unidentified_guam : return(cert_unidentified_guam);
    case unidentified_marentill : return(cert_unidentified_marentill);
    case unidentified_tarromin : return(cert_unidentified_tarromin);
    case unidentified_harralander : return(cert_unidentified_harralander);
    case unidentified_ranarr : return(cert_unidentified_ranarr);
    case unidentified_toadflax : return(cert_unidentified_toadflax);
    case unidentified_irit : return(cert_unidentified_irit);
    case unidentified_avantoe : return(cert_unidentified_avantoe);
    case unidentified_kwuarm : return(cert_unidentified_kwuarm);
    case unidentified_snapdragon : return(cert_unidentified_snapdragon);
    case unidentified_cadantine : return(cert_unidentified_cadantine);
    case unidentified_lantadyme : return(cert_unidentified_lantadyme);
    case unidentified_dwarf_weed : return(cert_unidentified_dwarf_weed);
    case unidentified_torstol : return(cert_unidentified_torstol);
    case default : return(null);
}
return(null);

[opnpcu,farming_tools_leprechaun]
def_obj $item = last_useitem;
def_namedobj $note = ~farming_note_obj($item);
if ($note = null) {
    ~chatnpc("<p,neutral>That's not something I grew, so it's not something I'll note.");
    return;
}
def_int $count = inv_total(inv, $item);
if ($count < 1) {
    return;
}
inv_del(inv, $item, $count);
inv_add(inv, $note, $count);
mes("The leprechaun exchanges your <lowercase(oc_name($item))> for banknotes.");
