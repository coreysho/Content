    case ^farming_patch_bush_patch_3 : %farming_flags_22 = $flags;
    case ^farming_patch_bush_patch_4 : %farming_flags_23 = $flags;
    case ^farming_patch_tree_patch_1 : %farming_flags_24 = $flags;
    case ^farming_patch_tree_patch_2 : %farming_flags_25 = $flags;
    case ^farming_patch_tree_patch_3 : %farming_flags_26 = $flags;
    case ^farming_patch_tree_patch_4 : %farming_flags_27 = $flags;
    case ^farming_patch_fruit_tree_patch_1 : %farming_flags_28 = $flags;
    case ^farming_patch_fruit_tree_patch_2 : %farming_flags_29 = $flags;
    case ^farming_patch_fruit_tree_patch_3 : %farming_flags_30 = $flags;
    case ^farming_patch_fruit_tree_patch_4 : %farming_flags_31 = $flags;
    case ^farming_patch_spirit_tree_patch_1 : %farming_flags_32 = $flags;
    case ^farming_patch_spirit_tree_patch_2 : %farming_flags_33 = $flags;
    case ^farming_patch_spirit_tree_patch_3 : %farming_flags_34 = $flags;
    case ^farming_patch_calquat_tree_patch : %farming_flags_35 = $flags;
    case ^farming_patch_cactus_patch : %farming_flags_36 = $flags;
    case ^farming_patch_mushroom_patch : %farming_flags_37 = $flags;
    case ^farming_patch_belladonna_patch : %farming_flags_38 = $flags;
    case ^farming_patch_compost_bin_1 : %farming_flags_39 = $flags;
    case ^farming_patch_compost_bin_2 : %farming_flags_40 = $flags;
    case ^farming_patch_compost_bin_3 : %farming_flags_41 = $flags;
    case ^farming_patch_compost_bin_4 : %farming_flags_42 = $flags;
    case default : return;
}

// Which family of crop this patch grows. Constant per patch, so it lives here rather than in a varp.
[proc,farming_patch_family](int $patch)(int)
switch_int($patch) {
    case ^farming_patch_veg_patch_1 : return(^farming_family_allotment);
    case ^farming_patch_veg_patch_2 : return(^farming_family_allotment);
    case ^farming_patch_veg_patch_3 : return(^farming_family_allotment);
    case ^farming_patch_veg_patch_4 : return(^farming_family_allotment);
    case ^farming_patch_veg_patch_5 : return(^farming_family_allotment);
    case ^farming_patch_veg_patch_6 : return(^farming_family_allotment);
    case ^farming_patch_veg_patch_7 : return(^farming_family_allotment);
    case ^farming_patch_veg_patch_8 : return(^farming_family_allotment);
    case ^farming_patch_hops_patch_1 : return(^farming_family_hops);
    case ^farming_patch_hops_patch_2 : return(^farming_family_hops);
    case ^farming_patch_hops_patch_3 : return(^farming_family_hops);
    case ^farming_patch_hops_patch_4 : return(^farming_family_hops);
    case ^farming_patch_flower_patch_1 : return(^farming_family_flower);
    case ^farming_patch_flower_patch_2 : return(^farming_family_flower);
    case ^farming_patch_flower_patch_3 : return(^farming_family_flower);
    case ^farming_patch_flower_patch_4 : return(^farming_family_flower);
    case ^farming_patch_herb_patch_1 : return(^farming_family_herb);
    case ^farming_patch_herb_patch_2 : return(^farming_family_herb);
    case ^farming_patch_herb_patch_3 : return(^farming_family_herb);
    case ^farming_patch_herb_patch_4 : return(^farming_family_herb);
    case ^farming_patch_bush_patch_1 : return(^farming_family_bush);
    case ^farming_patch_bush_patch_2 : return(^farming_family_bush);
    case ^farming_patch_bush_patch_3 : return(^farming_family_bush);
    case ^farming_patch_bush_patch_4 : return(^farming_family_bush);
    case ^farming_patch_tree_patch_1 : return(^farming_family_tree);
    case ^farming_patch_tree_patch_2 : return(^farming_family_tree);
    case ^farming_patch_tree_patch_3 : return(^farming_family_tree);
    case ^farming_patch_tree_patch_4 : return(^farming_family_tree);
    case ^farming_patch_fruit_tree_patch_1 : return(^farming_family_fruit_tree);
    case ^farming_patch_fruit_tree_patch_2 : return(^farming_family_fruit_tree);
    case ^farming_patch_fruit_tree_patch_3 : return(^farming_family_fruit_tree);
    case ^farming_patch_fruit_tree_patch_4 : return(^farming_family_fruit_tree);
    case ^farming_patch_spirit_tree_patch_1 : return(^farming_family_spirit_tree);
    case ^farming_patch_spirit_tree_patch_2 : return(^farming_family_spirit_tree);
    case ^farming_patch_spirit_tree_patch_3 : return(^farming_family_spirit_tree);
    case ^farming_patch_calquat_tree_patch : return(^farming_family_calquat);
    case ^farming_patch_cactus_patch : return(^farming_family_cactus);
    case ^farming_patch_mushroom_patch : return(^farming_family_mushroom);
    case ^farming_patch_belladonna_patch : return(^farming_family_belladonna);
    case ^farming_patch_compost_bin_1 : return(0);
    case ^farming_patch_compost_bin_2 : return(0);
    case ^farming_patch_compost_bin_3 : return(0);
    case ^farming_patch_compost_bin_4 : return(0);
    case default : return(0);
}
