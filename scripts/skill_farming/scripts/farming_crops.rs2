// Patches store a 6-bit crop id rather than an obj id, so this is the way back to the seed (or
// sapling) that every oc_param lookup goes through. Ids are dense and assigned in the same order as
// the table in claude/farming-skill.md.

[proc,farming_crop_obj](int $crop)(namedobj)
switch_int($crop) {
    case 1   : return(potato_seed); // allotment
    case 2   : return(onion_seed); // allotment
    case 3   : return(cabbage_seed); // allotment
    case 4   : return(tomato_seed); // allotment
    case 5   : return(sweetcorn_seed); // allotment
    case 6   : return(strawberry_seed); // allotment
    case 7   : return(watermelon_seed); // allotment
    case 8   : return(barley_seed); // hops
    case 9   : return(hammerstone_hop_seed); // hops
    case 10  : return(asgarnian_hop_seed); // hops
    case 11  : return(jute_seed); // hops
    case 12  : return(yanillian_hop_seed); // hops
    case 13  : return(krandorian_hop_seed); // hops
    case 14  : return(wildblood_hop_seed); // hops
    case 15  : return(marigold_seed); // flower
    case 16  : return(rosemary_seed); // flower
    case 17  : return(nasturtium_seed); // flower
    case 18  : return(woad_seed); // flower
    case 19  : return(limpwurt_seed); // flower
    case 20  : return(guam_seed); // herb
    case 21  : return(marrentill_seed); // herb
    case 22  : return(tarromin_seed); // herb
    case 23  : return(harralander_seed); // herb
    case 24  : return(ranarr_seed); // herb
    case 25  : return(toadflax_seed); // herb
    case 26  : return(irit_seed); // herb
    case 27  : return(avantoe_seed); // herb
    case 28  : return(kwuarm_seed); // herb
    case 29  : return(snapdragon_seed); // herb
    case 30  : return(cadantine_seed); // herb
    case 31  : return(lantadyme_seed); // herb
    case 32  : return(dwarf_weed_seed); // herb
    case 33  : return(torstol_seed); // herb
    case 34  : return(redberry_bush_seed); // bush
    case 35  : return(cadavaberry_bush_seed); // bush
    case 36  : return(dwellberry_bush_seed); // bush
    case 37  : return(jangerberry_bush_seed); // bush
    case 38  : return(whiteberry_bush_seed); // bush
    case 39  : return(poisonivy_bush_seed); // bush
    case 40  : return(plantpot_oak_sapling); // tree
    case 41  : return(plantpot_willow_sapling); // tree
    case 42  : return(plantpot_maple_sapling); // tree
    case 43  : return(plantpot_yew_sapling); // tree
    case 44  : return(plantpot_magic_tree_sapling); // tree
    case 45  : return(plantpot_apple_sapling); // fruit_tree
    case 46  : return(plantpot_banana_sapling); // fruit_tree
    case 47  : return(plantpot_orange_sapling); // fruit_tree
    case 48  : return(plantpot_curry_sapling); // fruit_tree
    case 49  : return(plantpot_pineapple_sapling); // fruit_tree
    case 50  : return(plantpot_papaya_sapling); // fruit_tree
    case 51  : return(plantpot_palm_sapling); // fruit_tree
    case 52  : return(cactus_seed); // cactus
    case 53  : return(plantpot_calquat_sapling); // calquat
    case 54  : return(mushroom_seed); // mushroom
    case 55  : return(belladonna_seed); // belladonna
    case 56  : return(plantpot_spirit_tree_sapling); // spirit_tree
    case 57  : return(scarecrow_complete); // flower
    case default : return(null);
}

// The reverse: which crop a seed or sapling plants. Kept as a param so that "is this thing
// plantable" is one lookup on any item the player shoves at a patch.
[proc,farming_seed_crop](obj $seed)(int)
if ($seed = null) {
    return(0);
}
return(oc_param($seed, farming_crop));
