// The bottomless compost bucket.
//
// A bucket of compost poured in is worth TWO uses. That doubling is the item, not the carrying
// capacity: 10,000 uses is a lot, but any sack would do that.
//
// Where the state lives: the one slot of compost_bucket_store holds the compost itself, so the OBJ
// in that slot is which tier is inside and its COUNT is the uses left. No varp, no param, and
// "one type at a time" is a consequence of there being one slot rather than a rule anyone
// enforces. Check is then just ~storage_check, and spending a use is one inv_del.

// ------------------------------------------------------------------ where it comes from
// Called from ~farming_xp, which every Farming award already goes through. See the note beside
// ^bottomless_roll_xp in compost_bucket.constant for why it is proportional to the experience and
// why the number is steeper than a skilling outfit's.
//
// ~obj_gettotal counts pack, worn AND bank, and both the empty and the filled bucket count: a
// player who has one anywhere never rolls another, and filling it does not make it findable again.
[proc,compost_bucket_roll](int $xp)
if ($xp <= 0) {
    return;
}
if (stat_base(farming) < ^bottomless_roll_level) {
    return;
}
if (random(^bottomless_roll_xp) >= $xp) {
    return;
}
if (~obj_gettotal(bottomless_bucket) > 0 | ~obj_gettotal(bottomless_bucket_filled) > 0) {
    return;
}
// Full hands put it on the floor rather than losing it, the same as a skilling outfit piece.
if (inv_freespace(inv) > 0) {
    inv_add(inv, bottomless_bucket, 1);
} else {
    obj_add(coord, bottomless_bucket, 1, ^lootdrop_duration);
}
mes("You unearth a bucket with no bottom to it.");

[proc,compost_bucket_tier]()(obj)
return(inv_getobj(compost_bucket_store, 0));

[proc,compost_bucket_uses]()(int)
return(inv_getnum(compost_bucket_store, 0));

// How much compost of one kind you are carrying, counting the noted stack as well as the loose
// buckets. A 10,000-use bucket is pointless if it can only be fed 28 buckets at a time, so the
// note is not an optional extra here - it is the only way to reach the capacity.
[proc,compost_bucket_held](namedobj $bucket)(int)
def_obj $note = oc_cert($bucket);
if ($note = $bucket) {
    return(inv_total(inv, $bucket));
}
return(calc(inv_total(inv, $bucket) + inv_total(inv, $note)));

// Take $count buckets of one kind out of the pack, loose ones first and then out of the noted
// stack, and answer how many it actually got.
[proc,compost_bucket_take](namedobj $bucket, int $count)(int)
def_int $loose = min(inv_total(inv, $bucket), $count);
if ($loose > 0) {
    inv_del(inv, $bucket, $loose);
}
def_int $rest = calc($count - $loose);
if ($rest < 1) {
    return($loose);
}
def_obj $note = oc_cert($bucket);
if ($note = $bucket) {
    return($loose);
}
// inv_del and inv_total both take an obj rather than a namedobj, which is what makes this work
// at all: oc_cert answers an obj, and an obj cannot be assigned to a namedobj local - the build
// catches that, rs2check does not. Nothing here needs inv_add, which is the namedobj one.
def_int $fromnote = min(inv_total(inv, $note), $rest);
if ($fromnote > 0) {
    inv_del(inv, $note, $fromnote);
}
return(calc($loose + $fromnote));

[proc,compost_bucket_carried]()(namedobj)
if (inv_total(inv, bottomless_bucket_filled) > 0) {
    return(bottomless_bucket_filled);
}
if (inv_total(inv, bottomless_bucket) > 0) {
    return(bottomless_bucket);
}
return(null);

// The icon follows the contents, as the herb sack's does. Called after anything that can change
// them, so an empty bucket never looks full and a full one never looks empty.
[proc,compost_bucket_restyle]
def_namedobj $have = ~compost_bucket_carried;
if ($have = null) {
    return;
}
if (~compost_bucket_uses > 0) {
    if ($have = bottomless_bucket) {
        inv_del(inv, bottomless_bucket, 1);
        inv_add(inv, bottomless_bucket_filled, 1);
    }
} else if ($have = bottomless_bucket_filled) {
    inv_del(inv, bottomless_bucket_filled, 1);
    inv_add(inv, bottomless_bucket, 1);
}

// ---------------------------------------------------------------- Fill
[opheld1,bottomless_bucket] ~compost_bucket_fill;
[opheld1,bottomless_bucket_filled] ~compost_bucket_fill;

// Using a bucket of compost on it fills it too, which is the way OSRS does it and the way anyone
// would try first.
[opheldu,bottomless_bucket]
if (~compost_bucket_is_compost(last_useitem) = true) {
    ~compost_bucket_fill;
    return;
}
~displaymessage(^dm_default);

[opheldu,bottomless_bucket_filled]
if (~compost_bucket_is_compost(last_useitem) = true) {
    ~compost_bucket_fill;
    return;
}
~displaymessage(^dm_default);

// Either compost, noted or not - four objs, and OSRS lets you use any of them on it.
[proc,compost_bucket_is_compost](obj $obj)(boolean)
if ($obj = bucket_compost | $obj = bucket_supercompost) {
    return(true);
}
if ($obj = oc_cert(bucket_compost) | $obj = oc_cert(bucket_supercompost)) {
    return(true);
}
return(false);

[proc,compost_bucket_fill]
def_obj $inside = ~compost_bucket_tier;
// With something inside, only more of the same goes in. With nothing, the first bucket poured
// decides the tier - supercompost first if you are holding both, because that is the one you would
// rather not pour into a patch by hand.
def_namedobj $want = null;
if ($inside = bucket_supercompost) {
    $want = bucket_supercompost;
} else if ($inside = bucket_compost) {
    $want = bucket_compost;
} else if (~compost_bucket_held(bucket_supercompost) > 0) {
    $want = bucket_supercompost;
} else if (~compost_bucket_held(bucket_compost) > 0) {
    $want = bucket_compost;
}
if ($want = null) {
    mes("You have no compost to put in the bucket.");
    return;
}
def_int $have = ~compost_bucket_held($want);
if ($have < 1) {
    mes("The bucket already holds <lowercase(oc_name($want))>, and you have none left to put in.");
    return;
}
def_int $room = calc(^compost_bucket_max - ~compost_bucket_uses);
if ($room < ^compost_bucket_per_bucket) {
    mes("The bucket is full.");
    return;
}
// one bucket in, two uses out - and never more buckets than one Fill accepts
def_int $buckets = min($have, ^compost_bucket_fill_max);
$buckets = min($buckets, calc($room / ^compost_bucket_per_bucket));
// The buckets go IN WITH the compost. OSRS hands the empties back in the same noted or unnoted
// form they went in as; this server keeps them, on purpose - see the note in the obj config.
// $took rather than $buckets from here on, because the pack is what decides how many it could
// actually give up.
def_int $took = ~compost_bucket_take($want, $buckets);
if ($took < 1) {
    mes("You have no compost to put in the bucket.");
    return;
}
inv_add(compost_bucket_store, $want, calc($took * ^compost_bucket_per_bucket));
~compost_bucket_restyle;
mes("You pour <tostring($took)> <lowercase(oc_name($want))> in. The bucket holds <tostring(~compost_bucket_uses)> uses.");

// ---------------------------------------------------------------- Check
[opheld2,bottomless_bucket] ~compost_bucket_check;
[opheld2,bottomless_bucket_filled] ~compost_bucket_check;

[proc,compost_bucket_check]
if (~compost_bucket_uses < 1) {
    mes("The bucket is empty.");
    return;
}
mes("The bucket holds <tostring(~compost_bucket_uses)> uses of <lowercase(oc_name(~compost_bucket_tier))>.");

// Destroying it loses what is inside, and says so first - the shared helper from storage_items.rs2
// already words and confirms exactly that.
[opheld5,bottomless_bucket_filled]
@storage_destroy(bottomless_bucket_filled, compost_bucket_store, "bottomless compost bucket");

// ---------------------------------------------------------------- using it on a patch
// Reached from ~farming_useitem's switch. The tier comes out of the store rather than from the
// item you clicked, and the namedobj is passed as a literal: inv_getobj answers an obj, and an obj
// where a namedobj is wanted is a build error, not a warning.
[proc,compost_bucket_apply](int $patch)
def_obj $inside = ~compost_bucket_tier;
if ($inside = null | ~compost_bucket_uses < 1) {
    mes("The bucket is empty.");
    return;
}
if ($inside = bucket_supercompost) {
    ~farming_apply_compost($patch, bucket_supercompost, ^farming_compost_super, true);
} else {
    ~farming_apply_compost($patch, bucket_compost, ^farming_compost_normal, true);
}
~compost_bucket_restyle;
