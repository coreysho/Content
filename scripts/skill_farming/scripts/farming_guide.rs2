~skillguide_row(2, $lvl, 4, hammerstone_hops, "Hammerstone hops");
~skillguide_row(3, $lvl, 8, asgarnian_hops, "Asgarnian hops");
~skillguide_row(4, $lvl, 13, jute_fibre, "Jute");
~skillguide_row(5, $lvl, 16, yanillian_hops, "Yanillian hops");
~skillguide_row(6, $lvl, 21, krandorian_hops, "Krandorian hops");
~skillguide_row(7, $lvl, 28, wildblood_hops, "Wildblood hops");

