// Farming skill guide. Eight category buttons, one per patch type.
//
// Every level here is read straight off the seed's farming_level param via
// tools/farming/gen.py, so the guide and the thing it documents cannot drift apart.
//
// Icons are the crop's produce rather than its seed - a row of near-identical seed
// sprites is unreadable, and the produce is what the player is actually after. Trees
// show their logs and the spirit tree its seed, since neither yields a farming item.
//
// Eight buttons means btn1..btn8 (7+ categories use the btn1-first ladder; see the
// note at the top of interfaces/skill_guide.rs2).
[proc,open_farming_guide]
%skillguide_page = 1;
~farming_guide_render;

[proc,farming_guide_render]
~skillguide_begin(^guide_farming, "Farming");
~skillguide_members;
~skillguide_panels(8);
~skillguide_button(1, "Allotment");
~skillguide_button(2, "Hops");
~skillguide_button(3, "Flowers");
~skillguide_button(4, "Herbs");
~skillguide_button(5, "Bushes");
~skillguide_button(6, "Trees");
~skillguide_button(7, "Fruit tree");
~skillguide_button(8, "Other");
def_int $lvl = stat(farming);
switch_int (%skillguide_page) {
    case 2 : ~farming_guide_hops($lvl);
    case 3 : ~farming_guide_flowers($lvl);
    case 4 : ~farming_guide_herbs($lvl);
    case 5 : ~farming_guide_bushes($lvl);
    case 6 : ~farming_guide_trees($lvl);
    case 7 : ~farming_guide_fruittrees($lvl);
    case 8 : ~farming_guide_other($lvl);
    case default : ~farming_guide_allotment($lvl);
}
~skillguide_show;

[proc,farming_guide_allotment](int $lvl)
~skillguide_row(1, $lvl, 1, potato, "Potatoes");
~skillguide_row(2, $lvl, 5, onion, "Onions");
~skillguide_row(3, $lvl, 7, cabbage, "Cabbages");
~skillguide_row(4, $lvl, 12, tomato, "Tomatoes");
~skillguide_row(5, $lvl, 20, sweetcorn, "Sweetcorn");
~skillguide_row(6, $lvl, 31, strawberry, "Strawberries");
~skillguide_row(7, $lvl, 47, watermelon, "Watermelons");

