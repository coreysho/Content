// 349's three Mysterious Old Man events: a strange box, the mime, the maze. They share the old man
// (macro_mage) with his gift, in the event tables, at these keys.
^macro_cube = 6
^macro_mime = 7
^macro_mime_solve_1 = 100
^macro_mime_solve_2 = 101
^macro_mime_solve_3 = 102
^macro_maze = 8
// the mime and the maze take you away, so they are only a quarter of the rolls that land on them
// and never below level 20 of the Wilderness (macro_event_set_random)
^teleport_macro_start = 7

^macro_maze_chest_ticks = 100 // 60 seconds per chest respawn/loot - https://www.youtube.com/shorts/TS3mW5Ta5pI

