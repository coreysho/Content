// The skilling outfits: how many, and how often a piece turns up.

// Seven outfits have a source. The index is the order below and it is what keys outfit_piece and
// outfit_name, so it cannot be reordered without reordering those.
^outfit_prospector = 0
^outfit_angler = 1
^outfit_lumberjack = 2
^outfit_pyromancer = 3
^outfit_eye = 4
^outfit_smiths = 5
^outfit_carpenters = 6
^outfit_count = 7
^outfit_pieces = 4

// HOW OFTEN. A roll happens once per skilling action, inside the same proc that applies the
// outfit's experience bonus, and it succeeds with probability xp/^outfit_roll_xp - so the chance
// is proportional to what the action was worth. A magic log is worth twenty normal ones and rolls
// twenty times as often, which is the behaviour you want and which a flat per-action chance would
// get exactly backwards.
//
// 250,000 means one piece per 250,000 experience on average, and a full set of four in about a
// million - the fourth piece takes as long as the first, because a piece you already own is never
// given twice and the roll simply picks another. At 60-80k an hour that is somewhere around twelve
// to sixteen hours a set, which is the number to tune if it feels wrong. It is the only number
// here: nothing else in the mechanism is a magic constant.
^outfit_roll_xp = 250000
