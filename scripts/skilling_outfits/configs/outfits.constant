// The skilling outfits: how many, and how often a piece turns up.

// Ten outfits have a source. The index is the order below and it is what keys outfit_piece and
// outfit_name, so it cannot be reordered without reordering those.
^outfit_prospector = 0
^outfit_angler = 1
^outfit_lumberjack = 2
^outfit_pyromancer = 3
^outfit_eye = 4
^outfit_smiths = 5
^outfit_carpenters = 6
^outfit_graceful = 7
^outfit_rogue = 8
^outfit_zealots = 9
^outfit_count = 10

// Six, because Graceful has six - hood, top, legs, boots, gloves and a cape. The Rogue outfit has
// five and everything else four; the slots an outfit does not have are null in outfit_piece and
// the roll skips them. See the note there.
^outfit_pieces = 6

// The GUILD HUNTER outfit is the one still without a source, and it is the only one that cannot
// have this one: every other outfit is found while training its own skill, and Hunter does not
// exist in this build. Four pieces - hunter_headwear, hunter_top, hunter_legs, hunter_boots - plus
// a separate hunter_hood, and they wait on the skill.

// HOW OFTEN. A roll happens once per skilling action, inside the same proc that applies the
// outfit's experience bonus where there is one, and it succeeds with probability xp/^outfit_roll_xp
// - so the chance is proportional to what the action was worth. A magic log is worth twenty normal
// ones and rolls twenty times as often, which is the behaviour you want and which a flat
// per-action chance would get exactly backwards.
//
// 50,000 means one piece per 50,000 experience on average. A four-piece set is 200,000 and
// Graceful's six are 300,000, because the fourth piece takes as long as the first - a piece you
// already own is never given twice and the roll simply picks another. At 30-40k an hour that is
// roughly an hour and a half per piece and five to seven hours for a set.
//
// It was 250,000 - twelve to sixteen hours a set, which was too much for a cosmetic with a 2.5%
// bonus. This is the only number in the mechanism, for every outfit at once: nothing else here is
// a magic constant, and there is no per-outfit rate to drift.
^outfit_roll_xp = 50000

// ------------------------------------------------- the three that pay no experience
// Graceful, the Rogue outfit and Zealot's robes give no experience bonus in OSRS. What they give
// instead is below, and outfit_effects.rs2 is where two of the three are wired.

// GRACEFUL is not here at all, and that is the point: -25kg is the pieces' own weight= lines and
// +20% recovery is their energy_restore param, both read by the engine. A continuous effect
// belongs in the numbers the engine already reads every tick, not in a script pretending to.
//
// OSRS gives a further +10% for wearing all six, for 30% rather than 20%. That is the one
// deliberate departure here: the engine sums a param over worn equipment and knows nothing about
// which outfit a piece belongs to, and teaching it about sets to buy the last ten points was not
// worth the mechanism. The per-piece 3/4/4/3/3/3 is exactly OSRS's.

// ROGUE OUTFIT: a chance that a pickpocket's loot is doubled. OSRS pays 15/30/45/60/100 for one
// through five pieces - note the jump. The fifth piece is worth forty points and not fifteen,
// which is why the full set is the thing worth chasing and why this is not simply pieces x 15.
^rogue_double_pct = 15
^rogue_double_full = 100
^rogue_full_pieces = 5

// ZEALOT'S ROBES: each piece has its OWN chance to stop the remains being used up, and the four
// rolls are INDEPENDENT - so the full set is 1-(79/80)^4, a shade under 5%, and not 4/80. OSRS
// quotes 1.25% a piece, which is exactly 1 in 80, so this is a denominator rather than a
// percentage and there is no rounding in it anywhere.
^zealots_save_denom = 80
