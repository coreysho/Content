// The seven skilling outfits that can be found, and the four pieces of each.
//
// The index into outfit_piece is ^outfit_<name> * ^outfit_pieces + the slot, in hat / torso / legs
// / feet order. The Smiths' uniform has no headpiece - it is gloves instead - so its "hat" slot is
// the gloves, which is also the order ~outfit_xp_bonus_smiths reads them in.

[outfit_piece]
inputtype=int
outputtype=namedobj
default=null
val=0,prospector_helm
val=1,prospector_jacket
val=2,prospector_legs
val=3,prospector_boots
val=4,angler_hat
val=5,angler_top
val=6,angler_waders
val=7,angler_boots
val=8,lumberjack_hat
val=9,lumberjack_top
val=10,lumberjack_legs
val=11,lumberjack_boots
val=12,pyromancer_hood
val=13,pyromancer_garb
val=14,pyromancer_robe
val=15,pyromancer_boots
val=16,eye_hat
val=17,eye_top
val=18,eye_bottoms
val=19,eye_boots
val=20,smiths_gloves
val=21,smiths_tunic
val=22,smiths_trousers
val=23,smiths_boots
val=24,carpenters_helm
val=25,carpenters_shirt
val=26,carpenters_trousers
val=27,carpenters_boots

// What to call the outfit in the message that announces a piece.
[outfit_name]
inputtype=int
outputtype=string
default=null
val=0,prospector's
val=1,angler's
val=2,lumberjack
val=3,pyromancer's
val=4,Eye
val=5,smith's
val=6,carpenter's
