// Skilling outfit experience bonuses.
//
// OSRS awards the bonus per piece, not per set: 0.4% head, 0.8% body, 0.6% legs,
// 0.2% boots, plus a further 0.5% when all four are worn - 2.5% in total. Those are
// held here in TENTHS OF A PERCENT (4/8/6/2, +5 = 25) so the maths stays integer;
// the xp is then scaled by bonus/1000.
//
// Why a proc per skill rather than one taking a stat argument: `stat` is a real type
// in engine.rs2 command signatures, but nothing in this repo passes one as a proc
// argument, so it is unproven and cannot be compile-tested from outside the build.
// See claude/rs2-compile-traps.md. Seven small procs cost nothing and are provably safe.
//
// Not every skilling outfit gives experience. Three of them give none in OSRS - Graceful restores
// run energy, the Rogue outfit doubles pickpocketing loot, and Zealot's saves a bone - and their
// procs are at the bottom of this file with no bonus in them at all. They are here for the ROLL:
// the outfit still has to come from somewhere, and the xp funnel is the one place that sees every
// action in a skill.
//
//   Guild hunter - still nothing, and the only outfit that cannot have a source of this shape,
//                  because Hunter does not exist in this build. See outfits.constant.
//
// THE CARPENTER'S OUTFIT USED TO BE ON THAT LIST TOO, next to the Guild hunter's, because Construction
// did not exist when this file was written. It does now, so ~construction_xp is below with the
// other six and the carpenter's outfit pays its 2.5% like everything else. A comment that names a
// reason goes stale when the reason does; this is the second one this week to have been quietly
// wrong (the Garden Centre's note about the flowers was the first).

// Four pieces in the usual hat / torso / legs / feet slots.
[proc,outfit_xp_bonus](obj $hat, obj $torso, obj $legs, obj $feet)(int)
def_int $bonus = 0;
if (inv_getobj(worn, ^wearpos_hat) = $hat) {
    $bonus = calc($bonus + 4);
}
if (inv_getobj(worn, ^wearpos_torso) = $torso) {
    $bonus = calc($bonus + 8);
}
if (inv_getobj(worn, ^wearpos_legs) = $legs) {
    $bonus = calc($bonus + 6);
}
if (inv_getobj(worn, ^wearpos_feet) = $feet) {
    $bonus = calc($bonus + 2);
}
if ($bonus = 20) {
    $bonus = 25;
}
return($bonus);

// The Smiths' uniform has no headpiece - it is tunic, trousers, boots and gloves.
[proc,outfit_xp_bonus_smiths]()(int)
def_int $bonus = 0;
if (inv_getobj(worn, ^wearpos_torso) = smiths_tunic) {
    $bonus = calc($bonus + 8);
}
if (inv_getobj(worn, ^wearpos_legs) = smiths_trousers) {
    $bonus = calc($bonus + 6);
}
if (inv_getobj(worn, ^wearpos_feet) = smiths_boots) {
    $bonus = calc($bonus + 2);
}
if (inv_getobj(worn, ^wearpos_hands) = smiths_gloves) {
    $bonus = calc($bonus + 4);
}
if ($bonus = 20) {
    $bonus = 25;
}
return($bonus);

// ---------------------------------------------------------------- per-skill awards
// Every stat_advance for these seven skills routes through here. The guard matches
// the one farming_xp already had: a zero or negative award is a no-op, not an error.

[proc,mining_xp](int $xp)
if ($xp <= 0) {
    return;
}
def_int $bonus = ~outfit_xp_bonus(prospector_helm, prospector_jacket, prospector_legs, prospector_boots);
def_int $extra = calc(($xp * $bonus) / 1000);
~outfit_roll(^outfit_prospector, $xp);
stat_advance(mining, calc($xp + $extra));

[proc,fishing_xp](int $xp)
if ($xp <= 0) {
    return;
}
def_int $bonus = ~outfit_xp_bonus(angler_hat, angler_top, angler_waders, angler_boots);
def_int $extra = calc(($xp * $bonus) / 1000);
~outfit_roll(^outfit_angler, $xp);
stat_advance(fishing, calc($xp + $extra));

[proc,woodcutting_xp](int $xp)
if ($xp <= 0) {
    return;
}
def_int $bonus = ~outfit_xp_bonus(lumberjack_hat, lumberjack_top, lumberjack_legs, lumberjack_boots);
def_int $extra = calc(($xp * $bonus) / 1000);
~outfit_roll(^outfit_lumberjack, $xp);
stat_advance(woodcutting, calc($xp + $extra));

[proc,firemaking_xp](int $xp)
if ($xp <= 0) {
    return;
}
def_int $bonus = ~outfit_xp_bonus(pyromancer_hood, pyromancer_garb, pyromancer_robe, pyromancer_boots);
def_int $extra = calc(($xp * $bonus) / 1000);
~outfit_roll(^outfit_pyromancer, $xp);
stat_advance(firemaking, calc($xp + $extra));

[proc,runecraft_xp](int $xp)
if ($xp <= 0) {
    return;
}
def_int $bonus = ~outfit_xp_bonus(eye_hat, eye_top, eye_bottoms, eye_boots);
def_int $extra = calc(($xp * $bonus) / 1000);
~outfit_roll(^outfit_eye, $xp);
stat_advance(runecraft, calc($xp + $extra));

[proc,smithing_xp](int $xp)
if ($xp <= 0) {
    return;
}
def_int $bonus = ~outfit_xp_bonus_smiths();
def_int $extra = calc(($xp * $bonus) / 1000);
~outfit_roll(^outfit_smiths, $xp);
stat_advance(smithing, calc($xp + $extra));

[proc,construction_xp](int $xp)
if ($xp <= 0) {
    return;
}
def_int $bonus = ~outfit_xp_bonus(carpenters_helm, carpenters_shirt, carpenters_trousers, carpenters_boots);
def_int $extra = calc(($xp * $bonus) / 1000);
~outfit_roll(^outfit_carpenters, $xp);
stat_advance(construction, calc($xp + $extra));

// ---------------------------------------------------------------- the three with no bonus
// Agility, Thieving and Prayer. No ~outfit_xp_bonus call and no $extra, because OSRS gives these
// three outfits no experience bonus - so there is nothing to add and the proc is the roll and the
// award. The roll still sees the pre-bonus amount, because there is no other amount.
//
// WHAT ROUTES THROUGH THEM. Every award in scripts/skill_agility, scripts/skill_thieving,
// scripts/skill_prayer, the agility arena, the gnomeball field, the Yanille agility dungeon, the
// abyss and the costume-room altar. What does NOT is anything under scripts/quests: a quest award
// is a lump sum for finishing something, not an hour of training, and finishing Regicide should
// not roll for a Graceful piece. Battery group 64 holds that line by path.

[proc,agility_xp](int $xp)
if ($xp <= 0) {
    return;
}
~outfit_roll(^outfit_graceful, $xp);
stat_advance(agility, $xp);

[proc,thieving_xp](int $xp)
if ($xp <= 0) {
    return;
}
~outfit_roll(^outfit_rogue, $xp);
stat_advance(thieving, $xp);

[proc,prayer_xp](int $xp)
if ($xp <= 0) {
    return;
}
~outfit_roll(^outfit_zealots, $xp);
stat_advance(prayer, $xp);
