[oploc1,_rc_altar] @runecraft_runes;

[oplocu,_rc_altar]
if (oc_category(last_useitem) = talismans) {
    @runecraft_craft_tiaras(loc_type, last_useitem, last_useslot);
} else {
    switch_obj (last_useitem) {
        case blankrune, blankrune_high : @runecraft_runes;
        case tiara : @runecraft_craft_tiaras(loc_type, last_useitem, last_useslot);
        case default : ~displaymessage(^dm_default);
    }
}

// Use specific oplocu's for elemental altars due to combo rune runecrafting
[oplocu,air_altar]
switch_obj (last_useitem) {
    case blankrune, blankrune_high : @runecraft_runes;
    case waterrune, water_talisman : ~runecraft_combo_rune(waterrune, water_talisman, mistrune, 6, 80, airrune);
    case earthrune, earth_talisman : ~runecraft_combo_rune(earthrune, earth_talisman, dustrune, 10, 83, airrune);
    case firerune, fire_talisman : ~runecraft_combo_rune(firerune, fire_talisman, smokerune, 15, 85, airrune);
    case tiara : @runecraft_craft_tiaras(loc_type, last_useitem, last_useslot);
    case default : ~displaymessage(^dm_default);
}

[oplocu,water_altar]
switch_obj (last_useitem) {
    case blankrune, blankrune_high : @runecraft_runes;
    case airrune, air_talisman : ~runecraft_combo_rune(airrune, air_talisman, mistrune, 6, 85, waterrune);
    case earthrune, earth_talisman : ~runecraft_combo_rune(earthrune, earth_talisman, mudrune, 13, 93, waterrune);
    case firerune, fire_talisman : ~runecraft_combo_rune(firerune, fire_talisman, steamrune, 19, 93, waterrune);
    case tiara : @runecraft_craft_tiaras(loc_type, last_useitem, last_useslot);
    case default : ~displaymessage(^dm_default);
}

[oplocu,earth_altar]
switch_obj (last_useitem) {
    case blankrune, blankrune_high : @runecraft_runes;
    case airrune, air_talisman : ~runecraft_combo_rune(airrune, air_talisman, dustrune, 10, 90, earthrune);
    case waterrune, water_talisman : ~runecraft_combo_rune(waterrune, water_talisman, mudrune, 13, 95, earthrune);
    case firerune, fire_talisman : ~runecraft_combo_rune(firerune, fire_talisman, lavarune, 23, 100, earthrune);
    case tiara : @runecraft_craft_tiaras(loc_type, last_useitem, last_useslot);
    case default : ~displaymessage(^dm_default);
}

[oplocu,fire_altar]
switch_obj (last_useitem) {
    case blankrune, blankrune_high : @runecraft_runes;
    case airrune, air_talisman : ~runecraft_combo_rune(airrune, air_talisman, smokerune, 15, 85, firerune);
    case waterrune, water_talisman : ~runecraft_combo_rune(waterrune, water_talisman, steamrune, 19, 100, firerune);
    case earthrune, earth_talisman : ~runecraft_combo_rune(earthrune, earth_talisman, lavarune, 23, 105, firerune);
    case tiara : @runecraft_craft_tiaras(loc_type, last_useitem, last_useslot);
    case default : ~displaymessage(^dm_default);
}
