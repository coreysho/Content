// Runecrafting skill guide, shown on the original RS2 skill guide interface
// (see content/scripts/interfaces/skill_guide.rs2 for the generic driver).
// Talismans and tiaras are craftable but have no level requirement, so they are not listed.
[proc,open_runecraft_guide]
~skillguide_begin(^guide_runecraft, "Runecrafting");
def_int $lvl = stat(runecraft);
~skillguide_row(1, $lvl, 1, airrune, "Air rune");
~skillguide_row(2, $lvl, 2, mindrune, "Mind rune");
~skillguide_row(3, $lvl, 5, waterrune, "Water rune");
~skillguide_row(4, $lvl, 6, mistrune, "Mist rune");
~skillguide_row(5, $lvl, 9, earthrune, "Earth rune");
~skillguide_row(6, $lvl, 10, dustrune, "Dust rune");
~skillguide_row(7, $lvl, 13, mudrune, "Mud rune");
~skillguide_row(8, $lvl, 14, firerune, "Fire rune");
~skillguide_row(9, $lvl, 15, smokerune, "Smoke rune");
~skillguide_row(10, $lvl, 19, steamrune, "Steam rune");
~skillguide_row(11, $lvl, 20, bodyrune, "Body rune");
~skillguide_row(12, $lvl, 23, lavarune, "Lava rune");
~skillguide_row(13, $lvl, 27, cosmicrune, "Cosmic rune");
~skillguide_row(14, $lvl, 35, chaosrune, "Chaos rune");
~skillguide_row(15, $lvl, 44, naturerune, "Nature rune");
~skillguide_row(16, $lvl, 54, lawrune, "Law rune");
~skillguide_row(17, $lvl, 65, deathrune, "Death rune");
~skillguide_show;
