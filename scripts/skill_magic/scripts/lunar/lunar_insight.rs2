// Monster Examine (66) and Stat Spy (75), the Lunar spellbook (2026-09-23).
//
// MONSTER EXAMINE opens 474's panel for it (interface 522, skill_magic/interfaces/monster_examine.if,
// from LostCityServer tools/models/genlunarif474.py) over the side tab: the spell's icon, the
// monster's name in orange, and 474's four lines under it, filled in here with nothing invented:
//   1 the combat level (nc_vislevel - the level the client prints over the monster);
//   2 current/maximum hitpoints and the max hit, from ~npc_melee_maxhit - the SAME sum the monster's
//     own melee swing uses (skill_combat/scripts/npc/npc_combat_melee.rs2), so it can never disagree
//     with what it hits;
//   3 the other four current combat stats (npc_stat);
//   4 what the ordinary Examine says (~npc_examine, skill_combat/scripts/player/elemental_weakness.rs2):
//     the elemental weakness of a monster with one, then the description.
// It is a side modal, not a tab: the spellbook is still the magic tab underneath, so closing it (the
// X, or walking off) needs nothing put back, and nothing about it outlives a logout. Nothing goes to
// the chat box. It is cast on anything with an Attack option; on anything else it says so and costs
// nothing.
//
// STAT SPY "may be cast on other players to discover stats, including current Hitpoints, all
// skills, and boosted stats", and "the target of the spell receives a message that their stats are
// being spied upon along with the name of the caster". No Accept Aid - Old School's wiki asks for
// none, and it takes nothing from the target. The list is drawn on the skill guide
// (interfaces/skill_guide.if, driven by interfaces/skill_guide.rs2): a scrolling parchment of forty
// rows with a number column and a text column, which is the one text list in this build long
// enough for every skill. The number is the current level; the text gives it against the real
// level, green when boosted and red when drained.

// ---------------------------------------------------------------------------------- Monster Examine

[opnpct,lunar_magic:monster_examine] @lunar_monster_examine;
[apnpct,lunar_magic:monster_examine] @lunar_monster_examine;

[label,lunar_monster_examine]
if (npc_hasop(2) = false) {
    mes("You can only cast this spell on something you could fight.");
    return;
}
def_dbrow $spell_data = ~get_spell_data(^monster_examine);
if (~check_spell_requirements($spell_data) = false) {
    return;
}
~delete_spell_runes($spell_data);
~give_spell_xp($spell_data);
anim(human_cast_monster_examine, 0);
spotanim_npc(monster_examine, 92, 0);
def_npc $npc = npc_type;
~monster_examine_name(npc_name);
def_int $level = nc_vislevel($npc);
if ($level > 0) {
    if_settext(monster_examine:line1, "Combat level: <tostring($level)>");
} else {
    if_settext(monster_examine:line1, "No combat level");
}
if_settext(monster_examine:line2, "Hitpoints: <tostring(npc_stat(hitpoints))>/<tostring(npc_basestat(hitpoints))>\\nMax hit: <tostring(~npc_melee_maxhit)>");
if_settext(monster_examine:line3, ~monster_examine_stats(npc_stat(attack), npc_stat(strength), npc_stat(defence), npc_stat(magic), npc_stat(ranged)));
~monster_examine_about($npc);
if_openside(monster_examine);

// The name, in the quill font beside the icon: wrapped to 474's 116 pixels (a long name
// takes two lines, "Witches experiment fourth form" three) and centred on the icon's middle.
[proc,monster_examine_name](string $name)
split_init($name, 116, 3, q8_full);
def_int $lines = split_linecount(0);
if_settext(monster_examine:name, ~monster_examine_lines(0, $lines));
// if_setposition moves a component BY x, y from where its .if puts it (Client IF_SETPOSITION)
if_setposition(monster_examine:name, 0, calc(15 - $lines * 15 / 2));

// Attack, Strength and Defence on one line and Magic and Ranged on the next - the quill font's 164
// pixels hold that, with the gaps closed up when a stat has three figures.
[proc,monster_examine_stats](int $attack, int $strength, int $defence, int $magic, int $ranged)(string)
def_string $gap = "  ";
if ($attack > 99 | $strength > 99 | $defence > 99) {
    $gap = " ";
}
return("Att <tostring($attack)><$gap>Str <tostring($strength)><$gap>Def <tostring($defence)>\\nMagic <tostring($magic)>  Ranged <tostring($ranged)>");

// The ordinary Examine's words (~npc_examine) on the last of 474's lines: the elemental weakness
// first when there is one, then the description, cut short with "..." in the few cases it would not
// fit. There is room for four quill lines above the bottom of the tab if the fourth starts five
// pixels higher than 474's line does (a quill "g" hangs five below its line), so a fourth line
// moves it up.
[proc,monster_examine_about](npc $npc)
def_string $desc = nc_desc($npc);
if (compare($desc, "null") = 0 | string_length($desc) < 1) {
    $desc = "It's a <nc_name($npc)>.";
}
def_string $text = "";
def_int $lines = 0;
def_int $w = enum(npc, int, elemental_weakness, $npc);
if ($w > 0) {
    $text = "@dre@Weakness: <~element_name(divide($w, 1000))> (<tostring(modulo($w, 1000))>%)@bla@\\n";
    $lines = 1;
}
split_init($desc, 164, calc(4 - $lines), q8_full);
$lines = add($lines, split_linecount(0));
$text = append($text, ~monster_examine_lines(0, split_linecount(0)));
if (split_pagecount > 1) {
    $text = append($text, "...");
}
if_settext(monster_examine:line4, $text);
if ($lines > 3) {
    if_setposition(monster_examine:line4, 0, -5);
} else {
    if_setposition(monster_examine:line4, 0, 0);
}

// Page $page of the last split_init, its first $count lines joined into one text.
[proc,monster_examine_lines](int $page, int $count)(string)
def_string $text = "";
def_int $i = 0;
while ($i < $count) {
    if ($i > 0) {
        $text = append($text, "\\n");
    }
    $text = append($text, split_get($page, $i));
    $i = calc($i + 1);
}
return($text);

// ---------------------------------------------------------------------------------- Stat Spy

[opplayert,lunar_magic:stat_spy] @lunar_stat_spy;
[applayert,lunar_magic:stat_spy] @lunar_stat_spy;

[label,lunar_stat_spy]
if (.uid = uid) {
    mes("You can't cast that on yourself.");
    return;
}
def_dbrow $spell_data = ~get_spell_data(^stat_spy);
if (~check_spell_requirements($spell_data) = false) {
    return;
}
~delete_spell_runes($spell_data);
~give_spell_xp($spell_data);
anim(human_cast_monster_examine, 0);
.spotanim_pl(stat_spy, 92, 0);
.mes("<displayname> is viewing your stats.");
// 0 is no guide: ~skillguide_selectpage has no case for it, and no category button is shown
~skillguide_begin(0, .displayname);
~skillguide_headers("Level", "Skill");
def_int $i = 1;
while ($i <= enum_getoutputcount(stats)) {
    def_stat $stat = enum(int, stat, stats, $i);
    ~lunar_stat_spy_row($i, $stat, .stat($stat), .stat_base($stat));
    $i = calc($i + 1);
}
~skillguide_show;

// One row: the current level in the number column, "Attack: 75/70" beside it.
[proc,lunar_stat_spy_row](int $row, stat $stat, int $level, int $base)
def_int $colour = ^black_rgb;
if ($level > $base) {
    $colour = ^skillguide_unlocked;
} else if ($level < $base) {
    $colour = ^skillguide_locked;
}
def_string $text = "<~stat_name($stat)>: <tostring($level)>/<tostring($base)>";
switch_int ($row) {
    case 1 : ~skillguide_setrow(skill_guide:lvl1, skill_guide:name1, $level, $text, $colour);
    case 2 : ~skillguide_setrow(skill_guide:lvl2, skill_guide:name2, $level, $text, $colour);
    case 3 : ~skillguide_setrow(skill_guide:lvl3, skill_guide:name3, $level, $text, $colour);
    case 4 : ~skillguide_setrow(skill_guide:lvl4, skill_guide:name4, $level, $text, $colour);
    case 5 : ~skillguide_setrow(skill_guide:lvl5, skill_guide:name5, $level, $text, $colour);
    case 6 : ~skillguide_setrow(skill_guide:lvl6, skill_guide:name6, $level, $text, $colour);
    case 7 : ~skillguide_setrow(skill_guide:lvl7, skill_guide:name7, $level, $text, $colour);
    case 8 : ~skillguide_setrow(skill_guide:lvl8, skill_guide:name8, $level, $text, $colour);
    case 9 : ~skillguide_setrow(skill_guide:lvl9, skill_guide:name9, $level, $text, $colour);
    case 10 : ~skillguide_setrow(skill_guide:lvl10, skill_guide:name10, $level, $text, $colour);
    case 11 : ~skillguide_setrow(skill_guide:lvl11, skill_guide:name11, $level, $text, $colour);
    case 12 : ~skillguide_setrow(skill_guide:lvl12, skill_guide:name12, $level, $text, $colour);
    case 13 : ~skillguide_setrow(skill_guide:lvl13, skill_guide:name13, $level, $text, $colour);
    case 14 : ~skillguide_setrow(skill_guide:lvl14, skill_guide:name14, $level, $text, $colour);
    case 15 : ~skillguide_setrow(skill_guide:lvl15, skill_guide:name15, $level, $text, $colour);
    case 16 : ~skillguide_setrow(skill_guide:lvl16, skill_guide:name16, $level, $text, $colour);
    case 17 : ~skillguide_setrow(skill_guide:lvl17, skill_guide:name17, $level, $text, $colour);
    case 18 : ~skillguide_setrow(skill_guide:lvl18, skill_guide:name18, $level, $text, $colour);
    case 19 : ~skillguide_setrow(skill_guide:lvl19, skill_guide:name19, $level, $text, $colour);
    case 20 : ~skillguide_setrow(skill_guide:lvl20, skill_guide:name20, $level, $text, $colour);
    case 21 : ~skillguide_setrow(skill_guide:lvl21, skill_guide:name21, $level, $text, $colour);
    case 22 : ~skillguide_setrow(skill_guide:lvl22, skill_guide:name22, $level, $text, $colour);
    case 23 : ~skillguide_setrow(skill_guide:lvl23, skill_guide:name23, $level, $text, $colour);
    case 24 : ~skillguide_setrow(skill_guide:lvl24, skill_guide:name24, $level, $text, $colour);
    case 25 : ~skillguide_setrow(skill_guide:lvl25, skill_guide:name25, $level, $text, $colour);
}
