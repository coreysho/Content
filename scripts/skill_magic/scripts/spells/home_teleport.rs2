// HOME TELEPORT, the first spell in both of 474's books. It takes you to Edgeville from either book.
// No runes; it can only be cast once every thirty real minutes (%home_teleport_last, in
// date_minutes, so the wait runs while you are logged out too).
//
// The cast is 474's, in five stages, with 474's five graphics (spotanims 800-804, imported into
// skill_magic/configs/home_teleport.seq and .spotanim): a circle drawn in the dirt, a book, rings of
// light round the book, and the vortex that carries you off. The player's own movements are the
// same seqs from the OSRS cache (4847, 4850, 4853, 4855, 4857 in home_teleport_osrs.seq) - 474's
// copies are rigged for 474's player models, and on these ones they pull the head off the neck; the
// OSRS ones play on the OSRS skeleton the other imported player animations use. Each stage waits in a
// WEAK queue, which the engine clears the moment you do anything else, so walking or clicking away
// stops the teleport. The cast is Old School's 24 ticks (the OSRS wiki's cast time): each stage
// lasts its movement and a moment of the held pose it ends on - every one of these seqs ends on a
// frame held for up to 200 client ticks, and waiting out those holds (41 ticks in all) was a slow
// teleport that stood still between stages. Stage lengths 7, 6, 3, 5 and 3.

[if_button,magic:home_teleport] @home_teleport;
[if_button,ancient_magic:home_teleport] @home_teleport;
// and Lunar's, which 474 calls Lunar Home Teleport and this build also takes to Edgeville
[if_button,lunar_magic:lunar_home_teleport] @home_teleport;

[label,home_teleport]
if_close;
if (p_finduid(uid) = false) {
    return;
}
if (~wilderness_level(coord) > 20) {
    mes("A mysterious force blocks your teleport spell!");
    mes("You can't use this teleport after level 20 wilderness.");
    return;
}
if (~pre_tele_checks(coord) = false) {
    return;
}
def_int $wait = calc(%home_teleport_last + 30 - date_minutes);
if (%home_teleport_last > 0 & $wait > 0) {
    if ($wait = 1) {
        mes("You need to wait another minute to cast this spell.");
    } else {
        mes("You need to wait another <tostring($wait)> minutes to cast this spell.");
    }
    return;
}
p_stopaction;
~home_teleport_stage(1);

// one stage: its animation and graphic now, and the next stage when this one has played out
[proc,home_teleport_stage](int $stage)
if ($stage = 1) {
    // drawing the circle with a stick (5 ticks of movement)
    anim(human_hometele_1, 0);
    spotanim_pl(hometele_1, 0, 0);
    weakqueue(home_teleport_next, 7, 2);
} else if ($stage = 2) {
    // reading the book, over the circle's glow (which loops for 6.7 ticks)
    anim(human_hometele_2, 0);
    spotanim_pl(hometele_2, 0, 0);
    weakqueue(home_teleport_next, 6, 3);
} else if ($stage = 3) {
    anim(human_hometele_3, 0);
    spotanim_pl(hometele_3, 0, 0);
    weakqueue(home_teleport_next, 3, 4);
} else if ($stage = 4) {
    anim(human_hometele_4, 0);
    spotanim_pl(hometele_4, 0, 0);
    weakqueue(home_teleport_next, 5, 5);
} else {
    anim(human_hometele_5, 0);
    spotanim_pl(hometele_5, 0, 0);
    weakqueue(home_teleport_arrive, 3, 6);
}

[queue,home_teleport_next](int $stage)
if (~pre_tele_checks(coord) = false) {
    anim(null, 0);
    return;
}
~home_teleport_stage($stage);

[queue,home_teleport_arrive](int $stage)
if (~pre_tele_checks(coord) = false) {
    anim(null, 0);
    return;
}
%home_teleport_last = date_minutes;
// stage 5 has already carried you off, so no ordinary teleport cast on top of it
anim(null, 0);
sound_synth(teleport_all, 1, 0);
~p_telejump_safe(map_findsquare(0_48_54_15_40, 0, 2, ^map_findsquare_lineofwalk));
