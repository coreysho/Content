// Magic skill guide, shown on the original RS2 skill guide interface
// (see content/scripts/interfaces/skill_guide.rs2 for the generic driver).
// Standard spellbook. Icons are the spell's tier rune or its enchant target.
[proc,open_magic_guide]
~skillguide_begin(^guide_magic, "Magic");
def_int $lvl = stat(magic);
~skillguide_row(1, $lvl, 1, mindrune, "Wind Strike");
~skillguide_row(2, $lvl, 3, bodyrune, "Confuse");
~skillguide_row(3, $lvl, 5, mindrune, "Water Strike");
~skillguide_row(4, $lvl, 7, sapphire_ring, "Lvl-1 Enchant");
~skillguide_row(5, $lvl, 9, mindrune, "Earth Strike");
~skillguide_row(6, $lvl, 11, bodyrune, "Weaken");
~skillguide_row(7, $lvl, 13, mindrune, "Fire Strike");
~skillguide_row(8, $lvl, 15, banana, "Bones to Bananas");
~skillguide_row(9, $lvl, 17, chaosrune, "Wind Bolt");
~skillguide_row(10, $lvl, 19, bodyrune, "Curse");
~skillguide_row(11, $lvl, 20, naturerune, "Bind");
~skillguide_row(12, $lvl, 21, coins, "Low Level Alchemy");
~skillguide_row(13, $lvl, 23, chaosrune, "Water Bolt");
~skillguide_row(14, $lvl, 25, lawrune, "Varrock Teleport");
~skillguide_row(15, $lvl, 27, emerald_ring, "Lvl-2 Enchant");
~skillguide_row(16, $lvl, 29, chaosrune, "Earth Bolt");
~skillguide_row(17, $lvl, 31, lawrune, "Lumbridge Teleport");
~skillguide_row(18, $lvl, 33, lawrune, "Telekinetic Grab");
~skillguide_row(19, $lvl, 35, chaosrune, "Fire Bolt");
~skillguide_row(20, $lvl, 37, lawrune, "Falador Teleport");
~skillguide_row(21, $lvl, 41, deathrune, "Wind Blast");
~skillguide_row(22, $lvl, 43, gold_bar, "Superheat Item");
~skillguide_row(23, $lvl, 45, lawrune, "Camelot Teleport");
~skillguide_row(24, $lvl, 47, deathrune, "Water Blast");
~skillguide_row(25, $lvl, 49, ruby_ring, "Lvl-3 Enchant");
~skillguide_row(26, $lvl, 50, deathrune, "Magic Dart");
~skillguide_row(27, $lvl, 50, naturerune, "Snare");
~skillguide_row(28, $lvl, 51, lawrune, "Ardougne Teleport");
~skillguide_row(29, $lvl, 53, deathrune, "Earth Blast");
~skillguide_row(30, $lvl, 55, naturerune, "High Level Alchemy");
~skillguide_row(31, $lvl, 56, stafforb, "Charge Water Orb");
~skillguide_row(32, $lvl, 57, diamond_ring, "Lvl-4 Enchant");
~skillguide_row(33, $lvl, 58, lawrune, "Watchtower Teleport");
~skillguide_row(34, $lvl, 59, deathrune, "Fire Blast");
~skillguide_row(35, $lvl, 62, bloodrune, "Wind Wave");
~skillguide_row(36, $lvl, 65, bloodrune, "Water Wave");
~skillguide_row(37, $lvl, 68, dragonstone_ring, "Lvl-5 Enchant");
~skillguide_row(38, $lvl, 70, bloodrune, "Earth Wave");
~skillguide_row(39, $lvl, 75, bloodrune, "Fire Wave");
~skillguide_row(40, $lvl, 79, naturerune, "Entangle");
~skillguide_show;
