// Ancient Magicks spellbook - the tab interface swapped in by ~set_spellbook when %spellbook=1.
//
// Sprite indices are the real ones from this cache: magicoff2/magicon2 frames 6-21 hold the 16
// ancient combat icons, laid out 4 tiers across (Rush, Burst, Blitz, Barrage) by 4 elements down
// (Ice 6-9, Smoke 10-13, Blood 14-17, Shadow 18-21 - identified by colour: pale blue, grey, red,
// black). Frames 22-29 are the 8 ancient teleports, not implemented here.
//
// The grid arrangement below (tier across, element down) mirrors the sprite sheet's own layout,
// which is the only authentic layout evidence in the repo - the real spellbook panel art and its
// exact button coordinates are not in this checkout. See claude/ancient-magicks.md.
type=overlay

[spells]
type=layer
x=1
y=11
width=167
height=167
scroll=167

[ice_rush]
layer=spells
type=graphic
x=0
y=0
buttontype=target
width=20
height=20
overlayer=info_ice_rush
script1op1=inv_count,inventory:inv,waterrune
script1op2=inv_count,inventory:inv,steamrune
script1op3=inv_count,inventory:inv,mistrune
