// What the Hunter kit holds (skill_magic/scripts/lunar/lunar_hunter_kit.rs2), in Old School's order:
// a noose wand, a butterfly net, a bird snare, a rabbit snare, a teasing stick, an unlit torch, a box
// trap and an impling jar. Hunter is being built a trap at a time; five of the eight exist as of
// 2026-09-23, and the butterfly net, rabbit snare and impling jar belong here, in that order, as their
// items arrive. Open counts this enum, so a new row is the whole change.
[hunter_kit_contents]
inputtype=int
outputtype=namedobj
default=null
val=0,noose_wand
val=1,hunter_bird_snare
val=2,teasing_stick
val=3,torch_unlit
val=4,hunter_box_trap
