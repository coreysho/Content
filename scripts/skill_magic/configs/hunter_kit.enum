// What the Hunter kit holds (skill_magic/scripts/lunar/lunar_hunter_kit.rs2). Old School's kit is eight:
// a noose wand, a butterfly net, a bird snare, a rabbit snare, a teasing stick, an unlit torch, a box
// trap and an impling jar. Hunter is being built a trap at a time, and on 2026-09-23 three of the eight
// exist - the rest belong here, in that order, as their items arrive. Open counts this enum, so a
// new row is the whole change.
[hunter_kit_contents]
inputtype=int
outputtype=namedobj
default=null
val=0,hunter_bird_snare
val=1,torch_unlit
val=2,hunter_box_trap
