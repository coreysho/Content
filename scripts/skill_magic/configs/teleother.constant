// How long a Teleother offer stands, in ticks. 17 ticks is 10.2 seconds (Corey's call: "expires
// after about 10 seconds").
//
// The number is here rather than in the script because it is read in three places - the varp the
// offer is stamped with, the softtimer that closes the panel, and nothing else may disagree with
// either - and because a timeout is the kind of value somebody will want to change later without
// reading the flow.
^teleother_offer_ticks = 17
