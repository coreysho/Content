// Vengeance and Vengeance Other: 50 ticks is Old School's 30 seconds, one cooldown for both spells,
// on the caster (skill_magic/configs/lunar.varp, %vengeance_cooldown).
^vengeance_cooldown_ticks = 50

// Spellbook Swap lends a book for one spell or 200 ticks, Old School's 120 seconds.
^spellbook_swap_ticks = 200
