// THE COMBINATION STAVES (2026-09-21), imported from OSRS: smoke (air+fire), mist (air+water),
// dust (air+earth), steam (water+fire), battlestaff and mystic. Each counts as unlimited runes of
// both its elements: magic_staff.dbrow for the server, and an inv_contains op in every spell
// script that counts either element for the spellbook (tools/genstaffruneops.py).
// Imported from a modern OSRS cache by tools/models/importosrs.py.
// Models are RE-ENCODED from OSRS model format into the 317-family format
// (tools/models/osrs2ob2.py); every one is round-trip verified before writing.
// wearpos/wearpos2/wearpos3 come from the cache - do not hand-edit them.

[smoke_battlestaff]
name=Smoke battlestaff
desc=It gives a 10% accuracy and damage bonus for spells on the standard spellbook.
model=obj_smoke_battlestaff
manwear=obj_smoke_battlestaff_manwear,0
womanwear=obj_smoke_battlestaff_womanwear,0
wearpos=righthand
2dzoom=2611
2dxan=1104
2dyan=1320
2dzan=1387
2dxof=-12
2dyof=-22
weight=2267g
cost=15500
members=yes
iop2=Wield
// Stats are this build's own staves' (magic attack 10, as mud and water have here); Attack and
// Magic 30 to wield, mystic 40, as the lava and mud staves already require.
category=weapon_staff
param=stabattack,7
param=slashattack,-1
param=crushattack,28
param=magicattack,10
param=stabdefence,2
param=slashdefence,3
param=crushdefence,1
param=magicdefence,10
param=strengthbonus,35
param=attackrate,5
param=ready_baseanim,human_staffready
param=crushattack_anim,human_stafforb_pummel
param=defend_anim,human_stafforb_block
param=crush_sound,staff_hit

