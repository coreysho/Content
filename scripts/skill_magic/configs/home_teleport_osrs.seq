// HOME TELEPORT's five player movements, OSRS seqs 4847/4850/4853/4855/4857 (474 has the same ids,
// but its frames are rigged for 474's player models). Played by spells/home_teleport.rs2 with the
// graphics in home_teleport.spotanim. The replaceheld lines are the cache's own, written by hand
// because the converter drops them: every stage puts your weapon and shield away, and the first
// gives you a stick to draw the circle with (home_teleport.obj).
// Animations converted from the OSRS cache by tools/models/animconvosrs.py.
// They play on the OSRS player skeleton (base_osrs_*), not the 377 one: the client
// only walk-merges two animations that share a base (ClientPlayer/NpcType patch).

[human_hometele_1]
// OSRS seq 4847
reachforward=yes
postanim_move=abortanim
replaceheldleft=hide
replaceheldright=hometele_stick
frame1=anim_osrs_12171_1
delay1=5
frame2=anim_osrs_12171_2
delay2=5
frame3=anim_osrs_12171_3
delay3=5
frame4=anim_osrs_12171_4
delay4=5
frame5=anim_osrs_12171_5
delay5=5
frame6=anim_osrs_12171_6
delay6=5
