// The Lunar skilling spells (skill_magic/scripts/lunar/lunar_skilling.rs2, lunar_imbue.rs2,
// lunar_farming.rs2), 2026-09-23. Every figure here is Old School's, from its wiki.

// Magic Imbue: 12.6 seconds of combining runes without a talisman, and the spell cannot be cast
// again until it is over - "This spell can only be cast once every 12.6 seconds (21 game ticks)".
// One number does both, held in %magic_imbue_until (lunar_skilling.varp).
^magic_imbue_ticks = 21

// Plank Make charges 70% of what the sawmill operator would: 70/175/350/1050 against his
// 100/250/500/1500 (^sawmill_fee_* in skill_construction/configs/construction.constant).
^plank_make_fee_percent = 70

// Superglass Make: each sand-and-alkali pair makes one molten glass and has a 30% chance of a
// second - Old School's "on average 1.3 molten glass per pair". Crafting xp is 10 per bucket of sand
// (tenths, as stat_advance takes it), half what the furnace gives (smelt_glass, 200).
^superglass_bonus_percent = 30
^superglass_crafting_xp = 100

// String Jewellery: "gives 4 Crafting experience ... per amulet", the same 4 that stringing with a
// ball of wool gives (skill_crafting/scripts/jewellery/stringing.rs2).
^string_jewellery_crafting_xp = 40

// Cure Plant "awards the player with 91.5 Farming experience", Fertile Soil "18 Farming
// experience". Tenths, through ~farming_xp so the farmer's outfit counts as it does for all farming.
^cure_plant_farming_xp = 915
^fertile_soil_farming_xp = 180
