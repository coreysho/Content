// Trollheim Teleport. Requires Eadgar's Ruse in the real game; that quest is not implemented
// here (only its varps are reserved), so this ships ungated. The destination is one tile off
// Mad Eadgar's cave entrance, which the map places at (2892, 3672) - map_findsquare in
// magic_teleport nudges it to a walkable square, so a tile either way is fine.
[magic_spell_teleport_trollheim]
table=magic_spell_table
data=spell,^trollheim_teleport
data=members,true
data=levelrequired,61
data=runesrequired,firerune,2,lawrune,2,null,null
data=experience,680
data=tele_coord,0_45_57_11_23

// ============================================================
// Ancient Magicks teleports (Corey, 2026-09-07)
// ============================================================
//
// The eight ancient teleports, unlocked with the rest of the book by Desert Treasure. Levels, rune
// costs and xp are the OSRS values, which are the closest verifiable proxy for 2005 - no source
// records a 2005-specific figure that differs. members is true: the whole spellbook was members-only
// in 2006, and this world runs with the members flag (start.js passes "members"), so the flag is
// accurate without gating anything.
//
// A caveat worth keeping: NO source publishes teleport destination TILES, only descriptions. Each
// tile below was derived from the description and then checked against this repo's own map data -
// every one is a tile with no loc on it and an npc spawn within five tiles, so it is real, built,
// walkable ground. ~magic_teleport passes them through map_findsquare(..., 0, 2, lineofwalk), which
// nudges up to two tiles, so a small error self-corrects. Still worth spot-checking in game.
//
// The four Wilderness destinations are deliberate - Dareeyak, Carrallanger, Annakarl and Ghorrock
// all landed in the Wilderness in 2006. ~magic_teleport's own "can't teleport above level 20
// Wilderness" rule is about where you cast FROM, so it applies to these unchanged.

// Paddewwa - Edgeville Dungeon, by the ladder up into the ruined building.
[magic_spell_teleport_paddewwa]
table=magic_spell_table
data=spell,^paddewwa_teleport
data=members,true
data=name,"Paddewwa Teleport"
data=spellcom,ancient_magic:paddewwa_teleport
data=levelrequired,54
data=runesrequired,airrune,1,firerune,1,lawrune,2
data=experience,6400
data=tele_coord,0_48_154_26_26

// Senntisten - The Digsite, between the south gate and the Exam Centre.
