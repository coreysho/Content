// Magic Imbue (skill_magic/scripts/lunar/lunar_imbue.rs2), 2026-09-23.

// The map_clock tick Magic Imbue wears off on. Before it, combination runes bind without the
// opposing talisman (~magic_imbue_active, read by skill_runecraft/scripts/runecraft_combo_runes.rs2)
// and the spell cannot be cast again. Temp, as map_clock is: it restarts with the world, and the
// effect is gone on logout anyway.
[magic_imbue_until]
type=int
