// HOME TELEPORT's five graphics, from the rev 474 cache (spotanims 800-804): the models are
// 474's byte for byte, the animations converted by tools/models/animconv474.py into
// home_teleport.seq. Played by skill_magic/scripts/spells/home_teleport.rs2, one per stage: the
// circle, the book, the rings round the book, the vortex.

[hometele_1]
model=spot_hometele_circle
anim=hometele_spot_1
resizeh=97

[hometele_2]
model=spot_hometele_circle
anim=hometele_spot_2
resizeh=97

[hometele_3]
model=spot_hometele_sparkle
anim=hometele_spot_3

[hometele_4]
model=spot_hometele_column
anim=hometele_spot_4
ambient=50
contrast=20

[hometele_5]
model=spot_hometele_burst
anim=hometele_spot_5
ambient=50
contrast=20
