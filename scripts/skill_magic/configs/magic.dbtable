column=maxhit,int
column=continue_by_autocast,boolean
// Added 2026-09-04 for the combat/Ancient Magicks spell rows (see claude/ancient-magicks.md).
// rune4: an optional 4th rune slot. runesrequired only has 3 fixed pairs, but the Smoke and Shadow
// ancients each cost 4 different runes. Only ever holds a NON-elemental rune (chaos/death/soul/blood)
// - the elemental runes always occupy the first 3 slots - so it deliberately does not go through
// ~staff_runes staff substitution, since no staff supplies those runes.
column=rune4,namedobj,int
// heal_percent: Blood ancients heal the caster for this % of damage dealt.
column=heal_percent,int
// poison_chance/poison_severity: Smoke ancients have a 1-in-<chance> shot at poisoning for <severity>.
column=poison_chance,int
column=poison_severity,int
