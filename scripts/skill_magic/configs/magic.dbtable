[magic_spell_table]
column=spell,int,INDEXED,REQUIRED
column=spellcom,component
column=name,string
column=members,boolean
column=levelrequired,int
column=runesrequired,namedobj,int,namedobj,int,namedobj,int
column=wornrequired,namedobj
column=worn_reqmessage,string
column=experience,int
column=loc_type,loc
column=convertobj,obj,namedobj,seq,spotanim,synth,LIST
column=tele_coord,coord
column=additional_reqmessage,string
column=specificobj_reqmessage,obj,string
column=stat_change,stat,int,int,LIST
column=freeze_time,int
column=anim,seq
column=spotanim_proj,spotanim,int,int,int,int,int,int,int
column=spotanim_origin,spotanim
column=spotanim_target,spotanim,int
column=sound_cast,synth
