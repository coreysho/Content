// WHICH BOSS, AND WHAT IT IS CALLED. GENERATED - do not hand-edit.
//   python3 tools/genbosskills.py
//
// These two are tables because they CAN be: an npc maps to an int and an int maps to a
// string, and enum() does both. The increment and the read cannot be tables, because
// this engine has no way to pick a varp at runtime - those are generated switches in
// boss_kills.rs2, and this comment is the reason they look different.

[boss_kill_index]
// the dying npc -> its slot, or ^boss_kills_none for everything else in the game
inputtype=npc
outputtype=int
default=-1
val=tzhaar_fightcave_swarm_boss,0
val=kril,1
val=graardor,2
val=zilyana,3
val=kreearra,4
val=kalphite_flyingqueen,5
val=chaoselemental,6
val=dagcave_melee_boss,7
val=dagcave_ranged_boss,8
val=dagcave_magic_boss,9
val=king_dragon,10
val=mole_giant,11
val=kraken,12

[boss_kill_name]
// slot -> the name off the boss's own npc record, so the window cannot disagree with
// what the player sees over its head
inputtype=int
outputtype=string
default=null
val=0,TzTok-Jad
val=1,K'ril Tsutsaroth
val=2,General Graardor
val=3,Commander Zilyana
val=4,Kree'arra
val=5,Kalphite Queen
val=6,Chaos Elemental
val=7,Dagannoth Rex
val=8,Dagannoth Supreme
val=9,Dagannoth Prime
val=10,King black dragon
val=11,Giant Mole
val=12,Kraken
