// God Wars Dungeon generals - drop tables. Generated by hand-checked tables; rates are the OSRS wiki's
// (oldschool.runescape.wiki, Sept 2026), adapted to what exists in this 377 cache.
//
// Two rolls, like the OSRS table behaves:
//   1. unique roll, random(1524). 1524 = LCM of 381/508/762/127, so every OSRS unique rate is exact.
//      A unique replaces the main drop, and is broadcast like every other rare drop on this server.
//   2. otherwise the main table, weights as the wiki lists them (random(total) of the weights).
//      "RDT" = the shared gem/rare table (~randomjewel).
// Always-drops, the hard clue roll, and no pets (GWD pets are part of the rest of GWD, not this).
// Items the wiki lists that are later OSRS additions or absent from this cache are left out; their
// weight is simply not in the table (noted per boss). No spawns yet - ::npc <name> to test.

// ---------------------------------------------------------------- General Graardor
[ai_queue3,graardor]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}
obj_add(npc_coord, big_bones, 1, ^lootdrop_duration);
~trail_hardcluedrop(^trail_hard_droprate, npc_coord);
if (~gwd_unique_roll_graardor = true) {
    return;
}
def_int $random = random(127);
if ($random < 8) { // 8/127
    obj_add(npc_coord, rune_longsword, 1, ^lootdrop_duration);
} else if ($random < 16) { // 8/127
    obj_add(npc_coord, rune_2h_sword, 1, ^lootdrop_duration);
} else if ($random < 24) { // 8/127
    obj_add(npc_coord, rune_platebody, 1, ^lootdrop_duration);
} else if ($random < 30) { // 6/127
    obj_add(npc_coord, rune_pickaxe, 1, ^lootdrop_duration);
} else if ($random < 62) { // 32/127
    obj_add(npc_coord, coins, ~random_range(19500, 20000), ^lootdrop_duration);
} else if ($random < 70) { // 8/127
    obj_add(npc_coord, cert_unidentified_snapdragon, 3, ^lootdrop_duration);
} else if ($random < 78) { // 8/127
    obj_add(npc_coord, snapdragon_seed, 1, ^lootdrop_duration);
} else if ($random < 86) { // 8/127
    obj_add(npc_coord, 4dose2restore, 3, ^lootdrop_duration);
} else if ($random < 94) { // 8/127
    obj_add(npc_coord, cert_adamantite_ore, ~random_range(15, 20), ^lootdrop_duration);
} else if ($random < 102) { // 8/127
    obj_add(npc_coord, cert_coal, ~random_range(115, 120), ^lootdrop_duration);
} else if ($random < 110) { // 8/127
    obj_add(npc_coord, cert_magic_logs, ~random_range(15, 20), ^lootdrop_duration);
} else if ($random < 118) { // 8/127
    obj_add(npc_coord, naturerune, ~random_range(65, 70), ^lootdrop_duration);
} else if ($random < 127) { // 9/127
    obj_add(npc_coord, ~randomjewel, ^lootdrop_duration);
}

[proc,gwd_unique_roll_graardor]()(boolean)
def_int $random = random(1524);
def_namedobj $drop = null;
if ($random < 4) { // 1/381
    $drop = bandos_chestplate;
} else if ($random < 8) { // 1/381
    $drop = bandos_tassets;
} else if ($random < 12) { // 1/381
    $drop = bandos_boots;
} else if ($random < 15) { // 1/508
    $drop = bandos_hilt;
} else if ($random < 17) { // 1/762
    $drop = godsword_shard_1;
} else if ($random < 19) { // 1/762
    $drop = godsword_shard_2;
} else if ($random < 21) { // 1/762
    $drop = godsword_shard_3;
}
if ($drop = null) {
    return(false);
}
obj_add(npc_coord, $drop, 1, ^lootdrop_duration);
session_log(^log_adventure, "Defeated <npc_name> and received a <oc_name($drop)>!");
broadcast_mes(append(append(displayname(), " received a rare drop: "), oc_name($drop)));
return(true);

// ---------------------------------------------------------------- K'ril Tsutsaroth
