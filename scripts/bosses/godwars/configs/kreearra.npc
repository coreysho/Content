// Kree'arra - imported from the rev 474 cache (npc 6222).
// Models byte-for-byte; animations from frame group 1773 on skeleton 1589.
//
// Combat stats are the OSRS figures, entered by hand - the cache carries none.
// No spawn and no drop table: there is no God Wars Dungeon here. ::npc kreearra
//
// He flies, so his melee defence is deliberately enormous - in OSRS melee cannot
// reach him at all. kreearra_attack2 (474 seq 6976) is his second attack, converted
// but not wired up.

[kreearra]
name=Kree'arra
desc=An aviansie general of Armadyl.
model1=npc_kreearra_1
model2=npc_kreearra_2
model3=npc_kreearra_3
size=5
readyanim=kreearra_ready
walkanim=kreearra_walk
op2=Attack
vislevel=580
hitpoints=255
attack=380
strength=210
defence=240
magic=200
ranged=210
huntmode=aggressive_melee
huntrange=8
attackrange=1
maxrange=20
wanderrange=8
respawnrate=100
param=attack_anim,kreearra_attack
param=defend_anim,kreearra_block
param=death_anim,kreearra_death
param=stabdefence,200
param=slashdefence,200
param=crushdefence,200
param=magicdefence,100
param=rangedefence,200
