// Commander Zilyana - imported from the rev 474 cache (npc 6247).
// Models byte-for-byte; animations from frame group 1775 on skeleton 1590.
//
// Combat stats are the OSRS figures, entered by hand - the cache carries none.
// No spawn and no drop table: there is no God Wars Dungeon here. ::npc zilyana
//
// defend_anim points at her idle deliberately. Rev 474 ships only six seqs on this
// rig and none of them is a block; the engine default is a HUMAN animation, which on
// a non-human rig animates the model into garbage. zilyana_magic (474 seq 6966) is
// her magic blast - the teal sphere is part of her own model set - and
// zilyana_special (6967) is her sword special. Both converted, neither wired up.

[zilyana]
name=Commander Zilyana
desc=A commander of Saradomin's forces.
model1=npc_zilyana_1
model2=npc_zilyana_2
model3=npc_zilyana_3
model4=npc_zilyana_4
model5=npc_zilyana_5
size=2
readyanim=zilyana_ready
walkanim=zilyana_walk
op2=Attack
vislevel=596
hitpoints=255
attack=300
strength=225
defence=280
magic=200
ranged=300
huntmode=aggressive_melee
huntrange=8
attackrange=1
maxrange=20
wanderrange=8
respawnrate=100
param=attack_anim,zilyana_attack
param=defend_anim,zilyana_ready
param=death_anim,zilyana_death
param=stabdefence,70
param=slashdefence,120
param=crushdefence,70
param=magicdefence,250
param=rangedefence,70
