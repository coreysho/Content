// General Graardor - imported from the rev 474 cache (npc 6260) by tools/models/importnpc474.py.
// Models and animations both come from 474: models byte-for-byte, animations
// re-laid-out by tools/models/animconv474.py (frame group 1124/1125, skeleton 1003).
//
// Combat stats are the OSRS figures, entered by hand - the cache carries none of them.
// Not yet done: a spawn (there is no God Wars Dungeon here), a drop table, and the
// ranged/magic attack styles. ::npc graardor to spawn one for now.
//
// death_anim and defend_anim: rev 474 ships only five seqs on this rig (ready, walk,
// attack, and two idles) - no death and no block. The engine default for both is a
// HUMAN animation, which would animate this rig into garbage because the vertex labels
// do not match, so both point at his own idle instead. Replace when the OSRS cache lands.

[graardor]
name=General Graardor
desc=A mighty Bandosian warrior.
model1=npc_graardor_1
model2=npc_graardor_2
size=4
readyanim=graardor_ready
walkanim=graardor_walk
resizeh=110
resizev=110
op2=Attack
vislevel=624
hitpoints=255
attack=280
strength=350
defence=250
magic=80
ranged=350
huntmode=aggressive_melee
huntrange=8
attackrange=1
maxrange=20
wanderrange=8
respawnrate=100
param=attack_anim,graardor_attack
param=defend_anim,graardor_idle2
param=death_anim,graardor_ready
param=stabdefence,90
param=slashdefence,90
param=crushdefence,90
param=magicdefence,298
param=rangedefence,90
