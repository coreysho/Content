// General Graardor - imported from the rev 474 cache (npc 6260).
// Models byte-for-byte; animations re-laid-out by tools/models/animconv474.py from
// frame groups 1124/1125 on skeleton 1003. Every seq below is his own - no human
// fallbacks, which on a non-human rig animate the model into garbage.
//
// Combat stats are the OSRS figures, entered by hand - the cache carries none of them.
// Not yet done: a spawn (there is no God Wars Dungeon here) and a drop table.
// ::npc graardor to spawn one.
//
// graardor_slam (474 seq 7063) and graardor_attack2 (7052) are his other two attack
// animations, converted and registered but not wired to an attack style yet.

[graardor]
name=General Graardor
desc=A mighty Bandosian warrior.
model1=npc_graardor_1
model2=npc_graardor_2
size=4
readyanim=graardor_ready
walkanim=graardor_walk
resizeh=110
resizev=110
op2=Attack
vislevel=624
hitpoints=255
attack=280
strength=350
defence=250
magic=80
ranged=350
huntmode=aggressive_melee
huntrange=8
attackrange=1
maxrange=20
wanderrange=8
respawnrate=100
param=attack_anim,graardor_attack
param=defend_anim,graardor_block
param=death_anim,graardor_death
param=stabdefence,90
param=slashdefence,90
param=crushdefence,90
param=magicdefence,298
param=rangedefence,90
