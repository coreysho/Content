// Firemaking skill guide, shown on the original RS2 skill guide interface
// (see content/scripts/interfaces/skill_guide.rs2 for the generic driver).
[proc,open_firemaking_guide]
~skillguide_begin(^guide_firemaking, "Firemaking");
def_int $lvl = stat(firemaking);
~skillguide_row(1, $lvl, 1, tinderbox, "Tinderbox");
~skillguide_row(2, $lvl, 1, logs, "Logs");
~skillguide_row(3, $lvl, 1, achey_tree_logs, "Achey tree logs");
~skillguide_row(4, $lvl, 15, oak_logs, "Oak logs");
~skillguide_row(5, $lvl, 30, willow_logs, "Willow logs");
~skillguide_row(6, $lvl, 35, teak_logs, "Teak logs");
~skillguide_row(7, $lvl, 45, maple_logs, "Maple logs");
~skillguide_row(8, $lvl, 50, mahogany_logs, "Mahogany logs");
~skillguide_row(9, $lvl, 60, yew_logs, "Yew logs");
~skillguide_row(10, $lvl, 75, magic_logs, "Magic logs");
~skillguide_show;
