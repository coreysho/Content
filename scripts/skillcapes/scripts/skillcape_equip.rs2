// The Quest point cape needs every quest point there is (~max_questpoints, general/scripts/quests.rs2).
[opheld2,quest_point_cape]
if (%qp < ~max_questpoints) {
    mes("You need all <tostring(~max_questpoints)> quest points to wear this cape.");
    return;
}
~equip(last_slot);
