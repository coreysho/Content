// The Max cape and the Max hood.
//
// IMPORTED from a modern OSRS cache (objs 13280 and 13281) by tools/models/importosrs.py, which
// re-encodes the models into the 317-family format. The 2d camera, the weight and the wearpos rows
// are the cache's own numbers; the ops, the category and the params below are by hand.
//
// The cape is a 2015 Old School item, which makes it the second knowing anachronism in this repo
// after the boss pets - it was asked for. Everything about it is a composite of the 22 skill capes:
// the same +9 defence a Cape of Accomplishment gives, the +4 prayer a trimmed one gives, and every
// perk all 22 of them have (skillcape_perks.rs2 - ~skillcape_worn answers true for every stat while
// this is on your back, which is what "inherits all skillcape perks" means in one line).
//
// THE OPS ARE THE CACHE'S OWN LIST, shortened by one. OSRS offers Wear / Teleports / Spellbook /
// Features on the inventory item; in 377 opheld5 is Drop, served globally by player/scripts/drop.rs2,
// so a fourth custom op would take the Drop option away from an untradeable cape. Spellbook is
// therefore the third line of the Features menu rather than an op of its own. The cache also carries
// the Features list itself - Search, Ring of Life, Commune, Stamina Boost, Teleport Boat, Rename
// Boat - which is how we know Ring of Life and the run-energy boost belong there and not under
// Teleports. (Reading that list needed a fix to tools/models/objconfig474.py; see claude/max-cape.md.)
//
// cost= is the cache's own 99,000, not what Mac charges. His price is 99,000 a skill, worked out at
// runtime from the stats enum - ~maxcape_price in skillcape_shop.rs2.

[max_cape]
name=Max cape
desc=The cape worn by only the most experienced players.
model=obj_max_cape
manwear=obj_max_cape_manwear,0
womanwear=obj_max_cape_womanwear,0
wearpos=back
2dzoom=2232
2dxan=687
2dyan=27
2dyof=-5
iop2=Wear
iop3=Teleports
iop4=Features
wearop1=Warriors' Guild
wearop2=Fishing Guild
wearop3=Crafting Guild
wearop4=Tele to POH
wearop5=Spellbook
wearop6=Features
cost=99000
members=yes
tradeable=no
weight=453g
category=armour_cape
param=stabdefence,9
param=slashdefence,9
param=crushdefence,9
param=magicdefence,9
param=rangedefence,9
param=prayerbonus,4

// Cosmetic and ungated, like every other skillcape hood.
[max_hood]
name=Max hood
desc=The hood worn by only the most experienced players.
model=obj_max_hood
manwear=obj_max_hood_manwear,0
womanwear=obj_max_hood_womanwear,0
manhead=obj_max_hood_manhead
womanhead=obj_max_hood_womanhead
wearpos=hat
wearpos2=head
2dzoom=720
2dxan=21
2dyan=18
iop2=Wear
members=yes
tradeable=no
weight=453g
