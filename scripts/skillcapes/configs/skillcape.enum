// Skill cape lookup tables. Capes and hoods come from skillcapes.obj; emote seqs and graphics
// from skillcape_emotes.seq/.spotanim (OSRS seq/spotanim pairs, see claude/skillcapes.md).

[skillcape_cape]
inputtype=stat
outputtype=namedobj
val=attack,attack_cape
val=strength,strength_cape
val=ranged,ranging_cape
val=magic,magic_cape
val=defence,defence_cape
val=hitpoints,hitpoints_cape
val=prayer,prayer_cape
val=agility,agility_cape
val=herblore,herblore_cape
val=thieving,thieving_cape
val=crafting,crafting_cape
val=runecraft,runecraft_cape
val=mining,mining_cape
val=smithing,smithing_cape
val=fishing,fishing_cape
val=cooking,cooking_cape
val=firemaking,firemaking_cape
val=woodcutting,woodcutting_cape
val=fletching,fletching_cape
val=slayer,slayer_cape
val=farming,farming_cape

