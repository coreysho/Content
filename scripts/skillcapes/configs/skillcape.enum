// Herblore cape: a grimy (unidentified) herb used on a vial of water is cleaned first.
[skillcape_grimy_herb]
inputtype=obj
outputtype=namedobj
val=unidentified_guam,guam_leaf
val=unidentified_marentill,marentill
val=unidentified_tarromin,tarromin
