// An enum with no default= encodes defaultInt 0, and a MISS returns 0 - not null. Seq 0 is
// swarm_walk and spotanim 0 is triple_firebreath_attack, so without these two lines the emote
// played dragonfire for anyone wearing a cape that is not a skillcape (the handler's only
// "do you have one" test is the null check on this lookup).
[skillcape_emote_seq]
inputtype=obj
outputtype=seq
default=null
val=attack_cape,skillcape_attack_emote
val=attack_cape_t,skillcape_attack_emote
val=strength_cape,skillcape_strength_emote
val=strength_cape_t,skillcape_strength_emote
val=ranging_cape,skillcape_ranging_emote
val=ranging_cape_t,skillcape_ranging_emote
val=magic_cape,skillcape_magic_emote
val=magic_cape_t,skillcape_magic_emote
val=defence_cape,skillcape_defence_emote
val=defence_cape_t,skillcape_defence_emote
val=hitpoints_cape,skillcape_hitpoints_emote
val=hitpoints_cape_t,skillcape_hitpoints_emote
val=prayer_cape,skillcape_prayer_emote
val=prayer_cape_t,skillcape_prayer_emote
val=agility_cape,skillcape_agility_emote
val=agility_cape_t,skillcape_agility_emote
val=herblore_cape,skillcape_herblore_emote
val=herblore_cape_t,skillcape_herblore_emote
val=thieving_cape,skillcape_thieving_emote
val=thieving_cape_t,skillcape_thieving_emote
