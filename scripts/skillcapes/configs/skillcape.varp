// Skill cape perks (skillcapes/scripts/skillcape_perks.rs2).
// Defence cape: 1 = the ring of life effect has been switched off with the cape's Toggle option.
[skillcape_rol_off]
type=int
scope=perm
protect=no

// Agility cape: the day (world_minute / 1440) its once-a-day run energy boost was last used.
[skillcape_agility_day]
type=int
scope=perm
protect=no

// Magic cape: the day of the last spellbook swap, and how many swaps were made that day (max 5).
[skillcape_magic_day]
type=int
scope=perm
protect=no

[skillcape_magic_uses]
type=int
scope=perm
protect=no
