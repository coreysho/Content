// Animations converted from the OSRS cache by tools/models/animconvosrs.py.
// They play on the OSRS player skeleton (base_osrs_*), not the 377 one: the client
// only walk-merges two animations that share a base (ClientPlayer/NpcType patch).

[skillcape_hunter_emote]
// OSRS seq 5158
// replaceheld is not carried by animconvosrs; OSRS sets both hands to 0 - an empty hand - so
// whatever is wielded is hidden for the emote, as skillcape_construction_emote hides its left.
preanim_move=delayanim
postanim_move=abortanim
replaceheldleft=hide
replaceheldright=hide
frame1=anim_osrs_11532_1
delay1=3
