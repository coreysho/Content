// A port's name as the crew say it.
[charter_port_name]
inputtype=int
outputtype=string
default=
val=0,Port Sarim
val=1,Brimhaven
val=2,Catherby
val=4,Musa Point
val=5,Port Khazard
val=6,Port Phasmatys
val=7,the Shipyard
val=8,Port Tyras

// A port's layer on the charter map (charter.if), for hiding it.
[charter_port_layer]
inputtype=int
outputtype=component
default=null
val=0,charter:sarim_port
val=1,charter:brimhaven_port
val=2,charter:catherby_port
val=4,charter:musa_port
val=5,charter:khazard_port
val=6,charter:phasmatys_port
val=7,charter:shipyard_port
val=8,charter:tyras_port

// ...and its click box, hidden while the ship is under way.
[charter_port_button]
inputtype=int
outputtype=component
default=null
val=0,charter:sarim
val=1,charter:brimhaven
val=2,charter:catherby
val=4,charter:musa
val=5,charter:khazard
val=6,charter:phasmatys
val=7,charter:shipyard
val=8,charter:tyras

// The fare, in coins, keyed origin * 10 + destination: the OSRS wiki's table
// (https://oldschool.runescape.wiki/w/Template:Charter_ship_fares), every route between two ports
// this build has. The wiki has no fare between Port Sarim and Musa Point either way - the Karamja
// boat covers that crossing for 30 - so neither is here, and a missing route is -1.
[charter_fares]
inputtype=int
outputtype=int
default=-1
// Port Sarim
val=1,1600
val=2,1000
val=5,1280
val=6,1300
val=7,400
val=8,3200
// Brimhaven
val=10,1600
val=12,480
val=14,480
val=15,400
val=16,2900
val=17,400
val=18,3200
// Catherby
val=20,1000
val=21,480
val=24,480
val=25,1600
val=26,3500
val=27,1600
val=28,3200
// Musa Point
val=41,480
val=42,480
val=45,400
val=46,1100
val=47,200
val=48,3200
// Port Khazard
val=50,1280
val=51,400
val=52,1600
val=54,400
val=56,4100
val=57,1600
val=58,3200
// Port Phasmatys
val=60,1300
val=61,2900
val=62,3500
val=64,1100
val=65,4100
val=67,3200
val=68,3200
// the Shipyard
val=70,400
val=71,400
val=72,1600
val=74,200
val=75,1600
val=76,3200
val=78,3200
// Port Tyras: 3,200 to anywhere
val=80,3200
val=81,3200
val=82,3200
val=84,3200
val=85,3200
val=86,3200
val=87,3200
