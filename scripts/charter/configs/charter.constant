// Charter ships (https://oldschool.runescape.wiki/w/Charter_ship). The ports are numbered as the wiki
// numbers its destinations (the keys OSRS later gave them), so the fare table below reads the same way
// round as the wiki's. Missing numbers are ports this build does not have:
//   3  Mos Le'Harmless - its charter pier is in map square m57_45, which this build has none of.
//   9+ Corsair Cove and everything after it - 2016 and later.
^charter_sarim = 0
^charter_brimhaven = 1
^charter_catherby = 2
^charter_musa = 4
^charter_khazard = 5
^charter_phasmatys = 6
^charter_shipyard = 7
^charter_tyras = 8
^charter_port_count = 9

// "Transportation time takes only a few seconds" - the wiki. Three seconds on the map.
^charter_voyage_ticks = 5
