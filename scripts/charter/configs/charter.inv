// Trader Stan's Trading Post: https://oldschool.runescape.wiki/w/Trader_Stan%27s_Trading_Post
// One shop for the whole fleet - the separate stock at each port came in 2016 (the Charter ship
// page's changes). The wiki's stock, less what this build does not have: the empty jug and bucket
// packs, the Security book, the Tyras helm, the Right eye patch, and the bronze cannonballs Sailing
// added in 2025. Its bucket of slime is this build's bucket_ectoplasm.
[trader_stan_shop]
scope=shared
size=40
restock=yes
stackall=yes
allstock=yes
stock1=pot_empty,5,10
stock2=jug_empty,2,100
stock3=shears,2,100
stock4=bucket_empty,3,10
stock5=bowl_empty,2,50
stock6=cake_tin,2,50
stock7=tinderbox,2,100
stock8=chisel,2,100
stock9=hammer,5,100
stock10=newcomer_map,5,100
stock11=rope,2,300
stock12=knife,2,100
stock13=pineapple,15,100
stock14=banana,15,100
stock15=orange,10,100
stock16=bucket_ectoplasm,10,100
stock17=glassblowingpipe,15,100
stock18=bucket_sand,10,100
stock19=seaweed,20,100
stock20=soda_ash,10,100
stock21=lobster_pot,20,100
stock22=fishing_rod,20,100
stock23=swamppaste,30,100
stock24=raw_rabbit,20,100
