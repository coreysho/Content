// GENERATED by tools/gencollectionlog.py from tools/collectionlogspec.json - do not hand-edit.
//   python3 tools/gencollectionlog.py
//
// THE SWITCHES. This engine cannot address a component or a varp by number at runtime, so
// everything the window does "to row $i" or "to counter $id" is a switch_int written out here.
// The logic - what goes in a row, what counts as obtained - is all in collection_log.rs2;
// nothing in this file knows what any page contains.

// One row of the entry list: its name, and the fill that marks it open. A row past the end of
// the tab is hidden, which only works because every row is its own layer.
[proc,collection_log_row](int $i, boolean $hide, string $text, int $fill)
switch_int ($i) {
    case 0 :
        if_sethide(collection_log:row0, $hide);
        if_settext(collection_log:r0name, $text);
        if_setcolour(collection_log:r0box, $fill);
    case 1 :
        if_sethide(collection_log:row1, $hide);
        if_settext(collection_log:r1name, $text);
        if_setcolour(collection_log:r1box, $fill);
    case 2 :
        if_sethide(collection_log:row2, $hide);
        if_settext(collection_log:r2name, $text);
        if_setcolour(collection_log:r2box, $fill);
    case 3 :
        if_sethide(collection_log:row3, $hide);
        if_settext(collection_log:r3name, $text);
        if_setcolour(collection_log:r3box, $fill);
    case 4 :
        if_sethide(collection_log:row4, $hide);
        if_settext(collection_log:r4name, $text);
        if_setcolour(collection_log:r4box, $fill);
    case 5 :
        if_sethide(collection_log:row5, $hide);
        if_settext(collection_log:r5name, $text);
        if_setcolour(collection_log:r5box, $fill);
    case 6 :
        if_sethide(collection_log:row6, $hide);
        if_settext(collection_log:r6name, $text);
        if_setcolour(collection_log:r6box, $fill);
    case 7 :
        if_sethide(collection_log:row7, $hide);
        if_settext(collection_log:r7name, $text);
        if_setcolour(collection_log:r7box, $fill);
    case 8 :
        if_sethide(collection_log:row8, $hide);
        if_settext(collection_log:r8name, $text);
        if_setcolour(collection_log:r8box, $fill);
    case 9 :
        if_sethide(collection_log:row9, $hide);
        if_settext(collection_log:r9name, $text);
        if_setcolour(collection_log:r9box, $fill);
    case 10 :
        if_sethide(collection_log:row10, $hide);
        if_settext(collection_log:r10name, $text);
        if_setcolour(collection_log:r10box, $fill);
    case 11 :
        if_sethide(collection_log:row11, $hide);
        if_settext(collection_log:r11name, $text);
        if_setcolour(collection_log:r11box, $fill);
}

// One tab: its fill and its label, bright for the open one.
[proc,collection_log_tab_paint](int $i, int $fill, string $text)
switch_int ($i) {
    case 0 :
        if_setcolour(collection_log:tab0fill, $fill);
        if_settext(collection_log:tab0, $text);
    case 1 :
        if_setcolour(collection_log:tab1fill, $fill);
        if_settext(collection_log:tab1, $text);
    case 2 :
        if_setcolour(collection_log:tab2fill, $fill);
        if_settext(collection_log:tab2, $text);
    case 3 :
        if_setcolour(collection_log:tab3fill, $fill);
        if_settext(collection_log:tab3, $text);
}

// One counter line of the open entry. Blank text is how an unused one disappears.
[proc,collection_log_counter_text](int $i, string $text)
switch_int ($i) {
    case 0 : if_settext(collection_log:counter0, $text);
    case 1 : if_settext(collection_log:counter1, $text);
    case 2 : if_settext(collection_log:counter2, $text);
}

// READ A COUNTER BY ID. Below ^collection_log_own_base it is a boss kill count, which
// ~boss_kill_get already switches on; above it, one of the log's own varps.
[proc,collection_log_counter_get](int $id)(int)
if ($id < ^collection_log_own_base) {
    return(~boss_kill_get($id));
}
switch_int ($id) {
    case ^collection_log_counter_clue_easy : return(%collection_log_count_clue_easy);
    case ^collection_log_counter_clue_medium : return(%collection_log_count_clue_medium);
    case ^collection_log_counter_clue_hard : return(%collection_log_count_clue_hard);
    case ^collection_log_counter_barrows_chests : return(%collection_log_count_barrows_chests);
}
return(0);

// ADD TO ONE OF THE LOG'S OWN COUNTERS. The boss kill counts are ~boss_kill_record's to keep,
// so an id below the base does nothing here rather than counting a kill twice.
[proc,collection_log_counter_add](int $id, int $n)
switch_int ($id) {
    case ^collection_log_counter_clue_easy : %collection_log_count_clue_easy = add(%collection_log_count_clue_easy, $n);
    case ^collection_log_counter_clue_medium : %collection_log_count_clue_medium = add(%collection_log_count_clue_medium, $n);
    case ^collection_log_counter_clue_hard : %collection_log_count_clue_hard = add(%collection_log_count_clue_hard, $n);
    case ^collection_log_counter_barrows_chests : %collection_log_count_barrows_chests = add(%collection_log_count_barrows_chests, $n);
}

// The clicks.
[if_button,collection_log:tab0] ~collection_log_select_tab(0);
[if_button,collection_log:tab1] ~collection_log_select_tab(1);
[if_button,collection_log:tab2] ~collection_log_select_tab(2);
[if_button,collection_log:tab3] ~collection_log_select_tab(3);
[if_button,collection_log:r0box] ~collection_log_select_entry(0);
[if_button,collection_log:r1box] ~collection_log_select_entry(1);
[if_button,collection_log:r2box] ~collection_log_select_entry(2);
[if_button,collection_log:r3box] ~collection_log_select_entry(3);
[if_button,collection_log:r4box] ~collection_log_select_entry(4);
[if_button,collection_log:r5box] ~collection_log_select_entry(5);
[if_button,collection_log:r6box] ~collection_log_select_entry(6);
[if_button,collection_log:r7box] ~collection_log_select_entry(7);
[if_button,collection_log:r8box] ~collection_log_select_entry(8);
[if_button,collection_log:r9box] ~collection_log_select_entry(9);
[if_button,collection_log:r10box] ~collection_log_select_entry(10);
[if_button,collection_log:r11box] ~collection_log_select_entry(11);

// Opened from the row this generator puts under "Boss kill counts" in the quest list.
[if_button,questlist:collection_log] ~collection_log_open;
