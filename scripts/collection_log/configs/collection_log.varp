// The window's place: which tab and which entry on it are open. Temp - Old School reopens the log
// where you left it within a session, and nothing about that needs to outlive a logout.
[collection_log_tab]

[collection_log_entry]

// THE REWARDS ALREADY PAID, one bit per collection_log_reward row (its bit column). Perm, and
// protect=no for the same reason the log's inv is: a reward can come due inside a monster's death
// script. Thirty-two rewards fit; the thirty-third needs a second varp and a line in
// ~collection_log_reward_paid / ~collection_log_reward_mark, and the generator refuses a bit past 31
// until then.
[collection_log_rewards]
scope=perm
protect=no

// THE LAST ITEM LOGGED FOR THE FIRST TIME, and when (world_minute), for the quest tab's Collection
// Log page ("Latest: Dragon axe (2 days ago)"). Written by ~collection_log_add beside the "New item
// added" message, so only a first-ever drop moves it. Perm, and protect=no for the same reason the
// log's inv is: most items are logged from a monster's death script. An account that has logged
// nothing since this was added has no latest item, and the page says so.
[collection_log_latest]
scope=perm
type=namedobj
protect=no

[collection_log_latest_minute]
scope=perm
protect=no
