// THE COLLECTION LOG'S PAGES AND REWARDS. The rows are collection_log.dbrow, generated by
// tools/gencollectionlog.py from tools/collectionlogspec.json - edit the spec, not the rows.

// A tab of the window. entries is the tab's list, in the order the window shows it.
[collection_log_tab]
column=tab,int,INDEXED,REQUIRED
column=name,string,REQUIRED
column=entries,dbrow,LIST

// One page. items is the page's grid, in order - namedobj, because inv_setslot will take nothing
// less and the window builds its grid straight from this list. counters is up to three
// (label, id) pairs for the lines under the page's name: an id below ^collection_log_own_base is a
// boss kill count slot, anything else one of the log's own counters (collection_log_ui.rs2).
[collection_log_entry]
column=name,string,REQUIRED
column=items,namedobj,LIST,REQUIRED
column=counters,string,int,LIST

// A REWARD, paid once by ~collection_log_rewards when its threshold is met.
//   bit        which bit of %collection_log_rewards records it as paid. Unique, and never reused:
//              a player who was paid under a bit keeps that bit set forever.
//   entry      the page it counts, or absent for the whole log (distinct items, as the title shows)
//   threshold  items obtained on that page / in the log; -1 means every one of them
//   reward     an item and count to hand over, or absent for a message-only milestone
//   message    what the player is told when it pays
[collection_log_reward]
column=bit,int,REQUIRED
column=entry,dbrow
column=threshold,int,REQUIRED
column=reward,namedobj,int
column=message,string
