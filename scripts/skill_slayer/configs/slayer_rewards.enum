// Slayer point rewards (skill_slayer/scripts/slayer_rewards.rs2). Extend index -> data; bit n of
// %slayer_extends is extend n. Costs, names and kill ranges from the OSRS Slayer Rewards page except
// Pedal to the Metals, whose 30-50 is this server's choice (Duradel gives 10-60 metal dragons here).

[slayer_extend_name]
inputtype=int
outputtype=string
val=0,Augment my Abbies
val=1,It's Dark in Here
val=2,Greater Challenge
val=3,Bleed Me Dry
val=4,Smell Ya Later
val=5,Get Smashed
val=6,Nechs Please
val=7,Basilonger
val=8,Fire & Darkness
val=9,Pedal to the Metals
val=10,Wyver-nother One

[slayer_extend_cost]
inputtype=int
outputtype=int
val=0,100
val=1,100
val=2,100
val=3,75
val=4,100
val=5,100
val=6,100
val=7,100
val=8,50
val=9,200
val=10,100

[slayer_extend_monster]
inputtype=int
outputtype=string
val=0,abyssal demon
val=1,black demon
val=2,greater demon
val=3,bloodveld
val=4,aberrant spectre
val=5,gargoyle
val=6,nechryael
val=7,basilisk
val=8,black dragon
val=9,bronze, iron and steel dragon
val=10,skeletal wyvern

[slayer_extend_min]
inputtype=int
outputtype=int
val=0,200
val=1,200
val=2,200
val=3,200
val=4,200
val=5,200
val=6,200
val=7,200
val=8,40
val=9,30
val=10,50

[slayer_extend_max]
inputtype=int
outputtype=int
val=0,250
val=1,250
val=2,250
val=3,250
val=4,250
val=5,250
val=6,250
val=7,250
val=8,60
val=9,50
val=10,75

// task (^slayer_*) -> 1 + extend index; 0 = no extension exists for it
[slayer_task_extend]
inputtype=int
outputtype=int
default=0
val=^slayer_abyssaldemon,1
val=^slayer_blackdemon,2
val=^slayer_greaterdemon,3
val=^slayer_bloodveld,4
val=^slayer_aberrantspecter,5
val=^slayer_gargoyle,6
val=^slayer_nechryael,7
val=^slayer_basilisk,8
val=^slayer_blackdragon,9
val=^slayer_bronzedragon,10
val=^slayer_skeletalwyvern,11
val=^slayer_irondragon,10
val=^slayer_steeldragon,10
