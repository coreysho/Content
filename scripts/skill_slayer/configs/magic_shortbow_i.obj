// MAGIC SHORTBOW (I) (2026-09-21). The magic shortbow, imbued with a scroll of imbuing - the same
// scroll as every other imbue here (imbue_scroll.obj), rather than OSRS's one-item Nightmare Zone
// scroll: this server has one scroll and the rule that everything it imbues can be uncharged.
// OSRS's differences, and only those: +75 ranged attack against +69, and a cheaper special - 50% of
// the bar against 55%, so this build's 350 becomes 318. Same model, same Snapshot special
// (player_special_attack.rs2 / pvp_special_attack.rs2), untradeable like every imbue.
[magic_shortbow_i]
name=Magic shortbow (i)
desc=Short and magical, but still effective.
recol1s=7330
recol1d=1451
members=yes
tradeable=no
cost=1600
model=obj_shortbow
2dxof=7
2dyof=2
2dzoom=1200
2dyan=124
2dxan=508
iop2=Wield
iop4=Uncharge
wearpos=righthand
wearpos2=lefthand
manwear=obj_shortbow_manwear,0
womanwear=obj_shortbow_manwear,6
category=weapon_bow
weight=3lb
param=rangeattack,75
param=levelrequire,50
param=attackrange,7
param=rangeattack_anim,human_bow
param=defend_anim,human_unarmedblock
param=rangeattack_sound,arrowlaunch2
param=damagetype,^ranged_style
param=specwep,^true
param=sa_energy,318
param=imbue_from,magic_shortbow
