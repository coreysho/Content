[slayer_count]
scope=perm

[slayer_target]
scope=perm

// Slayer points (skill_slayer/scripts/slayer_points.rs2), added 2026-09-10.
[slayer_points]
scope=perm

// tasks completed in a row; Turael swapping a task resets it
[slayer_streak]
scope=perm

// who gave the current task: 1 Turael, 2 Mazchna, 3 Vannaka, 4 Chaeldar, 5 Duradel (0 = before this existed)
[slayer_task_master]
scope=perm

// blocked tasks (^slayer_* values, 0 = empty slot)
[slayer_block1]
scope=perm

[slayer_block2]
scope=perm

[slayer_block3]
scope=perm

[slayer_block4]
scope=perm

// Slayer point unlocks: bit 0 Gargoyle Smasher, 1 Slug Salter, 2 Reptile Freezer, 3 Ring Bling,
// 4 Bigger and Badder
[slayer_unlocks]
scope=perm

// Slayer point task extensions: bit n = slayer_rewards.enum index n
[slayer_extends]
scope=perm

// Imbued heart: world_minute of the last Invigorate (7-minute cooldown, superiors.rs2)
[imbued_heart_minute]
scope=perm
