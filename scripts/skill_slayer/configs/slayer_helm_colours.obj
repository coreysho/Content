// The recoloured slayer helmets.
//
// GENERATED by tools/genslayerhelm.py from tools/slayerhelmspec.json - do not hand-edit.
//
// Every one is the plain helmet with TWO RECOLOUR PAIRS and a different name. The helmet's
// face mask is the same two colours the black mask itself is made of - rgb15 3170 and 5284 -
// so the recolour lands on exactly the part OSRS recolours and no new model is needed.
//
// Everything else - the models, the wear positions, the camera, the defences, the Check and
// Disassemble ops - is copied from the plain helmet and its imbued twin, so a colour cannot
// quietly have different stats from the helmet it is a recolour of.

[slayer_helm_red]
name=Red slayer helmet
desc=You don't want to wear it inside-out.
model=obj_slayer_helm
manwear=obj_slayer_helm_manwear,0
womanwear=obj_slayer_helm_womanwear,0
manhead=obj_slayer_helm_manhead
womanhead=obj_slayer_helm_womanhead
wearpos=hat
wearpos2=head
wearpos3=jaw
2dzoom=779
2dxan=30
2dyan=1791
2dxof=-4
2dyof=-5
weight=2267g
cost=40000
members=yes
tradeable=no
iop2=Wear
iop3=Check
iop4=Disassemble
category=armour_helmet
param=stabdefence,30
param=slashdefence,32
param=crushdefence,27
param=magicdefence,10
param=rangedefence,30
recol1s=3170
recol1d=10240
recol2s=5284
recol2d=17474
param=slayer_headgear,yes
param=slayer_helmet,yes

