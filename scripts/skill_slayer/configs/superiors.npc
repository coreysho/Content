// Superior slayer monsters (skill_slayer/scripts/superiors.rs2). Models and combat stats are the
// OSRS ones (tools/models/importosrsnpc.py, batch_superiors.txt); animations, sounds, attack style,
// defence bonuses and slayer_category are copied from the 377 monster each one replaces, whose
// animations fit the new models (checked by rendering ready/attack/death frames).

[superior_crushing_hand]
name=Crushing hand
desc=A superior crawling hand. It looks far tougher than the others.
model1=npc_superior_crushing_hand_1
size=3
readyanim=crawlinghand_ready
walkanim=crawlinghand_walk
vislevel=45
attack=45
defence=14
strength=42
hitpoints=55
ranged=1
magic=1
op2=Attack
param=attack_anim,crawlinghand_attack
param=defend_anim,crawlinghand_defend
param=death_anim,crawlinghand_death
param=attack_sound,hand_attack
param=defend_sound,hand_hit
param=death_sound,hand_death
param=damagetype,^crush_style
param=slayer_category,^slayer_crawlinghand

