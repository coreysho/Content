// Slayer points (skill_slayer/scripts/slayer_points.rs2) - OSRS prices
^slayer_cancel_cost = 30
^slayer_block_cost = 100

// ---- the Scroll of imbuing (skill_slayer/scripts/imbue_scroll.rs2) ----
// The imbue used to be a slayer master's service at 1,250 points - about eighty tasks for ONE
// imbue, a number that round itself called invented and too steep. It is a DROP now, of OSRS's own
// Scroll of imbuing, and these two numbers are the whole of it.

// ONE SCROLL PER THIS MANY HITPOINTS KILLED ON TASK. Weighted by the monster's hitpoints, not flat
// per kill, for the same reason ^bottomless_roll_xp is weighted by experience: a flat per-kill rate
// would make Turael's rats - fifteen of them a minute, five hitpoints each - the fastest scroll farm
// in the game. Weighting by hitpoints makes the rate a rate of TIME instead, and a slayer kill
// already pays Slayer xp as 10 x hitpoints, so this is the quantity the skill is already denominated
// in.
//
// Measured against this build's own task tables (the weighted mean of every row in
// slayer_tasks.dbrow against the hitpoints of the npcs in each task's slayer_category):
//
//     Turael      932 hitpoints a task  -> 161 tasks a scroll
//     Mazchna   2,268                   ->  66
//     Vannaka   6,549                   ->  23
//     Chaeldar 14,585                   ->  10
//     Duradel  18,973                   ->   8
//
// So the scroll is a high-level reward and low-level task farming cannot shortcut it - which is the
// shape the old price had, at a tenth of its cost per imbue.
^imbue_scroll_hitpoints = 150000

// AND A SUPERIOR PAYS A FLAT ONE IN THIS MANY, on top of the hitpoints roll it gets for being an
// on-task kill like any other. Flat, because "an increased rate" has to be visible: a superior
// averages 211 hitpoints, so its hitpoints roll alone is about 1/711, and this is roughly fifty
// times that. With Bigger and Badder a superior appears on 1/200 of on-task kills, so this path
// adds about a third again to a Duradel-task player's scrolls - six tasks a scroll rather than
// eight - and nothing at all to a player who has not bought the unlock.
^imbue_scroll_superior_odds = 15

// ---- the Slayer Rewards window (slayer_window.rs2, interface by tools/genslayerui.py) ----
// The five tabs, in OSRS's own order. Cosmetics is empty until the slayer helmet recolours land.
^slayer_tab_unlock = 0
^slayer_tab_extend = 1
^slayer_tab_buy = 2
^slayer_tab_tasks = 3
^slayer_tab_cosmetics = 4
^slayer_tab_count = 5

// Rows the Tasks tab shows: cancel, block, and one per block slot.
^slayer_task_rows = 6

// Every description in the window is two lines (battery group 4 proves it), so the third line of
// the panel is always blank and nothing needs a table of line counts.
^slayer_desc_lines = 2

// How many clicks one opening of the window will answer before it closes itself, and what a click
// costs.
//
// The engine gives a SCRIPT 500,000 opcodes and does not reset the count when it suspends on
// p_pausebutton, so every click in one window session comes out of one budget - that is what threw
// "Too many instructions" out of the Construction window (claude/poh-menu-opcount.md). Both numbers
// below are MEASURED, not guessed: the compiled script.pack was run through the engine's own opcode
// table (the harness in that doc, extended to strings and the if_ ops), and the worst click - the
// Extend tab, eleven rows, one selected - is a 2,229-opcode redraw plus 269 for its resume buttons.
//
// 128 x 2,498 is 319,744, or 64% of the budget: more clicks than anyone spends in one visit, and
// impossible to run out of. Battery group 6 multiplies these two and fails if the product climbs
// past 400,000, so raising either one means measuring again - 200 clicks would be 99% of it.
^slayer_ui_clicks = 128
^slayer_ui_click_ops = 2498

// The bright halves of the two browns the window paints with if_setcolour: the row you have
// selected, and the tab that is open. Their dark halves are in tools/genslayerui.py, because they
// are what the interface is written with; these two are what the script sets. Battery group 5
// checks the pair against the file.
^slayer_ui_row_on = 0x8C7F63
^slayer_ui_row_off = 0x4A3F31
^slayer_ui_tab_on = 0x6F6250
^slayer_ui_tab_off = 0x3E3529
