// The imbue pairing, both ways round, as data on the objs themselves.
//
// The alternative was a table in the script, and the fourteen recoloured slayer helmets are why
// there is not one: a table would have thirty-eight rows and would have to be edited every time a
// colour arrives. These two params are written by tools/genslayerhelm.py for the helmets, by hand
// for the black mask and the four rings, and read by exactly one proc each.
//
// BOTH DIRECTIONS ARE STORED rather than one being derived, because the engine has no command that
// searches a param by its value. tools/poh_battery.py group 66 walks the whole obj table and fails
// if a pair only points one way - which is the mistake this shape can make and the only one.

// On a plain item: the imbued twin a Scroll of imbuing turns it into.
[imbue_into]
type=namedobj
default=null

// On an imbued item: the plain item Uncharge gives back, with the scroll.
[imbue_from]
type=namedobj
default=null
