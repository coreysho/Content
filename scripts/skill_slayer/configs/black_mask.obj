// Black mask - imported from the rev 474 (Oct 2007) cache, not built from 377 parts.
//
// Source: 474 obj 8921 "Black mask" (the uncharged one; 8901-8919 are its charge states).
// Models came across byte-for-byte - 474 stores models in the same format the 377 client reads,
// so nothing was converted. 474 model ids -> content/models/obj:
//   15615 obj_black_mask            15935 obj_black_mask_manwear   15946 obj_black_mask_womanwear
//   15921 obj_black_mask_manhead    15924 obj_black_mask_womanhead
// The 2d params below are 474's own, so the inventory icon is framed exactly as it was in 2007.
// No recolours: this is the real black item, not a tinted stand-in.
//
// Stats are the OSRS wiki's. The on-task damage bonus is deliberately NOT wired up here - this
// change is the asset pipeline only, and the combat hook is a separate decision.

[black_mask]
name=Black mask
desc=A face mask that helps you hunt your prey.
model=obj_black_mask
2dxof=-1
2dyof=3
2dzoom=854
2dyan=1892
2dxan=387
iop2=Wear
wearpos=hat
// NOT head. obj_black_mask_manwear is a FLAT frontal face plate - 44 x 50 x 2 units - not a head
// covering like a full helm (iron full helm's is 38 deep, the void helm's 24). Hiding the head
// leaves the plate floating over nothing, which in game reads as the character's head vanishing.
// The head has to stay visible behind it. jaw is still hidden so a beard cannot clip through the
// plate - same as slayer_facemask, which is the other flat face piece in the cache.
wearpos2=jaw
manwear=obj_black_mask_manwear,0
womanwear=obj_black_mask_womanwear,0
manhead=obj_black_mask_manhead
womanhead=obj_black_mask_womanhead
members=yes
cost=3000
weight=10kg
category=armour_helmet
param=magicattack,-3
param=rangeattack,-1
param=stabdefence,9
param=slashdefence,10
param=crushdefence,8
param=magicdefence,-1
param=rangedefence,9
param=slayer_headgear,yes
param=imbue_into,black_mask_i

[cert_black_mask]
certlink=black_mask
certtemplate=template_for_cert


// Black mask (i). The SAME MODELS as the plain mask - in OSRS the imbued one is visually identical,
// so there is nothing to import and nothing to recolour; only the behaviour differs.
//
// Two differences, both read off the wiki rather than assumed:
//
//   * THE PENALTIES ARE GONE. The plain mask carries magicattack -3 and rangeattack -1; the imbued
//     one is +0 across every attack bonus. That is not a guess from "the imbue helps ranged and
//     magic" - the bonus table says stab/slash/crush/magic/ranged all +0, and the defences are
//     unchanged at 9/10/8/-1/9, which is exactly what the plain mask above has.
//   * ON TASK IT BOOSTS RANGED AND MAGIC by 15% to accuracy AND damage, on top of the melee 7/6
//     the plain mask already gives. That is the whole point of the item and it is wired in
//     skill_slayer/scripts/black_mask.rs2 and the two combat paths.
//
// cost is the plain mask's: the imbue is bought with Slayer points, not coins, so the shop value of
// the item itself has no reason to move.

[black_mask_i]
name=Black mask (i)
// The cache gives Black mask (i) the plain mask's examine text, word for word (obj 11784 and
// obj 8921 both read "An inert-seeming cave horror mask."). Ours keeps 377's own wording for
// the plain mask, so the imbued one takes that, not an invented suffix.
desc=A face mask that helps you hunt your prey.
model=obj_black_mask
// Uncharge hands the plain mask and the scroll back - OSRS lets an imbue be moved between items,
// and here, where the scroll is a drop rather than a shop line, that is most of its value. IN SLOT
// 4, with slot 3 left empty, because that is where OSRS's Black mask (i) (obj 11784) puts it.
iop4=Uncharge
2dxof=-1
2dyof=3
2dzoom=854
2dyan=1892
2dxan=387
iop2=Wear
wearpos=hat
wearpos2=jaw
manwear=obj_black_mask_manwear,0
womanwear=obj_black_mask_womanwear,0
manhead=obj_black_mask_manhead
womanhead=obj_black_mask_womanhead
members=yes
tradeable=no
cost=3000
weight=10kg
category=armour_helmet
param=stabdefence,9
param=slashdefence,10
param=crushdefence,8
param=magicdefence,-1
param=rangedefence,9
param=slayer_headgear,yes
param=slayer_imbued,yes
param=imbue_from,black_mask
