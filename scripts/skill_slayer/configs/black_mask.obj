// Black mask - imported from the rev 474 (Oct 2007) cache, not built from 377 parts.
//
// Source: 474 obj 8921 "Black mask" (the uncharged one; 8901-8919 are its charge states).
// Models came across byte-for-byte - 474 stores models in the same format the 377 client reads,
// so nothing was converted. 474 model ids -> content/models/obj:
//   15615 obj_black_mask            15935 obj_black_mask_manwear   15946 obj_black_mask_womanwear
//   15921 obj_black_mask_manhead    15924 obj_black_mask_womanhead
// The 2d params below are 474's own, so the inventory icon is framed exactly as it was in 2007.
// No recolours: this is the real black item, not a tinted stand-in.
//
// Stats are the OSRS wiki's. The on-task damage bonus is deliberately NOT wired up here - this
// change is the asset pipeline only, and the combat hook is a separate decision.

[black_mask]
name=Black mask
desc=A face mask that helps you hunt your prey.
model=obj_black_mask
2dxof=-1
2dyof=3
2dzoom=854
2dyan=1892
2dxan=387
iop2=Wear
wearpos=hat
wearpos2=head
wearpos3=jaw
manwear=obj_black_mask_manwear,0
womanwear=obj_black_mask_womanwear,0
manhead=obj_black_mask_manhead
womanhead=obj_black_mask_womanhead
members=yes
cost=3000
weight=10kg
category=armour_helmet
param=magicattack,-3
param=rangeattack,-1
param=stabdefence,9
param=slashdefence,10
param=crushdefence,8
param=magicdefence,-1
param=rangedefence,9

[cert_black_mask]
certlink=black_mask
certtemplate=template_for_cert
