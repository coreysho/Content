// slayer task (^slayer_*) -> its superior (skill_slayer/scripts/superiors.rs2). Turoths have no entry:
// the Spiked turoth model does not take the 377 turoth animations (see superiors.npc).
[slayer_superior]
inputtype=int
outputtype=npc
val=^slayer_crawlinghand,superior_crushing_hand
val=^slayer_cavecrawler,superior_chasm_crawler
val=^slayer_banshee,superior_screaming_banshee
val=^slayer_rockslug,superior_giant_rockslug
val=^slayer_cockatrice,superior_cockathrice
val=^slayer_pyrefiend,superior_flaming_pyrelord
val=^slayer_basilisk,superior_monstrous_basilisk
val=^slayer_bloodveld,superior_insatiable_bloodveld
val=^slayer_jelly,superior_vitreous_jelly
val=^slayer_aberrantspecter,superior_abhorrent_spectre
val=^slayer_kurask,superior_king_kurask
val=^slayer_gargoyle,superior_marble_gargoyle
val=^slayer_nechryael,superior_nechryarch
val=^slayer_abyssaldemon,superior_greater_abyssal
