// Wall beasts (skill_slayer/scripts/npcs/wall_beast.rs2): the hole in the wall grabs whoever steps in
// front of it, whatever their level, and hands off to [ai_applayer2,swamp_wallbeast].
[wallbeast_grab]
type=player
check_vis=off
check_nottoostrong=off
check_notcombat=%lastcombat
check_notcombat_self=%npc_lastcombat
check_notbusy=off
find_keephunting=off
find_newmode=applayer2
