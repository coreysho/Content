// Slayer skill guide, shown on the original RS2 skill guide interface
// (see content/scripts/interfaces/skill_guide.rs2 for the generic driver).
// Uses the repo's own slayerguide_* icon objs.
[proc,open_slayer_guide]
~skillguide_begin(^guide_slayer, "Slayer");
~skillguide_members;
def_int $lvl = stat(slayer);
~skillguide_row(1, $lvl, 5, slayerguide_crawlinghand, "Crawling Hands");
~skillguide_row(2, $lvl, 7, swamp_cave_bug, "Cave Bugs");
~skillguide_row(3, $lvl, 10, slayerguide_cavecrawler, "Cave Crawlers");
~skillguide_row(4, $lvl, 15, slayerguide_banshee, "Banshees");
~skillguide_row(5, $lvl, 20, slayerguide_rockslug, "Rockslugs");
~skillguide_row(6, $lvl, 25, slayerguide_cockatrice, "Cockatrice");
~skillguide_row(7, $lvl, 30, slayerguide_pyrfiend, "Pyrefiends");
~skillguide_row(8, $lvl, 32, slayerguide_mogre, "Mogres");
~skillguide_row(9, $lvl, 35, swamp_wallbeast, "Wall Beasts");
~skillguide_row(10, $lvl, 37, slayerguide_killerwatt, "Killerwatts");
~skillguide_row(11, $lvl, 40, slayerguide_basilisk, "Basilisks");
~skillguide_row(12, $lvl, 45, slayerguide_infernalmage, "Infernal Mages");
~skillguide_row(13, $lvl, 50, slayerguide_bloodveld, "Bloodveld");
~skillguide_row(14, $lvl, 52, slayerguide_jelly, "Jellies");
~skillguide_row(15, $lvl, 55, slayerguide_turoth, "Turoth");
~skillguide_row(16, $lvl, 55, slayerguide_broad_arrows, "Broad arrows");
~skillguide_row(17, $lvl, 55, slayer_leafbladed_spear, "Leaf-bladed spear");
~skillguide_row(18, $lvl, 55, slayer_staff, "Slayer staff");
~skillguide_row(19, $lvl, 60, slayerguide_aberrantspecter, "Aberrant Specters");
~skillguide_row(20, $lvl, 65, slayerguide_dustdevil, "Dust Devils");
~skillguide_row(21, $lvl, 70, slayerguide_kurask, "Kurask");
~skillguide_row(22, $lvl, 72, slayerguide_skeletalwyvern, "Skeletal Wyverns");
~skillguide_row(23, $lvl, 75, slayerguide_gargoyle, "Gargoyles");
~skillguide_row(24, $lvl, 80, slayerguide_nechryael, "Nechryael");
~skillguide_row(25, $lvl, 85, slayerguide_abyssaldemon, "Abyssal Demons");
~skillguide_row(26, $lvl, 90, slayerguide_dark_beast, "Dark Beasts");
~skillguide_show;
