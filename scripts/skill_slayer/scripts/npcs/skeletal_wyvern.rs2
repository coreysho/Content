// Skeletal Wyverns (Asgarnian Ice Dungeon, Slayer 72).
//
// They were typed ranged but had no ranged AI, so they walked into melee range and punched -
// the one thing a wyvern is not supposed to do. The cache already held everything needed:
// wyvern_skeleton_iceball / wyvern_skeleton_launch_iceball / wyvern_skeleton_travel_iceball for
// the ranged attack and wyvern_skeleton_ice_breath / wyvern_skeleton_travel_breath for the breath.
//
// Three attacks, per the wiki: melee slash (13), ranged iceball (13) and the icy breath, which
// hits for 50+ unprotected and is cut to about 10 by an elemental or dragonfire shield. The breath
// also ignores armour entirely, so it rolls no accuracy check - only the shield matters. Same
// shield item the dragons use (antidragonbreathshield); the elemental shield is its upgrade and is
// not in this cache.

[ai_queue1,skeletal_wyvern1] ~npc_default_retaliate_ap;
[ai_queue1,skeletal_wyvern2] ~npc_default_retaliate_ap;
[ai_queue1,skeletal_wyvern3] ~npc_default_retaliate_ap;
[ai_queue1,skeletal_wyvern4] ~npc_default_retaliate_ap;

[ai_applayer2,skeletal_wyvern1] ~wyvern_attack;
[ai_applayer2,skeletal_wyvern2] ~wyvern_attack;
[ai_applayer2,skeletal_wyvern3] ~wyvern_attack;
[ai_applayer2,skeletal_wyvern4] ~wyvern_attack;
[ai_opplayer2,skeletal_wyvern1] ~wyvern_attack;
[ai_opplayer2,skeletal_wyvern2] ~wyvern_attack;
[ai_opplayer2,skeletal_wyvern3] ~wyvern_attack;
[ai_opplayer2,skeletal_wyvern4] ~wyvern_attack;

[proc,wyvern_attack]
if (%npc_action_delay > map_clock) {
    npc_setmode(applayer2);
    return;
}
if (~npc_check_notcombat = false) {
    npc_setmode(null);
    return;
}
if (~npc_check_notcombat_self = false) {
    return;
}
// Roughly one attack in five is the breath; up close it will also just bite.
if (random(5) = 0) {
    ~wyvern_icy_breath;
    return;
}
if (distance(coord, npc_coord) <= 1 & random(2) = 0) {
    npc_anim(wyvern_skeleton_bite, 0);
    ~npc_meleeattack;
    return;
}
~npc_rangeattack;

[proc,wyvern_icy_breath]
if_close;
npc_anim(wyvern_skeleton_ice_breath, 0);
%npc_action_delay = add(map_clock, npc_param(attackrate));
def_int $duration = ~player_projectile(npc_coord, coord, uid, wyvern_skeleton_travel_breath, 40, 36, 32, 15, 0, 11, 5);

// The breath ignores armour, so there is no accuracy roll - only the shield changes the damage.
def_int $maxhit = 50;
if (inv_total(worn, antidragonbreathshield) > 0) {
    $maxhit = 10;
    mes("Your shield absorbs most of the wyvern's icy breath!");
} else {
    mes("You are frozen by the wyvern's icy breath!");
    // The breath freezes the player the way the ancient ice spells do.
    if (%frozen < map_clock) {
        %frozen = add(map_clock, 8);
    }
}
queue(combat_damage_player, calc($duration / 30), randominc($maxhit));
queue*(playerhit_n_retaliate, calc($duration / 30))(npc_uid);
~npc_set_attack_vars;
