// Killerwatt (Killerwatt Plane, Slayer 37).
//
// The ball form shocks from a distance on a very fast 2-tick attack. It was typed magic but had
// no ranged AI, so it closed to melee instead. skeleton_killerwatt_electricshock is the cache\'s
// own projectile for it.

[ai_queue1,slayer_killerwatt_ball] ~npc_default_retaliate_ap;
[ai_applayer2,slayer_killerwatt_ball] ~killerwatt_shock;
[ai_opplayer2,slayer_killerwatt_ball] ~killerwatt_shock;

[proc,killerwatt_shock]
~npc_cast_spell_with_forced_max_hit(^wind_strike, npc_param(attackrate), 8);
