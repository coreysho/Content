// Black mask / Slayer helmet behaviour.
//
// On-task bonus
// -------------
// Both items give 16.67% (7/6) to the melee accuracy roll and to max hit against monsters on the
// player's current slayer task. Melee only - the mask does nothing for ranged or magic, which
// matches the item's behaviour in 2006-era and modern RuneScape alike.
//
// "On task" is defined as: the target npc's slayer_category param equals %slayer_target, and
// %slayer_count is still above zero. That is the same pair of values npc_death.rs2 passes to
// ~check_progress_task, so a monster the mask boosts is exactly a monster that counts towards
// the task - the two can never drift apart.
//
// %slayer_target is 0 with no task assigned and slayer categories start at 1, so the
// %slayer_target > 0 guard also covers npcs whose slayer_category param is unset.
//
// The actual application lives on the melee path in
// skill_combat/scripts/player/player_melee.rs2, using ~player_npc_hit_roll_boosted.

[proc,slayer_mask_on_task]()(boolean)
if (%slayer_target <= 0 | %slayer_count <= 0) {
    return(false);
}
if (npc_param(slayer_category) ! %slayer_target) {
    return(false);
}
def_obj $hat = inv_getobj(worn, ^wearpos_hat);
if ($hat = black_mask | $hat = slayer_helmet) {
    return(true);
}
return(false);

// Making the helmet
// -----------------
// OSRS wants black mask + facemask + earmuffs + nose peg + spiny helmet + enchanted gem at
// 55 Crafting. There is no spiny helmet in the 377 cache (no obj, no model), so it is left out
// of the recipe - everything else is required. Add it here if a spiny helmet is ever added.
//
// None of these five items had an [opheldu] trigger before this file, so there is nothing to
// collide with.

[opheldu,black_mask] @slayer_helmet_combine;
[opheldu,slayer_facemask] @slayer_helmet_combine;
[opheldu,slayer_earmuffs] @slayer_helmet_combine;
[opheldu,slayer_nosepeg] @slayer_helmet_combine;
[opheldu,slayer_gem] @slayer_helmet_combine;

// last_useitem is the *other* item in the pair, so this is reached with one of the five in hand
// and last_useitem set to whatever it was used on. Anything outside the recipe falls through to
// the default "nothing interesting happens" message, same as crystal_key.rs2 does.
[label,slayer_helmet_combine]
if (last_useitem ! black_mask & last_useitem ! slayer_facemask & last_useitem ! slayer_earmuffs
    & last_useitem ! slayer_nosepeg & last_useitem ! slayer_gem) {
    ~displaymessage(^dm_default);
    return;
}
if (inv_total(inv, black_mask) < 1 | inv_total(inv, slayer_facemask) < 1
    | inv_total(inv, slayer_earmuffs) < 1 | inv_total(inv, slayer_nosepeg) < 1
    | inv_total(inv, slayer_gem) < 1) {
    ~mesbox("To make a slayer helmet you need a black mask, a facemask, a pair of|earmuffs, a nose peg and an enchanted gem, all in your inventory.");
    return;
}
if (stat_base(crafting) < 55) {
    ~mesbox("You need a Crafting level of 55 to combine these into a slayer helmet.");
    return;
}
inv_del(inv, black_mask, 1);
inv_del(inv, slayer_facemask, 1);
inv_del(inv, slayer_earmuffs, 1);
inv_del(inv, slayer_nosepeg, 1);
inv_del(inv, slayer_gem, 1);
inv_add(inv, slayer_helmet, 1);
mes("You combine the pieces into a slayer helmet.");

// Inherited component protections
// -------------------------------
// The slayer helmet absorbs the facemask, earmuffs and nose peg, so anything that checked for a
// component directly now goes through one of these three procs instead. Call sites patched:
//   skill_slayer/scripts/npcs/banshee.rs2          (earmuffs, x2)
//   skill_slayer/scripts/npcs/aberrant_specter.rs2 (nose peg, x2)
//   quests/quest_deserttreasure/scripts/dt_smoke.rs2 (facemask)
// Add any future check here rather than testing the component obj directly, or the helmet will
// silently stop working for that piece of content.

[proc,slayer_earmuffs_worn]()(boolean)
if (inv_total(worn, slayer_earmuffs) > 0 | inv_total(worn, slayer_helmet) > 0) {
    return(true);
}
return(false);

[proc,slayer_facemask_worn]()(boolean)
if (inv_total(worn, slayer_facemask) > 0 | inv_total(worn, slayer_helmet) > 0) {
    return(true);
}
return(false);

[proc,slayer_nosepeg_worn]()(boolean)
if (inv_total(worn, slayer_nosepeg) > 0 | inv_total(worn, slayer_helmet) > 0) {
    return(true);
}
return(false);
