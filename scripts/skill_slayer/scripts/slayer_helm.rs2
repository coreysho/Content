// Slayer helmet - assembly, disassembly, Check, and what it inherits from its parts.
//
// OSRS: 55 Crafting and all five parts in the inventory; use any part on another. OSRS also needs
// the 400-point "Malevolent masquerade" unlock; this build deliberately does not, and the reason
// written here used to be "this build has no slayer points" - which stopped being true when
// slayer_points.rs2 shipped. The helmet is left unlocked on purpose, not for want of a currency.
// Disassembling hands all five back.
//
// IMBUED: a black mask (i) and the four other parts assemble into a slayer helmet (i), and
// disassembling one hands the imbued mask back. The imbue is a property of the mask, so it
// survives being built into a helmet and taken out again - losing it there would make the helmet
// a trap for anyone who had paid for it.
//
// What it inherits, wired where each part is checked:
//   black mask   - on-task 7/6 melee accuracy and damage   skill_slayer/scripts/black_mask.rs2
//   earmuffs     - banshee screech                          skill_slayer/scripts/npcs/banshee.rs2
//   nose peg     - aberrant spectre stench                  skill_slayer/scripts/npcs/aberrant_specter.rs2
//   facemask     - Desert Treasure smoke dungeon            quests/quest_deserttreasure/scripts/dt_smoke.rs2
//   spiny helmet - wall beasts, which do not exist in this build, so nothing to wire.

[opheldu,black_mask] @slayer_helm_combine;
[opheldu,black_mask_i] @slayer_helm_combine;
[opheldu,slayer_earmuffs] @slayer_helm_combine;
[opheldu,slayer_facemask] @slayer_helm_combine;
[opheldu,slayer_nosepeg] @slayer_helm_combine;
[opheldu,wallbeast_spike_helmet] @slayer_helm_combine;

[label,slayer_helm_combine]
// A SCROLL OF IMBUING USED ON A MASK ARRIVES HERE, not at the scroll's own [opheldu]. The mask
// carries this trigger for assembly, and [opheldu] is looked up on the clicked half first
// (network/game/client/handler/OpHeldUHandler.ts), so clicking the mask and then the scroll finds
// this label. Without the handoff the player would get "Nothing interesting happens" from one of
// the two click orders and not the other, which is the worst kind of bug to report.
if (last_useitem = slayer_imbue_scroll) {
    ~imbue_scroll_read(last_item);
    return;
}
if (~slayer_helm_part(last_item) = false | ~slayer_helm_part(last_useitem) = false) {
    ~displaymessage(^dm_default);
    return;
}
if (stat(crafting) < 55) {
    mes("You need a Crafting level of 55 to assemble a slayer helmet.");
    return;
}
def_namedobj $mask = ~slayer_helm_mask;
if ($mask = null | inv_total(inv, slayer_earmuffs) < 1 | inv_total(inv, slayer_facemask) < 1
    | inv_total(inv, slayer_nosepeg) < 1 | inv_total(inv, wallbeast_spike_helmet) < 1) {
    mes("You need a black mask, earmuffs, a facemask, a nose peg and a spiny helmet");
    mes("in your inventory to assemble a slayer helmet.");
    return;
}
inv_del(inv, $mask, 1);
inv_del(inv, slayer_earmuffs, 1);
inv_del(inv, slayer_facemask, 1);
inv_del(inv, slayer_nosepeg, 1);
inv_del(inv, wallbeast_spike_helmet, 1);
def_namedobj $helm = slayer_helm;
if ($mask = black_mask_i) {
    $helm = slayer_helm_i;
}
inv_add(inv, $helm, 1);
~objbox($helm, "You combine the items into a slayer helmet.", 250, 0, divide(^objbox_height, 2));

[proc,slayer_helm_part](obj $obj)(boolean)
if ($obj = black_mask | $obj = black_mask_i | $obj = slayer_earmuffs | $obj = slayer_facemask
    | $obj = slayer_nosepeg | $obj = wallbeast_spike_helmet) {
    return(true);
}
return(false);

// Which mask is in the pack, and therefore which helmet comes out. An imbued mask makes an imbued
// helmet; there is no way to assemble one that quietly loses the imbue the player paid for.
[proc,slayer_helm_mask]()(namedobj)
if (inv_total(inv, black_mask_i) > 0) {
    return(black_mask_i);
}
if (inv_total(inv, black_mask) > 0) {
    return(black_mask);
}
return(null);

// iop3 - Check. Both helmets, one body.
[opheld3,slayer_helm_i] @slayer_helm_check;
[opheld3,slayer_helm] @slayer_helm_check;
// Worn, Check is the Worn Equipment tab's option too, as in OSRS (player/scripts/wearop.rs2).
[label,wearop1_slayer_helm_i] @slayer_helm_check;
[label,wearop1_slayer_helm] @slayer_helm_check;

[label,slayer_helm_check]
if (%slayer_count <= 0) {
    mes("You need something new to hunt.");
    return;
}
mes("You're assigned to kill <lowercase(~slayer_taskname)>; only <tostring(%slayer_count)> more to go.");

// iop4 - Disassemble. The imbued helmet gives the IMBUED mask back: the imbue was paid for and
// belongs to the mask, so taking the helmet apart must not quietly spend it.
[opheld4,slayer_helm_i] @slayer_helm_split(black_mask_i);
[opheld4,slayer_helm] @slayer_helm_split(black_mask);

[label,slayer_helm_split](namedobj $mask)
if (inv_freespace(inv) < 4) {
    mes("You need four free inventory spaces to disassemble your slayer helmet.");
    return;
}
inv_delslot(inv, last_slot);
inv_add(inv, $mask, 1);
inv_add(inv, slayer_earmuffs, 1);
inv_add(inv, slayer_facemask, 1);
inv_add(inv, slayer_nosepeg, 1);
inv_add(inv, wallbeast_spike_helmet, 1);
mes("You disassemble your slayer helmet.");

// The earmuffs / nose peg / facemask checks all go through this, so a slayer helmet counts as each.
[proc,slayer_helm_worn]()(boolean)
// slayer_helmet, not slayer_headgear: a bare black mask has no earmuffs, nose peg or facemask in
// it, so it must NOT answer true here even though it does for the melee bonus. Every recoloured
// helmet does, without being named.
def_obj $hat = inv_getobj(worn, ^wearpos_hat);
if ($hat = null) {
    return(false);
}
if (oc_param($hat, slayer_helmet) = true) {
    return(true);
}
return(false);
