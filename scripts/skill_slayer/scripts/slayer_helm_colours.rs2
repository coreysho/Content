// Recolouring a slayer helmet, and what every colour keeps.
//
// GENERATED by tools/genslayerhelm.py from tools/slayerhelmspec.json - do not hand-edit.
//
// OSRS: buy the unlock with Slayer reward points, then use the head on the helmet. The head
// is consumed. Each colour has its own unlock and its own head, and both are checked - an
// unlock without a head does nothing, and a head without the unlock says why.
//
// ONLY 2 OF THE 14 COLOURS HAVE A SOURCE. The rest exist so they can be looked at with
// ::give and get no trigger here at all; the black one becomes real the moment the King
// Black Dragon does. tools/obtainable.py reports them by name rather than being told to
// ignore them.
//
// A SCROLL OF IMBUING WORKS ON EVERY COLOUR, and costs this file no trigger: the pairing
// is the param=imbue_into / param=imbue_from pair on each obj above, and
// skill_slayer/scripts/imbue_scroll.rs2 is one proc that reads them.
//
// NO COLOUR HAS AN UNCHARGE OP, because no slayer helmet in the OSRS cache has one - all
// twenty-six are Wear / Check / Disassemble. Getting a scroll back out of a helmet is
// Disassemble, which hands back the imbued black mask, and then Uncharge on the mask.
//
// THE IMBUE SURVIVES THE RECOLOUR IN BOTH DIRECTIONS. An imbued helmet recoloured stays
// imbued, which is what the paired _i variants are for. Nothing here can turn an imbued
// helmet into a plain one, because the player paid for it.

// ---- green: Kq head, unlocked with Kalphite Khat
[opheldu,kq_head] @slayer_recolour_green;

[label,slayer_recolour_green]
if (~slayer_helm_recolour_pair(kq_head) = false) {
    ~displaymessage(^dm_default);
    return;
}
if (~slayer_has_unlock(6) = false) {
    mes("You need the Kalphite Khat unlock from a Slayer master to do that.");
    return;
}
def_namedobj $into = slayer_helm_green;
if (inv_total(inv, slayer_helm_i) > 0) {
    $into = slayer_helm_green_i;
}
inv_del(inv, kq_head, 1);
if (inv_total(inv, slayer_helm_i) > 0) {
    inv_del(inv, slayer_helm_i, 1);
} else {
    inv_del(inv, slayer_helm, 1);
}
inv_add(inv, $into, 1);
~objbox($into, "You fix the kq head onto your slayer helmet.", 250, 0, 0);

// ---- red: abyssal head, unlocked with Unholy Helmet
[opheldu,abyssal_head] @slayer_recolour_red;

[label,slayer_recolour_red]
if (~slayer_helm_recolour_pair(abyssal_head) = false) {
    ~displaymessage(^dm_default);
    return;
}
if (~slayer_has_unlock(5) = false) {
    mes("You need the Unholy Helmet unlock from a Slayer master to do that.");
    return;
}
def_namedobj $into = slayer_helm_red;
if (inv_total(inv, slayer_helm_i) > 0) {
    $into = slayer_helm_red_i;
}
inv_del(inv, abyssal_head, 1);
if (inv_total(inv, slayer_helm_i) > 0) {
    inv_del(inv, slayer_helm_i, 1);
} else {
    inv_del(inv, slayer_helm, 1);
}
inv_add(inv, $into, 1);
~objbox($into, "You fix the abyssal head onto your slayer helmet.", 250, 0, 0);

// The two halves of the use, either way round: a head and a helmet of some kind.
[proc,slayer_helm_recolour_pair](namedobj $head)(boolean)
if (inv_total(inv, $head) < 1) {
    return(false);
}
if (inv_total(inv, slayer_helm) > 0 | inv_total(inv, slayer_helm_i) > 0) {
    return(true);
}
return(false);

// Check and Disassemble, for every colour. A colour WITH a head gives it back on
// disassembly - taking the helmet apart does not destroy it, the same way the five parts
// survive. A colour with no head gives back five things, not six.

[opheld3,slayer_helm_black] @slayer_helm_check;
[opheld3,slayer_helm_black_i] @slayer_helm_check;
[opheld3,slayer_helm_green] @slayer_helm_check;
[opheld3,slayer_helm_green_i] @slayer_helm_check;
[opheld3,slayer_helm_red] @slayer_helm_check;
[opheld3,slayer_helm_red_i] @slayer_helm_check;
[opheld3,slayer_helm_purple] @slayer_helm_check;
[opheld3,slayer_helm_purple_i] @slayer_helm_check;
[opheld3,slayer_helm_turquoise] @slayer_helm_check;
[opheld3,slayer_helm_turquoise_i] @slayer_helm_check;
[opheld3,slayer_helm_hydra] @slayer_helm_check;
[opheld3,slayer_helm_hydra_i] @slayer_helm_check;
[opheld3,slayer_helm_twisted] @slayer_helm_check;
[opheld3,slayer_helm_twisted_i] @slayer_helm_check;
[opheld3,slayer_helm_tztok] @slayer_helm_check;
[opheld3,slayer_helm_tztok_i] @slayer_helm_check;
[opheld3,slayer_helm_vampyric] @slayer_helm_check;
[opheld3,slayer_helm_vampyric_i] @slayer_helm_check;
[opheld3,slayer_helm_tzkal] @slayer_helm_check;
[opheld3,slayer_helm_tzkal_i] @slayer_helm_check;
[opheld3,slayer_helm_araxyte] @slayer_helm_check;
[opheld3,slayer_helm_araxyte_i] @slayer_helm_check;
[opheld3,slayer_helm_hooded] @slayer_helm_check;
[opheld3,slayer_helm_hooded_i] @slayer_helm_check;
[opheld3,slayer_helm_oathplate] @slayer_helm_check;
[opheld3,slayer_helm_oathplate_i] @slayer_helm_check;
[opheld3,slayer_helm_radiant] @slayer_helm_check;
[opheld3,slayer_helm_radiant_i] @slayer_helm_check;

[opheld4,slayer_helm_black] @slayer_helm_split_headless(black_mask);
[opheld4,slayer_helm_black_i] @slayer_helm_split_headless(black_mask_i);
[opheld4,slayer_helm_green] @slayer_helm_split_coloured(black_mask, kq_head);
[opheld4,slayer_helm_green_i] @slayer_helm_split_coloured(black_mask_i, kq_head);
[opheld4,slayer_helm_red] @slayer_helm_split_coloured(black_mask, abyssal_head);
[opheld4,slayer_helm_red_i] @slayer_helm_split_coloured(black_mask_i, abyssal_head);
[opheld4,slayer_helm_purple] @slayer_helm_split_headless(black_mask);
[opheld4,slayer_helm_purple_i] @slayer_helm_split_headless(black_mask_i);
[opheld4,slayer_helm_turquoise] @slayer_helm_split_headless(black_mask);
[opheld4,slayer_helm_turquoise_i] @slayer_helm_split_headless(black_mask_i);
[opheld4,slayer_helm_hydra] @slayer_helm_split_headless(black_mask);
[opheld4,slayer_helm_hydra_i] @slayer_helm_split_headless(black_mask_i);
[opheld4,slayer_helm_twisted] @slayer_helm_split_headless(black_mask);
[opheld4,slayer_helm_twisted_i] @slayer_helm_split_headless(black_mask_i);
[opheld4,slayer_helm_tztok] @slayer_helm_split_headless(black_mask);
[opheld4,slayer_helm_tztok_i] @slayer_helm_split_headless(black_mask_i);
[opheld4,slayer_helm_vampyric] @slayer_helm_split_headless(black_mask);
[opheld4,slayer_helm_vampyric_i] @slayer_helm_split_headless(black_mask_i);
[opheld4,slayer_helm_tzkal] @slayer_helm_split_headless(black_mask);
[opheld4,slayer_helm_tzkal_i] @slayer_helm_split_headless(black_mask_i);
[opheld4,slayer_helm_araxyte] @slayer_helm_split_headless(black_mask);
[opheld4,slayer_helm_araxyte_i] @slayer_helm_split_headless(black_mask_i);
[opheld4,slayer_helm_hooded] @slayer_helm_split_headless(black_mask);
[opheld4,slayer_helm_hooded_i] @slayer_helm_split_headless(black_mask_i);
[opheld4,slayer_helm_oathplate] @slayer_helm_split_headless(black_mask);
[opheld4,slayer_helm_oathplate_i] @slayer_helm_split_headless(black_mask_i);
[opheld4,slayer_helm_radiant] @slayer_helm_split_headless(black_mask);
[opheld4,slayer_helm_radiant_i] @slayer_helm_split_headless(black_mask_i);

[label,slayer_helm_split_coloured](namedobj $mask, namedobj $head)
if (inv_freespace(inv) < 5) {
    mes("You need five free inventory spaces to disassemble your slayer helmet.");
    return;
}
inv_delslot(inv, last_slot);
~slayer_helm_give_parts($mask);
inv_add(inv, $head, 1);
mes("You disassemble your slayer helmet.");

// A colour nothing in the game can make yet: there is no head to hand back.
[label,slayer_helm_split_headless](namedobj $mask)
if (inv_freespace(inv) < 4) {
    mes("You need four free inventory spaces to disassemble your slayer helmet.");
    return;
}
inv_delslot(inv, last_slot);
~slayer_helm_give_parts($mask);
mes("You disassemble your slayer helmet.");

[proc,slayer_helm_give_parts](namedobj $mask)
inv_add(inv, $mask, 1);
inv_add(inv, slayer_earmuffs, 1);
inv_add(inv, slayer_facemask, 1);
inv_add(inv, slayer_nosepeg, 1);
inv_add(inv, wallbeast_spike_helmet, 1);
