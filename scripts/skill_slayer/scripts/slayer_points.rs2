// Slayer points, the way OSRS does them (oldschool.runescape.wiki/w/Slayer_reward_point):
//   - every finished task adds to %slayer_streak and pays points by the master who gave it:
//     Turael 0, Mazchna 6, Vannaka 8, Chaeldar 10, Duradel 15 (current OSRS values);
//   - the first four tasks pay nothing; every 10th task pays 5x, 50th 15x, 100th 25x, 250th 35x,
//     1000th 50x;
//   - Turael swapping out a task you already have resets the streak (slayer_master.rs2).
// Spent with any master ("I'd like to spend my Slayer points." - unlocks, extends and items are in
// slayer_rewards.rs2):
//   - cancel the current task, 30 points (the streak is kept);
//   - block the current task, 100 points - it is cancelled and never assigned again until unblocked.
//     One block slot, plus one per 50 quest points (4 at this server's 152);
//   - unblock, free (OSRS does not refund the points either).
// 2006 had none of this - it arrived in 2007 - but it is what players expect of Slayer now.

[proc,slayer_task_points]()(int)
if (%slayer_streak < 5) {
    return(0);
}
def_int $master = %slayer_task_master;
if ($master = 0) {
    // a task given before points existed: pay as the master the player would use today
    switch_npc (~get_best_slayer_master) {
        case slayer_master_2 : $master = 2;
        case slayer_master_3 : $master = 3;
        case slayer_master_4 : $master = 4;
        case slayer_master_5 : $master = 5;
        case default : $master = 1;
    }
}
def_int $base = 0;
switch_int ($master) {
    case 2 : $base = 6;
    case 3 : $base = 8;
    case 4 : $base = 10;
    case 5 : $base = 15;
}
if (modulo(%slayer_streak, 1000) = 0) {
    return(multiply($base, 50));
}
if (modulo(%slayer_streak, 250) = 0) {
    return(multiply($base, 35));
}
if (modulo(%slayer_streak, 100) = 0) {
    return(multiply($base, 25));
}
if (modulo(%slayer_streak, 50) = 0) {
    return(multiply($base, 15));
}
if (modulo(%slayer_streak, 10) = 0) {
    return(multiply($base, 5));
}
return($base);

[proc,slayer_is_blocked](int $target)(boolean)
if ($target <= 0) {
    return(false);
}
if (%slayer_block1 = $target | %slayer_block2 = $target | %slayer_block3 = $target | %slayer_block4 = $target) {
    return(true);
}
return(false);

[proc,slayer_block_slots]()(int)
return(min(4, add(1, divide(%qp, 50))));

[proc,slayer_block_name](int $slot, int $target)(string)
if ($slot > ~slayer_block_slots) {
    return("(locked - <tostring(multiply(sub($slot, 1), 50))> quest points)");
}
if ($target <= 0) {
    return("(empty)");
}
return(enum(int, string, task_name, $target));

// The Tasks tab of the Slayer Rewards window: row 0 cancels, row 1 blocks, rows 2-5 unblock a
// slot. The window has already checked the points; these check the things only they know about -
// that there IS a task, that a slot is free, that a slot has something in it - and report with
// mes(), because the window is on screen while they run.

[proc,slayer_do_task](int $row)(boolean)
if ($row = 0) {
    return(~slayer_do_cancel);
}
if ($row = 1) {
    return(~slayer_do_block);
}
return(~slayer_do_unblock(sub($row, 1)));

[proc,slayer_do_cancel]()(boolean)
if (%slayer_count <= 0) {
    mes("You don't have a task to cancel.");
    return(false);
}
%slayer_points = sub(%slayer_points, ^slayer_cancel_cost);
%slayer_count = 0;
mes("Your <lowercase(~slayer_taskname)> task is cancelled. Your streak is untouched.");
return(true);

[proc,slayer_do_block]()(boolean)
if (%slayer_count <= 0) {
    mes("You need a task before you can block it.");
    return(false);
}
def_int $target = %slayer_target;
def_int $slots = ~slayer_block_slots;
if (%slayer_block1 = 0) {
    %slayer_block1 = $target;
} else if (%slayer_block2 = 0 & $slots >= 2) {
    %slayer_block2 = $target;
} else if (%slayer_block3 = 0 & $slots >= 3) {
    %slayer_block3 = $target;
} else if (%slayer_block4 = 0 & $slots >= 4) {
    %slayer_block4 = $target;
} else {
    mes("You have no free block slot. Unblock one, or earn more quest points for another.");
    return(false);
}
%slayer_points = sub(%slayer_points, ^slayer_block_cost);
%slayer_count = 0;
mes("<~slayer_taskname> are blocked. No master will assign them until you unblock them.");
return(true);

// Unblocking is free, as in OSRS - and OSRS does not refund the points either.
[proc,slayer_do_unblock](int $slot)(boolean)
if ($slot > ~slayer_block_slots) {
    mes("That slot isn't open yet. It takes <tostring(multiply(sub($slot, 1), 50))> quest points.");
    return(false);
}
def_int $target = ~slayer_ui_block_target($slot);
if ($target <= 0) {
    mes("There's nothing blocked there.");
    return(false);
}
switch_int ($slot) {
    case 1 : %slayer_block1 = 0;
    case 2 : %slayer_block2 = 0;
    case 3 : %slayer_block3 = 0;
    case 4 : %slayer_block4 = 0;
}
mes("<enum(int, string, task_name, $target)> can be assigned to you again.");
return(true);
