// Black mask (and slayer helmet) - the on-task combat bonus, plain and imbued.
//
// 7/6 (16.67%) to both the melee accuracy roll and max hit against monsters on the player's
// current slayer task. Melee only for the PLAIN mask: it does nothing for ranged or magic, which
// is correct for the item in every revision.
//
// THE IMBUED PAIR ADD RANGED AND MAGIC, 23/20 (15%) to accuracy and damage alike, and that is the
// entire reason to buy the imbue. Melee is unchanged at 7/6 - the imbue does not stack on top of
// the melee bonus, it extends the same idea to the other two styles, which is what OSRS does.
//
// "On task" is npc_param(slayer_category) = %slayer_target with %slayer_count still above zero -
// deliberately the SAME pair of values npc_death.rs2 passes to ~check_progress_task, so the set of
// monsters the mask boosts can never drift from the set that counts towards the task.
//
// %slayer_target is 0 with no task assigned and slayer categories start at 1, so the > 0 guard
// also covers npcs whose slayer_category param is unset.

[proc,black_mask_on_task]()(boolean)
if (%slayer_target <= 0 | %slayer_count <= 0) {
    return(false);
}
if (npc_param(slayer_category) ! %slayer_target) {
    return(false);
}
// THE ITEM SAYS WHAT IT IS. This used to be a list of names, and the list grew by two every time
// a colour was added - four when the imbues arrived, eight with the red and green recolours, and
// ten more waiting behind the bosses OSRS recolours from. slayer_headgear is on both masks and
// every helmet (configs/slayer_helm.param, written by tools/genslayerhelm.py), so a new colour
// needs no edit here at all.
def_obj $hat = inv_getobj(worn, ^wearpos_hat);
if ($hat = null) {
    return(false);
}
if (oc_param($hat, slayer_headgear) = true) {
    return(true);
}
return(false);

// The imbued half. Same "on task" test - it calls the proc above rather than repeating it, so the
// set of monsters the ranged and magic boost applies to can never drift from the melee one - and
// then asks whether what is worn is one of the two imbued pieces.
//
// Read by player_ranged.rs2 and player_magic.rs2, which used the unboosted hit roll until now.
[proc,black_mask_imbued_on_task]()(boolean)
if (~black_mask_on_task = false) {
    return(false);
}
def_obj $hat = inv_getobj(worn, ^wearpos_hat);
if ($hat = null) {
    return(false);
}
if (oc_param($hat, slayer_imbued) = true) {
    return(true);
}
return(false);
