// The whole window, repainted. $sel is -1 for nothing selected.
[proc,slayer_ui_draw](int $tab, int $sel)
if_settext(slayer_rewards:subtitle, "<~slayer_ui_points_text>");
if_settext(slayer_rewards:tab0, "<~slayer_ui_tabtint($tab, 0)>Unlock");
if_setcolour(slayer_rewards:tab0fill, ~slayer_ui_tab_fill($tab, 0));
if_settext(slayer_rewards:tab1, "<~slayer_ui_tabtint($tab, 1)>Extend");
if_setcolour(slayer_rewards:tab1fill, ~slayer_ui_tab_fill($tab, 1));
if_settext(slayer_rewards:tab2, "<~slayer_ui_tabtint($tab, 2)>Buy");
if_setcolour(slayer_rewards:tab2fill, ~slayer_ui_tab_fill($tab, 2));
if_settext(slayer_rewards:tab3, "<~slayer_ui_tabtint($tab, 3)>Tasks");
if_setcolour(slayer_rewards:tab3fill, ~slayer_ui_tab_fill($tab, 3));
if_settext(slayer_rewards:tab4, "<~slayer_ui_tabtint($tab, 4)>Cosmetics");
if_setcolour(slayer_rewards:tab4fill, ~slayer_ui_tab_fill($tab, 4));
~slayer_ui_row0($tab, 0, $sel);
~slayer_ui_row1($tab, 1, $sel);
~slayer_ui_row2($tab, 2, $sel);
~slayer_ui_row3($tab, 3, $sel);
~slayer_ui_row4($tab, 4, $sel);
~slayer_ui_row5($tab, 5, $sel);
~slayer_ui_row6($tab, 6, $sel);
~slayer_ui_row7($tab, 7, $sel);
~slayer_ui_row8($tab, 8, $sel);
~slayer_ui_row9($tab, 9, $sel);
~slayer_ui_row10($tab, 10, $sel);
if_settext(slayer_rewards:desc0, "<~slayer_ui_desc($tab, $sel, 0)>");
if_settext(slayer_rewards:desc1, "<~slayer_ui_desc($tab, $sel, 1)>");
if_settext(slayer_rewards:desc2, "<~slayer_ui_desc($tab, $sel, 2)>");

// Every button the window can answer with, added after the draw.
[proc,slayer_ui_buttons](int $tab)
if_addresumebutton(slayer_rewards:tab0);
if_addresumebutton(slayer_rewards:tab1);
if_addresumebutton(slayer_rewards:tab2);
if_addresumebutton(slayer_rewards:tab3);
if_addresumebutton(slayer_rewards:tab4);
def_int $i = 0;
while ($i < ~slayer_ui_count($tab)) {
    ~slayer_ui_rowbutton($i);
    $i = calc($i + 1);
}
if_addresumebutton(slayer_rewards:back);
if_addresumebutton(slayer_rewards:confirm);

// A resume button per row, by index. switch_int rather than eleven ifs so an unused
// row costs one comparison.
[proc,slayer_ui_rowbutton](int $i)
switch_int ($i) {
    case 0 : if_addresumebutton(slayer_rewards:r0box);
    case 1 : if_addresumebutton(slayer_rewards:r1box);
    case 2 : if_addresumebutton(slayer_rewards:r2box);
    case 3 : if_addresumebutton(slayer_rewards:r3box);
    case 4 : if_addresumebutton(slayer_rewards:r4box);
    case 5 : if_addresumebutton(slayer_rewards:r5box);
    case 6 : if_addresumebutton(slayer_rewards:r6box);
    case 7 : if_addresumebutton(slayer_rewards:r7box);
    case 8 : if_addresumebutton(slayer_rewards:r8box);
    case 9 : if_addresumebutton(slayer_rewards:r9box);
    case 10 : if_addresumebutton(slayer_rewards:r10box);
}

// Which row was clicked, or -1. The window reads last_com once and asks this.
[proc,slayer_ui_clicked_row]()(int)
switch_component (last_com) {
    case slayer_rewards:r0box : return(0);
    case slayer_rewards:r1box : return(1);
    case slayer_rewards:r2box : return(2);
    case slayer_rewards:r3box : return(3);
    case slayer_rewards:r4box : return(4);
    case slayer_rewards:r5box : return(5);
    case slayer_rewards:r6box : return(6);
    case slayer_rewards:r7box : return(7);
    case slayer_rewards:r8box : return(8);
    case slayer_rewards:r9box : return(9);
    case slayer_rewards:r10box : return(10);
}
return(-1);

// Which tab was clicked, or -1.
[proc,slayer_ui_clicked_tab]()(int)
switch_component (last_com) {
    case slayer_rewards:tab0 : return(0);
    case slayer_rewards:tab1 : return(1);
    case slayer_rewards:tab2 : return(2);
    case slayer_rewards:tab3 : return(3);
    case slayer_rewards:tab4 : return(4);
}
return(-1);
