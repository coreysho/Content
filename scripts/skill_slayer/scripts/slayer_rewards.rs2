// Slayer point rewards, spent through the Slayer Rewards WINDOW (slayer_window.rs2 and the
// generated slayer_ui.rs2 / slayer_rewards.if). This file holds what each reward costs and what
// buying one does; the window is only a way in.
//
// Names and prices follow the OSRS Slayer Rewards page, limited to what exists in this build:
//   Unlock     Bigger and Badder 50 (superiors.rs2), Gargoyle Smasher 120, Slug Salter 10,
//              Reptile Freezer 10, Ring Bling 150
//   Extend     eleven tasks (configs/slayer_rewards.enum) - longer tasks from Chaeldar and Duradel
//   Buy        Slayer ring (8) 75, Herb sack 750, Looting bag 10, and the imbue at
//              ^slayer_imbue_cost, which is a service rather than an item
//   Tasks      cancel 30, block 100, unblock free (slayer_points.rs2)
//   Cosmetics  Unholy Helmet 1,000 and Kalphite Khat 1,000 - the helmet recolours, which OSRS also
//              keeps in a tab of their own (slayer_helm_colours.rs2 reads their bits)
// Not here because the thing they work on is missing: 'Shroom Sprayer (zygomite tasks are never
// assigned), Broader Fletching, the boss/TzHaar/lizardman task unlocks, broad bolts and arrows, and
// the rune pouch. Seeing Red is left out on purpose: red dragon tasks were never locked here, and
// selling that back would take them away.
//
// NOTHING HERE PRINTS A DIALOGUE. The window is on screen while these run, so they report with
// mes() - an npc talking over the top of its own window is what the chat menu used to do.

[proc,slayer_has_unlock](int $bit)(boolean)
if (testbit(%slayer_unlocks, $bit) = ^true) {
    return(true);
}
return(false);

[proc,slayer_has_extend](int $index)(boolean)
if (testbit(%slayer_extends, $index) = ^true) {
    return(true);
}
return(false);

// Buying. Each of these is reached only through ~slayer_ui_take, which has already checked that the
// row is not owned and that the points are there - so each one spends and does the thing.
[proc,slayer_buy_unlock](int $i)(boolean)
%slayer_points = sub(%slayer_points, enum(int, int, slayer_unlock_cost, $i));
%slayer_unlocks = setbit(%slayer_unlocks, enum(int, int, slayer_unlock_bit, $i));
mes("You unlock <enum(int, string, slayer_unlock_name, $i)>. <tostring(%slayer_points)> points left.");
return(true);

// The Cosmetics tab is unlocks too - same bits, same currency, different tab, because that is where
// OSRS keeps the helmet recolours. What the unlock then lets you do is in slayer_helm_colours.rs2.
[proc,slayer_buy_cosmetic](int $i)(boolean)
%slayer_points = sub(%slayer_points, enum(int, int, slayer_cosmetic_cost, $i));
%slayer_unlocks = setbit(%slayer_unlocks, enum(int, int, slayer_cosmetic_bit, $i));
mes("You unlock <enum(int, string, slayer_cosmetic_name, $i)>. <tostring(%slayer_points)> points left.");
return(true);

[proc,slayer_buy_extend](int $i)(boolean)
%slayer_points = sub(%slayer_points, enum(int, int, slayer_extend_cost, $i));
%slayer_extends = setbit(%slayer_extends, $i);
mes("Your <enum(int, string, slayer_extend_monster, $i)> tasks will be longer from now on. <tostring(%slayer_points)> points left.");
return(true);

// The Buy tab. Row 3 is the imbue, which hands over no item and so has no obj: ^slayer_buy_imbue is
// the row it sits in.
[proc,slayer_buy_item](int $i)(boolean)
if ($i = ^slayer_buy_imbue) {
    return(~slayer_do_imbue);
}
def_namedobj $item = enum(int, namedobj, slayer_buy_obj, $i);
if (inv_freespace(inv) < 1) {
    mes("You need a free inventory space for that.");
    return(false);
}
%slayer_points = sub(%slayer_points, enum(int, int, slayer_buy_cost, $i));
inv_add(inv, $item, 1);
mes("You buy <~add_article(lowercase(oc_name($item)))>. <tostring(%slayer_points)> points left.");
return(true);

// THE IMBUE, as a proc rather than the label it was.
//
// OSRS imbues a black mask in the Nightmare Zone for 1,250,000 NMZ points, at Soul Wars for 500
// Zeal tokens, or in Emir's Arena with a Scroll of Imbuing. None of those three exists in a 2006
// build, so this is a slayer master service and ^slayer_imbue_cost is the one invented number in
// it - see the note beside the constant.
//
// The imbue is a property of the MASK: a helmet is imbued by imbuing its mask, or directly if it is
// already assembled, and taking a helmet apart hands back whichever mask went in.
//
// A SECOND IMBUE IS ALLOWED, as in OSRS. The chat version warned "you've already got one of those
// imbued" and then imbued and charged anyway - the branch had no return - so the message only ever
// misled. Carrying a second plain mask and paying again is a fair thing to want, so it is silent.
[proc,slayer_do_imbue]()(boolean)
def_namedobj $from = null;
def_namedobj $to = null;
if (inv_total(inv, black_mask) > 0) {
    $from = black_mask;
    $to = black_mask_i;
} else if (inv_total(inv, slayer_helm) > 0) {
    $from = slayer_helm;
    $to = slayer_helm_i;
} else {
    mes("You need a black mask or a slayer helmet with you to imbue.");
    return(false);
}
%slayer_points = sub(%slayer_points, ^slayer_imbue_cost);
inv_del(inv, $from, 1);
inv_add(inv, $to, 1);
mes("You imbue your <lowercase(oc_name($from))>. <tostring(%slayer_points)> points left.");
return(true);

// Called after every assignment (slayer_task.rs2). Only Chaeldar and Duradel give extended tasks,
// as their lengths are what the OSRS ranges are written against.
[proc,slayer_apply_extend]
if (%slayer_task_master < 4) {
    return;
}
def_int $ext = enum(int, int, slayer_task_extend, %slayer_target);
if ($ext <= 0) {
    return;
}
def_int $index = sub($ext, 1);
if (~slayer_has_extend($index) = false) {
    return;
}
%slayer_count = ~random_range(enum(int, int, slayer_extend_min, $index), enum(int, int, slayer_extend_max, $index));

// ---- automatic finishing blows (called from each monster's ai_queue3) ----

// Returns true if the player who brought the monster down has the unlock and the item, in which case
// the caller lets it die instead of healing it. $use: the item is used up (salt, icy water).
[proc,slayer_autofinish](int $bit, namedobj $item, boolean $use, string $message)(boolean)
if (finduid(%npc_aggressive_player) = false) {
    return(false);
}
if (testbit(%slayer_unlocks, $bit) = ^false | inv_total(inv, $item) < 1) {
    return(false);
}
if ($use = true) {
    queue*(slayer_autofinish_use, 0)($item);
}
mes($message);
return(true);

[queue,slayer_autofinish_use](namedobj $item)
inv_del(inv, $item, 1);

// ---- Slayer ring ----

[opheld1,_slayer_ring] @slayer_ring_rub;
[opheld3,_slayer_ring] @slayer_ring_check;

[label,slayer_ring_check]
if (%slayer_count <= 0) {
    mes("You need something new to hunt.");
} else {
    mes("You're assigned to kill <lowercase(~slayer_taskname)>; only <tostring(%slayer_count)> more to go.");
}
mes("You have <tostring(%slayer_points)> Slayer points and a streak of <tostring(%slayer_streak)> tasks.");

[label,slayer_ring_rub]
def_obj $ring = last_item;
def_int $slot = last_slot;
mes("You rub the ring...");
def_int $choice = ~p_choice3_header("Slayer Tower.", 1, "Fremennik Slayer Dungeon.", 2, "Nowhere.", 3, "Where would you like to teleport to?");
if ($choice ! 1 & $choice ! 2) {
    mes("You remain where you were.");
    return;
}
if (~wilderness_level(coord) > 30) {
    mes("A mysterious force blocks your teleport.");
    mes("You can't use this teleport after level 30 wilderness.");
    return;
}
if (~pre_tele_checks(coord) = false) {
    return;
}
if (inv_getobj(inv, $slot) ! $ring) {
    return;
}
def_namedobj $next = oc_param($ring, slayer_ring_next);
if ($next = null) {
    inv_delslot(inv, $slot);
    mes("Your Slayer ring crumbles to dust.");
} else {
    inv_setslot(inv, $slot, $next, 1);
}
if ($choice = 1) {
    ~player_teleport_normal(0_53_55_36_4);
} else {
    ~player_teleport_normal(0_43_56_44_31);
}

// Ring Bling: enchanted gem on a furnace, with a gold bar and ring mould (smelting.rs2 routes here)
[label,slayer_craft_ring]
if (~slayer_has_unlock(3) = false) {
    mes("You don't know how to make that. A Slayer master could teach you.");
    return;
}
if (stat(crafting) < 75) {
    mes("You need a Crafting level of 75 to make a Slayer ring.");
    return;
}
if (inv_total(inv, ring_mould) < 1 | inv_total(inv, gold_bar) < 1) {
    mes("You need a ring mould and a gold bar to make a Slayer ring.");
    return;
}
p_arrivedelay;
anim(human_furnace, 0);
p_delay(2);
if (inv_total(inv, slayer_gem) < 1 | inv_total(inv, gold_bar) < 1) {
    return;
}
inv_del(inv, slayer_gem, 1);
inv_del(inv, gold_bar, 1);
inv_add(inv, slayer_ring_8, 1);
stat_advance(crafting, 150);
mes("You make a Slayer ring.");
