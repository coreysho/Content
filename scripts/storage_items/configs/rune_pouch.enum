// Every rune the pouch will hold, in the order Check lists them.
//
// The thirteen a spell in this repo can ask for, then the six combination runes. Battery group 3
// reads magic_spells.dbrow and magic_combat_spells.dbrow and fails if a spell needs a rune that is
// not in here - so a new spell cannot quietly arrive with a rune the pouch refuses.
[rune_pouch_runes]
inputtype=int
outputtype=namedobj
default=null
val=0,airrune
val=1,waterrune
val=2,earthrune
val=3,firerune
val=4,mindrune
val=5,bodyrune
val=6,chaosrune
val=7,deathrune
val=8,naturerune
val=9,lawrune
val=10,cosmicrune
val=11,bloodrune
val=12,soulrune
val=13,mistrune
val=14,dustrune
val=15,mudrune
val=16,smokerune
val=17,steamrune
val=18,lavarune
