// The Thread of Elidinis. Model and 2d camera imported from the OSRS cache by
// tools/models/importosrs.py and rendered before it was kept: a bobbin with wooden ends and the
// thread wound between them, which is what it should be.
//
// The import's single recolour pair matches no face on the converted mesh - the same as the filled
// compost bucket's - so it is dropped rather than carried as a no-op.
//
// Untradeable, as in OSRS. It is not obtainable here: OSRS gives it out at the Tombs of Amascut,
// which this server has no content for, so it is declared sourceless in tools/nosourcespec.json
// rather than given an invented source. The recipe it is FOR works, and ::give hands one out.

[thread_of_elidinis]
name=Thread of Elidinis
desc=A spool of thread that gives off a divine energy.
model=obj_thread_of_elidinis
2dzoom=590
2dxan=248
2dyan=1644
2dxof=2
weight=3g
cost=14000
members=yes
tradeable=no
iop5=Destroy
