// Herb sack, seed box and looting bag contents - saved with the character (scope=perm).
// See storage_items/scripts/storage_items.rs2.

// 14 grimy herb kinds, up to 30 of each (enforced in script); herbs stack inside the sack.
[herb_sack_store]
scope=perm
size=14
stackall=yes
protect=no

// Up to 6 kinds of seed, any number of each.
[seed_box_store]
scope=perm
size=6
protect=no

// 28 slots, exactly like the inventory.
[looting_bag_store]
scope=perm
size=28
protect=no
