// Herb sack, seed box and looting bag contents - saved with the character (scope=perm).
// See storage_items/scripts/storage_items.rs2.

// 14 grimy herb kinds, up to 30 of each (enforced in script); herbs stack inside the sack.
[herb_sack_store]
scope=perm
size=14
stackall=yes
protect=no

// Up to 6 kinds of seed, any number of each.
[seed_box_store]
scope=perm
size=6
protect=no

// 28 slots, exactly like the inventory.
[looting_bag_store]
scope=perm
size=28
protect=no

// The rune pouch. FOUR slots even though the plain pouch can only reach three: the pouch item's
// own param says how many are reachable (see rune_pouch.obj), so upgrading to the divine pouch
// moves nothing and downgrading cannot spill a rune - the revert simply refuses while a fourth
// kind is inside. stackall so 16,000 of a rune is one slot.
[rune_pouch_store]
scope=perm
size=4
stackall=yes
protect=no
