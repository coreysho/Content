// The rune pouch and its upgrade. Models and 2d cameras imported from the OSRS cache by
// tools/models/importosrs.py; everything below the camera is by hand.
//
// param=pouch_slots is what makes the upgrade cheap: BOTH pouches share one four-slot store
// (rune_pouch_store in storage_items.inv) and this number says how many of those slots the item
// in your hand can reach. Upgrading therefore moves nothing and can never spill a rune.
//
// Ops follow the seed box rather than OSRS: Fill / Empty / Check / Destroy, with Revert on the
// divine one where OSRS puts Configure. There is no Configure because there is nothing to
// configure - the three (or four) kinds are simply whichever runes you put in.

[rune_pouch]
name=Rune pouch
desc=You can store runes in here.
model=obj_rune_pouch
2dzoom=350
2dxan=512
2dyan=475
2dzan=59
2dxof=-4
weight=1000g
cost=10000
members=yes
tradeable=no
iop1=Fill
iop2=Empty
iop3=Check
iop5=Destroy
param=pouch_slots,3

[divine_rune_pouch]
name=Divine rune pouch
desc=A vessel used to store runes that's been imbued with the powers of Elidinis.
model=obj_divine_rune_pouch
2dzoom=850
2dxan=512
2dyan=475
2dzan=13
2dxof=-13
2dyof=1
weight=878g
cost=20000
members=yes
tradeable=no
iop1=Fill
iop2=Empty
iop3=Check
iop4=Revert
iop5=Destroy
param=pouch_slots,4
