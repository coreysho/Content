// The rune pouch.
//
// 16,000 of each kind, which is OSRS's own cap, and 19 kinds allowed: the thirteen runes a spell
// in this repo can ask for, plus the six combination runes this cache has. Rune essence is not a
// rune and does not go in, as in OSRS.
^rune_pouch_max_per_rune = 16000
^rune_pouch_kinds = 19

// Making the divine pouch: OSRS wants a needle, a Thread of Elidinis and 75 Crafting, and gives no
// experience. The thread is a Tombs of Amascut drop and this server has no content for it, so
// ordinary thread stands in and the rest of the recipe is unchanged.
^rune_pouch_craft_level = 75
