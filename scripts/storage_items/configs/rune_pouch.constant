// The rune pouch.
//
// 16,000 of each kind, which is OSRS's own cap, and 20 kinds allowed: the thirteen runes a spell
// in this repo can ask for, plus the six combination runes this cache has, plus astral. Rune essence is not a
// rune and does not go in, as in OSRS.
^rune_pouch_max_per_rune = 16000
^rune_pouch_kinds = 20

// Making the divine pouch: OSRS wants a needle, a Thread of Elidinis and 75 Crafting, and gives no
// experience. All four are what this does. The thread is a Tombs of Amascut reward and this server
// has no content for it, so the item is imported and declared sourceless in nosourcespec.json -
// ordinary thread used to stand in for it, which made the recipe wrong rather than incomplete.
^rune_pouch_craft_level = 75
