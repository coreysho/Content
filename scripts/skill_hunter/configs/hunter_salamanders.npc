// OSRS npcs imported by tools/models/importosrsnpc.py. Models re-encoded by osrs2ob2.py with
// the npc recolours baked in; stats and level from the cache, the rest by hand.
//
// The net-trap creatures - one model (OSRS 19391) recoloured four ways, with OSRS's own walk and ready
// animations (5262, 5263, converted into hunter_salamanders.seq). No ops, as in the cache: they are
// caught by walking into a net trap, never clicked. Spawns are the OSRS wiki's, per hunter area.

[hunter_swamp_lizard]
// OSRS npc 2906
name=Swamp lizard
model1=npc_hunter_swamp_lizard_1
readyanim=osrs_seq_5263
walkanim=osrs_seq_5262
wanderrange=5
respawnrate=50

