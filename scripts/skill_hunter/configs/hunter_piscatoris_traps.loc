// OSRS locs imported by tools/models/importosrslocs.py (osrslocimport.py).
// Models re-encoded by osrs2ob2.py with the loc recolours baked in.
//
// The Piscatoris catches in the existing trap states: a copper longtail in a bird snare (OSRS 9378
// catching, 9379 caught - the bird is OSRS model 26848, the copper longtail npc's own), and a prickly
// kebbit under a deadfall (OSRS 19218: the kebbit model 19918 is the curled-up spiny one). Imported with
// --no-anim and given the loc seqs the Feldip states already use - OSRS gives these the same ones (5173/
// 5174 for a snare, 5195 for a deadfall). The snare and deadfall frames are byte-identical to Feldip's
// and point at those models. OSRS ships the caught deadfall without an op; Check is added here, as on
// the wild and barb-tailed ones.

[hunter_snare_catching_longtail]
// OSRS loc 9378
name=Bird snare
model=osrsloc_9373
model2=osrsloc_9378_2
blockwalk=no
blockrange=no
active=yes
ambient=20
anim=osrsloc_anim_5173

[hunter_snare_caught_longtail]
// OSRS loc 9379
name=Bird snare
model=osrsloc_9373
model2=osrsloc_9379_2
blockwalk=no
blockrange=no
active=yes
ambient=20
op1=Check
anim=osrsloc_anim_5174

[hunter_deadfall_prickly]
// OSRS loc 19218
name=Deadfall
model=osrsloc_19217
model2=osrsloc_19217_2
model3=osrsloc_19218_3
model4=osrsloc_20131_4
width=2
blockrange=no
mapscene=71
anim=osrsloc_anim_5195
op1=Check
