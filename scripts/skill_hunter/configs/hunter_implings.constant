// PURO-PURO AND THE CROP CIRCLES (scripts/hunter_puro.rs2), IMPLINGS (scripts/hunter_implings.rs2).

// Where you come out of a crop circle in Puro-Puro: the heart of the maze, beside the portal home.
^puro_arrive = 0_40_67_31_30
// Puro-Puro's square, m40_67: the implings' rule (a jar to catch one, no loot on the spot) is "in here".
^puro_sw = 0_40_67_0_0
^puro_ne = 0_40_67_63_63

// The permanent crop circle in Zanaris's wheat field (site 0), and the roaming one's fields in the OSRS
// rotation's order - the ones this build has: Doric's hut and Rimmington (sown for it in June 2007 -
// hunter_crop_fields.loc), then Draynor Village, Lumbridge, Ardougne, south of Varrock and Miscellania,
// whose fields were already there. The rotation's other fields (Yanille and south of the Grand
// Exchange, whose 2007 squares 474 has no key for; the 2021 additions, whose wheat 377 never had; the
// Zeah and Varlamore ones) are not. The centre of each; the circle is the 3x3 round it.
^puro_site_zanaris = 0
^puro_site_zanaris_coord = 0_37_69_59_30
^puro_sites = 7
^puro_site_doric = 1
^puro_site_draynor = 2
^puro_site_rimmington = 3
^puro_site_lumbridge = 4
^puro_site_ardougne = 5
^puro_site_varrock = 6
^puro_site_miscellania = 7

// A roaming crop circle stays fifteen minutes in a field (OSRS: "around 15 minutes"); the Gielinor
// implings are rolled every thirty minutes and roam for as long (Impling#Gielinor); an impling is
// invisible for its first two minutes. In ticks.
^puro_circle_ticks = 1500
^impling_cycle_ticks = 3000
^impling_hidden_ticks = 200
// Farmer's Affinity, in minutes, and what it takes off every push through the wheat, in ticks.
^puro_affinity_minutes = 30
^puro_affinity_ticks = 3
// Level to go through a crop circle (not boostable, as OSRS).
^puro_level = 17
// A jar generator's charge, and what a jar costs (OSRS: 3 an impling jar, 1 a butterfly jar).
^jar_generator_full = 100
^jar_generator_impling_cost = 3
^jar_generator_butterfly_cost = 1
// Elnock's jars: ten a day at 2,000 coins.
^puro_elnock_daily_jars = 10
^puro_elnock_jar_price = 2000
^impling_world_spawns = 31

// An impling's own timer: every ten ticks, one chance in twenty that it blinks a few squares away (the
// wiki: "they can occasionally teleport to a nearby area" - it gives no rate, so this is a guess at
// "occasionally": about once in two minutes).
^impling_escape_ticks = 10
^impling_escape_chance = 20
^puro_shift_tiles = 76
