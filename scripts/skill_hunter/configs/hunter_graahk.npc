// OSRS npc imported by tools/models/importosrsnpc.py. Model re-encoded by osrs2ob2.py with the npc
// recolours baked in; stats and level from the cache, the rest by hand. It shares the spined
// larupia's ready and walk animations (OSRS seqs 5225/5226, hunter_larupia.seq) - the cache gives
// both npcs the same two, and they pose the graahk's mesh cleanly.

[hunter_horned_graahk]
// OSRS npc 2909
name=Horned graahk
desc=Get in a graahk's way and you're going to know about it... however briefly.
model1=npc_hunter_horned_graahk_1
size=2
readyanim=osrs_seq_5225
walkanim=osrs_seq_5226
// One tile, as the larupia: NPCs move naively, and each graahk spawns where it can step all the way to
// its pit's take-off tile (hunter_live.ts checks every one).
wanderrange=1
respawnrate=50
op1=Tease
// Its combat stats are the cache's, and are only its level: it has no Attack op and nothing here
// fights it. Teased, it follows (npc_setmode(playerfollow)) rather than attacks, as the larupia does.
vislevel=50
attack=50
defence=35
strength=50
hitpoints=35
ranged=1
magic=1
