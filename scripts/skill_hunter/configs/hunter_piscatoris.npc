// OSRS npc 5556. Its model is OSRS model 3022 - which is 377's own npc_butterfly, so rather than a
// copy this is that model with OSRS's one recolour (HSL 39029 -> 947, written here as RGB15).
// OSRS's Catch op is left off: every butterfly in this build is caught by using a net on it
// ([opnpcu], see scripts/hunter_butterflies.rs2), and a Catch that did nothing would be a dead click.
[hunter_ruby_harvest]
name=Ruby harvest
desc=It's a ruby harvest butterfly.
model1=npc_butterfly
recol1s=27551
recol1d=24673
readyanim=butterfly_hover
walkanim=butterfly_hover
minimap=no
vislevel=hide
wanderrange=10
