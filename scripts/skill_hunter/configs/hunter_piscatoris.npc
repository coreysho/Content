// OSRS npcs imported by tools/models/importosrsnpc.py. Models re-encoded by osrs2ob2.py with
// the npc recolours baked in; stats and level from the cache, the rest by hand.
//
// The Piscatoris hunter area (scripts/hunter_piscatoris.rs2 and hunter_falconry.rs2): Matthias the
// falconer and his gyr falcons, the three falconry kebbits, the prickly kebbit (deadfalls) and the
// copper longtail (bird snares). Spawns are the OSRS wiki's, in maps m36_55, m36_56, m37_55, m37_56.
// Where a model is byte-identical to one an earlier Hunter round imported (the kebbit body, the
// longtail's wings), the config points at that one rather than carrying a copy.

[hunter_matthias]
// OSRS npc 1340
name=Matthias
desc=He's wearing a single glove; how strange.
model1=npc_hunter_matthias_1
model2=npc_hunter_matthias_2
model3=npc_hunter_matthias_3
model4=npc_hunter_matthias_4
model5=npc_hunter_matthias_5
model6=npc_hunter_matthias_6
model7=npc_hunter_matthias_7
model8=npc_hunter_matthias_8
head1=npc_hunter_matthias_head1
head2=npc_hunter_matthias_head2
readyanim=osrs_seq_5160
walkanim=osrs_seq_5164
resizeh=132
resizev=135
wanderrange=3
op1=Talk-to
// op3=Quick-falcon - OSRS added it in 2015; in 2006 you talked to him.
attack=1
defence=1
strength=1
hitpoints=15
ranged=1
magic=1

// The falcon on its catch: one per kebbit, so Retrieve knows what it is holding. Spawned by
// npc_add where the kebbit was, for as long as the falcon will wait (^falconry_wait).
[hunter_falcon_spotted]
// OSRS npc 1342
name=Gyr Falcon
desc=It looks like it has caught something.
model1=npc_hunter_falcon_spotted_1
readyanim=osrs_seq_5202
walkanim=osrs_seq_5284
resizeh=76
resizev=76
wanderrange=0
op1=Retrieve

[hunter_falcon_dark]
// OSRS npc 1343
name=Gyr Falcon
desc=It looks like it has caught something.
model1=npc_hunter_falcon_spotted_1
