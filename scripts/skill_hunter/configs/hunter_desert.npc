// OSRS npcs imported by tools/models/importosrsnpc.py. Models re-encoded by osrs2ob2.py with
// the npc recolours baked in; stats and level from the cache, the rest by hand.
//
// The desert's Hunter npcs, from the OSRS cache (OpenRS2 #2710): the Uzer hunter area's golden warbler
// and Artimeus, who has kept the Nardah Hunter Shop since Hunter came out (21 November 2006).

[hunter_golden_warbler]
// OSRS npc 5551. Its second model (26844, the wings) is byte-for-byte the crimson swift's, so it
// shares that one rather than importing it twice. Flies on the swift's animations, as in OSRS.
name=Golden warbler
desc=Actually, golden screecher might be a more appropriate name.
model1=npc_hunter_golden_warbler_1
model2=npc_hunter_crimson_swift_2
readyanim=osrs_seq_6771
walkanim=osrs_seq_6773
wanderrange=6
respawnrate=50
attack=35
defence=20
strength=30
hitpoints=40
ranged=1
magic=1

[artimeus]
// OSRS npc 1350. OSRS puts Trade on op5; here it is op3, where [opnpc3,_shop_keeper] opens the shop.
name=Artimeus
desc=He looks like he knows what he's doing.
model1=npc_artimeus_1
model2=npc_artimeus_2
model3=npc_artimeus_3
model4=npc_artimeus_4
model5=npc_artimeus_5
model6=npc_artimeus_6
model7=npc_artimeus_7
model8=npc_artimeus_8
head1=npc_artimeus_head1
head2=npc_artimeus_head2
head3=npc_artimeus_head3
readyanim=human_ready
walkanim=human_walk_f,human_walk_b,human_walk_l,human_walk_r
wanderrange=2
op1=Talk-to
op3=Trade
category=shop_keeper
param=owned_shop,nardah_hunter_shop
param=shop_sell_multiplier,1000
param=shop_buy_multiplier,550
param=shop_delta,20
param=shop_title,Nardah Hunter Shop
