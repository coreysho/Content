// OSRS locs imported by tools/models/importosrslocs.py (osrslocimport.py).
// The pitfall's states, set over the 474 map's own Pit (loc474_19227) with loc_change. All three
// share OSRS's one pit model - a dark hole - so a spiked pit and a collapsed one look alike, as in
// the cache; the larupia's state adds the animal.
// Models re-encoded by osrs2ob2.py with the loc recolours baked in.

[hunter_pit_spiked]
// OSRS loc 19228
name=Spiked pit
model=osrsloc_19228
active=yes
shadow=no
ambient=0
contrast=0
op1=Jump
op2=Dismantle

[hunter_pit_collapsed]
// OSRS loc 19230
name=Collapsed trap
model=osrsloc_19230
active=yes
shadow=no
ambient=0
contrast=0
op2=Dismantle

[hunter_pit_larupia]
// OSRS loc 19232
name=Collapsed trap
model=osrsloc_19232
model2=osrsloc_19232_2
active=yes
ambient=12
contrast=60
op2=Dismantle
