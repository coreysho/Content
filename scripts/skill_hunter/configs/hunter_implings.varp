// IMPLINGS AND PURO-PURO (scripts/hunter_implings.rs2, hunter_puro.rs2).

// Implings caught, by kind and by place, for the butterfly net's Check totals (OSRS's impling tracker):
// eleven perm varps, each two 16-bit counters (configs/hunter_implings.varbit) - Gielinor low, Puro-Puro high.
[impling_caught_baby]
type=int
scope=perm
protect=no

[impling_caught_young]
type=int
scope=perm
protect=no

[impling_caught_gourmet]
type=int
scope=perm
protect=no

[impling_caught_earth]
type=int
scope=perm
protect=no

[impling_caught_essence]
type=int
scope=perm
protect=no

[impling_caught_eclectic]
type=int
scope=perm
protect=no

[impling_caught_nature]
type=int
scope=perm
protect=no

[impling_caught_magpie]
type=int
scope=perm
protect=no

[impling_caught_ninja]
type=int
scope=perm
protect=no

[impling_caught_dragon]
type=int
scope=perm
protect=no

[impling_caught_lucky]
type=int
scope=perm
protect=no

// Puro-Puro's per-player flags (varbits in hunter_implings.varbit): the wheat field you came in by, so the
// portal sends you back there; the Strength experience Elnock can switch on for pushing through the wheat;
// the spare equipment he hands over once; and the lamp oil still holding a dose of imp repellent.
[puro_state]
type=int
scope=perm
protect=no

// Farmer's Affinity: the world_minute it runs out. Thirty minutes from coming in through a roaming crop
// circle (OSRS, since January 2021), and it keeps running outside Puro-Puro.
[puro_affinity_until]
type=int
scope=perm
protect=no

// Elnock's ten jars a day: date_runeday * 16 + how many bought that day.
[puro_elnock_jars]
type=int
scope=perm
protect=no

// The jar generator's charge, 0-100 (OSRS: 3 an impling jar, 1 a butterfly jar). One generator a player,
// so its charge lives here; 0 means none has been handed over (or it was used up or destroyed).
[jar_generator_charge]
type=int
scope=perm
protect=no

// Elnock's Exchange: which of its four trades is selected (1 imp repellent, 2 magic butterfly net,
// 3 jar generator, 4 three impling jars). Temp - the window's own state.
[puro_exchange_choice]
type=int
scope=temp
protect=no
