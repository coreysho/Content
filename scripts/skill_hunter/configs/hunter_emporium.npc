// OSRS npcs imported by tools/models/importosrsnpc.py. Models re-encoded by osrs2ob2.py with
// the npc recolours baked in; stats and level from the cache, the rest by hand.
//
// Aleck's Hunter Emporium, Yanille (configs/hunter_emporium.loc; spawns in maps/m40_48.jm2 at the
// OSRS wiki's 2567,3083 for Aleck, and beside the bird cage for Leon). Both came with Hunter on
// 21 November 2006. Ops where the cache has them: Aleck's Trade is op5, Leon's op3, and Leon's Ammo
// op4. The shops are configs/hunter_shops.inv; the scripts are the Emporium section of
// scripts/hunter_imps.rs2.

[aleck]
// OSRS npc 1501
name=Aleck
desc=He acts as if he owns the place.
model1=npc_aleck_1
model2=npc_aleck_2
model3=npc_aleck_3
model4=npc_aleck_4
model5=npc_aleck_5
model6=npc_aleck_6
model7=npc_aleck_7
head1=npc_aleck_head1
head2=npc_aleck_head2
readyanim=human_ready
walkanim=human_walk_f
wanderrange=1
op1=Talk-to
op5=Trade
param=owned_shop,hunter_aleck_shop
param=shop_sell_multiplier,1200
param=shop_buy_multiplier,700
param=shop_delta,20
param=shop_title,Aleck's Hunter Emporium

[leon]
// OSRS npc 1502
name=Leon
desc=He seems to be making odd sucking noises with his teeth.
model1=npc_leon_1
model2=npc_leon_2
model3=npc_leon_3
model4=npc_leon_4
model5=npc_leon_5
model6=npc_leon_6
model7=npc_aleck_5
model8=npc_leon_8
model9=npc_leon_9
model10=npc_leon_10
head1=npc_leon_head1
head2=npc_leon_head2
head3=npc_leon_head3
readyanim=human_ready
walkanim=human_walk_f
wanderrange=1
op1=Talk-to
op3=Trade
op4=Ammo
param=owned_shop,hunter_leon_shop
param=shop_sell_multiplier,1000
param=shop_buy_multiplier,200
param=shop_delta,20
param=shop_title,Leon's Prototype Crossbow

// The imp in an imp-in-a-box, for its Talk-to: never spawned, only a name and a chathead for
// ~chatnpc_specific. The 377 imp (npc 708) has no chathead; this is OSRS's imp head, model 20045.
// Its lines carry no <p,...> mood, because the 377 chat animations are made for a human face.
[imp_in_a_box]
name=Imp
model1=npc_imp
head1=npc_hunter_imp_head
