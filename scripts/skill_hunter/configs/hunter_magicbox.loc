// OSRS locs imported by tools/models/importosrslocs.py (osrslocimport.py).
// Models re-encoded by osrs2ob2.py with the loc recolours baked in.
//
// The magic box, laid (OSRS loc 19223), and what becomes of it: an imp that got away (19224, the
// cache's "Magic box failed" - its recolours blacken the panels, and it keeps only Deactivate), an imp
// going in (19225, no ops - it lasts one look of the owner's timer), and an imp inside (19226,
// Retrieve). All four are one model, 19891, and each plays its own OSRS seq (5220 the box humming,
// 5219 the empty box, 5222 the lid coming down, 5221 the imp rattling about) - see hunter_magicbox.seq.

[hunter_magicbox_laid]
// OSRS loc 19223
name=Magic box
model=osrsloc_19223
blockwalk=no
blockrange=no
active=yes
resizex=128
resizey=128
resizez=128
ambient=30
contrast=127
op1=Deactivate
op2=Investigate
anim=osrsloc_anim_5220

[hunter_magicbox_failed]
// OSRS loc 19224
name=Magic box failed
model=osrsloc_19224
blockwalk=no
blockrange=no
active=yes
resizex=128
resizey=128
resizez=128
ambient=30
contrast=127
op1=Deactivate
anim=osrsloc_anim_5219

[hunter_magicbox_catching]
