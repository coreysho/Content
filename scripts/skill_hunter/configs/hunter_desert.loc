// The desert's Hunter locs.
//
// GOLDEN WARBLER SNARE STATES - OSRS locs 9376 (catching) and 9377 (caught), imported by
// tools/models/importosrslocs.py (--no-anim; they play the snare's own 5173/5174, already imported).
// The snare half of both is byte-for-byte osrsloc_9349 and the bird half is one model, so each is
// imported once.

[hunter_snare_catching_warbler]
// OSRS loc 9376
name=Bird snare
model=osrsloc_9349
model2=osrsloc_9376_2
blockwalk=no
blockrange=no
active=yes
ambient=20
anim=osrsloc_anim_5173

[hunter_snare_caught_warbler]
// OSRS loc 9377
name=Bird snare
model=osrsloc_9349
model2=osrsloc_9376_2
blockwalk=no
blockrange=no
active=yes
ambient=20
op1=Check
anim=osrsloc_anim_5174

// DESERT DEVIL TRACKING NODES. 474 placed fifteen tracking nodes in the Uzer hunter area (m53_48), each
// its own loc (19388-19402) so the client could light up one trail step at a time: nine cacti and six
// rockslides, every one with op1=Inspect. Their models are 377's own
// cactus4/cactus5 and rockslide1-4, byte for byte, so the importer placed those - and those carry no
// op, and stand all over the desert. These are the same six looks as tracking nodes: 377's config, plus
// the Inspect and the category hunter_desert.rs2 hangs off. Only the fifteen node tiles use them.

[hunter_desert_cactus4]
name=Cactus
desc=How do these things manage to grow?
model=cactus4
width=2
length=2
mapscene=4
blockrange=no
category=hunter_track_desert
op1=Inspect

[hunter_desert_cactus5]
name=Cactus
desc=How do these things manage to grow?
model=cactus5
width=2
length=2
mapscene=4
blockrange=no
category=hunter_track_desert
op1=Inspect

[hunter_desert_rockslide1]
name=Rockslide
desc=A deposit of rocks.
model=loc_471
width=2
length=2
mapscene=24
blockrange=no
category=hunter_track_desert
op1=Inspect

