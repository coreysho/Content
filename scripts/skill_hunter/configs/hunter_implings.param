// IMPLINGS (scripts/hunter_implings.rs2): what an impling npc is, read by the one [opnpc1,_impling].
// The numbers are in configs/hunter_implings.npc, from the OSRS wiki.

// The Hunter level to catch it with a butterfly net or magic butterfly net; bare-handed it is 10 more.
[impling_level]
type=int
default=0

// The experience a catch pays, in tenths - the Puro-Puro npc carries the Puro-Puro figure, the
// Gielinor npc the Gielinor one.
[impling_xp]
type=int
default=0

// stat_random's low and high: with a butterfly net, and bare-handed or with the magic butterfly net.
[impling_low]
type=int
default=0

[impling_high]
type=int
default=0

[impling_magic_low]
type=int
default=0

[impling_magic_high]
type=int
default=0

// The full jar a catch goes into.
[impling_jar]
type=namedobj
default=null

// 1 baby .. 11 lucky, the order imp defenders free them in (the lowest first). On a spawner, which
// table it rolls: 1 low, 2 mid, 3 high (Gielinor), 4 high (Puro-Puro).
[impling_tier]
type=int
default=0

// 1 on the Puro-Puro implings: an empty impling jar is needed to catch one, and a catch without one is
// never looted on the spot.
[impling_puro]
type=int
default=0

// On a full jar: its impling's number, 1 baby .. 11 lucky (the exchange takes the lowest first).
[impling_jar_tier]
type=int
default=0
