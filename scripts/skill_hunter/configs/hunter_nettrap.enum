// Net traps: what each young-tree colour turns into, keyed by ^hunter_net_<colour> (0 swamp, 1 orange,
// 2 red, 3 black) - the tree on the map, its states, the creature that walks into it and what it pays.
// See scripts/hunter_traps.rs2.

[hunter_net_tree]
inputtype=int
outputtype=loc
default=null
val=0,hunter_young_tree_swamp
val=1,hunter_young_tree_orange
val=2,hunter_young_tree_red
val=3,hunter_young_tree_black

[hunter_net_bending]
inputtype=int
outputtype=loc
default=null
val=0,hunter_nettrap_swamp_bending
val=1,hunter_nettrap_orange_bending
val=2,hunter_nettrap_red_bending
val=3,hunter_nettrap_black_bending

[hunter_net_set]
inputtype=int
outputtype=loc
default=null
val=0,hunter_nettrap_swamp_set
val=1,hunter_nettrap_orange_set
val=2,hunter_nettrap_red_set
val=3,hunter_nettrap_black_set

[hunter_net_catching]
inputtype=int
outputtype=loc
default=null
val=0,hunter_nettrap_swamp_catching
val=1,hunter_nettrap_orange_catching
val=2,hunter_nettrap_red_catching
val=3,hunter_nettrap_black_catching

[hunter_net_caught]
inputtype=int
outputtype=loc
default=null
val=0,hunter_nettrap_swamp_caught
val=1,hunter_nettrap_orange_caught
val=2,hunter_nettrap_red_caught
val=3,hunter_nettrap_black_caught

[hunter_net_escaping]
inputtype=int
outputtype=loc
default=null
val=0,hunter_nettrap_swamp_escaping
val=1,hunter_nettrap_orange_escaping
val=2,hunter_nettrap_red_escaping
val=3,hunter_nettrap_black_escaping

[hunter_net_escaped]
inputtype=int
outputtype=loc
default=null
val=0,hunter_nettrap_swamp_escaped
val=1,hunter_nettrap_orange_escaped
val=2,hunter_nettrap_red_escaped
val=3,hunter_nettrap_black_escaped

[hunter_net_prey]
inputtype=int
outputtype=npc
default=null
val=0,hunter_swamp_lizard
val=1,hunter_orange_salamander
val=2,hunter_red_salamander
val=3,hunter_black_salamander

[hunter_net_catch]
inputtype=int
outputtype=int
val=0,^hunter_catch_swamp_lizard
val=1,^hunter_catch_orange_salamander
val=2,^hunter_catch_red_salamander
val=3,^hunter_catch_black_salamander
