// Imported from a modern OSRS cache by tools/models/importosrs.py.
// Models are RE-ENCODED from OSRS model format into the 317-family format
// (tools/models/osrs2ob2.py); every one is round-trip verified before writing.
// wearpos/wearpos2/wearpos3 come from the cache - do not hand-edit them.
//
// The Piscatoris hunter area's objs (OSRS 10023/10024, 10125, 10115, 10127, 10121, 10105, 10107, 10091).
// The common and dark kebbit furs are the Feldip weasel fur's model and the orange feather is the red
// feather's (byte-identical in the cache - only the recolours differ), so they point at those.

// Matthias's glove. It never sits in a pack: he puts it on your hand (the weapon and shield slots,
// wearpos/wearpos2 from the cache), and only he takes it off - scripts/hunter_falconry.rs2. With the
// falcon on it, you stand and walk the way Matthias does, holding the bird up: OSRS seqs 5160-5168,
// his own and on the player skeleton. Its combat stats are OSRS's (+1 slash and crush defence).
[falconers_glove]
name=Falconer's glove
desc=A very large, single leather glove.
model=obj_falconers_glove
manwear=obj_falconers_glove_manwear,0
womanwear=obj_falconers_glove_womanwear,0
wearpos=righthand
wearpos2=lefthand
2dzoom=1010
2dxan=332
2dyan=2000
2dxof=2
2dyof=-14
weight=907g
cost=1
members=yes
tradeable=no
iop2=Wear
param=slashdefence,1
param=crushdefence,1

[falconers_glove_falcon]
name=Falconer's glove
desc=A very large, single leather glove.
model=obj_falconers_glove_falcon
manwear=obj_falconers_glove_falcon_manwear,0
womanwear=obj_falconers_glove_falcon_womanwear,0
wearpos=righthand
wearpos2=lefthand
2dzoom=1010
2dxan=332
2dyan=2000
2dxof=2
2dyof=-14
weight=1814g
cost=1
members=yes
tradeable=no
iop2=Wear
param=slashdefence,1
param=crushdefence,1
param=ready_baseanim,osrs_seq_5160
param=turnonspot_baseanim,osrs_seq_5161
param=walk_f_baseanim,osrs_seq_5164
param=walk_b_baseanim,osrs_seq_5165
param=walk_l_baseanim,osrs_seq_5166
param=walk_r_baseanim,osrs_seq_5167
param=running_baseanim,osrs_seq_5168

