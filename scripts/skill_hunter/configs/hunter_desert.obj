// OSRS objs 10090 and 10123, from the OSRS cache (OpenRS2 #2710) as tools/models/importosrs.py reads
// them. Each is one of an OSRS family on a single model with its own recolour - the feathers on 2476, the
// kebbit furs on 2631 - and those models are already here as the red feather's and the Feldip weasel
// fur's, so these take them with the cache's recolours rather than importing the same model twice.

[yellow_feather]
// OSRS obj 10090: the golden warbler's
name=Yellow feather
desc=A bright yellow feather.
model=obj_red_feather
2dzoom=700
2dxan=428
2dyan=692
2dxof=4
2dyof=10
recol1s=32767
recol1d=22084
weight=2g
cost=13
members=yes
stackable=yes

[desert_devil_fur]
// OSRS obj 10123: the desert devil's
name=Desert devil fur
desc=Sandy coloured kebbit fur.
model=obj_feldip_weasel_fur
2dzoom=1090
2dxan=584
2dyof=-4
recol1s=19904
recol1d=23112
weight=453g
cost=17
members=yes
