// Hunter. Stat 22, added 2026-09-22 (engine PlayerStat.HUNTER, content stat.enum index 23).
//
// BUTTERFLY NETTING is the first thing in it, and it is built entirely out of what the 377 cache
// already has on the map. No import, no new art, no new npc:
//
//   butterfly                    id 153   126 placements
//   butterfly2                   id 154    64
//   butterfly_viceroy            id 157    42
//   butterfly_bluemorpo          id 155    12
//   butterfly_tigerswallowtail   id 156     5
//
// 249 of them across 20 map squares, the thickest of it in Tirannwn (m34_49, m34_50, m35_49,
// m35_50, m36_49) with smaller clusters round Lumbridge and Draynor (m48_48, m49_50, m50_50) and
// in the upper map band. Jagex placed them as scenery years before Hunter existed, and scenery is
// exactly what they have been ever since: not one of the five carries an op, so there has never
// been anything to click.
//
// WHICH IS WHY THIS IS AN [opnpcu] AND NOT AN [opnpc1]. A handler on an op the npc does not
// declare never fires - the dead-click class this repo has been clearing all month. But
// Client.addNpcOptions adds "Use <item> with <npc>" from the bounds and the interact flag alone,
// with no reference to the ops array at all, and the butterflies never set active=no. So using a
// net on one works today, on npcs nobody has touched, and it is also how the real skill reads.
//
// THE NET IS THE PLAIN SMALL FISHING NET. A proper butterfly net is 2006 art this cache does not
// have, and inventing one is the thing that goes wrong (claude/black-mask-slayer-helm-ma2.md).
// `net` is already in every fishing shop, already wieldable, and needs no trigger of its own: the
// handler lives on the BUTTERFLY and reads last_useitem, so nothing about fishing changes.
//
// THE JAR IS BLOWN, NOT BOUGHT. OSRS sells butterfly jars in a hunter shop; this build has no
// Hunter expert and nowhere to put one, and the cache's only jar is the Digsite's specimen_jar,
// which that quest counts in four places. So hunter_butterfly_jar is a new obj on the same model
// and it is a GLASSBLOWING product - Crafting 20, a bucket of sand and some soda ash - which is
// what a glass jar is anyway, and which means it costs something instead of appearing from a
// shopkeeper who does not exist. See configs/hunter.struct and skill_crafting/scripts/glass.
//
// THE JAR DECIDES WHAT YOU KEEP, NOT WHAT YOU LEARN. A catch pays the same experience with or
// without one, so netting is worth training from level 1 with nothing but the net; the jar is what
// turns a catch into something you can carry home, and releasing one gives the jar back. The four
// filled jars carry a cost, so a general store will buy them.

// The rarer the species, the higher the level - and the cache's own placement counts are what
// order them. 190 plain butterflies, 42 viceroys, 12 blue morphos, 5 tiger swallowtails.
^hunter_butterfly_level = 1
^hunter_viceroy_level = 15
^hunter_bluemorpo_level = 25
^hunter_swallowtail_level = 35

// Experience, in the x10 form stat_advance takes throughout this repo. OSRS pays 24/34/44/54 for
// its four butterflies; these are the same shape one tier lower, because the first of ours is a
// level 1 catch and OSRS's first is level 15.
^hunter_butterfly_xp = 120
^hunter_viceroy_xp = 240
^hunter_bluemorpo_xp = 340
^hunter_swallowtail_xp = 440

// stat_random(stat, low, high) is the engine's own interpolated roll: `low` out of 256 at level 1,
// `high` out of 256 at 99, straight-line between. A harder butterfly starts worse and ends a
// little worse, so the level that unlocks a species is never the level you farm it at.
^hunter_butterfly_low = 100
^hunter_butterfly_high = 250
^hunter_viceroy_low = 70
^hunter_viceroy_high = 235
^hunter_bluemorpo_low = 60
^hunter_bluemorpo_high = 225
^hunter_swallowtail_low = 50
^hunter_swallowtail_high = 215

// Enough experience to clear the Tiger Swallowtail's level 35, for [debugproc,hunter]. 22,406 xp
// is level 35 on the standard table; this is the x10 form plus a little slack.
^hunter_debug_xp = 230000

// ---------------------------------------------------------------------------------------------
// BOX TRAPPING (2026-09-23). The second method, and the first with imported art: the trap, its
// eight loc states, the three prey and their loot all come from the OSRS cache (loc 9380 laid,
// 9385 collapsed, 9382-9384 shaking, 9386/9390/9394 catching; npc 2910, 2911, 1505; obj 10008,
// 10033, 10034, 10092), and the ground they live on is the Feldip hunting strip, mapsquares
// 39_45 to 41_45, imported from the rev 474 cache because 377 has no terrain there at all.
//
// See scripts/hunter_traps.rs2 for the loop and configs/hunter_trap.varp for ownership.

// A box trap needs Hunter 27 to lay, which is also the ferret's level - OSRS's own figure for both.
^hunter_boxtrap_level = 27

// Levels and experience are OSRS's (198.25 for a grey chinchompa is written 1983 here, the x10 form
// rounded). Prey will only walk into a trap whose owner could catch it, as in OSRS, so a level-27
// hunter's trap in the carnivorous chinchompas' clearing simply stays empty.
^hunter_ferret_level = 27
^hunter_ferret_xp = 1150
^hunter_chinchompa_level = 53
^hunter_chinchompa_xp = 1983
^hunter_chinchompa_red_level = 63
^hunter_chinchompa_red_xp = 2650

// The roll, as stat_random's low/high out of 256 at levels 1 and 99. These are not OSRS numbers -
// OSRS publishes none - but a shape: each prey is about an even chance at its unlock level and
// reaches 85-95% at 99, so a trap that has only just become available still fails as often as it
// works. A failed roll collapses the trap and the prey runs off.
^hunter_ferret_low = 104
^hunter_ferret_high = 240
^hunter_chinchompa_low = 24
^hunter_chinchompa_high = 220
^hunter_chinchompa_red_low = 10
^hunter_chinchompa_red_high = 200

// The Baby chinchompa's base chances live with the other skilling pets', in
// npc/configs/skill_pets.constant, where tools/pet_battery.py reads them.

// How often each owner's traps are looked at (ticks), how close a prey has to wander to a trap to
// be interested in it (tiles), and the one-in-N chance per look that an interested prey goes in.
//
// 1 in 12 at 2 ticks is a spring about every 24 ticks (~15s) with prey beside the trap. It was 1 in
// 3 first, and the live test (a socketless player on the real engine) had a trap shaking within
// seconds of being laid - several hundred thousand xp an hour at four traps. At 1 in 12, with a
// ~60% catch and a reset between springs, four traps on grey chinchompas come out near 100k an
// hour, which is where OSRS puts them.
^hunter_trap_interval = 2
^hunter_trap_lure_radius = 3
^hunter_trap_lure_chance = 12

// A trap left longer than this without being touched falls over and becomes a box trap on the
// ground (ticks: two minutes). Every change of state - laid, caught, collapsed, reset - starts the
// clock again, because loc_change takes a fresh duration.
^hunter_trap_duration = 200

// Walk further than this from a trap (tiles, or change level) and it collapses, as in OSRS.
^hunter_trap_leash = 20

// ---------------------------------------------------------------------------------------------
// BIRD SNARES (2026-09-23). Same loop, same slots, same cap as the box traps - see
// scripts/hunter_traps.rs2. The two Feldip birds, OSRS's levels and experience: the crimson swift
// at 1 (34 xp) and the tropical wagtail at 19 (95.2). The three other snare birds live in places
// this map does not have yet (Piscatoris, the Rellekka hunter area, the desert).
^hunter_snare_level = 1
^hunter_swift_level = 1
^hunter_swift_xp = 340
^hunter_wagtail_level = 19
^hunter_wagtail_xp = 952

// The roll, in the same shape as the box traps': an even-ish chance at the unlock level, most of
// the way there by 99. Not OSRS's numbers - it publishes none.
^hunter_swift_low = 128
^hunter_swift_high = 250
^hunter_wagtail_low = 70
^hunter_wagtail_high = 240

// A snare pays bones, raw bird meat and this many of the bird's feathers. The count is the one
// number here that is a judgement rather than a citation.
^hunter_bird_feathers = 5

// What a trap is holding - the argument ~hunter_catch_pay and ~hunter_catch_room switch on.
^hunter_catch_none = 0
^hunter_catch_ferret = 1
^hunter_catch_chinchompa = 2
^hunter_catch_chinchompa_red = 3
^hunter_catch_swift = 4
^hunter_catch_wagtail = 5
^hunter_catch_wild_kebbit = 6
^hunter_catch_barbtailed_kebbit = 7

// Which kind of trap a slot holds (three bits each of %hunter_trap_kinds).
^hunter_kind_box = 0
^hunter_kind_snare = 1
^hunter_kind_deadfall = 2

// ---------------------------------------------------------------------------------------------
// DEADFALLS (2026-09-23). Set on the boulders 474 placed across the Feldip grounds, with a knife and
// logs. OSRS's Feldip kebbits, levels and experience: the wild kebbit at 23 (128 xp; bones and kebbit
// claws) and the barb-tailed kebbit at 33 (168 xp; bones and a barb-tail harpoon, which fishes like
// any harpoon). The deadfall itself needs 23, the wild kebbit's level, as in OSRS.
^hunter_deadfall_level = 23
^hunter_wild_kebbit_level = 23
^hunter_wild_kebbit_xp = 1280
^hunter_barbtailed_kebbit_level = 33
^hunter_barbtailed_kebbit_xp = 1680
^hunter_wild_kebbit_low = 90
^hunter_wild_kebbit_high = 240
^hunter_barbtailed_kebbit_low = 60
^hunter_barbtailed_kebbit_high = 230
^hunter_catch_larupia = 8
^hunter_kind_pitfall = 3

// ---------------------------------------------------------------------------------------------
// PITFALLS (2026-09-23). Set over the pits 474 dug across the Feldip grounds, with a knife and logs;
// sprung by teasing a spined larupia with a teasing stick and jumping the pit with it on your
// heels. OSRS's numbers: Hunter 31, 180 xp, big bones and larupia fur.
^hunter_pitfall_level = 31
^hunter_larupia_level = 31
^hunter_larupia_xp = 1800
^hunter_larupia_low = 60
^hunter_larupia_high = 230
// How long a tease lasts (ticks), and how close behind you (to the tile you jumped from) the larupia
// has to be when you land. Each pit's larupia spawns where it can step all the way to that tile.
^hunter_tease_window = 50
^hunter_pit_reach = 3

// ---------------------------------------------------------------------------------------------
// TRACKING (2026-09-23): the Feldip weasel, OSRS's Feldip tracking kebbit - Hunter 7, 48 xp, bones
// and Feldip weasel fur - on the trail of jungle plants and burrows in the grounds' south-west
// corner, ending in a bush. A noose wand to catch it. See scripts/hunter_tracking.rs2.
^hunter_weasel_level = 7
^hunter_weasel_xp = 480
^hunter_weasel_low = 150
^hunter_weasel_high = 250
// A trail is this many plants long, plus up to this many more, before it turns to the bush; each step
// is between these distances (tiles) from the last, and always closer to the bush.
^hunter_track_hops_min = 2
^hunter_track_hops_extra = 2
^hunter_track_step_min = 2
^hunter_track_step_max = 9
// ---------------------------------------------------------------------------------------------
// NET TRAPS (2026-09-24). A small fishing net and a rope, set on a young tree: the tree is bent over the
// net, and a lizard or salamander that runs across the net springs it and hangs in it. OSRS's four 2006
// creatures, levels and experience, each in the hunter area OSRS keeps it in:
//   swamp lizard       29   152    Canifis hunter area (m55_53, 474's young trees)
//   orange salamander  47   224    Uzer hunter area (m53_48, 474's rocks and young trees)
//   red salamander     59   272    Ourania hunter area (m38_50, OSRS's young trees on 377's ground)
//   black salamander   67   319.2  Bone Yard hunter area, Wilderness (m51_57, 474's young trees)
// A net trap needs Hunter 29 to set, the swamp lizard's level, as in OSRS.
^hunter_nettrap_level = 29
^hunter_swamp_lizard_level = 29
^hunter_swamp_lizard_xp = 1520
^hunter_orange_salamander_level = 47
^hunter_orange_salamander_xp = 2240
^hunter_red_salamander_level = 59
^hunter_red_salamander_xp = 2720
^hunter_black_salamander_level = 67
^hunter_black_salamander_xp = 3192

// The roll. Unlike the other traps', these ARE OSRS's figures: the wiki gives each creature's catch rate
// by level (swamp lizard 55% at 29 and certain from 66; orange 56% at 47, certain from 87; red 56% at 59
// and 94% at 99; black 56% at 67 and 83% at 99), and these low/high values put stat_random on exactly
// those numbers - worked through the engine's own formula at each quoted level. A high above 255 is how
// "certain from level N" comes out.
^hunter_swamp_lizard_low = 52
^hunter_swamp_lizard_high = 360
^hunter_orange_salamander_low = 12
^hunter_orange_salamander_high = 290
^hunter_red_salamander_low = 1
^hunter_red_salamander_high = 240
^hunter_black_salamander_low = 0
^hunter_black_salamander_high = 212

^hunter_catch_swamp_lizard = 9
^hunter_catch_orange_salamander = 10
^hunter_catch_red_salamander = 11
^hunter_catch_black_salamander = 12
^hunter_kind_nettrap = 4

// Which young tree: the key of every hunter_net_* enum (configs/hunter_nettrap.enum).
^hunter_net_swamp = 0
^hunter_net_orange = 1
^hunter_net_red = 2
^hunter_net_black = 3
^hunter_net_colours = 4

// How long a young tree stays bent while a net is set on it (ticks) - only long enough to outlast the
// setting, after which it is either a set trap or a plain tree again.
^hunter_net_bend_duration = 10
