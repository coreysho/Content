// Aleck's Hunter Emporium and Leon's Prototype Crossbow, Yanille (scripts/hunter_imps.rs2).
//
// Aleck's is the OSRS wiki's stock, counts and all, less what came later or has no use here:
//   - the three trap packs (2020);
//   - the rabbit snare. Snaring white rabbits with a ferret is Piscatoris hunting, which this build
//     does not have, so a rabbit snare would be a trap that cannot be laid anywhere.
// The butterfly jar is this build's own (hunter_butterfly_jar, which can also still be blown), and the
// small fishing net goes on netting butterflies beside the butterfly net. Box traps, bird snares,
// teasing sticks and noose wands are sold at Gu'Tanoth too (the ogre general store, nearest Feldip).
[hunter_aleck_shop]
scope=shared
size=40
restock=yes
stackall=yes
allstock=no
stock1=butterfly_net,5,100
stock2=hunter_butterfly_jar,100,100
stock3=magic_box,30,100
stock4=noose_wand,50,100
stock5=hunter_bird_snare,50,100
stock6=hunter_box_trap,25,100
stock7=teasing_stick,5,100
stock8=torch_unlit,20,100

// Leon keeps two, as in OSRS.
[hunter_leon_shop]
scope=shared
size=40
restock=yes
stackall=yes
allstock=no
stock1=hunters_crossbow,2,100
