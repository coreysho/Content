// IMPLINGS: tier number (1 baby .. 11 lucky, as param impling_tier) to jar, to Puro-Puro npc and to name.

[impling_jar_by_tier]
inputtype=int
outputtype=namedobj
default=null
val=1,baby_impling_jar
val=2,young_impling_jar
val=3,gourmet_impling_jar
val=4,earth_impling_jar
val=5,essence_impling_jar
val=6,eclectic_impling_jar
val=7,nature_impling_jar
val=8,magpie_impling_jar
val=9,ninja_impling_jar
val=10,dragon_impling_jar
val=11,lucky_impling_jar

[impling_puro_by_tier]
inputtype=int
outputtype=npc
default=null
val=1,impling_baby_puro
val=2,impling_young_puro
val=3,impling_gourmet_puro
val=4,impling_earth_puro
val=5,impling_essence_puro
val=6,impling_eclectic_puro
val=7,impling_nature_puro
val=8,impling_magpie_puro
val=9,impling_ninja_puro
val=10,impling_dragon_puro
val=11,impling_lucky_puro

[impling_world_by_tier]
inputtype=int
outputtype=npc
default=null
val=1,impling_baby
val=2,impling_young
val=3,impling_gourmet
val=4,impling_earth
val=5,impling_essence
val=6,impling_eclectic
val=7,impling_nature
val=8,impling_magpie
val=9,impling_ninja
val=10,impling_dragon
val=11,impling_lucky

[impling_name_by_tier]
inputtype=int
outputtype=string
default=impling
val=1,Baby
val=2,Young
val=3,Gourmet
val=4,Earth
val=5,Essence
val=6,Eclectic
val=7,Nature
val=8,Magpie
val=9,Ninja
val=10,Dragon
val=11,Lucky
