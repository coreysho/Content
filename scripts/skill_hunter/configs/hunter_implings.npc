// THE INVISIBLE SPAWNS (Impling#Spawn_mechanics). An impling first exists as an invisible npc that roams
// for two minutes, over anything (blocked+normal), then turns into the impling its tier rolls
// (npc_changetype, [ai_timer,_impling_spawner]). Caught, it is npc_del'd - which respawns the BASE type,
// the invisible one, at its own spawn point, after the impling's respawnrate (7 ticks: "immediately").
// Puro-Puro's 35 are static map npcs; the Gielinor ones are npc_add'ed every thirty minutes by the
// controller below, and a Gielinor catch does not come back until the next cycle. trollrescue_blankmodel_8
// is the build's one invisible model; active=no leaves nothing to click.
[impling_spawner_low]
model1=trollrescue_blankmodel_8
active=no
minimap=no
category=impling_spawner
timer=200
moverestrict=blocked+normal
wanderrange=32
respawnrate=7
param=impling_tier,1

[impling_spawner_mid]
model1=trollrescue_blankmodel_8
active=no
minimap=no
category=impling_spawner
timer=200
moverestrict=blocked+normal
wanderrange=32
respawnrate=7
param=impling_tier,2

[impling_spawner_high]
model1=trollrescue_blankmodel_8
active=no
minimap=no
category=impling_spawner
timer=200
moverestrict=blocked+normal
wanderrange=32
respawnrate=7
param=impling_tier,4

[impling_spawner_world_low]
model1=trollrescue_blankmodel_8
active=no
minimap=no
category=impling_spawner
timer=200
moverestrict=blocked+normal
wanderrange=100
respawnrate=7
param=impling_tier,1

[impling_spawner_world_mid]
model1=trollrescue_blankmodel_8
active=no
minimap=no
category=impling_spawner
timer=200
moverestrict=blocked+normal
wanderrange=100
respawnrate=7
param=impling_tier,2

[impling_spawner_world_high]
model1=trollrescue_blankmodel_8
active=no
minimap=no
category=impling_spawner
timer=200
moverestrict=blocked+normal
wanderrange=100
respawnrate=7
param=impling_tier,3

// The clock nothing sees: one npc, standing in Puro-Puro's unwalkable outer edge, whose timer runs the
// thirty-minute Gielinor cycle, moves the roaming crop circle every fifteen minutes and makes the maze's
// wheat grow and wilt (hunter_puro.rs2). An npc because npcs are processed every tick whether or not a
// player is near, and a static one because a static npc comes back if anything ever removes it.
[impling_controller]
model1=trollrescue_blankmodel_8
timer=1
active=no
minimap=no
moverestrict=nomove
wanderrange=0

// ELNOCK INQUISITOR (hunter_puro.rs2). Rev 474 npc 6070 - OSRS's 5734 is a later redraw - with its
// recolours as the RGB15 the packer turns back into 474's HSL16 (import474.hsl16_to_rgb15, all exact).
// 474's ops are Talk-to and Trade; OSRS added Exchange and Quick-withdraw in 2021 with an equipment
// store this build has no window for, so Trade is the exchange, as it was in 2007.
[elnock_inquisitor]
name=Elnock Inquisitor
desc=Insurance investigator extraordinaire.
model1=npc_elnock_1
model2=npc_3053i2
model3=npc_elnock_3
head1=npc_elnock_head
readyanim=midget_ready
walkanim=midget_walk
recol1s=12514
recol1d=2215
recol2s=6470
recol2d=4329
recol3s=4356
recol3d=1158
recol4s=2242
recol4d=1158
recol5s=18990
recol5d=101
recol6s=352
recol6d=1158
op1=Talk-to
op3=Trade
wanderrange=2

// Imp defenders (rev 474 npc 6074, OSRS 5738): no ops; they walk the maze and free the implings in your
// jars (hunter_puro.rs2). The chathead is OSRS's imp head, as the imp-in-a-box's.
[imp_defender]
name=Imp defender
timer=5
desc=An angry little imp. Grrr.
model1=npc_imp_defender
head1=npc_hunter_imp_head
readyanim=imp_ready
walkanim=imp_walk
wanderrange=3
respawnrate=100
hitpoints=10

// The wandering impling in Zanaris's wheat field (474 npc 6073) and Immenizz at Puro-Puro's portal (474
// 6071): the same impling model, Talk-to. OSRS gave the wandering impling Check-gates in 2021; its
// answer is the Talk-to's last line, so it is here too.
[wandering_impling]
name=Wandering impling
desc=He looks a little lost.
model1=npc_impling_wandering
head1=npc_impling_head
readyanim=impling_ready
walkanim=impling_walk
op1=Talk-to
op3=Check-gates
wanderrange=4

[immenizz]
name=Immenizz
desc=An impling.
model1=npc_impling_wandering
head1=npc_impling_head
readyanim=impling_ready
walkanim=impling_walk
op1=Talk-to
wanderrange=2
