// IMPLINGS (Impetuous Impulses, June 2007) - scripts/hunter_implings.rs2.
//
// Every impling OSRS has but the crystal impling (Prifddinas, which this build does not have). Two of
// each, as OSRS has two: the Gielinor one and the Puro-Puro one, which differ only in the experience a
// catch pays (the wiki's Gielinor and Puro-Puro columns) and in how they move - Puro-Puro's stay in
// the maze's corridors, the world's fly over water (moverestrict=blocked+normal: blocked only by what
// blocks a projectile, so walls and fences but not rivers). Models: rev 474's (npcs 1028-1035,
// 6053-6064, byte-identical to OSRS's), the lucky impling OSRS's (npc 7233, model 31741 - it came in
// 2019). Level, xp and the catch rolls are the OSRS wiki's: its Skilling success chart numbers for
// the net (impling_low/high) and for bare hands or the magic butterfly net (impling_magic_low/high),
// which are stat_random's own low/high out of 256 - Mod Ash's 12% at 1 to 98% at 99, +8 points for
// the magic net or bare hands. Combat stats per Mod Ash (hitpoints 10, the rest 0, magic defence
// +10 to +50); no Attack op, as in OSRS.

[impling_baby]
name=Baby impling
desc=An impling baby. Aaah...
model1=npc_impling_baby
model2=npc_impling_wings
readyanim=impling_ready
walkanim=impling_walk
op1=Catch
category=impling
timer=10
moverestrict=blocked+normal
wanderrange=100
respawnrate=7
hitpoints=10
param=magicdefence,10
param=stabdefence,-10
param=slashdefence,-10
param=crushdefence,-10
param=rangedefence,-10
param=impling_level,17
param=impling_xp,200
param=impling_low,79
param=impling_high,402
param=impling_magic_low,99
param=impling_magic_high,422
param=impling_jar,baby_impling_jar
param=impling_tier,1

