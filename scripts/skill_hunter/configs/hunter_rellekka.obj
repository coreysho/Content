// The two Rellekka butterflies in their jars - OSRS's own jar objs (10016, 10018), which is what a netted
// one goes into when there is an empty butterfly jar in the pack. Release gives the jar back; in OSRS a
// snowy knight heals 15 as it goes and a sapphire glacialis boosts Defence by 4 + 15%, and so they do here.
// Release sits in the cache's own slot (4), ahead of Drop.
[snowy_knight]
name=Snowy knight
desc=There's a snowy knight butterfly in here.
model=obj_snowy_knight
2dzoom=590
2dxan=280
2dyan=1756
2dxof=9
2dyof=60
recol1s=10879
recol1d=32764
weight=20g
cost=50
members=yes
iop4=Release

