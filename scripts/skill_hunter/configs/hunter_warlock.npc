// The black warlock (2026-09-25): the fifth butterfly, Hunter 45, 54 xp - one of the four the skill shipped
// with in November 2006, and the one that lives on the Feldip hunting grounds, where these seven stand at
// the OSRS wiki's own spawn points (maps m39_45 and m40_45). OSRS npc 5553, rev 474's 5082: 377's own
// butterfly model 3023 (npc_butterfly2, as the tiger swallowtail) with 474's three recolours - HSL 39892
// and 32889 to 916, 39386 to 0 - written as RGB15.
//
// OSRS gives it a Catch op for its butterfly net; like every other butterfly here it is caught by using a
// net on it ([opnpcu], scripts/hunter_butterflies.rs2), so the op is left out rather than left dead.
[hunter_black_warlock]
name=Black warlock
desc=A black warlock. The air seems to distort wherever it passes.
model1=npc_butterfly2
recol1s=10847
recol1d=10240
recol2s=13983
recol2d=0
recol3s=29695
recol3d=10240
readyanim=butterfly_hover
walkanim=butterfly_hover
// op1=Catch
minimap=no
vislevel=hide
wanderrange=10
