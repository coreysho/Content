// The Rellekka hunting grounds' creatures. OSRS npcs imported by tools/models/importosrsnpc.py - models
// re-encoded by osrs2ob2.py with the npc recolours baked in; stats and level from the cache, the rest by
// hand. Each reuses the animations an earlier round converted for its kin: the bird's flight (6771/6773),
// the kebbits' (5273/5272), the larupia's (5225/5226, the same skeleton as the kyatt's), and 377's own
// butterfly hover.

[hunter_cerulean_twitch]
// OSRS npc 5550. Its body is the crimson swift's with blue plumage; the second model (the wing
// geometry) is byte-for-byte the swift's, so it is that one.
name=Cerulean twitch
model1=npc_hunter_cerulean_twitch_1
model2=npc_hunter_crimson_swift_2
readyanim=osrs_seq_6771
walkanim=osrs_seq_6773
wanderrange=6
respawnrate=50
attack=35
defence=20
strength=30
hitpoints=40
ranged=1
magic=1

[hunter_sabretooth_kebbit]
// OSRS npc 1347
name=Sabre-toothed kebbit
model1=npc_hunter_sabretooth_kebbit_1
model2=npc_hunter_sabretooth_kebbit_2
model3=npc_hunter_sabretooth_kebbit_3
readyanim=osrs_seq_5273
walkanim=osrs_seq_5272
wanderrange=5
respawnrate=50

[hunter_sabretooth_kyatt]
// OSRS npc 2907
name=Sabre-toothed kyatt
model1=npc_hunter_sabretooth_kyatt_1
size=2
readyanim=osrs_seq_5225
walkanim=osrs_seq_5226
// One tile, as the larupia's: NPCs move naively, and a kyatt that drifts behind a rock can never chase
// a teaser back to the pit (see hunter_larupia.npc).
wanderrange=1
respawnrate=50
op1=Tease
// Its combat stats are the cache's, and are only its level: nothing here fights it. Teased, it
// follows (npc_setmode(playerfollow)) rather than attacks.
vislevel=60
attack=60
defence=42
strength=60
hitpoints=42
ranged=1
magic=1

// The two Rellekka butterflies. OSRS gives them a Catch op for its butterfly net; this build nets
// butterflies by using the small fishing net on one ([opnpcu], as every other butterfly here), so the op
// is left out rather than duplicated. hide/wanderrange as 377's own butterflies.
[hunter_sapphire_glacialis]
// OSRS npc 5555
name=Sapphire glacialis
model1=npc_hunter_sapphire_glacialis_1
readyanim=butterfly_hover
walkanim=butterfly_hover
// op1=Catch
minimap=no
vislevel=hide
wanderrange=10

[hunter_snowy_knight]
// OSRS npc 5554
name=Snowy knight
model1=npc_hunter_snowy_knight_1
readyanim=butterfly_hover
walkanim=butterfly_hover
// op1=Catch
minimap=no
vislevel=hide
wanderrange=10

// The Hunting expert of the Rellekka grounds, in polar camouflage - from the rev 474 cache (npc 5112,
// OSRS's 1503) by tools/models/importnpc474.py, models and chathead copied byte-for-byte: OSRS's own
// 1503 carries a post-2020 head, 474's is the 2006 one. Stands on the plateau at 2710,3829, where OSRS
// puts him. A second Hunter master, as in OSRS: he sells the cape too.
[hunting_expert_rellekka]
name=Hunting expert
model1=npc_hunting_expert_rellekka_1
model2=npc_hunting_expert_rellekka_2
model3=npc_hunting_expert_rellekka_3
model4=npc_hunting_expert_rellekka_4
model5=npc_hunting_expert_rellekka_5
model6=npc_hunting_expert_rellekka_6
model7=npc_hunting_expert_rellekka_7
head1=npc_hunting_expert_rellekka_head1
head2=npc_hunting_expert_rellekka_head2
readyanim=human_ready
walkanim=human_walk_f
wanderrange=3
op1=Talk-to
recol1s=7298
recol1d=17868
recol2s=9473
recol2d=17868
