// The Karamja hunter area - the horned graahks' pitfalls, west of Shilo Village and south of Tai Bwo
// Wannai - imported from the rev 474 cache by tools/models/import474rect.py: rectangles of m43_46
// (level 0 3:52-39:63, level 1 9:56-35:63) and m43_47 (level 0 5:0-29:7, level 1 13:0-17:5), and
// 474's heights alone (--terrain-only) for m43_46 level 0 40:52-57:63: 474 re-graded the ground east
// of the pits as well, so the pits' rectangle by itself would have left a step along its east edge.
// With the strip, every tile round the patched ground is the same in 474 and here - the seam is 474's
// own. 377 has the jungle there but not the hunting ground Jagex cut into it in November 2006 - the
// five pits, the dug-up soil round them and the dead trees for logs.
//
// These are the loc types that are 474's own; everything else placed there resolved to a loc the
// build already has - the five pits to loc474_19227, the Feldip Pit, whose Trap op is the pitfall
// (scripts/hunter_traps.rs2), and the dead trees to loc474_1286, which chops like any dead tree.
// None of the four below carries an op.
//
// Left out on purpose (--skip-loc): 474's Hunter map icon (19750), which previous rounds have not
// placed either; and the twenty rim pieces round the pits (19280-19332), multilocs whose default
// state is NOTHING - a pit's rim only shows logs and spikes while a trap is set - so resolving them
// to their first visible child, as the importer does, would have laid permanent spiked logs over
// every unset pit.

[loc474_1398]
// rev 474 loc 1398 (import474map.py)
name=Jungle plant
model=loc474_1398
recol1s=6528
recol1d=1730
width=2
blockrange=no

[loc474_16429]
// rev 474 loc 16429 (import474map.py) - an area sound (the jungle at the north edge of the pits)
model=minigame_start_icon
active=no
bgsound=jungle_ambience_loop,20

