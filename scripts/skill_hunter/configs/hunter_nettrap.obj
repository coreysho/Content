// Imported from a modern OSRS cache by tools/models/importosrs.py.
// Models are RE-ENCODED from OSRS model format into the 317-family format
// (tools/models/osrs2ob2.py); every one is round-trip verified before writing.
// wearpos/wearpos2/wearpos3 come from the cache - do not hand-edit them.
//
// The net-trap catches (OSRS objs 10146-10149). OSRS makes them noteable; nothing else this skill catches
// has a note here yet either.

[swamp_lizard]
name=Swamp lizard
desc=A very slimy and generally disgusting green lizard.
model=obj_swamp_lizard
manwear=obj_swamp_lizard_manwear,0
womanwear=obj_swamp_lizard_womanwear,6
wearpos=righthand
wearpos2=lefthand
2dzoom=1370
2dxan=296
2dxof=5
2dyof=29
recol1s=21890
recol1d=2242
recol2s=20833
recol2d=1185
recol3s=17665
recol3d=128
weight=4000g
cost=50
members=yes
// Wield: OSRS's two-handed salamander, fed herb tar from the ammunition slot - Scorch, Flare and
// Blaze, in scripts/hunter_salamander.rs2. Bonuses are OSRS's; attackrate is Scorch's and Blaze's 5
// (Flare is 4, set there), and every style reaches one tile, diagonals included.
iop2=Wield
category=weapon_salamander
param=slashattack,10
param=rangeattack,20
param=strengthbonus,22
param=attackrate,5
param=attackrange,1
param=slashattack_anim,osrs_salamander_attack
param=rangeattack_anim,osrs_salamander_attack
param=slash_sound,salamander_flame
param=rangeattack_sound,salamander_blaze
param=defend_anim,human_unarmedblock
param=ready_baseanim,osrs_salamander_ready
param=turnonspot_baseanim,osrs_human_turnonspot
param=walk_f_baseanim,osrs_salamander_walk
param=walk_b_baseanim,osrs_salamander_walk
param=walk_l_baseanim,osrs_salamander_walk
param=walk_r_baseanim,osrs_salamander_walk
// Release is OSRS's, and it is in the Drop slot: a live catch is let go, never dropped.
iop5=Release

