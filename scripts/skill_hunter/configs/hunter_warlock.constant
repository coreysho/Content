// The black warlock (configs/hunter_warlock.npc): OSRS's level and experience. OSRS publishes no catch
// rate for a butterfly, so it takes the next step of the tiers netting already has (hunter.constant:
// 60/225 at 25, 50/215 at 35).
^hunter_warlock_level = 45
^hunter_warlock_xp = 540
^hunter_warlock_low = 40
^hunter_warlock_high = 205
// let out of its jar: Strength + 4 + 15% (OSRS)
^hunter_warlock_boost = 4
^hunter_warlock_boost_pct = 15
