// OSRS npcs imported by tools/models/importosrsnpc.py. Models re-encoded by osrs2ob2.py with
// the npc recolours baked in; stats and level from the cache, the rest by hand.

[hunter_chinchompa]
// OSRS npc 2910
name=Chinchompa
model1=npc_hunter_chinchompa_1
readyanim=osrs_seq_5182
walkanim=osrs_seq_5181
wanderrange=5
respawnrate=50
// op2=Attack - OSRS lets you fight them; nothing here gives them combat, so no dead op.
vislevel=1

[hunter_chinchompa_red]
// OSRS npc 2911
name=Carnivorous chinchompa
model1=npc_hunter_chinchompa_red_1
readyanim=osrs_seq_5182
walkanim=osrs_seq_5181
wanderrange=5
respawnrate=50
// op2=Attack - OSRS lets you fight them; nothing here gives them combat, so no dead op.
vislevel=2
attack=2
defence=2
strength=2
hitpoints=1
ranged=2
magic=2

[hunter_ferret]
