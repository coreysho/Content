// Hunter's catches as weapons, and the herb tar that feeds a salamander (2026-09-25). OSRS's numbers
// throughout - the OSRS wiki's salamander, chinchompa and tar pages, and the OSRS cache's own obj params
// where the wiki gives a figure (they agree). See scripts/hunter_salamander.rs2, hunter_chinchompa.rs2 and
// hunter_tar.rs2.

// SALAMANDERS: to wield, this level in Attack, Ranged AND Magic.
^salamander_swamp_lizard_level = 30
^salamander_orange_level = 50
^salamander_red_level = 60
^salamander_black_level = 70
// The "magic damage bonus" the wiki gives each (invisible in the equipment stats; OSRS obj param 65):
// Blaze's max hit is floor(0.5 + Magic * (64 + bonus) / 640).
^salamander_swamp_lizard_magic = 56
^salamander_orange_magic = 59
^salamander_red_magic = 77
^salamander_black_magic = 92
// Scorch and Blaze swing every 5 ticks, Flare every 4.
^salamander_rate = 5
^salamander_flare_rate = 4

// CHINCHOMPAS. Accuracy by fuse and distance, as a percentage of the attack roll (Mod Ash, 2016 and
// 2018; the wiki's table): distance bands 0-3, 4-6 and 7+ tiles.
//                 0-3   4-6   7+
//   Short fuse    100    75    50
//   Medium fuse    75   100    75
//   Long fuse      50    75   100
^chinchompa_band_near = 3
^chinchompa_band_mid = 6
// the whole 3x3 is hit, up to this many targets in all - 11 at monsters, 9 at players (OSRS)
^chinchompa_max_npcs = 11
^chinchompa_max_players = 9

// HERB TAR: 15 swamp tar and one clean herb make 15 tar, with a pestle and mortar in the pack.
^tar_batch = 15
^guam_tar_level = 19
^guam_tar_xp = 300
^marrentill_tar_level = 31
^marrentill_tar_xp = 425
^tarromin_tar_level = 39
^tarromin_tar_xp = 550
^harralander_tar_level = 44
^harralander_tar_xp = 725
