// ---------------------------------------------------------------------------------------------
// KARAMJA (2026-09-25). The Karamja hunter area, west of Shilo Village: five pits and the horned
// graahks - the one Hunter creature OSRS keeps on Karamja (the wiki's Karamja Hunter area page lists
// nothing else, and none of the butterflies, birds or box-trap prey is placed there). Pitfall
// trapping, exactly as the spined larupia's at Feldip: spiked logs over a pit (a knife and logs), a
// tease with a teasing stick, and a jump with the graahk on your heels. See configs/hunter_karamja.loc
// for the ground and scripts/hunter_karamja.rs2 for what is the graahk's own.
//
// OSRS's numbers: Hunter 41, 240 xp, big bones and graahk fur. Like the larupia's, the catch here is
// the fur and the bones; OSRS's raw graahk came with the 2022 rumours and is not 2006.
^hunter_graahk_level = 41
^hunter_graahk_xp = 2400
// The roll, in the larupia's shape (OSRS publishes no pitfall rates): about 44% at the unlock level,
// as the larupia is at its 31, and most of the way there by 99.
^hunter_graahk_low = 40
^hunter_graahk_high = 220
// What a pit holding a graahk pays (~hunter_catch_pay). Karamja's catches are numbered from 40, so the
// Hunter rounds being built alongside this one cannot pick the same number.
^hunter_catch_graahk = 40
