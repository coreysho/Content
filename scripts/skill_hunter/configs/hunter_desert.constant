// Hunter in the Kharidian desert (2026-09-25): the Uzer hunter area's golden warbler and desert devil,
// and the Nardah Hunter Shop. The area's orange salamanders are the net traps' (hunter.constant).
// See scripts/hunter_desert.rs2.

// GOLDEN WARBLER - bird snare, OSRS's Hunter 5 and 47 xp; bones, raw bird meat and yellow feathers. Ten
// of them, at the OSRS wiki's spawn points: six at the north end of the hunter area (m53_49) and four
// among the young trees at the south end (m53_48).
^hunter_warbler_level = 5
^hunter_warbler_xp = 470
// The roll is OSRS's own: the wiki's skilling-success chart for the golden warbler is low 92, high 400
// (36% at level 1, 41% at its level 5, certain from 53), which is exactly what stat_random takes.
^hunter_warbler_low = 92
^hunter_warbler_high = 400
// What a warbler snare holds, for ~hunter_catch_pay/~hunter_catch_room. 40 and up is this round's block,
// so it cannot meet another area's new catch numbers.
^hunter_catch_golden_warbler = 40

// DESERT DEVIL - tracking, OSRS's Hunter 13 and 66 xp; bones and desert devil fur. The trail starts at
// one of the area's two burrows, runs through its cacti and rockslides, and ends in disturbed sand - the
// fifteen nodes and six hiding spots 474 placed (configs/hunter_desert.enum). OSRS's trail passes through
// at least five nodes, the burrow among them, before the hiding spot: so three or four connectors here.
^hunter_devil_level = 13
^hunter_devil_xp = 660
^hunter_devil_hops_min = 3
^hunter_devil_hops_extra = 1
// Not OSRS's: it publishes no rate for a noose. The Feldip weasel's shape (hunter.constant), a little
// harder, as the devil is six levels further on.
^hunter_devil_low = 130
^hunter_devil_high = 245
