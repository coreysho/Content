// The polar kebbit tracking ground on the Rellekka plateau (m42_59, level 1), read off the imported map:
// every hole, tunnel and hollow log a trail can pass through (anchor tiles), and every snow drift a
// kebbit can end up in. Regenerate from the map rather than by hand if the map changes - a coord here
// with no loc on it is a trail step nobody can inspect.

[hunter_polar_track_nodes]
inputtype=int
outputtype=coord
// the two holes
val=0,1_42_59_23_54
val=1,1_42_59_29_43
// tunnels
val=2,1_42_59_23_43
val=3,1_42_59_27_44
val=4,1_42_59_26_45
val=5,1_42_59_33_51
val=6,1_42_59_30_53
val=7,1_42_59_30_56
// hollow logs
val=8,1_42_59_24_39
val=9,1_42_59_20_49
val=10,1_42_59_25_51

[hunter_polar_track_drifts]
inputtype=int
outputtype=coord
val=0,1_42_59_20_43
val=1,1_42_59_24_55
val=2,1_42_59_28_51
val=3,1_42_59_30_44
