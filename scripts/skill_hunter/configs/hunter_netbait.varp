// NET TRAP BAIT (scripts/hunter_netbait.rs2).

// Which trap slots hold a BAITED net trap: bit slot-1, one per ^hunter_trap slot, as %hunter_imp_bait is
// for magic boxes. Tar used on your own set trap sets it; the trap's next spring takes the bait, caught or
// not, and setting a trap in the slot clears it. Temp, like the slots themselves (configs/hunter_trap.varp).
[hunter_net_bait]
scope=temp
