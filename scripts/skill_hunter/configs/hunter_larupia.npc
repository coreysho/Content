// OSRS npcs imported by tools/models/importosrsnpc.py. Models re-encoded by osrs2ob2.py with
// the npc recolours baked in; stats and level from the cache, the rest by hand.

[hunter_spined_larupia]
// OSRS npc 2908
name=Spined larupia
model1=npc_hunter_spined_larupia_1
size=2
readyanim=osrs_seq_5225
walkanim=osrs_seq_5226
// Wanders one tile, not more. NPCs move naively - a straight step toward their target, stopped by
// the first obstacle - and each larupia spawns where it can step all the way to its pit's take-off
// tile; drifting three tiles let it end up behind a blocked tile it could never chase past (the
// live test found one stuck at 2543,2902, straight south of the take-off with a tree between).
wanderrange=1
respawnrate=50
op1=Tease
// Its combat stats are the cache's, and are only its level: it has no Attack op and nothing here
// fights it. Teased, it follows (npc_setmode(playerfollow)) rather than attacks.
vislevel=40
attack=40
defence=28
strength=40
hitpoints=28
ranged=1
magic=1
