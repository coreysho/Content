// OSRS loc imported by tools/models/importosrslocs.py (osrslocimport.py); model re-encoded by
// osrs2ob2.py with the loc recolours baked in.
//
// The horned graahk's pitfall catch. The spiked and collapsed pits are the Feldip ones
// (hunter_pit.loc) - OSRS gives every pit the same three: 19227, 19228, 19229/19230. Where the
// pits differ is the animal, and 474's Karamja pit multiloc (19264) says which states the graahk
// has: [19227, 19228, 19229, 19231, 19234]. 19231 is the graahk standing over the pit, 19234 the
// graahk down in it on OSRS's one dark pit model - the caught state, and the one used here.

[hunter_pit_graahk]
// OSRS loc 19234
name=Collapsed trap
model=osrsloc_19234
model2=osrsloc_19234_2
active=yes
ambient=12
contrast=60
op2=Dismantle
