// Net traps: the tar each creature takes as bait, keyed by ^hunter_net_<colour> (0 swamp, 1 orange, 2 red,
// 3 black) - the OSRS wiki's net trap page, "Preferred bait". See scripts/hunter_netbait.rs2.

[hunter_net_bait]
inputtype=int
outputtype=obj
default=null
val=0,guam_tar
val=1,marrentill_tar
val=2,tarromin_tar
val=3,harralander_tar
