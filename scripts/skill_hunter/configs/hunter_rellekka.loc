// The Rellekka creatures' trap states. OSRS locs imported by tools/models/importosrslocs.py
// (osrslocimport.py), --no-anim: each plays the animation an earlier round already converted for the
// same trap (the snare's 5173/5174, the deadfall's 5195). Models re-encoded by osrs2ob2.py with the loc
// recolours baked in.

[hunter_snare_catching_twitch]
// OSRS loc 9374
name=Bird snare
model=osrsloc_9374
model2=osrsloc_9374_2
blockwalk=no
blockrange=no
active=yes
ambient=20
anim=osrsloc_anim_5173

[hunter_snare_caught_twitch]
// OSRS loc 9375
name=Bird snare
model=osrsloc_9375
model2=osrsloc_9375_2
blockwalk=no
blockrange=no
active=yes
ambient=20
op1=Check
anim=osrsloc_anim_5174

[hunter_deadfall_sabretooth]
// OSRS loc 19851 - the capture, told from 20131/20129 by its recolours, which match the sabre-toothed
// kebbit npc's (1347). OSRS ships it opless; Check is added, as on the Feldip deadfalls.
name=Deadfall
model=osrsloc_19851
model2=osrsloc_19851_2
model3=osrsloc_19851_3
model4=osrsloc_19851_4
width=2
blockrange=no
mapscene=71
anim=osrsloc_anim_5195
op1=Check

[hunter_pit_kyatt]
// OSRS loc 19233 - one of the Rellekka pits' own states (its multiloc children are 19227, 19228, 19229,
// 19233, 19236): the spiked pit with a kyatt in it.
name=Collapsed trap
model=osrsloc_19233
model2=osrsloc_19233_2
active=yes
ambient=12
contrast=60
op2=Dismantle

// 474 puts 377's dagannoth_caveentrance_ice (8930) at the foot of the plateau's north-east cliff, for the
// Eagles' Peak cave (2008). That loc's Enter is wired - to the Waterbirth dungeon - so it is placed as this
// copy instead, with the op left out until the eagles' cave exists.
[hunter_rellekka_cave_entrance]
name=Cave entrance
desc=It looks cold in there.
model=caveentrance
recol1s=10400
recol1d=30653
recol2s=8288
recol2d=23254
recol3s=6176
recol3d=15855
recol4s=4096
recol4d=9513
recol5s=2048
recol5d=4228
width=4
length=2
offsetx=0
offsety=80
offsetz=0
// op1=Enter
forceapproach=south
