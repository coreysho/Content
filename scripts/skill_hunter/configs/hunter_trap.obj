// Imported from a modern OSRS cache by tools/models/importosrs.py.
// Models are RE-ENCODED from OSRS model format into the 317-family format
// (tools/models/osrs2ob2.py); every one is round-trip verified before writing.
// wearpos/wearpos2/wearpos3 come from the cache - do not hand-edit them.

[hunter_box_trap]
name=Box trap
desc=If a creature goes inside, the box should then slam shut.
model=obj_hunter_box_trap
2dzoom=2345
2dxan=180
2dyan=747
2dzan=1535
2dxof=15
2dyof=-100
cost=32
members=yes
stackable=yes
// op4 (Lay, from the ground) is OSRS's too, but it lays the trap where the obj lies rather than
// where you stand, and nothing here handles it yet - commented out rather than left dead.
// op4=Lay
op5=hidden
iop1=Lay

[chinchompa]
name=Chinchompa
desc=Handle with care.
model=obj_chinchompa
manwear=obj_chinchompa_manwear,0
womanwear=obj_chinchompa_womanwear,6
wearpos=righthand
2dzoom=1000
2dxan=284
2dyan=1800
2dxof=1
2dyof=27
weight=20g
cost=140
members=yes
stackable=yes
// Wield: OSRS's thrown explosive - Short, Medium and Long fuse, and a 3x3 splash in multi-combat, in
// scripts/hunter_chinchompa.rs2. A thrown weapon to everything else (the tab, the bans on Entrana).
// Bonuses, level, speed (4, 3 on Medium fuse) and reach (9, 10 on Long fuse) are OSRS's; the throw,
// the stance and the sounds are the 377 cache's own chinchompa ones.
iop2=Wield
category=weapon_thrown
param=rangeattack,45
param=levelrequire,45
param=attackrate,4
param=attackrange,9
param=rangeattack_anim,human_chinchompa_attack
param=rangeattack_sound,chinchompa_attack
param=proj_travel,chinchompa_travel
param=defend_anim,human_chinchompa_defend
param=ready_baseanim,human_chinchompa_ready
param=walk_f_baseanim,human_chinchompa_walk
param=walk_b_baseanim,human_chinchompa_walk
param=walk_l_baseanim,human_chinchompa_walk
param=walk_r_baseanim,human_chinchompa_walk
param=running_baseanim,human_chinchompa_run

