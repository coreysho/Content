// Imported from a modern OSRS cache by tools/models/importosrs.py.
// Models are RE-ENCODED from OSRS model format into the 317-family format
// (tools/models/osrs2ob2.py); every one is round-trip verified before writing.
// wearpos/wearpos2/wearpos3 come from the cache - do not hand-edit them.

[hunter_box_trap]
name=Box trap
desc=If a creature goes inside, the box should then slam shut.
model=obj_hunter_box_trap
2dzoom=2345
2dxan=180
2dyan=747
2dzan=1535
2dxof=15
2dyof=-100
cost=32
members=yes
stackable=yes
// op4 (Lay, from the ground) is OSRS's too, but it lays the trap where the obj lies rather than
// where you stand, and nothing here handles it yet - commented out rather than left dead.
// op4=Lay
op5=hidden
iop1=Lay

