// Hunter - the black warlock (2026-09-25): OSRS's level-45 butterfly, 54 xp, one of the four the skill
// shipped with in 2006, on the Feldip hunting grounds at the wiki's seven spawn points
// (configs/hunter_warlock.npc). Netted as every butterfly here is (hunter_butterflies.rs2), into a jar if
// there is one; let out of the jar it boosts Strength by 4 + 15%, as OSRS's does - the Rellekka
// butterflies' pattern (hunter_rellekka.rs2).

[opnpcu,hunter_black_warlock]
@hunter_net_butterfly(^hunter_warlock_level, ^hunter_warlock_xp, ^hunter_warlock_low, ^hunter_warlock_high, "black warlock", black_warlock);

[opheld4,black_warlock]
inv_del(inv, black_warlock, 1);
inv_add(inv, hunter_butterfly_jar, 1);
stat_boost(strength, ^hunter_warlock_boost, ^hunter_warlock_boost_pct);
mes("You release the black warlock. The air shimmers as it goes, and you feel stronger.");
