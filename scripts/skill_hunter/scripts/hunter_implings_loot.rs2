// IMPLING JARS' LOOT - written out mechanically from the OSRS wiki's impling jar pages (Baby impling jar ..
// Dragon impling jar: their Main drops and Tertiary tables, rates as the wiki gives them, each row's
// wiki name in its comment). A change belongs on the wiki's numbers: check the page before editing a row.
//
// A table is one random() over the sum of its rates, walked as the drop tables walk theirs (a ladder of
// thresholds, as drop_tables/scripts/*.rs2 do). An item this build does not have is left out and the
// roll goes to the rest of the table - what OSRS does for the dragon javelin tips a player without
// Monkey Madness II cannot have (Mod Ash, 20 May 2020: "It rolls for the remaining items on their
// table if you can't have that one"). "(noted)" is the cert. Tertiaries are the clue scrolls, through
// ~impling_clue (the drop tables' ~trail_cluedrop, into your pack); the beginner and elite tiers are
// not in this build, so those two rolls are not made.

[proc,impling_loot](int $tier)
switch_int ($tier) {
    case 1 : ~impling_loot_baby;
    case 2 : ~impling_loot_young;
    case 3 : ~impling_loot_gourmet;
    case 4 : ~impling_loot_earth;
    case 5 : ~impling_loot_essence;
    case 6 : ~impling_loot_eclectic;
    case 7 : ~impling_loot_nature;
    case 8 : ~impling_loot_magpie;
    case 9 : ~impling_loot_ninja;
    case 10 : ~impling_loot_dragon;
    case 11 : ~impling_loot_lucky;
}

// Baby impling jar. Not in this build, so left out: Clue scroll (beginner) (tertiary).
[proc,impling_loot_baby]
~impling_clue(^trail_tier_easy, 100);
def_int $roll = random(100);
if ($roll < 10) {
    ~impling_give(chisel, 1);   // Chisel
} else if ($roll < 20) {
    ~impling_give(thread, 1);   // Thread
} else if ($roll < 30) {
    ~impling_give(needle, 1);   // Needle
} else if ($roll < 40) {
    ~impling_give(knife, 1);   // Knife
} else if ($roll < 50) {
    ~impling_give(cheese, 1);   // Cheese
} else if ($roll < 60) {
    ~impling_give(hammer, 1);   // Hammer
} else if ($roll < 70) {
    ~impling_give(ball_of_wool, 1);   // Ball of wool
} else if ($roll < 80) {
    ~impling_give(anchovies, 1);   // Anchovies
} else if ($roll < 90) {
    // nothing   // Nothing
} else if ($roll < 91) {
    ~impling_give(spicespot, 1);   // Spice
} else if ($roll < 92) {
    ~impling_give(flax, 1);   // Flax
} else if ($roll < 93) {
    ~impling_give(mud_pie, 1);   // Mud pie
} else if ($roll < 94) {
    ~impling_give(seaweed, 1);   // Seaweed
} else if ($roll < 95) {
    ~impling_give(air_talisman, 1);   // Air talisman
} else if ($roll < 96) {
    ~impling_give(silver_bar, 1);   // Silver bar
} else if ($roll < 97) {
    ~impling_give(sapphire, 1);   // Sapphire
} else if ($roll < 98) {
    ~impling_give(hard_leather, 1);   // Hard leather
} else if ($roll < 99) {
    ~impling_give(lobster, 1);   // Lobster
} else {
    ~impling_give(softclay, 1);   // Soft clay
}

