// Dragon impling jar. Not in this build, so left out: Dragonstone bolt tips, Dragonstone bolt tips, Dragon arrow, Dragonstone bolts, Dragon dart, Dragon dart tip, Dragon arrowtips, Dragon javelin tips, Clue scroll (elite) (tertiary).
[proc,impling_loot_dragon]
def_int $roll = random(11);
if ($roll < 1) {
    ~impling_give(mystic_robe_bottom, 1);   // Mystic robe bottom
} else if ($roll < 2) {
    ~impling_give(cert_amulet_of_glory, 3);   // Amulet of glory (noted)
} else if ($roll < 3) {
    ~impling_give(cert_strung_dragonstone_amulet, 2);   // Dragonstone amulet (noted)
} else if ($roll < 4) {
    ~impling_give(dragon_longsword, 1);   // Dragon longsword
} else if ($roll < 5) {
    ~impling_give(cert_dragon_dagger_p++, 3);   // Dragon dagger(p++) (noted)
} else if ($roll < 6) {
    ~impling_give(cert_dragonstone, 3);   // Dragonstone (noted)
} else if ($roll < 7) {
    ~impling_give(cert_babydragon_bones, calc(100 + random(201)));   // Babydragon bones (noted)
} else if ($roll < 8) {
    ~impling_give(cert_dragon_bones, calc(50 + random(51)));   // Dragon bones (noted)
} else if ($roll < 9) {
    ~impling_give(magic_tree_seed, 1);   // Magic seed
} else if ($roll < 10) {
    ~impling_give(snapdragon_seed, 6);   // Snapdragon seed
} else {
    ~impling_give(cert_summer_pie, 15);   // Summer pie (noted)
}

