// Hunter skill guide, on the original RS2 skill guide interface (see
// scripts/interfaces/skill_guide.rs2 for the generic driver).
//
// Butterfly netting, then box trapping. The netting rows show the jar each species goes into,
// which is the thing the row actually gets you - the butterflies are npcs and have no obj of their
// own. The box-trap rows show the catch itself, and the trap at the level it becomes usable.
[proc,open_hunter_guide]
~skillguide_begin(^guide_hunter, "Hunter");
def_int $lvl = stat(hunter);
~skillguide_row(1, $lvl, ^hunter_butterfly_level, hunter_jar_butterfly, "Butterfly");
~skillguide_row(2, $lvl, ^hunter_viceroy_level, hunter_jar_viceroy, "Viceroy");
~skillguide_row(3, $lvl, ^hunter_bluemorpo_level, hunter_jar_bluemorpo, "Blue Morpho");
~skillguide_row(4, $lvl, ^hunter_swallowtail_level, hunter_jar_swallowtail, "Tiger Swallowtail");
~skillguide_row(5, $lvl, ^hunter_boxtrap_level, hunter_box_trap, "Box trap");
~skillguide_row(6, $lvl, ^hunter_ferret_level, ferret, "Ferret");
~skillguide_row(7, $lvl, ^hunter_chinchompa_level, chinchompa, "Chinchompa");
~skillguide_row(8, $lvl, ^hunter_chinchompa_red_level, red_chinchompa, "Carnivorous chinchompa");
~skillguide_show;
