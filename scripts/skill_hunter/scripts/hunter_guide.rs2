~skillguide_row(2, $lvl, ^hunter_ferret_level, ferret, "Ferret");
~skillguide_row(3, $lvl, ^hunter_chinchompa_level, chinchompa, "Chinchompa");
~skillguide_row(4, $lvl, ^hunter_chinchompa_red_level, red_chinchompa, "Carnivorous chinchompa");
~skillguide_row(5, $lvl, ^hunter_magicbox_level, magic_box, "Magic box");
~skillguide_row(6, $lvl, ^hunter_imp_level, imp_box_2, "Imp");

