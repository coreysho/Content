~skillguide_row(2, $lvl, ^hunter_larupia_level, larupia_fur, "Spined larupia");
~skillguide_row(3, $lvl, ^hunter_graahk_level, graahk_fur, "Horned graahk");
~skillguide_row(4, $lvl, ^hunter_kyatt_level, kyatt_fur, "Sabre-toothed kyatt");

