// Hunter skill guide, on the original RS2 skill guide interface (see
// scripts/interfaces/skill_guide.rs2 for the generic driver).
//
// Grouped by method - butterfly netting, bird snares, box traps - each opening with its trap. The
// netting rows show the jar each species goes into, the snare rows the bird's feather (the catch
// itself is an npc), and the box-trap rows the animal you keep.
[proc,open_hunter_guide]
~skillguide_begin(^guide_hunter, "Hunter");
def_int $lvl = stat(hunter);
~skillguide_row(1, $lvl, ^hunter_butterfly_level, hunter_jar_butterfly, "Butterfly");
~skillguide_row(2, $lvl, ^hunter_viceroy_level, hunter_jar_viceroy, "Viceroy");
~skillguide_row(3, $lvl, ^hunter_bluemorpo_level, hunter_jar_bluemorpo, "Blue Morpho");
~skillguide_row(4, $lvl, ^hunter_swallowtail_level, hunter_jar_swallowtail, "Tiger Swallowtail");
~skillguide_row(5, $lvl, ^hunter_snare_level, hunter_bird_snare, "Bird snare");
~skillguide_row(6, $lvl, ^hunter_swift_level, red_feather, "Crimson swift");
~skillguide_row(7, $lvl, ^hunter_wagtail_level, stripy_feather, "Tropical wagtail");
~skillguide_row(8, $lvl, ^hunter_boxtrap_level, hunter_box_trap, "Box trap");
~skillguide_row(9, $lvl, ^hunter_ferret_level, ferret, "Ferret");
~skillguide_row(10, $lvl, ^hunter_chinchompa_level, chinchompa, "Chinchompa");
~skillguide_row(11, $lvl, ^hunter_chinchompa_red_level, red_chinchompa, "Carnivorous chinchompa");
~skillguide_show;
