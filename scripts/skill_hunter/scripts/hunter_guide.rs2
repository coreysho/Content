// Hunter skill guide, on the original RS2 skill guide interface (see
// scripts/interfaces/skill_guide.rs2 for the generic driver).
//
// ONE PAGE PER METHOD, as the other big guides are paged: with Piscatoris, Rellekka, Karamja, the
// desert and imps in, Hunter had 43 rows and the list holds 40. Each page is in level order and opens
// with what the method is done with - the noose wand, the snare, the net, the logs for a deadfall,
// the box, the net trap, the teasing stick, the falconer's glove. The creature rows show what you keep:
// a jar, a feather, a fur, claws, a spike, the animal itself.
[proc,open_hunter_guide]
%skillguide_page = 1;
~hunter_guide_render;

[proc,hunter_guide_render]
~skillguide_begin(^guide_hunter, "Hunter");
~skillguide_panels(8);
~skillguide_button(1, "Tracking");
~skillguide_button(2, "Bird snares");
~skillguide_button(3, "Butterflies");
~skillguide_button(4, "Deadfalls");
~skillguide_button(5, "Box traps");
~skillguide_button(6, "Net traps");
~skillguide_button(7, "Pitfalls");
~skillguide_button(8, "Falconry");
switch_int (%skillguide_page) {
    case 2 : ~hunter_guide_snares;
    case 3 : ~hunter_guide_butterflies;
    case 4 : ~hunter_guide_deadfalls;
    case 5 : ~hunter_guide_boxtraps;
    case 6 : ~hunter_guide_nettraps;
    case 7 : ~hunter_guide_pitfalls;
    case 8 : ~hunter_guide_falconry;
    case default : ~hunter_guide_tracking;
}
~skillguide_show;

[proc,hunter_guide_tracking]
def_int $lvl = stat(hunter);
~skillguide_row(1, $lvl, ^hunter_polar_kebbit_level, noose_wand, "Tracking");
~skillguide_row(2, $lvl, ^hunter_polar_kebbit_level, polar_kebbit_fur, "Polar kebbit");
~skillguide_row(3, $lvl, ^hunter_common_kebbit_level, common_kebbit_fur, "Common kebbit");
~skillguide_row(4, $lvl, ^hunter_weasel_level, feldip_weasel_fur, "Feldip weasel");
~skillguide_row(5, $lvl, ^hunter_devil_level, desert_devil_fur, "Desert devil");
~skillguide_row(6, $lvl, ^hunter_razorback_kebbit_level, long_kebbit_spike, "Razor-backed kebbit");

[proc,hunter_guide_snares]
def_int $lvl = stat(hunter);
~skillguide_row(1, $lvl, ^hunter_snare_level, hunter_bird_snare, "Bird snare");
~skillguide_row(2, $lvl, ^hunter_swift_level, red_feather, "Crimson swift");
~skillguide_row(3, $lvl, ^hunter_warbler_level, yellow_feather, "Golden warbler");
~skillguide_row(4, $lvl, ^hunter_longtail_level, orange_feather, "Copper longtail");
~skillguide_row(5, $lvl, ^hunter_twitch_level, blue_feather, "Cerulean twitch");
~skillguide_row(6, $lvl, ^hunter_wagtail_level, stripy_feather, "Tropical wagtail");

[proc,hunter_guide_butterflies]
def_int $lvl = stat(hunter);
~skillguide_row(1, $lvl, ^hunter_butterfly_level, hunter_jar_butterfly, "Butterfly");
~skillguide_row(2, $lvl, ^hunter_viceroy_level, hunter_jar_viceroy, "Viceroy");
~skillguide_row(3, $lvl, ^hunter_ruby_level, hunter_jar_ruby, "Ruby harvest");
~skillguide_row(4, $lvl, ^hunter_bluemorpo_level, hunter_jar_bluemorpo, "Blue Morpho");
~skillguide_row(5, $lvl, ^hunter_glacialis_level, sapphire_glacialis, "Sapphire glacialis");
~skillguide_row(6, $lvl, ^hunter_swallowtail_level, hunter_jar_swallowtail, "Tiger Swallowtail");
~skillguide_row(7, $lvl, ^hunter_snowyknight_level, snowy_knight, "Snowy knight");
~skillguide_row(8, $lvl, ^hunter_warlock_level, black_warlock, "Black warlock");
// Implings (hunter_implings.rs2): netted too, at the OSRS wiki's levels - the jar is what you keep.
~skillguide_row(9, $lvl, 17, baby_impling_jar, "Baby impling");
~skillguide_row(10, $lvl, 22, young_impling_jar, "Young impling");
~skillguide_row(11, $lvl, 28, gourmet_impling_jar, "Gourmet impling");
~skillguide_row(12, $lvl, 36, earth_impling_jar, "Earth impling");
~skillguide_row(13, $lvl, 42, essence_impling_jar, "Essence impling");
~skillguide_row(14, $lvl, 50, eclectic_impling_jar, "Eclectic impling");
~skillguide_row(15, $lvl, 58, nature_impling_jar, "Nature impling");
~skillguide_row(16, $lvl, 65, magpie_impling_jar, "Magpie impling");
~skillguide_row(17, $lvl, 74, ninja_impling_jar, "Ninja impling");
~skillguide_row(18, $lvl, 83, dragon_impling_jar, "Dragon impling");
~skillguide_row(19, $lvl, 89, lucky_impling_jar, "Lucky impling");

[proc,hunter_guide_deadfalls]
def_int $lvl = stat(hunter);
~skillguide_row(1, $lvl, ^hunter_deadfall_level, logs, "Deadfall");
~skillguide_row(2, $lvl, ^hunter_wild_kebbit_level, kebbit_claws, "Wild kebbit");
~skillguide_row(3, $lvl, ^hunter_barbtailed_kebbit_level, barbtail_harpoon, "Barb-tailed kebbit");
~skillguide_row(4, $lvl, ^hunter_prickly_kebbit_level, kebbit_spike, "Prickly kebbit");
~skillguide_row(5, $lvl, ^hunter_sabretooth_kebbit_level, kebbit_teeth, "Sabre-toothed kebbit");

