// Hunter skill guide, on the original RS2 skill guide interface (see
// scripts/interfaces/skill_guide.rs2 for the generic driver).
//
// Four rows, because butterfly netting is all there is in the skill so far. Every row shows the
// small fishing net in the icon column, since the net is what the row is telling you to use and
// the butterflies have no obj of their own - they are npcs, and a catch currently yields no item.
[proc,open_hunter_guide]
~skillguide_begin(^guide_hunter, "Hunter");
def_int $lvl = stat(hunter);
~skillguide_row(1, $lvl, ^hunter_butterfly_level, net, "Butterfly");
~skillguide_row(2, $lvl, ^hunter_viceroy_level, net, "Viceroy");
~skillguide_row(3, $lvl, ^hunter_bluemorpo_level, net, "Blue Morpho");
~skillguide_row(4, $lvl, ^hunter_swallowtail_level, net, "Tiger Swallowtail");
~skillguide_show;
