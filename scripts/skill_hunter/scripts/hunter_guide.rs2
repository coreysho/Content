~skillguide_row(2, $lvl, ^hunter_swamp_lizard_level, swamp_lizard, "Swamp lizard");
~skillguide_row(3, $lvl, ^hunter_orange_salamander_level, orange_salamander, "Orange salamander");
~skillguide_row(4, $lvl, ^hunter_red_salamander_level, red_salamander, "Red salamander");
~skillguide_row(5, $lvl, ^hunter_black_salamander_level, black_salamander, "Black salamander");

