// ::hunter [xp] - a small fishing net, a butterfly jar and some Hunter experience, so netting can
// be tried at every tier without an afternoon of swinging.
//
// Bare `::hunter` grants enough to clear the Tiger Swallowtail's level 35; `::hunter 500` grants
// 50 xp, in the same x10 form stat_advance takes everywhere else. A debugproc needs staff level 4
// (ClientCheatHandler), and this build currently allows them in production - see the note there.
[debugproc,hunter](int $xp)
if (inv_total(inv, net) = 0) {
    if (inv_freespace(inv) < 1) {
        mes("No room for a net.");
        return;
    }
    inv_add(inv, net, 1);
}
// One jar too, so the jarred branch can be tried without twenty Crafting levels and a furnace.
if (inv_total(inv, hunter_butterfly_jar) = 0 & inv_freespace(inv) > 0) {
    inv_add(inv, hunter_butterfly_jar, 1);
}
def_int $grant = $xp;
if ($grant <= 0) {
    $grant = ^hunter_debug_xp;
}
// Straight to the stat rather than through ~hunter_xp: this is a test grant, not a skilling
// action, and it should not roll for a Guild hunter piece.
stat_advance(hunter, $grant);
mes("Hunter is now <tostring(stat(hunter))>. Use the net on a butterfly.");

// ::feldip - to the Feldip hunting grounds with five box traps, for trying the trap loop. Lands in
// the grey chinchompas' clearing; the ferrets are north-west of it and the carnivorous chinchompas
// north-east. Pair with ::hunter 250000 (level 60, three traps) or more to catch all three.
[debugproc,feldip]
if (p_finduid(uid) = false) {
    return;
}
if (inv_total(inv, hunter_box_trap) < 5) {
    if (inv_itemspace(inv, hunter_box_trap, 5, inv_size(inv)) = false) {
        mes("No room for the traps.");
        return;
    }
    inv_add(inv, hunter_box_trap, calc(5 - inv_total(inv, hunter_box_trap)));
}
p_telejump(0_40_45_10_7);
