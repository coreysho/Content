// What each attackable npc drops, for the viewer an examine opens (scripts/npc_drops.rs2). The rows
// are generated from the death scripts by tools/gennpcdrops.py (npc_drops.dbrow); one row per
// distinct table, found by db_find on any npc that shares it.
[npc_drops]
column=npc,npc,LIST,INDEXED,REQUIRED
// obj (the icon), name as shown, amount ("5" or "2-8"), rarity ("Always" or "1/N")
column=drop,namedobj,string,string,string,LIST
// what the game-mode drop-rate boost rolls (gamemodes/scripts/droprate.rs2): obj, least, most,
// chance in ten million, kind (0 the obj, 1 a pet, 2-4 an easy/medium/hard clue)
column=bonus,namedobj,int,int,int,int,LIST
