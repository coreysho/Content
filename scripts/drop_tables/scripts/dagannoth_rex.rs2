// Dagannoth Rex drop table - Waterbirth Island Dungeon
// Rates adapted from https://oldschool.runescape.wiki/w/Dagannoth_Rex, with anachronistic/absent
// content stripped out for this server's 2006 target:
//  - rock-shell plate/legs, Fremennik blade/shield/helm: NOT present anywhere in the 377 cache
//    (checked against _unpack/377/all.obj) - these appear to be later drop table additions, not
//    original Nov 2005 launch drops, so they're excluded rather than invented.
//  - ensouled dagannoth head, Konar brimstone key, Combat Achievements rate bonus, pet Dagannoth Rex:
//    all confirmed OSRS-only additions from 2013+ with no equivalent at this server's revision.
//  - elite clue scroll: excluded (hard clue only - see below); ensouled heads/Konar have no reasonable
//    2006 substitute so they're dropped rather than reskinned.
// Follows the same structure as king_black_dragon.rs2 (bespoke ai_queue3 override + weighted
// random(128) cascade), not the roll_on_drop_table/dbrow system.

[ai_queue3,dagcave_melee_boss]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}
// Default drop
obj_add(npc_coord, dagannoth_king_bones, 1, ^lootdrop_duration);

~trail_hardcluedrop(^trail_hard_droprate, npc_coord);

def_int $random = random(128);

if ($random < 17) { // osrs
    obj_add(npc_coord, steel_kiteshield, 1, ^lootdrop_duration);
} else if ($random < 28) { // osrs
    obj_add(npc_coord, mithril_warhammer, 1, ^lootdrop_duration);
} else if ($random < 35) { // osrs
    obj_add(npc_coord, cert_adamant_axe, 1, ^lootdrop_duration);
} else if ($random < 39) { // osrs
    obj_add(npc_coord, steel_platebody, 1, ^lootdrop_duration);
} else if ($random < 42) { // osrs
    obj_add(npc_coord, mithril_pickaxe, 1, ^lootdrop_duration);
} else if ($random < 44) { // osrs
    obj_add(npc_coord, adamant_platebody, 1, ^lootdrop_duration);
} else if ($random < 45) { // osrs (replaces "Fremennik blade", absent from this cache)
    obj_add(npc_coord, mithril_2h_sword, 1, ^lootdrop_duration);
} else if ($random < 46) { // osrs (replaces "Fremennik shield", absent from this cache)
    obj_add(npc_coord, ring_of_life, 1, ^lootdrop_duration);
} else if ($random < 47) { // osrs
    obj_add(npc_coord, cert_dragon_axe, 1, ^lootdrop_duration);
} else if ($random < 48) { // osrs
    obj_add(npc_coord, cert_rune_axe, 1, ^lootdrop_duration);
} else if ($random < 49) { // osrs - unique
    obj_add(npc_coord, berzerker_ring, 1, ^lootdrop_duration);
    broadcast_mes(append(append(displayname(), " received a rare drop: "), oc_name(berzerker_ring))); // Corey, 2026-09-04
} else if ($random < 50) { // osrs - unique
    obj_add(npc_coord, warrior_ring, 1, ^lootdrop_duration);
    broadcast_mes(append(append(displayname(), " received a rare drop: "), oc_name(warrior_ring))); // Corey, 2026-09-04
} else if ($random < 60) { // osrs (25 mithril ore, noted)
    obj_add(npc_coord, cert_mithril_ore, 25, ^lootdrop_duration);
} else if ($random < 63) { // osrs
    obj_add(npc_coord, adamantite_bar, ~random_range(1, 2), ^lootdrop_duration);
} else if ($random < 65) { // osrs (100 coal, noted)
    obj_add(npc_coord, cert_coal, 100, ^lootdrop_duration);
} else if ($random < 66) { // osrs (150 iron ore, noted)
    obj_add(npc_coord, cert_iron_ore, 150, ^lootdrop_duration);
} else if ($random < 67) { // osrs (15-30 steel bar, noted)
    obj_add(npc_coord, cert_steel_bar, ~random_range(15, 30), ^lootdrop_duration);
} else if ($random < 74) { // osrs
    obj_add(npc_coord, unidentified_ranarr, 1, ^lootdrop_duration);
} else if ($random < 81) { // osrs (5 raw bass)
    obj_add(npc_coord, bass, 5, ^lootdrop_duration);
} else if ($random < 85) { // osrs (5 raw swordfish)
    obj_add(npc_coord, swordfish, 5, ^lootdrop_duration);
} else if ($random < 86) { // osrs (5 raw shark)
    obj_add(npc_coord, shark, 5, ^lootdrop_duration);
} else if ($random < 100) { // gem table access, same rate band style as kbd
    obj_add(npc_coord, ~randomjewel, ^lootdrop_duration);
} else { // rare/ultra-rare table access
    obj_add(npc_coord, ~ultrarare_getitem, ^lootdrop_duration);
}
