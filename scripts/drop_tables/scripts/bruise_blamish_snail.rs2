// Bruise Blamish Snail - https://oldschool.runescape.wiki/w/Bruise_Blamish_Snail

[ai_queue3,mmsnailpoint_blue] @mmsnailpoint_blue_drop_table;
[ai_queue3,mmsnailround_blue] @mmsnailpoint_blue_drop_table;

[label,mmsnailpoint_blue_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

obj_add(npc_coord, shellpoint_blue, 1, ^lootdrop_duration);
obj_add(npc_coord, snail_corpse3, 1, ^lootdrop_duration);

