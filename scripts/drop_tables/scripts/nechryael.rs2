// Nechryael - https://oldschool.runescape.wiki/w/Nechryael

[ai_queue3,slayer_nechryael] @slayer_nechryael_drop_table;

[label,slayer_nechryael_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}
~slayer_nechryael_drop_table_loot; // the rolls themselves, so a superior can take three (skill_slayer/scripts/superiors.rs2)

[proc,slayer_nechryael_drop_table_loot]

~trail_hardcluedrop(^trail_hard_droprate, npc_coord);

def_int $dropint = random(512);
if ($dropint < 18) {
    obj_add(npc_coord, adamant_platelegs, 1, ^lootdrop_duration);
} else if ($dropint < 36) {
    obj_add(npc_coord, rune_2h_sword, 1, ^lootdrop_duration);
} else if ($dropint < 49) {
    obj_add(npc_coord, rune_full_helm, 1, ^lootdrop_duration);
} else if ($dropint < 58) {
    obj_add(npc_coord, adamant_kiteshield, 1, ^lootdrop_duration);
} else if ($dropint < 62) {
    obj_add(npc_coord, rune_armoured_boots, 1, ^lootdrop_duration);
} else if ($dropint < 97) {
    obj_add(npc_coord, chaosrune, 37, ^lootdrop_duration);
} else if ($dropint < 123) {
    obj_add(npc_coord, deathrune, calc(random(6) + 5), ^lootdrop_duration);
} else if ($dropint < 145) {
    obj_add(npc_coord, lawrune, calc(random(11) + 25), ^lootdrop_duration);
} else if ($dropint < 163) {
    obj_add(npc_coord, bloodrune, calc(random(6) + 15), ^lootdrop_duration);
} else if ($dropint < 189) {
    obj_add(npc_coord, limpwurt_seed, 1, ^lootdrop_duration);
} else if ($dropint < 207) {
    obj_add(npc_coord, softclay, 25, ^lootdrop_duration);
} else if ($dropint < 220) {
    obj_add(npc_coord, tuna, 1, ^lootdrop_duration);
} else if ($dropint < 277) {
    obj_add(npc_coord, coins, calc(random(500) + 1000), ^lootdrop_duration);
} else if ($dropint < 323) {
    obj_add(npc_coord, coins, calc(random(501) + 1500), ^lootdrop_duration);
} else if ($dropint < 349) {
    obj_add(npc_coord, coins, calc(random(500) + 2500), ^lootdrop_duration);
} else if ($dropint < 362) {
    obj_add(npc_coord, coins, calc(random(501) + 3000), ^lootdrop_duration);
} else if ($dropint < 373) {
    obj_add(npc_coord, coins, calc(random(500) + 500), ^lootdrop_duration);
} else if ($dropint < 377) {
    obj_add(npc_coord, coins, 5000, ^lootdrop_duration);
} else if ($dropint < 456) {
    obj_add(npc_coord, ~roll_general_seed_table(115), ^lootdrop_duration);
} else if ($dropint < 482) {
    obj_add(npc_coord, ~ultrarare_getitem, ^lootdrop_duration);
}

