// Ice warrior - https://oldschool.runescape.wiki/w/Ice_warrior

[ai_queue3,icewarrior_low_wanderrange] @icewarrior_low_wanderrange_drop_table;

[label,icewarrior_low_wanderrange_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

~trail_mediumcluedrop(^trail_medium_droprate, npc_coord);

def_int $dropint = random(128);
if ($dropint < 3) {
    obj_add(npc_coord, iron_battleaxe, 1, ^lootdrop_duration);
} else if ($dropint < 4) {
    obj_add(npc_coord, mithril_mace, 1, ^lootdrop_duration);
} else if ($dropint < 14) {
    obj_add(npc_coord, naturerune, 4, ^lootdrop_duration);
} else if ($dropint < 22) {
    obj_add(npc_coord, chaosrune, 3, ^lootdrop_duration);
} else if ($dropint < 29) {
    obj_add(npc_coord, lawrune, 2, ^lootdrop_duration);
} else if ($dropint < 34) {
    obj_add(npc_coord, cosmicrune, 2, ^lootdrop_duration);
} else if ($dropint < 39) {
    obj_add(npc_coord, mithril_arrow, 3, ^lootdrop_duration);
} else if ($dropint < 42) {
    obj_add(npc_coord, adamant_arrow, 2, ^lootdrop_duration);
} else if ($dropint < 45) {
    obj_add(npc_coord, deathrune, 2, ^lootdrop_duration);
} else if ($dropint < 46) {
    obj_add(npc_coord, bloodrune, 2, ^lootdrop_duration);
} else if ($dropint < 56) {
    obj_add(npc_coord, ~randomherb, ^lootdrop_duration);
} else if ($dropint < 74) {
    obj_add(npc_coord, ~roll_general_seed_table(57), ^lootdrop_duration);
} else if ($dropint < 113) {
    obj_add(npc_coord, coins, 15, ^lootdrop_duration);
} else if ($dropint < 116) {
    obj_add(npc_coord, ~ultrarare_getitem, ^lootdrop_duration);
}
