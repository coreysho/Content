// Vampyre Juvinate - https://oldschool.runescape.wiki/w/Vampyre_Juvinate

[ai_queue3,burgh_vampire_juve_1] @burgh_vampire_juve_1_drop_table;
[ai_queue3,burgh_vampire_juve_2] @burgh_vampire_juve_1_drop_table;
[ai_queue3,burgh_vampire_juve_3] @burgh_vampire_juve_1_drop_table;
[ai_queue3,burgh_vampire_juve_4] @burgh_vampire_juve_1_drop_table;

[label,burgh_vampire_juve_1_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

obj_add(npc_coord, vampire_dust, 1, ^lootdrop_duration);

~trail_mediumcluedrop(^trail_medium_droprate, npc_coord);

def_int $dropint = random(512);
if ($dropint < 2) {
    obj_add(npc_coord, staff_of_air, 1, ^lootdrop_duration);
} else if ($dropint < 6) {
    obj_add(npc_coord, staff_of_water, 1, ^lootdrop_duration);
} else if ($dropint < 8) {
    obj_add(npc_coord, staff_of_earth, 1, ^lootdrop_duration);
} else if ($dropint < 12) {
    obj_add(npc_coord, staff_of_fire, 1, ^lootdrop_duration);
} else if ($dropint < 22) {
    obj_add(npc_coord, black_spear, 1, ^lootdrop_duration);
} else if ($dropint < 30) {
    obj_add(npc_coord, black_battleaxe, 1, ^lootdrop_duration);
} else if ($dropint < 38) {
    obj_add(npc_coord, black_2h_sword, 1, ^lootdrop_duration);
} else if ($dropint < 44) {
    obj_add(npc_coord, mithril_battleaxe, 1, ^lootdrop_duration);
} else if ($dropint < 50) {
    obj_add(npc_coord, mithril_2h_sword, 1, ^lootdrop_duration);
} else if ($dropint < 84) {
    obj_add(npc_coord, mithril_scimitar, 1, ^lootdrop_duration);
} else if ($dropint < 104) {
    obj_add(npc_coord, mithril_longsword, 1, ^lootdrop_duration);
} else if ($dropint < 110) {
    obj_add(npc_coord, mithril_warhammer, 1, ^lootdrop_duration);
} else if ($dropint < 130) {
    obj_add(npc_coord, adamant_axe, 1, ^lootdrop_duration);
} else if ($dropint < 136) {
    obj_add(npc_coord, adamant_sword, 1, ^lootdrop_duration);
} else if ($dropint < 154) {
    obj_add(npc_coord, adamant_mace, 1, ^lootdrop_duration);
} else if ($dropint < 158) {
    obj_add(npc_coord, adamant_scimitar, 1, ^lootdrop_duration);
} else if ($dropint < 190) {
    obj_add(npc_coord, steel_plateskirt, 1, ^lootdrop_duration);
} else if ($dropint < 196) {
    obj_add(npc_coord, steel_platebody, 1, ^lootdrop_duration);
} else if ($dropint < 224) {
    obj_add(npc_coord, black_full_helm, 1, ^lootdrop_duration);
} else if ($dropint < 240) {
    obj_add(npc_coord, black_chainbody, 1, ^lootdrop_duration);
} else if ($dropint < 246) {
    obj_add(npc_coord, black_platelegs, 1, ^lootdrop_duration);
} else if ($dropint < 252) {
    obj_add(npc_coord, black_plateskirt, 1, ^lootdrop_duration);
} else if ($dropint < 270) {
    obj_add(npc_coord, black_kiteshield, 1, ^lootdrop_duration);
} else if ($dropint < 300) {
    obj_add(npc_coord, black_sq_shield, 1, ^lootdrop_duration);
} else if ($dropint < 316) {
    obj_add(npc_coord, mithril_full_helm, 1, ^lootdrop_duration);
} else if ($dropint < 322) {
    obj_add(npc_coord, mithril_chainbody, 1, ^lootdrop_duration);
} else if ($dropint < 366) {
    obj_add(npc_coord, mithril_platelegs, 1, ^lootdrop_duration);
