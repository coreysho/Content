// Bunny - https://oldschool.runescape.wiki/w/Bunny

[ai_queue3,viking_bunny_1] @viking_bunny_1_drop_table;
[ai_queue3,viking_bunny_2] @viking_bunny_1_drop_table;

[label,viking_bunny_1_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

// Bones / ashes, set on the npc config.
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

obj_add(npc_coord, raw_rabbit, 1, ^lootdrop_duration);

