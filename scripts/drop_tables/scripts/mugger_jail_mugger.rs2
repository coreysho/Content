// Mugger - https://oldschool.runescape.wiki/w/Mugger

[ai_queue3,jail_mugger] @jail_mugger_drop_table;

[label,jail_mugger_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

// Bones / ashes, set on the npc config.
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

~trail_easycluedrop(^trail_easy_droprate, npc_coord);

def_int $dropint = random(128);
if ($dropint < 40) {
    obj_add(npc_coord, rope, 1, ^lootdrop_duration);
} else if ($dropint < 67) {
    obj_add(npc_coord, bolt, calc(random(11) + 2), ^lootdrop_duration);
} else if ($dropint < 80) {
    obj_add(npc_coord, coins, 10, ^lootdrop_duration);
} else if ($dropint < 92) {
    obj_add(npc_coord, coins, 5, ^lootdrop_duration);
} else if ($dropint < 98) {
    obj_add(npc_coord, fishing_bait, 1, ^lootdrop_duration);
} else if ($dropint < 101) {
    obj_add(npc_coord, mindrune, 9, ^lootdrop_duration);
} else if ($dropint < 104) {
    obj_add(npc_coord, coins, 15, ^lootdrop_duration);
} else if ($dropint < 106) {
    obj_add(npc_coord, waterrune, 6, ^lootdrop_duration);
} else if ($dropint < 108) {
    obj_add(npc_coord, earthrune, 5, ^lootdrop_duration);
} else if ($dropint < 110) {
    obj_add(npc_coord, copper_ore, 1, ^lootdrop_duration);
} else if ($dropint < 112) {
    obj_add(npc_coord, bronze_med_helm, 1, ^lootdrop_duration);
} else if ($dropint < 113) {
    obj_add(npc_coord, knife, 1, ^lootdrop_duration);
} else if ($dropint < 114) {
    obj_add(npc_coord, cabbage, 1, ^lootdrop_duration);
} else if ($dropint < 115) {
    obj_add(npc_coord, coins, 25, ^lootdrop_duration);
} else if ($dropint < 128) {
    obj_add(npc_coord, ~randomherb, ^lootdrop_duration);
}
