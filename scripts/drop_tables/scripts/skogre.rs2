// Skogre - https://oldschool.runescape.wiki/w/Skogre

[ai_queue3,zogre_drummer2] @zogre_drummer2_drop_table;
[ai_queue3,zogre_skele] @zogre_drummer2_drop_table;
[ai_queue3,zogre_skele_dance] @zogre_drummer2_drop_table;

[label,zogre_drummer2_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

// Bones / ashes, set on the npc config.
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

obj_add(npc_coord, zogre_coffinkey, 1, ^lootdrop_duration);

