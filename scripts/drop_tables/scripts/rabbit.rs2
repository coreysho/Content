// Rabbit - https://oldschool.runescape.wiki/w/Rabbit

[ai_queue3,misc_rabbit] @misc_rabbit_drop_table;
[ai_queue3,regicide_bunny1] @misc_rabbit_drop_table;
[ai_queue3,regicide_bunny2] @misc_rabbit_drop_table;
[ai_queue3,regicide_rabbit] @misc_rabbit_drop_table;

[label,misc_rabbit_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

// Bones / ashes, set on the npc config.
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

obj_add(npc_coord, raw_rabbit, 1, ^lootdrop_duration);

