// Hobgoblin - https://oldschool.runescape.wiki/w/Hobgoblin

[ai_queue3,rimmington_hobgoblin_armed_1] @rimmington_hobgoblin_armed_1_drop_table;
[ai_queue3,rimmington_hobgoblin_unarmed_1] @rimmington_hobgoblin_armed_1_drop_table;
[ai_queue3,rimmington_hobgoblin_unarmed_2] @rimmington_hobgoblin_armed_1_drop_table;
[ai_queue3,rimmington_hobgoblin_unarmed_3] @rimmington_hobgoblin_armed_1_drop_table;

[label,rimmington_hobgoblin_armed_1_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

// Bones / ashes, set on the npc config.
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

def_int $dropint = random(128);
if ($dropint < 18) {
    obj_add(npc_coord, limpwurt_root, 1, ^lootdrop_duration);
} else if ($dropint < 33) {
    obj_add(npc_coord, ~roll_general_seed_table(28), ^lootdrop_duration);
} else if ($dropint < 46) {
    obj_add(npc_coord, coins, 15, ^lootdrop_duration);
} else if ($dropint < 56) {
    obj_add(npc_coord, coins, 28, ^lootdrop_duration);
} else if ($dropint < 66) {
    obj_add(npc_coord, coins, 5, ^lootdrop_duration);
} else if ($dropint < 69) {
    obj_add(npc_coord, coins, 62, ^lootdrop_duration);
} else if ($dropint < 71) {
    obj_add(npc_coord, coins, 42, ^lootdrop_duration);
} else if ($dropint < 72) {
    obj_add(npc_coord, coins, 1, ^lootdrop_duration);
} else if ($dropint < 87) {
    obj_add(npc_coord, coins, 5, ^lootdrop_duration);
} else if ($dropint < 92) {
    obj_add(npc_coord, coins, 10, ^lootdrop_duration);
} else if ($dropint < 97) {
    obj_add(npc_coord, ~randomherb, ^lootdrop_duration);
} else if ($dropint < 99) {
    obj_add(npc_coord, bronze_spear, 1, ^lootdrop_duration);
} else if ($dropint < 101) {
    obj_add(npc_coord, iron_sword, 1, ^lootdrop_duration);
} else if ($dropint < 103) {
    obj_add(npc_coord, steel_dagger, 1, ^lootdrop_duration);
} else if ($dropint < 105) {
    obj_add(npc_coord, lawrune, 2, ^lootdrop_duration);
} else if ($dropint < 106) {
    obj_add(npc_coord, iron_spear, 1, ^lootdrop_duration);
} else if ($dropint < 107) {
    obj_add(npc_coord, steel_spear, 1, ^lootdrop_duration);
} else if ($dropint < 108) {
    obj_add(npc_coord, waterrune, 2, ^lootdrop_duration);
} else if ($dropint < 109) {
    obj_add(npc_coord, firerune, 7, ^lootdrop_duration);
} else if ($dropint < 110) {
    obj_add(npc_coord, bodyrune, 6, ^lootdrop_duration);
} else if ($dropint < 111) {
    obj_add(npc_coord, chaosrune, 3, ^lootdrop_duration);
} else if ($dropint < 112) {
    obj_add(npc_coord, naturerune, 4, ^lootdrop_duration);
} else if ($dropint < 113) {
    obj_add(npc_coord, steel_longsword, 1, ^lootdrop_duration);
} else if ($dropint < 114) {
    obj_add(npc_coord, cosmicrune, 2, ^lootdrop_duration);
} else if ($dropint < 115) {
    obj_add(npc_coord, goblin_armour, 1, ^lootdrop_duration);
} else if ($dropint < 116) {
    obj_add(npc_coord, ~ultrarare_getitem, ^lootdrop_duration);
}
