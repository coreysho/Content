// Dust devil - https://oldschool.runescape.wiki/w/Dust_devil

[ai_queue3,slayer_dustdevil] @slayer_dustdevil_drop_table;

[label,slayer_dustdevil_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

// Bones / ashes, set on the npc config.
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

if (random(32821) = 0) {
    obj_add(npc_coord, dragon_chainbody, 1, ^lootdrop_duration);
}

def_int $dropint = random(128);
if ($dropint < 28) {
    obj_add(npc_coord, coins, calc(random(2001) + 2000), ^lootdrop_duration);
} else if ($dropint < 38) {
    obj_add(npc_coord, dustrune, 200, ^lootdrop_duration);
} else if ($dropint < 48) {
    obj_add(npc_coord, earthrune, 300, ^lootdrop_duration);
} else if ($dropint < 58) {
    obj_add(npc_coord, firerune, 300, ^lootdrop_duration);
} else if ($dropint < 65) {
    obj_add(npc_coord, chaosrune, 65, ^lootdrop_duration);
} else if ($dropint < 70) {
    obj_add(npc_coord, rune_arrow, 12, ^lootdrop_duration);
} else if ($dropint < 74) {
    obj_add(npc_coord, soulrune, 15, ^lootdrop_duration);
} else if ($dropint < 75) {
    obj_add(npc_coord, firerune, 50, ^lootdrop_duration);
} else if ($dropint < 76) {
    obj_add(npc_coord, soulrune, 50, ^lootdrop_duration);
} else if ($dropint < 79) {
    obj_add(npc_coord, adamant_axe, 1, ^lootdrop_duration);
} else if ($dropint < 81) {
    obj_add(npc_coord, rune_dagger, 1, ^lootdrop_duration);
} else if ($dropint < 83) {
    obj_add(npc_coord, red_dragon_vambraces, 1, ^lootdrop_duration);
} else if ($dropint < 85) {
    obj_add(npc_coord, air_battlestaff, 1, ^lootdrop_duration);
} else if ($dropint < 87) {
    obj_add(npc_coord, earth_battlestaff, 1, ^lootdrop_duration);
} else if ($dropint < 88) {
    obj_add(npc_coord, black_dragon_vambraces, 1, ^lootdrop_duration);
} else if ($dropint < 89) {
    obj_add(npc_coord, mystic_air_staff, 1, ^lootdrop_duration);
} else if ($dropint < 90) {
    obj_add(npc_coord, mystic_earth_staff, 1, ^lootdrop_duration);
} else if ($dropint < 91) {
    obj_add(npc_coord, dragon_dagger, 1, ^lootdrop_duration);
} else if ($dropint < 94) {
    obj_add(npc_coord, mithril_bar, 10, ^lootdrop_duration);
} else if ($dropint < 96) {
    obj_add(npc_coord, ugthanki_kebab, 4, ^lootdrop_duration);
} else if ($dropint < 97) {
    obj_add(npc_coord, adamantite_bar, 4, ^lootdrop_duration);
} else if ($dropint < 116) {
    obj_add(npc_coord, ~randomherb, ^lootdrop_duration);
} else if ($dropint < 127) {
    obj_add(npc_coord, ~ultrarare_getitem, ^lootdrop_duration);
}
