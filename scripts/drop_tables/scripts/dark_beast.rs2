// Dark Beast - https://oldschool.runescape.wiki/w/Dark_Beast

[ai_queue3,mourning_dark_beast] @mourning_dark_beast_drop_table;

[label,mourning_dark_beast_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

// Bones / ashes, set on the npc config.
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

~trail_hardcluedrop(^trail_hard_droprate, npc_coord);

def_int $dropint = random(128);
if ($dropint < 3) {
    obj_add(npc_coord, black_battleaxe, 1, ^lootdrop_duration);
} else if ($dropint < 4) {
    obj_add(npc_coord, adamant_sq_shield, 1, ^lootdrop_duration);
} else if ($dropint < 5) {
    obj_add(npc_coord, rune_chainbody, 1, ^lootdrop_duration);
} else if ($dropint < 6) {
    obj_add(npc_coord, rune_med_helm, 1, ^lootdrop_duration);
} else if ($dropint < 7) {
    obj_add(npc_coord, rune_full_helm, 1, ^lootdrop_duration);
} else if ($dropint < 8) {
    obj_add(npc_coord, rune_2h_sword, 1, ^lootdrop_duration);
} else if ($dropint < 9) {
    obj_add(npc_coord, rune_battleaxe, 1, ^lootdrop_duration);
} else if ($dropint < 17) {
    obj_add(npc_coord, deathrune, 20, ^lootdrop_duration);
} else if ($dropint < 24) {
    obj_add(npc_coord, chaosrune, 30, ^lootdrop_duration);
} else if ($dropint < 28) {
    obj_add(npc_coord, bloodrune, 15, ^lootdrop_duration);
} else if ($dropint < 68) {
    obj_add(npc_coord, coins, 152, ^lootdrop_duration);
} else if ($dropint < 74) {
    obj_add(npc_coord, coins, 64, ^lootdrop_duration);
} else if ($dropint < 80) {
    obj_add(npc_coord, coins, 95, ^lootdrop_duration);
} else if ($dropint < 85) {
    obj_add(npc_coord, coins, 220, ^lootdrop_duration);
} else if ($dropint < 88) {
    obj_add(npc_coord, shark, 1, ^lootdrop_duration);
} else if ($dropint < 90) {
    obj_add(npc_coord, adamantite_bar, 3, ^lootdrop_duration);
} else if ($dropint < 91) {
    obj_add(npc_coord, adamantite_ore, 5, ^lootdrop_duration);
} else if ($dropint < 92) {
    obj_add(npc_coord, death_talisman, 1, ^lootdrop_duration);
} else if ($dropint < 93) {
    obj_add(npc_coord, runite_ore, 1, ^lootdrop_duration);
} else if ($dropint < 94) {
    obj_add(npc_coord, shark, 2, ^lootdrop_duration);
} else if ($dropint < 113) {
    obj_add(npc_coord, ~randomherb, ^lootdrop_duration);
} else if ($dropint < 118) {
    obj_add(npc_coord, ~randomherb, ^lootdrop_duration);
} else if ($dropint < 121) {
    obj_add(npc_coord, ~roll_general_seed_table(182), ^lootdrop_duration);
} else if ($dropint < 122) {
    obj_add(npc_coord, snapdragon_seed, 1, ^lootdrop_duration);
} else if ($dropint < 125) {
    obj_add(npc_coord, ~ultrarare_getitem, ^lootdrop_duration);
}
