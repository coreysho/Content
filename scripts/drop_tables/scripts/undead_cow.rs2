// Undead Cow - https://oldschool.runescape.wiki/w/Undead_Cow

[ai_queue3,ahoy_undead_cow] @ahoy_undead_cow_drop_table;

[label,ahoy_undead_cow_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

// Bones / ashes, set on the npc config.
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

obj_add(npc_coord, bones, 1, ^lootdrop_duration);
obj_add(npc_coord, cow_hide, 1, ^lootdrop_duration);
obj_add(npc_coord, raw_beef_undead, 1, ^lootdrop_duration);

