// Experiment - https://oldschool.runescape.wiki/w/Experiment

[ai_queue3,fenk_experiment_1] @fenk_experiment_1_drop_table;
[ai_queue3,fenk_experiment_2] @fenk_experiment_1_drop_table;
[ai_queue3,fenk_experiment_3] @fenk_experiment_1_drop_table;

[label,fenk_experiment_1_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

// Bones / ashes, set on the npc config.
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

obj_add(npc_coord, fenk_mausoleum_key, 1, ^lootdrop_duration);

