// Highwayman - https://oldschool.runescape.wiki/w/Highwayman

[ai_queue3,highwayman2] @highwayman2_drop_table;

[label,highwayman2_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

// Bones / ashes, set on the npc config.
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

obj_add(npc_coord, black_cape, 1, ^lootdrop_duration);

def_int $dropint = random(512);
if ($dropint < 26) {
    obj_add(npc_coord, bolt, calc(random(11) + 2), ^lootdrop_duration);
}
