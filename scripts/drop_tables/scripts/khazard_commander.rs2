// Khazard commander - https://oldschool.runescape.wiki/w/Khazard_commander

[ai_queue3,khazard_commander] @khazard_commander_drop_table;

[label,khazard_commander_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

// Bones / ashes, set on the npc config.
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

obj_add(npc_coord, orb_of_protection, 1, ^lootdrop_duration);

