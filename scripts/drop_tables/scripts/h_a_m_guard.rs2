// H.A.M. Guard - https://oldschool.runescape.wiki/w/H.A.M._Guard

[ai_queue3,favour_guard_long_beard] @favour_guard_long_beard_drop_table;
[ai_queue3,favour_guard_male_bearded] @favour_guard_long_beard_drop_table;
[ai_queue3,favour_guard_male_no_beard] @favour_guard_long_beard_drop_table;

[label,favour_guard_long_beard_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

// Bones / ashes, set on the npc config.
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

~trail_easycluedrop(^trail_easy_droprate, npc_coord);

if (random(337) = 0) {
    obj_add(npc_coord, unidentified_tarromin, 1, ^lootdrop_duration);
}

def_int $dropint = random(512);
if ($dropint < 63) {
    obj_add(npc_coord, coins, calc(random(20) + 1), ^lootdrop_duration);
} else if ($dropint < 107) {
    obj_add(npc_coord, ~roll_general_seed_table(22), ^lootdrop_duration);
} else if ($dropint < 126) {
    obj_add(npc_coord, digsitebuttons, 1, ^lootdrop_duration);
} else if ($dropint < 145) {
    obj_add(npc_coord, digsitearmour1, 1, ^lootdrop_duration);
} else if ($dropint < 164) {
    obj_add(npc_coord, digsitesword, 1, ^lootdrop_duration);
} else if ($dropint < 178) {
    obj_add(npc_coord, bronze_axe, 1, ^lootdrop_duration);
} else if ($dropint < 192) {
    obj_add(npc_coord, bronze_dagger, 1, ^lootdrop_duration);
} else if ($dropint < 206) {
    obj_add(npc_coord, bronze_pickaxe, 1, ^lootdrop_duration);
} else if ($dropint < 220) {
    obj_add(npc_coord, iron_axe, 1, ^lootdrop_duration);
} else if ($dropint < 234) {
    obj_add(npc_coord, iron_pickaxe, 1, ^lootdrop_duration);
} else if ($dropint < 248) {
    obj_add(npc_coord, iron_dagger, 1, ^lootdrop_duration);
} else if ($dropint < 262) {
    obj_add(npc_coord, leather_armour, 1, ^lootdrop_duration);
} else if ($dropint < 276) {
    obj_add(npc_coord, cow_hide, calc(random(3) + 1), ^lootdrop_duration);
} else if ($dropint < 290) {
    obj_add(npc_coord, logs, calc(random(3) + 1), ^lootdrop_duration);
} else if ($dropint < 304) {
    obj_add(npc_coord, feather, calc(random(6) + 1), ^lootdrop_duration);
} else if ($dropint < 316) {
    obj_add(npc_coord, bronze_arrow, calc(random(12) + 1), ^lootdrop_duration);
} else if ($dropint < 328) {
    obj_add(npc_coord, ham_gloves, 1, ^lootdrop_duration);
} else if ($dropint < 337) {
    obj_add(npc_coord, steel_dagger, 1, ^lootdrop_duration);
} else if ($dropint < 346) {
    obj_add(npc_coord, steel_axe, 1, ^lootdrop_duration);
} else if ($dropint < 355) {
    obj_add(npc_coord, steel_pickaxe, 1, ^lootdrop_duration);
} else if ($dropint < 364) {
    obj_add(npc_coord, ham_boots, 1, ^lootdrop_duration);
} else if ($dropint < 373) {
    obj_add(npc_coord, steel_arrow, calc(random(10) + 1), ^lootdrop_duration);
} else if ($dropint < 382) {
    obj_add(npc_coord, uncut_opal, 1, ^lootdrop_duration);
} else if ($dropint < 391) {
    obj_add(npc_coord, uncut_jade, 1, ^lootdrop_duration);
} else if ($dropint < 400) {
    obj_add(npc_coord, iron_ore, 1, ^lootdrop_duration);
} else if ($dropint < 409) {
    obj_add(npc_coord, coal, 1, ^lootdrop_duration);
} else if ($dropint < 418) {
    obj_add(npc_coord, raw_anchovies, calc(random(3) + 1), ^lootdrop_duration);
} else if ($dropint < 427) {
