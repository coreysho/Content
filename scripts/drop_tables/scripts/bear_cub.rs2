// Bear Cub - https://oldschool.runescape.wiki/w/Bear_Cub

[ai_queue3,brownbear_cub_1] @brownbear_cub_1_drop_table;
[ai_queue3,brownbear_cub_2] @brownbear_cub_1_drop_table;

[label,brownbear_cub_1_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

// Bones / ashes, set on the npc config.
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

obj_add(npc_coord, fur, 1, ^lootdrop_duration);
obj_add(npc_coord, raw_bear_meat, 1, ^lootdrop_duration);

