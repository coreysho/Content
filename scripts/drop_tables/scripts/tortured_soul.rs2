// Tortured Soul - https://oldschool.runescape.wiki/w/Tortured_Soul

[ai_queue3,ahoy_tortured_soul] @ahoy_tortured_soul_drop_table;

[label,ahoy_tortured_soul_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

def_int $dropint = random(128);
if ($dropint < 7) {
    obj_add(npc_coord, bodyrune, 7, ^lootdrop_duration);
} else if ($dropint < 13) {
    obj_add(npc_coord, waterrune, 6, ^lootdrop_duration);
} else if ($dropint < 16) {
    obj_add(npc_coord, lawrune, 2, ^lootdrop_duration);
} else if ($dropint < 21) {
    obj_add(npc_coord, unidentified_harralander, 1, ^lootdrop_duration);
} else if ($dropint < 24) {
    obj_add(npc_coord, unidentified_tarromin, 1, ^lootdrop_duration);
} else if ($dropint < 26) {
    obj_add(npc_coord, unidentified_marentill, 1, ^lootdrop_duration);
} else if ($dropint < 27) {
    obj_add(npc_coord, unidentified_guam, 1, ^lootdrop_duration);
} else if ($dropint < 28) {
    obj_add(npc_coord, unidentified_ranarr, 1, ^lootdrop_duration);
} else if ($dropint < 58) {
    obj_add(npc_coord, coins, 3, ^lootdrop_duration);
} else if ($dropint < 79) {
    obj_add(npc_coord, coins, 2, ^lootdrop_duration);
} else if ($dropint < 82) {
    obj_add(npc_coord, coins, 6, ^lootdrop_duration);
} else if ($dropint < 85) {
    obj_add(npc_coord, coins, 5, ^lootdrop_duration);
} else if ($dropint < 87) {
    obj_add(npc_coord, coins, 2, ^lootdrop_duration);
} else if ($dropint < 88) {
    obj_add(npc_coord, coins, 12, ^lootdrop_duration);
} else if ($dropint < 91) {
    obj_add(npc_coord, limpwurt_root, 1, ^lootdrop_duration);
} else if ($dropint < 92) {
    obj_add(npc_coord, vial_water, 1, ^lootdrop_duration);
} else if ($dropint < 112) {
    obj_add(npc_coord, ~roll_general_seed_table(59), ^lootdrop_duration);
}
