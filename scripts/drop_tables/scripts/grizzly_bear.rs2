// Grizzly bear - https://oldschool.runescape.wiki/w/Grizzly_bear

[ai_queue3,regicide_darkbear] @regicide_darkbear_drop_table;

[label,regicide_darkbear_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

// Bones / ashes, set on the npc config.
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

obj_add(npc_coord, fur, 1, ^lootdrop_duration);
obj_add(npc_coord, raw_bear_meat, 1, ^lootdrop_duration);

