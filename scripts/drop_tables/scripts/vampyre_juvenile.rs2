// Vampyre Juvenile - https://oldschool.runescape.wiki/w/Vampyre_Juvenile

[ai_queue3,burgh_vampire_juvenile_1] @burgh_vampire_juvenile_1_drop_table;
[ai_queue3,burgh_vampire_juvenile_2] @burgh_vampire_juvenile_1_drop_table;
[ai_queue3,burgh_vampire_juvenile_3] @burgh_vampire_juvenile_1_drop_table;

[label,burgh_vampire_juvenile_1_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

// Bones / ashes, set on the npc config.
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

~trail_mediumcluedrop(^trail_medium_droprate, npc_coord);

def_int $dropint = random(512);
if ($dropint < 44) {
    obj_add(npc_coord, mithril_platelegs, 1, ^lootdrop_duration);
} else if ($dropint < 78) {
    obj_add(npc_coord, mithril_scimitar, 1, ^lootdrop_duration);
} else if ($dropint < 110) {
    obj_add(npc_coord, steel_plateskirt, 1, ^lootdrop_duration);
} else if ($dropint < 142) {
    obj_add(npc_coord, willow_logs, 5, ^lootdrop_duration);
} else if ($dropint < 172) {
    obj_add(npc_coord, black_sq_shield, 1, ^lootdrop_duration);
} else if ($dropint < 200) {
    obj_add(npc_coord, black_full_helm, 1, ^lootdrop_duration);
} else if ($dropint < 224) {
    obj_add(npc_coord, naturerune, 10, ^lootdrop_duration);
} else if ($dropint < 244) {
    obj_add(npc_coord, mithril_longsword, 1, ^lootdrop_duration);
} else if ($dropint < 264) {
    obj_add(npc_coord, adamant_axe, 1, ^lootdrop_duration);
} else if ($dropint < 284) {
    obj_add(npc_coord, yew_logs, 5, ^lootdrop_duration);
} else if ($dropint < 302) {
    obj_add(npc_coord, black_kiteshield, 1, ^lootdrop_duration);
} else if ($dropint < 320) {
    obj_add(npc_coord, adamant_mace, 1, ^lootdrop_duration);
} else if ($dropint < 338) {
    obj_add(npc_coord, ruby_ring, 1, ^lootdrop_duration);
} else if ($dropint < 354) {
    obj_add(npc_coord, black_chainbody, 1, ^lootdrop_duration);
} else if ($dropint < 370) {
    obj_add(npc_coord, mithril_full_helm, 1, ^lootdrop_duration);
} else if ($dropint < 386) {
    obj_add(npc_coord, deathrune, 10, ^lootdrop_duration);
} else if ($dropint < 400) {
    obj_add(npc_coord, mithril_sq_shield, 1, ^lootdrop_duration);
} else if ($dropint < 410) {
    obj_add(npc_coord, black_spear, 1, ^lootdrop_duration);
} else if ($dropint < 418) {
    obj_add(npc_coord, black_battleaxe, 1, ^lootdrop_duration);
} else if ($dropint < 426) {
    obj_add(npc_coord, black_2h_sword, 1, ^lootdrop_duration);
} else if ($dropint < 432) {
    obj_add(npc_coord, mithril_battleaxe, 1, ^lootdrop_duration);
} else if ($dropint < 438) {
    obj_add(npc_coord, mithril_2h_sword, 1, ^lootdrop_duration);
} else if ($dropint < 444) {
    obj_add(npc_coord, mithril_warhammer, 1, ^lootdrop_duration);
} else if ($dropint < 450) {
    obj_add(npc_coord, mithril_chainbody, 1, ^lootdrop_duration);
} else if ($dropint < 456) {
    obj_add(npc_coord, mithril_kiteshield, 1, ^lootdrop_duration);
} else if ($dropint < 462) {
    obj_add(npc_coord, adamant_sword, 1, ^lootdrop_duration);
} else if ($dropint < 468) {
