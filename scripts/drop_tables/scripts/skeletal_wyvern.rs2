// Skeletal Wyvern - https://oldschool.runescape.wiki/w/Skeletal_Wyvern

[ai_queue3,skeletal_wyvern1] @skeletal_wyvern1_drop_table;
[ai_queue3,skeletal_wyvern2] @skeletal_wyvern1_drop_table;
[ai_queue3,skeletal_wyvern3] @skeletal_wyvern1_drop_table;
[ai_queue3,skeletal_wyvern4] @skeletal_wyvern1_drop_table;

[label,skeletal_wyvern1_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

// Bones / ashes, set on the npc config.
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

obj_add(npc_coord, wyvern_bones, 1, ^lootdrop_duration);

~trail_hardcluedrop(^trail_hard_droprate, npc_coord);

if (random(512) = 0) {
    obj_add(npc_coord, granite_legs, 1, ^lootdrop_duration);
}
if (random(512) = 0) {
    obj_add(npc_coord, dragon_platelegs, 1, ^lootdrop_duration);
}
if (random(512) = 0) {
    obj_add(npc_coord, dragon_plateskirt, 1, ^lootdrop_duration);
}

def_int $dropint = random(128);
if ($dropint < 4) {
    obj_add(npc_coord, earth_battlestaff, 1, ^lootdrop_duration);
} else if ($dropint < 7) {
    obj_add(npc_coord, battlestaff, 10, ^lootdrop_duration);
} else if ($dropint < 10) {
    obj_add(npc_coord, rune_axe, 1, ^lootdrop_duration);
} else if ($dropint < 12) {
    obj_add(npc_coord, rune_battleaxe, 1, ^lootdrop_duration);
} else if ($dropint < 14) {
    obj_add(npc_coord, rune_warhammer, 1, ^lootdrop_duration);
} else if ($dropint < 16) {
    obj_add(npc_coord, rune_full_helm, 1, ^lootdrop_duration);
} else if ($dropint < 18) {
    obj_add(npc_coord, rune_kiteshield, 1, ^lootdrop_duration);
} else if ($dropint < 24) {
    obj_add(npc_coord, airrune, 225, ^lootdrop_duration);
} else if ($dropint < 29) {
    obj_add(npc_coord, rune_arrow, 36, ^lootdrop_duration);
} else if ($dropint < 33) {
    obj_add(npc_coord, waterrune, 150, ^lootdrop_duration);
} else if ($dropint < 37) {
    obj_add(npc_coord, chaosrune, 80, ^lootdrop_duration);
} else if ($dropint < 41) {
    obj_add(npc_coord, lawrune, 45, ^lootdrop_duration);
} else if ($dropint < 45) {
    obj_add(npc_coord, deathrune, 40, ^lootdrop_duration);
} else if ($dropint < 49) {
    obj_add(npc_coord, bloodrune, 25, ^lootdrop_duration);
} else if ($dropint < 52) {
    obj_add(npc_coord, bolt, calc(random(25) + 75), ^lootdrop_duration);
} else if ($dropint < 55) {
    obj_add(npc_coord, bolt, calc(random(10) + 35), ^lootdrop_duration);
} else if ($dropint < 56) {
    obj_add(npc_coord, soulrune, 20, ^lootdrop_duration);
} else if ($dropint < 63) {
    obj_add(npc_coord, ~randomherb, ^lootdrop_duration);
} else if ($dropint < 71) {
    obj_add(npc_coord, blankrune_high, 250, ^lootdrop_duration);
} else if ($dropint < 77) {
    obj_add(npc_coord, magic_logs, 35, ^lootdrop_duration);
} else if ($dropint < 83) {
    obj_add(npc_coord, adamantite_bar, 10, ^lootdrop_duration);
} else if ($dropint < 86) {
    obj_add(npc_coord, iron_ore, 200, ^lootdrop_duration);
} else if ($dropint < 88) {
    obj_add(npc_coord, uncut_ruby, 10, ^lootdrop_duration);
} else if ($dropint < 90) {
    obj_add(npc_coord, uncut_diamond, 5, ^lootdrop_duration);
} else if ($dropint < 102) {
    obj_add(npc_coord, coins, 300, ^lootdrop_duration);
} else if ($dropint < 110) {
    obj_add(npc_coord, lobster, 6, ^lootdrop_duration);
} else if ($dropint < 117) {
    obj_add(npc_coord, 4doseprayerrestore, 2, ^lootdrop_duration);
} else if ($dropint < 119) {
    obj_add(npc_coord, stafforb, 75, ^lootdrop_duration);
} else if ($dropint < 121) {
    obj_add(npc_coord, ranarr_seed, 3, ^lootdrop_duration);
} else if ($dropint < 123) {
    obj_add(npc_coord, snapdragon_seed, 1, ^lootdrop_duration);
} else if ($dropint < 126) {
    obj_add(npc_coord, ~ultrarare_getitem, ^lootdrop_duration);
}
