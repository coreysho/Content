// Guard - https://oldschool.runescape.wiki/w/Guard

[ai_queue3,falador_doric_area_guard] @falador_doric_area_guard_drop_table;
[ai_queue3,jail_guard_1] @falador_doric_area_guard_drop_table;
[ai_queue3,jail_guard_2] @falador_doric_area_guard_drop_table;
[ai_queue3,jail_guard_3] @falador_doric_area_guard_drop_table;
[ai_queue3,jail_guard_4] @falador_doric_area_guard_drop_table;
[ai_queue3,jail_guard_5] @falador_doric_area_guard_drop_table;
[ai_queue3,mcannonguard] @falador_doric_area_guard_drop_table;
[ai_queue3,ranging_guild_guard] @falador_doric_area_guard_drop_table;

[label,falador_doric_area_guard_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

// Bones / ashes, set on the npc config.
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

~trail_mediumcluedrop(^trail_medium_droprate, npc_coord);

def_int $dropint = random(128);
if ($dropint < 10) {
    obj_add(npc_coord, bolt, calc(random(11) + 2), ^lootdrop_duration);
} else if ($dropint < 16) {
    obj_add(npc_coord, iron_dagger, 1, ^lootdrop_duration);
} else if ($dropint < 19) {
    obj_add(npc_coord, body_talisman, 1, ^lootdrop_duration);
} else if ($dropint < 29) {
    obj_add(npc_coord, bronze_arrow, calc(random(2) + 1), ^lootdrop_duration);
} else if ($dropint < 35) {
    obj_add(npc_coord, airrune, 6, ^lootdrop_duration);
} else if ($dropint < 40) {
    obj_add(npc_coord, earthrune, 3, ^lootdrop_duration);
} else if ($dropint < 44) {
    obj_add(npc_coord, firerune, 2, ^lootdrop_duration);
} else if ($dropint < 47) {
    obj_add(npc_coord, iron_arrow, calc(random(2) + 1), ^lootdrop_duration);
} else if ($dropint < 49) {
    obj_add(npc_coord, steel_arrow, calc(random(5) + 1), ^lootdrop_duration);
} else if ($dropint < 51) {
    obj_add(npc_coord, chaosrune, calc(random(2) + 1), ^lootdrop_duration);
} else if ($dropint < 52) {
    obj_add(npc_coord, naturerune, 1, ^lootdrop_duration);
} else if ($dropint < 53) {
    obj_add(npc_coord, bloodrune, 1, ^lootdrop_duration);
} else if ($dropint < 54) {
    obj_add(npc_coord, iron_ore, 1, ^lootdrop_duration);
} else if ($dropint < 55) {
    obj_add(npc_coord, grain, 1, ^lootdrop_duration);
} else if ($dropint < 73) {
    obj_add(npc_coord, coins, 8, ^lootdrop_duration);
} else if ($dropint < 85) {
    obj_add(npc_coord, coins, 15, ^lootdrop_duration);
} else if ($dropint < 90) {
    obj_add(npc_coord, coins, 30, ^lootdrop_duration);
} else if ($dropint < 124) {
    obj_add(npc_coord, ~roll_general_seed_table(37), ^lootdrop_duration);
}
