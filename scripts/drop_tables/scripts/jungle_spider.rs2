// Jungle spider - https://oldschool.runescape.wiki/w/Jungle_spider

[ai_queue3,jungle_spider] @jungle_spider_drop_table;
[ai_queue3,mm_jungle_spider] @jungle_spider_drop_table;

[label,jungle_spider_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

obj_add(npc_coord, village_spider_carcass, 1, ^lootdrop_duration);

