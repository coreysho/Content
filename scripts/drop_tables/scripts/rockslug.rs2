// Rockslug - https://oldschool.runescape.wiki/w/Rockslug

[ai_queue3,slayer_rockslug_baby] @slayer_rockslug_baby_drop_table;

[label,slayer_rockslug_baby_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

if (random(512) = 0) {
    obj_add(npc_coord, mystic_gloves_light, 1, ^lootdrop_duration);
}

def_int $dropint = random(128);
if ($dropint < 30) {
    obj_add(npc_coord, earthrune, 5, ^lootdrop_duration);
} else if ($dropint < 34) {
    obj_add(npc_coord, earthrune, 42, ^lootdrop_duration);
} else if ($dropint < 38) {
    obj_add(npc_coord, chaosrune, 2, ^lootdrop_duration);
} else if ($dropint < 60) {
    obj_add(npc_coord, iron_ore, 1, ^lootdrop_duration);
} else if ($dropint < 73) {
    obj_add(npc_coord, coal, 1, ^lootdrop_duration);
} else if ($dropint < 81) {
    obj_add(npc_coord, tin_ore, 1, ^lootdrop_duration);
} else if ($dropint < 84) {
    obj_add(npc_coord, iron_bar, 1, ^lootdrop_duration);
} else if ($dropint < 87) {
    obj_add(npc_coord, copper_ore, 1, ^lootdrop_duration);
} else if ($dropint < 89) {
    obj_add(npc_coord, bronze_bar, 1, ^lootdrop_duration);
} else if ($dropint < 90) {
    obj_add(npc_coord, mithril_ore, 1, ^lootdrop_duration);
} else if ($dropint < 99) {
    obj_add(npc_coord, ~roll_general_seed_table(29), ^lootdrop_duration);
} else if ($dropint < 112) {
    obj_add(npc_coord, dwarven_stout, 1, ^lootdrop_duration);
} else if ($dropint < 122) {
    obj_add(npc_coord, hammer, 1, ^lootdrop_duration);
} else if ($dropint < 128) {
    obj_add(npc_coord, ~ultrarare_getitem, ^lootdrop_duration);
}
