// Woman - https://oldschool.runescape.wiki/w/Woman

[ai_queue3,ardougnian_female1] @ardougnian_female1_drop_table;
[ai_queue3,dskin_w_ardoungecitizen2] @ardougnian_female1_drop_table;
[ai_queue3,dskin_w_ardoungecitizenlady1] @ardougnian_female1_drop_table;
[ai_queue3,dskin_w_ardoungecitizenlady3] @ardougnian_female1_drop_table;
[ai_queue3,dskin_w_ardoungecitizenlady4] @ardougnian_female1_drop_table;
[ai_queue3,w_ardoungecitizenlady1] @ardougnian_female1_drop_table;
[ai_queue3,w_ardoungecitizenlady2] @ardougnian_female1_drop_table;
[ai_queue3,w_ardoungecitizenlady4] @ardougnian_female1_drop_table;

[label,ardougnian_female1_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

// Bones / ashes, set on the npc config.
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

~trail_easycluedrop(^trail_easy_droprate, npc_coord);

def_int $dropint = random(128);
if ($dropint < 38) {
    obj_add(npc_coord, coins, 3, ^lootdrop_duration);
} else if ($dropint < 60) {
    obj_add(npc_coord, bolt, calc(random(11) + 2), ^lootdrop_duration);
} else if ($dropint < 69) {
    obj_add(npc_coord, coins, 5, ^lootdrop_duration);
} else if ($dropint < 74) {
    obj_add(npc_coord, fishing_bait, 1, ^lootdrop_duration);
} else if ($dropint < 78) {
    obj_add(npc_coord, coins, 15, ^lootdrop_duration);
} else if ($dropint < 81) {
    obj_add(npc_coord, bronze_arrow, 7, ^lootdrop_duration);
} else if ($dropint < 83) {
    obj_add(npc_coord, earthrune, 4, ^lootdrop_duration);
} else if ($dropint < 85) {
    obj_add(npc_coord, firerune, 6, ^lootdrop_duration);
} else if ($dropint < 87) {
    obj_add(npc_coord, mindrune, 9, ^lootdrop_duration);
} else if ($dropint < 89) {
    obj_add(npc_coord, copper_ore, 1, ^lootdrop_duration);
} else if ($dropint < 91) {
    obj_add(npc_coord, earth_talisman, 1, ^lootdrop_duration);
} else if ($dropint < 92) {
    obj_add(npc_coord, coins, 25, ^lootdrop_duration);
} else if ($dropint < 93) {
    obj_add(npc_coord, chaosrune, 2, ^lootdrop_duration);
} else if ($dropint < 94) {
    obj_add(npc_coord, bronze_med_helm, 1, ^lootdrop_duration);
} else if ($dropint < 95) {
    obj_add(npc_coord, iron_dagger, 1, ^lootdrop_duration);
} else if ($dropint < 96) {
    obj_add(npc_coord, cabbage, 1, ^lootdrop_duration);
} else if ($dropint < 119) {
    obj_add(npc_coord, ~randomherb, ^lootdrop_duration);
}
