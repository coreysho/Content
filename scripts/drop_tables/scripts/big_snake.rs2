// Big Snake - https://oldschool.runescape.wiki/w/Big_Snake

[ai_queue3,hundred_ilm_snake] @hundred_ilm_snake_drop_table;

[label,hundred_ilm_snake_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

// Bones / ashes, set on the npc config.
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

obj_add(npc_coord, hundred_ilm_snake_corpse, 1, ^lootdrop_duration);

