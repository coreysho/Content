// Farmer - https://oldschool.runescape.wiki/w/Farmer

[ai_queue3,farmer2] @farmer2_drop_table;
[ai_queue3,farmer3] @farmer2_drop_table;

[label,farmer2_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

// Bones / ashes, set on the npc config.
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

~trail_easycluedrop(^trail_easy_droprate, npc_coord);

def_int $dropint = random(128);
if ($dropint < 33) {
    obj_add(npc_coord, coins, 3, ^lootdrop_duration);
} else if ($dropint < 56) {
    obj_add(npc_coord, ~roll_general_seed_table(7), ^lootdrop_duration);
} else if ($dropint < 65) {
    obj_add(npc_coord, ~randomherb, ^lootdrop_duration);
} else if ($dropint < 69) {
    obj_add(npc_coord, fishing_bait, 1, ^lootdrop_duration);
} else if ($dropint < 71) {
    obj_add(npc_coord, rake, 1, ^lootdrop_duration);
} else if ($dropint < 72) {
    obj_add(npc_coord, earthrune, 4, ^lootdrop_duration);
} else if ($dropint < 73) {
    obj_add(npc_coord, firerune, 6, ^lootdrop_duration);
} else if ($dropint < 74) {
    obj_add(npc_coord, mindrune, 9, ^lootdrop_duration);
} else if ($dropint < 75) {
    obj_add(npc_coord, earth_talisman, 1, ^lootdrop_duration);
} else if ($dropint < 76) {
    obj_add(npc_coord, gardening_boots, 1, ^lootdrop_duration);
} else if ($dropint < 77) {
    obj_add(npc_coord, dibber, 1, ^lootdrop_duration);
} else if ($dropint < 78) {
    obj_add(npc_coord, chaosrune, 2, ^lootdrop_duration);
} else if ($dropint < 79) {
    obj_add(npc_coord, coins, 25, ^lootdrop_duration);
} else if ($dropint < 80) {
    obj_add(npc_coord, secateurs, 1, ^lootdrop_duration);
} else if ($dropint < 81) {
    obj_add(npc_coord, watering_can_8, 1, ^lootdrop_duration);
} else if ($dropint < 82) {
    obj_add(npc_coord, bronze_med_helm, 1, ^lootdrop_duration);
} else if ($dropint < 83) {
    obj_add(npc_coord, iron_dagger, 1, ^lootdrop_duration);
} else if ($dropint < 85) {
    obj_add(npc_coord, bronze_arrow, 7, ^lootdrop_duration);
} else if ($dropint < 105) {
    obj_add(npc_coord, coins, 10, ^lootdrop_duration);
} else if ($dropint < 112) {
    obj_add(npc_coord, coins, 5, ^lootdrop_duration);
} else if ($dropint < 115) {
    obj_add(npc_coord, coins, 15, ^lootdrop_duration);
} else if ($dropint < 116) {
    obj_add(npc_coord, copper_ore, 1, ^lootdrop_duration);
} else if ($dropint < 117) {
    obj_add(npc_coord, cabbage, 1, ^lootdrop_duration);
}
