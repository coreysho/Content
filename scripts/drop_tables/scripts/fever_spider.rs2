// Fever Spider - https://oldschool.runescape.wiki/w/Fever_Spider

[ai_queue3,deal_fever_spiders1] @deal_fever_spiders1_drop_table;

[label,deal_fever_spiders1_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

obj_add(npc_coord, deal_spider_body, 1, ^lootdrop_duration);

def_int $dropint = random(512);
if ($dropint < 114) {
    obj_add(npc_coord, coins, calc(random(401) + 200), ^lootdrop_duration);
} else if ($dropint < 214) {
    obj_add(npc_coord, bass, calc(random(2) + 1), ^lootdrop_duration);
} else if ($dropint < 299) {
    obj_add(npc_coord, unidentified_kwuarm, 1, ^lootdrop_duration);
} else if ($dropint < 356) {
    obj_add(npc_coord, limpwurt_root, 1, ^lootdrop_duration);
} else if ($dropint < 399) {
    obj_add(npc_coord, red_dragonhide_chaps, 1, ^lootdrop_duration);
} else if ($dropint < 427) {
    obj_add(npc_coord, adamant_axe, 1, ^lootdrop_duration);
} else if ($dropint < 455) {
    obj_add(npc_coord, adamant_med_helm, 1, ^lootdrop_duration);
} else if ($dropint < 483) {
    obj_add(npc_coord, blankrune_high, calc(random(101) + 100), ^lootdrop_duration);
} else if ($dropint < 497) {
    obj_add(npc_coord, adamant_battleaxe, 1, ^lootdrop_duration);
} else if ($dropint < 511) {
    obj_add(npc_coord, ~ultrarare_getitem, ^lootdrop_duration);
}
