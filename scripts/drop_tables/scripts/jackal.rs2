// Jackal - https://oldschool.runescape.wiki/w/Jackal

[ai_queue3,ics_little_jackal] @ics_little_jackal_drop_table;

[label,ics_little_jackal_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

// Bones / ashes, set on the npc config.
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

def_int $dropint = random(128);
if ($dropint < 32) {
    obj_add(npc_coord, rag_jackal_bone, 1, ^lootdrop_duration);
}
