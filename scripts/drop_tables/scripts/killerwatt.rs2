// Killerwatt - https://oldschool.runescape.wiki/w/Killerwatt

[ai_queue3,slayer_killerwatt_ball] @slayer_killerwatt_ball_drop_table;

[label,slayer_killerwatt_ball_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

// Bones / ashes, set on the npc config.
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

if (random(512) = 0) {
    obj_add(npc_coord, mystic_fire_staff, 1, ^lootdrop_duration);
}

def_int $dropint = random(512);
if ($dropint < 113) {
    obj_add(npc_coord, ~randomherb, ^lootdrop_duration);
} else if ($dropint < 204) {
    obj_add(npc_coord, coins, 44, ^lootdrop_duration);
} else if ($dropint < 279) {
    obj_add(npc_coord, coins, 11, ^lootdrop_duration);
} else if ($dropint < 315) {
    obj_add(npc_coord, naturerune, 8, ^lootdrop_duration);
} else if ($dropint < 351) {
    obj_add(npc_coord, coins, 200, ^lootdrop_duration);
} else if ($dropint < 380) {
    obj_add(npc_coord, chaosrune, 4, ^lootdrop_duration);
} else if ($dropint < 406) {
    obj_add(npc_coord, firerune, 45, ^lootdrop_duration);
} else if ($dropint < 422) {
    obj_add(npc_coord, firerune, 18, ^lootdrop_duration);
} else if ($dropint < 438) {
    obj_add(npc_coord, ~ultrarare_getitem, ^lootdrop_duration);
} else if ($dropint < 448) {
    obj_add(npc_coord, airrune, 5, ^lootdrop_duration);
} else if ($dropint < 458) {
    obj_add(npc_coord, deathrune, 2, ^lootdrop_duration);
} else if ($dropint < 464) {
    obj_add(npc_coord, staff_of_fire, 1, ^lootdrop_duration);
} else if ($dropint < 470) {
    obj_add(npc_coord, staff_of_air, 1, ^lootdrop_duration);
} else if ($dropint < 476) {
    obj_add(npc_coord, airrune, 17, ^lootdrop_duration);
} else if ($dropint < 482) {
    obj_add(npc_coord, steamrune, 2, ^lootdrop_duration);
} else if ($dropint < 488) {
    obj_add(npc_coord, mcannonball, 3, ^lootdrop_duration);
} else if ($dropint < 491) {
    obj_add(npc_coord, fire_battlestaff, 1, ^lootdrop_duration);
} else if ($dropint < 494) {
    obj_add(npc_coord, air_battlestaff, 1, ^lootdrop_duration);
} else if ($dropint < 497) {
    obj_add(npc_coord, naturerune, 37, ^lootdrop_duration);
} else if ($dropint < 500) {
    obj_add(npc_coord, fire_orb, 2, ^lootdrop_duration);
} else if ($dropint < 503) {
    obj_add(npc_coord, soda_ash, 4, ^lootdrop_duration);
} else if ($dropint < 506) {
    obj_add(npc_coord, coins, 76, ^lootdrop_duration);
} else if ($dropint < 509) {
    obj_add(npc_coord, coins, 127, ^lootdrop_duration);
}
