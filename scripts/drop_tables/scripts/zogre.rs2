// Zogre - https://oldschool.runescape.wiki/w/Zogre

[ai_queue3,zogre_1] @zogre_1_drop_table;
[ai_queue3,zogre_2] @zogre_1_drop_table;
[ai_queue3,zogre_3] @zogre_1_drop_table;
[ai_queue3,zogre_4] @zogre_1_drop_table;
[ai_queue3,zogre_5] @zogre_1_drop_table;
[ai_queue3,zogre_6] @zogre_1_drop_table;
[ai_queue3,zogre_dance_1] @zogre_1_drop_table;
[ai_queue3,zogre_dance_2] @zogre_1_drop_table;
[ai_queue3,zogre_dance_3] @zogre_1_drop_table;
[ai_queue3,zogre_dance_4] @zogre_1_drop_table;
[ai_queue3,zogre_drummer1] @zogre_1_drop_table;

[label,zogre_1_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

// Bones / ashes, set on the npc config.
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

obj_add(npc_coord, zogre_coffinkey, 1, ^lootdrop_duration);

