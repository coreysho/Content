// Skeleton - https://oldschool.runescape.wiki/w/Skeleton

[ai_queue3,barrows_skeleton_armed] @barrows_skeleton_armed_drop_table;
[ai_queue3,barrows_skeleton_unarmed] @barrows_skeleton_armed_drop_table;
[ai_queue3,dragonslayer_skeleton_2] @barrows_skeleton_armed_drop_table;
[ai_queue3,dragonslayer_skeleton_3] @barrows_skeleton_armed_drop_table;
[ai_queue3,draynor_skeleton] @barrows_skeleton_armed_drop_table;
[ai_queue3,mm_skeleton] @barrows_skeleton_armed_drop_table;

[label,barrows_skeleton_armed_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

// Bones / ashes, set on the npc config.
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

def_int $dropint = random(128);
if ($dropint < 18) {
    obj_add(npc_coord, coins, 2, ^lootdrop_duration);
} else if ($dropint < 33) {
    obj_add(npc_coord, coins, 12, ^lootdrop_duration);
} else if ($dropint < 40) {
    obj_add(npc_coord, coins, 4, ^lootdrop_duration);
} else if ($dropint < 44) {
    obj_add(npc_coord, coins, 33, ^lootdrop_duration);
} else if ($dropint < 48) {
    obj_add(npc_coord, coins, 25, ^lootdrop_duration);
} else if ($dropint < 52) {
    obj_add(npc_coord, coins, 16, ^lootdrop_duration);
} else if ($dropint < 53) {
    obj_add(npc_coord, coins, 48, ^lootdrop_duration);
} else if ($dropint < 60) {
    obj_add(npc_coord, bronze_arrow, 2, ^lootdrop_duration);
} else if ($dropint < 64) {
    obj_add(npc_coord, bronze_arrow, 5, ^lootdrop_duration);
} else if ($dropint < 68) {
    obj_add(npc_coord, iron_arrow, 1, ^lootdrop_duration);
} else if ($dropint < 69) {
    obj_add(npc_coord, steel_arrow, 1, ^lootdrop_duration);
} else if ($dropint < 71) {
    obj_add(npc_coord, airrune, 12, ^lootdrop_duration);
} else if ($dropint < 73) {
    obj_add(npc_coord, earthrune, 3, ^lootdrop_duration);
} else if ($dropint < 75) {
    obj_add(npc_coord, chaosrune, 3, ^lootdrop_duration);
} else if ($dropint < 77) {
    obj_add(npc_coord, firerune, 2, ^lootdrop_duration);
} else if ($dropint < 78) {
    obj_add(npc_coord, naturerune, 3, ^lootdrop_duration);
} else if ($dropint < 81) {
    obj_add(npc_coord, iron_dagger, 1, ^lootdrop_duration);
} else if ($dropint < 102) {
    obj_add(npc_coord, ~randomherb, ^lootdrop_duration);
} else if ($dropint < 103) {
    obj_add(npc_coord, ~ultrarare_getitem, ^lootdrop_duration);
}
