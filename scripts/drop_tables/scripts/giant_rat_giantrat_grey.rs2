// Giant rat - https://oldschool.runescape.wiki/w/Giant_rat

[ai_queue3,giantrat_grey] @giantrat_grey_drop_table;

[label,giantrat_grey_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

// Bones / ashes, set on the npc config.
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

obj_add(npc_coord, raw_rat_meat, 1, ^lootdrop_duration);

