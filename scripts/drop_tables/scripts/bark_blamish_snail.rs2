// Bark Blamish Snail - https://oldschool.runescape.wiki/w/Bark_Blamish_Snail

[ai_queue3,mmsnailround_orange] @mmsnailround_orange_drop_table;

[label,mmsnailround_orange_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

obj_add(npc_coord, shellround_orange, 1, ^lootdrop_duration);
obj_add(npc_coord, snail_corpse2, 1, ^lootdrop_duration);

