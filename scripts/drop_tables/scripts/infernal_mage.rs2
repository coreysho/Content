// Infernal Mage - https://oldschool.runescape.wiki/w/Infernal_Mage

[ai_queue3,slayer_infernal_mage_1] @slayer_infernal_mage_1_drop_table;
[ai_queue3,slayer_infernal_mage_2] @slayer_infernal_mage_1_drop_table;
[ai_queue3,slayer_infernal_mage_3] @slayer_infernal_mage_1_drop_table;
[ai_queue3,slayer_infernal_mage_4] @slayer_infernal_mage_1_drop_table;
[ai_queue3,slayer_infernal_mage_5] @slayer_infernal_mage_1_drop_table;

[label,slayer_infernal_mage_1_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

// Bones / ashes, set on the npc config.
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

obj_add(npc_coord, bones, 1, ^lootdrop_duration);

if (random(1000) = 0) {
    obj_add(npc_coord, lava_battlestaff, 1, ^lootdrop_duration);
}
if (random(512) = 0) {
    obj_add(npc_coord, mystic_hat_dark, 1, ^lootdrop_duration);
}
if (random(512) = 0) {
    obj_add(npc_coord, mystic_boots_dark, 1, ^lootdrop_duration);
}

def_int $dropint = random(128);
if ($dropint < 18) {
    obj_add(npc_coord, deathrune, 7, ^lootdrop_duration);
} else if ($dropint < 26) {
    obj_add(npc_coord, plainstaff, 1, ^lootdrop_duration);
} else if ($dropint < 27) {
    obj_add(npc_coord, staff_of_fire, 1, ^lootdrop_duration);
} else if ($dropint < 33) {
    obj_add(npc_coord, earthrune, 10, ^lootdrop_duration);
} else if ($dropint < 39) {
    obj_add(npc_coord, firerune, 10, ^lootdrop_duration);
} else if ($dropint < 43) {
    obj_add(npc_coord, earthrune, 36, ^lootdrop_duration);
} else if ($dropint < 46) {
    obj_add(npc_coord, airrune, 10, ^lootdrop_duration);
} else if ($dropint < 49) {
    obj_add(npc_coord, waterrune, 10, ^lootdrop_duration);
} else if ($dropint < 51) {
    obj_add(npc_coord, airrune, 18, ^lootdrop_duration);
} else if ($dropint < 53) {
    obj_add(npc_coord, waterrune, 18, ^lootdrop_duration);
} else if ($dropint < 55) {
    obj_add(npc_coord, earthrune, 18, ^lootdrop_duration);
} else if ($dropint < 57) {
    obj_add(npc_coord, firerune, 18, ^lootdrop_duration);
} else if ($dropint < 59) {
    obj_add(npc_coord, mindrune, 18, ^lootdrop_duration);
} else if ($dropint < 61) {
    obj_add(npc_coord, bodyrune, 18, ^lootdrop_duration);
} else if ($dropint < 63) {
    obj_add(npc_coord, bloodrune, 4, ^lootdrop_duration);
} else if ($dropint < 84) {
    obj_add(npc_coord, coins, 1, ^lootdrop_duration);
} else if ($dropint < 100) {
    obj_add(npc_coord, coins, 2, ^lootdrop_duration);
} else if ($dropint < 109) {
    obj_add(npc_coord, coins, 4, ^lootdrop_duration);
} else if ($dropint < 112) {
    obj_add(npc_coord, coins, 29, ^lootdrop_duration);
}
