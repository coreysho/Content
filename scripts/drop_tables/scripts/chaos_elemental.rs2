// Chaos Elemental - https://oldschool.runescape.wiki/w/Chaos_Elemental

[ai_queue3,chaoselemental] @chaoselemental_drop_table;

[label,chaoselemental_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

def_int $dropint = random(512);
if ($dropint < 97) {
    obj_add(npc_coord, dragon_bones, 1, ^lootdrop_duration);
} else if ($dropint < 127) {
    obj_add(npc_coord, ~ultrarare_getitem, ^lootdrop_duration);
} else if ($dropint < 146) {
    obj_add(npc_coord, rune_dart, 100, ^lootdrop_duration);
} else if ($dropint < 161) {
    obj_add(npc_coord, rune_platelegs, 1, ^lootdrop_duration);
} else if ($dropint < 176) {
    obj_add(npc_coord, rune_plateskirt, 1, ^lootdrop_duration);
} else if ($dropint < 187) {
    obj_add(npc_coord, rune_2h_sword, 1, ^lootdrop_duration);
} else if ($dropint < 198) {
    obj_add(npc_coord, rune_battleaxe, 1, ^lootdrop_duration);
} else if ($dropint < 209) {
    obj_add(npc_coord, rune_full_helm, 1, ^lootdrop_duration);
} else if ($dropint < 220) {
    obj_add(npc_coord, rune_kiteshield, 1, ^lootdrop_duration);
} else if ($dropint < 231) {
    obj_add(npc_coord, mystic_air_staff, 1, ^lootdrop_duration);
} else if ($dropint < 242) {
    obj_add(npc_coord, mystic_water_staff, 1, ^lootdrop_duration);
} else if ($dropint < 253) {
    obj_add(npc_coord, mystic_earth_staff, 1, ^lootdrop_duration);
} else if ($dropint < 264) {
    obj_add(npc_coord, mystic_fire_staff, 1, ^lootdrop_duration);
} else if ($dropint < 271) {
    obj_add(npc_coord, dragon_dagger, 1, ^lootdrop_duration);
} else if ($dropint < 278) {
    obj_add(npc_coord, dragon_2h_sword, 1, ^lootdrop_duration);
} else if ($dropint < 285) {
    obj_add(npc_coord, dragon_platelegs, 1, ^lootdrop_duration);
} else if ($dropint < 292) {
    obj_add(npc_coord, dragon_plateskirt, 1, ^lootdrop_duration);
} else if ($dropint < 322) {
    obj_add(npc_coord, chaosrune, calc(random(201) + 300), ^lootdrop_duration);
} else if ($dropint < 352) {
    obj_add(npc_coord, bloodrune, calc(random(151) + 100), ^lootdrop_duration);
} else if ($dropint < 371) {
    obj_add(npc_coord, rune_arrow, 150, ^lootdrop_duration);
} else if ($dropint < 386) {
    obj_add(npc_coord, unidentified_ranarr, calc(random(4) + 5), ^lootdrop_duration);
} else if ($dropint < 401) {
    obj_add(npc_coord, unidentified_snapdragon, calc(random(4) + 5), ^lootdrop_duration);
} else if ($dropint < 412) {
    obj_add(npc_coord, unidentified_avantoe, calc(random(4) + 5), ^lootdrop_duration);
} else if ($dropint < 423) {
    obj_add(npc_coord, unidentified_kwuarm, calc(random(4) + 5), ^lootdrop_duration);
} else if ($dropint < 442) {
    obj_add(npc_coord, coal, calc(random(76) + 75), ^lootdrop_duration);
} else if ($dropint < 457) {
    obj_add(npc_coord, runite_bar, calc(random(3) + 3), ^lootdrop_duration);
} else if ($dropint < 472) {
    obj_add(npc_coord, adamantite_bar, calc(random(5) + 8), ^lootdrop_duration);
} else if ($dropint < 498) {
    obj_add(npc_coord, coins, calc(random(9991) + 20005), ^lootdrop_duration);
}
