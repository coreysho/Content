// Harpie Bug Swarm - https://oldschool.runescape.wiki/w/Harpie_Bug_Swarm

[ai_queue3,slayer_harpiebugswarm] @slayer_harpiebugswarm_drop_table;

[label,slayer_harpiebugswarm_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

~trail_mediumcluedrop(^trail_medium_droprate, npc_coord);

def_int $dropint = random(128);
if ($dropint < 25) {
    obj_add(npc_coord, coins, 40, ^lootdrop_duration);
} else if ($dropint < 45) {
    obj_add(npc_coord, firerune, 30, ^lootdrop_duration);
} else if ($dropint < 65) {
    obj_add(npc_coord, coins, 160, ^lootdrop_duration);
} else if ($dropint < 75) {
    obj_add(npc_coord, coins, 230, ^lootdrop_duration);
} else if ($dropint < 83) {
    obj_add(npc_coord, firerune, 60, ^lootdrop_duration);
} else if ($dropint < 91) {
    obj_add(npc_coord, gold_ore, 1, ^lootdrop_duration);
} else if ($dropint < 98) {
    obj_add(npc_coord, coins, 30, ^lootdrop_duration);
} else if ($dropint < 103) {
    obj_add(npc_coord, chaosrune, 15, ^lootdrop_duration);
} else if ($dropint < 107) {
    obj_add(npc_coord, steel_axe, 1, ^lootdrop_duration);
} else if ($dropint < 111) {
    obj_add(npc_coord, steel_full_helm, 1, ^lootdrop_duration);
} else if ($dropint < 114) {
    obj_add(npc_coord, deathrune, 3, ^lootdrop_duration);
} else if ($dropint < 117) {
    obj_add(npc_coord, staff_of_fire, 1, ^lootdrop_duration);
} else if ($dropint < 119) {
    obj_add(npc_coord, coins, 490, ^lootdrop_duration);
} else if ($dropint < 121) {
    obj_add(npc_coord, mithril_chainbody, 1, ^lootdrop_duration);
} else if ($dropint < 123) {
    obj_add(npc_coord, jug_wine, 1, ^lootdrop_duration);
} else if ($dropint < 124) {
    obj_add(npc_coord, adamant_med_helm, 1, ^lootdrop_duration);
} else if ($dropint < 125) {
    obj_add(npc_coord, steel_armoured_boots, 1, ^lootdrop_duration);
} else if ($dropint < 128) {
    obj_add(npc_coord, ~ultrarare_getitem, ^lootdrop_duration);
}
