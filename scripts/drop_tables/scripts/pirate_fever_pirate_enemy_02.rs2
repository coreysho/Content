// Pirate - https://oldschool.runescape.wiki/w/Pirate

[ai_queue3,fever_pirate_enemy_02] @fever_pirate_enemy_02_drop_table;
[ai_queue3,fever_pirate_enemy_03] @fever_pirate_enemy_02_drop_table;
[ai_queue3,fever_pirate_enemy_04] @fever_pirate_enemy_02_drop_table;
[ai_queue3,fever_pirate_enemy_05] @fever_pirate_enemy_02_drop_table;
[ai_queue3,fever_pirate_enemy_06] @fever_pirate_enemy_02_drop_table;
[ai_queue3,fever_pirate_enemy_07] @fever_pirate_enemy_02_drop_table;
[ai_queue3,fever_pirate_enemy_08] @fever_pirate_enemy_02_drop_table;
[ai_queue3,fever_pirate_enemy_09] @fever_pirate_enemy_02_drop_table;
[ai_queue3,fever_pirate_enemy_10] @fever_pirate_enemy_02_drop_table;
[ai_queue3,jail_pirate] @fever_pirate_enemy_02_drop_table;

[label,fever_pirate_enemy_02_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

// Bones / ashes, set on the npc config.
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

def_int $dropint = random(128);
if ($dropint < 29) {
    obj_add(npc_coord, coins, 4, ^lootdrop_duration);
} else if ($dropint < 42) {
    obj_add(npc_coord, coins, 25, ^lootdrop_duration);
} else if ($dropint < 50) {
    obj_add(npc_coord, coins, 7, ^lootdrop_duration);
} else if ($dropint < 56) {
    obj_add(npc_coord, coins, 12, ^lootdrop_duration);
} else if ($dropint < 60) {
    obj_add(npc_coord, coins, 35, ^lootdrop_duration);
} else if ($dropint < 61) {
    obj_add(npc_coord, coins, 55, ^lootdrop_duration);
} else if ($dropint < 73) {
    obj_add(npc_coord, eye_patch, 1, ^lootdrop_duration);
} else if ($dropint < 83) {
    obj_add(npc_coord, bolt, calc(random(11) + 2), ^lootdrop_duration);
} else if ($dropint < 89) {
    obj_add(npc_coord, iron_dagger, 1, ^lootdrop_duration);
} else if ($dropint < 95) {
    obj_add(npc_coord, chaosrune, 2, ^lootdrop_duration);
} else if ($dropint < 100) {
    obj_add(npc_coord, naturerune, 2, ^lootdrop_duration);
} else if ($dropint < 104) {
    obj_add(npc_coord, bronze_scimitar, 1, ^lootdrop_duration);
} else if ($dropint < 107) {
    obj_add(npc_coord, bronze_arrow, 9, ^lootdrop_duration);
} else if ($dropint < 109) {
    obj_add(npc_coord, bronze_arrow, 12, ^lootdrop_duration);
} else if ($dropint < 111) {
    obj_add(npc_coord, airrune, 10, ^lootdrop_duration);
} else if ($dropint < 113) {
    obj_add(npc_coord, earthrune, 9, ^lootdrop_duration);
} else if ($dropint < 115) {
    obj_add(npc_coord, firerune, 5, ^lootdrop_duration);
} else if ($dropint < 116) {
    obj_add(npc_coord, lawrune, 2, ^lootdrop_duration);
} else if ($dropint < 117) {
    obj_add(npc_coord, iron_platebody, 1, ^lootdrop_duration);
} else if ($dropint < 118) {
    obj_add(npc_coord, chefs_hat, 1, ^lootdrop_duration);
} else if ($dropint < 119) {
    obj_add(npc_coord, iron_bar, 1, ^lootdrop_duration);
} else if ($dropint < 120) {
    obj_add(npc_coord, ~ultrarare_getitem, ^lootdrop_duration);
}
