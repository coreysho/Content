// Bloodveld - https://oldschool.runescape.wiki/w/Bloodveld

[ai_queue3,slayer_bloodveld] @slayer_bloodveld_drop_table;
[ai_queue3,slayer_bloodveld_baby] @slayer_bloodveld_drop_table;

[label,slayer_bloodveld_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

~trail_hardcluedrop(^trail_hard_droprate, npc_coord);

def_int $dropint = random(128);
if ($dropint < 27) {
    obj_add(npc_coord, coins, 120, ^lootdrop_duration);
} else if ($dropint < 53) {
    obj_add(npc_coord, coins, 40, ^lootdrop_duration);
} else if ($dropint < 62) {
    obj_add(npc_coord, coins, 200, ^lootdrop_duration);
} else if ($dropint < 68) {
    obj_add(npc_coord, coins, 10, ^lootdrop_duration);
} else if ($dropint < 69) {
    obj_add(npc_coord, coins, 450, ^lootdrop_duration);
} else if ($dropint < 78) {
    obj_add(npc_coord, bones, 1, ^lootdrop_duration);
} else if ($dropint < 85) {
    obj_add(npc_coord, firerune, 60, ^lootdrop_duration);
} else if ($dropint < 91) {
    obj_add(npc_coord, big_bones, 1, ^lootdrop_duration);
} else if ($dropint < 95) {
    obj_add(npc_coord, bloodrune, 10, ^lootdrop_duration);
} else if ($dropint < 98) {
    obj_add(npc_coord, steel_axe, 1, ^lootdrop_duration);
} else if ($dropint < 101) {
    obj_add(npc_coord, steel_full_helm, 1, ^lootdrop_duration);
} else if ($dropint < 103) {
    obj_add(npc_coord, bloodrune, 3, ^lootdrop_duration);
} else if ($dropint < 105) {
    obj_add(npc_coord, big_bones, 3, ^lootdrop_duration);
} else if ($dropint < 107) {
    obj_add(npc_coord, meat_pizza, 1, ^lootdrop_duration);
} else if ($dropint < 108) {
    obj_add(npc_coord, steel_scimitar, 1, ^lootdrop_duration);
} else if ($dropint < 109) {
    obj_add(npc_coord, gold_ore, 1, ^lootdrop_duration);
} else if ($dropint < 110) {
    obj_add(npc_coord, black_armoured_boots, 1, ^lootdrop_duration);
} else if ($dropint < 111) {
    obj_add(npc_coord, mithril_sq_shield, 1, ^lootdrop_duration);
} else if ($dropint < 112) {
    obj_add(npc_coord, mithril_chainbody, 1, ^lootdrop_duration);
} else if ($dropint < 113) {
    obj_add(npc_coord, rune_med_helm, 1, ^lootdrop_duration);
} else if ($dropint < 114) {
    obj_add(npc_coord, bloodrune, 30, ^lootdrop_duration);
} else if ($dropint < 115) {
    obj_add(npc_coord, ~randomherb, ^lootdrop_duration);
} else if ($dropint < 118) {
    obj_add(npc_coord, ~ultrarare_getitem, ^lootdrop_duration);
}
