// THE TRADING POST. Tabs of the lists window.
^tp_tab_browse = 0
^tp_tab_mine = 1
^tp_tab_offers = 2
^tp_tab_box = 3

// what %tp_confirm is armed for
^tp_confirm_none = 0
^tp_confirm_buynow = 1
^tp_confirm_accept = 2
^tp_confirm_cancel = 3

// which window is open, so the inventory beside it knows whether a click lists or offers
^tp_window_lists = 0
^tp_window_listing = 1
^tp_window_offer = 2

// the lists window's grid is 8 x 4, and tp_view is that size
^tp_page_size = 32
// engine/src/engine/market/TradingPost.ts TP_MAX_LISTINGS - shown, not enforced, here
^tp_max_listings = 10
// the orange every button in these windows is drawn in, for putting a row back after it was white
^tp_orange = 0xFF981F
