// PLATINUM TOKENS. One token is worth a thousand coins, and nothing else about it is a special
// case: it is an ordinary stackable item that the trading post will swap for coins either way.
//
// WHY THEY EXIST. Every stack in this game is a signed 32-bit integer, so a player cannot hold,
// bank, trade or list more than 2,147,483,647 coins - and with the bank at 1410 slots and the
// trading post taking coin offers, that ceiling is reachable. A token at a thousand to one moves
// it to just over two trillion without touching a single engine limit.
//
// THE ART IS THE COIN PILE, RECOLOURED. 377's cache has no platinum token and none can be
// imported here, so every entry below is the matching coins_* model with its one face colour
// (hsl16 8128, the gold) swapped for a pale platinum - see tools/models/ob2palette.py, which is
// what found the source value. The pile therefore grows with the stack exactly as coins do, and a
// token is never mistaken for a coin at a glance.
//
// The nine count links are coins' own thresholds. They must stay in step: a count link that named
// a coins_* model would put gold in the inventory for that size of stack only.

[platinum_token]
name=Platinum token
desc=A token of immense wealth. Worth 1000 coins.
model=obj_coins
recol1s=32480
recol1d=25404
cost=1000
stackable=yes
2dxof=3
2dzoom=710
2dyan=2012
2dxan=184
count1=platinum_token_2,2
count2=platinum_token_3,3
count3=platinum_token_4,4
count4=platinum_token_5,5
count5=platinum_token_25,25
count6=platinum_token_100,100
count7=platinum_token_250,250
count8=platinum_token_1000,1000
count9=platinum_token_10000,10000
weight=2g

