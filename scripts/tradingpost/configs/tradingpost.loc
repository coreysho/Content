// THE TRADING POST. The model is built by tools/models/gentradingpostmodel.py: a notice board of
// listings, a strongbox for the collection box, and a crate of coins. Two tiles wide.
//
// It faces SOUTH at angle 0 - the notices, the strongbox and the approach are all on that side -
// and forceapproach turns with the loc, so a post placed at any angle is used from its front.
// Edgeville's is at angle 3, facing east across the road to the bank door.
[trading_post]
name=Trading post
desc=Goods for sale, pinned up by other players. The strongbox holds what you're owed.
model=trading_post
width=2
length=1
forceapproach=south
blockrange=no
ambient=25
contrast=125
op1=Browse
op2=Sell
op3=Collect

// The trading post's minimap icon: Old School's Grand Exchange icon (OSRS sprite 1531, coins over a
// sack), map icon 70 - the 71st, added to sprites/mapfunction.png for it. It is a loc of its own,
// as every map icon is: the client only reads mapfunction off GROUND DECORATION (shape 22), which is
// why Jagex marked shops with general_store_icon and the like - an invisible model, forcedecor - and
// never on the building. Placed on the post's own tile in maps/m48_54.jm2.
[trading_post_icon]
model=minigame_start_icon
forcedecor=yes
mapfunction=70
