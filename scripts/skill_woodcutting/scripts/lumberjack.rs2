// Lumberjack outfit - equip gate.
//
// NOT IMPLEMENTED: the woodcutting experience bonus (hat 0.4%, top 0.8%, legs 0.6%, boots 0.2%,
// plus 0.5% for the full set = 2.5%) is script work in the woodcutting xp path, not config.
// These items are asset + gate only for now.

[label,lumberjack_require](int $slot)
if (stat_base(woodcutting) < 44) {
    mes("You need level 44 Woodcutting to wear this.");
    return;
}
~equip($slot);

[opheld2,lumberjack_hat] @lumberjack_require(last_slot);
[opheld2,lumberjack_top] @lumberjack_require(last_slot);
[opheld2,lumberjack_legs] @lumberjack_require(last_slot);
[opheld2,lumberjack_boots] @lumberjack_require(last_slot);
