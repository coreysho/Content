// Woodcutting skill guide, shown on the original RS2 skill guide interface
// (see content/scripts/interfaces/skill_guide.rs2 for the generic driver).
[proc,open_woodcutting_guide]
~skillguide_begin(^guide_woodcutting, "Woodcutting");
def_int $lvl = stat(woodcutting);
~skillguide_row(1, $lvl, 1, bronze_axe, "Bronze axe");
~skillguide_row(2, $lvl, 1, iron_axe, "Iron axe");
~skillguide_row(3, $lvl, 1, logs, "Logs");
~skillguide_row(4, $lvl, 1, achey_tree_logs, "Achey tree logs");
~skillguide_row(5, $lvl, 6, steel_axe, "Steel axe");
~skillguide_row(6, $lvl, 11, black_axe, "Black axe");
~skillguide_row(7, $lvl, 15, oak_logs, "Oak logs");
~skillguide_row(8, $lvl, 21, mithril_axe, "Mithril axe");
~skillguide_row(9, $lvl, 30, willow_logs, "Willow logs");
~skillguide_row(10, $lvl, 31, adamant_axe, "Adamant axe");
~skillguide_row(11, $lvl, 35, teak_logs, "Teak logs");
~skillguide_row(12, $lvl, 41, rune_axe, "Rune axe");
~skillguide_row(13, $lvl, 61, dragon_axe, "Dragon axe");
~skillguide_row(14, $lvl, 45, maple_logs, "Maple logs");
~skillguide_row(15, $lvl, 50, mahogany_logs, "Mahogany logs");
~skillguide_row(16, $lvl, 60, yew_logs, "Yew logs");
~skillguide_row(17, $lvl, 75, magic_logs, "Magic logs");
~skillguide_show;
