// THE DRAGON PICKAXE'S MINING SWING (2026-09-21). It borrowed human_mining_rune_pickaxe, and that
// seq carries replaceheldright/left=rune_pickaxe - it tells the client which pickaxe to draw in
// the hand for the length of the swing - so a player mining with a dragon pickaxe was shown
// holding a rune one every time it swung. This is the same seq, the same frames and timing, with
// the dragon pickaxe in the hand.
[human_mining_dragon_pickaxe]
replaceheldright=dragon_pickaxe
replaceheldleft=dragon_pickaxe
priority=0
loops=8
maxloops=3
postanim_move=abortanim
duplicatebehaviour=reset
frame1=anim_584
frame2=anim_876
frame3=anim_1156
frame4=anim_1444
frame5=anim_1743
frame6=anim_2042
frame7=anim_2345
frame8=anim_626
frame9=anim_7085
frame10=anim_7084
frame11=anim_7086
frame12=anim_7087
