// Mining skill guide, shown on the original RS2 skill guide interface
// (see content/scripts/interfaces/skill_guide.rs2 for the generic driver).
[proc,open_mining_guide]
~skillguide_begin(^guide_mining, "Mining");
def_int $lvl = stat(mining);
~skillguide_row(1, $lvl, 1, clay, "Clay");
~skillguide_row(2, $lvl, 1, copper_ore, "Copper ore");
~skillguide_row(3, $lvl, 1, tin_ore, "Tin ore");
~skillguide_row(4, $lvl, 1, blankrune, "Rune essence");
~skillguide_row(5, $lvl, 1, bronze_pickaxe, "Bronze pickaxe");
~skillguide_row(6, $lvl, 1, iron_pickaxe, "Iron pickaxe");
~skillguide_row(7, $lvl, 6, steel_pickaxe, "Steel pickaxe");
~skillguide_row(8, $lvl, 10, blurite_ore, "Blurite ore");
~skillguide_row(9, $lvl, 15, iron_ore, "Iron ore");
~skillguide_row(10, $lvl, 20, silver_ore, "Silver ore");
~skillguide_row(11, $lvl, 21, mithril_pickaxe, "Mithril pickaxe");
~skillguide_row(12, $lvl, 30, coal, "Coal");
~skillguide_row(13, $lvl, 31, adamant_pickaxe, "Adamant pickaxe");
~skillguide_row(14, $lvl, 40, gold_ore, "Gold ore");
~skillguide_row(15, $lvl, 40, uncut_sapphire, "Gem rock");
~skillguide_row(16, $lvl, 41, rune_pickaxe, "Rune pickaxe");
~skillguide_row(17, $lvl, 55, mithril_ore, "Mithril ore");
~skillguide_row(18, $lvl, 70, adamantite_ore, "Adamantite ore");
~skillguide_row(19, $lvl, 85, runite_ore, "Runite ore");
~skillguide_show;
