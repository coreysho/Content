// volume setting if_closes here (interupts the cooking weakqueue)
// https://youtu.be/neAoU0yiGFY?t=98

[if_button,options:com_0]
if_close;
%option_brightness = 1;

[if_button,options:com_1]
if_close;
%option_brightness = 1;

[if_button,options:com_2]
if_close;
%option_brightness = 2;

[if_button,options:com_3]
if_close;
%option_brightness = 2;

[if_button,options:com_4]
if_close;
%option_brightness = 3;

[if_button,options:com_5]
if_close;
%option_brightness = 3;

[if_button,options:com_6]
if_close;
%option_brightness = 4;

[if_button,options:com_7]
if_close;
%option_brightness = 4;

[if_button,options:com_8]
if_close;
%option_mouse = 0;

[if_button,options:com_9]
if_close;
%option_mouse = 1;

[if_button,options:com_10]
if_close;
%option_chat = 0;

[if_button,options:com_11]
if_close;
%option_chat = 1;

[if_button,options:com_25]
if_close;
%option_music = 4;

[if_button,options:com_26]
if_close;
%option_music = 3;

[if_button,options:com_27]
if_close;
%option_music = 2;

[if_button,options:com_28]
if_close;
%option_music = 1;

[if_button,options:com_29]
if_close;
%option_music = 0;

[if_button,options:com_36]
if_close;
%option_sounds = 4;

[if_button,options:com_37]
if_close;
%option_sounds = 3;

[if_button,options:com_38]
if_close;
%option_sounds = 2;

[if_button,options:com_39]
if_close;
%option_sounds = 1;

[if_button,options:com_40]
if_close;
%option_sounds = 0;

[if_button,options:com_47]
if_close;
%option_pm = 1;

[if_button,options:com_48]
if_close;
%option_pm = 0;

// ACCEPT AID, and these two were setting the WRONG VARP. options.if's com_52 and com_53 are the
// Accept Aid Yes/No pair - both carry `script1op1=pushvar,option_aid` - but the handlers here set
// %option_pm, which belongs to com_47/com_48 above, the Split Private-chat pair. So clicking
// "Accept Aid: Yes" turned your private chat split ON and left aid exactly where it was, and
// nothing in the build read %option_aid at all, so nobody could see it. The low-detail tab
// (game_options_ld.rs2) had it right all along, which is what made the pair readable as a slip
// rather than a design.
[if_button,options:com_52]
if_close;
%option_aid = ^aid_yes;

[if_button,options:com_53]
if_close;
%option_aid = ^aid_no;
