// Clan chat ranks - the engine's numbers (Engine-TS src/engine/clan/ClanChat.ts), which are 2008's.
// Who may enter or talk is one of -1..7, who may kick one of 2..7; a friend's own rank is 0..6.
^clan_rank_anyone = -1
^clan_rank_friends = 0
^clan_rank_recruit = 1
^clan_rank_corporal = 2
^clan_rank_sergeant = 3
^clan_rank_lieutenant = 4
^clan_rank_captain = 5
^clan_rank_general = 6
^clan_rank_owner = 7

// clan_rank / clan_setrank's first argument
^clan_setting_enter = 0
^clan_setting_talk = 1
^clan_setting_kick = 2

// the friend rows Clan Setup has (LostCityServer tools/models/genclan474.py MAX_FRIENDS)
^clan_setup_rows = 100
