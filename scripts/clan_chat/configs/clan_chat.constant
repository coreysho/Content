// Clan chat ranks - the engine's numbers (Engine-TS src/engine/clan/ClanChat.ts), which are 2008's.
// Who may enter, talk and kick is one of these three; 1-6 (Recruit to General) are not used yet.
^clan_rank_anyone = -1
^clan_rank_friends = 0
^clan_rank_owner = 7

// clan_rank / clan_setrank's first argument
^clan_setting_enter = 0
^clan_setting_talk = 1
^clan_setting_kick = 2
