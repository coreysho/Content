// CLAN CHAT, the content side. Almost all of it is the engine's (src/engine/clan/ClanChat.ts) and the
// client's: joining, leaving, kicking, talking with "/" and the tab's list never pass through a script.
// What is here is Clan Setup - your own channel's name, who may enter, talk and kick in it, and the
// rank you give each of your friends - which the engine keeps and these read and write with clan_name,
// clan_rank, clan_setname, clan_setrank, clan_friend_count, clan_friend, clan_friend_rank and
// clan_setfriendrank.
//
// Every option in the window is its own click box (474 picked them from a right-click menu), so each
// has its own trigger; those are generated into clan_setup_buttons.rs2 with the interface, by
// LostCityServer tools/models/genclan474.py, and call the procs below.

[if_button,clanchat:setup]
if_openmain(clan_setup);
~clan_setup_refresh;

[proc,clan_setup_prefix]
p_dialogprompt("Enter chat name:");
p_namedialog;
if (string_length(last_string) = 0) {
    return;
}
clan_setname(last_string);
~clan_setup_refresh;

[proc,clan_setup_disable]
clan_setname("");
~clan_setup_refresh;

[proc,clan_setup_setting](int $setting, int $rank)
clan_setrank($setting, $rank);
~clan_setup_refresh;

[proc,clan_setup_friendrank](int $index, int $rank)
clan_setfriendrank($index, $rank);
~clan_setup_refresh;

[proc,clan_setup_refresh]
def_string $name = clan_name;
if (string_length($name) = 0) {
    if_settext(clan_setup:name_value, "Chat disabled");
} else {
    if_settext(clan_setup:name_value, $name);
}
if_settext(clan_setup:enter_value, ~clan_rank_text(clan_rank(^clan_setting_enter)));
if_settext(clan_setup:talk_value, ~clan_rank_text(clan_rank(^clan_setting_talk)));
if_settext(clan_setup:kick_value, ~clan_rank_text(clan_rank(^clan_setting_kick)));

// the friends, by name, as many rows as there are (the window has room for ^clan_setup_rows)
def_int $count = clan_friend_count;
if ($count > ^clan_setup_rows) {
    $count = ^clan_setup_rows;
}
def_int $i = 0;
while ($i < ^clan_setup_rows) {
    if ($i < $count) {
        if_settext(enum(int, component, clan_setup_friend_name, $i), clan_friend($i));
        if_settext(enum(int, component, clan_setup_friend_rank, $i), ~clan_friend_rank_text(clan_friend_rank($i)));
        if_sethide(enum(int, component, clan_setup_friend_row, $i), false);
    } else {
        if_sethide(enum(int, component, clan_setup_friend_row, $i), true);
    }
    $i = calc($i + 1);
}

// who may enter, talk or kick, in 474's words
[proc,clan_rank_text](int $rank)(string)
if ($rank = ^clan_rank_anyone) {
    return("Anyone");
}
if ($rank = ^clan_rank_friends) {
    return("Any friends");
}
if ($rank = ^clan_rank_owner) {
    return("Only me");
}
return(append(~clan_friend_rank_text($rank), "+"));

// what a friend is in the clan
[proc,clan_friend_rank_text](int $rank)(string)
switch_int ($rank) {
    case 1 : return("Recruit");
    case 2 : return("Corporal");
    case 3 : return("Sergeant");
    case 4 : return("Lieutenant");
    case 5 : return("Captain");
    case 6 : return("General");
    case default : return("Not in clan");
}
