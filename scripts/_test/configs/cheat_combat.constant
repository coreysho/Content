// Tunables for the combat/drop test cheats.
//
// Every comment must start at column 0. An indented continuation line is rejected by the .constant
// parser with "Bad constant declaration on line:" - it does not skip leading whitespace before
// looking for the // marker. No shipped .constant file in the repo indents a comment.

// enough that npc_findhero always names the tester as the killer
^debug_heropoints = 30000

// a hard cap; 1000 kills is ~35 minutes of queue cycles at the delay below
^debug_droptest_max = 1000

// ticks between kills - 1 is not enough for the npc's own queue3 to run
^debug_droptest_delay = 2

// ticks the spawned npc lives if something goes wrong and it is never killed, so a failed test
// cleans itself up rather than leaving a monster standing on you
^debug_droptest_lifetime = 50
