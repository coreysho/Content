// Tunables for the combat/drop test cheats.
^debug_heropoints = 30000       // enough that npc_findhero always names the tester as the killer
^debug_droptest_max = 1000      // a hard cap; 1000 kills is ~10 minutes of queue cycles
^debug_droptest_delay = 2       // ticks between kills - 1 is not enough for the npc's own queue3
^debug_droptest_lifetime = 50   // ticks the spawned npc lives if something goes wrong and it is
                                // never killed, so a failed test cleans itself up
