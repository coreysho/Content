[debugproc,dt](int $stage)
if (p_finduid(uid) = true) {
    %deserttreasuremain = $stage;
    ~debug_quest_set(questlist:deserttreasure, $stage, ^deserttreasure_complete, "Desert Treasure");
}

// ---------------------------------------------------------------------------------------------
// Shared helpers
// ---------------------------------------------------------------------------------------------

// The varp assignment cannot live in here - RS2 has no way to write a varp named by a variable -
// so each debugproc sets its own and this handles the journal and the message.
[proc,debug_quest_set](component $journal, int $stage, int $complete, string $name)
~send_quest_progress($journal, $stage, $complete);
mes("<$name> set to stage <tostring($stage)>.");

// Adds one of an obj only if it is not already carried, so repeated calls do not stack duplicates.
[proc,debug_give](namedobj $obj)
if (inv_total(inv, $obj) > 0) {
    return;
}
if (inv_freespace(inv) < 1) {
    mes("No inventory space for <oc_name($obj)>.");
    return;
}
inv_add(inv, $obj, 1);
