// Quest stage cheats. ::<quest> <stage> jumps a quest straight to a stage and hands over the
// items that stage assumes you are already carrying, so a quest can be tested from the middle
// instead of played from the start every time.
//
// Written because a large amount of quest content had accumulated without ever being run:
// Fremennik Trials, Recruitment Drive, Regicide's second half, Roving Elves, Mourning's End
// Part 1 and all three Monkey Madness stages were all written and never executed. Playing each
// one from the beginning to reach the step under test is the bottleneck, not the fixing.
//
// POINTERS: a [debugproc,...] is handed NO pointers - not even an active player - so every one
// of these acquires with p_finduid(uid) and does its work INSIDE the success branch. The
// compiler's static analysis only follows the positive branch, so the early-return shape used
// by the older iku/ikd debugprocs is not relied on here.
//
// These are gated by the engine at staffModLevel >= 4 along with every other debugproc.

// ---------------------------------------------------------------------------------------------
// Monkey Madness (the PlagueCityRS 349 original). Stages are in
// quests/quest_mm/configs/quest_mm.constant:
//   1 started  2 shown the seal  3 arrived on the atoll  4 chapter 2 done (greegree)
//   5 chapter 3 done (sigil)  6 demon defeated  7 reported  8 rewarded  9 complete  10 trained
// The per-character counters are set as the migration sets them (port349_migrate_mm.rs2).
// ---------------------------------------------------------------------------------------------
[debugproc,mm](int $stage)
if (p_finduid(uid) = true) {
    ~debug_quest_mm($stage);
}

[proc,debug_quest_mm](int $stage)
%mm_main = $stage;
~send_quest_progress(questlist:mm, $stage, ^mm_complete);
if ($stage >= ^mm_started) {
    ~debug_give(mm_gnome_royal_seal);
    %mm_narnode = ^narnode_given_seal;
}
if ($stage >= ^mm_arrived_atoll) {
    ~mm_set_chapter1_done;
}
if ($stage >= ^mm_completed_ch2) {
    ~mm_set_amulet_made;
    ~mm_set_greegree_made;
    ~debug_give(mm_amulet_of_monkey_speak);
    ~debug_give(mm_monkey_greegree_for_normal_monkey);
}
if ($stage >= ^mm_completed_ch3) {
    %mm_garkor = ^garkor_joined_10th_squad;
    %mm_awowogei = ^awowogei_complete_mission;
    %mm_kruk = ^kruk_spoken;
    %mm_elder_guard = ^elder_guard_spoken;
    ~debug_give(mm_sigil);
}
mes("Monkey Madness set to stage <tostring($stage)>.");

// ::mmtp <n>
//   1 hangar   2 Crash Island   3 Ape Atoll shore   4 throne room   5 final battle   6 Grand Tree
[debugproc,mmtp](int $where)
if (p_finduid(uid) = true) {
    ~debug_quest_mm_tp($where);
}

[proc,debug_quest_mm_tp](int $where)
switch_int ($where) {
    case 1 : p_teleport(0_41_70_25_36);
    case 2 : p_teleport(0_45_42_13_37);
    case 3 : p_teleport(0_43_42_49_19);
    case 4 : p_teleport(0_43_43_50_10);
    case 5 : p_teleport(1_42_143_14_21);
    case 6 : p_teleport(1_38_54_51_30);
    case default : mes("::mmtp 1 hangar, 2 crash island, 3 ape atoll, 4 throne, 5 final battle, 6 grand tree");
}

// ---------------------------------------------------------------------------------------------
// The rest of the untested set. Stage only - each quest's item chain would need its own audit,
// and the stage is what unblocks walking to the next npc.
// ---------------------------------------------------------------------------------------------
[debugproc,viking](int $stage)
if (p_finduid(uid) = true) {
    %viking = $stage;
    ~debug_quest_set(questlist:viking, $stage, ^viking_complete, "Fremennik Trials");
}

[debugproc,rd](int $stage)
if (p_finduid(uid) = true) {
    %recruitmentdrive = $stage;
    ~debug_quest_set(questlist:rd, $stage, ^recruitmentdrive_complete, "Recruitment Drive");
}

[debugproc,regicide](int $stage)
if (p_finduid(uid) = true) {
    %regicide_quest = $stage;
    ~debug_quest_set(questlist:regicide, $stage, ^regicide_complete, "Regicide");
}

[debugproc,roving](int $stage)
if (p_finduid(uid) = true) {
    %roving_elves_quest = $stage;
    ~debug_quest_set(questlist:roving_elves, $stage, ^roving_elves_complete, "Roving Elves");
