[owned_shop]
type=inv
default=null

[shop_sell_multiplier]
type=int
default=100

[shop_buy_multiplier]
type=int
default=60

[shop_delta]
type=int
default=10

[shop_title]
type=string
default=Shop.

// What this shopkeeper trades in. Defaults to coins, so the 29 shopkeepers that had no idea this
// existed keep working untouched; the three TzHaar traders set it to tzhaar_token.
[shop_currency]
type=namedobj
default=coins
