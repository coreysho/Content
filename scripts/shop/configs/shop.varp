[shop]
type=inv
scope=temp

[shop_buy]
type=int
scope=temp

[shop_sell]
type=int
scope=temp

[shop_haggle]
type=int
scope=temp

// What the shop that is currently open trades in. Set by both openshop procs, so nothing below
// them has to know whose shop it is - and the TzHaar shops trade in Tokkul, which is the reason
// this exists at all. Six places in shop.rs2 said "coins" before.
[shop_currency]
type=namedobj
scope=temp
