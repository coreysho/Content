// Thieving skill guide, shown on the original RS2 skill guide interface
// (see content/scripts/interfaces/skill_guide.rs2 for the generic driver).
// Icons are each row's own loot where it has one, else a lockpick stand-in.
[proc,open_thieving_guide]
~skillguide_begin(^guide_thieving, "Thieving");
~skillguide_members;
def_int $lvl = stat(thieving);
~skillguide_row(1, $lvl, 1, coins, "Man / Woman");
~skillguide_row(2, $lvl, 1, lockpick, "Locked door");
~skillguide_row(3, $lvl, 5, cake, "Baker's stall");
~skillguide_row(4, $lvl, 5, cup_of_tea, "Tea stall");
~skillguide_row(5, $lvl, 10, coins, "Farmer");
~skillguide_row(6, $lvl, 13, coins, "Chest (10 coins)");
~skillguide_row(7, $lvl, 13, lockpick, "Locked door");
~skillguide_row(8, $lvl, 16, lockpick, "Locked door");
~skillguide_row(9, $lvl, 20, silk, "Silk stall");
~skillguide_row(10, $lvl, 23, lockpick, "Locked door (lockpick)");
~skillguide_row(11, $lvl, 25, coins, "Warrior");
~skillguide_row(12, $lvl, 28, naturerune, "Chest (nature rune)");
~skillguide_row(13, $lvl, 31, lockpick, "Ardougne sewer gate");
~skillguide_row(14, $lvl, 32, jug_wine, "Rogue");
~skillguide_row(15, $lvl, 35, grey_wolf_fur, "Fur stall");
~skillguide_row(16, $lvl, 39, lockpick, "Locked door (lockpick)");
~skillguide_row(17, $lvl, 40, coins, "Guard");
~skillguide_row(18, $lvl, 43, coins, "Chest (50 coins)");
~skillguide_row(19, $lvl, 46, lockpick, "Locked door");
~skillguide_row(20, $lvl, 47, steel_arrowheads, "Chest (steel arrowtips)");
~skillguide_row(21, $lvl, 50, silver_ore, "Silver stall");
~skillguide_row(22, $lvl, 55, coins, "Knight of Ardougne");
~skillguide_row(23, $lvl, 59, bloodrune, "Chest (blood runes)");
~skillguide_row(24, $lvl, 61, lockpick, "Locked door");
~skillguide_row(25, $lvl, 65, spicespot, "Spice stall");
~skillguide_row(26, $lvl, 65, bread, "Watchman");
~skillguide_row(27, $lvl, 70, chaosrune, "Paladin");
~skillguide_row(28, $lvl, 72, adamantite_ore, "Chest (Ardougne castle)");
~skillguide_row(29, $lvl, 75, uncut_sapphire, "Gem stall");
~skillguide_row(30, $lvl, 75, king_worm, "Gnome");
~skillguide_row(31, $lvl, 80, diamond, "Hero");
~skillguide_row(32, $lvl, 82, lockpick, "Locked door (lockpick)");
~skillguide_show;
