// ADDED 2026-09-08 (dead-op audit): 27 npcs carried op3=Pickpocket that nothing served, so the
// option showed and did nothing. Declared as type triggers rather than by giving them
// category=citizen/guard, because those categories also carry [ai_queue3,_citizen]/[ai_queue3,_guard]
// drop tables and [opnpc1,_citizen] dialogue - this enables pickpocketing and nothing else.
// Each one was added to the npc LIST of the matching existing row in pickpocket.dbrow, so they use
// the canonical Man/Woman/Farmer/Guard/Paladin levels, XP and loot rather than invented numbers.
//
// Deliberately NOT included, because they want their own rates and loot rather than citizen-tier:
// the five Lletya town elves (level 85), the Menaphite Thug and the nine Pollnivneach villagers
// (blackjack targets, a system this server does not have), the Feud and Desert Treasure bandits,
// both H.A.M. civilians, Sandy, Dr Fenkenstrain, Sigmund and the Saradominist Zealot.
// Man
[opnpc3,death_man_indoors1] @attempt_pick_pocket(npc_type);
[opnpc3,man4_for_musa_point] @attempt_pick_pocket(npc_type);
[opnpc3,falador_doric_area_man1] @attempt_pick_pocket(npc_type);
[opnpc3,falador_doric_area_man2] @attempt_pick_pocket(npc_type);
[opnpc3,falador_doric_area_man3] @attempt_pick_pocket(npc_type);
[opnpc3,falador_doric_area_man4] @attempt_pick_pocket(npc_type);
[opnpc3,rimmington_hengel] @attempt_pick_pocket(npc_type);
[opnpc3,viking_man] @attempt_pick_pocket(npc_type);
[opnpc3,viking_man2] @attempt_pick_pocket(npc_type);
[opnpc3,viking_man3] @attempt_pick_pocket(npc_type);
[opnpc3,viking_man4] @attempt_pick_pocket(npc_type);
[opnpc3,viking_man5] @attempt_pick_pocket(npc_type);

// Woman
[opnpc3,rimmington_anja] @attempt_pick_pocket(npc_type);
[opnpc3,viking_woman] @attempt_pick_pocket(npc_type);
[opnpc3,viking_woman2] @attempt_pick_pocket(npc_type);
[opnpc3,viking_woman3] @attempt_pick_pocket(npc_type);
[opnpc3,viking_woman4] @attempt_pick_pocket(npc_type);
[opnpc3,viking_woman_indoors] @attempt_pick_pocket(npc_type);

// Farmer
[opnpc3,farmer2] @attempt_pick_pocket(npc_type);
