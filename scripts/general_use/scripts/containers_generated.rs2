// ---------------------------------------------------------------- filling baskets and sacks
// A basket takes five of one fruit, a sack ten of one vegetable. Filling tops it up from
// the inventory a piece at a time and stops when the container is full or the fruit runs out.

[proc,container_fill](namedobj $contents, namedobj $next)(boolean)
if (inv_total(inv, $contents) < 1) {
    mes("You have no <lowercase(oc_name($contents))> to put in it.");
    return(false);
}
inv_del(inv, $contents, 1);
inv_delslot(inv, last_slot);
inv_setslot(inv, last_slot, $next, 1);
return(true);

[proc,container_fill_loop](namedobj $contents)
mes("You fill the container.");

[opheld1,basket_apple_1]
    ~container_fill(cooking_apple, basket_apple_2);

[opheld1,basket_apple_2]
    ~container_fill(cooking_apple, basket_apple_3);

[opheld1,basket_apple_3]
    ~container_fill(cooking_apple, basket_apple_4);

[opheld1,basket_apple_4]
    ~container_fill(cooking_apple, basket_apple_5);

[opheld1,basket_apple_5]
    mes("The basket is already full.");

