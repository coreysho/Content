[opheld1,regicide_iorwerth_message]
    ~mesbox("King Lathas | Your man did well. We are a step closer to welcoming the Dark Lord into this realm. You will yet live to see Camelot crushed under foot. | Lord Iorwerth");

[opheld1,regicide_alchemy]
    ~mesbox("The Big Book of Bangs, by Mel Achy | I have seen many explosive creations in my travels, but none so fearsome as the fire oil of the far east: it clings to whatever it touches as it burns.");

[opheld1,serum_book]
    ~mesbox("The diary of Herbi Flax, herbalist of Mort'ton.");

[opheld1,horror_diary1]
    ~mesbox("Bennath the 3rd | I have taken over my uncle's post at the lighthouse. The barbarian camps nearby give me some unease.");

[opheld1,horror_diary2]
    ~mesbox("I do not know why it is me that has been chosen by them. But I will not fail them.");

[opheld1,horror_diary3]
