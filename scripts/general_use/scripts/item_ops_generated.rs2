// GENERATED - the long tail of item options that had no handler at all:
// Look-at, Check, Play, Open, Rub, Activate, Dance, Feed and the rest.
// See claude/opheld-audit.md. Teleports and quest logic are described rather than
// simulated - those need the owning quest, and are listed as follow-ups in the doc.

[opheld1,lit_black_candle]
    inv_delslot(inv, last_slot);
    inv_setslot(inv, last_slot, unlit_black_candle, 1);
    mes("You extinguish the candle.");

[opheld1,lit_candle]
    inv_delslot(inv, last_slot);
    inv_setslot(inv, last_slot, unlit_candle, 1);
    mes("You extinguish the candle.");

[opheld1,torch_lit]
    inv_delslot(inv, last_slot);
    inv_setslot(inv, last_slot, torch_lit, 1);
    mes("You extinguish the torch.");

