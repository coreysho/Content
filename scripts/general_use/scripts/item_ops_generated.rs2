// FIXED 2026-09-09 (Recipe for Disaster pass 10): hundred_rewardlamp is the quest's own reward and
// carries iop1=Rub, but the generated stub said "Nothing interesting happens." The genie lamp's
// interface in general/scripts/xplamp/xplamp.rs2 does exactly the right thing and only needed to
// stop assuming which lamp it was consuming.
[opheld1,hundred_rewardlamp]
%xplamp = ^xplamp_none;
if_openmain(xplamp);
// Recipe for Disaster, Freeing Skrach Uglogwee. These two were generated dead flavour - the toads
// are the bait for the jubbly hunt and had nowhere to be placed. @hundred_place_toad is in
// quest_100/scripts/hundred_ogre.rs2 and keeps this message for everywhere that is not the island.
[opheld1,100_jubbly_balloon_toad_brown] @hundred_place_toad(100_jubbly_balloon_toad_brown);
[opheld4,100_jubbly_balloon_toad_brown] ~mesbox("You release the toads. They hop away gratefully.");
[opheld1,100_jubbly_balloon_toad_white] @hundred_place_toad(100_jubbly_balloon_toad_white);
[opheld4,100_jubbly_balloon_toad_white] ~mesbox("You release the toads. They hop away gratefully.");
