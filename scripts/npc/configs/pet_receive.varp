// The pet a death table has just given the killer, carried to [queue,pet_receive] (npc/scripts/follower.rs2):
// a queue can only be handed ints, and the table runs as the npc, which cannot give the pet itself.
// protect=no because it is written from that npc context. Temp: it is read the tick after.
[pet_pending]
type=namedobj
protect=no
