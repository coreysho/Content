model3=npc_2882i2
size=1
resizeh=44
resizev=45
walkanim=dagannoth_meganoth_walk
readyanim=dagannoth_meganoth_ready
vislevel=hide
timer=20
op1=Pick-up
op3=Talk-to
category=bosspet
param=pet_item_id,bosspet_dagannoth_prime_item

[bosspet_dagannoth_supreme]
