resizev=45
walkanim=osrs_seq_6236
readyanim=osrs_seq_6236
vislevel=hide
timer=20
op1=Pick-up
op3=Talk-to
category=bosspet
param=pet_item_id,bosspet_kalphite_queen_item

// The one pet that never was a shrunk boss: the 377 cache ships its own baby mole, and this used
// it. It is OSRS's Baby Mole now (model 42012, six recolours baked in) for the same reason as the
// rest - one look, one source - and it is also the one pet with no resize, because 42012 is
// authored at pet size rather than boss size.
[bosspet_giant_mole]
name=Baby mole
desc=I will call him, Mini Mole.
model1=npc_bosspet_giant_mole_1
size=1
walkanim=osrs_seq_3313
readyanim=osrs_seq_3309
vislevel=hide
timer=20
op1=Pick-up
op3=Talk-to
category=bosspet
param=pet_item_id,bosspet_giant_mole_item

