// Boss pet items. Structurally these are copies of [growncatobject] - the cache's own pet-cat item -
// with category and follower_id swapped: category drives the [opheld5,_bosspet] drop trigger, and
// param=follower_id names the npc that gets spawned.
//
// PLACEHOLDER ICONS, flagged. This 377 cache contains no figurine or miniature-creature obj models -
// searching model.pack for dragon, kalphite, mole, dagannoth, statue and figurine turns up only
// equipment. Every one of these therefore uses obj_bird_egg_red, the one small creature-adjacent
// model that carries recolour fields, recoloured per boss. The mechanic is complete and correct; the
// inventory icon is a stand-in and is a one-line swap per item if real models ever exist.
//
// tradeable=no matches the cats and keeps pets off the trade screen, which matters because these are
// rare drops with no other sink.

[bosspet_kbd_item]
name=Prince black dragon
desc=The biggest, meanest dragon around. Eventually.
model=obj_bird_egg_red
recol1s=30224
recol1d=1
2dzoom=650
2dyan=16
2dxan=76
members=yes
weight=1500g
category=bosspet
param=follower_id,bosspet_kbd
tradeable=no

