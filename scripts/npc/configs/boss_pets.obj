// Boss pet items. Structurally these are copies of [growncatobject] - the cache's own pet-cat item -
// with category and follower_id swapped: category drives the [opheld5,_bosspet] drop trigger, and
// param=follower_id names the npc that gets spawned.
//
// The icons are OSRS's own, imported by tools/models/importosrs.py with each item's own 2d camera;
// the recoloured bird eggs that stood in for them until the art round are gone. Four of the six
// draw the npc's mesh, which is what OSRS does as well - a Dagannoth King at zoom 4560 is simply
// one seen from far enough away to fit an inventory square - and only the Prince black dragon and
// the Baby mole have a purpose-built icon model. The Prince carries no camera lines at all because
// its model is authored for the default one, which 377 and OSRS share (zoom 2000, no rotation).
//
// The two Dagannoth recolours are the item config's own, not baked into the mesh: all three share
// model 9941 and OSRS repaints two of them, so the pairs are carried across and converted from
// HSL16 to the RGB15 a .obj is written in.
//
// tradeable=no matches the cats and keeps pets off the trade screen, which matters because these are
// rare drops with no other sink.

[bosspet_kbd_item]
name=Prince black dragon
desc=The biggest, meanest dragon around. Eventually.
model=obj_bosspet_kbd_item
members=yes
weight=1500g
category=bosspet
param=follower_id,bosspet_kbd
tradeable=no

[bosspet_kalphite_queen_item]
name=Kalphite princess
desc=I don't think insect repellent will work on her either.
model=obj_bosspet_kalphite_queen_item
2dzoom=8016
2dxan=342
2dyan=1778
