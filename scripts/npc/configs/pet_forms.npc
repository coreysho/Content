// ---------------------------------------------------------------------------------------------
// LOOKS THAT ARE NOT A RIGHT-CLICK. The rock golem and the tangleroot have no Metamorphosis op in
// the cache and none here: in Old School you USE something on them. An ore on the golem (a plain
// rock puts it back), a seed on the tangleroot (which eats the seed, and an acorn puts it back).
// They are still rings - that is how npc/scripts/pet_metamorph.rs2 remembers which look a pet is
// wearing - but nothing cycles them, so they carry no op4. followerspec.json says which rings have
// the right-click and the battery holds it to that.
//
// The ore each golem look belongs to was MEASURED: nine of the eleven share an exact recolour
// destination with the ore item's own recolour, and clay and iron are the only tan and dark-brown
// looks left once those nine are taken. The renders agree.
//
// Eight of Old School's nineteen golem ores and four of the tangleroot's five seeds are not in this
// build at all - granite, amethyst, lovakite, daeyalt and the rest; crystal acorn, dragonfruit,
// redwood and white lily seeds. Their looks are in the cache and are not imported: an npc nothing
// can reach is dead weight. The ids are in followerspec.json for whenever the items exist.

[skillpet_rock_golem_clay]
// OSRS npc 7448
name=Rock golem
desc=A tiny golem, hewn from clay.
model1=npc_skillpet_rock_golem_clay_1
head1=npc_skillpet_rock_golem_clay_head1
readyanim=osrs_seq_7180
walkanim=osrs_seq_7181
size=1
vislevel=hide
timer=20
op1=Pick-up
op3=Talk-to
category=bosspet
param=pet_item_id,skillpet_rock_golem_item
