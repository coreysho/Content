// Probita, who runs the pet insurance bureau in East Ardougne - the small building next to Aemad's
// Adventuring Supplies, which is where she stands in Old School and where she stands here: the
// empty one-room building immediately east of the shop, entered from the north at 2618,3293. The
// spawn is one line in maps/m40_51.jm2 and the room was empty in the 377 map, furniture and all.
//
// ERA NOTE: she is a 2016 Old School npc, and she is here for the same reason the boss pets are -
// they were asked for, and a pet you can lose for good with no way to get it back is worse than
// the anachronism. See npc/scripts/follower.rs2 for what death does and npc/scripts/probita.rs2
// for the bureau itself.
//
// Her art is OSRS npc 5906's own, seven body models and two chatheads, imported by
// tools/models/importosrsnpc.py. The 377 human animations drive it - the same pairing the estate
// agent and the sawmill operator already use, and it was rendered merged before shipping.
// resizeh/resizev are the cache's own: she is slightly shorter and wider than a 377 citizen
// because OSRS says she is.
//
// op1=Talk-to and op3=Check are HER OWN ops out of the cache, in her own order, and Check is what
// opens the window - exactly as in Old School, where Check is how you see what she is holding.

[probita]
// OSRS npc 5906
name=Probita
desc=She looks after lost pets.
model1=npc_probita_1
model2=npc_probita_2
model3=npc_probita_3
model4=npc_probita_4
model5=npc_probita_5
model6=npc_probita_6
model7=npc_probita_7
head1=npc_probita_head1
head2=npc_probita_head2
readyanim=human_ready
walkanim=human_walk_f
resizeh=116
resizev=108
vislevel=hide
wanderrange=0
op1=Talk-to
op3=Check
