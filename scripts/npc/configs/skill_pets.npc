// The eight skilling pets. Every one has a purpose-built OSRS mesh - not one of them is a shrunk
// anything - imported by tools/models/importosrsnpc.py with its recolours baked in.
//
// category=bosspet is deliberate and is not a claim about where the pet came from: the category is
// the follower MECHANISM - the four triggers in scripts/npc/scripts/boss_pets.rs2 that put a pet
// down, pick it back up, talk to it and teleport it to its owner - and splitting it would mean
// four more triggers saying the same thing. A skilling pet is a follower like any other.
//
// Two of the twelve ids are not the obvious ones: the Rock golem's plain npc is 7439 and the Baby
// chinchompa's is 6719. Both names also belong to long rows of recoloured variants (2182 paints
// the golem pink; 6721 is the gold chinchompa), and the plain ones were found by rendering the
// candidates. See tools/bossartspec.json, which records the id each mesh came from.

[skillpet_beaver]
name=Beaver
desc=A hardworking little fellow.
model1=npc_skillpet_beaver_1
head1=npc_skillpet_beaver_head1
size=1
readyanim=osrs_seq_7177
walkanim=osrs_seq_7178
vislevel=hide
timer=20
op1=Pick-up
op3=Talk-to
category=bosspet
param=pet_item_id,skillpet_beaver_item

[skillpet_heron]
name=Heron
desc=A fishing companion.
model1=npc_skillpet_heron_1
