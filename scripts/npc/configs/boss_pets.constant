// Boss pets. See configs/boss_pets.npc for the era note, the models and the placeholder icons.
//
// 1 in 3000 per kill, the Old School rate for the KBD / Kalphite Queen / Giant Mole / Dagannoth King
// family. Every one of these bosses already had a drop table, so the roll is one line in each.
^bosspet_droprate = 3000

// The god wars generals drop theirs at 1 in 5,000, which is OSRS's rate for that family - a
// different number from the 3,000 above, which is why ~bosspet_roll takes the rate rather than
// reading one.
^bosspet_gwd_droprate = 5000
