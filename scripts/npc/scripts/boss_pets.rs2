// Boss pets - the follower behaviour. See configs/boss_pets.npc for the era note and the models.
//
// This is deliberately a thin parallel of the cat system in quest_fluffs/scripts/pet.rs2 rather than
// a reuse of it: cats carry growth, hunger, attention and vermin-hunting on the same category, none
// of which a boss pet should inherit. What IS shared is the engine-level follower slot the cats
// established - %follower_uid, %follower_obj and %npc_attacking_uid as the ownership marker - so a
// player still has exactly one follower and cats and boss pets cannot both be out at once.

// Dropping the item puts the pet down. opheld5 is Drop, served globally by player/scripts/drop.rs2;
// a category trigger beats the global, which is how the cats do it too.
[opheld5,_bosspet]
if (npc_finduid(%follower_uid) = true) {
    mes("You already have a follower.");
    return;
}
def_int $slot = last_slot;
// ~pet_form, not the item's follower_id: a pet put down comes back in the form you last chose
// for it. npc/scripts/pet_metamorph.rs2.
def_npc $type = ~pet_form(last_item);
inv_delslot(inv, $slot);
sound_synth(put_down, 1, 0);
// The slot itself is claimed by ~follower_spawn in npc/scripts/follower.rs2 - the same four lines
// the cats and the login respawn use, in one place.
~follower_spawn($type);

// Picking it back up. Mirrors [opnpc1,_petcat] including the ownership check, so you cannot pocket
// somebody else's pet.
[opnpc1,_bosspet]
if (%npc_attacking_uid ! uid | %follower_uid ! npc_uid) {
    mes("That isn't yours to take.");
    return;
}
if (inv_freespace(inv) = 0) {
    mes("You don't have enough inventory space to pick that up.");
    return;
}
p_delay(0);
%follower_obj = null;
%follower_uid = null;
inv_add(inv, npc_param(pet_item_id), 1);
sound_synth(pick, 1, 0);
npc_del;

// Keeping up - ~follower_keepup in npc/scripts/follower.rs2, shared with the cats. This was a copy
// of the cats' one; the two have the same job and now have one body.
[ai_timer,_bosspet] ~follower_keepup;

// --- The drop ---
// Called from each boss's death table with ITS OWN rate: 1 in 3,000 for the KBD / Kalphite Queen /
// Giant Mole / Dagannoth King family, 1 in 5,000 for the god wars generals. The rate is an argument
// rather than a constant read in here, so a family that drops at a different rate has to say so at
// the call site and cannot silently inherit another family's number.
//
// The pet is never dropped on the floor: it follows the killer, or goes in their pack, or to
// Probita's - ~pet_receive in npc/scripts/follower.rs2, Old School's rules, which also turn away a
// pet the player owns already (~pet_owned: pack, bank, worn, following, or at Probita's). This runs
// inside the boss's [ai_queue3] death script, as the npc, so it is queued on the killer - the player
// npc_findhero made active - rather than called.
[proc,bosspet_roll](namedobj $pet, int $rate)
if (random($rate) ! 0) {
    return;
}
~pet_receive_later($pet, 0);
