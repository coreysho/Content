// Herblore skill guide, shown on the original RS2 skill guide interface
// (see content/scripts/interfaces/skill_guide.rs2 for the generic driver).
// Potions only - herb identification would push this past the 40-row cap.
[proc,open_herblore_guide]
~skillguide_begin(^guide_herblore, "Herblore");
~skillguide_members;
def_int $lvl = stat(herblore);
~skillguide_row(1, $lvl, 1, guamvial, "Guam potion (unf)");
~skillguide_row(2, $lvl, 1, 3dose1attack, "Attack potion");
~skillguide_row(3, $lvl, 5, marrentillvial, "Marrentill potion (unf)");
~skillguide_row(4, $lvl, 5, 3doseantipoison, "Antipoison");
~skillguide_row(5, $lvl, 12, tarrominvial, "Tarromin potion (unf)");
~skillguide_row(6, $lvl, 12, 3dose1strength, "Strength potion");
~skillguide_row(7, $lvl, 22, harralandervial, "Harralander potion (unf)");
~skillguide_row(8, $lvl, 22, 3dosestatrestore, "Restore potion");
~skillguide_row(9, $lvl, 25, blamish_oil, "Blamish oil");
~skillguide_row(10, $lvl, 26, 3dose1energy, "Energy potion");
~skillguide_row(11, $lvl, 30, ranarrvial, "Ranarr potion (unf)");
~skillguide_row(12, $lvl, 30, 3dose1defense, "Defence potion");
~skillguide_row(13, $lvl, 34, toadflaxvial, "Toadflax potion (unf)");
~skillguide_row(14, $lvl, 34, 3dose1agility, "Agility potion");
~skillguide_row(15, $lvl, 38, 3doseprayerrestore, "Prayer potion");
~skillguide_row(16, $lvl, 45, iritvial, "Irit potion (unf)");
~skillguide_row(17, $lvl, 45, 3dose2attack, "Super attack");
~skillguide_row(18, $lvl, 48, 3dose2antipoison, "Superantipoison");
~skillguide_row(19, $lvl, 50, avantoevial, "Avantoe potion (unf)");
~skillguide_row(20, $lvl, 50, 3dosefisherspotion, "Fishing potion");
~skillguide_row(21, $lvl, 52, 3dose2energy, "Super energy");
~skillguide_row(22, $lvl, 55, kwuarmvial, "Kwuarm potion (unf)");
~skillguide_row(23, $lvl, 55, 3dose2strength, "Super strength");
~skillguide_row(24, $lvl, 60, weapon_poison, "Weapon poison");
~skillguide_row(25, $lvl, 63, snapdragonvial, "Snapdragon potion (unf)");
~skillguide_row(26, $lvl, 63, 3dose2restore, "Super restore");
~skillguide_row(27, $lvl, 66, cadantinevial, "Cadantine potion (unf)");
~skillguide_row(28, $lvl, 66, 3dose2defense, "Super defence");
~skillguide_row(29, $lvl, 69, lantadymevial, "Lantadyme potion (unf)");
~skillguide_row(30, $lvl, 69, 3dose1antidragon, "Antifire potion");
~skillguide_row(31, $lvl, 72, dwarfweedvial, "Dwarf weed potion (unf)");
~skillguide_row(32, $lvl, 72, 3doserangerspotion, "Ranging potion");
~skillguide_row(33, $lvl, 76, 3dose1magic, "Magic potion");
~skillguide_row(34, $lvl, 78, torstolvial, "Torstol potion (unf)");
~skillguide_row(35, $lvl, 78, 3dosepotionofzamorak, "Zamorak brew");
~skillguide_show;
