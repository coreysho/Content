// 474's staff tab (474 interface 90), ported by LostCityServer tools/models/portcombat474.py -
// regenerate it rather than editing by hand. 474's per-spell icon layers are left out: the
// chosen spell is named in auto_spell and picked on staff_spells, as before.
type=overlay

[name]
type=text
x=4
y=4
width=180
height=17
center=yes
font=q8_full
shadowed=yes
text=%1
colour=0xFF981F

