[proc,npc_death]
// npc_walk(npc_coord) is unnecessary due to npc_setmode(none).
// But they do it in this screenshot so might be good to do it here just incase: https://i.imgur.com/AfQ1MfF.png
npc_walk(npc_coord);
npc_setmode(none);
npc_arrivedelay; // arrivedelay for up to two ticks (current osrs too) https://youtu.be/Vsnkdq8OOMg?t=209
~check_progress_task(npc_param(slayer_category)); // this is checked after arrivedelay
// The Barrows tunnels pay reward potential for everything that dies in them, and this is the one
// place every death passes through: the two Barrows skeletons already carry an [ai_queue3] for
// their drop table and a second trigger on the same npc is a hard build error, so there is no
// per-monster hook to use. ~barrows_potential returns immediately anywhere but down there.
~barrows_potential;
// AND THE BOSS KILL COUNTS, for the same reason and in the same place. Eight of the twelve bosses
// already carry an [ai_queue3] for their drop table and a second trigger on one npc is a hard
// build error, so there is no per-boss hook to use. ~boss_kill_record returns immediately for
// everything that is not one of the twelve, which is almost everything that dies.
~boss_kill_record;
if (finduid(%npc_aggressive_player) = true) {
    if (npc_param(death_sound) ! null) {
        ~sound_within_distance(npc_param(death_sound), 0, npc_coord, 12); // osrs
    }
    %lastcombat = null; // allows other npcs to hunt you immediately
}
npc_anim(npc_param(death_anim), 0);
npc_delay(1); // osrs has an extra tick of delay here. I think this delay can vary from npc to npc
npc_del;
