// Hitpoints guide. Nothing in this repo gates on a Hitpoints level, so instead of
// an empty list this shows what food heals, straight from consume_table:stat_heal
// (content/scripts/player/configs/consumption/consume_normal.dbrow).
// The left column is hitpoints restored, not a level requirement, so the headers
// are relabelled and every row is drawn unlocked.
[proc,open_hitpoints_guide]
~skillguide_begin(^guide_hitpoints, "Hitpoints");
~skillguide_headers("Heals", "Food");
def_int $lvl = 99;
~skillguide_row(1, $lvl, 1, cabbage, "Cabbage");
~skillguide_row(2, $lvl, 2, banana, "Banana");
~skillguide_row(3, $lvl, 2, cheese, "Cheese");
~skillguide_row(4, $lvl, 3, shrimp, "Shrimps");
~skillguide_row(5, $lvl, 3, cooked_meat, "Cooked meat");
~skillguide_row(6, $lvl, 3, cooked_chicken, "Cooked chicken");
~skillguide_row(7, $lvl, 3, anchovies, "Anchovies");
~skillguide_row(8, $lvl, 3, redberry_pie, "Redberry pie");
~skillguide_row(9, $lvl, 4, bread, "Bread");
~skillguide_row(10, $lvl, 4, cake, "Cake");
~skillguide_row(11, $lvl, 4, meat_pie, "Meat pie");
~skillguide_row(12, $lvl, 4, sardine, "Sardine");
~skillguide_row(13, $lvl, 5, herring, "Herring");
~skillguide_row(14, $lvl, 5, plain_pizza, "Plain pizza");
~skillguide_row(15, $lvl, 5, apple_pie, "Apple pie");
~skillguide_row(16, $lvl, 5, chocolate_cake, "Chocolate cake");
~skillguide_row(17, $lvl, 6, mackerel, "Mackerel");
~skillguide_row(18, $lvl, 6, giant_carp, "Giant carp");
~skillguide_row(19, $lvl, 7, trout, "Trout");
~skillguide_row(20, $lvl, 7, cod, "Cod");
~skillguide_row(21, $lvl, 7, meat_pizza, "Meat pizza");
~skillguide_row(22, $lvl, 8, pike, "Pike");
~skillguide_row(23, $lvl, 8, anchovie_pizza, "Anchovy pizza");
~skillguide_row(24, $lvl, 9, salmon, "Salmon");
~skillguide_row(25, $lvl, 9, stew, "Stew");
~skillguide_row(26, $lvl, 9, ugthanki_kebab_bad, "Ugthanki kebab");
~skillguide_row(27, $lvl, 10, tuna, "Tuna");
~skillguide_row(28, $lvl, 10, pineapple_pizza, "Pineapple pizza");
~skillguide_row(29, $lvl, 10, cooked_chompy, "Cooked chompy");
~skillguide_row(30, $lvl, 11, worm_batta, "Worm batta");
~skillguide_row(31, $lvl, 11, jug_wine, "Jug of wine");
~skillguide_row(32, $lvl, 12, lobster, "Lobster");
~skillguide_row(33, $lvl, 12, worm_hole, "Worm hole");
~skillguide_row(34, $lvl, 13, bass, "Bass");
~skillguide_row(35, $lvl, 14, swordfish, "Swordfish");
~skillguide_row(36, $lvl, 14, lava_eel, "Lava eel");
~skillguide_row(37, $lvl, 15, chocolate_bomb, "Chocolate bomb");
~skillguide_row(38, $lvl, 19, curry, "Curry");
~skillguide_row(39, $lvl, 20, shark, "Shark");
~skillguide_row(40, $lvl, 21, seaturtle, "Sea turtle");
~skillguide_show;
