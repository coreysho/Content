[proc,hitpoints_guide_potions]
// Saradomin brew heals a share of your maximum rather than a flat amount, so the number here is
// the percentage it restores. It also raises Defence and lowers the four attacking stats.
def_int $lvl = 99;
~skillguide_row(1, $lvl, 15, 4dosepotionofsaradomin, "Saradomin brew - 15% + 2");
~skillguide_row(2, $lvl, 15, 3dosepotionofsaradomin, "Saradomin brew(3)");
~skillguide_row(3, $lvl, 15, 2dosepotionofsaradomin, "Saradomin brew(2)");
~skillguide_row(4, $lvl, 15, 1dosepotionofsaradomin, "Saradomin brew(1)");
