// Hitpoints guide. Nothing in this repo gates on a Hitpoints level, so instead of an empty list
// this shows what restores hitpoints, and the left column is the amount healed rather than a
// level requirement - the headers are relabelled and every row is drawn unlocked.
//
// The values are read out of the consume_table dbrows (player/configs/consumption/), the same
// place the eating code reads them, so the guide and the food cannot drift apart. Four pages,
// because there are far more than 40 things that heal now: three of food by amount healed, and
// one for the potions, which restore through a stat boost rather than a flat heal.
[proc,open_hitpoints_guide]
%skillguide_page = 1;
~hitpoints_guide_render;

[proc,hitpoints_guide_render]
~skillguide_begin(^guide_hitpoints, "Hitpoints");
~skillguide_headers("Heals", "Restores hitpoints");
~skillguide_panels(4);
~skillguide_button(2, "Best food");
~skillguide_button(3, "Good food");
~skillguide_button(4, "Basic food");
~skillguide_button(5, "Potions");
switch_int (%skillguide_page) {
    case 3 : ~hitpoints_guide_good;
    case 4 : ~hitpoints_guide_basic;
    case 5 : ~hitpoints_guide_potions;
    case default : ~hitpoints_guide_best;
}
~skillguide_show;

[proc,hitpoints_guide_best]
