// begins combat
[label,player_melee_attack]
p_stopaction;
if (~npc_is_attackable() = false) {
    return;
}

if (%action_delay > map_clock) {
    p_opnpc(2); // it is guaranteed here that we are already within op distance
    return;
}

if (npc_stat(hitpoints) = 0) {
    p_stopaction;
    return; // this means the npc is not avail to fight i.e dead
}

// Desert Treasure - Fareed disarms anyone who swings at him without ice gloves. Returns true for
// every other npc, so this is one proc call on the melee path.
// ~dt_melee_attack_allowed is in quests/quest_deserttreasure/scripts/dt_combat.rs2.
if (~dt_melee_attack_allowed = false) {
    return;
}

// Black mask: 16.67% to accuracy and max hit against monsters on the player's current slayer
// task, melee only. ~black_mask_on_task is in skill_slayer/scripts/black_mask.rs2.
def_int $mask_num = 1;
def_int $mask_div = 1;
if (~black_mask_on_task = true) {
    $mask_num = 7;
    $mask_div = 6;
}

// check hit, give combat xp
// Verac's set: "a 25% chance of ignoring any armour, Defence, and protection prayers", all three
// of which live inside the hit roll - so ignoring them is ignoring the roll.
// ~barrows_verac_ignores is in areas/area_barrows/scripts/barrows_sets.rs2.
def_int $damage = 0;
if (~player_npc_hit_roll_boosted(%damagetype, $mask_num, $mask_div) = true
    | ~barrows_verac_ignores = true) {
    def_int $maxhit = %com_maxhit;
    if (npc_type = count_draynor & inv_total(inv, garlic) > 0) {
        $maxhit = add($maxhit, 1);
    }
    if (npc_param(demonbane_vulnerable) = true & inv_total(worn, silverlight) > 0) {
        $maxhit = scale(160, 100, %com_maxhit);
    }
    // After silverlight, which assigns from %com_maxhit and would otherwise discard this, and
    // before the blocks below that zero $maxhit outright.
    $maxhit = scale($mask_num, $mask_div, $maxhit);
    // Dharok's set: more damage the lower the player's own hitpoints, scaled by their maximum.
    $maxhit = ~barrows_dharok_maxhit($maxhit);
    if((npc_param(slayer_category) = ^slayer_kurask | npc_param(slayer_category) = ^slayer_turoth) & inv_total(worn, slayer_leafbladed_spear) = 0) {
        $maxhit = 0;
    }
    // Horror from the Deep - Dagannoth Mother (quest_horror) cycles through six elemental/combat-style
    // weaknesses every 18 seconds (see quests/quest_horror/scripts/quest_horror_combat.rs2). Melee only
    // damages her during her orange/melee-weakness phase (horror_dagganoth_melee); every other phase
    // blocks melee entirely, matching the wiki's "changes weakness" mechanic.
    if (npc_type = horror_dagganoth_air | npc_type = horror_dagganoth_water | npc_type = horror_dagganoth_earth | npc_type = horror_dagganoth_fire | npc_type = horror_dagganoth_ranged) {
        $maxhit = 0;
    }
    $damage = randominc(min($maxhit, npc_param(max_dealt)));
    def_int $damage_capped = min($damage, npc_stat(hitpoints));
    ~give_combat_experience(%damagestyle, $damage_capped, %npc_combat_xp_multiplier);
    npc_heropoints($damage_capped);
    // Guthan's heal, and Ahrim's Strength drain when the hit was a magic one. Karil's and Torag's
    // do nothing to a monster in Old School either - a monster has no Agility and no run energy.
    ~barrows_set_hit_npc($damage_capped, %damagetype);
}

def_obj $weapon = inv_getobj(worn, ^wearpos_rhand);
if ($weapon ! null) {
    def_int $poison_severity = oc_param($weapon, poison_severity);
    if ($damage > 0 & $poison_severity > 0 & random(4) = 0) { // 1/4 chance to poison
        // poison npc
        ~npc_poison_start($poison_severity);
    }
}

//mes("attackstyle: <tostring(%attackstyle)>, damagestyle: <tostring(%damagestyle)>, damage: <tostring($damage)>, damagetype: <tostring(%damagetype)>");
anim(%com_attackanim, 0);
sound_synth(%com_attacksound, 0, 0);
~npc_retaliate(0);
npc_queue(2, $damage, 0);
npc_anim(npc_param(defend_anim), 20); 
if (npc_param(defend_sound) ! null) {
    sound_synth(npc_param(defend_sound), 0, 20); // delay npc this tick
}
// set the skill clock depending on the weapon attack rate
if ($weapon = null) {
    %action_delay = add(map_clock, 4);
} else {
    %action_delay = add(map_clock, oc_param($weapon, attackrate));
}
~abyssal_tentacle_swing; // a charge per swing (area_kraken_cove/scripts/abyssal_tentacle.rs2)

p_opnpc(2);
