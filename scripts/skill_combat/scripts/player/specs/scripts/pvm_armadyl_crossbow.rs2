// ARMADYL EYE, the Armadyl crossbow's special (OSRS; the crossbow drops from Kree'arra): 40% of the
// special energy for one shot at twice the accuracy. The damage is the ordinary shot's, and an
// enchanted bolt's effect can still fire on it (bolt_effects.rs2).
[label,pvm_armadyl_crossbow_sa]
def_obj $rhand = inv_getobj(worn, ^wearpos_rhand);
def_obj $ammo = ~player_ranged_check_ammo($rhand);
if ($ammo = null) {
    p_stopaction;
    ~update_all($rhand);
    return;
}

~set_sa_vars(oc_param($rhand, sa_energy));

anim(%com_attackanim, 0);
spotanim_pl(oc_param($ammo, proj_launch), 96, 0);
sound_synth(%com_attacksound, 0, 0);
def_int $duration = ~npc_projectile(coord, npc_uid, oc_param($ammo, proj_travel), 40, 36, 41, 15, 5, 11, 5);
~ranged_dropammo_npc($ammo, divide($duration, 30));

def_int $damage = 0;
def_int $bolt_effect = ~bolt_effect_roll($rhand, $ammo);
if ($bolt_effect ! ^bolt_none | ~player_npc_hit_roll_boosted(%damagetype, 2, 1) = true) {
    def_int $maxhit = %com_maxhit;
    $damage = randominc(min($maxhit, npc_param(max_dealt)));
    if ($bolt_effect ! ^bolt_none & $maxhit > 0) {
        $damage = min(~bolt_effect_damage($bolt_effect, $maxhit), npc_param(max_dealt));
    }
    def_int $damage_capped = min($damage, npc_stat(hitpoints));
    ~give_combat_experience(%damagestyle, $damage_capped, %npc_combat_xp_multiplier);
    npc_heropoints($damage_capped);
}
~bolt_effect_after_hit($rhand, $ammo, $damage);

~npc_retaliate(add(divide($duration, 30), 1));
npc_queue(2, $damage, add(divide($duration, 30), 1));
npc_anim(npc_param(defend_anim), $duration);
if (npc_param(defend_sound) ! null) {
    sound_synth(npc_param(defend_sound), 0, $duration);
}
