// Auto retaliate, which 474 put on every combat tab (the "Auto Retaliate" button under the attack
// styles) rather than on the player-controls tab it had in 377. The combat tabs' buttons call this.
// %option_nodef is 0 on, 1 off (^player_auto_retaliate_on / _off).

[proc,toggle_auto_retaliate]
// Only the setting changes: no p_stopaction and no if_close, so flipping it mid-fight, mid-skill or
// with a bank open carries on with whatever you were doing. (Old School made the button stop you in
// its 2016 Slayer Cave update; this build takes the older behaviour, which players here prefer.)
// Nothing here needs protected access, so it cannot be refused while you are busy either.
if (%option_nodef = ^player_auto_retaliate_on) {
    %option_nodef = ^player_auto_retaliate_off;
} else {
    %option_nodef = ^player_auto_retaliate_on;
}

[if_button,combat_axe:auto_retaliate] ~toggle_auto_retaliate;
[if_button,combat_blunt:auto_retaliate] ~toggle_auto_retaliate;
[if_button,combat_bow:auto_retaliate] ~toggle_auto_retaliate;
[if_button,combat_claw:auto_retaliate] ~toggle_auto_retaliate;
[if_button,combat_crossbow:auto_retaliate] ~toggle_auto_retaliate;
[if_button,combat_hacksword:auto_retaliate] ~toggle_auto_retaliate;
[if_button,combat_heavysword:auto_retaliate] ~toggle_auto_retaliate;
[if_button,combat_pickaxe:auto_retaliate] ~toggle_auto_retaliate;
[if_button,combat_scythe:auto_retaliate] ~toggle_auto_retaliate;
[if_button,combat_spear:auto_retaliate] ~toggle_auto_retaliate;
[if_button,combat_spiked:auto_retaliate] ~toggle_auto_retaliate;
[if_button,combat_stabsword:auto_retaliate] ~toggle_auto_retaliate;
[if_button,combat_thrown:auto_retaliate] ~toggle_auto_retaliate;
[if_button,combat_unarmed:auto_retaliate] ~toggle_auto_retaliate;
[if_button,combat_whip:auto_retaliate] ~toggle_auto_retaliate;
[if_button,combat_staff_2:auto_retaliate] ~toggle_auto_retaliate;
[if_button,combat_powered_staff:auto_retaliate] ~toggle_auto_retaliate;
