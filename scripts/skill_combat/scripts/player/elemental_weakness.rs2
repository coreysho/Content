// ELEMENTAL WEAKNESSES and the TWINFLAME STAFF (2026-09-21), both OSRS's.
//
// Elemental weakness (oldschool.runescape.wiki/w/Elemental_weakness): a monster weak to an element
// takes, from a strike, bolt, blast or wave of that element, 1% more accuracy and 1% of the spell's
// max hit on top for every percent of weakness. Standard spellbook only - nothing from the Ancients,
// and not the god spells or Iban's. The per-monster figures are the wiki's, matched to this build by
// name in configs/magic/elemental_weakness.enum (tools/genelementalweakness.py).
//
// The twinflame staff (oldschool.runescape.wiki/w/Twinflame_staff): +10% accuracy and damage with any
// standard-spellbook spell, and a bolt, blast or wave cast with it hits twice - the second a tick
// later, for 40% of the first, rounded down, with no experience for it.

// 1 air, 2 water, 3 earth, 4 fire - the enum's numbering - or 0 for a spell with no element.
[proc,spell_element](int $spell)(int)
switch_int ($spell) {
    case ^wind_strike, ^wind_bolt, ^wind_blast, ^wind_wave : return(1);
    case ^water_strike, ^water_bolt, ^water_blast, ^water_wave : return(2);
    case ^earth_strike, ^earth_bolt, ^earth_blast, ^earth_wave : return(3);
    case ^fire_strike, ^fire_bolt, ^fire_blast, ^fire_wave : return(4);
}
return(0);

// The current npc's weakness to $spell, in percent, or 0.
[proc,elemental_weakness_pct](int $spell)(int)
def_int $element = ~spell_element($spell);
if ($element = 0) {
    return(0);
}
def_int $w = enum(npc, int, elemental_weakness, npc_type);
if (divide($w, 1000) ! $element) {
    return(0);
}
return(modulo($w, 1000));

// Every percent a cast gains against the current npc: its weakness, and the twinflame staff's 10%
// for a standard-spellbook spell (ids under 100: the Ancients start at 200).
[proc,spell_bonus_pct](int $spell)(int)
def_int $pct = ~elemental_weakness_pct($spell);
if (inv_getobj(worn, ^wearpos_rhand) = twinflame_staff & $spell < 100) {
    $pct = add($pct, 10);
}
return($pct);

// Bolts, blasts and waves - strike and surge are left out, as in OSRS.
[proc,twinflame_second_hit](int $spell)(boolean)
if (inv_getobj(worn, ^wearpos_rhand) ! twinflame_staff) {
    return(false);
}
if ($spell >= ^wind_bolt & $spell <= ^fire_wave) {
    return(true);
}
return(false);

// EXAMINE (2026-09-23). 377 printed an npc's description inside the client and the server never
// heard about it; the client now sends the examine here (engine ExamineNpcHandler, which has
// already resolved a multinpc to the form this player sees) so it can say more than the
// description. The first line is exactly what the client used to print - the desc, or "It's a
// <name>." for an npc without one - and a monster with an elemental weakness adds its element and
// how much, so a player can find out which spell to bring without leaving the game.
[proc,npc_examine](npc $npc)
def_string $desc = nc_desc($npc);
if (compare($desc, "null") = 0 | string_length($desc) < 1) {
    $desc = "It's a <nc_name($npc)>.";
}
mes($desc);
def_int $w = enum(npc, int, elemental_weakness, $npc);
if ($w > 0) {
    mes("Elemental weakness: @dre@<~element_name(divide($w, 1000))> (<tostring(modulo($w, 1000))>%)@bla@");
}
// and a monster's drop table, in a window (drop_tables/scripts/npc_drops.rs2); the text above stays,
// and an npc with nothing to drop opens nothing
~npc_drops_open($npc);

// The enum's element numbering, as a word.
[proc,element_name](int $element)(string)
switch_int ($element) {
    case 1 : return("Air");
    case 2 : return("Water");
    case 3 : return("Earth");
    case 4 : return("Fire");
}
return("None");
