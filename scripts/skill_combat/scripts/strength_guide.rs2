// Strength skill guide, shown on the original RS2 skill guide interface
// (see content/scripts/interfaces/skill_guide.rs2 for the generic driver).
// This is the complete set. Nothing else in the repo gates on Strength - every one
// of these comes from a combined attack+strength check in levelrequire/.
[proc,open_strength_guide]
~skillguide_begin(^guide_strength, "Strength");
def_int $lvl = stat(strength);
~skillguide_row(1, $lvl, 5, black_halberd, "Black halberd (10 Att)");
~skillguide_row(2, $lvl, 10, mithril_halberd, "Mithril halberd (20 Att)");
~skillguide_row(3, $lvl, 15, adamant_halberd, "Adamant halberd (30 Att)");
~skillguide_row(4, $lvl, 20, rune_halberd, "Rune halberd (40 Att)");
~skillguide_row(5, $lvl, 30, dragon_halberd, "Dragon halberd (60 Att, quest)");
~skillguide_row(6, $lvl, 50, granite_maul, "Granite maul (50 Att)");
~skillguide_row(7, $lvl, 70, barrows_dharok_weapon, "Dharok's greataxe (70 Att)");
~skillguide_row(8, $lvl, 70, barrows_torag_weapon, "Torag's hammers (70 Att)");
~skillguide_show;
