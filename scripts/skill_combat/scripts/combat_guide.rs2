// Combined Attack / Strength / Defence guide, matching how the real 2006 skill
// guides grouped the core combat stats. Each row is coloured against the stat
// that actually gates it. Hitpoints has no level requirements anywhere in this
// repo, so it contributes no rows.
[proc,open_combat_guide]
~skillguide_begin(^guide_combat, "Combat");
def_int $att = stat(attack);
def_int $str = stat(strength);
def_int $def = stat(defence);
~skillguide_row(1, $att, 1, bronze_scimitar, "Bronze weapons");
~skillguide_row(2, $def, 1, bronze_platebody, "Bronze armour");
~skillguide_row(3, $att, 1, iron_scimitar, "Iron weapons");
~skillguide_row(4, $def, 1, iron_platebody, "Iron armour");
~skillguide_row(5, $att, 5, steel_scimitar, "Steel weapons");
~skillguide_row(6, $def, 5, steel_platebody, "Steel armour");
~skillguide_row(7, $att, 10, black_scimitar, "Black weapons");
~skillguide_row(8, $def, 10, black_platebody, "Black armour");
~skillguide_row(9, $def, 10, hardleather_body, "Hardleather body");
~skillguide_row(10, $att, 20, mithril_scimitar, "Mithril weapons");
~skillguide_row(11, $def, 20, mithril_platebody, "Mithril armour");
~skillguide_row(12, $att, 20, excalibur, "Excalibur");
~skillguide_row(13, $att, 30, adamant_scimitar, "Adamant weapons");
~skillguide_row(14, $def, 30, adamant_platebody, "Adamant armour");
~skillguide_row(15, $att, 40, rune_scimitar, "Rune weapons");
~skillguide_row(16, $def, 40, rune_kiteshield, "Rune armour");
~skillguide_row(17, $def, 40, rune_platebody, "Rune platebody (quest)");
~skillguide_row(18, $def, 45, viking_helmet_slash, "Warrior helm (quest)");
~skillguide_row(19, $str, 50, granite_maul, "Granite maul");
~skillguide_row(20, $att, 50, slayer_leafbladed_spear, "Leaf-bladed spear");
~skillguide_row(21, $att, 60, dragon_dagger, "Dragon dagger (quest)");
~skillguide_row(22, $att, 60, dragon_longsword, "Dragon longsword (quest)");
~skillguide_row(23, $att, 60, dragon_scimitar, "Dragon scimitar (quest)");
~skillguide_row(24, $att, 60, dragon_mace, "Dragon mace (quest)");
~skillguide_row(25, $att, 60, dragon_battleaxe, "Dragon battleaxe (quest)");
~skillguide_row(26, $att, 60, dragon_spear, "Dragon spear");
~skillguide_row(27, $att, 60, dragon_halberd, "Dragon halberd (quest)");
~skillguide_row(28, $def, 60, dragon_med_helm, "Dragon med helm");
~skillguide_row(29, $def, 60, dragon_chainbody, "Dragon chainbody");
~skillguide_row(30, $def, 60, dragon_platelegs, "Dragon platelegs");
~skillguide_row(31, $def, 60, dragon_sq_shield, "Dragon sq shield (quest)");
~skillguide_row(32, $att, 70, abyssal_whip, "Abyssal whip");
~skillguide_row(33, $att, 70, barrows_verac_weapon, "Verac's flail");
~skillguide_row(34, $att, 70, barrows_guthan_weapon, "Guthan's warspear");
~skillguide_row(35, $att, 70, barrows_dharok_weapon, "Dharok's greataxe");
~skillguide_row(36, $att, 70, barrows_torag_weapon, "Torag's hammers");
~skillguide_row(37, $def, 70, barrows_dharok_body, "Dharok's platebody");
~skillguide_row(38, $def, 70, barrows_guthan_body, "Guthan's platebody");
~skillguide_row(39, $def, 70, barrows_torag_body, "Torag's platebody");
~skillguide_row(40, $def, 70, barrows_verac_body, "Verac's brassard");
~skillguide_show;
