// Attack skill guide, shown on the original RS2 skill guide interface
// (see content/scripts/interfaces/skill_guide.rs2 for the generic driver).
// Metal tiers are collapsed to one row each - every dagger/axe/mace/sword/scimitar/
// longsword/warhammer/battleaxe/spear/2h/claws in a tier shares its attack level.
[proc,open_attack_guide]
~skillguide_begin(^guide_attack, "Attack");
def_int $lvl = stat(attack);
~skillguide_row(1, $lvl, 1, bronze_scimitar, "Bronze weapons");
~skillguide_row(2, $lvl, 1, iron_scimitar, "Iron weapons");
~skillguide_row(3, $lvl, 1, plainstaff, "Staves");
~skillguide_row(4, $lvl, 5, steel_scimitar, "Steel weapons");
~skillguide_row(5, $lvl, 5, tbwt_bronze_spear_kp, "Bronze spear (kebbit)");
~skillguide_row(6, $lvl, 10, black_scimitar, "Black weapons");
~skillguide_row(7, $lvl, 10, black_halberd, "Black halberd (5 Str)");
~skillguide_row(8, $lvl, 20, mithril_scimitar, "Mithril weapons");
~skillguide_row(9, $lvl, 20, excalibur, "Excalibur");
~skillguide_row(10, $lvl, 20, mithril_halberd, "Mithril halberd (10 Str)");
~skillguide_row(11, $lvl, 30, adamant_scimitar, "Adamant weapons");
~skillguide_row(12, $lvl, 30, adamant_halberd, "Adamant halberd (15 Str)");
~skillguide_row(13, $lvl, 30, battlestaff, "Battlestaves");
~skillguide_row(14, $lvl, 40, rune_scimitar, "Rune weapons");
~skillguide_row(15, $lvl, 40, rune_halberd, "Rune halberd (20 Str)");
~skillguide_row(16, $lvl, 40, mystic_fire_staff, "Mystic staves");
~skillguide_row(17, $lvl, 50, granite_maul, "Granite maul (50 Str)");
~skillguide_row(18, $lvl, 50, slayer_leafbladed_spear, "Leaf-bladed spear");
~skillguide_row(19, $lvl, 50, ibanstaff, "Iban's staff");
~skillguide_row(20, $lvl, 50, staff_of_zaros, "Ancient staff");
~skillguide_row(21, $lvl, 60, dragon_dagger, "Dragon dagger (quest)");
~skillguide_row(22, $lvl, 60, dragon_longsword, "Dragon longsword (quest)");
~skillguide_row(23, $lvl, 60, dragon_mace, "Dragon mace (quest)");
~skillguide_row(24, $lvl, 60, dragon_battleaxe, "Dragon battleaxe (quest)");
~skillguide_row(25, $lvl, 60, dragon_spear, "Dragon spear");
~skillguide_row(26, $lvl, 60, dragon_scimitar, "Dragon scimitar (quest)");
~skillguide_row(27, $lvl, 60, dragon_halberd, "Dragon halberd (30 Str, quest)");
~skillguide_row(28, $lvl, 70, abyssal_whip, "Abyssal whip");
~skillguide_row(29, $lvl, 70, barrows_verac_weapon, "Verac's flail");
~skillguide_row(30, $lvl, 70, barrows_guthan_weapon, "Guthan's warspear");
~skillguide_row(31, $lvl, 70, barrows_dharok_weapon, "Dharok's greataxe (70 Str)");
~skillguide_row(32, $lvl, 70, barrows_torag_weapon, "Torag's hammers (70 Str)");
~skillguide_row(33, $lvl, 70, barrows_ahrim_weapon, "Ahrim's staff");
~skillguide_show;
