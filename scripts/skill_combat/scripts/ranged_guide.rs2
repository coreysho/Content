// Ranged skill guide, shown on the original RS2 skill guide interface
// (see content/scripts/interfaces/skill_guide.rs2 for the generic driver).
[proc,open_ranged_guide]
~skillguide_begin(^guide_ranged, "Ranged");
def_int $lvl = stat(ranged);
~skillguide_row(1, $lvl, 1, shortbow, "Shortbow");
~skillguide_row(2, $lvl, 1, longbow, "Longbow");
~skillguide_row(3, $lvl, 1, crossbow, "Crossbow");
~skillguide_row(4, $lvl, 1, leather_armour, "Leather armour");
~skillguide_row(5, $lvl, 1, bronze_dart, "Bronze/iron throwables");
~skillguide_row(6, $lvl, 5, oak_shortbow, "Oak shortbow");
~skillguide_row(7, $lvl, 5, oak_longbow, "Oak longbow");
~skillguide_row(8, $lvl, 5, steel_dart, "Steel throwables");
~skillguide_row(9, $lvl, 10, black_knife, "Black knife");
~skillguide_row(10, $lvl, 20, willow_shortbow, "Willow shortbow");
~skillguide_row(11, $lvl, 20, willow_longbow, "Willow longbow");
~skillguide_row(12, $lvl, 20, coif, "Coif");
~skillguide_row(13, $lvl, 20, studded_body, "Studded body");
~skillguide_row(14, $lvl, 20, studded_chaps, "Studded chaps");
~skillguide_row(15, $lvl, 20, mithril_dart, "Mithril throwables");
~skillguide_row(16, $lvl, 30, maple_shortbow, "Maple shortbow");
~skillguide_row(17, $lvl, 30, maple_longbow, "Maple longbow");
~skillguide_row(18, $lvl, 30, ogre_bow, "Ogre bow");
~skillguide_row(19, $lvl, 30, adamant_dart, "Adamant throwables");
~skillguide_row(20, $lvl, 30, snakeskin_body, "Snakeskin armour");
~skillguide_row(21, $lvl, 40, robinhoodhat, "Robin Hood hat");
~skillguide_row(22, $lvl, 40, boots_ranger, "Ranger boots");
~skillguide_row(23, $lvl, 40, yew_shortbow, "Yew shortbow");
~skillguide_row(24, $lvl, 40, yew_longbow, "Yew longbow");
~skillguide_row(25, $lvl, 40, dragonhide_body, "Green d'hide body");
~skillguide_row(26, $lvl, 40, dragonhide_chaps, "Green d'hide chaps");
~skillguide_row(27, $lvl, 40, dragon_vambraces, "Green d'hide vambs");
~skillguide_row(28, $lvl, 40, rune_dart, "Rune throwables");
~skillguide_row(29, $lvl, 50, magic_shortbow, "Magic shortbow");
~skillguide_row(30, $lvl, 50, magic_longbow, "Magic longbow");
~skillguide_row(31, $lvl, 50, blue_dragonhide_body, "Blue d'hide body");
~skillguide_row(32, $lvl, 50, blue_dragonhide_chaps, "Blue d'hide chaps");
~skillguide_row(33, $lvl, 50, blue_dragon_vambraces, "Blue d'hide vambs");
~skillguide_row(34, $lvl, 50, slayer_broad_arrows, "Broad arrows");
~skillguide_row(35, $lvl, 60, red_dragonhide_body, "Red d'hide body");
~skillguide_row(36, $lvl, 60, red_dragon_vambraces, "Red d'hide vambs");
~skillguide_row(37, $lvl, 70, black_dragonhide_body, "Black d'hide body");
~skillguide_row(38, $lvl, 70, barrows_karil_weapon, "Karil's crossbow");
~skillguide_row(39, $lvl, 70, barrows_karil_head, "Karil's coif");
~skillguide_row(40, $lvl, 70, barrows_karil_legs, "Karil's leatherskirt");
~skillguide_show;
