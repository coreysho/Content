// Data rows for magic_spell_table (magic_combat_spells.dbtable). Populates the framework that
// player_magic.rs2 / npc_combat_magic.rs2 were already written against but which never existed - see
// claude/ancient-magicks.md.
//
// All level/rune/xp/maxhit figures below are the classic (2006-era, pre gear-scaling) OSRS values,
// cross-checked against the wiki. XP is stored *100 (fixed point), matching this repo's existing
// convention (see skill_cooking's cooking_generic.dbrow, e.g. stew = 1170 for 11.7 xp).
//
// Player cast anim/spotanim tags for the 26 normal spellbook rows are all directly confirmed against
// content/scripts/_unpack/377/all.seq and all.spotanim. sound_cast/sound_hit are left unpopulated
// everywhere: no all.synth or synth.pack exists anywhere in this repo, so there is no real tag to
// verify a sound name against for ANY spell (not just the new ones) - see the guard added in
// player_magic.rs2/npc_combat_magic.rs2 that makes sound_cast safely skippable instead of a hard error.

// ============================================================
// Normal spellbook - strike/bolt/blast/wave (16)
// ============================================================

[magic_combat_wind_strike]
table=magic_spell_table
data=spell,^wind_strike
data=spellcom,magic:wind_strike
data=level,1
data=xp,550
data=maxhit,2
data=anim,human_caststrike
data=spotanim_origin,windstrike_casting
data=spotanim_proj,windstrike_travel
data=spotanim_target,windstrike_impact
data=continue_by_autocast,yes
data=rune,airrune,1
data=rune,mindrune,1

