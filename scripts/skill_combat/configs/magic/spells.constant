// Teleport to house (Corey, 2026-09-11). No button and no spellbook entry - the spell was
// added to the game with Construction, after 377 - but its tablet needs a recipe, and every
// other tablet reads its recipe out of magic_spell_table. So the row exists and only
// poh_tablets.rs2 asks for this id.
^teleport_to_house = 226

// Teleport to Ape Atoll. Same story as Trollheim: the button was already drawn in magic.if with
// the right level and the right rune checks - including the banana, which the client already
// counts - and only the id, the dbrow and the trigger were missing. The component was still
// carrying its unpacked name (com_569), so nothing could reference it.
^ape_atoll_teleport = 227
