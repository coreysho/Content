// The data table that player_magic.rs2 / npc_combat_magic.rs2 have always been written to read from
// (see the ~get_spell_data proc and every db_getfield(..., magic_spell_table:X, ...) call in those two
// files) but which never actually existed anywhere in the repo - see claude/ancient-magicks.md for the
// full writeup. This was silently broken for EVERY combat spell (Wallasalki's water wave included), not
// just the new Ancient Magicks ones added alongside it.
//
// spellcom is left unpopulated (data=spellcom,...) for the 16 Ancient Magicks rows: the real
// magic:wind_strike-style component tag for each ancient spell can't be identified from this repo (no
// raw interface source, only ~540 unlabeled magic:com_NN entries in content/pack/interface.pack) so
// spellcom is only trustworthy for the 26 normal-spellbook rows, whose tags are directly confirmed
// there. spellcom is only ever read for autocast re-triggering (continue_by_autocast=true rows), so the
// ancient rows all set continue_by_autocast to false and are cast directly via ~pvm_default_spell
// (either from a real apnpct trigger for normal spells, or the ::cast dev command for ancients).
[magic_spell_table]
column=spell,int,INDEXED,REQUIRED
column=spellcom,component
column=level,int,REQUIRED
column=xp,int,REQUIRED
column=maxhit,int,REQUIRED
column=anim,seq,REQUIRED
column=spotanim_origin,spotanim,LIST
column=spotanim_proj,spotanim,LIST
column=spotanim_target,spotanim,REQUIRED
column=sound_cast,synth,LIST
column=sound_hit,synth,LIST
column=freeze_time,int
column=stat_change,stat,int,int,LIST
column=continue_by_autocast,boolean,REQUIRED
column=rune,namedobj,int,LIST
column=heal_percent,int
column=poison_chance,int
column=poison_severity,int
