// Every crossbow but Karil's: OSRS seqs 4230 (fire), 4591 (ready), 4226 (walk), 4228 (run). They
// used 377's human_crossbow (seq 427), the one-handed hip shot that looks like Karil's own, and
// the attack is on the OSRS skeleton so the stances have to be too (see below).
// Animations converted from the OSRS cache by tools/models/animconvosrs.py.
// They play on the OSRS player skeleton (base_osrs_*), not the 377 one: the client
// only walk-merges two animations that share a base (ClientPlayer/NpcType patch).

[osrs_crossbow_fire]
// OSRS seq 4230
reachforward=yes
priority=6
duplicatebehaviour=reset
frame1=anim_osrs_10773_1
delay1=10
frame2=anim_osrs_10773_2
delay2=5
frame3=anim_osrs_10773_3
delay3=4
frame4=anim_osrs_10773_4
delay4=4
