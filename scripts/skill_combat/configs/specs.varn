// map_clock of the last multi-target special attack that hit this npc (dragon halberd Sweep,
// dragon 2h Powerstab) - lets pvm_specs_osrs.rs2 hit each npc once without arrays.
[npc_multihit]
type=int

// The same count for a monster. Cleared for us on respawn - Npc.resetEntity zeroes every varn.
[npc_arkan_burn_stacks]
type=int
