// map_clock until which protection prayers are blocked by a dragon scimitar Sever
// (pvp/specs/scripts/pvp_specs_osrs.rs2).
[sever_block]
protect=no

// How many Flames of Ralos burns are running on this player right now. Old School caps a burn at
// five stacks and discards any further one, and the damage per tick IS the stack count - so the
// count has to be tracked rather than inferred from the queue.
// (player/specs/scripts/arkan_blade.rs2)
[arkan_burn_stacks]
protect=no
