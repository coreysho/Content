// Crossbow bolts (474), in the fletching table skill_fletching/scripts/bolts.rs2 reads. Levels and
// experience are OSRS's, which are 2006's; experience is in tenths, per gem or per bolt.

// a cut gem and a chisel make tips, twelve to the gem (onyx twenty-four)
[fletching_jade_tips]
table=fletching_table
data=item,jade
data=product,jade_bolttips,12
data=level,26
data=experience,24
data=skill_anim,human_jadecutting
data=skill_sound,chisel

