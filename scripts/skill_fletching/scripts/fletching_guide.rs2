~skillguide_row(2, $lvl, 1, bronze_dart, "Bronze dart");
~skillguide_row(3, $lvl, 5, ogre_arrow, "Ogre arrow");
~skillguide_row(4, $lvl, 15, iron_arrow, "Iron arrow");
~skillguide_row(5, $lvl, 22, iron_dart, "Iron dart");
~skillguide_row(6, $lvl, 30, steel_arrow, "Steel arrow");
~skillguide_row(7, $lvl, 37, steel_dart, "Steel dart");
~skillguide_row(8, $lvl, 45, mithril_arrow, "Mithril arrow");
~skillguide_row(9, $lvl, 52, mithril_dart, "Mithril dart");
~skillguide_row(10, $lvl, 60, adamant_arrow, "Adamant arrow");
~skillguide_row(11, $lvl, 67, adamant_dart, "Adamant dart");
~skillguide_row(12, $lvl, 75, rune_arrow, "Rune arrow");
~skillguide_row(13, $lvl, 81, rune_dart, "Rune dart");

