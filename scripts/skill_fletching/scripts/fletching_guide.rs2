// Fletching skill guide, shown on the original RS2 skill guide interface
// (see content/scripts/interfaces/skill_guide.rs2 for the generic driver).
// Unstrung bows share their strung level, so they are collapsed into one row each. Four pages since
// the crossbows (474) - bows, arrows and darts, crossbows, bolts - as smithing_guide.rs2 has seven.
[proc,open_fletching_guide]
%skillguide_page = 1;
~fletching_guide_render;

[proc,fletching_guide_render]
~skillguide_begin(^guide_fletching, "Fletching");
~skillguide_members;
~skillguide_panels(4);
~skillguide_button(1, "Bows");
~skillguide_button(2, "Ammo");
~skillguide_button(3, "Crossbows");
~skillguide_button(4, "Bolts");
def_int $lvl = stat(fletching);
switch_int (%skillguide_page) {
    case 2 : ~fletching_guide_ammo($lvl);
    case 3 : ~fletching_guide_crossbows($lvl);
    case 4 : ~fletching_guide_bolts($lvl);
    case default : ~fletching_guide_bows($lvl);
}
~skillguide_show;

[proc,fletching_guide_bows](int $lvl)
~skillguide_row(1, $lvl, 1, arrow_shaft, "Arrow shaft");
~skillguide_row(2, $lvl, 1, headless_arrow, "Headless arrow");
~skillguide_row(3, $lvl, 5, shortbow, "Shortbow");
~skillguide_row(4, $lvl, 10, longbow, "Longbow");
~skillguide_row(5, $lvl, 20, oak_shortbow, "Oak shortbow");
~skillguide_row(6, $lvl, 25, oak_longbow, "Oak longbow");
~skillguide_row(7, $lvl, 35, willow_shortbow, "Willow shortbow");
~skillguide_row(8, $lvl, 40, willow_longbow, "Willow longbow");
~skillguide_row(9, $lvl, 50, maple_shortbow, "Maple shortbow");
~skillguide_row(10, $lvl, 55, maple_longbow, "Maple longbow");
~skillguide_row(11, $lvl, 65, yew_shortbow, "Yew shortbow");
~skillguide_row(12, $lvl, 70, yew_longbow, "Yew longbow");
~skillguide_row(13, $lvl, 80, magic_shortbow, "Magic shortbow");
~skillguide_row(14, $lvl, 85, magic_longbow, "Magic longbow");

[proc,fletching_guide_ammo](int $lvl)
