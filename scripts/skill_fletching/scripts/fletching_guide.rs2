// Fletching skill guide, shown on the original RS2 skill guide interface
// (see content/scripts/interfaces/skill_guide.rs2 for the generic driver).
// Unstrung bows share their strung level, so they are collapsed into one row each.
[proc,open_fletching_guide]
~skillguide_begin(^guide_fletching, "Fletching");
~skillguide_members;
def_int $lvl = stat(fletching);
~skillguide_row(1, $lvl, 1, arrow_shaft, "Arrow shaft");
~skillguide_row(2, $lvl, 1, headless_arrow, "Headless arrow");
~skillguide_row(3, $lvl, 1, bronze_arrow, "Bronze arrow");
~skillguide_row(4, $lvl, 1, bronze_dart, "Bronze dart");
~skillguide_row(5, $lvl, 5, shortbow, "Shortbow");
~skillguide_row(6, $lvl, 5, ogre_arrow, "Ogre arrow");
~skillguide_row(7, $lvl, 10, longbow, "Longbow");
~skillguide_row(8, $lvl, 11, opal_bolttips, "Opal bolttips");
~skillguide_row(9, $lvl, 11, opal_bolt, "Opal bolts");
~skillguide_row(10, $lvl, 15, iron_arrow, "Iron arrow");
~skillguide_row(11, $lvl, 20, oak_shortbow, "Oak shortbow");
~skillguide_row(12, $lvl, 22, iron_dart, "Iron dart");
~skillguide_row(13, $lvl, 25, oak_longbow, "Oak longbow");
~skillguide_row(14, $lvl, 30, steel_arrow, "Steel arrow");
~skillguide_row(15, $lvl, 35, willow_shortbow, "Willow shortbow");
~skillguide_row(16, $lvl, 37, steel_dart, "Steel dart");
~skillguide_row(17, $lvl, 40, willow_longbow, "Willow longbow");
~skillguide_row(18, $lvl, 41, pearl_bolttips, "Pearl bolttips");
~skillguide_row(19, $lvl, 41, pearl_bolt, "Pearl bolts");
~skillguide_row(20, $lvl, 45, mithril_arrow, "Mithril arrow");
~skillguide_row(21, $lvl, 50, maple_shortbow, "Maple shortbow");
~skillguide_row(22, $lvl, 51, barbed_bolt, "Barbed bolts");
~skillguide_row(23, $lvl, 52, mithril_dart, "Mithril dart");
~skillguide_row(24, $lvl, 55, maple_longbow, "Maple longbow");
~skillguide_row(25, $lvl, 60, adamant_arrow, "Adamant arrow");
~skillguide_row(26, $lvl, 65, yew_shortbow, "Yew shortbow");
~skillguide_row(27, $lvl, 67, adamant_dart, "Adamant dart");
~skillguide_row(28, $lvl, 70, yew_longbow, "Yew longbow");
~skillguide_row(29, $lvl, 75, rune_arrow, "Rune arrow");
~skillguide_row(30, $lvl, 80, magic_shortbow, "Magic shortbow");
~skillguide_row(31, $lvl, 81, rune_dart, "Rune dart");
~skillguide_row(32, $lvl, 85, magic_longbow, "Magic longbow");
~skillguide_show;
