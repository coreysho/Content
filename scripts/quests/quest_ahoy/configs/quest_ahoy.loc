// Ghosts Ahoy - the tatty doors of Port Phasmatys and the wreck.
//
// Moved here out of _unpack/377/all.loc (redeclaring would be a duplicate-config error) for two
// added lines each: the door_closed/door_opened category and next_loc_stage, which hand them to the
// generic door code in doors/scripts/doors.rs2. They carried op1=Open/Close and no script at all, and
// three of them stand between the player and the quest: Robin's house, the temple's upper floor
// (Necrovarus' coffin) and the middle deck of the wreck (the pirate captain and the old man).

[ahoy_harbour_door]
name=Door
desc=Looks a bit tatty...
model=zanarisdoor
recol1s=8387
recol1d=6370
recol2s=19912
recol2d=6370
recol3s=16741
recol3d=8484
recol4s=7330
recol4d=4256
active=yes
op1=Open
category=door_closed
param=next_loc_stage,ahoy_harbour_door_open

[ahoy_harbour_door_open]
name=Door
desc=Looks a bit tatty...
model=zanarisdoor
recol1s=8387
recol1d=6370
recol2s=19912
recol2d=6370
recol3s=16741
recol3d=8484
recol4s=7330
recol4d=4256
active=yes
op1=Close
category=door_opened
param=next_loc_stage,ahoy_harbour_door
