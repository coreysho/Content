// Dr Fenkenstrain, his creature, and the gardener's ghost.
//
// The two doctor shells and the two creature shells are all placed, all four keyed on %fenk_quest,
// and the swap happens at 8 - so the handlers go on the shells and the endgame needs no npc_add or
// npc_del at all. See the quest's constant file.

// =========================================================================== Dr Fenkenstrain

[opnpc1,fenk_fenkenstrain]
switch_int (%fenk_quest) {
    case ^fenk_not_started : @fenk_doctor_hire;
    case ^fenk_started : @fenk_doctor_parts;
    case ^fenk_parts_gathered : @fenk_doctor_sew;
    case ^fenk_body_sewn : @fenk_doctor_conductor;
    case ^fenk_conductor_fitted : @fenk_doctor_storm;
    case ^fenk_creature_alive : @fenk_doctor_dismiss;
    case ^fenk_creature_spoke : @fenk_doctor_dismiss;
    case ^fenk_has_proof : @fenk_doctor_accused;
    case default : @fenk_doctor_dismiss;
}

// At stage 8 this shell is the one standing in the tower, and there is nothing left to say through
// a locked door.
[opnpc1,fenk_fenkenstrain_in_tower]
~chatnpc("<p,angry>Go away! The door is bolted and it is staying bolted!");
~chatplayer("<p,happy>Take your time.");

[label,fenk_doctor_hire]
~chatnpc("<p,neutral>You are not a local. Locals do not come up here.");
switch_int (~p_choice2("What is this place?", 1, "I'll leave you to it.", 2)) {
    case 2 :
        ~chatplayer("<p,neutral>I'll leave you to it.");
        ~chatnpc("<p,neutral>Wise.");
        return;
    case 1 :
        ~chatplayer("<p,quiz>What is this place?");
}
~chatnpc("<p,happy>My laboratory. My life's work. And, at the moment, my great frustration.");
~chatnpc("<p,neutral>I am assembling a man. I have the slab, I have the theory, and I have a shortage of arms, legs and torsos.");
~chatplayer("<p,shock>You want me to rob graves.");
~chatnpc("<p,happy>I want you to be well paid. The graveyards are full and their occupants have no further use for any of it.");
switch_int (~p_choice2("Fine. But I want paying.", 1, "Absolutely not.", 2)) {
    case 2 :
        ~chatplayer("<p,angry>Absolutely not.");
        ~chatnpc("<p,neutral>Then you are of no use to me. Mind the step on the way out.");
        return;
    case 1 :
        ~chatplayer("<p,neutral>Fine. But I want paying.");
}
~chatnpc("<p,happy>Excellent. Arms, legs and a torso from the graves - a spade will do for those.");
~chatnpc("<p,neutral>The head is a different matter. There is only one skull on this hill worth having, and it is in the mausoleum.");
if (inv_freespace(inv) = 0) {
    ~chatnpc("<p,neutral>Come back when you have a hand free. I have a key for you.");
    return;
}
%fenk_quest = ^fenk_started;
~send_quest_progress(questlist:creatureoffenkenstrain, %fenk_quest, ^fenk_complete);
inv_add(inv, fenk_mausoleum_key, 1);
mes("Dr Fenkenstrain gives you the cavern key.");

[label,fenk_doctor_parts]
if (inv_total(inv, fenk_arms) = 0 | inv_total(inv, fenk_legs) = 0 | inv_total(inv, fenk_torso) = 0 | (inv_total(inv, fenk_head_empty) = 0 & inv_total(inv, fenk_head_full) = 0)) {
    ~chatnpc("<p,quiz>Arms, legs, a torso and a head. How many of those am I looking at?");
    ~chatplayer("<p,sad>Not all four.");
    ~chatnpc("<p,neutral>Then we are not having a conversation yet.");
    return;
}
~chatplayer("<p,neutral>All four.");
~chatnpc("<p,happy>All four! Splendid. Put them on the slab and sew them together - needle, thread, and a steady hand.");
~chatnpc("<p,neutral>The head wants filling first. There is a brain in a jar on my bench; it is not doing anything.");
if (inv_freespace(inv) = 0) {
    ~chatnpc("<p,neutral>I would hand you the brain, but you are carrying half a cemetery as it is. Make room and ask again.");
    return;
}
inv_add(inv, fenk_brain, 1);
mes("Dr Fenkenstrain hands you a jar with a brain in it.");
%fenk_quest = ^fenk_parts_gathered;
~send_quest_progress(questlist:creatureoffenkenstrain, %fenk_quest, ^fenk_complete);

[label,fenk_doctor_sew]
~chatnpc("<p,neutral>Brain in the head, head on the body, and sew the whole thing up. The slab is through there.");
// The brain is handed over once, at the step before; one that has gone missing since would leave
// the head empty for good.
if (~obj_gettotal(fenk_brain) = 0 & ~obj_gettotal(fenk_head_full) = 0 & inv_freespace(inv) > 0) {
    ~chatplayer("<p,sad>I've lost the brain.");
    ~chatnpc("<p,angry>Then it is fortunate I keep spares. Try to hold on to this one.");
    inv_add(inv, fenk_brain, 1);
    mes("Dr Fenkenstrain hands you a jar with a brain in it.");
}

[label,fenk_doctor_conductor]
~chatnpc("<p,happy>It is a fine body. Now it wants waking, and for that I want lightning.");
~chatnpc("<p,angry>The conductor on my roof snapped off in a gale two winters ago and I have not been able to replace it.");
~chatnpc("<p,neutral>Cast a new one. Silver, from this mould, and get it back onto the roof.");
if (~obj_gettotal(fenk_lightning_mould) > 0) {
    ~chatnpc("<p,neutral>You have the mould already. Use it.");
    return;
}
if (inv_freespace(inv) = 0) {
    ~chatnpc("<p,neutral>When you have somewhere to put it.");
    return;
}
inv_add(inv, fenk_lightning_mould, 1);
mes("Dr Fenkenstrain gives you the conductor mould.");

[label,fenk_doctor_storm]
~chatplayer("<p,neutral>The conductor's back on the roof.");
~chatnpc("<p,happy>Then stand well back and do not touch anything metal.");
if_close;
mes("Dr Fenkenstrain throws a switch. The whole hill goes white.");
p_delay(3);
%fenk_quest = ^fenk_creature_alive;
~send_quest_progress(questlist:creatureoffenkenstrain, %fenk_quest, ^fenk_complete);
~mesbox("Something on the slab draws a breath.");
~chatnpc("<p,happy>IT LIVES! It lives, it lives, it - ");
~chatnpc("<p,confused>...why is it looking at me like that?");

[label,fenk_doctor_dismiss]
~chatnpc("<p,angry>Not now. I am busy, and you are in the way.");

[label,fenk_doctor_accused]
if (inv_total(inv, fenk_journal) = 0) {
    ~chatnpc("<p,angry>Not now.");
    return;
}
~chatplayer("<p,angry>Lord Rologarth. You murdered him, and then you used him.");
mes("You hold up the journal.");
~chatnpc("<p,shock>Where did you - that is private correspondence!");
~chatplayer("<p,neutral>It's a confession.");
~chatnpc("<p,angry>It is my LIFE'S WORK, and I will not be lectured about it by a grave robber I hired myself!");
if_close;
mes("Dr Fenkenstrain backs towards the tower stair, still talking.");
p_delay(2);
mes("The tower door slams. A bolt goes across on the inside.");
p_delay(1);
queue(fenk_quest_complete, 0, 0);

// =========================================================================== the creature

[opnpc1,fenk_creature]
if (%fenk_quest < ^fenk_creature_alive) {
    mes("It is not alive. It is a shape on a slab.");
    return;
}
if (%fenk_quest = ^fenk_creature_alive) {
    @fenk_creature_wakes;
}
if (inv_total(inv, fenk_journal) > 0) {
    ~chatnpc("<p,happy>You found it. Then it is not only me saying it.");
    ~chatplayer("<p,neutral>He's shut himself in the tower.");
    ~chatnpc("<p,neutral>Let him rot up there. I have a name again, and that is all I wanted.");
    return;
}
~chatnpc("<p,sad>His own hand, written down. That is what you want. He kept a journal - he could never resist admiring himself on paper.");

[label,fenk_creature_wakes]
~chatnpc("<p,confused>...cold. Everything is cold.");
~chatplayer("<p,shock>Can you understand me?");
~chatnpc("<p,sad>I understand you. I understand a great deal more than he thinks I do.");
~chatnpc("<p,angry>My name was Rologarth. Lord Rologarth, of this estate, until the good doctor came to me with a proposal and then with a knife.");
~chatplayer("<p,shock>You're the owner of this castle?");
~chatnpc("<p,sad>I was its owner. Now I am its exhibit.");
~chatnpc("<p,neutral>Find me something written. Nobody will take the word of a thing that was sewn together last week.");
%fenk_quest = ^fenk_creature_spoke;
~send_quest_progress(questlist:creatureoffenkenstrain, %fenk_quest, ^fenk_complete);

// At stage 8 the released shell is Lord Rologarth, and the quest is over.
[opnpc1,fenk_creature_released]
~chatnpc("<p,happy>The estate is mine again, such as it is. You have my thanks, and you are welcome here whenever you like.");
~chatplayer("<p,happy>What about the doctor?");
~chatnpc("<p,neutral>He has a tower, a bolt and a great deal of time to think. That will do.");

// =========================================================================== the gardener's ghost

// fenk_gardener_multi_2 is the placed shell and its only multinpc entry is 0, so the ghost is
// visible by default and setting fenk_gardener_directions to anything else would simply delete
// him. The conversation is recorded in fenk_spoken_to_gardener instead, which is what that varbit
// is for; fenk_gardener_directions is deliberately left alone.
[opnpc1,fenk_gardener_multi_2]
if (inv_total(worn, amulet_of_ghostspeak) = 0 & inv_total(worn, amulet_of_ghostspeak_enchanted) = 0) {
    ~chatnpc("<p,neutral>Wooo! Wooooo!");
    mes("The ghost seems to be trying to tell you something.");
    return;
}
if (%fenk_spoken_to_gardener = 0) {
    ~chatnpc("<p,sad>Forty years I kept these grounds, and he never once came out to look at them.");
    ~chatplayer("<p,quiz>Dr Fenkenstrain?");
    ~chatnpc("<p,angry>Fenkenstrain. He is not the master here, whatever he tells you. The master was a decent man and one day he simply was not here any more.");
    %fenk_spoken_to_gardener = 1;
}
if (~obj_gettotal(fenk_obsidian_amulet) > 0 | ~obj_gettotal(fenk_star_amulet) > 0 | %fenk_coffin = 1) {
    ~chatnpc("<p,neutral>Mind what you do with that amulet. It was the master's.");
    @fenk_gardener_shed_key;
}
~chatnpc("<p,neutral>The master wore an amulet in two halves - obsidian and marble. He kept the marble half in the garden shed, of all the daft places.");
if (inv_freespace(inv) = 0) {
    ~chatnpc("<p,neutral>I have the other half here, if you had anywhere to put it.");
    return;
}
~chatnpc("<p,neutral>I have carried the obsidian half about with me since the day he went. You had better have it.");
inv_add(inv, fenk_obsidian_amulet, 1);
mes("The ghost gives you the obsidian amulet.");
@fenk_gardener_shed_key;

// The shed key. The shed is where the marble half is, and the broom cupboard is inside it - see
// [oploc1,fenk_shed_door] - so the key has to come from somewhere outside the shed, and the man
// who kept the garden is where it came from in the original.
[label,fenk_gardener_shed_key]
if (%fenk_unlocked_shed = 1 | inv_total(inv, fenk_shed_key) > 0) {
    return;
}
if (inv_freespace(inv) = 0) {
    ~chatnpc("<p,neutral>I would give you my key to the shed, if you had a hand free for it.");
    return;
}
~chatnpc("<p,neutral>And you will want this. It is my key to the shed. Nobody has been in there since I died.");
inv_add(inv, fenk_shed_key, 1);
mes("The ghost gives you the shed key.");

// The two halves make the six-pointed star that the memorial in the mausoleum is cut to take.
[opheldu,fenk_obsidian_amulet]
if (last_useitem ! fenk_marble_amulet) {
    ~displaymessage(^dm_default);
    return;
}
@fenk_join_amulet;

[opheldu,fenk_marble_amulet]
if (last_useitem ! fenk_obsidian_amulet) {
    ~displaymessage(^dm_default);
    return;
}
@fenk_join_amulet;

[label,fenk_join_amulet]
inv_del(inv, fenk_obsidian_amulet, 1);
inv_del(inv, fenk_marble_amulet, 1);
inv_add(inv, fenk_star_amulet, 1);
mes("The two triangles lock together into a six-pointed star.");
