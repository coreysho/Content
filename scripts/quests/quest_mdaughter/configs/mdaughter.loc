// The Mountain Camp's tent doors (Mountain Daughter) - Hamal's tent is behind one pair. With no
// handler Open and Close did nothing, so he could not be reached. Ordinary doors, moved here from
// _unpack to join the generic door code.
[mdaughter_tent_door]
name=Tent door
desc=It's barely a door, really.
model=mdaughter_tent_door
ambient=0
active=yes
op1=Open
category=door_closed
param=next_loc_stage,mdaughter_tent_door_open

[mdaughter_tent_door_open]
name=Tent door
desc=It's barely a door, really.
model=mdaughter_tent_door_open
ambient=0
blockwalk=no
active=yes
op1=Close
category=door_opened
param=next_loc_stage,mdaughter_tent_door

[mdaughter_tent_doorl]
name=Tent door
desc=It's barely a door, really.
model=mdaughter_tent_door
ambient=0
mirror=yes
active=yes
op1=Open
category=door_closed
param=next_loc_stage,mdaughter_tent_door_openl

[mdaughter_tent_door_openl]
name=Tent door
desc=It's barely a door, really.
model=mdaughter_tent_door_open
ambient=0
mirror=yes
blockwalk=no
active=yes
op1=Close
category=door_opened
param=next_loc_stage,mdaughter_tent_doorl
