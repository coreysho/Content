[if_button,questlist:tog]
def_string $text;

switch_int (~tog_progress) {
    case ^tog_not_started :
        $text = "@dbl@I can start this quest by finding @dre@Juna@dbl@ in the cave|";
        $text = append($text, "@dbl@below the @dre@Lumbridge Swamp Caves|");
        $text = append($text, "@dbl@I will need @dre@<tostring(^tog_req_questpoints)> Quest Points@dbl@ and a @dre@light source|");
        $text = append($text, "@dbl@and @dre@<tostring(^tog_req_mining)> Mining@dbl@ and @dre@<tostring(^tog_req_crafting)> Crafting@dbl@ for the bowl");

    case ^tog_met_juna :
        $text = "@str@Juna has guarded the place where Guthix wept since before|";
        $text = append($text, "@str@there was anyone to guard it from. She will trade the tears|");
        $text = append($text, "@str@for a story.|");
        $text = append($text, "@dbl@I need to @dre@mine blue stone@dbl@ from the rocks across the chasm.|");
        $text = append($text, "@dbl@A @dre@light@dbl@ held up to the @dre@light creatures@dbl@ will get me over it");

    case ^tog_has_stone :
        $text = "@str@I have a lump of stone with a blue vein through it.|";
        $text = append($text, "@dbl@A @dre@chisel@dbl@ will make it into a bowl");

    case ^tog_has_bowl :
        $text = "@str@The bowl is made.|";
        $text = append($text, "@dbl@I should go back down to @dre@Juna@dbl@ and tell her a story");

    case ^tog_complete :
        $text = "@str@Juna has guarded the place where Guthix wept since the god|";
        $text = append($text, "@str@went to sleep, and she is very bored.|");
        $text = append($text, "@str@I told her what I had been doing and she let me at the|");
        $text = append($text, "@str@weeping walls with a bowl cut from the cave's own stone.|");
        $text = append($text, "@str@Blue tears are worth catching. Green ones are not.||");
        if (~count_questpoints > %tog_qp_before_return) {
            $text = append($text, "@dbl@I have done something new since. @dre@Juna@dbl@ will want to hear it.||");
        } else {
            $text = append($text, "@dbl@She has heard everything I have done. @dre@<tostring(%tog_qp_before_return)> quest points|");
            $text = append($text, "@dbl@was where I left off.||");
        }
        $text = append($text, "@red@QUEST COMPLETE!");

    case default :
        $text = "@dbl@I can start this quest by finding @dre@Juna@dbl@ in the cave|";
        $text = append($text, "@dbl@below the @dre@Lumbridge Swamp Caves");
}

~quest_journal("Tears of Guthix", $text);
