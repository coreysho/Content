// A Soul's Bane - one more bit in soulbane2 (bits 0-13 are the cache's own).
//
// 1 once the player has been into the room their stage is in; back to 0 whenever the stage moves on.
// Launa and the room's opening lines (Tolna's voice) both follow it: the OSRS transcript has her say
// one thing after a room is beaten and another once you have been into the next.
[soulbane_room_entered]
basevar=soulbane2
startbit=14
endbit=14
