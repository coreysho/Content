// A Soul's Bane - the rift and its rooms.
//
// Not one of the rift's monsters is placed in the map data, so every room stocks itself with
// npc_add when the player arrives. The rooms are separate islands of m47_81 (and Tolna's room is
// plane 1 of m46_81): nothing joins them on foot, and every exit is a loc op that teleports.
//
// A monster's death credits whoever npc_findhero names. That runs on the NPC, and soulbane and
// soulbane2 are protected varps it cannot write (nor can it p_teleport or open a chatbox), so a
// death queues a player script that does the bookkeeping. Only the protect=no counters in
// soulbane_unprotected/2 are written straight from a monster's trigger.

// =========================================================================== the rift
// [soulbane_falloff2_rope_multi] is 0 a bare rift and 1 a rift with a rope. Every other rift loc is
// the same hole drawn from a different angle, all with op1=Enter, so they all come here.
[oploc1,soulbane_falloff2_rope_multi] @soulbane_rift_enter;
[oploc1,soulbane_falloff1] @soulbane_rift_enter;
[oploc1,soulbane_falloff2] @soulbane_rift_enter;
[oploc1,soulbane_falloff3] @soulbane_rift_enter;
[oploc1,soulbane_falloff4] @soulbane_rift_enter;
[oploc1,soulbane_falloff5] @soulbane_rift_enter;
[oploc1,soulbane_falloff6] @soulbane_rift_enter;
[oploc1,soulbane_falloff7] @soulbane_rift_enter;
[oploc1,soulbane_falloff8] @soulbane_rift_enter;
[oploc1,soulbane_falloff9] @soulbane_rift_enter;
[oploc1,soulbane_falloff_10] @soulbane_rift_enter;
[oploc1,soulbane_falloff_11] @soulbane_rift_enter;
[oploc1,soulbane_falloff_12] @soulbane_rift_enter;

// "Use the rope on the rift" - the rope is the one item the quest asks for.
[oplocu,soulbane_falloff2_rope_multi] @soulbane_rift_rope;
[oplocu,soulbane_falloff1] @soulbane_rift_rope;
[oplocu,soulbane_falloff2] @soulbane_rift_rope;
[oplocu,soulbane_falloff3] @soulbane_rift_rope;
[oplocu,soulbane_falloff4] @soulbane_rift_rope;
[oplocu,soulbane_falloff5] @soulbane_rift_rope;
[oplocu,soulbane_falloff6] @soulbane_rift_rope;
[oplocu,soulbane_falloff7] @soulbane_rift_rope;
[oplocu,soulbane_falloff8] @soulbane_rift_rope;
[oplocu,soulbane_falloff9] @soulbane_rift_rope;
[oplocu,soulbane_falloff_10] @soulbane_rift_rope;
[oplocu,soulbane_falloff_11] @soulbane_rift_rope;
[oplocu,soulbane_falloff_12] @soulbane_rift_rope;

[label,soulbane_rift_rope]
if (last_useitem ! rope) {
    ~displaymessage(^dm_default);
    return;
}
if (%soulbane_riftrope_pres = ^soulbane_on) {
    mes("There's already a rope tied to the edge of the rift.");
    return;
}
if (%soulbane_prog < ^soulbane_asked) {
    mes("You have no reason to go down there.");
    return;
}
inv_delslot(inv, last_useslot);
%soulbane_riftrope_pres = ^soulbane_on;
mes("You tie the rope firmly to the edge of the rift.");

[label,soulbane_rift_enter]
p_arrivedelay;
if (%soulbane_riftrope_pres = ^soulbane_off) {
    if (%soulbane_prog < ^soulbane_asked) {
        ~mesbox("It's a long way down, and you can't see the bottom.");
        return;
    }
    ~mesbox("It's a long way down. You'll need to tie a rope to the edge before you climb in.");
    return;
}
if_close;
mes("You climb down the rope into the rift.");
p_delay(1);
if (%soulbane_prog >= ^soulbane_complete) {
    p_teleport(^soulbane_dungeon_land);
    return;
}
@soulbane_enter_room(%soulbane_prog);

// The rift's Exits all lead straight back up. soulbane_rope_up is the one in Tolna's rift proper.
// During the quest they ask first (OSRS transcript, "Leaving the room"): whatever room you are in
// is started again next time - "Any incomplete rooms will be restarted" - while a room already
// beaten stays beaten.
[oploc1,soul_bane_awall_void_small] @soulbane_leave_room;
[oploc1,soul_bane_fwall_void_small] @soulbane_leave_room;
[oploc1,soul_bane_cwall_void_small] @soulbane_leave_room;
[oploc1,soul_bane_hwall_void_small] @soulbane_leave_room;
[oploc1,soul_bane_tolna_void_small] @soulbane_leave_room;
[oploc1,soulbane_rope_up] @soulbane_to_surface;

[label,soulbane_leave_room]
p_arrivedelay;
if (%soulbane_prog > ^soulbane_asked & %soulbane_prog < ^soulbane_complete) {
    if (~p_choice2_header("Yes, I don't mind starting this room again.", 1, "No, I'll finish this room first.", 2, "Do you wish to leave?") = 2) {
        return;
    }
    ~soulbane_restart_room;
}
@soulbane_to_surface;

[label,soulbane_to_surface]
p_arrivedelay;
if_close;
~soulbane_drop_anger_weapons;
mes("You climb back up to the surface.");
p_delay(1);
p_teleport(^soulbane_surface_land);

// The room the player's stage is in goes back to the start. The Anger room's rage bar already
// empties every time it is entered.
[proc,soulbane_restart_room]
switch_int (%soulbane_prog) {
    case ^soulbane_fear :
        %soulbane_fear_killedtally = 0;
        %soulbane_fear_monspres = ^soulbane_off;
    case ^soulbane_confusion :
        %soulbane_confu_door1pres = ^soulbane_off;
        %soulbane_confu_door2pres = ^soulbane_off;
        %soulbane_confu_door3pres = ^soulbane_off;
        %soulbane_confu_door4pres = ^soulbane_off;
        %soulbane_confu_door5pres = ^soulbane_off;
        %soulbane_confu_hitcount1 = 0;
        %soulbane_confu_hitcount2 = 0;
        %soulbane_confu_hitcount3 = 0;
        %soulbane_confu_hitcount4 = 0;
    case ^soulbane_hopelessness :
        %soulbane_hope_killedtally = 0;
        %soulbane_hope_monmes = 0;
    case ^soulbane_tolna :
        if (~soulbane_heads_dead = false) {
            %soulbane_final_tol1dead = ^soulbane_off;
            %soulbane_final_tol2dead = ^soulbane_off;
            %soulbane_final_tol3dead = ^soulbane_off;
        }
}

[label,soulbane_enter_room](int $stage)
if ($stage = ^soulbane_asked) {
    %soulbane_prog = ^soulbane_anger;
    %soulbane_room_entered = ^soulbane_off;
    ~send_quest_progress(questlist:soulbane, %soulbane_prog, ^soulbane_complete);
}
switch_int (%soulbane_prog) {
    case ^soulbane_anger : ~soulbane_enter_anger;
    case ^soulbane_fear : ~soulbane_enter_fear;
    case ^soulbane_confusion : ~soulbane_enter_confusion;
    case ^soulbane_hopelessness : ~soulbane_enter_hope;
    case default : ~soulbane_enter_tolna;
}
~soulbane_room_voice;

// Tolna's voice, the first time into each room (OSRS transcript). The Fear room also has the
// player wonder why it isn't dark, every time in.
[proc,soulbane_room_voice]
if (%soulbane_room_entered = ^soulbane_off) {
    %soulbane_room_entered = ^soulbane_on;
    switch_int (%soulbane_prog) {
        case ^soulbane_anger : ~mesbox("Why should I, Tolna, be trapped in such a wretched place?|Arrghh, It's not fair! Feel my ANGER!");
        case ^soulbane_fear : ~mesbox("It's so quiet and dark. I FEAR I may never escape this horrid place.|Mum, Dad, help me!");
        case ^soulbane_confusion : ~mesbox("Where am I? How long have I been here? Am I still the person I once was?|Oh why am I so CONFUSED?");
        case ^soulbane_hopelessness : ~mesbox("What's the point? No-one will ever help me.|I'm not worth anything. Will anyone ever combat my HOPELESSNESS?");
    }
}
if (%soulbane_prog = ^soulbane_fear) {
    ~chatplayer("<p,confused>Hmmm, no light sources. So why can I still see down here? This can't just be a simple dungeon.");
}

// A room is beaten: the stage moves on, and the next room has not been seen yet.
[proc,soulbane_advance](int $stage)
%soulbane_prog = $stage;
%soulbane_room_entered = ^soulbane_off;
~send_quest_progress(questlist:soulbane, %soulbane_prog, ^soulbane_complete);

// =========================================================================== Anger
// The rage bar is soulbane_anger_damagedealt, and it only fills with damage an angry monster takes
// from its own weapon - which is also the only damage it takes at all (~soulbane_anger_maxhit in
// player_melee.rs2, and the [ai_queue2] below for everything that does not go through melee).
[proc,soulbane_enter_anger]
~soulbane_drop_anger_weapons;
%soulbane_anger_damagedealt = 0;
%soulbane_anger_donespecial = ^soulbane_off;
p_teleport(^soulbane_anger_room);
~soulbane_stock_anger;

[proc,soulbane_stock_anger]
if (%soulbane_prog ! ^soulbane_anger | %soulbane_anger_flamepres = ^soulbane_on) {
    return;
}
~soulbane_spawn_once(^soulbane_anger_bear_spot, soulbane_anger_bear, 30);
~soulbane_spawn_once(^soulbane_anger_unicorn_spot, soulbane_anger_unicorn, 30);
~soulbane_spawn_once(^soulbane_anger_rat_spot, soulbane_anger_rat, 30);
~soulbane_spawn_once(^soulbane_anger_goblin_spot, soulbane_anger_goblin, 30);

// One of a kind per room: a second player coming in, or the same one coming back, does not stack
// another copy on top of one that is still there.
[proc,soulbane_spawn_once](coord $at, npc $type, int $range)
if (npc_find($at, $type, $range, ^vis_off) = true) {
    return;
}
npc_add($at, $type, ^soulbane_npc_duration);

// Which rack weapon hurts which monster (OSRS: sword - unicorn, spear - bear, mace - giant rat,
// battleaxe - goblin). null for anything that is not one of the four.
[proc,soulbane_anger_weakness](npc $type)(namedobj)
switch_npc ($type) {
    case soulbane_anger_bear : return(soulbane_anger_spearq);
    case soulbane_anger_unicorn : return(soulbane_anger_swordq);
    case soulbane_anger_rat : return(soulbane_anger_maceq);
    case soulbane_anger_goblin : return(soulbane_anger_axeq);
}
return(null);

// Called from player_melee.rs2 with the swing's max hit: ten times it with the matching weapon
// ("normal damage multiplied by 10"), nothing without it, and untouched for every other npc.
[proc,soulbane_anger_maxhit](int $maxhit)(int)
def_namedobj $weapon = ~soulbane_anger_weakness(npc_type);
if ($weapon = null) {
    return($maxhit);
}
if (inv_total(worn, $weapon) = 0) {
    return(0);
}
return(multiply($maxhit, 10));

[ai_queue2,soulbane_anger_bear] ~soulbane_anger_damage(last_int, soulbane_anger_spearq);
[ai_queue2,soulbane_anger_unicorn] ~soulbane_anger_damage(last_int, soulbane_anger_swordq);
[ai_queue2,soulbane_anger_rat] ~soulbane_anger_damage(last_int, soulbane_anger_maceq);
[ai_queue2,soulbane_anger_goblin] ~soulbane_anger_damage(last_int, soulbane_anger_axeq);

// Every hit on an angry monster ends here - melee, ranged, magic and specials alike - so this is
// where "only its own weapon hurts it" is enforced, and where the rage bar fills.
[proc,soulbane_anger_damage](int $damage, namedobj $weapon)
if (finduid(%npc_aggressive_player) = false) {
    ~npc_default_damage(0);
    return;
}
if (inv_total(worn, $weapon) = 0) {
    ~npc_default_damage(0);
    return;
}
if ($damage > 0 & %soulbane_prog = ^soulbane_anger & %soulbane_anger_donespecial = ^soulbane_off) {
    def_int $before = %soulbane_anger_damagedealt;
    def_int $after = min(add($before, min($damage, npc_stat(hitpoints))), ^soulbane_anger_needed);
    %soulbane_anger_damagedealt = $after;
    if ($after >= ^soulbane_anger_needed) {
        %soulbane_anger_donespecial = ^soulbane_on;
        queue(soulbane_anger_unleash, 1, 0);
    } else if (divide(multiply($after, 4), ^soulbane_anger_needed) > divide(multiply($before, 4), ^soulbane_anger_needed)) {
        mes("You feel your rage building...");
    }
}
~npc_default_damage($damage);

// The rack's four and whoever falls: the next of its kind comes at you while the rage bar is
// still filling. Queued on the hero so the respawn is a moment later rather than the same tick.
[ai_queue3,soulbane_anger_bear] @soulbane_anger_death(1);
[ai_queue3,soulbane_anger_unicorn] @soulbane_anger_death(2);
[ai_queue3,soulbane_anger_rat] @soulbane_anger_death(3);
[ai_queue3,soulbane_anger_goblin] @soulbane_anger_death(4);

[label,soulbane_anger_death](int $which)
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}
if (%soulbane_prog ! ^soulbane_anger | %soulbane_anger_donespecial = ^soulbane_on) {
    return;
}
queue(soulbane_anger_respawn, 4, $which);

[queue,soulbane_anger_respawn](int $which)
if (%soulbane_prog ! ^soulbane_anger | %soulbane_anger_flamepres = ^soulbane_on) {
    return;
}
switch_int ($which) {
    case 1 : ~soulbane_spawn_once(^soulbane_anger_bear_spot, soulbane_anger_bear, 30);
    case 2 : ~soulbane_spawn_once(^soulbane_anger_unicorn_spot, soulbane_anger_unicorn, 30);
    case 3 : ~soulbane_spawn_once(^soulbane_anger_rat_spot, soulbane_anger_rat, 30);
    case 4 : ~soulbane_spawn_once(^soulbane_anger_goblin_spot, soulbane_anger_goblin, 30);
}

// The bar is full: you spin, everything angry in the room drops, 40 Attack experience, and the
// fire in the doorway goes out.
[queue,soulbane_anger_unleash](int $unused)
if (%soulbane_prog ! ^soulbane_anger) {
    return;
}
anim(human_dhsword_spin, 0);
~soulbane_clear_type(coord, soulbane_anger_bear, 30);
~soulbane_clear_type(coord, soulbane_anger_unicorn, 30);
~soulbane_clear_type(coord, soulbane_anger_rat, 30);
~soulbane_clear_type(coord, soulbane_anger_goblin, 30);
stat_advance(attack, 400);
%soulbane_anger_flamepres = ^soulbane_on;
~soulbane_advance(^soulbane_fear);
~mesbox("Your rage boils over! You spin around, and every creature in the cave falls. The fire blocking the way on dies down.");

// Every one of a type near a coord: gone, with its death animation.
[proc,soulbane_clear_type](coord $at, npc $type, int $range)
npc_findall($at, $type, $range, ^vis_off);
while (npc_findnext = true) {
    npc_setmode(none);
    npc_anim(npc_param(death_anim), 0);
    npc_del;
}

// [soulbane_rack_multi] is 0 all four, then 1-4 while that one is out; op1=Take-from is on the
// shell. One weapon at a time: put it back (use it on the rack) to swap.
[oploc1,soulbane_rack_multi]
p_arrivedelay;
if (~soulbane_anger_weapon_held = true) {
    mes("You can only carry one weapon from the rack at a time.");
    return;
}
if (inv_freespace(inv) = 0) {
    mes("You don't have enough inventory space.");
    return;
}
def_int $pick = ~p_choice4("The sword.", 1, "The spear.", 2, "The mace.", 3, "The battleaxe.", 4);
switch_int ($pick) {
    case 1 : @soulbane_take_weapon(soulbane_anger_swordq, ^soulbane_rack_sword);
    case 2 : @soulbane_take_weapon(soulbane_anger_spearq, ^soulbane_rack_spear);
    case 3 : @soulbane_take_weapon(soulbane_anger_maceq, ^soulbane_rack_mace);
    case 4 : @soulbane_take_weapon(soulbane_anger_axeq, ^soulbane_rack_axe);
}

[label,soulbane_take_weapon](namedobj $weapon, int $state)
inv_add(inv, $weapon, 1);
%soulbane_anger_weaponmulti = $state;
mes("You take the <lowercase(oc_name($weapon))> from the rack.");

[oplocu,soulbane_rack_multi]
switch_obj (last_useitem) {
    case soulbane_anger_swordq, soulbane_anger_spearq, soulbane_anger_maceq, soulbane_anger_axeq :
        inv_delslot(inv, last_useslot);
        %soulbane_anger_weaponmulti = ^soulbane_rack_full;
        mes("You put the weapon back on the rack.");
    case default : ~displaymessage(^dm_default);
}

[proc,soulbane_anger_weapon_held]()(boolean)
if (inv_total(inv, soulbane_anger_swordq) > 0 | inv_total(worn, soulbane_anger_swordq) > 0) { return(true); }
if (inv_total(inv, soulbane_anger_spearq) > 0 | inv_total(worn, soulbane_anger_spearq) > 0) { return(true); }
if (inv_total(inv, soulbane_anger_maceq) > 0 | inv_total(worn, soulbane_anger_maceq) > 0) { return(true); }
if (inv_total(inv, soulbane_anger_axeq) > 0 | inv_total(worn, soulbane_anger_axeq) > 0) { return(true); }
return(false);

// The rack's weapons do not leave the Anger room.
[proc,soulbane_drop_anger_weapons]
def_obj $wielded = inv_getobj(worn, ^wearpos_rhand);
inv_del(inv, soulbane_anger_swordq, 28);
inv_del(inv, soulbane_anger_spearq, 28);
inv_del(inv, soulbane_anger_maceq, 28);
inv_del(inv, soulbane_anger_axeq, 28);
inv_del(worn, soulbane_anger_swordq, 1);
inv_del(worn, soulbane_anger_spearq, 1);
inv_del(worn, soulbane_anger_maceq, 1);
inv_del(worn, soulbane_anger_axeq, 1);
if ($wielded ! null & inv_getobj(worn, ^wearpos_rhand) ! $wielded) {
    ~update_all($wielded); // bonuses, attack styles and appearance follow the empty hand
}
%soulbane_anger_weaponmulti = ^soulbane_rack_full;

// The way on is soul_bane_awall_void_exit behind the fire ("To the next area!"); the fire itself
// has no op and, being a multiloc, never blocked anything on the server.
[oploc1,soul_bane_awall_void_exit]
p_arrivedelay;
if (%soulbane_prog < ^soulbane_fear) {
    mes("The fire is far too hot to get past.");
    return;
}
if_close;
~soulbane_drop_anger_weapons;
mes("You step through into the next cave.");
p_delay(1);
~soulbane_enter_fear;
~soulbane_room_voice;

// =========================================================================== Fear
// Six dark holes line the walls. One of them - soulbane_fear_enemydoor, 1-6 - has a fear reaper in
// it, and which one moves after every kill. Five reapers and the black hole to the west lights up.
[proc,soulbane_enter_fear]
p_teleport(^soulbane_fear_room);
%soulbane_fear_monspres = ^soulbane_off;
if (%soulbane_fear_enemydoor < 1 | %soulbane_fear_enemydoor > ^soulbane_fear_holes) {
    %soulbane_fear_enemydoor = calc(random(^soulbane_fear_holes) + 1);
}

[oploc1,soul_bane_fwall_void] @soulbane_fear_hole(1);
[oploc1,soul_bane_fwall_void2] @soulbane_fear_hole(2);
[oploc1,soul_bane_fwall_void3] @soulbane_fear_hole(3);
[oploc1,soul_bane_fwall_void4] @soulbane_fear_hole(4);
[oploc1,soul_bane_fwall_void5] @soulbane_fear_hole(5);
[oploc1,soul_bane_fwall_void6] @soulbane_fear_hole(6);

[label,soulbane_fear_hole](int $hole)
p_arrivedelay;
if (%soulbane_prog ! ^soulbane_fear) {
    mes("You peer into the hole. There's nothing in there.");
    return;
}
if (%soulbane_fear_monspres = ^soulbane_on & npc_find(coord, soulbane_fear_reaper, 30, ^vis_off) = true) {
    mes("You'd better deal with the one that's already out first.");
    return;
}
if (%soulbane_fear_enemydoor < 1 | %soulbane_fear_enemydoor > ^soulbane_fear_holes) {
    %soulbane_fear_enemydoor = calc(random(^soulbane_fear_holes) + 1);
}
if ($hole ! %soulbane_fear_enemydoor) {
    mes("You peer into the hole. There's nothing in there.");
    return;
}
npc_add(~soulbane_fear_hole_spot($hole), soulbane_fear_reaper, ^soulbane_npc_duration);
npc_setmode(opplayer2);
%soulbane_fear_monspres = ^soulbane_on;
mes("Something leaps out of the darkness at you!");

[proc,soulbane_fear_hole_spot](int $hole)(coord)
switch_int ($hole) {
    case 1 : return(^soulbane_fear_hole1);
    case 2 : return(^soulbane_fear_hole2);
    case 3 : return(^soulbane_fear_hole3);
    case 4 : return(^soulbane_fear_hole4);
    case 5 : return(^soulbane_fear_hole5);
}
return(^soulbane_fear_hole6);

[ai_queue3,soulbane_fear_reaper]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}
if (%soulbane_prog ! ^soulbane_fear) {
    return;
}
%soulbane_fear_monspres = ^soulbane_off;
queue(soulbane_fear_kill, 0, 0);

// soulbane is a protected varp, so the tally is kept here on the player rather than in the
// reaper's death trigger.
[queue,soulbane_fear_kill](int $unused)
if (%soulbane_prog ! ^soulbane_fear) {
    return;
}
%soulbane_fear_killedtally = min(add(%soulbane_fear_killedtally, 1), ^soulbane_fear_needed);
def_int $tally = %soulbane_fear_killedtally;
// the next one hides somewhere else: any hole but this one
def_int $next = calc(random(sub(^soulbane_fear_holes, 1)) + 1);
if ($next >= %soulbane_fear_enemydoor) {
    $next = add($next, 1);
}
%soulbane_fear_enemydoor = $next;
// what the player says after each kill (OSRS transcript - overheads)
switch_int ($tally) {
    case 1 : say("I don't like looking in these holes but I must!");
    case 2 : say("I don't feel quite so afraid now.");
    case 3 : say("These holes aren't that spooky.");
    case 4 : say("This isn't so scary after all!");
}
if ($tally < ^soulbane_fear_needed) {
    return;
}
// [soulbane_fwall_exit_multi] is the ordinary way round: 0 closed, 1 open.
%soulbane_fear_exitlit = ^soulbane_on;
~soulbane_advance(^soulbane_confusion);
~chatplayer("<p,happy>Phew, I don't feel so scared now. This feels like the figment of someone's imagination!");
mes("What's that?");

[oploc1,soulbane_fwall_exit_multi]
p_arrivedelay;
if (%soulbane_fear_exitlit = ^soulbane_off) {
    mes("There's no way you're going in there!");
    return;
}
if_close;
mes("You step into the black hole.");
p_delay(1);
~soulbane_enter_confusion;
~soulbane_room_voice;

// =========================================================================== Confusion
// Five confusion beasts, one of them real (soulbane_confu_creeper) and four illusions (fake1-4).
// An illusion takes no damage and does none; eight hits and it fades (confu_hitcountN). The real
// one's death makes one of the five confusing doors vanish, and a fresh five appear. When all five
// have gone, the sixth door - the one left standing - is the way on.
[proc,soulbane_enter_confusion]
p_teleport(^soulbane_confu_room);
~soulbane_stock_confusion;

[proc,soulbane_stock_confusion]
if (%soulbane_prog ! ^soulbane_confusion | %soulbane_confu_door6open = ^soulbane_on) {
    return;
}
if (npc_find(^soulbane_confu_room, soulbane_confu_creeper, 30, ^vis_off) = true) {
    return;
}
~soulbane_confu_round;

[proc,soulbane_confu_round]
~soulbane_clear_type(^soulbane_confu_room, soulbane_confu_creeper_fake1, 30);
~soulbane_clear_type(^soulbane_confu_room, soulbane_confu_creeper_fake2, 30);
~soulbane_clear_type(^soulbane_confu_room, soulbane_confu_creeper_fake3, 30);
~soulbane_clear_type(^soulbane_confu_room, soulbane_confu_creeper_fake4, 30);
%soulbane_confu_hitcount1 = 0;
%soulbane_confu_hitcount2 = 0;
%soulbane_confu_hitcount3 = 0;
%soulbane_confu_hitcount4 = 0;
// the real one takes a different spot each round, and the illusions the rest
def_int $real = random(5);
npc_add(~soulbane_confu_spot($real), soulbane_confu_creeper, ^soulbane_npc_duration);
npc_add(~soulbane_confu_spot(modulo(add($real, 1), 5)), soulbane_confu_creeper_fake1, ^soulbane_npc_duration);
npc_add(~soulbane_confu_spot(modulo(add($real, 2), 5)), soulbane_confu_creeper_fake2, ^soulbane_npc_duration);
npc_add(~soulbane_confu_spot(modulo(add($real, 3), 5)), soulbane_confu_creeper_fake3, ^soulbane_npc_duration);
npc_add(~soulbane_confu_spot(modulo(add($real, 4), 5)), soulbane_confu_creeper_fake4, ^soulbane_npc_duration);

[proc,soulbane_confu_spot](int $i)(coord)
switch_int ($i) {
    case 0 : return(^soulbane_confu_spot1);
    case 1 : return(^soulbane_confu_spot2);
    case 2 : return(^soulbane_confu_spot3);
    case 3 : return(^soulbane_confu_spot4);
}
return(^soulbane_confu_spot5);

[ai_queue2,soulbane_confu_creeper_fake1] ~soulbane_confu_illusion_hit(1);
[ai_queue2,soulbane_confu_creeper_fake2] ~soulbane_confu_illusion_hit(2);
[ai_queue2,soulbane_confu_creeper_fake3] ~soulbane_confu_illusion_hit(3);
[ai_queue2,soulbane_confu_creeper_fake4] ~soulbane_confu_illusion_hit(4);

[proc,soulbane_confu_illusion_hit](int $which)
~npc_default_damage(0);
if (finduid(%npc_aggressive_player) = false) {
    return;
}
def_int $hits = add(~soulbane_confu_hits($which), 1);
switch_int ($which) {
    case 1 : %soulbane_confu_hitcount1 = min($hits, 15);
    case 2 : %soulbane_confu_hitcount2 = min($hits, 15);
    case 3 : %soulbane_confu_hitcount3 = min($hits, 15);
    case 4 : %soulbane_confu_hitcount4 = min($hits, 15);
}
if ($hits >= ^soulbane_confu_illusion_hits) {
    mes("The beast fades away - it was only an illusion!");
    npc_setmode(none);
    npc_del;
}

[proc,soulbane_confu_hits](int $which)(int)
switch_int ($which) {
    case 1 : return(%soulbane_confu_hitcount1);
    case 2 : return(%soulbane_confu_hitcount2);
    case 3 : return(%soulbane_confu_hitcount3);
}
return(%soulbane_confu_hitcount4);

// An illusion swings, but nothing it does lands.
[ai_opplayer2,soulbane_confu_creeper_fake1] ~soulbane_confu_illusion_attack;
[ai_opplayer2,soulbane_confu_creeper_fake2] ~soulbane_confu_illusion_attack;
[ai_opplayer2,soulbane_confu_creeper_fake3] ~soulbane_confu_illusion_attack;
[ai_opplayer2,soulbane_confu_creeper_fake4] ~soulbane_confu_illusion_attack;

[proc,soulbane_confu_illusion_attack]
if (%death = ^true) {
    npc_setmode(null);
    return;
}
if (%npc_action_delay > map_clock) return;
if (~npc_check_notcombat = false) {
    npc_setmode(null);
    return;
}
if (~npc_check_notcombat_self = false) {
    return;
}
anim(%com_defendanim, 0);
npc_anim(npc_param(attack_anim), 0);
~playerhit_n_melee(0, npc_param(attackrate));

[ai_queue3,soulbane_confu_creeper_fake1] gosub(npc_death);
[ai_queue3,soulbane_confu_creeper_fake2] gosub(npc_death);
[ai_queue3,soulbane_confu_creeper_fake3] gosub(npc_death);
[ai_queue3,soulbane_confu_creeper_fake4] gosub(npc_death);

[ai_queue3,soulbane_confu_creeper]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}
if (%soulbane_prog ! ^soulbane_confusion) {
    return;
}
queue(soulbane_confu_kill, 2, 0);

// the next door in line vanishes (the shells draw a door only while their varbit is 0)
[queue,soulbane_confu_kill](int $unused)
if (%soulbane_prog ! ^soulbane_confusion) {
    return;
}
if (%soulbane_confu_door1pres = ^soulbane_off) {
    %soulbane_confu_door1pres = ^soulbane_on;
} else if (%soulbane_confu_door2pres = ^soulbane_off) {
    %soulbane_confu_door2pres = ^soulbane_on;
} else if (%soulbane_confu_door3pres = ^soulbane_off) {
    %soulbane_confu_door3pres = ^soulbane_on;
} else if (%soulbane_confu_door4pres = ^soulbane_off) {
    %soulbane_confu_door4pres = ^soulbane_on;
} else {
    %soulbane_confu_door5pres = ^soulbane_on;
}
~soulbane_confu_progress(~soulbane_confu_doors_gone);

[proc,soulbane_confu_doors_gone]()(int)
def_int $n = 0;
if (%soulbane_confu_door1pres = ^soulbane_on) { $n = calc($n + 1); }
if (%soulbane_confu_door2pres = ^soulbane_on) { $n = calc($n + 1); }
if (%soulbane_confu_door3pres = ^soulbane_on) { $n = calc($n + 1); }
if (%soulbane_confu_door4pres = ^soulbane_on) { $n = calc($n + 1); }
if (%soulbane_confu_door5pres = ^soulbane_on) { $n = calc($n + 1); }
return($n);

[proc,soulbane_confu_progress](int $gone)
if ($gone < ^soulbane_confu_doors) {
    mes("One of the doors vanishes, and the beasts appear again.");
    ~soulbane_confu_round;
    return;
}
~soulbane_clear_type(^soulbane_confu_room, soulbane_confu_creeper_fake1, 30);
~soulbane_clear_type(^soulbane_confu_room, soulbane_confu_creeper_fake2, 30);
~soulbane_clear_type(^soulbane_confu_room, soulbane_confu_creeper_fake3, 30);
~soulbane_clear_type(^soulbane_confu_room, soulbane_confu_creeper_fake4, 30);
%soulbane_confu_door6open = ^soulbane_on;
~soulbane_advance(^soulbane_hopelessness);
~mesbox("The last of the false doors vanishes. Only one door is left - that must be the way on.");

[oploc1,soulbane_door_multi1] @soulbane_confu_false_door;
[oploc1,soulbane_door_multi2] @soulbane_confu_false_door;
[oploc1,soulbane_door_multi3] @soulbane_confu_false_door;
[oploc1,soulbane_door_multi4] @soulbane_confu_false_door;
[oploc1,soulbane_door_multi5] @soulbane_confu_false_door;

[label,soulbane_confu_false_door]
p_arrivedelay;
mes("The door won't open. You're not even sure it's really there.");

[oploc1,soulbane_door_multi6]
p_arrivedelay;
if (%soulbane_confu_door6open = ^soulbane_off) {
    mes("The door won't open. You're not even sure it's really there.");
    return;
}
if_close;
mes("You step through the door.");
p_delay(1);
~soulbane_enter_hope;
~soulbane_room_voice;

// =========================================================================== Hopelessness
// Five hopeless creatures, each of which has to be put down three times: form 1
// (soulbane_hope_monst3, full size, fights from range), then smaller and smaller (monst2, monst1).
// hope_killedtally counts form kills, 15 in all. Then the Bridge of Hope, and the way on beyond it.
[proc,soulbane_enter_hope]
p_teleport(^soulbane_hope_room);
~soulbane_stock_hope;

[proc,soulbane_stock_hope]
if (%soulbane_prog ! ^soulbane_hopelessness) {
    return;
}
if (npc_find(^soulbane_hope_room, soulbane_hope_monst3, 30, ^vis_off) = true
    | npc_find(^soulbane_hope_room, soulbane_hope_monst2, 30, ^vis_off) = true
    | npc_find(^soulbane_hope_room, soulbane_hope_monst1, 30, ^vis_off) = true) {
    return;
}
npc_add(^soulbane_hope_spot1, soulbane_hope_monst3, ^soulbane_npc_duration);
npc_add(^soulbane_hope_spot2, soulbane_hope_monst3, ^soulbane_npc_duration);
npc_add(^soulbane_hope_spot3, soulbane_hope_monst3, ^soulbane_npc_duration);
npc_add(^soulbane_hope_spot4, soulbane_hope_monst3, ^soulbane_npc_duration);
npc_add(^soulbane_hope_spot5, soulbane_hope_monst3, ^soulbane_npc_duration);

// form 1 fights from range
[ai_opplayer2,soulbane_hope_monst3] npc_setmode(applayer2);
[ai_applayer2,soulbane_hope_monst3] ~npc_rangeattack;

[ai_queue3,soulbane_hope_monst3] @soulbane_hope_death(soulbane_hope_monst2);
[ai_queue3,soulbane_hope_monst2] @soulbane_hope_death(soulbane_hope_monst1);
[ai_queue3,soulbane_hope_monst1] @soulbane_hope_death(null);

[label,soulbane_hope_death](npc $next)
def_coord $at = npc_coord;
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}
if (%soulbane_prog ! ^soulbane_hopelessness) {
    return;
}
if ($next ! null & add(%soulbane_hope_killedtally, 1) < ^soulbane_hope_needed) {
    // it shrinks and comes again
    npc_add($at, $next, ^soulbane_npc_duration);
    npc_setmode(opplayer2);
}
if ($next = null) {
    queue(soulbane_hope_kill, 0, 1); // the smallest form: that creature is gone for good
} else {
    queue(soulbane_hope_kill, 0, 0);
}

// soulbane is a protected varp: the tally is kept on the player, not in the death trigger.
// soulbane_hope_monmes counts the creatures put down for good (all three forms), which is what
// the player's remarks follow (OSRS transcript - overheads, one per creature).
[queue,soulbane_hope_kill](int $gone)
if (%soulbane_prog ! ^soulbane_hopelessness) {
    return;
}
%soulbane_hope_killedtally = min(add(%soulbane_hope_killedtally, 1), ^soulbane_hope_needed);
if (%soulbane_hope_killedtally < ^soulbane_hope_needed) {
    if ($gone = 1 & %soulbane_hope_monmes < 4) {
        %soulbane_hope_monmes = add(%soulbane_hope_monmes, 1);
        switch_int (%soulbane_hope_monmes) {
            case 1 : say("Is there any end to killing these monsters?");
            case 2 : say("This is hard work!");
            case 3 : say("I've almost killed them all now!");
            case 4 : say("Maybe if I kill one more?");
        }
    }
    return;
}
~soulbane_clear_type(^soulbane_hope_room, soulbane_hope_monst3, 30);
~soulbane_clear_type(^soulbane_hope_room, soulbane_hope_monst2, 30);
~soulbane_clear_type(^soulbane_hope_room, soulbane_hope_monst1, 30);
%soulbane_hope_bridgepres = ^soulbane_on;
~soulbane_advance(^soulbane_tolna);
~chatplayer("<p,happy>A bridge of hope! Tolna should feel that help is at hand by now!");

// soul_bane_hwall_void_exit, on the far side of the bridge: "I think it's the forward."
[oploc1,soul_bane_hwall_void_exit]
p_arrivedelay;
if (%soulbane_prog < ^soulbane_tolna) {
    mes("What's the point? You'll never get anywhere in here.");
    return;
}
if_close;
mes("You step through into the passage.");
p_delay(1);
~soulbane_enter_tolna;

// =========================================================================== Tolna
// The last room, plane 1 of m46_81 - the one shaped like a brain. Brana has got here first and
// found his son: Tolna is the three-headed thing rising out of the chasm (soulbane_final_tolna1-3,
// "Is that really Tolna?"). The first time in, the two of them have it out (the OSRS "Finding
// Tolna" scene) before the heads turn on you; then all three at once, in a multicombat room
// (maps/multiway.csv). With the last head down Tolna is himself again, on the narrow path into the
// chasm, and talking to him takes the three of you back up.
//
// Brana's lines are chat with his head (the wiki's screenshot of the scene); Tolna has no chathead
// in this form, so what he says is told as a plain statement.
[proc,soulbane_enter_tolna]
p_teleport(^soulbane_tolna_room);
if (%soulbane_prog ! ^soulbane_tolna) {
    return;
}
%soulbane_room_entered = ^soulbane_on;
~soulbane_stock_tolna;
if (%soulbane_final_seencut = ^soulbane_off & ~soulbane_heads_dead = false) {
    p_delay(1);
    ~soulbane_final_cutscene;
}

[proc,soulbane_stock_tolna]
if (%soulbane_prog ! ^soulbane_tolna) {
    return;
}
~soulbane_spawn_once(^soulbane_brana_spot, soulbane_brana, 20);
if (~soulbane_heads_dead = true) {
    ~soulbane_spawn_once(^soulbane_tolna_spot, soulbane_tolna_top, 20);
    return;
}
// Until the scene has played the heads don't hunt (huntrange 0), so nothing is thrown at a player
// who is still reading.
def_boolean $quiet = false;
if (%soulbane_final_seencut = ^soulbane_off) {
    $quiet = true;
}
if (%soulbane_final_tol1dead = ^soulbane_off) {
    ~soulbane_spawn_head(^soulbane_tolna_head1_spot, soulbane_final_tolna1, $quiet);
}
if (%soulbane_final_tol2dead = ^soulbane_off) {
    ~soulbane_spawn_head(^soulbane_tolna_head2_spot, soulbane_final_tolna2, $quiet);
}
if (%soulbane_final_tol3dead = ^soulbane_off) {
    ~soulbane_spawn_head(^soulbane_tolna_head3_spot, soulbane_final_tolna3, $quiet);
}

[proc,soulbane_spawn_head](coord $at, npc $type, boolean $quiet)
if (npc_find($at, $type, 20, ^vis_off) = true) {
    return;
}
npc_add($at, $type, ^soulbane_npc_duration);
if ($quiet = true) {
    npc_sethunt(0);
}

// Back to the heads' own huntrange (all.npc, 12), and straight at the player in the room.
[proc,soulbane_heads_wake]
~soulbane_head_wake(soulbane_final_tolna1);
~soulbane_head_wake(soulbane_final_tolna2);
~soulbane_head_wake(soulbane_final_tolna3);

[proc,soulbane_head_wake](npc $type)
if (npc_find(^soulbane_tolna_room, $type, 20, ^vis_off) = true) {
    npc_sethunt(12);
    npc_setmode(opplayer2);
}

// "Finding Tolna" (OSRS wiki transcript), word for word.
[proc,soulbane_final_cutscene]
~chatnpc_specific("Brana", soulbane_brana, "<p,shock>Son! Is that you?");
~chatnpc_specific("Brana", soulbane_brana, "<p,sad>Please speak to me! Tolna?");
~mesbox("Why should I speak to you? Besides, I'm no longer the boy you once knew.");
~chatnpc_specific("Brana", soulbane_brana, "<p,confused>What do you mean?");
~chatnpc_specific("Brana", soulbane_brana, "<p,sad>You'll always be my son!");
~mesbox("No. Something evil in this dungeon has morphed my body and mind.");
~chatnpc_specific("Brana", soulbane_brana, "<p,neutral>There must be a way.");
~chatnpc_specific("Brana", soulbane_brana, "<p,neutral>Don't give up so easily!");
~mesbox("Don't give up? You had your chance to help me, 25 years it's taken you!");
~chatnpc_specific("Brana", soulbane_brana, "<p,sad>Sorry, but your mother and I...");
~chatnpc_specific("Brana", soulbane_brana, "<p,sad>tried so hard to find you!");
~mesbox("Lies!");
~mesbox("Ah, we have a visitor!");
~chatplayer("<p,angry>Your father isn't lying.");
~mesbox("Hah! If that's the way you think, then you shall both die!");
if_close;
%soulbane_final_seencut = ^soulbane_on;
~soulbane_heads_wake;

[proc,soulbane_heads_dead]()(boolean)
if (%soulbane_final_tol1dead = ^soulbane_on & %soulbane_final_tol2dead = ^soulbane_on & %soulbane_final_tol3dead = ^soulbane_on) {
    return(true);
}
return(false);

// The heads never move: they shoot from where they are, and the northern one bites anyone who
// comes close. Attack speeds are OSRS's: southern 7 ranged / 8 melee, eastern 5 ranged only,
// northern 20 ranged / 3 melee.
[ai_opplayer2,soulbane_final_tolna1] npc_setmode(applayer2);
[ai_opplayer2,soulbane_final_tolna2] npc_setmode(applayer2);
[ai_opplayer2,soulbane_final_tolna3] npc_setmode(applayer2);
[ai_applayer2,soulbane_final_tolna1] ~soulbane_head_attack(8, 7);
[ai_applayer2,soulbane_final_tolna2] ~soulbane_head_attack(0, 5);
[ai_applayer2,soulbane_final_tolna3] ~soulbane_head_attack(3, 20);

[proc,soulbane_head_attack](int $melee_rate, int $range_rate)
if (%death = ^true) {
    npc_setmode(null);
    return;
}
if (%npc_action_delay > map_clock) {
    return;
}
if ($melee_rate > 0 & npc_range(coord) <= 1) {
    if (~npc_check_notcombat = false) {
        npc_setmode(null);
        return;
    }
    if (~npc_check_notcombat_self = false) {
        return;
    }
    anim(%com_defendanim, 0);
    npc_anim(neckattack, 0);
    ~npc_meleeattack;
    %npc_action_delay = add(map_clock, $melee_rate);
    return;
}
def_int $before = %npc_action_delay;
~npc_rangeattack;
if (%npc_action_delay ! $before) {
    %npc_action_delay = add(map_clock, $range_rate);
}

[ai_queue3,soulbane_final_tolna1] @soulbane_head_death(1);
[ai_queue3,soulbane_final_tolna2] @soulbane_head_death(2);
[ai_queue3,soulbane_final_tolna3] @soulbane_head_death(3);

[label,soulbane_head_death](int $head)
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}
if (%soulbane_prog ! ^soulbane_tolna) {
    return;
}
queue(soulbane_head_kill, 0, $head);

// "After defeating Tolna's body - Tolna's human body appears on the narrow path."
[queue,soulbane_head_kill](int $head)
if (%soulbane_prog ! ^soulbane_tolna) {
    return;
}
switch_int ($head) {
    case 1 : %soulbane_final_tol1dead = ^soulbane_on;
    case 2 : %soulbane_final_tol2dead = ^soulbane_on;
    case 3 : %soulbane_final_tol3dead = ^soulbane_on;
}
if (~soulbane_heads_dead = false) {
    return;
}
~soulbane_spawn_once(^soulbane_tolna_spot, soulbane_tolna_top, 20);

// Tolna in the rift, himself again ("Talking to human Tolna"). At the end the three of you are
// taken up to the surface, where Tolna now stands by the rift (soulbane_tolna_pres) and Launa -
// gone home with Brana, as Tolna says - is not (soulbane_launa_pres; her multinpc draws her at 0).
[opnpc1,soulbane_tolna_top]
if (%soulbane_prog ! ^soulbane_tolna | ~soulbane_heads_dead = false) {
    mes("Tolna doesn't seem interested in talking right now.");
    return;
}
~chatplayer("<p,quiz>Tolna?");
~chatnpc("<p,confused>Sorry? What happened?");
~chatplayer("<p,neutral>You've been trapped down here for years. I've come to rescue you on behalf of your parents.");
~chatnpc("<p,neutral>Oh yeah. I was looking for the legacy of a civilisation that used to live down here.");
~chatnpc_specific("Brana", soulbane_brana, "<p,happy>Son!");
~chatnpc("<p,sad>Father? Oh, I'm so sorry, can you ever forgive me?");
~chatnpc_specific("Brana", soulbane_brana, "<p,happy>Don't worry, I'm just glad you're back to yourself. Are you OK?");
~chatnpc("<p,neutral>I'm fine, my memories are slowly returning. How's mother?");
~chatnpc_specific("Brana", soulbane_brana, "<p,sad>She misses you dearly!");
~chatnpc("<p,quiz>Where is she?");
~chatplayer("<p,neutral>She's up at the surface waiting for you.");
~chatnpc_specific("Brana", soulbane_brana, "<p,happy>Thank you traveller, I'm glad my wife and I never gave up hope. We should return to her and tell her the good news.");
~chatnpc("<p,happy>Thank you so much. I truly owe you for your help.");
~chatplayer("<p,happy>I'm just glad I could help.");
if_close;
%soulbane_tolna_pres = ^soulbane_on;
%soulbane_launa_pres = ^soulbane_on;
p_delay(1);
p_teleport(^soulbane_surface_land);

// Brana ("Talking to Brana", and after the heads fall).
[opnpc1,soulbane_brana]
if (%soulbane_prog = ^soulbane_tolna & ~soulbane_heads_dead = true) {
    ~chatplayer("<p,happy>I think I've saved your son.");
    ~chatnpc("<p,neutral>Please talk to him, make sure he's OK!");
    return;
}
~chatplayer("<p,quiz>Are you ok?");
~chatnpc("<p,shock>Please! You must help my son! He's beyond sense.");
~chatplayer("<p,quiz>But how can I help?");
~chatnpc("<p,neutral>I take it you have travelled through the mental dilemmas of my son, as I have.");
~chatplayer("<p,neutral>That's correct.");
~chatnpc("<p,neutral>Now you must do what I cannot, conquer the physical dilemma!");
~chatplayer("<p,neutral>I will try.");
~chatnpc("<p,happy>Thank you stranger.");
