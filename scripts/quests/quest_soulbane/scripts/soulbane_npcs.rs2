// A Soul's Bane - Launa beside the rift, and Tolna once he is out.
//
// [soulbane_launa_multi] is multinpc=0,soulbane_launa - index 0 only - so Launa is present while
// soulbane_launa_pres is 0, which it always is. [soulbane_tolna_multi] is multinpc=1,soulbane_tolna_top
// and nothing else, so Tolna shows on the grass at soulbane_tolna_pres=1 only - set when he climbs
// out of the rift with you (quest_soulbane.rs2).

[opnpc1,soulbane_launa_multi]
switch_int (%soulbane_prog) {
    case ^soulbane_not_started : @soulbane_launa_start;
    case ^soulbane_asked : @soulbane_launa_rope;
    case ^soulbane_complete :
        ~chatnpc("<p,happy>I have my husband and my son back. I can't thank you enough.");
        ~chatnpc("<p,neutral>Tolna says the creatures down there are still fair game for anyone who wants to test their mettle. Just mind you come back up again.");
    case default : @soulbane_launa_progress;
}

[label,soulbane_launa_start]
~chatnpc("<p,sad>Please, be careful around that rift.");
switch_int (~p_choice2("What happened here?", 1, "Don't worry, I'll keep well away.", 2)) {
    case 2 :
        ~chatplayer("<p,neutral>Don't worry, I'll keep well away.");
        ~chatnpc("<p,sad>If only my husband had done the same.");
        return;
    case 1 :
        ~chatplayer("<p,quiz>What happened here?");
}
~chatnpc("<p,sad>The ground just split open a few months ago. I've been sitting here watching it ever since.");
~chatnpc("<p,sad>Twenty-five years ago my son Tolna went off hunting for the ruins of some ancient civilisation. He never came home.");
~chatnpc("<p,sad>When the rift opened, my husband Brana was certain Tolna was down there. He climbed in after him days ago, and he hasn't come back either.");
switch_int (~p_choice2("I could go down there and look for them.", 1, "I'm sorry to hear that.", 2)) {
    case 2 :
        ~chatplayer("<p,neutral>I'm sorry to hear that.");
        ~chatnpc("<p,sad>So am I.");
        return;
    case 1 :
        ~chatplayer("<p,neutral>I could go down there and look for them.");
}
~chatnpc("<p,shock>Would you really? Nobody else has dared.");
~chatnpc("<p,neutral>You'll need a rope. Tie it to the edge of the rift and climb down - and please, bring them home.");
%soulbane_prog = ^soulbane_asked;
%soulbane_warning_pres = ^soulbane_on;
~send_quest_progress(questlist:soulbane, %soulbane_prog, ^soulbane_complete);

[label,soulbane_launa_rope]
if (%soulbane_riftrope_pres = ^soulbane_off) {
    ~chatnpc("<p,sad>You'll need a rope tied to the edge of the rift to climb down.");
    return;
}
~chatnpc("<p,sad>The rope's secure. Please find them.");

[label,soulbane_launa_progress]
if (%soulbane_prog = ^soulbane_tolna & %soulbane_tolna_pres = ^soulbane_on) {
    ~chatnpc("<p,happy>Tolna! Brana! You found them! Go on, talk to my son - he has something to say to you.");
    return;
}
switch_int (%soulbane_prog) {
    case ^soulbane_anger : ~chatnpc("<p,sad>Tolna always did have a temper. Please, keep looking.");
    case ^soulbane_fear : ~chatnpc("<p,sad>You look shaken. Is there any sign of them?");
    case ^soulbane_confusion : ~chatnpc("<p,sad>Please don't give up on them.");
    case ^soulbane_hopelessness : ~chatnpc("<p,sad>I've waited twenty-five years. I can wait a little longer.");
    case ^soulbane_tolna : ~chatnpc("<p,sad>You've been so far down. Are they alive?");
}

// =========================================================================== Tolna
// He only renders here at soulbane_tolna_pres=1, which the climb out of the rift sets, and the
// quest completes when you talk to him - "talk again [on the surface] to complete the quest".
[opnpc1,soulbane_tolna_multi]
if (%soulbane_prog >= ^soulbane_complete) {
    ~chatnpc("<p,neutral>I'll keep an eye on the rift. Whatever was in there left a lot of creatures behind - good practice for anyone brave enough.");
    return;
}
if (%soulbane_prog ! ^soulbane_tolna | %soulbane_tolna_pres = ^soulbane_off) {
    return;
}
~chatnpc("<p,happy>Thank you, adventurer. If it weren't for you I'd still be down there, and so would my father.");
~chatnpc("<p,sad>I should have listened to my parents. I went looking for the remains of an ancient people, and the ground opened up and swallowed me.");
~chatnpc("<p,neutral>There was something down there with me - something old and powerful, watching. It fed on everything bad in me until that was all I was.");
~chatplayer("<p,neutral>It's over now. Your mother has waited a long time for you.");
~chatnpc("<p,happy>I know. I'm not going anywhere again.");
if_close;
@soulbane_finish;

[label,soulbane_finish]
%soulbane_prog = ^soulbane_complete;
// The rope stays: the rift goes on to Tolna's rift, the training dungeon, from now on. The warning
// signs come down - there is nothing left down there anybody needs warning about.
%soulbane_warning_pres = ^soulbane_off;
stat_advance(defence, 5000);
stat_advance(hitpoints, 5000);
session_log(^log_adventure, "Quest complete: A Soul's Bane");
if (inv_itemspace(inv, coins, 500, inv_size(inv)) = true) {
    inv_add(inv, coins, 500);
} else {
    obj_add(coord, coins, 500, ^lootdrop_duration);
}
~send_quest_complete(questlist:soulbane, coins, 250, ^soulbane_questpoints, "You have completed\\nA Soul's Bane!", "500 Defence XP|500 Hitpoints XP|500 Coins|Access to Tolna's rift");

// =========================================================================== the warning sign
// [soulbane_warning_sign_multi] is 0 grass and 1 the sign, op1=Read on the shell. Launa puts it up
// when you agree to go down and it comes down when the rift is safe.
[oploc1,soulbane_warning_sign_multi]
p_arrivedelay;
if (%soulbane_warning_pres = ^soulbane_off) {
    mes("Why do I never take time to look at the grass?");
    return;
}
~mesbox("DANGER! Keep away from the rift!");
