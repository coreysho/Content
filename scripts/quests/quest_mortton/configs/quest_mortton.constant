// ============================================================================
// Added when the quest was scripted. Everything above this line is the original
// file and is left exactly as it was: the block at the top is the BIT INDEX map
// for %morttonmulti (used with testbit/setbit, not as varbits - only pyre_loc,
// temple_resources and shadeattack are declared in all.varbit), and the stage
// list is the quest's own flow, which the scripts follow rather than replace.
// ============================================================================
//
// None of the five varps had scope=perm. Only temple_repaired_p ships with
// transmit=yes, and nothing anywhere keys a multiloc or multinpc on any of them
// - checked every loc and npc config - so the temple is driven by loc_change
// and that transmit is for an interface, not a multi.
//
// ---------------------------------------------------------------- the cured NPCs
// razmire_keelgan and ulsquire_shauncy both exist and NEITHER is placed in the
// map data; only their _afflicted versions are, and with no multivar there is
// nothing to swap between them. ^ulsquire_visible and ^razmire_visible are bits
// in %morttonmulti, not varbits, so they cannot render anything either - they
// are script flags. Curing somebody therefore changes what they say, not what
// is standing there.
//
// That costs something real: razmire_keelgan carries op3=Trade-General-Store
// and op4=Trade-Builders-Store, and razmire_keelgan_afflicted has op1=Talk-to
// and nothing else, so both of Razmire's shops are unreachable as placed. They
// are offered inside his dialogue instead.
//
// ---------------------------------------------------------------- the walls
// Fifteen segments - eleven templewall_base and four templewallcorner_base -
// all op1=Repair, eleven models each (base, then _1 to _10), and no multiloc.
// So a repair is a loc_change on whichever segment was clicked, and it reverts
// after ^mortton_repair_ticks because that decay is what the minigame around
// this quest is built on. Segments the player never touches stay where they
// were, which is also how the minigame behaves.

^mortton_complete = 80           // the same value as ^mortton_lit_pyre
^mortton_wall_levels = 10        // templewall_1 .. templewall_10
^mortton_repair_ticks = 30000    // how long a repaired wall holds before decaying
^mortton_sanctity_full = 100
^mortton_shades_needed = 5

^mortton_req_crafting = 20
^mortton_req_herblore = 15
^mortton_req_firemaking = 5

