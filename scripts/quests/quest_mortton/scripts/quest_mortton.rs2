// Shades of Mort'ton - the diary, the serum, the shades, the temple and the pyre.
//
// The stage list this follows is the one that was already in
// quests/quest_mortton/configs/quest_mortton.constant before anything was scripted, and so is the
// bit map for %morttonmulti at the top of that file. Neither was invented here.

// =========================================================================== the diary
[oploc1,shades_experimentshelf]
p_arrivedelay;
if (inv_total(inv, serum_book) > 0 | inv_total(bank, serum_book) > 0) {
    mes("You have already had the useful thing off this shelf.");
    return;
}
if (inv_freespace(inv) = 0) {
    mes("You have no room to take anything.");
    return;
}
mes("You go through the jars.");
p_delay(2);
inv_add(inv, serum_book, 1);
if (%morttonquest = ^mortton_not_started) {
    %morttonquest = ^mortton_read_diary;
    ~send_quest_progress(questlist:mortton, %morttonquest, ^mortton_complete);
}
~mesbox("Behind the jars is a diary. The name inside it is Herbi Flax, and most of it is a recipe he clearly never finished testing.");

// op5, not op1 - the smashed table is the one loc in Mort'ton whose search is on op5, which is why
// it needs a handler of its own rather than sharing the shelf's.
[oploc5,shades_experimenttable]
p_arrivedelay;
mes("You turn over what is left of the table.");
p_delay(2);
if (testbit(%morttonmulti, ^shades_table_searched) = ^true) {
    mes("There is nothing else under it.");
    return;
}
%morttonmulti = setbit(%morttonmulti, ^shades_table_searched);
~mesbox("Underneath is a note in the same hand as the diary: 'Tarromin. It has to be tarromin. Anything else and they simply die faster.'");

[oploc1,mortton_signpost]
p_arrivedelay;
~mesbox("WELCOME TO MORT'TON | Twinned with nowhere. | Somebody has scratched out the population figure and not written a new one.");

// =========================================================================== the serum
// Only one side of the combine is declared. [opheldu,ashes] is Recipe for Disaster's
// (quest_100/scripts/hundred_amik.rs2) and [opheldu,tarrominvial] is Herblore's brewing, and a
// trigger cannot be declared twice - so this hangs off the diary, which nothing else uses.
// OpHeldUHandler falls back to [opheldu,a] and swaps last_useitem, so either order lands here.
//
// FIXED: the OSRS way - ashes and the tarromin potion on each other, no diary involved - never
// reached this at all, in either order: [opheldu,b] is looked up before [opheldu,a], so ashes on the
// potion went to Herblore's [opheldu,tarrominvial] and the potion on the ashes to Recipe for
// Disaster's [opheldu,ashes], and both said "Nothing interesting happens". Each of those two now
// jumps to @mortton_make_serum when the other item is the one in hand
// (skill_herblore/scripts/brewing/brew_potion.rs2, quest_100/scripts/hundred_amik.rs2).
[opheldu,serum_book]
def_obj $item = last_useitem;
if ($item ! tarrominvial & $item ! ashes) {
    ~displaymessage(^dm_default);
    return;
}
@mortton_make_serum;

[label,mortton_make_serum]
// Herbi Flax's recipe, so only for somebody who has read it
if (%morttonquest < ^mortton_read_diary) {
    ~displaymessage(^dm_default);
    return;
}
if (inv_total(inv, tarrominvial) = 0 | inv_total(inv, ashes) = 0) {
    ~mesbox("The recipe wants a tarromin potion and a handful of ashes, and you are short of one of them.");
    return;
}
if (stat(herblore) < ^mortton_req_herblore) {
    mes("You need a Herblore level of <tostring(^mortton_req_herblore)> to follow the diary.");
    return;
}
if_close;
mes("You work the ashes into the tarromin the way the diary describes.");
p_delay(4);
inv_del(inv, tarrominvial, 1);
inv_del(inv, ashes, 1);
inv_add(inv, mort_serum4, 1);
stat_advance(herblore, 500);
if (%morttonquest = ^mortton_read_diary) {
    %morttonquest = ^mortton_made_serum;
    ~send_quest_progress(questlist:mortton, %morttonquest, ^mortton_complete);
}
~mesbox("Four doses of something Herbi Flax called Serum 207. His diary does not say what the first two hundred and six did.");

[opheld1,serum_book]
~mesbox("Herbi Flax's diary. | The affliction is not a sickness, it is a thinning. They are being worn away by the shades and there is nothing left in them to fight it. | Tarromin, and ashes off a pyre. Tarromin and nothing else. | It does not cure them. It gives them back enough of themselves to speak.");

// =========================================================================== the shades
// shadeshadow_level1 is a Loar Shadow and shade_level1 is a Loar Shade - two npcs, both op2=Attack.
// The remains come off the shade.
//
// FIXED: only the shadows are placed, and nothing ever turned one into its shade - so every Loar
// killed was a shadow, died through the default death script, and never reached the tally below.
// The shadows now rise into their shades (mortton_shades.rs2), and this is what they die as.
// Only the Loar count: OSRS asks for five level-40 Loar Shades, and the deeper shades are the
// catacombs' (the tally used to count any of the five kinds).
[ai_queue3,shade_level1] @mortton_shade_death(shade_bones1, true);
[ai_queue3,shade_level2] @mortton_shade_death(shade_bones2, false);
[ai_queue3,shade_level3] @mortton_shade_death(shade_bones3, false);
[ai_queue3,shade_level4] @mortton_shade_death(shade_bones4, false);
[ai_queue3,shade_level5] @mortton_shade_death(shade_bones5, false);

// An [ai_queue] runs on the npc, so the kill is handed to the killer as a queued script: the tally
// shows a dialogue on the fifth, and a dialogue cannot be opened from the npc's script.
[label,mortton_shade_death](namedobj $remains, boolean $counts)
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}
obj_add(npc_coord, $remains, 1, ^lootdrop_duration);
if ($counts = true) {
    queue(mortton_shade_killed, 0, 0);
}

[queue,mortton_shade_killed]
if (%morttonquest < ^mortton_kill_shades | %morttonquest >= ^mortton_killed_5_shades) {
    return;
}
// The five tally stages are five apart, so counting is one addition rather than a switch.
%morttonquest = add(%morttonquest, 5);
~send_quest_progress(questlist:mortton, %morttonquest, ^mortton_complete);
if (%morttonquest >= ^mortton_killed_5_shades) {
    ~mesbox("Five of them down. Razmire will want to hear it, for whatever that is worth in his state.");
    return;
}
mes("That is one fewer thing wearing this town away.");

// =========================================================================== the walls
// Fifteen segments, all op1=Repair, eleven models each and no multiloc - so a repair is a
// loc_change on whichever one was clicked, reverting after ^mortton_repair_ticks because that
// decay is what the minigame around this quest runs on.
[oploc1,templewall_base] @mortton_repair(false);
[oploc1,templewall_1] @mortton_repair(false);
[oploc1,templewall_2] @mortton_repair(false);
[oploc1,templewall_3] @mortton_repair(false);
[oploc1,templewall_4] @mortton_repair(false);
[oploc1,templewall_5] @mortton_repair(false);
[oploc1,templewall_6] @mortton_repair(false);
[oploc1,templewall_7] @mortton_repair(false);
[oploc1,templewall_8] @mortton_repair(false);
[oploc1,templewall_9] @mortton_repair(false);
[oploc1,templewallcorner_base] @mortton_repair(true);
[oploc1,templewallcorner_1] @mortton_repair(true);
[oploc1,templewallcorner_2] @mortton_repair(true);
[oploc1,templewallcorner_3] @mortton_repair(true);
[oploc1,templewallcorner_4] @mortton_repair(true);
[oploc1,templewallcorner_5] @mortton_repair(true);
[oploc1,templewallcorner_6] @mortton_repair(true);
[oploc1,templewallcorner_7] @mortton_repair(true);
[oploc1,templewallcorner_8] @mortton_repair(true);
[oploc1,templewallcorner_9] @mortton_repair(true);

[label,mortton_repair](boolean $corner)
p_arrivedelay;
if (%morttonquest < ^mortton_ulsquire_temple) {
    ~mesbox("There is no point putting the walls back while the town is still being emptied out.");
    return;
}
if (%morttonquest > ^mortton_rebuild_temple & %temple_repaired_p >= ^mortton_wall_levels) {
    ~mortton_restore_altar;
    mes("The temple is as whole as it is going to get.");
    return;
}
// FIXED: only a flamtaer hammer would do, and nothing was used up - so the builders' store, which
// is the whole reason Razmire has one, had nothing to sell for this. OSRS takes any hammer (the
// flamtaer one is the quick one) and a plank, a limestone brick and five swamp paste a repair.
if (inv_total(inv, flamtaer_hammer) = 0 & inv_total(inv, hammer) = 0) {
    mes("You need a hammer to repair the temple. Razmire sells them.");
    return;
}
if (stat(crafting) < ^mortton_req_crafting) {
    mes("You need a Crafting level of <tostring(^mortton_req_crafting)> to lay these stones.");
    return;
}
if (%temple_repaired_p >= ^mortton_wall_levels) {
    mes("The temple is as whole as it is going to get.");
    return;
}
if (inv_total(inv, woodplank) = 0 | inv_total(inv, limestonebrick) = 0 | inv_total(inv, swamppaste) < ^mortton_swamppaste_per_repair) {
    mes("You need a plank, a limestone brick and <tostring(^mortton_swamppaste_per_repair)> swamp paste for each repair.");
    mes("Razmire's builders' store sells all three.");
    return;
}
mes("You set another course of stone.");
sound_synth(anvil, 1, 0);
// the flamtaer hammer is the quick one
if (inv_total(inv, flamtaer_hammer) > 0) {
    p_delay(1);
} else {
    p_delay(3);
}
inv_del(inv, woodplank, 1);
inv_del(inv, limestonebrick, 1);
inv_del(inv, swamppaste, ^mortton_swamppaste_per_repair);
%temple_repaired_p = min(add(%temple_repaired_p, ^mortton_courses_per_repair), ^mortton_wall_levels);
stat_advance(crafting, 400);
// ^mortton_rebuild_temple is in the original stage list, between being told about the temple and
// being able to light it, so the first course of stone is what it marks.
if (%morttonquest = ^mortton_ulsquire_temple) {
    %morttonquest = ^mortton_rebuild_temple;
    ~send_quest_progress(questlist:mortton, %morttonquest, ^mortton_complete);
}
if ($corner = true) {
    @mortton_set_corner(%temple_repaired_p);
}
@mortton_set_wall(%temple_repaired_p);

[label,mortton_set_wall](int $level)
switch_int ($level) {
    case 1 : loc_change(templewall_1, ^mortton_repair_ticks);
    case 2 : loc_change(templewall_2, ^mortton_repair_ticks);
    case 3 : loc_change(templewall_3, ^mortton_repair_ticks);
    case 4 : loc_change(templewall_4, ^mortton_repair_ticks);
    case 5 : loc_change(templewall_5, ^mortton_repair_ticks);
    case 6 : loc_change(templewall_6, ^mortton_repair_ticks);
    case 7 : loc_change(templewall_7, ^mortton_repair_ticks);
    case 8 : loc_change(templewall_8, ^mortton_repair_ticks);
    case 9 : loc_change(templewall_9, ^mortton_repair_ticks);
    case default : loc_change(templewall_10, ^mortton_repair_ticks);
}
~mortton_check_walls;

[label,mortton_set_corner](int $level)
switch_int ($level) {
    case 1 : loc_change(templewallcorner_1, ^mortton_repair_ticks);
    case 2 : loc_change(templewallcorner_2, ^mortton_repair_ticks);
    case 3 : loc_change(templewallcorner_3, ^mortton_repair_ticks);
    case 4 : loc_change(templewallcorner_4, ^mortton_repair_ticks);
    case 5 : loc_change(templewallcorner_5, ^mortton_repair_ticks);
    case 6 : loc_change(templewallcorner_6, ^mortton_repair_ticks);
    case 7 : loc_change(templewallcorner_7, ^mortton_repair_ticks);
    case 8 : loc_change(templewallcorner_8, ^mortton_repair_ticks);
    case 9 : loc_change(templewallcorner_9, ^mortton_repair_ticks);
    case default : loc_change(templewallcorner_10, ^mortton_repair_ticks);
}
~mortton_check_walls;

// templefire_altar_nofire_broken carries no ops at all, so it cannot be clicked into working
// order - it has to be replaced outright. templefire_altar_nofire is the one with op1=Light.
[proc,mortton_check_walls]
if (%morttonquest ! ^mortton_rebuild_temple) {
    return;
}
if (%temple_repaired_p < ^mortton_wall_levels) {
    mes("The temple is coming back. <tostring(%temple_repaired_p)> of <tostring(^mortton_wall_levels)>.");
    return;
}
%morttonquest = ^mortton_can_light_altar;
~send_quest_progress(questlist:mortton, %morttonquest, ^mortton_complete);
loc_add(^mortton_temple_altar_coord, templefire_altar_nofire, 0, centrepiece_straight, ^mortton_repair_ticks);
~mesbox("The last course goes on and the roof stops letting the rain in. At the far end the altar is suddenly an altar rather than a heap.");

// The working altar only ever exists as that loc_add, over the broken one the map places - so a
// restart, or ^mortton_repair_ticks running out, put the broken altar (no ops at all) back under a
// player whose stage says "light it", with nothing they could click to get it back. Clicking a wall
// of the finished temple, or using anything on the broken altar, puts it back for them.
[proc,mortton_restore_altar]
if (%morttonquest < ^mortton_can_light_altar) {
    return;
}
if (loc_find(^mortton_temple_altar_coord, templefire_altar_nofire_broken) = false) {
    return;
}
loc_add(^mortton_temple_altar_coord, templefire_altar_nofire, 0, centrepiece_straight, ^mortton_repair_ticks);
mes("You set the altar back to rights.");

[oplocu,templefire_altar_nofire_broken]
p_arrivedelay;
if (%morttonquest < ^mortton_can_light_altar) {
    mes("It is a heap. The temple around it needs putting back first.");
    return;
}
~mortton_restore_altar;

// =========================================================================== the altar
[oploc1,templefire_altar_nofire]
p_arrivedelay;
if (%morttonquest < ^mortton_can_light_altar) {
    mes("There is no point lighting it with the walls still down. It would be out by morning.");
    return;
}
if (inv_total(inv, tinderbox) = 0) {
    mes("You need a tinderbox.");
    return;
}
if (stat(firemaking) < ^mortton_req_firemaking) {
    mes("You need a Firemaking level of <tostring(^mortton_req_firemaking)> to get this going.");
    return;
}
if_close;
mes("You put the tinderbox to the altar.");
p_delay(3);
loc_change(templefire_altar, ^mortton_repair_ticks);
%temple_sanctity = ^mortton_sanctity_full;
stat_advance(firemaking, 2000);
~mesbox("It catches, and goes on catching. The light reaches the walls you just put back up.");

// =========================================================================== sacred oil
// templefire_altar has no ops - it is the lit one - so blessing the oil is an oplocu on it.
[oplocu,templefire_altar]
def_obj $item = last_useitem;
p_arrivedelay;
switch_obj ($item) {
    case oliveoil4 : @mortton_bless_oil(oliveoil4, sacred_oil4);
    case oliveoil3 : @mortton_bless_oil(oliveoil3, sacred_oil3);
    case oliveoil2 : @mortton_bless_oil(oliveoil2, sacred_oil2);
    case oliveoil1 : @mortton_bless_oil(oliveoil1, sacred_oil1);
    case default : ~displaymessage(^dm_default);
}

[label,mortton_bless_oil](namedobj $oil, namedobj $sacred)
if (%morttonquest < ^mortton_can_light_altar) {
    mes("The altar is cold. Nothing would come of it.");
    return;
}
inv_del(inv, $oil, 1);
inv_add(inv, $sacred, 1);
stat_advance(crafting, 300);
mes("You hold the oil over the flame until it stops being ordinary.");
if (%morttonquest = ^mortton_can_light_altar) {
    %morttonquest = ^mortton_created_sacred_oil;
    ~send_quest_progress(questlist:mortton, %morttonquest, ^mortton_complete);
}

// =========================================================================== pyre logs
// Doses and Firemaking levels are OSRS's: logs 5/2, oak 20/2, willow 35/3, maple 50/3, yew 65/4,
// magic 80/4 - out of the one vial, which is what the sacred oil is used from.
// The logs are never the [opheldu,b] of this (no log type carries an [opheldu] of its own), so oil on
// logs and logs on oil both land here, with the logs in last_useitem.
[opheldu,sacred_oil4] @mortton_oil_logs(sacred_oil4, 4);
[opheldu,sacred_oil3] @mortton_oil_logs(sacred_oil3, 3);
[opheldu,sacred_oil2] @mortton_oil_logs(sacred_oil2, 2);
[opheldu,sacred_oil1] @mortton_oil_logs(sacred_oil1, 1);

[label,mortton_oil_logs](namedobj $oil, int $doses)
def_obj $item = last_useitem;
def_namedobj $pyre;
def_int $level;
def_int $needed;
switch_obj ($item) {
    case logs : $pyre = logs_pyre; $level = 5; $needed = 2;
    case oak_logs : $pyre = oak_logs_pyre; $level = 20; $needed = 2;
    case willow_logs : $pyre = willow_logs_pyre; $level = 35; $needed = 3;
    case maple_logs : $pyre = maple_logs_pyre; $level = 50; $needed = 3;
    case yew_logs : $pyre = yew_logs_pyre; $level = 65; $needed = 4;
    case magic_logs : $pyre = magic_logs_pyre; $level = 80; $needed = 4;
    case default : ~displaymessage(^dm_default); return;
}
if (stat(firemaking) < $level) {
    mes("You need a Firemaking level of <tostring($level)> to make pyre logs out of those.");
    return;
}
if ($doses < $needed) {
    mes("You need <tostring($needed)> doses of sacred oil in the one vial to prepare those logs.");
    return;
}
def_namedobj $left = vial_empty;
switch_int (sub($doses, $needed)) {
    case 1 : $left = sacred_oil1;
    case 2 : $left = sacred_oil2;
}
inv_del(inv, $item, 1);
inv_del(inv, $oil, 1);
inv_add(inv, $left, 1);
inv_add(inv, $pyre, 1);
stat_advance(firemaking, 200);
mes("You work the sacred oil into the wood.");
if (%morttonquest = ^mortton_created_sacred_oil) {
    %morttonquest = ^mortton_created_pyre_logs;
    ~send_quest_progress(questlist:mortton, %morttonquest, ^mortton_complete);
}

// =========================================================================== the pyre
// temple_pyre carries op4=Hidden and nothing else, and neither do the six wood-loaded versions -
// only temple_pyre_bones_* has op1=Light. So loading the pyre is two oplocus, wood then body, and
// only the third state can be clicked at all.
[oplocu,temple_pyre]
def_obj $item = last_useitem;
p_arrivedelay;
switch_obj ($item) {
    case logs_pyre : @mortton_lay_wood(logs_pyre, temple_pyre_logs);
    case oak_logs_pyre : @mortton_lay_wood(oak_logs_pyre, temple_pyre_oak);
    case willow_logs_pyre : @mortton_lay_wood(willow_logs_pyre, temple_pyre_willow);
    case maple_logs_pyre : @mortton_lay_wood(maple_logs_pyre, temple_pyre_maple);
    case yew_logs_pyre : @mortton_lay_wood(yew_logs_pyre, temple_pyre_yew);
    case magic_logs_pyre : @mortton_lay_wood(magic_logs_pyre, temple_pyre_magic);
    case default : ~displaymessage(^dm_default);
}

[label,mortton_lay_wood](namedobj $logs, loc $loaded)
inv_del(inv, $logs, 1);
loc_change($loaded, ^mortton_repair_ticks);
mes("You build the pyre up.");

[oplocu,temple_pyre_logs] @mortton_lay_body(temple_pyre_bones_logs);
[oplocu,temple_pyre_oak] @mortton_lay_body(temple_pyre_bones_oak);
[oplocu,temple_pyre_willow] @mortton_lay_body(temple_pyre_bones_willow);
[oplocu,temple_pyre_maple] @mortton_lay_body(temple_pyre_bones_maple);
[oplocu,temple_pyre_yew] @mortton_lay_body(temple_pyre_bones_yew);
[oplocu,temple_pyre_magic] @mortton_lay_body(temple_pyre_bones_magic);

[label,mortton_lay_body](loc $loaded)
def_obj $item = last_useitem;
p_arrivedelay;
switch_obj ($item) {
    case shade_bones1 : @mortton_place_remains(shade_bones1, $loaded);
    case shade_bones2 : @mortton_place_remains(shade_bones2, $loaded);
    case shade_bones3 : @mortton_place_remains(shade_bones3, $loaded);
    case shade_bones4 : @mortton_place_remains(shade_bones4, $loaded);
    case shade_bones5 : @mortton_place_remains(shade_bones5, $loaded);
    case default : ~displaymessage(^dm_default);
}

[label,mortton_place_remains](namedobj $remains, loc $loaded)
inv_del(inv, $remains, 1);
loc_change($loaded, ^mortton_repair_ticks);
mes("You lay the remains on the wood.");
if (%morttonquest = ^mortton_created_pyre_logs) {
    %morttonquest = ^mortton_logs_on_pyre;
    ~send_quest_progress(questlist:mortton, %morttonquest, ^mortton_complete);
}

[oploc1,temple_pyre_bones_logs] @mortton_light_pyre;
[oploc1,temple_pyre_bones_oak] @mortton_light_pyre;
[oploc1,temple_pyre_bones_willow] @mortton_light_pyre;
[oploc1,temple_pyre_bones_maple] @mortton_light_pyre;
[oploc1,temple_pyre_bones_yew] @mortton_light_pyre;
[oploc1,temple_pyre_bones_magic] @mortton_light_pyre;

[label,mortton_light_pyre]
def_coord $pyre = loc_coord;
p_arrivedelay;
if (inv_total(inv, tinderbox) = 0) {
    mes("You need a tinderbox.");
    return;
}
if_close;
mes("You light the pyre.");
p_delay(3);
loc_change(temple_pyre, ^mortton_repair_ticks);
stat_advance(firemaking, 2000);
stat_advance(prayer, 1000);
npc_add($pyre, shade_heaven, 20);
~mesbox("Something goes up off the pyre that is not smoke, and it does not come back down.");
if (%morttonquest = ^mortton_logs_on_pyre) {
    @mortton_finish;
}

[label,mortton_finish]
%morttonquest = ^mortton_lit_pyre;
stat_advance(herblore, 20000);
stat_advance(crafting, 20000);
// OSRS's rewards are 3 quest points, 2,000 Herblore and 2,000 Crafting - no Firemaking
session_log(^log_adventure, "Quest complete: Shades of Mort'ton");
~send_quest_complete(questlist:mortton, mort_serum4, 200, ^mortton_questpoints, "You have completed\\nShades of Mort'ton!", "3 Quest Points|2,000 Herblore XP|2,000 Crafting XP|The temple is lit");
