[queue,sheep_complete]
%sheep = ^sheep_complete;
// No inv_del here. @fred_give_wool has already taken every ball it counted; taking one more stole a
// spare from anyone who brought extras, and was the reason the hand-in effectively cost 21 balls.
// The June 2008 source the note in fred_the_farmer.rs2 cites does not take the last ball separately.
inv_add(inv, coins, 60);
stat_advance(crafting, 1500);
session_log(^log_adventure, "Quest complete: Sheep Shearer");
~send_quest_complete(questlist:sheep, shears, 250, ^sheep_questpoints, "You have completed the Sheep Shearer Quest!", "150 Crafting XP|60 coins");
