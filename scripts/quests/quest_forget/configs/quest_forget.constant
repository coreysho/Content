// Forgettable Tale of a Drunken Dwarf.
//
// Three varps. forget_main_var is the quest; forget_puzzle_var and forget_puzzle_var2 hold twelve
// two-bit slots each called forget_if1 through forget_if12 - twelve things, four states apiece.
//
//   forget_quest              bits 0-7
//   forget_farming            bits 8-11
//   forget_veldaban_exposition, forget_boarding_removed, forget_beer_given
//   forget_seed2/3/4_given and forget_seed2/3/4_told
//   forget_gardener_task      bits 20-22
//   forget_room2_bookcase, forget_room2_paper1, forget_room2_paper2
//   forget_brothers_toldsuccess, forget_region_status
//   forget_tunnel_cutscene1/2/3
//
// ---------------------------------------------------------------------------- the letter
// forget_gardener_letter is "A letter addressed to Elstan of Falador", and Rind the gardener is
// standing in Keldagrim at 2854,10195 with nothing to say. Three seed varbits, three "told"
// varbits and a three-bit task counter, and the letter names the man to take it to - who is the
// same Elstan this repo already hooked for Garden of Tranquillity.
//
// ---------------------------------------------------------------------------- the beer
// forget_cutscene_beer is "Beer glass. For drinking... if it were filled." and forget_beer_given is
// one bit. Commander Veldaban is the Black Guard's supreme leader and he is not going to discuss
// the Red Axe with anybody sober.
//
// ---------------------------------------------------------------------------- the Red Axe
// Everything with a forget_ prefix in the loc table lives in m29_77: a train cart with op1=Ride and
// op2=Return, three metal crates full of papers, and four cave mouths on plane 2 that lead from one
// chamber of the story to the next. Nothing there was placed anywhere else and nothing there had a
// handler.
//
// The boarding Rind watches through is keldagrim_boardedupdoor_multi at 2926,10158 in Keldagrim - a
// multiloc on forget_boarding_removed that shows "Wooden boards" at 0 and nothing at all at 1. It
// has no ops, so the hammer is used on it; and since the cart is in m29_77, the boards are the only
// way to it. They stay up (the varbit stays 0) so that there is still something to squeeze through
// the next time, and come down when the story is told.
^forget_not_started = 0
^forget_beer = 10        // Veldaban has been bought a drink and has talked
^forget_seeds = 20       // Rind's seeds
^forget_tunnel = 30      // the boarding off the tunnel
^forget_papers = 40      // the crates in the Red Axe base
^forget_story = 50       // the chambers
^forget_told = 60
^forget_complete = 70

^forget_off = 0
^forget_on = 1

^forget_murals = 12
^forget_mural_read = 1

// ---------------------------------------------------------------------------- places
^forget_veldaban = 1_44_159_12_34        // 2828,10204
^forget_veldaban_landing = 1_44_159_12_35   // was 12_33, his desk: a blocked tile
^forget_rind = 0_44_159_38_19            // 2854,10195
^forget_drunk = 0_45_159_32_46           // 2912,10222
^forget_rowdy = 0_45_159_26_22
^forget_librarian = 0_44_159_42_49

^forget_train = 1_29_77_8_29
^forget_train_landing = 1_29_77_8_28
^forget_base = 2_29_77_50_36             // beside the first papers crate
^forget_puzzle_in = 1_29_77_4_29
^forget_chamber_a = 2_29_77_32_54      // was 33_53: a blocked tile with no free neighbour
^forget_chamber_b = 2_29_77_12_55
^forget_chamber_c = 2_29_77_6_11
^forget_next_a = 2_29_77_33_54
^forget_prev_b = 2_29_77_11_55
^forget_next_b = 2_29_77_57_13
^forget_prev_c = 2_29_77_5_11
^forget_after_b = 2_29_77_56_13
^forget_after_a = 2_29_77_32_54
// The cave mouth beside the papers. forget_puzzle_entrance, by the cart, is a wall door whose far
// side (the tile east of it) is solid - it can never be reached from the rails - so this mouth,
// which the papers room does reach, is the way into the chambers.
^forget_base_next = 2_29_77_58_37
