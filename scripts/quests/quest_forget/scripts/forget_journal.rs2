[if_button,questlist:forget]
def_string $text;

switch_int (%forget_quest) {
    case ^forget_not_started :
        $text = "@dbl@There is a @dre@drunk@dbl@ in a @dre@Keldagrim@dbl@ pub who says he saw a|";
        $text = append($text, "@dbl@@dre@Red Axe@dbl@ director in a boarded tunnel talking to something|");
        $text = append($text, "@dbl@that was not a dwarf|");
        $text = append($text, "@dbl@Nobody has ever looked|");
        $text = append($text, "@dbl@@dre@The Giant Dwarf@dbl@ opens Keldagrim");

    case ^forget_beer :
        $text = "@str@Commander Veldaban will not investigate a man who cannot|";
        $text = append($text, "@str@stand up, and has been drinking in the same room as him for|");
        $text = append($text, "@str@two years.|");
        $text = append($text, "@dbl@@dre@Rind the gardener@dbl@ notices things. He has a @dre@letter@dbl@ he|");
        $text = append($text, "@dbl@has been trying to post out of the city");

    case ^forget_seeds :
        $text = "@str@Rind grows things underground with a lantern, has got triple|";
        $text = append($text, "@str@herbicide resistance out of a cabbage, and has written to|");
        $text = append($text, "@str@Elstan of Falador nine times.|");
        $text = append($text, "@str@Elstan wrote back, and agrees with him.|");
        $text = append($text, "@dbl@Rind has been looking through a gap in some @dre@boarding@dbl@ east|");
        $text = append($text, "@dbl@of here every day for eleven years. The @dre@rails@dbl@ behind it|");
        $text = append($text, "@dbl@are not rusty. I should use a @dre@hammer@dbl@ on the @dre@boards");

    case ^forget_tunnel :
        $text = "@str@The boards came off and the rails are not rusted.|";
        $text = append($text, "@dbl@@dre@Ride the cart");

    case ^forget_papers :
        $text = "@str@Eleven years of ore that never reached the Consortium, and|";
        $text = append($text, "@str@a list of names with dates beside them and nothing after the|");
        $text = append($text, "@str@dates.|");
        $text = append($text, "@str@The drunk has been right for two years.|");
        $text = append($text, "@dbl@There is a @dre@cave mouth@dbl@ off the room with the crates");

    case ^forget_story :
        $text = "@str@Twelve panels cut into the rock, and the twelfth is blocked|";
        $text = append($text, "@str@out and not carved, and it is eleven years newer than the|");
        $text = append($text, "@str@other eleven.|");
        $text = append($text, "@dbl@Tell @dre@Veldaban");

    case ^forget_complete :
        $text = "@str@Eleven years of ore, a company digging where the city voted|";
        $text = append($text, "@str@it could not, and twelve panels on a wall with the last one|");
        $text = append($text, "@str@left blank.|");
        $text = append($text, "@str@Veldaban has written it all down and filed it and nothing has|");
        $text = append($text, "@str@happened, and he has gone back to the pub.|");
        $text = append($text, "@str@He had been drinking in the same room as that man for two|");
        $text = append($text, "@str@years and had never once let him finish.||");
        $text = append($text, "@red@QUEST COMPLETE!");

    case default :
        $text = "@dbl@There is a @dre@drunk@dbl@ in a @dre@Keldagrim@dbl@ pub with a story";
}

~quest_journal("Forgettable Tale of a Drunken Dwarf", $text);
