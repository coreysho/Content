[haunted]
// FIXED: [ernest_multiernest] is multinpc=3,ernest and NOTHING ELSE, keyed on this varp. Without
// transmit the client never receives it, its copy stays 0 forever, and index 3 is never resolved -
// so Ernest never appeared as a man after being restored, which is the entire payoff of the quest.
// [ernest_multichicken] declares 0, 1 and 2 and so kept working by accident: the client's stuck 0
// happens to be a valid index for the chicken.
transmit=yes
scope=perm

[ernestlever]
scope=perm
transmit=yes

[haunted_manor_fountain_poisoned]
scope=perm
