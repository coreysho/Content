// Icthlarin's Little Helper.
//
// Three multinpc shells key on %ics_little_var and they pin the ceremony hard:
//
//   [ics_little_hipriest_ceremony]  multinpc 19..24 -> ics_little_hipriest_vis
//   [ics_little_priest_ceremony]    multinpc 19..25 -> ics_little_priest
//   [ics_little_ic]                 multinpc 24     -> ics_little_ic_vis
//
// So the burial party exists only between 19 and 25, and ICTHLARIN RENDERS AT 24 AND NOWHERE ELSE.
// One value. The stages below are built around that, and completion is 26 so that the ceremony
// clears once it is over.
//
// The four canopic jars are inverted multis: each *_pot_*_multi has multiloc=0 only, so the jar is
// there while its vis bit is 0 and gone once it is set. Setting the bit is what makes taking it
// stick. Their lids name their contents in the cache's own descriptions - man=liver, ape=intestines,
// bug=stomach, crocodile=lungs - which is the puzzle key.
^icslittle_not_started = 0
^icslittle_asked = 5
^icslittle_has_method = 10
^icslittle_has_ingredients = 15
^icslittle_embalmed = 18
^icslittle_ceremony = 19
^icslittle_jars_placed = 22
^icslittle_icthlarin = 24
^icslittle_devoured = 25

// The spectre of Klenter. ics_little_spectre has multinpc=1 only, so he is absent at 0 and appears
// when the bit is set - the opposite of the jars.
^icslittle_spectre_hidden = 0
^icslittle_spectre_shown = 1

// Sophanem's tomb, where the jars and Klenter are: m51_143. The town is m51_43 above it.
^icslittle_jar_liver = 0_51_143_22_42
^icslittle_jar_lungs = 0_51_143_22_43
^icslittle_jar_stomach = 0_51_143_22_44
^icslittle_jar_intestines = 0_51_143_22_41
