// Desert Treasure - boss combat mechanics (Corey, 2026-09-07).
//
// Two of the four bosses are gated on the element of the spell you cast at them, which the cache has
// no way to express as config. Both hook the same place in
// skill_combat/scripts/player/player_magic.rs2 that Salarin the Twisted, Chronozon and the Dagannoth
// Mother already hook - the damage-override chain in ~pvm_spell_success - so nothing new had to be
// invented for it.
//
//   Kamil  is immune to every spell except Fire.
//   Fareed is immune to every spell except Water.
//
// Added 2026-09-07: the two melee mechanics. Both hang off a single call in an existing path
// rather than a new system, so nothing else on the server changes shape.
//
//   Fareed   disarms anyone who swings at him without ice gloves. ~dt_melee_attack_allowed is
//            called once at the top of [label,player_melee_attack], after the target is known to be
//            alive and attackable but before the hit roll, and returns true for every other npc.
//   Damis 2  drains prayer on every hit he lands. Queued from ~playerhit_n_melee alongside the
//            poison queue that was already there - that queue is the only shape which reaches the
//            player from inside npc combat.

[proc,dt_spell_damage_allowed](int $spell)(boolean)
if (npc_type = icediamond_icewarrior) {
    return(~dt_is_fire_spell($spell));
}
if (npc_type = firediamond_firewarrior) {
    return(~dt_is_water_spell($spell));
}
return(true);

[proc,dt_is_fire_spell](int $spell)(boolean)
switch_int ($spell) {
    case ^fire_strike : return(true);
    case ^fire_bolt : return(true);
    case ^fire_blast : return(true);
    case ^fire_wave : return(true);
    case ^iban_blast : return(true);
    case ^flames_of_zamorak : return(true);
    case ^smoke_rush : return(true);
    case ^smoke_burst : return(true);
    case ^smoke_blitz : return(true);
    case ^smoke_barrage : return(true);
    case default : return(false);
}
return(false);

[proc,dt_is_water_spell](int $spell)(boolean)
switch_int ($spell) {
    case ^water_strike : return(true);
    case ^water_bolt : return(true);
    case ^water_blast : return(true);
    case ^water_wave : return(true);
    case ^ice_rush : return(true);
    case ^ice_burst : return(true);
    case ^ice_blitz : return(true);
    case ^ice_barrage : return(true);
    case default : return(false);
}
return(false);


// ================================================================================ Fareed's disarm
//
// "Fareed will disarm players not wearing ice gloves" - so the swing never happens and the weapon
// comes off instead. An unarmed player is left alone: there is nothing to disarm, and unarmed melee
// against a level 167 with +100 melee defence is its own punishment.
//
// ~unequip refuses when the inventory is full rather than dropping the weapon on the floor, so a
// full-inventory player keeps their weapon and simply cannot land a hit. That is the safe failure.
[proc,dt_melee_attack_allowed]()(boolean)
if (npc_type ! firediamond_firewarrior) {
    return(true);
}
if (inv_total(worn, ice_gloves) > 0) {
    return(true);
}
if (inv_getobj(worn, ^wearpos_rhand) = null) {
    return(true);
}
mes("Fareed's heat sears your hands and you lose your grip on your weapon.");
~unequip(^wearpos_rhand);
~update_bas;
p_stopaction;
return(false);
