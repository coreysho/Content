// Desert Treasure - the Ice diamond, Kamil (Corey, 2026-09-07).
//
// Progress is fd_icewarrior_subquest, a 5-bit varbit the cache reserved. The troll child is a
// multi npc reading it: fourdiamonds_troll_child shows _crying at 0 and _okay at 1 and above, so
// cheering him up with a sweet is literally a one-line varbit write and the client swaps the model.
//
// Kamil's defining mechanic - immune to every spell except Fire - is enforced in dt_combat.rs2,
// which hooks the same place in player_magic.rs2 that Salarin, Chronozon and the Dagannoth Mother
// already hook.
//
// Added 2026-09-08: the ice gate, the Ice Path's cold, and the automatic thaw.
//
// The gate (icegate_left / icegate_right, m44_58 x=22) ships with op1=Go-through already authored
// and had no handler anywhere in the codebase, so there was no way onto the path at all.
//
// The cold uses [timer]/settimer/cleartimer - the same mechanism poison, prayer drain and barrows
// degradation all use - rather than the per-tick zone system I said this codebase did not have. It
// does; I was looking for the wrong thing.

// ================================================================================ the ice gate
//
// Two halves of one gate, three tiles long, standing north-south at m44_58 x=22. You come through
// it westwards or eastwards depending on which side you were on.

[oploc1,icegate_left] @dt_ice_gate;
[oploc1,icegate_right] @dt_ice_gate;

[label,dt_ice_gate]
if (%deserttreasure < ^dt_hunting_diamonds) {
    ~mesbox("A huge gate of ice. There is nothing beyond it that you want.");
    return;
}
if (%fd_icewarrior_subquest < ^fdiw_gave_sweet) {
    ~mesbox("The troll child is sitting in front of the gate and will not budge.|He wants something to eat first.");
    return;
}
def_int $dx = calc(coordx(loc_coord) - coordx(coord) + 1);
if (coordx(coord) > coordx(loc_coord)) {
    $dx = calc(coordx(loc_coord) - coordx(coord) - 1);
}
def_coord $dest = movecoord(coord, $dx, 0, 0);
mes("You squeeze through the ice gate.");
sound_synth(sluice_gate, 1, 0);
p_delay(1);
p_telejump($dest);
settimer(dt_ice_path, ^dt_ice_path_drain_ticks);

// ================================================================================ the Ice Path
//
// ^dt_ice_path_drain_ticks was declared when the quest went in and never referenced. The path is
// bitterly cold: it takes a little damage and knocks a combat stat down every 25 ticks for as long
// as you are on it, and stops the moment you step off. fd_icewarrior_bootshint is the cache's own
// varbit for the one-time warning.
//
// The timer starts when you come through the gate. Logging out on the path and back in does not
// restart it - you get a free run until you cross the gate again - which is the safe failure.

[timer,dt_ice_path]
if (inzone(^dt_ice_path_sw, ^dt_ice_path_ne, coord) = false) {
    cleartimer(dt_ice_path);
    return;
}
// mes rather than mesbox: ~damage_self does an if_close, so a modal opened here would be shut
// again the same tick, and a box popping up mid-fight with the ice trolls would be worse than
// useless anyway.
if (%fd_icewarrior_bootshint = 0) {
    %fd_icewarrior_bootshint = 1;
    mes("The cold here is not natural. You will not be able to stand it for long.");
}
mes("The cold bites into you.");
~damage_self(randominc(3));
switch_int (random(3)) {
    case 0 : stat_sub(attack, 1, 0);
    case 1 : stat_sub(strength, 1, 0);
    case default : stat_sub(defence, 1, 0);
}

// ================================================================================ the troll child

// ---------------------------------------------------------------- multi shells
//
// Every opnpc handler below is declared TWICE: once on the multi child and once on the shell the
// map actually places. That is not belt-and-braces, it is required.
//
// network/game/client/handler/OpNpcHandler.ts:38-51 resolves a multi npc - but only far enough to
// validate that the option exists, so the right-click menu looks perfectly correct. It then sets
// the interaction on the placed entity, and engine/entity/Player.ts:1001 (getOpTrigger) looks the
// script up with
//
//     type = NpcType.get(this.target.type)
//
// with no multi resolution at all. So the script is searched for under the SHELL's name, the
// handler on the child is never found, and the click silently does nothing.
//
// Same fault as the Biohazard elena2/elena2_vis bug, from the other direction.

[opnpc1,fourdiamonds_troll_child] @dt_troll_child;
[opnpc1,fourdiamonds_troll_child_crying] @dt_troll_child;
[opnpc1,fourdiamonds_troll_child_okay] @dt_troll_child;

[label,dt_troll_child]
if (%deserttreasure < ^dt_hunting_diamonds) {
    ~chatnpc("<p,sad>Go away. Not want talk.");
    return;
}
if (%fd_icewarrior_subquest >= ^fdiw_diamond_given) {
    ~chatnpc("<p,happy>You good human. Mummy and daddy say hello.");
    return;
}
if (%fd_icewarrior_subquest >= ^fdiw_parents_freed) {
    @dt_troll_child_reward;
}
if (%fd_icewarrior_subquest >= ^fdiw_gave_sweet) {
    ~chatnpc("<p,sad>Mummy and daddy still ice. Please help.");
    ~chatnpc("<p,neutral>Ice man live past gate. Him freeze them. Smash ice blocks to let them out.");
    return;
}
if (%fd_trollchild_intro = 0) {
    ~chatnpc("<p,sad>*sniff*");
    ~chatplayer("<p,quiz>Are you all right?");
    ~chatnpc("<p,sad>No! Bad man come. Freeze mummy. Freeze daddy. Me all alone.");
    ~chatplayer("<p,quiz>What bad man?");
    ~chatnpc("<p,sad>White man. Cold man. Him live past gate with shiny stone.");
    ~chatnpc("<p,sad>Me hungry too. Me want sweet.");
    %fd_trollchild_intro = 1;
    return;
}
~chatnpc("<p,sad>Me want sweet. Then me let you past gate.");

[opnpcu,fourdiamonds_troll_child] @dt_troll_child_sweet;
[opnpcu,fourdiamonds_troll_child_crying] @dt_troll_child_sweet;
[opnpcu,fourdiamonds_troll_child_okay] @dt_troll_child_sweet;

[label,dt_troll_child_sweet]
if (%deserttreasure < ^dt_hunting_diamonds) {
    ~chatnpc("<p,sad>Not want.");
    return;
}
if (%fd_icewarrior_subquest >= ^fdiw_gave_sweet) {
    ~chatnpc("<p,happy>Me full. Thank you.");
    return;
}
if (~dt_is_sweet(last_useitem) = false) {
    ~chatnpc("<p,sad>Not sweet. Me want sweet.");
    return;
}
inv_del(inv, last_useitem, 1);
~chatnpc("<p,happy>SWEET! Me like you now. You go past gate. Ice man there.");
~chatnpc("<p,neutral>Please free mummy and daddy. Them in ice past cold path.");
%fd_icewarrior_subquest = ^fdiw_gave_sweet;
~dt_spawn_kamil;
~send_quest_progress(questlist:deserttreasure, %deserttreasure, ^deserttreasure_complete);

[proc,dt_is_sweet](obj $item)(boolean)
switch_obj ($item) {
    case cake : return(true);
    case cake_slice : return(true);
    case chocolate_cake : return(true);
    case chocolate_slice : return(true);
    case chocolate_bar : return(true);
    case cooking_apple : return(true);
    case default : return(false);
}
return(false);

// ================================================================================ Kamil
//
// The seven ice trolls guarding the path already have a drop table wired in
// drop_tables/scripts/ice_troll.rs2, which owns their [ai_queue3] triggers - a second declaration
// is a build error - so the "kill five trolls to open the gate" gate is NOT implemented. They are
// still in the way and still have to be fought through; there is just no counter.
//
// Kamil is spawned the moment the troll child lets you past rather than standing on the map, which
// keeps him from being farmed before the quest and matches how the fight really starts.
[proc,dt_spawn_kamil]
if (npc_find(^dt_kamil_arena, icediamond_icewarrior, 20, 0) = true) {
    return;
}
npc_add(^dt_kamil_arena, icediamond_icewarrior, 2000);

// Correcting an earlier mistake of mine: an ai_queue3 death hook CAN write the killer's varbits.
// NPC_FINDHERO in engine/src/engine/script/handlers/NpcOps.ts:129-143 does
//
//     state.activePlayer = player;
//     state.pointerAdd(ActivePlayer[state.intOperand]);
//
// so everything after a successful npc_findhero runs with the killer as the active player.
// areas/area_mage_arena/scripts/kolodion_fight.rs2 has been relying on exactly that for %magearena
// the whole time. That is what makes the automatic thaw below possible.
[ai_queue3,icediamond_icewarrior]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}
obj_add(npc_coord, bones, 1, ^lootdrop_duration);
obj_add(npc_coord, coins, 2000, ^lootdrop_duration);
%fd_icewarrior_dead = 1;
%fd_icewarrior_dadfree = 1;
%fd_icewarrior_mumfree = 1;
if (%fd_icewarrior_subquest < ^fdiw_parents_freed) {
    %fd_icewarrior_subquest = ^fdiw_parents_freed;
    mes("Somewhere behind you, ice cracks.");
}

// ================================================================================ the ice blocks

// troll_block_1 and troll_block_2 are the shells the map places, and each covers BOTH states:
// multinpc=0 is the ice block (op1 Talk-to, op2 Smash-ice) and multinpc=1 is the freed parent
// (op1 Talk-to). So op1 on the shell has to branch on the same varbit the multi reads.
// troll_frozen_1/2 are a second pair of shells for the same two parents at subquest stage 4-5.
[opnpc2,troll_block_1] ~dt_smash_ice(1);
[opnpc2,troll_block_2] ~dt_smash_ice(2);
[opnpc2,fd_trollblock1] ~dt_smash_ice(1);
[opnpc2,fd_trollblock2] ~dt_smash_ice(2);

[opnpc1,troll_block_1] ~dt_iceblock_talk(1);
[opnpc1,troll_block_2] ~dt_iceblock_talk(2);
[opnpc1,fd_trollblock1] ~dt_look_at_ice;
[opnpc1,fd_trollblock2] ~dt_look_at_ice;

[opnpc1,troll_frozen_1] ~dt_troll_parent(1);
[opnpc1,troll_frozen_2] ~dt_troll_parent(2);
[opnpc1,fd_troll_dad] ~dt_troll_parent(1);
[opnpc1,fd_troll_mum] ~dt_troll_parent(2);

// Which of the two the shell is currently showing.
[proc,dt_iceblock_talk](int $which)
if ($which = 1 & %fd_icewarrior_dadfree = 1) {
    ~dt_troll_parent(1);
    return;
}
if ($which = 2 & %fd_icewarrior_mumfree = 1) {
    ~dt_troll_parent(2);
    return;
}
~dt_look_at_ice;

[proc,dt_look_at_ice]
if (%deserttreasure < ^dt_hunting_diamonds) {
    ~mesbox("A troll, frozen solid inside a block of ice. There is nothing you can do for it.");
    return;
}
~mesbox("A troll, frozen solid inside a block of ice. The ice looks brittle - you could smash it.");

[proc,dt_smash_ice](int $which)
if (%deserttreasure < ^dt_hunting_diamonds | %fd_icewarrior_subquest < ^fdiw_gave_sweet) {
    mes("You have no reason to break this open.");
    return;
}
if ($which = 1 & %fd_icewarrior_dadfree = 1) {
    mes("This block is already broken open.");
    return;
}
if ($which = 2 & %fd_icewarrior_mumfree = 1) {
    mes("This block is already broken open.");
    return;
}
// Kamil's death is checked by his absence rather than by a varbit. An [ai_queue3] death hook runs
// with no player pointer at all, so it cannot write a player varbit - and "he is not here any more"
// is the same test from the player's side.
if (npc_find(coord, icediamond_icewarrior, 20, 0) = true) {
    mes("Kamil is still here. You will not get near the ice while he lives.");
    return;
}
mes("You strike the block of ice.");
anim(human_axe_smash, 0);
sound_synth(smash_gem, 1, 0);
p_delay(3);
mes("The ice cracks and falls away.");
if ($which = 1) {
    %fd_icewarrior_dadfree = 1;
} else {
    %fd_icewarrior_mumfree = 1;
}
if (%fd_icewarrior_dadfree = 1 & %fd_icewarrior_mumfree = 1) {
    %fd_icewarrior_subquest = ^fdiw_parents_freed;
    ~mesbox("Both trolls are free. You should tell their child.");
}

[proc,dt_troll_parent](int $which)
if (%fd_icewarrior_subquest < ^fdiw_parents_freed) {
    ~chatnpc("<p,neutral>Grrr.");
    return;
}
if ($which = 1) {
    ~chatnpc("<p,happy>You break ice. Good human. Child waiting for you.");
    return;
}
~chatnpc("<p,happy>Thank you. Go see child - him have shiny stone cold man dropped.");

[label,dt_troll_child_reward]
~chatnpc("<p,happy>Mummy! Daddy! You free them!");
~chatplayer("<p,happy>They're both fine.");
~chatnpc("<p,happy>Cold man drop shiny stone when him fall. Me keep for you.");
if (inv_freespace(inv) = 0) {
    ~chatnpc("<p,neutral>You hands full. Come back.");
    return;
}
inv_add(inv, fd_icediamond, 1);
%fd_icewarrior_subquest = ^fdiw_diamond_given;
~objbox(fd_icediamond, "The troll child hands you the Diamond of Ice.", 250, 0, ^objbox_height);
