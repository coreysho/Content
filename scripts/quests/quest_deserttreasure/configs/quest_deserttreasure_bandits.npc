walkanim=human_walk_f,human_walk_b,human_walk_l,human_walk_r
readyanim=human_ready
op1=Talk-to
op3=Trade
head1=obj_pickpocket_guide_farmer
head2=npc_gem_trader_head
category=shop_keeper
param=owned_shop,fd_bandit_bar
param=shop_sell_multiplier,1300
param=shop_buy_multiplier,40
param=shop_delta,15
param=shop_title,Bandit Camp General Store

