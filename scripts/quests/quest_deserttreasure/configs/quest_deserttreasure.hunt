// Desert Treasure - Bandit Camp aggression (Corey, 2026-09-08).
//
// Modelled on [aggressive_melee] in _unpack/377/all.hunt, with the check_invparam line from
// [example3] doing the actual work. find_keephunting=on so they stay on you once provoked rather
// than losing interest the moment you step away, and check_nottoostrong=off because the whole point
// is that they attack regardless of your level.

[dt_bandit_saradomin]
type=player
check_invparam=worn,saradominitem,>0
check_vis=lineofsight
check_nottoostrong=off
check_notcombat=%lastcombat
check_notcombat_self=%npc_lastcombat
check_notbusy=off
find_keephunting=on
find_newmode=opplayer2

[dt_bandit_zamorak]
type=player
check_invparam=worn,zamorakitem,>0
check_vis=lineofsight
check_nottoostrong=off
check_notcombat=%lastcombat
check_notcombat_self=%npc_lastcombat
check_notbusy=off
find_keephunting=on
find_newmode=opplayer2
