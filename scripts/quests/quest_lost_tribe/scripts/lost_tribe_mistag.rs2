// The mine: Mistag at the far end, the goblin bow that makes him talk, and Kazgar, who walks the
// player through it once Mistag has had them shown out.
//
// Kazgar is npc 2085 at 0_50_150_31_10 (the multi shell lost_tribe_guide, visible from stage 9);
// Mistag is npc 2084 at 0_51_150_55_15. The tunnel between them is walkable - the first trip is made
// on foot, as in OSRS.
//
// lost_tribe_guide_1op (2086) is what the shell resolves to; the trigger goes on the shell.

[opnpc1,lost_tribe_guide]
if (%lost_tribe_quest < ^lost_tribe_spoke_mistag) {
    ~chatnpc("<p,neutral>You should not be down here.");
    return;
}
~chatnpc("<p,neutral>You're the surface-dweller Mistag told us about. Do you want me to take you to him?");
switch_int (~p_choice2("Yes, take me to Mistag.", 1, "Not just now.", 2)) {
    case 2 :
        ~chatplayer("<p,neutral>Not just now.");
        ~chatnpc("<p,neutral>I'll be here. Don't wander off - the tunnels don't forgive it.");
        return;
    case 1 :
        ~chatplayer("<p,happy>Yes, take me to Mistag.");
}
~chatnpc("<p,neutral>Stay close, and mind your head.");
@lost_tribe_walk(^lost_tribe_mistag_side, "Kazgar leads you through the dark, turning so often that you lose count.");

[label,lost_tribe_walk](coord $to, string $line)
if_close;
mes($line);
p_delay(3);
p_teleport($to);

// =========================================================================== the goblin bow

// Called from [if_button,emotes:goblin_bow] (interface_controls/scripts/emotes.rs2) before the emote
// plays. OSRS: "perform your Goblin Bow emote in front of him" - Mistag answers in kind.
[proc,lost_tribe_goblin_bow]
if (%lost_tribe_quest ! ^lost_tribe_learnt_emotes) {
    return;
}
if (npc_find(coord, lost_tribe_mistag, 6, ^vis_off) = false) {
    return;
}
queue(lost_tribe_mistag_bowed, 3, 0);

[queue,lost_tribe_mistag_bowed]
if (%lost_tribe_quest ! ^lost_tribe_learnt_emotes) {
    return;
}
%lost_tribe_quest = ^lost_tribe_bowed;
~send_quest_progress(questlist:lost_tribe, %lost_tribe_quest, ^lost_tribe_complete);
~chatnpc_specific("Mistag", lost_tribe_mistag, "<p,shock>A surface-dweller who knows the old greeting? Then you come as a friend. I am Mistag, and I lead the miners here.");
~chatnpc_specific("Mistag", lost_tribe_mistag, "<p,neutral>Come and speak with me.");

// =========================================================================== Mistag

[opnpc1,lost_tribe_mistag]
switch_int (%lost_tribe_quest) {
    case ^lost_tribe_learnt_emotes : @mistag_suspicious;
    case ^lost_tribe_bowed : @mistag_talk;
    case ^lost_tribe_spoke_mistag : @mistag_waiting;
    case ^lost_tribe_treaty_signed : @mistag_treaty;
    case ^lost_tribe_complete : @mistag_after;
    case default : @mistag_stranger;
}

[label,mistag_stranger]
~chatnpc("<p,angry>A surface-dweller! Keep back - we want nothing to do with your kind.");
mes("Mistag will not speak to you.");

[label,mistag_suspicious]
~chatnpc("<p,angry>A surface-dweller, down here? What do you want?");
~chatplayer("<p,neutral>I mean you no harm.");
~chatnpc("<p,angry>So you say. A friend would greet us properly.");

[label,mistag_talk]
~chatnpc("<p,neutral>Well, friend. What brings you so far beneath the surface?");
~chatplayer("<p,neutral>The Duke of Lumbridge's cellar wall collapsed, and his silverware went missing. The Duke thinks goblins came through the hole and took it.");
~chatnpc("<p,sad>The wall fell because we were mining too close to it. That was our mistake, and I am sorry for it. But we took nothing.");
~chatnpc("<p,neutral>We are the Dorgeshuun. We refused to fight in the god wars, and we came down here to be left in peace. We have lived under your castle ever since, and never troubled anyone.");
~chatplayer("<p,quiz>So who took the silverware?");
~chatnpc("<p,neutral>Someone on your side of the wall, I should think. If your Duke sends soldiers down here my people will defend themselves - and then there will be war over a box of spoons.");
~chatnpc("<p,neutral>Go back to your Duke, and tell him that the Dorgeshuun want only peace.");
%lost_tribe_quest = ^lost_tribe_spoke_mistag;
~send_quest_progress(questlist:lost_tribe, %lost_tribe_quest, ^lost_tribe_complete);
~lost_tribe_return_brooch;
@mistag_offer_escort;

[label,mistag_offer_escort]
switch_int (~p_choice2("Can you show me the way out of the mines?", 1, "I'll find my own way.", 2)) {
    case 2 :
        ~chatplayer("<p,neutral>I'll find my own way.");
        ~chatnpc("<p,neutral>Mind the low roof. Kazgar keeps watch at the Lumbridge end of the mine, if you need a guide next time.");
        return;
    case 1 :
        ~chatplayer("<p,neutral>Can you show me the way out of the mines?");
}
~chatnpc("<p,neutral>Of course. And from now on, Kazgar will guide you whenever you want to pass through.");
@lost_tribe_walk(^lost_tribe_mine_entrance, "You are led back through the tunnels, and lose count of the turnings again.");

[label,mistag_waiting]
~chatnpc("<p,quiz>Have you spoken with your Duke?");
~chatplayer("<p,sad>He won't listen. His advisor, Sigmund, tells him goblins are thieves.");
~chatnpc("<p,sad>Then someone must show him the truth. Find who really took the silverware.");
~lost_tribe_return_brooch;
@mistag_offer_escort;

[label,mistag_treaty]
~lost_tribe_return_brooch;
if (inv_total(inv, lost_tribe_treaty) = 0) {
    ~chatnpc("<p,quiz>Have you spoken with your Duke?");
    ~chatplayer("<p,neutral>He's signed a peace treaty. I need to fetch it from him.");
    ~chatnpc("<p,happy>Then hurry back with it!");
    return;
}
~chatplayer("<p,happy>The Duke has signed a peace treaty! It was his advisor Sigmund who took the silverware - he wanted your people blamed.");
mes("You hand Mistag the peace treaty.");
~chatnpc("<p,shock>He did? Truly?");
mes("Mistag reads the treaty twice before he says anything.");
~chatnpc("<p,happy>Then it is done. Ur-tag, our leader, will set his mark on it, and there will be peace between Lumbridge and the Dorgeshuun.");
~chatnpc("<p,happy>You will always be welcome here, friend. Take this, with our thanks.");
inv_del(inv, lost_tribe_treaty, 1);
queue(lost_tribe_quest_complete, 0, 0);

[label,mistag_after]
~lost_tribe_return_brooch;
~chatnpc("<p,happy>Hello again, friend. The treaty holds. Kazgar will guide you through the mine whenever you want.");
@mistag_offer_escort;

// OSRS: returning the brooch to Mistag gets a mining helmet (the cache's %lost_tribe_returned_brooch).
[proc,lost_tribe_return_brooch]
if (%lost_tribe_returned_brooch = 1 | inv_total(inv, lost_tribe_brooch) = 0) {
    return;
}
~chatplayer("<p,neutral>I believe this brooch belongs to one of your people.");
~chatnpc("<p,happy>It does! Thank you. Here - have one of our mining helmets. It will light your way down here.");
inv_del(inv, lost_tribe_brooch, 1);
inv_add(inv, cave_goblin_mining_helmet_unlit, 1);
%lost_tribe_returned_brooch = 1;
mes("Mistag gives you a mining helmet.");
