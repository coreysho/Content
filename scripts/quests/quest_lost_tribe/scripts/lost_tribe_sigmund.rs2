// Sigmund, in Lumbridge castle (npc 2079, maps/m50_50.jm2).
//
// He is the Duke's advisor and, as it turns out, the thief. The cache keeps four more Sigmunds -
// lost_tribe_sigmund_leaving, _ham, _there, _ham_there - for the later Dorgesh-Kaan quests and the
// H.A.M. hideout. None of those is placed in any map, so only this one is scripted.

[opnpc1,lost_tribe_sigmund]
switch_int (%lost_tribe_quest) {
    case ^lost_tribe_investigate : @sigmund_dismiss;
    case ^lost_tribe_met_mistag : @sigmund_confront;
    // Everything else, including before the quest and after the key is taken, gets the brush-off.
    // Never fall off the end of the switch and leave him silent.
    case default : @sigmund_busy;
}

[label,sigmund_busy]
~chatnpc("<p,neutral>I am advisor to the Duke of Lumbridge. I am not here to make conversation.");

[label,sigmund_dismiss]
~chatplayer("<p,neutral>There's a hole in the castle cellar wall, and rubble all over the floor.");
~chatnpc("<p,angry>There is nothing of the sort.");
~chatplayer("<p,quiz>I've just come from down there.");
~chatnpc("<p,neutral>Then you have seen a damp wall and some fallen stone, and you have made a story out of it.");
~chatnpc("<p,shifty>The cellar is old. Old cellars crumble. There is nothing under Lumbridge but rock.");
~chatplayer("<p,quiz>Something took the Duke's silverware.");
~chatnpc("<p,angry>Rats took it, or a servant did. I will not have the Duke troubled with goblin stories.");
~chatnpc("<p,neutral>Go away.");
%lost_tribe_quest = ^lost_tribe_told_sigmund;
~send_quest_progress(questlist:lost_tribe, %lost_tribe_quest, ^lost_tribe_complete);

[label,sigmund_confront]
// He only turns his back the once. Without this the confrontation could be replayed for another
// key every time, which is harmless in itself but is how a chest ends up looted twice.
if (~obj_gettotal(lost_tribe_chest_key) > 0) {
    ~chatnpc("<p,angry>I have said all I intend to say to you.");
    return;
}
if (inv_total(inv, lost_tribe_brooch) = 0 | ~obj_gettotal(lost_tribe_book) = 0) {
    ~chatnpc("<p,angry>You again. Have you anything to say that is not about goblins?");
    ~chatplayer("<p,neutral>Not yet.");
    return;
}
~chatplayer("<p,neutral>The tribe under the castle is the Dorgeshuun. They've been down there since before Lumbridge was built.");
~chatnpc("<p,shock>...");
~chatplayer("<p,neutral>They didn't take the silverware. They didn't even know it was missing.");
~chatnpc("<p,angry>And you believe a goblin over your own kind.");
~chatplayer("<p,neutral>I believe the book.");
~chatnpc("<p,shifty>This conversation is finished. I have business elsewhere.");
if_close;
mes("Sigmund turns away so sharply that his cloak swings.");
if (inv_freespace(inv) = 0) {
    // He only turns his back once. Say what was missed rather than silently dropping it.
    ~mesbox("Something small and iron swings loose on his belt as he goes - and you have no free hand to take it with. Make some room and speak to him again.");
    return;
}
p_delay(1);
~mesbox("Something small and iron swings loose on his belt as he goes. You take it.");
inv_add(inv, lost_tribe_chest_key, 1);
