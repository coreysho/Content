[if_button,questlist:lost_tribe]
def_string $text;

switch_int (%lost_tribe_quest) {
    case ^lost_tribe_not_started :
        $text = "@dbl@I can start this quest by speaking to @dre@Sigmund@dbl@ in|";
        $text = append($text, "@dre@Lumbridge Castle@dbl@.|");
        $text = append($text, "@dbl@To complete this quest I need:|");
        $text = append($text, "@dbl@To have completed @dre@Goblin Diplomacy@dbl@ and @dre@Rune Mysteries|");
        $text = append($text, "@dbl@Level 13 @dre@Agility@dbl@, level 13 @dre@Thieving@dbl@ and level 17 @dre@Mining|");
        $text = append($text, "@dbl@A @dre@pickaxe@dbl@ and a @dre@light source");

    case ^lost_tribe_started :
        $text = "@str@Part of the cellar wall in Lumbridge Castle has collapsed,|";
        $text = append($text, "@str@and the Duke's silverware has gone missing.|");
        $text = append($text, "@dbl@Sigmund wants me to find out what happened. I should ask|");
        $text = append($text, "@dbl@around the castle and town - the @dre@Cook@dbl@, @dre@Hans@dbl@, @dre@Father Aereck|");
        $text = append($text, "@dbl@and @dre@Bob@dbl@ may have seen something");

    case ^lost_tribe_goblin_seen :
        $text = "@str@Part of the cellar wall in Lumbridge Castle has collapsed,|";
        $text = append($text, "@str@and the Duke's silverware has gone missing.|");
        $text = append($text, "@str@Someone saw a creature with huge eyes in the cellar.|");
        $text = append($text, "@dbl@I should tell @dre@Duke Horacio@dbl@ what I have learned");

    case ^lost_tribe_told_duke :
        $text = "@str@Part of the cellar wall in Lumbridge Castle has collapsed,|";
        $text = append($text, "@str@and the Duke's silverware has gone missing.|");
        $text = append($text, "@str@Someone saw a goblin-like creature in the cellar.|");
        $text = append($text, "@dbl@The Duke wants me to dig through the @dre@rubble@dbl@ in the|");
        $text = append($text, "@dbl@cellar with a @dre@pickaxe@dbl@ and see what is behind it");

    case ^lost_tribe_dug_through :
        $text = "@str@Someone saw a goblin-like creature in the castle cellar,|";
        $text = append($text, "@str@and I dug through the rubble to a cave behind the wall.|");
        $text = append($text, "@dbl@I should look around the @dre@cave@dbl@ and tell the @dre@Duke@dbl@ what I find");

    case ^lost_tribe_showed_brooch :
        $text = "@str@Behind the rubble in the castle cellar I found a cave,|";
        $text = append($text, "@str@and a stone brooch lying on its floor.|");
        $text = append($text, "@dbl@The Duke did not recognise its symbol. He suggested I ask|");
        $text = append($text, "@dre@Reldo@dbl@, the librarian in @dre@Varrock palace");

    case ^lost_tribe_read_book :
        $text = "@str@Behind the rubble in the castle cellar I found a cave,|";
        $text = append($text, "@str@and a stone brooch lying on its floor.|");
        $text = append($text, "@str@A book in the Varrock library says its symbol belongs to|");
        $text = append($text, "@str@the Dorgeshuun, a goblin tribe that went underground.|");
        $text = append($text, "@dbl@The goblin generals in the @dre@Goblin Village@dbl@ may know|");
        $text = append($text, "@dbl@more about the Dorgeshuun");

    case ^lost_tribe_learnt_emotes :
        $text = "@str@The creature in the cellar was one of the Dorgeshuun, a|";
        $text = append($text, "@str@goblin tribe that went underground long ago.|");
        $text = append($text, "@str@The goblin generals taught me how the old tribes greet|");
        $text = append($text, "@str@each other.|");
        $text = append($text, "@dbl@I should go through the hole in the @dre@cellar@dbl@, find the|");
        $text = append($text, "@dbl@Dorgeshuun and greet them with a @dre@goblin bow");

    case ^lost_tribe_bowed :
        $text = "@str@The creature in the cellar was one of the Dorgeshuun.|";
        $text = append($text, "@str@I found their miners at the end of the tunnels, and|");
        $text = append($text, "@str@greeted their leader with a goblin bow.|");
        $text = append($text, "@dbl@I should talk to @dre@Mistag");

    case ^lost_tribe_spoke_mistag :
        $text = "@str@The Dorgeshuun did not take the silverware - their mining|";
        $text = append($text, "@str@brought the cellar wall down by accident.|");
        $text = append($text, "@dbl@The Duke will not believe me while Sigmund tells him goblins|");
        $text = append($text, "@dbl@are thieves. I need to find out who really took the|");
        $text = append($text, "@dre@silverware@dbl@ - perhaps @dre@Sigmund@dbl@ knows more than he says");

    case ^lost_tribe_treaty_signed :
        $text = "@str@Sigmund, a member of H.A.M., stole the silverware to have|";
        $text = append($text, "@str@the goblins blamed. The Duke has dismissed him.|");
        $text = append($text, "@dbl@I should take the Duke's @dre@peace treaty@dbl@ to @dre@Mistag@dbl@.|");
        $text = append($text, "@dre@Kazgar@dbl@ can guide me through the mine");

    case ^lost_tribe_complete :
        $text = "@str@Someone emptied Duke Horacio's cellar of its silverware|";
        $text = append($text, "@str@through a hole in the wall.|");
        $text = append($text, "@str@Under the castle I found the Dorgeshuun, a tribe of cave|");
        $text = append($text, "@str@goblins who refused to fight in the god wars, and the|");
        $text = append($text, "@str@silverware in the H.A.M. hideout, where Sigmund had hidden it.|");
        $text = append($text, "@str@Lumbridge and the Dorgeshuun are at peace.||");
        $text = append($text, "@red@QUEST COMPLETE!");
}

~quest_journal("The Lost Tribe", $text);
