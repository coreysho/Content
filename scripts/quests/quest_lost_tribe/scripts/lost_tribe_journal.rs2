[if_button,questlist:lost_tribe]
def_string $text;

switch_int (%lost_tribe_quest) {
    case ^lost_tribe_not_started :
        $text = "@dbl@I can start this quest by speaking to @dre@Duke Horacio|";
        $text = append($text, "@dbl@in @dre@Lumbridge Castle|");
        $text = append($text, "@dbl@I will need a @dre@light source@dbl@ for the tunnels");

    case ^lost_tribe_investigate :
        $text = "@str@Someone has emptied Duke Horacio's cellar of its|";
        $text = append($text, "@str@silverware, through a locked door.|");
        $text = append($text, "@dbl@I should look at the @dre@cellar wall@dbl@ under the castle");

    case ^lost_tribe_told_sigmund :
        $text = "@str@Someone has emptied Duke Horacio's cellar of its|";
        $text = append($text, "@str@silverware. The cellar wall has been broken through|");
        $text = append($text, "@str@from the other side.|");
        $text = append($text, "@str@Sigmund, the Duke's advisor, says there is nothing|");
        $text = append($text, "@str@down there and that I imagined it.|");
        $text = append($text, "@dbl@I should tell the @dre@Duke@dbl@ what Sigmund said");

    case ^lost_tribe_way_open :
        $text = "@str@The Duke has had the cellar wall opened up.|";
        $text = append($text, "@dbl@I should go @dre@through the hole@dbl@ and find out who lives|");
        $text = append($text, "@dbl@down there. @dre@Kazgar@dbl@ can guide me through the mine.");

    case ^lost_tribe_met_mistag :
        $text = "@str@The tunnels are home to a tribe of cave goblins. Mistag|";
        $text = append($text, "@str@says they did not take the silverware, and that his|");
        $text = append($text, "@str@people will fight if Lumbridge sends soldiers down.|");
        $text = append($text, "@str@He gave me a brooch bearing his tribe's symbol.||");
        $text = append($text, "@dbl@I should find out what the symbol means - a @dre@library|");
        $text = append($text, "@dbl@might have a book on the goblin tribes|");
        $text = append($text, "@dbl@I should also work out who really took the silver");

    case ^lost_tribe_proved_sigmund :
        $text = "@str@The tribe under Lumbridge is the Dorgeshuun, and they|";
        $text = append($text, "@str@did not take the silverware - I found it in Sigmund's|");
        $text = append($text, "@str@own chest.||");
        $text = append($text, "@dbl@I should show the @dre@Duke@dbl@ the silverware, the brooch and|");
        $text = append($text, "@dbl@the book, and get him to sign a @dre@peace treaty");

    case ^lost_tribe_complete :
        $text = "@str@Someone emptied Duke Horacio's cellar through a hole in|";
        $text = append($text, "@str@the wall, and Sigmund his advisor was very keen that|");
        $text = append($text, "@str@nobody should look into it.|");
        $text = append($text, "@str@Under the castle I found the Dorgeshuun, a tribe of|");
        $text = append($text, "@str@cave goblins who left the wars generations ago, and the|");
        $text = append($text, "@str@Duke's silver in Sigmund's chest.|");
        $text = append($text, "@str@Lumbridge and the Dorgeshuun are at peace, and Sigmund|");
        $text = append($text, "@str@is nowhere to be found.||");
        $text = append($text, "@red@QUEST COMPLETE!");
}

~quest_journal("The Lost Tribe", $text);
