// Rag and Bone Man.
//
// Only three states: the Odd Old Man's list is checked against what is in the player's inventory
// when they come back, not tracked bone by bone, so there is nothing in between to record. That
// matches the cache, which allocates no varbits at all on rag_quest - the whole of the rag varbit
// block (rag_potboiler, rag_boiler, rag_inv_check, rag_wine, rag_helmet, rag_bonesack) hangs off
// rag_bone_2 and belongs to part two, which is not built here.
//
// ^rag_complete and ^rag_questpoints live in general/configs/quest.constant with every other
// quest's, so ~count_questpoints and ~update_questlist can see them.
^rag_not_started = 0
^rag_started = 1

// The five the Odd Old Man asks for. These are the first five rag_*_bone entries in the cache, in
// cache order, ahead of the thirty that belong to part two's collection.
^rag_bones_wanted = 5
