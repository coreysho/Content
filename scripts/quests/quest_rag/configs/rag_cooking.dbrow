// Boiling a bone clean is cooking, so it goes through the ordinary cooking table rather than a
// bespoke oplocu - [oplocu,_cooking_oven] and [oplocu,_cooking_fire] are already claimed by
// skill_cooking/scripts/cooking.rs2 and a trigger cannot be declared twice.
//
// successchance 1,1 is the table's "always succeeds" encoding (cooking.rs2:112). A bone cannot be
// ruined, so burnt is set to the cleaned bone as well, the way lava_eel does it - nothing can reach
// that branch, but a null there would hand inv_add a null on a failed roll.
//
// No experience: the Odd Old Man pays the Cooking XP for the whole job when the bones are handed
// over, and charging per pot as well would pay for the same work twice.

[rag_cooking_goblin]
table=cooking_generic
data=uncooked,rag_pot_goblin_bone
data=cooked,rag_polished_goblin_bone
data=burnt,rag_polished_goblin_bone
data=levelrequired,1
data=experience,0
data=successchance,1,1
data=successmessage,The vinegar boils away and the goblin skull comes up clean.

[rag_cooking_bear]
table=cooking_generic
data=uncooked,rag_pot_bear_bone
data=cooked,rag_polished_bear_bone
data=burnt,rag_polished_bear_bone
data=levelrequired,1
data=experience,0
data=successchance,1,1
data=successmessage,The vinegar boils away and the bear ribs come up clean.

