// Rum Deal - a brewery on an island full of people who are technically dead and entirely
// unbothered about it.

// =========================================================================== the crossing
[opnpc1,deal_pete]
if (%deal_quest = ^deal_not_started) {
    ~chatnpc("<p,neutral>You're new. Everyone here's dead and you're not, so you're new.");
    ~chatplayer("<p,quiz>What's the boat for?");
    ~chatnpc("<p,happy>Braindeath Island. Captain Braindeath brews rum on it and hasn't managed to brew any for eight months, and I've been sat here since.");
    ~chatnpc("<p,neutral>Get in if you like. It's not as if the boat's doing anything.");
    ~deal_cross;
    return;
}
~chatnpc("<p,neutral>Back and forth. Get in.");
~deal_cross;

[opnpc1,deal_island_pete]
if (%deal_quest >= ^deal_complete) {
    ~chatnpc("<p,happy>Eight months and then one afternoon. I'd be annoyed if I could still feel things properly.");
    return;
}
~chatplayer("<p,quiz>Can you row me back?");
~deal_cross;

// FIXED: this was [oploc1,deal_boat], and deal_boat is "Row boat" with no ops at all - the trigger
// could never fire and the island was unreachable. Pirate Pete is standing beside the boat at each
// end and already owns a handler, so he rows.
[proc,deal_cross]()()
if_close;
if (coordz(coord) > 5000) {
    mes("Pete rows you back to Port Phasmatys.");
    p_delay(4);
    p_teleport(^deal_pete_phasmatys);
    return;
}
mes("Pete rows you out past the harbour.");
p_delay(4);
p_teleport(^deal_island_landing);
if (%deal_quest = ^deal_not_started) {
    %deal_quest = ^deal_island;
    ~send_quest_progress(questlist:deal, %deal_quest, ^deal_complete);
    ~mesbox("Braindeath Island. It smells of a brewery that has not brewed anything in eight months, which is a worse smell than a brewery.");
}

// =========================================================================== Captain Braindeath
[opnpc1,deal_captian_braindeath]
switch_int (%deal_quest) {
    case ^deal_island : @deal_brief;
    case ^deal_crew :
        ~chatnpc("<p,neutral>Crew's working. Vat's still eaten through at the tap. Holy wrench - Davey does the blessing, the wrench is in the cupboard.");
    case ^deal_vat : @deal_recipe;
    case ^deal_brewing :
        ~chatnpc("<p,neutral>Five pulls on the pressure lever and we'll see what we've got.");
    case ^deal_spirit : @deal_finish;
    case default :
        if (%deal_quest >= ^deal_complete) {
            ~chatnpc("<p,happy>Braindeath rum. Nobody has ever asked what's in it and I'd like to keep it that way.");
            return;
        }
        ~chatnpc("<p,neutral>Talk to Pete.");
}

[label,deal_brief]
~chatnpc("<p,angry>Eight months. Eight months without a drop and the crew have got IDEAS.");
switch_int (~p_choice2("What's stopping you?", 1, "Everyone here is dead.", 2)) {
    case 2 :
        ~chatplayer("<p,neutral>Everyone here is dead.");
        ~chatnpc("<p,neutral>Aye. Doesn't stop a man wanting a drink, it just stops him needing one, which is worse.");
    case 1 :
        ~chatplayer("<p,quiz>What's stopping you?");
}
~chatnpc("<p,angry>Three things. The crew won't work, the vat's eaten through at the tap, and the ingredients have all gone to seed or swum off.");
~chatnpc("<p,neutral>Six Zombie Swabs out the front. They'll do as they're told if somebody tells them properly. I've tried asking.");
~chatplayer("<p,quiz>Properly?");
~chatnpc("<p,happy>Intimidate 'em. They're dead, not deaf.");

[label,deal_recipe]
~chatnpc("<p,happy>Vat holds. Now then. Five things go in the hopper and I'll not be taking questions about any of them.");
~chatnpc("<p,neutral>Blindweed off the patch - it's overgrown, there's a kit in the cupboard.");
~chatnpc("<p,neutral>A bucket of water out of the stagnant lake. Not the sea. The lake.");
~chatnpc("<p,neutral>A fever spider. A whole one.");
~chatnpc("<p,neutral>A karamthulhu. There's fishing spots round the shore and it's the only thing in them.");
~chatnpc("<p,neutral>And sluglings.");
~chatplayer("<p,quiz>Sluglings.");
~chatnpc("<p,happy>Sluglings.");

[label,deal_finish]
~chatplayer("<p,neutral>Something came out of the vat.");
~chatnpc("<p,neutral>Aye, that happens. Did you put it back?");
~chatplayer("<p,neutral>Not exactly.");
~chatnpc("<p,happy>Good enough.");
if_close;
mes("Captain Braindeath draws a bucket off the tap and looks at it for a long time.");
p_delay(4);
%deal_quest = ^deal_complete;
stat_advance(cooking, 70000);
stat_advance(farming, 70000);
stat_advance(slayer, 70000);
session_log(^log_adventure, "Quest complete: Rum Deal");
~send_quest_complete(questlist:deal, deal_slayer_gloves, 200, ^deal_questpoints, "You have completed\\nRum Deal!", "2 Quest Points|7,000 Cooking XP|7,000 Farming XP|7,000 Slayer XP|Slayer gloves");

// =========================================================================== the crew
// Six Zombie Swabs, six bits, and every one of them carries op3=Intimidate and had no handler.
// A varbit cannot be passed to a label, so each swab writes its own and then calls the count.
[opnpc3,deal_pirate_a]
if (~deal_can_intimidate(%deal_multi_pirate_a) = false) { return; }
%deal_multi_pirate_a = ^deal_on;
~deal_intimidated;

[opnpc3,deal_pirate_b]
if (~deal_can_intimidate(%deal_multi_pirate_b) = false) { return; }
%deal_multi_pirate_b = ^deal_on;
~deal_intimidated;

[opnpc3,deal_pirate_c]
if (~deal_can_intimidate(%deal_multi_pirate_c) = false) { return; }
%deal_multi_pirate_c = ^deal_on;
~deal_intimidated;

[opnpc3,deal_pirate_d]
if (~deal_can_intimidate(%deal_multi_pirate_d) = false) { return; }
%deal_multi_pirate_d = ^deal_on;
~deal_intimidated;

[opnpc3,deal_pirate_e]
if (~deal_can_intimidate(%deal_multi_pirate_e) = false) { return; }
%deal_multi_pirate_e = ^deal_on;
~deal_intimidated;

[opnpc3,deal_pirate_f]
if (~deal_can_intimidate(%deal_multi_pirate_f) = false) { return; }
%deal_multi_pirate_f = ^deal_on;
~deal_intimidated;

[proc,deal_can_intimidate](int $done)(boolean)
if (%deal_quest < ^deal_island) {
    ~chatnpc("<p,neutral>Wouldn't.");
    return(false);
}
if ($done = ^deal_on) {
    ~chatnpc("<p,sad>I'm working, I'm working.");
    return(false);
}
~chatnpc("<p,angry>Shan't.");
~chatplayer("<p,angry>You will.");
~chatnpc("<p,sad>...I'll get the mop.");
return(true);

[opnpc1,deal_pirate_a] ~deal_swab_talk;
[opnpc1,deal_pirate_b] ~deal_swab_talk;
[opnpc1,deal_pirate_c] ~deal_swab_talk;
[opnpc1,deal_pirate_d] ~deal_swab_talk;
[opnpc1,deal_pirate_e] ~deal_swab_talk;
[opnpc1,deal_pirate_f] ~deal_swab_talk;

[proc,deal_swab_talk]()()
~chatnpc("<p,neutral>Been dead eleven years. Still on the same watch.");

[proc,deal_intimidated]()()
def_int $n = 0;
if (%deal_multi_pirate_a = ^deal_on) { $n = add($n, 1); }
if (%deal_multi_pirate_b = ^deal_on) { $n = add($n, 1); }
if (%deal_multi_pirate_c = ^deal_on) { $n = add($n, 1); }
if (%deal_multi_pirate_d = ^deal_on) { $n = add($n, 1); }
if (%deal_multi_pirate_e = ^deal_on) { $n = add($n, 1); }
if (%deal_multi_pirate_f = ^deal_on) { $n = add($n, 1); }
if ($n < 6) {
    ~mesbox("<tostring($n)> of 6 swabs are working.");
    return;
}
if (%deal_quest ! ^deal_island) {
    return;
}
%deal_quest = ^deal_crew;
~send_quest_progress(questlist:deal, %deal_quest, ^deal_complete);
~mesbox("All six of them are working, badly, which is the most that has happened on this island in eight months.");

// =========================================================================== the wrench
[oploc1,deal_broomcupboard]
p_arrivedelay;
if (%deal_quest < ^deal_island) {
    ~mesbox("Somebody else's cupboard.");
    return;
}
if (inv_freespace(inv) < 2) {
    mes("You have no room for what is in it.");
    return;
}
mes("You open the cupboard.");
p_delay(2);
def_boolean $took = false;
if (inv_total(inv, deal_wrench) = 0 & inv_total(inv, deal_wrench_blessed) = 0) {
    inv_add(inv, deal_wrench, 1);
    $took = true;
}
if (inv_total(inv, deal_blindweed_seed) = 0 & inv_total(inv, deal_blindweed) = 0 & %deal_farming < ^deal_seeded) {
    inv_add(inv, deal_blindweed_seed, 1);
    $took = true;
}
if ($took = false) {
    ~mesbox("A mop, a rake, and a great deal of mildew.");
    return;
}
~mesbox("A wrench, a blindweed seed and about eight months of mildew.");

[opnpc1,deal_davey]
if (%deal_quest < ^deal_crew) {
    ~chatnpc("<p,neutral>I do the blessing. Somebody has to and I lost.");
    return;
}
if (inv_total(inv, deal_wrench) = 0) {
    if (inv_total(inv, deal_wrench_blessed) > 0) {
        ~chatnpc("<p,happy>It's about as holy as anything on this island gets.");
        return;
    }
    ~chatnpc("<p,neutral>There's a wrench in the broom cupboard. Bring it.");
    return;
}
~chatplayer("<p,quiz>Braindeath says you can bless this.");
~chatnpc("<p,neutral>I can bless anything. Whether it takes is between the thing and whoever's listening.");
if_close;
mes("Davey holds the wrench up, says something that is mostly vowels, and hands it back considerably shinier.");
p_delay(4);
inv_del(inv, deal_wrench, 1);
inv_add(inv, deal_wrench_blessed, 1);
~mesbox("A shining paragon of wrenchly virtue.");

[oploc1,deal_brewvat_tap]
p_arrivedelay;
if (%deal_quest >= ^deal_vat) {
    if (%deal_quest < ^deal_spirit) {
        ~mesbox("Nothing comes out of it yet.");
        return;
    }
    ~mesbox("The tap works, which after eight months is the whole of the news on this island.");
    return;
}
if (inv_total(inv, deal_wrench_blessed) = 0) {
    ~mesbox("The brass is eaten away all round the tap and a plain wrench would take the whole fitting off with it.");
    return;
}
anim(human_pickupfloor, 0);
p_delay(5);
%deal_quest = ^deal_vat;
~send_quest_progress(questlist:deal, %deal_quest, ^deal_complete);
stat_advance(crafting, 5000);
~mesbox("The holy wrench goes round without tearing anything, which a plain one would not have done. Davey is going to be insufferable about this.");

// =========================================================================== the blindweed patch
// deal_blindweed is a multiloc on deal_farming and the table is the whole mechanic:
// weeds3 -> weeds2 -> weeds1 -> empty -> seed -> fullygrown, and only fullygrown carries op1=Pick.
[oploc1,deal_blindweed]
p_arrivedelay;
if (%deal_farming ! ^deal_grown) {
    @deal_patch_work;
}
if (inv_freespace(inv) = 0) {
    mes("You have no room.");
    return;
}
anim(human_pickupfloor, 0);
p_delay(3);
inv_add(inv, deal_blindweed, 1);
%deal_farming = ^deal_empty;
stat_advance(farming, 3000);
~mesbox("Blindweed. An inedible, foul smelling herb, and it is going into something people will drink.");

[oploc2,deal_blindweed] @deal_patch_work;

[label,deal_patch_work]
p_arrivedelay;
if (%deal_quest < ^deal_vat) {
    ~mesbox("A blindweed patch, under eight months of everything else.");
    return;
}
switch_int (%deal_farming) {
    case ^deal_weeds3 :
    case ^deal_weeds2 :
    case ^deal_weeds1 :
        anim(human_pickupfloor, 0);
        p_delay(3);
        %deal_farming = add(%deal_farming, 1);
        stat_advance(farming, 500);
        if (%deal_farming = ^deal_empty) {
            mes("That is the last of the weeds.");
        } else {
            mes("You clear some of the weeds.");
        }
    case ^deal_empty :
        if (inv_total(inv, deal_blindweed_seed) = 0) {
            ~mesbox("Bare soil and nothing to put in it. There is a seed in the broom cupboard.");
            return;
        }
        inv_del(inv, deal_blindweed_seed, 1);
        %deal_farming = ^deal_seeded;
        stat_advance(farming, 1000);
        mes("You plant the seed.");
    case ^deal_seeded :
        // Nothing on this island is in a hurry and the blindweed least of all.
        %deal_farming = ^deal_grown;
        ~mesbox("It has come up already. Nothing on this island behaves the way it is supposed to.");
    case default :
        ~mesbox("A grown blindweed patch.");
}

// =========================================================================== the lake
[oplocu,deal_stagnant]
if (last_useitem ! bucket_empty) {
    ~displaymessage(^dm_default);
    return;
}
p_arrivedelay;
if (inv_total(inv, deal_stagnant_bucket) > 0) {
    ~mesbox("You have a bucket of it and one is more than enough.");
    return;
}
inv_del(inv, bucket_empty, 1);
inv_add(inv, deal_stagnant_bucket, 1);
mes("You fill the bucket from the lake.");
~mesbox("It's a bucket of... water?");

// =========================================================================== the squid
[opnpc1,deal_squid]
p_arrivedelay;
if (%deal_quest < ^deal_vat) {
    ~mesbox("Something is moving down there and it is not a fish.");
    return;
}
if (inv_total(inv, deal_karamthulhu) > 0) {
    ~mesbox("There is only ever one of them in a spot and you have this one.");
    return;
}
if (inv_total(inv, big_net) = 0 & inv_total(inv, net) = 0) {
    ~mesbox("You would need a net, and a big one would be better.");
    return;
}
if (inv_freespace(inv) = 0) {
    mes("You have no room.");
    return;
}
anim(human_smallnet, 0);
p_delay(5);
if (stat(fishing) < 30) {
    ~mesbox("You need a Fishing level of 30 to land whatever that is.");
    return;
}
inv_add(inv, deal_karamthulhu, 1);
%deal_squidfish = add(%deal_squidfish, 1);
stat_advance(fishing, 5000);
~mesbox("A karamthulhu. A sinister looking squid, and it is looking.");

// =========================================================================== sluglings
// deal_slugling: "They look at you balefully. 'Feed us...'"
[opnpc1,deal_captian_donnie]
if (%deal_quest < ^deal_vat) {
    ~chatnpc("<p,neutral>Donnie. I keep the bait.");
    return;
}
if (inv_total(inv, deal_slugling) > 0 | %deal_slug > 0) {
    ~chatnpc("<p,neutral>Don't feed them. Whatever you do.");
    return;
}
~chatplayer("<p,quiz>Braindeath says you have sluglings.");
~chatnpc("<p,angry>He says that like it's a thing a man should be pleased about.");
if (inv_freespace(inv) = 0) {
    ~chatnpc("<p,neutral>In what?");
    return;
}
inv_add(inv, deal_slugling, 1);
%deal_slug = 1;
~chatnpc("<p,sad>Take the lot. And don't feed them, because they ask.");

[opheld1,deal_slugling]
~mesbox("They look at you balefully. | 'Feed us...'");

// The fever spiders carry op2=Attack and nothing else, so there is no Talk-to handler here to
// write - you kill one and take the body off the drop table.

// =========================================================================== the hopper
[oplocu,deal_hopper]
def_obj $in = last_useitem;
p_arrivedelay;
if (%deal_quest < ^deal_vat) {
    ~mesbox("The vat leaks at the tap. There is no point putting anything in the top of it yet.");
    return;
}
if ($in = deal_blindweed | $in = deal_stagnant_bucket | $in = deal_spider_body | $in = deal_karamthulhu | $in = deal_slugling) {
    inv_del(inv, $in, 1);
    mes("In it goes.");
    ~deal_hopper_check;
    return;
}
~mesbox("Braindeath was specific, which is not like him, so stick to the five.");

[proc,deal_hopper_check]()()
if (inv_total(inv, deal_blindweed) > 0) { return; }
if (inv_total(inv, deal_stagnant_bucket) > 0) { return; }
if (inv_total(inv, deal_spider_body) > 0) { return; }
if (inv_total(inv, deal_karamthulhu) > 0) { return; }
if (inv_total(inv, deal_slugling) > 0) { return; }
if (%deal_quest ! ^deal_vat) { return; }
if (%deal_multi_hopper = 0) {
    %deal_multi_hopper = 1;
}
%deal_quest = ^deal_brewing;
~send_quest_progress(questlist:deal, %deal_quest, ^deal_complete);
~mesbox("All five of them are in the hopper and the hopper has started to turn on its own, which nobody asked it to do.");

// =========================================================================== the pressure lever
// deal_multi_lever reads deal_barrel: down at 0-4 and up at 5. Five pulls.
[oploc1,deal_multi_lever]
p_arrivedelay;
if (%deal_quest < ^deal_brewing) {
    ~mesbox("The lever moves and nothing anywhere responds to it.");
    return;
}
if (%deal_quest > ^deal_brewing) {
    ~mesbox("The barrel is at pressure and has been since.");
    return;
}
anim(human_leverdown, 0);
p_delay(2);
if (%deal_barrel < ^deal_pressure_full) {
    %deal_barrel = add(%deal_barrel, 1);
}
if (%deal_barrel < ^deal_pressure_full) {
    mes("The pressure barrel takes it. <tostring(%deal_barrel)> of <tostring(^deal_pressure_full)>.");
    return;
}
%deal_multi_hopper = 2;
if_close;
mes("The fifth pull takes and the whole brewery starts working at once.");
p_delay(5);
~deal_spirit_fight;

[oploc2,deal_pressure]
~mesbox("The pressure barrel is at <tostring(%deal_barrel)> of <tostring(^deal_pressure_full)>.");

[proc,deal_spirit_fight]()()
~mesbox("Something comes up the pipe that is not rum, and it has been in that vat for a long time, and it is extremely annoyed about the five things you have just put in on top of it.");
p_delay(3);
~damage_self(14);
mes("The Evil Spirit is made largely of last year's brewing.");
p_delay(4);
~damage_self(8);
mes("It goes back down the pipe in pieces.");
p_delay(3);
%deal_thulhu = 1;
%deal_quest = ^deal_spirit;
~send_quest_progress(questlist:deal, %deal_quest, ^deal_complete);
stat_advance(attack, 10000);
~mesbox("The tap runs. What comes out of it is brown and moves slowly and Captain Braindeath is going to sell it.");

// =========================================================================== odds
[opnpc1,deal_50luke]
if (%deal_quest < ^deal_island) {
    ~chatnpc("<p,neutral>Fifty percent.");
    return;
}
~chatplayer("<p,quiz>Why do they call you 50% Luke?");
~chatnpc("<p,neutral>Because I do half of everything.");
~chatplayer("<p,quiz>Half of what?");
~chatnpc("<p,neutral>Exactly.");

[oploc1,deal_gate_closed]
p_arrivedelay;
~mesbox("The gate is shut and 50% Luke is on the other side of it doing half of his job, which is the half where the gate stays shut.");

[opheld1,deal_bucket_swill]
~mesbox("Sorry, I mean a bucket of 'rum'.");
