// The giant kebbit that has the silver feather (474 npc 5137): level 13, 50 hitpoints, a max hit of 1
// (OSRS wiki). It jumps out of the opening at the end of the trail; the feather is its drop.
[eagle_kebbit]
name=Kebbit
desc=A little bigger than usual...
model1=npc_eagle_kebbit_1
model2=npc_eagle_kebbit_2
model3=npc_eagle_kebbit_3
