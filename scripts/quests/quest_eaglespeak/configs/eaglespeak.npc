param=attack_anim,eagle_kebbit_attack
param=defend_anim,eagle_kebbit_defend
param=death_anim,eagle_kebbit_death
param=death_drop,bones

// The boulder in the tunnel out of the Uzer eyrie (474 npc 5140): pushed aside from the desert side with
// 45 Strength, after which it stays out of that player's way (eaglespeak_boulder_pushed).
[eagle_boulder]
name=Boulder
desc=It's blocking the way out.
model1=npc_eagle_boulder_1
size=2
readyanim=eagle_boulder_ready
walkanim=eagle_boulder_roll
op1=Push

[eagle_boulder_shell]
