// Eagles' Peak - see eaglespeak.varp.

// How many of the three metal feathers are in the stone door's engraving (0-3): both halves of the
// door are multis on it, empty, part-filled and complete as 474 draws them (474 loc 19991's children).
[eaglespeak_door_count]
basevar=eaglespeak_bits
startbit=0
endbit=1

// Which feathers are in it, so the same one cannot be put in twice.
[eaglespeak_door_bronze]
basevar=eaglespeak_bits
startbit=2
endbit=2

[eaglespeak_door_silver]
basevar=eaglespeak_bits
startbit=3
endbit=3

[eaglespeak_door_gold]
basevar=eaglespeak_bits
startbit=4
endbit=4

// The silver feather's trail across the kebbit's room: 1 the pedestal inspected (the first stretch of
// footprints shows), 3 the first heap of rocks (the trail to it, and on from it), 4 the second heap
// (on to the opening), 5 the kebbit dealt with (the feather lies at the opening), 6 the feather taken.
// The trail pieces are multis on it (474's own thresholds, 1 to 4).
[eaglespeak_silver_trail]
basevar=eaglespeak_bits
startbit=5
endbit=7

// The bronze feather's room: the net has been sprung, and which of the four winches are wound.
[eaglespeak_bronze_net]
basevar=eaglespeak_bits
startbit=8
endbit=8

[eaglespeak_winches]
basevar=eaglespeak_bits
startbit=9
endbit=12

// Asyff has made the first pair of costumes (from then on he offers "another" for 25 coins).
[eaglespeak_costume_made]
basevar=eaglespeak_bits
startbit=13
endbit=13

// The boulder in the Uzer eyrie's tunnel has been pushed out of the way from the desert side.
[eaglespeak_boulder_pushed]
basevar=eaglespeak_bits
startbit=14
endbit=14

// The Feldip vine under the jungle eagles' cave: 0 young, 1 wrapped round a cane, 2 growing, 3 tall.
// 474 loc 19993's children, a multi on it.
[eaglespeak_vine]
basevar=eaglespeak_bits
startbit=15
endbit=16

// Nickolaus has called out across the chasm (the first time the player comes to the ledge).
[eaglespeak_ledge_seen]
basevar=eaglespeak_bits
startbit=17
endbit=17

// Asyff has been asked for the costumes and said what he needs (from then on the player asks "again").
[eaglespeak_asked_asyff]
basevar=eaglespeak_bits
startbit=18
endbit=18

// The player came into the Uzer eyrie from the desert while the boulder was still in the tunnel, so is on
// its desert side (and can go back out that way).
[eaglespeak_uzer_desert_side]
basevar=eaglespeak_bits
startbit=19
endbit=19
