// Eagles' Peak (28 November 2006, a week after Hunter). Stages of %eaglespeak. The camp at the foot of
// the mountain, the rocky outcrop at the top and Nickolaus are multis on it (eaglespeak.loc/.npc).
^eaglespeak_not_started = 0
// Charlie at Ardougne Zoo has sent the player after Nickolaus.
^eaglespeak_started = 1
// The metal feather fell out of the bird book at Nickolaus's abandoned camp.
^eaglespeak_feather = 2
// The metal feather has opened the rocky outcrop at the top of the mountain.
^eaglespeak_passage = 3
// Nickolaus, across the chasm, has asked for a disguise for each of them.
^eaglespeak_help = 4
// Nickolaus has his disguise; he is back at his camp (and still, in it, in the nest).
^eaglespeak_disguised = 5
// Nickolaus has shown the player how to box-trap a ferret, and given them that one.
^eaglespeak_ferret = 6
^eaglespeak_complete = 7

// Reward: 2 quest points and 2,500 Hunter experience (x10 here).
^eaglespeak_reward_xp = 25000

// Needed to be sent at all (Charlie: "I need somebody with a little more experience").
^eaglespeak_hunter_level = 27

// Asyff's price: 10 eagle feathers, swamp tar and yellow dye, and 50 coins for the pair; 25 for another.
^eaglespeak_costume_feathers = 10
^eaglespeak_costume_price = 50
^eaglespeak_costume_price_again = 25

// The eagle transport: 35 Agility for the Rellekka handholds, 45 Strength for the Uzer boulder; the
// Feldip vine is climbable 40 minutes (4,000 ticks) after it is given a cane.
^eaglespeak_handholds_agility = 35
^eaglespeak_boulder_strength = 45
^eaglespeak_vine_ticks = 4000

// The gold feather room: how long a moved bird or gate, or a pulled lever, stays put untouched (an hour).
^eaglespeak_gold_duration = 6000
