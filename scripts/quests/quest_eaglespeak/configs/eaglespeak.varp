// Eagles' Peak (28 November 2006). The quest's stage (quest_eaglespeak.constant has the values);
// transmitted, because the camp at the foot of the mountain, the rocky outcrop and Nickolaus himself are
// multis on it.
[eaglespeak]
scope=perm
transmit=yes

// The quest's smaller state, as varbits (eaglespeak.varbit): the stone door's feathers, the silver
// feather's trail, the bronze feather's winches, Asyff's first costume, the Uzer boulder and the
// Feldip vine. Transmitted for the door, the trail and the vine, which are multis on it.
[eaglespeak_bits]
scope=perm
transmit=yes

// When the Feldip vine was given its cane, in clock ticks (map_clock): it is climbable 40 minutes on.
[eaglespeak_vine_planted]
scope=perm
