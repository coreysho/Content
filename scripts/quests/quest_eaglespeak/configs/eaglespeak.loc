// ---- The gold feather room's four eagle levers (474 locs 19946-19949) ----
// 474 kept each lever's position in a varbit of the player's; this build keeps the room's whole puzzle -
// levers, gates and metal birds - in the world, the way the reset lever outside the room implies (it
// puts back what somebody else has left). So each lever is two plain locs, up and down.

[eagle_gold_lever_sw]
name=Eagle lever
desc=A small lever seems to be set in the beak of this eagle carving.
model=loc474_19877
model2=loc474_19877_2
active=yes
forceapproach=south
op1=Pull-down

[eagle_gold_lever_sw_down]
name=Eagle lever
desc=A small lever seems to be set in the beak of this eagle carving.
model=loc474_19878
model2=loc474_19878_2
active=yes
forceapproach=south
op2=Push-up

[eagle_gold_lever_nw]
name=Eagle lever
desc=A small lever seems to be set in the beak of this eagle carving.
model=loc474_19877
model2=loc474_19877_2
active=yes
forceapproach=south
op1=Pull-down

[eagle_gold_lever_nw_down]
