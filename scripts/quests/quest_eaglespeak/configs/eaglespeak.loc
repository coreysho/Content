// ---- The rocky outcrop at the top of the mountain (474 locs 19790, 19844, 19845) ----
// An outcrop with a feather carved over a slot until the metal feather has been put in it; from then on a
// cave entrance, the rock face (474 loc 19927) swung out beside it.

[eagle_outcrop]
op1=Enter
op2=Inspect
width=2
length=2
multivar=eaglespeak
multiloc=0,loc474_19925
multiloc=1,loc474_19925
