// Eagles' Peak (28 November 2006): the quest's own loc configs. The art is 474's (eaglespeak_map.loc,
// imported by this round's importeagle.py); these are the transformers 474 drew on its quest varbits,
// re-pointed at this build's varps (eaglespeak.varp/.varbit), and the gold feather room's levers.

// ---- The camp at the foot of Eagles' Peak (474 locs 19784-19789, on 474's quest varbit 2780) ----
// Tidy while nobody has been sent after Nickolaus, and again once he is back from the eagles' nest
// (^eaglespeak_disguised on); in between it is abandoned - the fire burning low, the books kicked over,
// the gear trampled, which is when the fire, books and gear can be Inspected.

[eagle_camp_firepit]
multivar=eaglespeak
multiloc=0,loc474_19879
multiloc=5,loc474_19879
multiloc=6,loc474_19879
multiloc=7,loc474_19879
multiloc=1,loc474_19880
multiloc=2,loc474_19880
multiloc=3,loc474_19880
multiloc=4,loc474_19880

[eagle_camp_fire]
op1=Inspect
forcedecor=yes
multivar=eaglespeak
multiloc=0,loc474_19881
multiloc=5,loc474_19881
multiloc=6,loc474_19881
multiloc=7,loc474_19881
multiloc=1,loc474_19884
multiloc=2,loc474_19884
multiloc=3,loc474_19884
multiloc=4,loc474_19884

