// --- The lighthouse's ranged dagannoths (horror_dagganoth_jr / _darker / _lighter, npcs 1338-1340) ---
// Moved out of _unpack/377/all.npc (2026-09-08) so they can carry a real attackrange field.
//
// These are the level-74 Dagannoths on the basalt causeway outside the lighthouse. They are ranged
// attackers (param=damagetype,^ranged_style, proj_travel=dagannoth_arrow_spotanim_travel) and
// horror_dagannoth.rs2 wires them to ~npc_default_retaliate_ap + ~dagannoth_rangeattack (since the
// PlagueCityRS 349 port; ~npc_rangeattack before it) - but every one of
// their cache blocks set param=attackrange,7 and NOT the attackrange= config field, and those are
// two completely different things:
//
//   param=attackrange  is read by nothing anywhere in this repo. Grep it.
//   attackrange=       is the opcode field the ENGINE reads, in exactly one place that matters -
//                      Npc.ts:951, `this.checkApTrigger() && this.inApproachDistance(type.attackrange,
//                      this.target)`. NpcType.attackrange defaults to 0, and inApproachDistance
//                      explicitly returns false when the two entities intersect, so a range of 0 can
//                      never be satisfied by anything.
//
// The result was an npc that retaliates into applayer2 mode, walks up to the player, and then stands
// there forever: the ap trigger it needs is gated on a distance it can never reach. Nothing else in
// the ranged path was wrong. Setting the field to 7 - the value the param already claimed - is the
// whole fix.
//
// Everything below is a byte-for-byte copy of the original all.npc blocks apart from that one added
// line per npc.

[horror_dagganoth_jr]
name=Dagannoth
desc=A horror from the ocean depths...
model1=poh_dagganoth_8
resizeh=64
resizev=64
walkanim=horror_dagannoth_walk
readyanim=horror_dagannoth_ready
op2=Attack
vislevel=74
attackrange=7
wanderrange=5
maxrange=8
huntrange=4
respawnrate=30
hitpoints=70
attack=68
strength=70
defence=50
magic=1
ranged=1
param=strengthbonus,13
param=rangebonus,13
param=damagetype,^ranged_style
param=attack_anim,horror_dagannoth_attack
param=defend_anim,horror_dagannoth_defend
param=death_anim,horror_dagannoth_death
param=slayer_category,^slayer_dagannoth
huntmode=aggressive_melee
param=rangeattack,100
param=attackrange,7
param=proj_travel,dagannoth_arrow_spotanim_travel
param=proj_height,40

