// Horror from the Deep - combat content (quest_horror). Migrated from the raw 377 cache dump
// (content/scripts/_unpack/377/all.npc), same pattern as areas/area_waterbirth/configs/
// dagannoth_kings.npc: base appearance/model/anim fields below "op2=Attack" (or "vislevel=100" where
// op2 already exists) are untouched raw cache values, everything from "param=slayer_category" onward
// (existing in the cache) plus the stat/param block after it (new) wires these into skill_combat.
//
// Stats sourced from the OSRS wiki for "Dagannoth (Horror from the Deep)" and "Dagannoth Mother":
// both share the exact same base stat block (level 100, 120 hp, 78 atk/str, 81 def, 1 magic, 50
// ranged, stab melee, max hit 9, all attack/defence bonuses +0, attack speed 4 ticks) - Mother's is
// just layered with the elemental/style weakness-cycling mechanic on top (see horror_dagannoth.rs2
// and the matching edits in skill_combat/scripts/player/player_{melee,ranged,magic}.rs2). Explicitly
// excludes the 25 Jun 2025 "35% earth spell weakness" update added to the generic Dagannoth - that
// postdates this server's January 2006 target era.
//
// horror_dagannoth_jr1/jr2/jr3 and horror_dagganoth_aira/airb/airc are the emergence stages (still in
// _unpack/377/all.npc). The PlagueCityRS 349 port (2026-09-25) spawns them out of the water in
// Jossik's cave and changes them into jr4 / the Mother - see horror_lighthousekeeper.rs2 and
// horror_dagannoth.rs2. Stats and bonuses below stay ours; the port added only its behavioural
// fields (category, timer, attackrange, ranges and sounds).

[horror_dagannoth_jr4]
name=Dagannoth
desc=A horror from the ocean depths...
model1=poh_dagganoth_8
recol1s=13740
recol1d=14796
recol2s=12683
recol2d=13739
recol3s=11626
recol3d=13706
recol4s=10569
recol4d=12649
vislevel=100
size=2
resizeh=82
resizev=82
walkanim=horror_dagannoth_walk
readyanim=horror_dagannoth_ready
op2=Attack
param=slayer_category,^slayer_dagannoth
hitpoints=120
attack=78
strength=78
defence=81
magic=1
ranged=50
param=stabdefence,0
param=slashdefence,0
param=crushdefence,0
param=magicdefence,0
param=rangedefence,0
param=attackbonus,0
param=strengthbonus,0
param=damagetype,^stab_style
param=attackrate,4
param=attackrange,1
param=attack_anim,horror_dagannoth_attack
param=defend_anim,horror_dagannoth_defend
param=death_anim,horror_dagannoth_death
param=retreat,0
// PlagueCityRS 349 port: roams the cave once it has surfaced (it is only ever spawned for one player).
maxrange=20
wanderrange=63
param=attack_sound,dagganoth_attack
param=defend_sound,dagganoth_hit
param=death_sound,dagganoth_death

[horror_dagganoth_air]
name=Dagannoth mother
desc=A horror from the ocean depths...
model1=poh_dagganoth_8
recol1s=13740
recol1d=21140
