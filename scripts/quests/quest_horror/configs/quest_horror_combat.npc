// Horror from the Deep - combat content (quest_horror). Migrated from the raw 377 cache dump
// (content/scripts/_unpack/377/all.npc), same pattern as areas/area_waterbirth/configs/
// dagannoth_kings.npc: base appearance/model/anim fields below "op2=Attack" (or "vislevel=100" where
// op2 already exists) are untouched raw cache values, everything from "param=slayer_category" onward
// (existing in the cache) plus the stat/param block after it (new) wires these into skill_combat.
//
// Stats sourced from the OSRS wiki for "Dagannoth (Horror from the Deep)" and "Dagannoth Mother":
// both share the exact same base stat block (level 100, 120 hp, 78 atk/str, 81 def, 1 magic, 50
// ranged, stab melee, max hit 9, all attack/defence bonuses +0, attack speed 4 ticks) - Mother's is
// just layered with the elemental/style weakness-cycling mechanic on top (see quest_horror_combat.rs2
// and the matching edits in skill_combat/scripts/player/player_{melee,ranged,magic}.rs2). Explicitly
// excludes the 25 Jun 2025 "35% earth spell weakness" update added to the generic Dagannoth - that
// postdates this server's January 2006 target era.
//
// horror_dagannoth_jr1/jr2/jr3 (emergence animation stages, no op2/combat params - not fought
// directly) precede jr4 in the cache; horror_dagganoth_aira/airb/airc are Dagannoth Mother's
// equivalent emergence stages. Wiring the actual emergence sequence (and where either of these
// spawns in the first place) is blocked on the same missing Waterbirth-area/dungeon coordinates
// flagged in the project doc - only the fightable end-states (jr4, and Mother's six phases) get
// combat capability here.

[horror_dagannoth_jr4]
name=Dagannoth
desc=A horror from the ocean depths...
model1=poh_dagganoth_8
recol1s=13740
recol1d=14796
recol2s=12683
recol2d=13739
recol3s=11626
recol3d=13706
recol4s=10569
recol4d=12649
vislevel=100
size=2
resizeh=82
resizev=82
walkanim=horror_dagannoth_walk
readyanim=horror_dagannoth_ready
op2=Attack
param=slayer_category,^slayer_dagannoth
hitpoints=120
attack=78
strength=78
defence=81
magic=1
ranged=50
param=stabdefence,0
param=slashdefence,0
param=crushdefence,0
param=magicdefence,0
param=rangedefence,0
param=attackbonus,0
param=strengthbonus,0
param=damagetype,^stab_style
param=attackrate,4
param=attackrange,1
param=attack_anim,horror_dagannoth_attack
param=defend_anim,horror_dagannoth_defend
param=death_anim,horror_dagannoth_death
param=retreat,0

[horror_dagganoth_air]
name=Dagannoth mother
desc=A horror from the ocean depths...
model1=poh_dagganoth_8
recol1s=13740
recol1d=21140
recol2s=12683
recol2d=20083
recol3s=11626
recol3d=19026
recol4s=10569
recol4d=17969
size=3
walkanim=horror_dagannoth_walk
readyanim=horror_dagannoth_ready
op2=Attack
resizeh=155
resizev=155
vislevel=100
param=slayer_category,^slayer_dagannoth
hitpoints=120
attack=78
strength=78
defence=81
magic=1
ranged=50
param=stabdefence,0
param=slashdefence,0
param=crushdefence,0
param=magicdefence,0
param=rangedefence,0
param=attackbonus,0
param=strengthbonus,0
param=damagetype,^stab_style
param=attackrate,4
// Ranged component (2026-09-08). attackrange= is the engine field NpcType.attackrange, which gates
// every ap trigger (Npc.ts:951) and defaults to 0 - param=attackrange, which this block already had,
// is read by nothing anywhere in the repo. Without the field her [ai_applayer2] handler could never
// fire and the hybrid below would be dead code. 8 tiles, matching the other dagannoth bosses.
// rangeattack/rangebonus stay 0 like attackbonus/strengthbonus above: the wiki's bonus table for her
// is all zeroes. Her ranged max hit is NOT derived from rangebonus - it is hardcoded 12 in
// ~dagmother_range_maxhit, the same shape as ~dagannoth_prime_maxhit, because the wiki gives her a
// flat "12x2" rather than a bonus to work back from.
attackrange=8
param=rangeattack,0
param=rangebonus,0
param=rangeattack_anim,horror_dagannoth_rangeattack
param=proj_travel,dagannoth_arrow_spotanim_travel
param=proj_height,40
param=attackrange,8
param=attack_anim,horror_dagannoth_attack
param=defend_anim,horror_dagannoth_defend
param=death_anim,horror_dagannoth_death
param=retreat,0

