// Horror from the Deep - the original quest stages (PlagueCityRS 349 port, 2026-09-25). %horrorquest
// is bits 0-10 of %deephorror; ^horror_complete (10) lives in general/configs/quest.constant.
// The bridge planks, Gunnjorn's key, the unlocked front door, the six items in the strange wall
// and the three lamp repairs are single-bit varbits of %deephorror beside it (quest_horror.varbit).
^horror_not_started = 0
^horror_started = 1
^horror_entered_lighthouse = 2
^horror_fixing_lighthouse = 3
^horror_repaired_lighthouse = 4
^horror_defeated_dagjr = 5

// Our own addition, kept: the Waterbirth maze's dagexp_exit_ladder climbs out into Jossik's cave
// (m39_72 plane 0), north of the strange wall - Corey confirmed it in game (2026-09-03, round 5).
// See area_waterbirth/scripts/waterbirth_dungeon.rs2 for the ladder itself.
^horror_maze_exit_dest = 0_39_72_14_36
