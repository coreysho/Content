// Horror from the Deep - ported from PlagueCityRS's 349 content (2026-09-25), original dialogue and stages.
[opnpc2,horror_dagannoth_jr4]
if (%npc_aggressive_player ! uid) {
    mes("It's not after you...");
    return;
}
@player_combat_start;

[apnpc2,horror_dagannoth_jr4]
if (%npc_aggressive_player ! uid) {
    mes("It's not after you...");
    return;
}
@player_combat_start_ap;

[ai_queue3,horror_dagannoth_jr4]
gosub(npc_death);
def_coord $spot = npc_coord;
if (npc_findhero = ^false) {
    return;
}
// ours, kept: big bones, as the drop viewer lists (drop_tables/configs/npc_drops.dbrow)
obj_add($spot, big_bones, 1, ^lootdrop_duration);
if (%npc_aggressive_player = uid) {
    if(%horrorquest = ^horror_repaired_lighthouse) {
        queue(queue_defeat_dagjr, 0, 0);
    }
}

[queue,queue_defeat_dagjr]
%horrorquest = ^horror_defeated_dagjr;
~chatplayer("<p,happy>Okay, now that the creature's dead we can get you out of here.");
if(inzone(0_39_72_0_0, 0_39_72_63_63, coord) = true) queue(spawn_dagmother, 0, 0);
if(npc_findexact(0_39_72_22_25, horror_lighthousekeeeper_injured) = ^true) {
    ~chatnpcnoturn("<p,scared>No... you do not understand...");
    ~chatnpcnoturn("<p,scared>That was not the creature that attacked me...");
    ~chatnpcnoturn("<p,scared>That was one of its babies...");
}

// works similar to sara wizards, check prayer so we dont get
// stuck in setmode loop if spam clicking
[opnpc2,_dagannoth_mother]
if (%npc_aggressive_player ! uid) {
    mes("It's not after you...");
    return;
}
if (~check_protect_prayer(^melee_style) = false) {
    npc_setmode(opplayer2);
}
@player_combat_start;

[apnpc2,_dagannoth_mother] 
if (%npc_aggressive_player ! uid) {
    mes("It's not after you...");
    return;
}
if (~check_protect_prayer(^ranged_style) = false) {
    npc_setmode(applayer2);
}
@player_combat_start_ap;

[ai_queue1,_dagannoth_mother]
if(npc_getmode = applayer2) ~npc_default_retaliate_ap;
else ~npc_default_retaliate;

// only melees in op, only ranges in ap, will switch to ranged if you're praying melee and vice versa
// if you switch prayer every tick she will never attack (matches osrs) :)
[ai_opplayer2,_dagannoth_mother]
if (~check_protect_prayer(^melee_style) = true) {
    npc_setmode(applayer2);
    return;
}
gosub(npc_default_attack);

[ai_applayer2,_dagannoth_mother]
if (~check_protect_prayer(^ranged_style) = true) {
    npc_setmode(opplayer2);
    return;
}
~dagannoth_rangeattack(12, ^true);

[proc,dagannoth_rangeattack](int $maxhit, int $double_roll)
if (%npc_action_delay > map_clock) {
    npc_setmode(applayer2);
    return;
}
if (~npc_check_notcombat = false) {
    npc_setmode(null);
    return;
}
if (~npc_check_notcombat_self = false) {
    return;
}

def_int $attack_roll = ~npc_ranged_attack_roll;
def_int $defence_roll = ~player_defence_roll_specific(^ranged_style); // TODO: confirm if this rolls against ranged def (prob does...)

npc_anim(horror_dagannoth_rangeattack, 0);
~.sound_area(dagganoth_spines, 0, npc_coord, 10);

%npc_action_delay = add(map_clock, npc_param(attackrate));
// map_projanim_v2	id=horror_spines_travel (294), starttime=10, endtime=66, angle=25, progress=50, startheight=210, endheight=110
def_int $duration = ~player_projectile(npc_coord, coord, uid, horror_spines_travel, 52, 28, 10, 25, 36, 50, 5);
def_int $damage = randominc($maxhit);
def_int $damage2 = randominc($maxhit);
if_close; // close the player interface when taking a hit.
if (~check_protect_prayer(^ranged_style) = true) { 
    $damage = 0;
    $damage2 = 0;
}
anim(%com_defendanim, $duration);
queue(combat_damage_player, calc($duration / 30), $damage);
if($double_roll = ^true) queue(combat_damage_player, calc($duration / 30), $damage2);
queue*(playerhit_n_retaliate, calc($duration / 30))(npc_uid);
~npc_set_attack_vars;

[ai_timer,horror_dagganoth_air]
if(finduid(%npc_aggressive_player) = true) {
    if(distance(coord, npc_coord) > 17) {
        npc_del;
        return;
    }
    npc_changetype(horror_dagganoth_water, 1000);
    %aggressive_npc = npc_uid;
    npc_say("Krrrrrrk");
    mes("The Dagannoth changes to blue...");
    // can switch mode between phase changes
    if(random(2) = 0) npc_setmode(opplayer2);
    else npc_setmode(applayer2);
    ~.sound_area(dagganoth_changes, 0, npc_coord, 10);
    return;
}
npc_del;

[ai_timer,horror_dagganoth_water]
if(finduid(%npc_aggressive_player) = true) {
    if(distance(coord, npc_coord) > 17) {
        npc_del;
        return;
    }
    npc_changetype(horror_dagganoth_melee, 1000);
    %aggressive_npc = npc_uid;
    npc_say("Chkhkhkhkhk");
    mes("The Dagannoth changes to orange...");
    if(random(2) = 0) npc_setmode(opplayer2);
    else npc_setmode(applayer2);
    ~.sound_area(dagganoth_changes, 0, npc_coord, 10);
    return;
}
npc_del;

[ai_timer,horror_dagganoth_melee]
if(finduid(%npc_aggressive_player) = true) {
    if(distance(coord, npc_coord) > 17) {
        npc_del;
        return;
    }
    npc_changetype(horror_dagganoth_earth, 1000);
    %aggressive_npc = npc_uid;
    npc_say("Krrrrrrssssssss");
    mes("The Dagannoth changes to brown...");
    if(random(2) = 0) npc_setmode(opplayer2);
    else npc_setmode(applayer2);
    ~.sound_area(dagganoth_changes, 0, npc_coord, 10);
    return;
}
npc_del;

[ai_timer,horror_dagganoth_earth]
if(finduid(%npc_aggressive_player) = true) {
    if(distance(coord, npc_coord) > 17) {
        npc_del;
        return;
    }
    npc_changetype(horror_dagganoth_fire, 1000);
    %aggressive_npc = npc_uid;
    npc_say("Sssssrrrkkkkk");
    mes("The Dagannoth changes to red...");
    if(random(2) = 0) npc_setmode(opplayer2);
    else npc_setmode(applayer2);
    ~.sound_area(dagganoth_changes, 0, npc_coord, 10);
    return;
}
npc_del;

[ai_timer,horror_dagganoth_fire]
if(finduid(%npc_aggressive_player) = true) {
    if(distance(coord, npc_coord) > 17) {
        npc_del;
        return;
    }
    npc_changetype(horror_dagganoth_ranged, 1000);
    %aggressive_npc = npc_uid;
    npc_say("Krkrkrkrkrkrkrkr");
    mes("The Dagannoth changes to green...");
    if(random(2) = 0) npc_setmode(opplayer2);
    else npc_setmode(applayer2);
    ~.sound_area(dagganoth_changes, 0, npc_coord, 10);
    return;
}
npc_del;

[ai_timer,horror_dagganoth_ranged]
if(finduid(%npc_aggressive_player) = true) {
    if(distance(coord, npc_coord) > 17) {
        npc_del;
        return;
    }
    npc_changetype(horror_dagganoth_air, 1000);
    %aggressive_npc = npc_uid;
    npc_say("Tktktktktktkt");
    mes("The Dagannoth changes to white...");
    if(random(2) = 0) npc_setmode(opplayer2);
    else npc_setmode(applayer2);
    ~.sound_area(dagganoth_changes, 0, npc_coord, 10);
    return;
}
npc_del;

[ai_queue3,_dagannoth_mother]
gosub(npc_death);
def_coord $spot = npc_coord;
// requires kill credit supposedly
if (npc_findhero = ^false) {
    return;
}
// ours, kept: big bones, as the drop viewer lists (drop_tables/configs/npc_drops.dbrow)
obj_add($spot, big_bones, 1, ^lootdrop_duration);
if (%npc_aggressive_player = uid) { // should always be true but just incase
    if(%horrorquest = ^horror_defeated_dagjr) {
        queue(quest_horror_complete, 0, 0);
    }
}

[queue,spawn_dagmother]
npc_huntall(0_39_72_24_36, 25, 0);
while (npc_findnext = true) {
    if(%npc_aggressive_player = uid) {
        npc_setmode(opplayer2);
        return;
    }
}
cam_moveto(0_39_72_18_37, 500, 50, 10);
p_delay(0);
def_coord $start = 0_39_72_10_34;
npc_add($start, horror_dagganoth_aira, 1000);
~.sound_area(dagganoth_chitters, 0, npc_coord, 10);
%npc_aggressive_player = uid;
%aggressive_npc = npc_uid;
hint_stop;
hint_npc;
cam_lookat(0_39_72_13_36, 100, 50, 10);
p_delay(1);
npc_changetype(horror_dagganoth_airb, 1000);
npc_walk(movecoord($start, 1, 0, 0));
p_delay(1);
npc_changetype(horror_dagganoth_airc, 1000);
npc_walk(movecoord($start, 2, 0, 0));
p_delay(1);
npc_changetype(horror_dagganoth_air, 1000);
npc_tele(map_findsquare(0_39_72_24_38, 0, 8, ^map_findsquare_lineofwalk));
npc_setmode(applayer2);
cam_reset;

// The level-74 Dagannoths on the lighthouse's basalt causeway: ranged only. Their drop tables are
// ours (drop_tables/scripts/dagannoth.rs2), as are their configs (quest_horror_combat.npc).
[ai_queue1,horror_dagganoth_jr] ~npc_default_retaliate_ap;
[ai_opplayer2,horror_dagganoth_jr] npc_setmode(applayer2);
[ai_applayer2,horror_dagganoth_jr] ~dagannoth_rangeattack(8, ^false);

[ai_queue1,horror_dagganoth_jr_lighter] ~npc_default_retaliate_ap;
[ai_opplayer2,horror_dagganoth_jr_lighter] npc_setmode(applayer2);
[ai_applayer2,horror_dagganoth_jr_lighter] ~dagannoth_rangeattack(8, ^false);

[ai_queue1,horror_dagganoth_jr_darker] ~npc_default_retaliate_ap;
[ai_opplayer2,horror_dagganoth_jr_darker] npc_setmode(applayer2);
[ai_applayer2,horror_dagganoth_jr_darker] ~dagannoth_rangeattack(8, ^false);

// Ours, kept: which of the Mother's colours a spell hurts. The original does this in its
// npc_max_dealt; this server does the same job inline in skill_combat/scripts/player/
// player_{melee,ranged,magic}.rs2 (and the salamander/chinchompa hooks in skill_hunter), which call
// this. Runs with her as the active npc. False blocks the spell's damage: only the matching
// elemental family hurts her white/blue/brown/red forms, and magic never hurts the orange/green ones.
[proc,dagmother_spell_matches_phase](int $spell)(boolean)
if (npc_type = horror_dagganoth_air & ($spell = ^wind_strike | $spell = ^wind_bolt | $spell = ^wind_blast | $spell = ^wind_wave)) {
    return(true);
}
if (npc_type = horror_dagganoth_water & ($spell = ^water_strike | $spell = ^water_bolt | $spell = ^water_blast | $spell = ^water_wave)) {
    return(true);
}
if (npc_type = horror_dagganoth_earth & ($spell = ^earth_strike | $spell = ^earth_bolt | $spell = ^earth_blast | $spell = ^earth_wave)) {
    return(true);
}
if (npc_type = horror_dagganoth_fire & ($spell = ^fire_strike | $spell = ^fire_bolt | $spell = ^fire_blast | $spell = ^fire_wave)) {
    return(true);
}
return(false);
