// --- Jossik: found injured, then the final reward exchange ---
// Only horror_lighthousekeeeper_well (npc 1334) is actually placed in the map (confirmed via
// content/maps/m39_56.jm2, plane 1, local(13,55) = world(2509,3639,1)) - horror_lighthousekeeeper_
// injured (npc 1335) exists in the cache but has zero placements anywhere in a 29-region search
// (see project doc). The original two-handler split assumed an npc_changetype from injured->well
// partway through, matching Dagannoth Mother's precedent elsewhere in this quest, but there's no
// confirmed way to target a *different*, non-combat npc instance for changetype from a loc/dialogue
// context in this codebase (npc_changetype's real precedents are all self-directed, from inside that
// same npc's own ai_queue hook) - guessing at one would be exactly the kind of unverified engine
// mechanic this build has been avoiding elsewhere. So this is one merged handler on the npc type
// that's actually live in the world; Jossik doesn't get a distinct battle-damaged model this pass,
// only the dialogue conveys he's shaken. If horror_lighthousekeeeper_injured is ever placed for real,
// split this back into two handlers along the original %horror boundaries.
[opnpc1,horror_lighthousekeeeper_well]
if (%horror = ^horror_wall_opened) {
    ~chatplayer("<p,shock>Jossik! Are you alright?");
    ~chatnpc("<p,sad>Adventurer! Thank Guthix... there are creatures down here, dagannoth of some kind. Please, be careful.");
    %horror = ^horror_dagannoth_defeated;
    // combat with the level 100 Dagannoth and Dagannoth Mother happens in the chambers below -
    // see the (not yet built) encounter scripts for horror_dagganoth_jr* / horror_dagganoth_aira etc.
    // TODO: this currently jumps straight from wall_opened to dagannoth_defeated on first meeting
    // Jossik rather than being set by the encounter scripts themselves once they exist - the combat
    // stages (^horror_dagannoth_defeated / ^horror_mother_defeated) should eventually be set by
    // those scripts on kill, with this dialogue only reacting to state rather than driving it.
    ~send_quest_progress(questlist:horror, 3, ^horror_complete);
} else if (%horror >= ^horror_dagannoth_defeated & %horror < ^horror_mother_defeated) {
    ~chatnpc("<p,worried>There's something bigger down there... I can hear it moving.");
} else if (%horror >= ^horror_mother_defeated & %horror < ^horror_casket_given) {
    ~chatplayer("<p,happy>I found this rusty casket where that creature was nesting.");
    ~chatnpc("<p,neutral>A casket? Let's get out of here and I'll take a look upstairs.");
    %horror = ^horror_casket_given;
    ~send_quest_progress(questlist:horror, 5, ^horror_complete);
} else if (%horror >= ^horror_casket_given & %horror < ^horror_complete) {
    ~chatplayer("<p,neutral>Here's that casket I found.");
    inv_del(inv, horror_casket, 1);
    ~chatnpc("<p,happy>Ah, I recognise this - it's one of ours. There should be a damaged prayer book inside. Which order would you like?");
    @multi4("A book of Saradomin.", horror_book_saradomin, "A book of Zamorak.", horror_book_zamorak, "A book of Guthix.", horror_book_guthix, "None for me, thanks.", horror_book_none);
} else if (%horror >= ^horror_complete) {
    ~chatnpc("<p,happy>I can sell you another damaged prayer book for 5,000 coins, if you'd like.");
    ~openshop_activenpc;
}

[label,horror_book_saradomin]
~chatplayer("<p,happy>A book of Saradomin.");
inv_add(inv, unfinished_saradominbook, 1);
~mesbox("Jossik hands you a damaged book of Saradomin, salvaged from the wreck of the casket.");
@finish_horror_quest;

[label,horror_book_zamorak]
~chatplayer("<p,happy>A book of Zamorak.");
inv_add(inv, unfinished_zamorakbook, 1);
~mesbox("Jossik hands you a damaged book of Zamorak, salvaged from the wreck of the casket.");
@finish_horror_quest;

[label,horror_book_guthix]
~chatplayer("<p,happy>A book of Guthix.");
inv_add(inv, unfinished_guthixbook, 1);
~mesbox("Jossik hands you a damaged book of Guthix, salvaged from the wreck of the casket.");
@finish_horror_quest;

[label,horror_book_none]
~chatplayer("<p,neutral>None for me, thanks.");
~chatnpc("<p,happy>Suit yourself - I'll keep hold of it in case you change your mind.");
@finish_horror_quest;

[label,finish_horror_quest]
~chatnpc("<p,happy>Thank you again for everything, adventurer. I don't know what would have happened to me down there without you.");
stat_advance(magic, 46625);
stat_advance(strength, 46625);
stat_advance(ranged, 46625);
mes("Congratulations, you've completed Horror from the Deep!");
%horror = ^horror_complete;
~send_quest_progress(questlist:horror, 6, ^horror_complete);
