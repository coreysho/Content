// Horror from the Deep - main quest dialogue and puzzles
// Walkthrough (re-verified this pass): https://oldschool.runescape.wiki/w/Horror_from_the_Deep
// Requires quest_barcrawl complete (already implemented - see ~visited_all_bars).
// Uses ~chatplayer/~chatnpc rather than ~mesbox's @tag@ speaker shorthand, since that shorthand
// depends on a per-NPC abbreviation registered elsewhere that I haven't located/verified for
// Larrissa/Jossik/Gunnjorn - safer to stick to the plain, confirmed primitives.
//
// Item/NPC/loc tags below were cross-checked against the real 377 cache dump
// (content/scripts/_unpack/377/all.{obj,npc,loc}) rather than guessed - the quest's actual assets
// are already present there (this cache already shipped this content in 2006), which is a much
// stronger source than my memory of the wiki walkthrough. Notable corrections made this pass:
//   - horror_lighthouse_key -> horror_key, horror_rusty_casket -> horror_casket (my invented names
//     were wrong - the real tags were sitting right there in all.obj)
//   - damaged prayer books are unfinished_saradominbook / unfinished_zamorakbook / unfinished_guthixbook
//   - bridge item is `woodplank` (all.obj name=Plank), not `plank`; nails item is `nails`
//     (all.obj name=Steel nails) - confirmed via the wiki that repair needs a hammer + 60 nails + 2
//     planks total, split across the two broken spans (horror_broken_bridge_left_spot /
//     _right_spot - both real loc tags, replacing my earlier guessed horror_broken_bridge1/2)
// All quest loc/NPC world placements below are now confirmed, cross-checked two ways: against
// content/maps/*.jm2 (id-based placement data, content/pack/{loc,npc}.pack for id<->name) and,
// for Larrissa, independently in-game via Corey's own ::getcoord (matched exactly). An earlier pass
// this session reported zero placements for several of these - that was wrong on two counts, both
// fixed: (1) a grep `$`-anchor bug against this file format's CRLF line endings silently ate real
// matches, and (2) horror_lighthouse_doorway's id was misread as 4578 (that's the .pack file's own
// line number) when the real id is 4577 (4578 is a different loc, horror_lighthouse_inactive).
//   - SUPERSEDED (horror2): the mechanism the quest repairs is horror_lighthouse_cog_broken (4588),
//     placed in the ransacked copy of the lighthouse (m38_71 p2 11,55) - it was never unplaced, the
//     search just never looked at m38_71. horror_lighthouse_windpower_cog (4590, m39_56 p2 11,50) is
//     the wind vane outside the railing. See "The two lighthouses" and "Lighting the lighthouse".
//   - horror_lighthouse_doorway (loc 4577): m39_56.jm2, plane 0, local(13,52) = world(2509,3636,0) -
//     Corey confirmed in-game this is the lighthouse's plain building entrance (real cache def:
//     op1=Walk-through), NOT the six-icon rune/sword/arrow puzzle door I'd guessed it was - that
//     puzzle's real loc is still unknown, see the comment above its (now commented-out) handler below.
//   - horror_ladder_top (loc 4383, real op1=Climb) / horror_ladder_down (loc 4380, no op, decorative):
//     m39_56.jm2, plane 0, local(13,60)/local(12,60) = world(2509,3644,0)/world(2508,3644,0) - the way
//     down to the basement, per Corey's in-game find ("iron ladder to basement"). No script exists for
//     the Climb op yet since there's no known destination - this is now the concrete blocker.
//   - horror_girlfriend_prequest / Larrissa (npc 1336): m39_56.jm2, plane 0, local(12,51) =
//     world(2508,3635,0) - matches Corey's in-game ::getcoord reading exactly.
//   - horror_lighthousekeeeper_well / Jossik (npc 1334): m39_56.jm2, plane 1, local(13,55) =
//     world(2509,3639,1). Only this variant is placed, not horror_lighthousekeeeper_injured (1335) -
//     see the merged opnpc1 handler below for how that's handled.
//   - gunnjorn (npc 607): m39_55.jm2, plane 0, local(44,28) = world(2540,3548,0) - near the real
//     Barbarian Outpost agility arena, matching his own dialogue.
// horror_girlfriend_postquest (1337) is placed after all - inside the m38_71 copy; see its handler below.
//
// UPDATE (2026-09-03): Corey supplied real in-game coords for the lighthouse basement this pass,
// resolving what used to be this quest's one real remaining blocker. horror_lighthousekeeeper_
// injured (1335, "Fallen Jossik") IS genuinely placed after all - m39_72.jm2, plane 0, local(22,25),
// matching Corey's coord exactly - so the merged well/injured handler below is now split back into
// two (see the "Fallen Jossik" section). The strange wall puzzle's real locs were also found in the
// same region (horror_mid_left_door/_mid_right_door, op1=Study; horror_far_right_door/_far_left_door,
// op1=Open - all four tagged "Strange wall", m39_72 plane 1, local z=19 x=17-20) and the six-icon rune/
// sword/arrow logic below is re-attached to them (wiki-reconfirmed this pass, see that section).
// SUPERSEDED (2026-09-24): the basement ladders, the boss spawns and the lighthouse doorway were all
// rewired to the OSRS layout - lighthouse -> basement south of the strange wall -> through the wall ->
// down to Jossik's cave, where both bosses are fought. The notes that used to sit here described the
// old, inverted wiring (lighthouse straight down to Jossik, bosses in m39_156, no way back up) and are
// replaced by the ladder section below and quest_horror.constant.

// Larrissa's dialogue follows the quest transcript (RS wiki and OSRS wiki, "Transcript:Horror from the
// Deep") branch for branch - every option, condition and outcome is the original's - but the lines are
// written in our own words rather than copied.
[opnpc1,horror_girlfriend_prequest]
if (%horror = ^horror_not_started) {
    @horror_larrissa_start;
}
if (%horror >= ^horror_mother_defeated) {
    @horror_larrissa_thanks;
}
if (%horror = ^horror_dagannoth_defeated) {
    @horror_larrissa_found_jossik;
}
if (getbit_range(%horror_lighting, 0, 2) = 7) {
    ~chatnpc("<p,sad>Have you found any sign of my Jossik yet?");
    ~chatplayer("<p,neutral>Not yet...");
    ~chatnpc("<p,sad>I came out here to see if I could find some trace of him... but there's nothing at all. I'm so worried...");
    ~chatplayer("<p,neutral>Don't worry, I'm sure he's fine. I'll find him somehow.");
    return;
}
def_boolean $bridge = false;
if (getbit_range(%horror_bridges, 0, 1) = 3) {
    $bridge = true;
}
if ($bridge = true & testbit(%horror_bridges, ^horror_door_unlocked_bit) = 1) {
    if (%horror = ^horror_started & %horror_lighting = 0) {
        ~chatnpc("<p,happy>Quickly, we must go inside and find out what has happened to my Jossik!");
        return;
    }
    // back outside with the light still out
    ~chatnpc("<p,angry>Adventurer! You have to do something about the broken light! Ships come round this coast - they mustn't be wrecked here!");
    ~chatplayer("<p,neutral>Okay, I'll see what I can do.");
    return;
}
if ($bridge = true & inv_total(inv, horror_key) > 0) {
    ~chatplayer("<p,happy>I've got your key for you!");
    ~chatnpc("<p,happy>Oh, thank you so much!");
    ~chatnpc("<p,happy>Quickly, we must go inside and find out what has happened to my Jossik!");
    return;
}
if (inv_total(inv, horror_key) > 0) {
    ~chatplayer("<p,happy>I've got your key for you!");
    ~chatnpc("<p,sad>Thank you, adventurer, but I need you to mend the bridge for me. A key to the lighthouse is little comfort while I'm stuck out here on this causeway!");
    return;
}
if ($bridge = true) {
    ~chatplayer("<p,happy>I've fixed the bridge for you!");
    ~chatnpc("<p,happy>Oh, thank you so much!");
    ~chatnpc("<p,sad>Please find the lighthouse key for me too, though! I can't bear to think something bad has happened to my Jossik...");
    return;
}
~chatplayer("<p,neutral>Hello again.");
~chatnpc("<p,sad>Oh, please find my darling! I just know something awful has happened!");
@horror_larrissa_options;

[label,horror_larrissa_start]
~chatnpc("<p,sad>Oh, thank Armadyl! I'm so worried... please, help me!");
if (~p_choice2("With what?", 1, "Sorry, just passing through.", 2) = 2) {
    @horror_larrissa_decline;
}
~chatplayer("<p,quiz>With what?");
~chatnpc("<p,sad>Oh... it's awful... My boyfriend lives here in this lighthouse, and I haven't seen him for days! I think something terrible has happened to him!");
~chatnpc("<p,sad>See for yourself - the light has gone out, and the front door is locked tight! He would NEVER do that!");
~chatnpc("<p,sad>Without the light this coast is deadly to ships! And why lock the front door, so nobody can light it again?");
~chatplayer("<p,neutral>Maybe he's just gone on holiday? Living in a lighthouse must be pretty dull.");
~chatnpc("<p,angry>That would be terribly irresponsible, and he's far too thoughtful! He'd never leave the light untended, and he'd never go without telling me!");
~chatnpc("<p,sad>Please, I know something dreadful has happened to him... I can feel it! Please help me, adventurer!");
if (~p_choice2("But how can I help?", 1, "Sorry, just passing through.", 2) = 2) {
    @horror_larrissa_decline;
}
~chatplayer("<p,quiz>But how can I help?");
~chatnpc("<p,neutral>Well, we have to get the lighthouse working again somehow! And as you may have noticed, the storm that broke the bridge has left me stranded on this causeway.");
~chatnpc("<p,neutral>You got here somehow, so if you could visit my cousin and fetch the spare key I left with him, and mend the bridge enough for me to get to Rellekka and tell my family what has happened, I'd be ever so grateful!");
if (~p_choice2_header("Yes.", 1, "No.", 2, "Start the Horror from the Deep quest?") = 2) {
    @horror_larrissa_decline;
}
// The one start requirement: Alfred Grimhand's Barcrawl (OSRS wiki infobox, "Questreqstart" yes).
// Its 35 Agility is NOT checked here - the same infobox marks it "Questreqstart" no; it is for the
// pipe on the Barbarian Outpost course between you and Gunnjorn, which barbarian_course.rs2 already
// enforces. No 2006 Larrissa line for the refusal is recorded anywhere (both transcripts give only the
// start prompt), so it is the game's own notice the RS transcript records at this point.
if (%barcrawl ! ^barcrawl_complete) {
    ~mesbox("You do not meet the requirements to start: 'Horror from the Deep'.");
    return;
}
~chatplayer("<p,happy>Okay, I'll help!");
%horror = ^horror_started;
~send_quest_progress(questlist:horror, 1, ^horror_complete);
~chatnpc("<p,happy>OH! THANK YOU SO MUCH! I know my darling would never have gone off with the light out and without even telling me where!");
@horror_larrissa_options;

[label,horror_larrissa_decline]
~chatplayer("<p,neutral>Sorry, just passing through.");
~chatnpc("<p,sad>Oh... my poor Jossik... I just know something terrible has happened...");

[label,horror_larrissa_options]
def_int $op = ~p_choice3("Where is your cousin?", 1, "How can I fix the bridge?", 2, "I'll see what I can do.", 3);
if ($op = 1) {
    ~chatplayer("<p,quiz>Where is your cousin?");
    if (testbit(%horror_bridges, ^horror_key_given_bit) = 1) {
        ~chatnpc("<p,confused>What? My cousin is the one who gave you my spare lighthouse key. Is your memory going, adventurer?");
        ~chatplayer("<p,shifty>Er... no... I was just... testing you. Yes. Testing.");
        return;
    }
    ~chatnpc("<p,neutral>My cousin was always mad about agility. He left our home in Rellekka long ago to follow it.");
    ~chatnpc("<p,neutral>I don't know exactly where he went, but it'll be somewhere he can practise his agility. His name is Gunnjorn - mention my name and he'll know it.");
    @horror_larrissa_options;
}
if ($op = 2) {
    ~chatplayer("<p,quiz>How can I fix the bridge?");
    ~chatnpc("<p,angry>Well, I'm not some helpless girl! My agility's good enough that two planks will do - a ledge I can balance along.");
    ~chatnpc("<p,neutral>Just use a plank on each side of the bridge. You'll need a hammer, and thirty steel nails for each plank. I think there are some planks around here...");
    @horror_larrissa_options;
}
~chatplayer("<p,neutral>I'll see what I can do.");
~chatnpc("<p,happy>Thank you so much!");

[label,horror_larrissa_found_jossik]
~chatplayer("<p,happy>I found Jossik! He's in a cavern under the lighthouse...");
~chatnpc("<p,happy>That's wonderful news! But why doesn't he come up out of there?");
~chatplayer("<p,shifty>Um... well, there's a big monster down there with him that won't let him leave.");
~chatnpc("<p,shock>What?!? You MUST save him! I'm begging you, please! Do something!");
~chatplayer("<p,neutral>Okay, okay, sheesh, keep your hair on...");

[label,horror_larrissa_thanks]
~chatnpc("<p,happy>Oh! Thank you so much for all your help rescuing my darling Jossik!");
~chatnpc("<p,happy>I don't know what would have become of him if you hadn't happened along this path!");
~chatplayer("<p,happy>Don't worry about it, I was glad to help.");

// The Larrissa inside the attacked lighthouse (m38_71 p0 13,55 - see "The two lighthouses" below).
// Despite its debugname this npc is not a post-quest one: it is the Larrissa who has followed you in,
// and only players between opening the door and killing the Dagannoth Mother ever see her.
[opnpc1,horror_girlfriend_postquest]
if (%horror >= ^horror_mother_defeated) {
    @horror_larrissa_thanks;
}
if (%horror = ^horror_dagannoth_defeated) {
    @horror_larrissa_found_jossik;
}
if (getbit_range(%horror_lighting, 0, 2) = 7) {
    ~chatplayer("<p,happy>I have managed to fix the light!");
    ~chatnpc("<p,happy>Excellent work, adventurer!");
    ~chatnpc("<p,happy>Now you can put all your energy into finding out what has happened to my darling Jossik!");
    return;
}
~chatnpc("<p,sad>This is terrible...");
~chatnpc("<p,sad>What can have happened here? Please, you have to fix the light - we can't let my Jossik take the blame for a shipwreck!");
if (~p_choice2("What am I supposed to be doing again?", 1, "Okay, I will see what I can do.", 2) = 2) {
    ~chatplayer("<p,neutral>Okay, I will see what I can do.");
    return;
}
~chatplayer("<p,quiz>What am I supposed to be doing again?");
~chatnpc("<p,angry>You MUST find a way to fix the light! Ships are in terrible danger for as long as it isn't working!");
~chatplayer("<p,quiz>Do you have any idea how I could do that?");
~chatnpc("<p,sad>I'm sorry, adventurer, I don't know anything about lighthouses.");
~chatnpc("<p,neutral>But there must be some sort of guide around here. Jossik knew nothing about lighthouses when he started, so the council must have left him a manual or something.");


// Gunnjorn. [opnpc1,gunnjorn] can only be declared once globally, so his base flavour lines (from
// area_barbarian_outpost/scripts/gunnjorn.rs2) live here too. The key hand-out follows the transcript:
// a first meeting where you ask for Larrissa's key, and a "lost that key" version if you come back
// without it - only while the door has never been opened (the key is used up in the lock). No room,
// no key. %horror_bridges bit ^horror_key_given_bit remembers the first meeting.
[opnpc1,gunnjorn]
~chatnpc("<p,happy>Haha welcome to my obstacle course.|Have fun, but remember this isn't a child's playground.|People have died here.");
if (%horror < ^horror_started | %horror >= ^horror_mother_defeated | inv_total(inv, horror_key) > 0 | testbit(%horror_bridges, ^horror_door_unlocked_bit) = 1) {
    ~chatnpc("<p,happy>The best way to train,|is to go round the course in a clockwise direction.");
    return;
}
if (testbit(%horror_bridges, ^horror_key_given_bit) = 1) {
    ~chatplayer("<p,sad>Hello again, Gunnjorn. I'm afraid I've lost that key you gave me.");
    if (inv_freespace(inv) = 0) {
        ~chatnpc("<p,neutral>I'd give you another, but you don't seem to have any room for it.");
        return;
    }
    ~chatnpc("<p,happy>No problem. Here you go.");
    inv_add(inv, horror_key, 1);
    return;
}
~chatplayer("<p,quiz>Hi, are you called Gunnjorn?");
~chatnpc("<p,happy>Why, I am indeed! This agility course is mine - it can be very dangerous!");
~chatplayer("<p,neutral>Yes, that's great. Anyway, I hear you have a cousin called Larrissa who gave you a key...?");
~chatnpc("<p,quiz>So she did! How do you know about that? She said she probably wouldn't need it, but gave it to me for safe keeping, just in case.");
~chatplayer("<p,neutral>Well, something has happened at the lighthouse, and she's been locked out. I need you to give me her key.");
if (inv_freespace(inv) = 0) {
    ~chatnpc("<p,neutral>I'd give you the key, but you don't seem to have any room for it.");
    return;
}
~chatnpc("<p,happy>Sure. Here you go.");
inv_add(inv, horror_key, 1);
%horror_bridges = setbit(%horror_bridges, ^horror_key_given_bit);


// --- The Lighthouse's front doorway (loc 4577) ---
// op1=Walk-through. The doorway is a shape-0 wall on the SOUTH edge of its own tile (m39_56 plane 0
// local(13,52) = 2509,3636, angle 3), so outside is z < 3636 and the lighthouse is z >= 3636.
//
// FIXED: the old handler compared coordz(coord) - an ABSOLUTE z of about 3635 - against the local
// value 52, so the test was never true and every click took the player two tiles further south.
// Nobody could get into the lighthouse at all. The sides are now read against the loc's own tile,
// which also makes the same handler right for the m38_71 copy of the building.
//
// The door is locked until Gunnjorn's key has been through it once, as in OSRS. The key only has to
// be carried the first time: %horror_bridges bit 2 remembers that the door has been unlocked.
[oploc1,horror_lighthouse_doorway]
@horror_walk_through_doorway;

[oplocu,horror_lighthouse_doorway]
if (last_useitem ! horror_key) {
    ~displaymessage(^dm_default);
    return;
}
@horror_walk_through_doorway;

// Both lighthouses' doorways come here (the copy's is m38_71 p0 13,52). Going in, the stage picks the
// lighthouse (~horror_lighthouse_coord); coming out of either, you are on the real causeway - the
// copy's own island is never walked on.
[label,horror_walk_through_doorway]
p_arrivedelay;
def_coord $door = ~horror_to_real(loc_coord);
if (coordz(coord) >= coordz(loc_coord)) {
    // inside: the way out is never locked
    p_teleport(movecoord($door, 0, 0, -1));
    return;
}
if (%horror < ^horror_complete & testbit(%horror_bridges, ^horror_door_unlocked_bit) = 0) {
    if (inv_total(inv, horror_key) = 0) {
        if (%horror = ^horror_not_started) {
            mes("The door is locked.");
            return;
        }
        mes("The door is locked. Larrissa's cousin Gunnjorn has the spare key.");
        return;
    }
    // RS wiki transcript, "Unlocking the Lighthouse": the key is taken. The door stays unlocked.
    inv_del(inv, horror_key, 1);
    mes("You unlock the lighthouse front door.");
    %horror_bridges = setbit(%horror_bridges, ^horror_door_unlocked_bit);
}
// Larrissa is stranded on the causeway until the bridge is mended, and she is going in with you
// (OSRS transcript: "Attempting to enter the lighthouse before repairing the bridge"). Only on the
// first stage - anyone further on has been inside already.
if (%horror = ^horror_started & getbit_range(%horror_bridges, 0, 1) ! 3) {
    ~chatnpc_specific("Larrissa", horror_girlfriend_prequest, "<p,sad>Please, adventurer... I want to know what happened in there as much as you do, but you have to fix the bridge for me first!");
    return;
}
p_teleport(~horror_lighthouse_coord($door));

// --- The two lighthouses (m39_56 and its ransacked copy m38_71 - see quest_horror.constant) ---
// OSRS: "Enter the building; you will appear in an instance with Larrissa inside. The furniture is
// smashed and there are blood splatters and claw marks on the floor and walls." In 2006 that
// "instance" is the m38_71 copy, and you are in it from the first time through the door until the
// Dagannoth Mother is dead - OSRS completes the quest on her death, and Jossik ("Follow me upstairs
// ... Bring it to my library") is from then on in the real lighthouse, where the cache places him.
// Before this, nothing sent anybody to the copy, so everyone saw the lit, tidy lighthouse at every
// stage - with Jossik standing upstairs while he lay injured in the cave below.
[proc,horror_lighthouse_attacked]()(boolean)
if (%horror >= ^horror_started & %horror < ^horror_mother_defeated) {
    return(true);
}
return(false);

[proc,horror_in_copy](coord $coord)(boolean)
return(inzone(^horror_copy_sw, ^horror_copy_ne, $coord));

// Any coord in the copy -> the same tile in the real lighthouse square; anything else unchanged.
[proc,horror_to_real](coord $coord)(coord)
if (~horror_in_copy($coord) = true) {
    return(movecoord($coord, calc(0 - ^horror_copy_dx), 0, calc(0 - ^horror_copy_dz)));
}
return($coord);

// A tile of the real lighthouse -> the tile this player should be put on: the copy's while the
// lighthouse is under attack for them, the real one otherwise.
[proc,horror_lighthouse_coord](coord $real)(coord)
if (~horror_lighthouse_attacked = true) {
    return(movecoord(~horror_to_real($real), ^horror_copy_dx, 0, ^horror_copy_dz));
}
return(~horror_to_real($real));

// Inside the building itself, in either lighthouse. The upper floors are nothing but the building;
// the ground floor is the octagon inside the bounding box (its four corner tiles are the diagonal
// walls and the causeway outside them).
[proc,horror_in_lighthouse](coord $coord)(boolean)
def_coord $real = ~horror_to_real($coord);
if (inzone(^horror_lighthouse_sw, ^horror_lighthouse_ne, $real) = false) {
    return(false);
}
if (coordy($real) > 0) {
    return(true);
}
def_int $x = sub(coordx($real), coordx(^horror_lighthouse_sw));
def_int $z = sub(coordz($real), coordz(^horror_lighthouse_sw));
if (add(min($x, sub(9, $x)), min($z, sub(9, $z))) >= 3) {
    return(true);
}
return(false);

// Login: whoever is standing in the wrong lighthouse for their stage is moved to the same tile of
// the right one - an old save inside the real lighthouse mid-quest, or someone left in the copy after
// the Mother died. Anyone on the copy's island outside the building goes back to the real causeway.
[proc,horror_login]
if (~horror_in_copy(coord) = true) {
    if (~horror_lighthouse_attacked = false | ~horror_in_lighthouse(coord) = false) {
        p_teleport(~horror_to_real(coord));
    }
    return;
}
if (~horror_lighthouse_attacked = true & ~horror_in_lighthouse(coord) = true) {
    p_teleport(~horror_lighthouse_coord(coord));
}


// --- The broken bridge east of the Lighthouse ---
// One crossing, two "Broken bridge" spans (horror_broken_bridge_left_spot at 2596,3608 and
// _right_spot at 2598,3608) with the impassable gap tile 2597,3608 between them. Geometry read out
// of content/maps/m40_56.jm2 (plane 1, z=24): the tiles carry the LINK_BELOW bridge flag, so the
// engine registers the whole row at level 0; x=37 is LINK_BELOW|blocked, which is the gap. Both spans
// are blockwalk=no, so the player walks onto the span on their own side and only the gap needs a
// script.
//
// FIXED: the bridge could not be repaired the way OSRS does it. OSRS (wiki, Horror from the Deep):
// "With a hammer and 60 steel nails in your inventory, use a plank on the side of the bridge you are
// on, then click to jump to the other side to use a plank there as well. Depending on your agility
// level, you may take slight damage from the leap." Here the two planks had both been made to land
// on whichever span you clicked, and Cross refused to move you until both were down - so a player
// who nailed down their side and jumped, as the wiki says, was told the bridge was still broken and
// could go no further. Each span is now its own repair again (bit 0 = west span, bit 1 = east span),
// and Cross leaps the gap from any span that has its plank. Once both are down the crossing is safe.
//
// The quest's 35 Agility is not checked here: in OSRS it is for the pipe on the Barbarian Outpost
// agility course that stands between you and Gunnjorn (skill_agility/scripts/barbarian_course.rs2
// already enforces it). The leap is chance-based on Agility, like the basalt rocks.
// Wiki: 60 steel nails and 2 planks - 30 nails and 1 plank per span. The hammer is not consumed.
[oplocu,horror_broken_bridge_left_spot]
@horror_repair_bridge(0);

[oplocu,horror_broken_bridge_right_spot]
@horror_repair_bridge(1);

[label,horror_repair_bridge](int $bit)
if (last_useitem ! woodplank) {
    ~displaymessage(^dm_default);
    return;
}
if (%horror < ^horror_started) {
    mes("You should speak to Larrissa first.");
    return;
}
if (testbit(%horror_bridges, $bit) = 1) {
    mes("You have already repaired this side of the bridge.");
    return;
}
if (inv_total(inv, hammer) = 0) {
    mes("You need a hammer to nail the plank in place.");
    return;
}
if (inv_total(inv, nails) < 30) {
    mes("You need 30 steel nails to fix the plank in place.");
    return;
}
inv_del(inv, woodplank, 1);
inv_del(inv, nails, 30);
sound_synth(hammer_wood, 1, 0);
%horror_bridges = setbit(%horror_bridges, $bit);
if (getbit_range(%horror_bridges, 0, 1) = 3) {
    mes("You nail the last plank into place. The bridge is safe to cross now.");
    return;
}
mes("You nail a plank across this side of the bridge. Now jump across and fix the other side.");

[oploc1,horror_broken_bridge_left_spot]  ~horror_cross_bridge;
[oploc1,horror_broken_bridge_right_spot] ~horror_cross_bridge;

[proc,horror_cross_bridge]
if (%horror < ^horror_started) {
    mes("The bridge is broken. You'd need a reason to risk that jump.");
    return;
}
def_coord $start = 0_40_56_36_24;
def_coord $end = 0_40_56_38_24;
def_int $dir = ^exact_east;
def_int $from_bit = 0;
if (coordx(coord) > 2597) {
    $start = 0_40_56_38_24;
    $end = 0_40_56_36_24;
    $dir = ^exact_west;
    $from_bit = 1;
}
def_int $dist = add(~abs_value(sub(coordx(coord), coordx($start))), ~abs_value(sub(coordz(coord), coordz($start))));
if ($dist > 4) {
    mes("You need to be closer to the bridge to cross it.");
    return;
}
def_boolean $fixed = false;
if (getbit_range(%horror_bridges, 0, 1) = 3) {
    $fixed = true;
} else if (testbit(%horror_bridges, $from_bit) = 0) {
    mes("This side of the bridge is too rotten to jump from. You'll need to nail a plank across it first.");
    return;
}
if ($dist > 0) {
    p_walk($start);
    p_delay($dist);
}
if ($fixed = true) {
    mes("You cross the repaired bridge.");
} else {
    mes("You leap across the gap in the bridge.");
}
sound_synth(jump_no_land, 1, 20);
~agility_exactmove(human_steppingstonejump, 20, 2, $start, $end, 48, 60, $dir, false);
p_teleport($end);
p_delay(1);
if ($fixed = false & stat_random(agility, 60, 200) = false) {
    mes("You land awkwardly and hurt your ankle.");
    ~damage_self(calc(random(3) + 1));
}

// --- Lighting the lighthouse (top floor) ---
// %horror_lighting bits: 0 = swamp tar used, 1 = tinderbox used, 2 = molten glass used
//
// FIXED: this used to hang off horror_lighthouse_windpower_cog, the wind vane mounted OUTSIDE the
// lantern room's railing (m39_56 p2 11,50) - a loc nobody can stand next to, and one both lighthouses
// share. The mechanism the quest repairs is the one in the middle of the lantern room, and the cache
// has it twice at the same tile (p2 11,55): horror_lighthouse_cog in the real lighthouse (animated,
// with its own area sound) and horror_lighthouse_cog_broken ("It looks broken.") in the attacked copy,
// which is where the player is while the light is out. The copy is shared, so the repair shows the
// working mechanism there for ^horror_torch_lit_duration and then the broken one comes back for the
// next player; the quest itself only ever reads this player's %horror_lighting. Messages and the
// free order are the OSRS transcript's (tar, tinderbox and glass each have a line; the last of the
// three repairs the torch).
[oplocu,horror_lighthouse_cog_broken]
@horror_use_on_mechanism;

// The copy's mechanism while it is showing lit for somebody else: the same repair.
[oplocu,horror_lighthouse_cog]
if (~horror_in_copy(loc_coord) = false) {
    ~displaymessage(^dm_default);
    return;
}
@horror_use_on_mechanism;

[label,horror_use_on_mechanism]
if (%horror < ^horror_started | %horror >= ^horror_mother_defeated) {
    ~displaymessage(^dm_default);
    return;
}
if (getbit_range(%horror_lighting, 0, 2) = 7) {
    mes("You have already repaired the lighthouse torch.");
    return;
}
if (last_useitem = swamp_tar) {
    if (testbit(%horror_lighting, 0) = 1) {
        mes("The torch is already covered in swamp tar.");
        return;
    }
    inv_del(inv, swamp_tar, 1);
    mes("You use the swamp tar to make the torch flammable again.");
    %horror_lighting = setbit(%horror_lighting, 0);
} else if (last_useitem = tinderbox) {
    if (testbit(%horror_lighting, 1) = 1) {
        mes("The torch is already lit.");
        return;
    }
    mes("You light the torch with your tinderbox.");
    %horror_lighting = setbit(%horror_lighting, 1);
} else if (last_useitem = molten_glass) {
    if (testbit(%horror_lighting, 2) = 1) {
        mes("The lens has already been repaired.");
        return;
    }
    inv_del(inv, molten_glass, 1);
    mes("You use the molten glass to repair the lens.");
    %horror_lighting = setbit(%horror_lighting, 2);
} else {
    ~displaymessage(^dm_default);
    return;
}
if (getbit_range(%horror_lighting, 0, 2) = 7) {
    mes("You have managed to repair the lighthouse torch!");
    if (loc_type = horror_lighthouse_cog_broken) {
        loc_change(horror_lighthouse_cog, ^horror_torch_lit_duration);
    }
}


// --- The strange wall (basement, m39_72) - RE-ATTACHED (2026-09-03) ---
// Real locs confirmed via content/maps/m39_72.jm2 (all four sit in one row, plane 1, local z=19,
// x=17-20): horror_mid_left_door/horror_mid_right_door (loc 4543/4544, name="Strange wall", real
// op1=Study) and horror_far_right_door/horror_far_left_door (loc 4545/4546, name="Strange wall",
// real op1=Open, desc "appears to be hinged" - these two are the actual hinged doors; the mid pair
// are just the engraved wall panels you study/use items on). Puzzle mechanic wiki-reconfirmed this
// pass (https://oldschool.runescape.wiki/w/Horror_from_the_Deep): use one of each elemental rune
// (fire/air/water/earth), a sword, and an arrow, each consumed once regardless of stack size, in any
// order - "you do not get these back" per the wiki, which corrects the original draft of this logic
// (kept below, now fixed) that only deleted the runes and not the sword/arrow. The four physical
// panels aren't distinguished by the wiki, so all four accept any of the six items against one
// shared %horror_wall bitfield (bits: 0=fire, 1=air, 2=water, 3=earth, 4=sword, 5=arrow).
[oplocu,horror_mid_left_door]
@horror_wall_useitem;

[oplocu,horror_mid_right_door]
@horror_wall_useitem;

[oplocu,horror_far_right_door]
@horror_wall_useitem;

[oplocu,horror_far_left_door]
@horror_wall_useitem;

// Transcripts, "Using a ... on the strange wall": the player says it won't come back, the game asks
// "Really place the rune/weapon/arrow into the door?", and Yes puts it in the slot ("You place an air
// rune into the slot in the wall."); the last of the six sets something moving within the wall. An
// item already in its slot: "There is no space to put ... into the wall."
[label,horror_wall_useitem]
if (%horror < ^horror_started) {
    ~displaymessage(^dm_default);
    return;
}
def_int $bit = -1;
def_string $what = "";
def_string $kind = "";
if (last_useitem = firerune) {
    $bit = 0; $what = "a fire rune"; $kind = "rune";
} else if (last_useitem = airrune) {
    $bit = 1; $what = "an air rune"; $kind = "rune";
} else if (last_useitem = waterrune) {
    $bit = 2; $what = "a water rune"; $kind = "rune";
} else if (last_useitem = earthrune) {
    $bit = 3; $what = "an earth rune"; $kind = "rune";
} else if (last_useitem = bronze_sword | last_useitem = iron_sword | last_useitem = steel_sword | last_useitem = black_sword | last_useitem = mithril_sword | last_useitem = adamant_sword | last_useitem = rune_sword) {
    $bit = 4; $what = "a sword"; $kind = "weapon";
} else if (last_useitem = bronze_arrow | last_useitem = iron_arrow | last_useitem = steel_arrow | last_useitem = mithril_arrow | last_useitem = adamant_arrow | last_useitem = rune_arrow) {
    $bit = 5; $what = "an arrow"; $kind = "arrow";
} else {
    ~displaymessage(^dm_default);
    return;
}
if (getbit_range(%horror_wall, 0, 5) = 63 | testbit(%horror_wall, $bit) = 1) {
    mes("There is no space to put <$what> into the wall.");
    return;
}
def_obj $item = last_useitem; // before the dialogue, which ends the last_useitem pointer
~chatplayer("<p,neutral>I don't think I'll get that back if I put it in there.");
if (~p_choice2_header("Yes", 1, "No", 2, "Really place the <$kind> into the door?") = 2) {
    return;
}
if (inv_total(inv, $item) = 0) {
    return;
}
inv_del(inv, $item, 1);
%horror_wall = setbit(%horror_wall, $bit);
mes("You place <$what> into the slot in the wall.");
if (getbit_range(%horror_wall, 0, 5) = 63) {
    mes("You hear the sound of something moving within the wall.");
    ~horror_wall_open_doors;
    if (%horror < ^horror_wall_opened) {
        %horror = ^horror_wall_opened;
        ~send_quest_progress(questlist:horror, 2, ^horror_complete);
    }
}

[oploc1,horror_mid_left_door]
gosub(horror_wall_study);

[oploc1,horror_mid_right_door]
gosub(horror_wall_study);

// From the lighthouse side it is the metal door of the OSRS guide - a monstrous face in the middle and
// six icons round it (the four runes, a sword and an arrow), in our words. From the cave side, the
// transcript's line.
[proc,horror_wall_study]
// the panels sit on the south edge of their own tile, so the loc's own row is the cave side
if (coordz(coord) >= coordz(loc_coord)) {
    mes("You cannot see anything unusual about the wall from this side.");
    return;
}
mes("A monstrous face is carved into the middle of the wall, ringed by six icons: fire, air, water and earth, a sword and an arrow.");

[oploc1,horror_far_right_door]
gosub(horror_wall_open_attempt);

[oploc1,horror_far_left_door]
gosub(horror_wall_open_attempt);

[proc,horror_wall_open_attempt]
// The hinged panels sit on the south edge of their own tiles, so the lighthouse side is south of
// z=4627 and the side with the ladder down to Jossik is north of it. From the north side it always
// opens: nobody should be walled in behind a puzzle they came through (or round, from the Waterbirth
// maze - ^horror_maze_exit_dest lands in the cave beyond it).
if (getbit_range(%horror_wall, 0, 5) ! 63 & coordz(coord) < coordz(loc_coord)) {
    mes("You cannot see any way to move this part of the wall....");
    return;
}
mes("You push the hinged panel aside.");
~horror_wall_open_doors;

// FIXED (2026-09-08): the wall never actually opened. The old code did
//     loc_change(horror_far_left_door_inactive, ...); loc_change(horror_far_right_door_inactive, ...);
// which has two separate bugs. First, loc_change acts on the ACTIVE loc, so both calls landed on the
// one panel the player had just clicked - the second simply overwrote the first and the other panel
// was never touched. Second, and fatally, neither _inactive type declares blockwalk=no, and
// LocType.blockwalk defaults to true (engine/src/cache/config/LocType.ts:79) - so even the panel that
// did change stayed exactly as solid as before, just no longer clickable. The six-icon puzzle could
// be solved and the passage south still could not be walked through: a hard quest block.
//
// Both panels are now looked up by their own coordinates and deleted outright, which is the only
// thing that reliably drops a wall loc's collision. ^horror_wall_reopen_delay is short so the wall
// closes behind the player - a player who has already solved it re-opens it any time via Open above,
// and one who hasn't still has to place all six items.
[proc,horror_wall_open_doors]
if (loc_find(^horror_far_left_door_coord, horror_far_left_door) = true) {
    loc_del(^horror_wall_reopen_delay);
}
if (loc_find(^horror_far_right_door_coord, horror_far_right_door) = true) {
    loc_del(^horror_wall_reopen_delay);
}


// --- Lighthouse bookcase (horror_bookcase, loc 4617, op1=Search) ---
// On the middle floor of both lighthouses. Transcript: three important-looking books - the lighthouse
// manual, the ancient diary and Jossik's journal (the cache's horror_diary3/_diary2/_diary1) - taken
// one at a time or all three together. Reading them is not needed to finish the quest, but the manual
// says how the light is mended and Silas's diary how the strange wall is opened.
[oploc1,horror_bookcase]
~mesbox("There are three books here that look important... What would you like to do?");
def_int $op = ~p_choice4("Take the Lighthouse Manual.", 1, "Take the ancient Diary.", 2, "Take Jossik's Journal.", 3, "Take all three books.", 4);
if ($op = 4) {
    if (inv_freespace(inv) < 3) {
        mes("You do not have enough room to take all three.");
        return;
    }
    inv_add(inv, horror_diary3, 1);
    inv_add(inv, horror_diary2, 1);
    inv_add(inv, horror_diary1, 1);
    return;
}
if (inv_freespace(inv) = 0) {
    mes("You do not have enough room to take that.");
    return;
}
if ($op = 1) {
    inv_add(inv, horror_diary3, 1);
} else if ($op = 2) {
    inv_add(inv, horror_diary2, 1);
} else {
    inv_add(inv, horror_diary1, 1);
}

// Moved here from general_use/scripts/readables_generated.rs2, whose one-line stand-ins said nothing
// the quest needs. The contents follow the wiki's account of each book (OSRS wiki, Horror from the
// Deep, and the Manual / Diary / Journal item pages), retold in our own words.
[opheld1,horror_diary3]
~mesbox("Lightomatic Deluxe 500|Maintenance, Upkeep and Users' Manual. Second Edition.");
~mesbox("Congratulations on your purchase of the Lightomatic Deluxe 500, the finest lighthouse mechanism money can buy. Kept clean and in good repair, it will shine for many years.");
~mesbox("Troubleshooting. Q: My light has gone out! A: Check the lens - a cracked lens can be mended with molten glass. The torch must be coated in swamp tar to burn, and can then be lit again with a tinderbox.");

[opheld1,horror_diary2]
~mesbox("The diary is old, and the handwriting grows wilder with every page. It belonged to Silas, the keeper before Jossik.");
~mesbox("...they speak to me from beneath the waves. Nobody else hears them. I do not know why it is me they have chosen, but I will not fail them...");
~mesbox("...I have built them a door of metal in the rock below, so that no one else will find the way. Only the key will open it: the fire, the air, the water and the earth - white, blue, brown and red - and beside them the warrior's sword and the huntsman's arrow...");
~mesbox("The last pages are nothing but scrawl.");

[opheld1,horror_diary1]
~mesbox("Jossik's journal. He took the keeper's post at the lighthouse after his uncle Silas vanished, knowing nothing at all about lighthouses.");
~mesbox("The later entries speak of voices at night, and of strange noises that seem to come from somewhere beneath the lighthouse.");
~mesbox("The last entry says he has decided to go down to the basement and find out what is making them.");

// --- The lighthouse basement (m39_56 <-> m39_72) and the post-quest dagannoth caves (m39_156) ---
//
// REWIRED to the OSRS layout. The ladder models say which end of each ladder is which -
// horror_ladder_top/_top2 use model horror_ladder_top (you climb DOWN from them) and
// horror_ladder_base/_base2 use horror_ladder_base (you climb UP them) - and they pair up as:
//
//   lighthouse, horror_ladder_top (m39_56 p0 13,60)  <->  horror_ladder_base (m39_72 p1 23,10)
//       the basement, SOUTH of the strange wall (the wall is the p1 row z=19)
//   horror_ladder_top2 (m39_72 p1 19,22)             <->  horror_ladder_base2 (m39_72 p0 19,23)
//       the small room NORTH of the wall, and the cave below it where Jossik lies (p0 22,25)
//
// OSRS walkthrough: "Descend to the basement. Locate the strange wall and use ... on it. Open the
// eastern strange wall doorway, climb down the ladder, and speak with Jossik". The old wiring had it
// the other way round - the lighthouse ladder dropped you straight into Jossik's cave, past the wall,
// and horror_ladder_base (the basement's way back UP) sent you down into m39_156 instead - which left
// nothing anywhere leading back to the lighthouse. Anyone who went down was stuck underground unless
// they could teleport, and could never carry the casket back to Jossik upstairs on foot.
//
// m39_156 is the same cave with a byte-identical loc layout and 22 dagannoths placed in it: the
// post-quest Dagannoth caves. Once the quest is done, horror_ladder_top2 leads there instead of to
// Jossik's quiet cave. Its own copies of the ladders climb back up to the room north of the wall.
// Both lighthouses' iron ladders (m39_56 and m38_71, p0 13,60) lead down to the one basement, and the
// basement's ladder climbs back into whichever lighthouse the player's stage puts them in.
//
// OSRS transcript, "Attempting to climb down the iron ladder before fixing the lighthouse": Larrissa
// will not let you go down until the light is burning again. Only on the stages before the wall -
// nobody further on is sent back up to relight it.
[oploc1,horror_ladder_top]
p_arrivedelay;
if (%horror >= ^horror_started & %horror < ^horror_wall_opened & getbit_range(%horror_lighting, 0, 2) ! 7) {
    ~chatnpc_specific("Larrissa", horror_girlfriend_postquest, "<p,sad>Please, adventurer... don't let curiosity get the better of you! We have to fix the light before there's an accident.");
    return;
}
mes("You climb down the ladder into the lighthouse basement.");
p_telejump(^horror_basement_arrival);

[oploc1,horror_ladder_base]
p_arrivedelay;
mes("You climb up the ladder.");
p_telejump(~horror_lighthouse_coord(^horror_lighthouse_return));

[oploc1,horror_ladder_top2]
p_arrivedelay;
if (%horror >= ^horror_complete) {
    mes("You climb down into the dagannoth caves.");
    p_telejump(^horror_dag_cavern_arrival);
    return;
}
mes("You climb down the ladder into darkness.");
p_telejump(^horror_jossik_cave_arrival);

// Both copies (m39_72 and m39_156) climb back up to the room north of the wall; m39_156 has no
// walkable upper floor of its own.
[oploc1,horror_ladder_base2]
p_arrivedelay;
mes("You climb up the ladder.");
p_telejump(^horror_wall_room_arrival);

// Both bosses come out of the water when Jossik sees them coming, as in the original: the level-100
// Dagannoth at the end of your first talk with him, and the Mother when it is dead ("That was one of
// its babies..." - said on the kill, or on talking to him again). Nothing appears just for climbing
// down. A player who logged out mid-fight, or whose boss despawned, gets it back by talking to him
// again; while one is out he is too busy to talk. Searched for by radius, not by exact tile: a boss
// that has taken a step would otherwise not be found and a second one added.
[proc,horror_dagannoth_present]()(boolean)
if (npc_find(^horror_dag_cavern_jr4_spawn, horror_dagannoth_jr4, 20, ^vis_off) = true) {
    return(true);
}
return(false);

[proc,horror_spawn_dagannoth]
npc_add(^horror_dag_cavern_jr4_spawn, horror_dagannoth_jr4, ^horror_boss_lifetime);
// Aggressive (transcript: it "emerges from [the water] and attacks the player").
%npc_aggressive_player = uid;
npc_setmode(opplayer2);


// --- Fallen Jossik (injured, in the cave below the strange wall) and horror_lighthousekeeeper_well
// (the library upstairs, after the quest) ---
// horror_lighthousekeeeper_injured (npc 1335) is placed at m39_72 p0 local(22,25); the well Jossik
// (1334) at m39_56 p1 local(13,55). Dialogue follows the transcript, in our own words; every Jossik
// line goes through ~chatnpc_specific so the same labels can run from the kill's player queue.
[opnpc1,horror_lighthousekeeeper_injured]
if (%horror < ^horror_wall_opened) {
    // only reachable round the back, through the Waterbirth maze
    ~chatplayer("<p,shock>Jossik! Are you alright?");
    ~chatnpc("<p,scared>Adventurer! There are creatures down here, dagannoth of some kind. Get out while you can!");
    return;
}
if (%horror >= ^horror_mother_defeated) {
    ~chatnpc("<p,happy>Go on up - I'll follow you to my library. I don't want to stay down here a moment longer than I have to.");
    return;
}
if (%horror = ^horror_wall_opened) {
    if (~horror_dagannoth_present = true) {
        mes("You are too busy to talk to Jossik.");
        return;
    }
    @horror_jossik_first;
}
if (~horror_mother_present = true) {
    mes("You are too busy to talk to Jossik.");
    return;
}
@horror_jossik_babies;

[label,horror_jossik_first]
~chatnpc_specific("Jossik", horror_lighthousekeeeper_injured, "<p,sad>*cough* Please... please help me... I think my leg is broken, and those creatures will be back any minute!");
~chatplayer("<p,quiz>I guess you're Jossik then... What creatures are you talking about?");
~chatnpc_specific("Jossik", horror_lighthousekeeeper_injured, "<p,scared>I... I don't know. I've never seen anything like them!");
~chatnpc_specific("Jossik", horror_lighthousekeeeper_injured, "<p,sad>I was looking for anything about my uncle Silas, who vanished from this lighthouse months ago. I found the secret of that strange wall and that it opens like a door - but when I came down here I was attacked by...");
~chatnpc_specific("Jossik", horror_lighthousekeeeper_injured, "<p,scared>Well, I don't know what they are, but they're terribly strong! They hurt me so badly I couldn't get away, and I've been fearing for my life ever since!");
~chatplayer("<p,neutral>Don't worry, I'm here now. Larrissa was worried about you and asked me to help.");
~chatplayer("<p,neutral>I'll go back up and tell her I've found you and you're still alive, and then we'll work out some way of getting you out of here, okay?");
~chatnpc_specific("Jossik", horror_lighthousekeeeper_injured, "<p,shock>NO! No, you can't leave me now! Look! They're coming again! Do something!");
if (%horror = ^horror_wall_opened & ~horror_dagannoth_present = false) {
    ~horror_spawn_dagannoth;
}

[label,horror_jossik_babies]
~chatplayer("<p,neutral>Okay, now that the creature's dead we can get you out of here.");
~chatnpc_specific("Jossik", horror_lighthousekeeeper_injured, "<p,scared>No... you don't understand...");
~chatnpc_specific("Jossik", horror_lighthousekeeeper_injured, "<p,scared>That wasn't the creature that attacked me...");
~chatnpc_specific("Jossik", horror_lighthousekeeeper_injured, "<p,scared>That was one of its babies...");
if (%horror = ^horror_dagannoth_defeated & ~horror_mother_present = false) {
    ~horror_spawn_mother;
}

[opnpc1,horror_lighthousekeeeper_well]
// Saves from before the quest completed on the Mother's death stopped at stage 4 or 5 with the Mother
// already dead: they are finished here, and the casket is still owed to them.
if (%horror >= ^horror_mother_defeated & %horror < ^horror_complete) {
    %horror = ^horror_complete;
    %horror_bridges = setbit(%horror_bridges, ^horror_casket_owed_bit);
    queue(horror_quest_complete, 0, 0);
}
if (%horror >= ^horror_complete & testbit(%horror_bridges, ^horror_casket_owed_bit) = 1) {
    @horror_jossik_casket;
}
if (%horror >= ^horror_complete) {
    // The shop (op3=Trade and the first option; configs/quest_horror_jossik.npc binds it) and the
    // prayer books. The books follow the RS wiki's account of Jossik (Jossik page, "God Books"; the
    // OSRS Damaged book pages agree): a LOST damaged book he gives back for nothing - it washed up
    // and he knew it was yours - and once you have completed your book he will sell you a damaged
    // book of another god for 5,000 coins. The old 5,000gp charge for your own lost book was
    // invented. Only the three books of this era: Armadyl, Bandos and Ancient came later.
    ~chatnpc("<p,happy>Hello again, adventurer. What brings you this way?");
    def_int $service = ~p_choice3("Can I see your wares?", 1, "Have you found any new prayer books?", 2, "Nothing, really. Goodbye.", 3);
    if ($service = 3) {
        ~chatplayer("<p,neutral>Nothing, really. Goodbye.");
        return;
    }
    if ($service = 1) {
        ~chatplayer("<p,neutral>Can I see your wares?");
        ~chatnpc("<p,happy>Sure thing! I think you'll agree my prices are remarkable.");
        ~openshop_activenpc;
        return;
    }
    ~chatplayer("<p,quiz>Have you found any new prayer books?");
    @horror_jossik_books;
}

// %horror_bridges bits 5-7: the damaged books of Saradomin, Zamorak and Guthix this player has had
// from Jossik (the casket's, or bought). A save from before these bits has none set: whatever god
// books it is holding (anywhere - pack, worn or bank) are taken as its own the first time it asks.
[label,horror_jossik_books]
def_int $god = 1;
while ($god <= 3) {
    if (~horror_has_god_book($god) = true) {
        %horror_bridges = setbit(%horror_bridges, calc(^horror_book_owned_bit + $god - 1));
    }
    $god = add($god, 1);
}
// one that was yours and is nowhere to be found: back for nothing
$god = 1;
while ($god <= 3) {
    if (testbit(%horror_bridges, calc(^horror_book_owned_bit + $god - 1)) = 1 & ~horror_has_god_book($god) = false) {
        if (inv_freespace(inv) = 0) {
            ~chatnpc("<p,neutral>I have something of yours, as it happens - but you'll need some room in your pack first.");
            return;
        }
        inv_add(inv, ~horror_god_book($god), 1);
        ~chatnpc("<p,happy>As a matter of fact I have! This book washed up on the beach not long ago, and I knew it for yours straight away. Here you go!");
        return;
    }
    $god = add($god, 1);
}
// an old save that has lost the book it was given, with nothing on record: it chooses it back
if (getbit_range(%horror_bridges, ^horror_book_owned_bit, calc(^horror_book_owned_bit + 2)) = 0) {
    if (inv_freespace(inv) = 0) {
        ~chatnpc("<p,neutral>I have something of yours, as it happens - but you'll need some room in your pack first.");
        return;
    }
    ~chatnpc("<p,happy>As a matter of fact I have! A book washed up on the beach not long ago - one of yours, I'm sure. Which was it?");
    $god = ~p_choice3("Saradomin.", 1, "Zamorak.", 2, "Guthix.", 3);
    inv_add(inv, ~horror_god_book($god), 1);
    %horror_bridges = setbit(%horror_bridges, calc(^horror_book_owned_bit + $god - 1));
    return;
}
if (~horror_has_complete_god_book = false | getbit_range(%horror_bridges, ^horror_book_owned_bit, calc(^horror_book_owned_bit + 2)) = 7) {
    ~chatnpc("<p,neutral>Nope. Sorry, adventurer - nothing new has washed up. I'll let you know if any more show up, though.");
    return;
}
~chatnpc("<p,happy>Funnily enough, I have! Some more turned up in caskets the other day. I'll sell you one for 5,000 coins - what do you say?");
if (~p_choice2("Buy a book.", 1, "No thanks.", 2) = 2) {
    ~chatplayer("<p,neutral>No thanks.");
    ~chatnpc("<p,neutral>Okay! Suit yourself.");
    return;
}
$god = ~p_choice3_header("Saradomin.", 1, "Zamorak.", 2, "Guthix.", 3, "Which book would you like?");
if (testbit(%horror_bridges, calc(^horror_book_owned_bit + $god - 1)) = 1) {
    ~chatnpc("<p,confused>You've already got that one!");
    return;
}
if (inv_total(inv, coins) < 5000) {
    ~chatnpc("<p,neutral>You don't have enough coins for that.");
    return;
}
if (inv_freespace(inv) = 0 & inv_total(inv, coins) > 5000) {
    ~chatnpc("<p,neutral>You'll need some room in your pack for it.");
    return;
}
inv_del(inv, coins, 5000);
inv_add(inv, ~horror_god_book($god), 1);
%horror_bridges = setbit(%horror_bridges, calc(^horror_book_owned_bit + $god - 1));
~chatnpc("<p,happy>Here you go!");

[proc,horror_has_god_book](int $god)(boolean)
def_namedobj $damaged = ~horror_god_book($god);
def_namedobj $done = ~horror_god_book_complete($god);
if (inv_total(inv, $damaged) > 0 | inv_total(worn, $damaged) > 0 | inv_total(bank, $damaged) > 0) {
    return(true);
}
if (inv_total(inv, $done) > 0 | inv_total(worn, $done) > 0 | inv_total(bank, $done) > 0) {
    return(true);
}
return(false);

[proc,horror_has_complete_god_book]()(boolean)
def_int $god = 1;
while ($god <= 3) {
    def_namedobj $done = ~horror_god_book_complete($god);
    if (inv_total(inv, $done) > 0 | inv_total(worn, $done) > 0 | inv_total(bank, $done) > 0) {
        return(true);
    }
    $god = add($god, 1);
}
return(false);

[proc,horror_god_book_complete](int $god)(namedobj)
if ($god = 2) {
    return(zamorakbook_complete);
}
if ($god = 3) {
    return(guthixbook_complete);
}
return(saradominbook_complete);

// --- The casket (after the quest) ---
// Transcript, "Post-quest dialogue - Jossik": he reads the faint writing on the casket with you. You
// pick a god, he asks if you are REALLY sure, and you pick again; the same god twice opens it and the
// damaged book of that god is yours (a different one goes round again). No casket on you - he picked
// up the one you dropped. No free space - come back when you have some. %horror_bridges bit
// ^horror_casket_owed_bit is set on the kill and cleared here, so it is opened exactly once.
[label,horror_jossik_casket]
~chatplayer("<p,happy>I see you managed to get away from those monsters in one piece!");
~chatnpc("<p,happy>It seems I wasn't as badly hurt as I thought! Thank you again for all your help.");
~chatnpc("<p,neutral>Now, about that casket you found on the creature's body...");
if (inv_total(inv, horror_casket) = 0) {
    ~chatplayer("<p,confused>I never got any casket from that monster.");
    ~chatnpc("<p,laugh>Of course you did! You dropped it, and I picked it up. I have it right here.");
    ~chatnpc("<p,neutral>Now, let's have a look at it. There's some writing on it, but it's very faint. Can you make it out?");
} else {
    ~chatplayer("<p,quiz>I have it here. You said you might be able to tell me something about it?");
    ~chatnpc("<p,happy>I can indeed! Let me have a closer look... Yes! There's something written on it, though it's very faint. Can you read it?");
}
@horror_casket_say(~horror_casket_pick);

[proc,horror_casket_pick]()(int)
return(~p_choice3_header("Saradomin.", 1, "Zamorak.", 2, "Guthix.", 3, "What does the casket say?"));

[label,horror_casket_say](int $god)
~chatplayer("<p,neutral>I think it says... <~horror_god_name($god)>.");
~chatnpc("<p,quiz>Are you sure? I mean, are you REALLY sure? Maybe you'd better look again.");
if (inv_freespace(inv) = 0) {
    ~chatnpc("<p,neutral>I think you should free up some space in your pack first!");
    ~chatnpc("<p,neutral>Whatever's in this casket might be valuable, and you wouldn't want to just throw it away.");
    return;
}
def_int $again = ~horror_casket_pick;
if ($again ! $god) {
    @horror_casket_say($again);
}
~chatplayer("<p,neutral>Nope, it definitely says <~horror_god_name($god)>.");
~chatnpc("<p,happy>I think you're right! Hand it here, and let's see what's inside.");
if (inv_total(inv, horror_casket) > 0) {
    inv_del(inv, horror_casket, 1);
}
inv_add(inv, ~horror_god_book($god), 1);
%horror_bridges = clearbit(%horror_bridges, ^horror_casket_owed_bit);
%horror_bridges = setbit(%horror_bridges, calc(^horror_book_owned_bit + $god - 1));
~chatnpc("<p,shock>Well I never! It's a holy book of <~horror_god_name($god)>! I thought these had all been lost. Well, it's all yours - I hope you appreciate it.");

[proc,horror_god_name](int $god)(string)
if ($god = 2) {
    return("Zamorak");
}
if ($god = 3) {
    return("Guthix");
}
return("Saradomin");

[proc,horror_god_book](int $god)(namedobj)
if ($god = 2) {
    return(unfinished_zamorakbook);
}
if ($god = 3) {
    return(unfinished_guthixbook);
}
return(unfinished_saradominbook);

// The quest completes on the Dagannoth Mother's death (transcript: the completion message, then
// Jossik's "Follow me upstairs") - see quest_horror_combat.rs2's [queue,horror_boss_slain], which
// sets %horror there and queues this for the rewards. Through the player queue and
// ~send_quest_complete (not send_quest_progress) so the scroll, jingle and quest points are not left
// behind an abortable ~chatnpc.
[queue,horror_quest_complete]
%horror = ^horror_complete;
stat_advance(magic, 46625);
stat_advance(strength, 46625);
stat_advance(ranged, 46625);
~send_quest_complete(questlist:horror, horror_casket, 250, ^horror_questpoints, "You have completed the\\nHorror from the Deep Quest!", "4,662 Strength XP|4,662 Ranged XP|4,662 Magic XP|A damaged god book - see Jossik|Access to the Lighthouse basement");
