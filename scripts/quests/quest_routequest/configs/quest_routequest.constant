// In Search of the Myreque - the original quest, ported from PlagueCityRS 349 with its original
// stage numbers. The varps and varbits it uses are the cache's own, in _unpack/377/all.varp and
// all.varbit: routequest (progress), routequestmulti (routequestionscorrect/answered, roomnum,
// bridgerung1-3, thsfm_vanstrom_hide) and routequest_myreque_bits (who you have introduced
// yourself to).
^routequest_not_started = 0
^routequest_started = 5
^routequest_spoke_to_boatman = 10
^routequest_boatman_agreed = 15
^routequest_boatman_repaired = 20
^routequest_entered_hollowed = 25
^routequest_found_guard = 52
^routequest_answered_questions = 55
^routequest_entered_underground = 60
^routequest_introduced_veliaf = 65
// vvv - possibly osrs-only state?
//^routequest_gave_weapons = 67
^routequest_enter_cutscene = 70
// osrs also uses 71-79 that get all pushed in same tick as 80 after cutscene.
^routequest_ambush = 80
^routequest_saved_myreque = 85
^routequest_told_exit_route = 90
^routequest_discovered_wall = 95
^routequest_found_exit = 97
^routequest_spoke_to_stranger = 100
// osrs also uses 110, then skips 105->110 in same tick.
^routequest_complete = 105

// The name the rest of this server tests completion by - the quest list and quest points
// (general/scripts/quests.rs2) and In Aid of the Myreque (quest_myreque2). Same number.
^route_complete = 105

^route_myreque_sani = 0
^route_myreque_harold = 1
^route_myreque_radigrad = 2
^route_myreque_polmafi = 3
^route_myreque_ivan = 4
