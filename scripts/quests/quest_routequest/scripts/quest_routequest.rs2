[proc,routequest_has_weapons]()(boolean)
if(inv_total(inv, steel_longsword) < 1 | inv_total(inv, steel_sword) < 2 | inv_total(inv, steel_dagger) < 1
    | inv_total(inv, steel_mace) < 1 | inv_total(inv, steel_warhammer) < 1) {
    return (false);
}
return (true);

[queue,routequest_complete]
// The queue can be put on twice (the stranger is talked to again before it runs); pay once.
if (%routequest >= ^routequest_complete) {
    return;
}
%routequest = ^routequest_complete;
stat_advance(attack, 6000);
stat_advance(defence, 6000);
stat_advance(strength, 6000);
stat_advance(hitpoints, 6000);
stat_advance(crafting, 6000);
session_log(^log_adventure, "Quest complete: In Search of the Myreque");
~send_quest_complete(questlist:routequest, steel_sword, 200, ^route_questpoints, "'In Search of the Myreque' completed.", "Attack & Defence XP|Strength & Hitpoint XP|Crafting XP|Quick Route to Mort'ton");

// The broken ladder in the Hollows is scenery in the original. [oploc1,ladder_broken] belongs to
// Melzar's Maze (quest_dragon/scripts/melzars_maze.rs2), which asks this first; false leaves it to
// say the ladder is broken.
[proc,route_repair_ladder]()(boolean)
return(false);

// The chair in the Hair of the Dog. The map spawns [multi_vanstrom_stranger_entity], which shows
// Vanstrom Klause at thsfm_vanstrom_hide 0 and a Canifis stranger at 1, per player, so this is the
// original's pair of [opnpc1,route_vanstrom_klause_sitting]/[opnpc1,canafis_stranger] without the
// npc_changetype that swapped the one npc for everybody. The bit follows the stage: Vanstrom leaves
// the chair when he shows himself in the ambush.
[opnpc1,multi_vanstrom_stranger_entity]
~routequest_sync_vanstrom;
if (%routequest >= ^routequest_ambush) {
    @canafis_stranger_dialogue;
}
@vanstrom_sitting_dialogue;

[proc,routequest_sync_vanstrom]
if (%routequest >= ^routequest_ambush) {
    %thsfm_vanstrom_hide = 1;
} else {
    %thsfm_vanstrom_hide = 0;
}
