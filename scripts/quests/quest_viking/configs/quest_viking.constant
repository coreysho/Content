// The Fremennik name Brundt gives you: two four-bit syllable indices in %viking_name (349 kept
// them in bits 22-29 of %godbook_multi; that varp is temp on this server and shared with Horror
// from the Deep, so it has a perm varp of its own here).
^viking_name_lower1 = 0
^viking_name_upper1 = 3
^viking_name_lower2 = 4
^viking_name_upper2 = 7

// Koschei's battleground: m41_157, plane 2. Dying anywhere down there is a safe death on this
// server (player/scripts/death.rs2 -> [label,viking_koschei_player_death]).
^viking_arena_sw = 2_41_157_0_0
^viking_arena_ne = 2_41_157_63_63
^viking_thorvald_hut = 0_41_57_42_46

