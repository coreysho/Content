// The Fremennik Trials, as PlagueCityRS 349 has it (the original dialogue and stage numbers).
// Wiki: https://oldschool.runescape.wiki/w/The_Fremennik_Trials
//
// %viking is 0 before Brundt, then 1 + the number of council votes won (1-8), and ^viking_complete
// (10, in general/configs/quest.constant) once Brundt has welcomed you. Each trial keeps its own
// progress in a bit range of %viking_bits (below); a trial adds one to %viking as it finishes.
//
// ^viking_complete lives in general/configs/quest.constant with every other quest-completion
// constant - declaring it here too is a duplicate and breaks the build.
^viking_not_started = 0
^viking_started = 1

// --- %viking_bits ---
^viking_firecracker_placed = 0
^viking_spoken_poisonsalesman = 1
^viking_keg_lowalc = 2
