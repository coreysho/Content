// The Fremennik Trials - moved out of _unpack/377/all.varp so both can be perm-scoped. The cache
// ships them with no scope line at all, i.e. scope=temp, which would forget the whole quest on
// every logout.
//
// %viking      0, then 1 + the council votes won, then ^viking_complete (quest_viking.constant)
// %viking_bits the seven trials' own progress, one bit range each, plus the Seer's riddle and
//              the stew (see quest_viking.constant)
[viking]
scope=perm

[viking_bits]
scope=perm

// Moved out of _unpack/377/all.varp (349 types it, so it can hold the butterfly's npc uid).
[draugen_butterfly_uid]
type=npc_uid

// Added for the port: the two syllables of the Fremennik name Brundt gives you.
[viking_name]
scope=perm
