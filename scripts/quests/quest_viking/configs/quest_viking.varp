// The Fremennik Trials - moved out of _unpack/377/all.varp so both can be perm-scoped. The cache
// ships them with no scope line at all, i.e. scope=temp, which would forget the whole quest on
// every logout.
//
// %viking      the linear quest stage (see quest_viking.constant)
// %viking_bits one bit per council vote plus the per-trial sub-steps, since the six trials can be
//              done in any order - the same shape %horror_wall/%horror_bridges take in Horror from
//              the Deep, and for the same reason.
[viking]
scope=perm

[viking_bits]
scope=perm
