// The Fremennik Trials - Brundt the Chieftain (viking_brundt, m41_57 local(35,21), the longhall).
// Starts the quest and, once all seven council votes are in, ends it.
//
// Wiki: Brundt explains that to be made a Fremennik you must win over the council. The seven trials
// are done in ANY order, which is why each one is its own bit in %viking_bits rather than a step in
// a linear %viking - see configs/quest_viking.constant.

[opnpc1,viking_brundt]
// Brundt is the fifth link in Sigmund's chain on the way down and the ninth on the way back.
if (~viking_merchant(5, 23) = true) {
    return;
}
// Mountain Daughter borrows him for one conversation - he is the only person who can promise Svidi
// safe passage across Fremennik land. He has no op2 in the cache to hang it on, so it goes here.
if (~mdaughter_brundt = true) {
    return;
}
if (%viking = ^viking_not_started) {
    @viking_brundt_start;
}
if (%viking >= ^viking_complete) {
    ~chatnpc("<p,happy>Welcome home, <~viking_fremennik_name>. You are one of us now.");
    return;
}
if (~viking_has_all_votes = true) {
    @viking_brundt_finish;
}
~chatplayer("<p,quiz>How am I doing?");
~chatnpc("<p,neutral>You have <tostring(~viking_votes_won)> of the seven votes you need. Keep at it, outerlander.");
~viking_brundt_remaining;

[label,viking_brundt_start]
~chatplayer("<p,happy>Hello.");
~chatnpc("<p,neutral>Outerlander. You are a long way from your own people.");
~chatplayer("<p,quiz>Could I become one of yours?");
~chatnpc("<p,neutral>Ha! Every outerlander who wanders in here asks me that.");
~chatnpc("<p,neutral>It is not mine to give. The council decides, and the council is seven stubborn people who each want something different from you.");
def_int $op = ~p_choice2("Then I'll win them over.", 1, "That sounds like a lot of work.", 2);
if ($op = 2) {
    ~chatplayer("<p,neutral>That sounds like a lot of work.");
    ~chatnpc("<p,neutral>It is. Come back when you have the stomach for it.");
    return;
}
~chatplayer("<p,neutral>Then I'll win them over.");
~chatnpc("<p,happy>Good. Then go and speak to them - Manni, Sigli, Olaf, Sigmund, Swensen, Thorvald and Peer. Earn all seven votes and come back to me.");
~chatnpc("<p,neutral>They are scattered about Rellekka. Ask around; nobody here is shy.");
%viking = ^viking_started;
~send_quest_progress(questlist:viking, %viking, ^viking_complete);

[label,viking_brundt_finish]
~chatplayer("<p,happy>I have all seven votes.");
~chatnpc("<p,happy>So the council tells me. Every one of them, and not one of them easily won.");
~chatnpc("<p,neutral>Kneel then, outerlander, and take a Fremennik name.");
mes("Brundt lays a hand on your head.");
p_delay(2);
~chatnpc("<p,happy>Rise, <~viking_fremennik_name>. Rellekka is your home now.");
%viking = ^viking_complete;
queue(viking_quest_complete, 0, 0);

// This queue used to be session_log + ~send_quest_complete and nothing else: no stat_advance, no
// inv_add anywhere in it, so six trials' worth of work paid out three quest points and a reward
// screen. The XP below is the quest's own: 2,812 in each of the ten skills it trains, written in
// the x10 form stat_advance takes throughout this codebase.
//
// No item is granted here deliberately. The scroll shows viking_helmet as its display object and
// the reward line says "Fremennik equipment", but what the trials actually unlock is the right to
// wear it and to trade in Rellekka, not a handout - so the text is accurate as written and is left
// alone rather than backed with an invented item.
[queue,viking_quest_complete]
session_log(^log_adventure, "Quest complete: The Fremennik Trials");
stat_advance(agility, 28120);
stat_advance(attack, 28120);
stat_advance(crafting, 28120);
stat_advance(defence, 28120);
stat_advance(fishing, 28120);
stat_advance(fletching, 28120);
stat_advance(hitpoints, 28120);
stat_advance(strength, 28120);
stat_advance(thieving, 28120);
stat_advance(woodcutting, 28120);
~send_quest_complete(questlist:viking, viking_helmet, 250, ^viking_questpoints, "You have completed\\nThe Fremennik Trials!", "A Fremennik name|Rellekka's trust|2,812 XP in ten skills|Fremennik equipment");

// A hand-picked list rather than a generated one: the real quest asks you to choose from a short
// set of Fremennik names, and this keeps the flavour without an interface to pick from. Keyed off
// the player's gender so it is at least consistent for a given character.
[proc,viking_fremennik_name]()(string)
if (gender() = 0) {
    return("Sigurd");
}
return("Hild");

// Seven votes: bits 0-5 for the six council members who were wired first, and Swensen's on bit 27.
[proc,viking_votes_won]()(int)
def_int $n = 0;
def_int $bit = ^viking_votes_first;
while ($bit <= ^viking_votes_last) {
    if (testbit(%viking_bits, $bit) = 1) {
        $n = add($n, 1);
    }
    $bit = add($bit, 1);
}
if (testbit(%viking_bits, ^viking_vote_swensen) = 1) {
    $n = add($n, 1);
}
return($n);

[proc,viking_has_all_votes]()(boolean)
if (~viking_votes_won >= ^viking_votes_needed) {
    return(true);
}
return(false);

// Names the council members still owed a favour, so the quest is followable without a wiki open.
[proc,viking_brundt_remaining]
if (testbit(%viking_bits, ^viking_vote_manni) = 0) {
    mes("Manni the Reveller has not given you his vote.");
}
if (testbit(%viking_bits, ^viking_vote_sigli) = 0) {
    mes("Sigli the Huntsman has not given you his vote.");
}
if (testbit(%viking_bits, ^viking_vote_olaf) = 0) {
    mes("Olaf the Bard has not given you his vote.");
}
if (testbit(%viking_bits, ^viking_vote_sigmund) = 0) {
    mes("Sigmund the Merchant has not given you his vote.");
}
if (testbit(%viking_bits, ^viking_vote_swensen) = 0) {
    mes("Swensen the Navigator has not given you his vote.");
}
if (testbit(%viking_bits, ^viking_vote_thorvald) = 0) {
    mes("Thorvald the Warrior has not given you his vote.");
}
if (testbit(%viking_bits, ^viking_vote_peer) = 0) {
    mes("Peer the Seer has not given you his vote.");
}

// --- Quest journal ---
// FIXED 2026-09-08 (quest persistence + reward audit): this was the only one of the 67 quests
// coloured in the quest list on login that had no [if_button,questlist:...] behind it, so clicking
// The Fremennik Trials in the journal did nothing at all. The same gap that was found in Regicide
// by clicking it in-game; found here by sweeping every questlist component in
// ~update_questlist against the buttons that actually exist.
//
// The seven trials are done in any order, so the journal lists which votes are still outstanding
// rather than pretending there is a next step.

[if_button,questlist:viking]
def_string $n = "The Fremennik Trials";
def_string $x;
if (%viking >= ^viking_complete) {
    $x = append($x, "@str@I won the votes of all seven members of the Fremennik council and|");
    $x = append($x, "@str@Brundt the Chieftain gave me a Fremennik name.|");
    $x = append($x, "|@dre@QUEST COMPLETE!");
    ~quest_journal($n, $x);
    return;
}
if (%viking = ^viking_not_started) {
    $x = append($x, "@dbl@I can start this quest by speaking to @dre@Brundt the Chieftain@dbl@ in|");
    $x = append($x, "@dbl@the longhall at @dre@Rellekka@dbl@.");
    ~quest_journal($n, $x);
    return;
}
$x = append($x, "@str@To be made a Fremennik I must win the votes of all seven members|");
$x = append($x, "@str@of the council. They can be won in any order.|");
$x = append($x, "|@str@I have <tostring(~viking_votes_won)> of the seven.|");
$x = append($x, "|@dbl@Still to win over:|");
if (testbit(%viking_bits, ^viking_vote_manni) = 0) {
    $x = append($x, "@dbl@@dre@Manni the Reveller@dbl@ - a drinking contest.|");
}
if (testbit(%viking_bits, ^viking_vote_sigli) = 0) {
    $x = append($x, "@dbl@@dre@Sigli the Huntsman@dbl@ - hunt the Draugen.|");
}
if (testbit(%viking_bits, ^viking_vote_olaf) = 0) {
    $x = append($x, "@dbl@@dre@Olaf the Bard@dbl@ - bring him a lyre.|");
}
if (testbit(%viking_bits, ^viking_vote_sigmund) = 0) {
    $x = append($x, "@dbl@@dre@Sigmund the Merchant@dbl@ - his chain of favours.|");
}
if (testbit(%viking_bits, ^viking_vote_swensen) = 0) {
    $x = append($x, "@dbl@@dre@Swensen the Navigator@dbl@ - the maze under his house.|");
}
if (testbit(%viking_bits, ^viking_vote_thorvald) = 0) {
    $x = append($x, "@dbl@@dre@Thorvald the Warrior@dbl@ - fight Koschei the deathless.|");
}
if (testbit(%viking_bits, ^viking_vote_peer) = 0) {
    $x = append($x, "@dbl@@dre@Peer the Seer@dbl@ - his riddle house.|");
}
if (~viking_has_all_votes = true) {
    $x = append($x, "|@dbl@I have every vote. I should return to @dre@Brundt the Chieftain@dbl@.");
}
~quest_journal($n, $x);
