} else if (%viking < ^viking_complete) {
    ~chatplayer("<p,quiz>Hello, are you a member of the council?");
    ~chatnpc("<p,neutral>I am afraid not outerlander. Goodbye.");
}

// 349 tested ^viking_complete twice here, so during the quest Talk-to did nothing at all; the
// in-progress branch is the ordinary "not a council member" answer the other citizens give.
