[if_button,questlist:fairy_farmers]
def_string $text;

switch_int (%fairy_farmers_quest) {
    case ^fairy_not_started :
        $text = "@dbl@Every allotment from @dre@Draynor@dbl@ to @dre@Catherby@dbl@ started dying|";
        $text = append($text, "@dbl@on the same day, and things do not do that|");
        $text = append($text, "@dbl@@dre@Martin the Master Farmer@dbl@ is at the Draynor field");

    case ^fairy_zanaris :
        $text = "@str@There is an old story about who actually looks after growing|";
        $text = append($text, "@str@things, and it is not farmers. The story says Zanaris.|");
        $text = append($text, "@dbl@The throne is the wrong shape and there are guards on the|");
        $text = append($text, "@dbl@door who were not there before|");
        $text = append($text, "@dbl@The @dre@ring coordinator@dbl@ will not say it. @dre@Fairy Nuff@dbl@ might");

    case ^fairy_nuff :
        $text = "@str@The Fairy Queen is on the floor of Nuff's room and has not|";
        $text = append($text, "@str@opened her eyes in eleven days. There is no wound.|");
        $text = append($text, "@dbl@@dre@Read@dbl@ the @dre@symptoms list");

    case ^fairy_symptoms :
        $text = "@str@Slow discorporation of the ethereal body. Fading magical|";
        $text = append($text, "@str@energy. A fever with no cause.|");
        $text = append($text, "@dbl@Tell @dre@Nuff@dbl@ what that adds up to");

    case ^fairy_secateurs :
        $text = "@str@He did not take her power. He took the thing she keeps it|";
        $text = append($text, "@str@in, and put it somewhere a fairy cannot go.|");
        $text = append($text, "@dbl@The @dre@chest@dbl@ nobody in Zanaris can look at|");
        $text = append($text, "@dbl@Bring an ordinary pair of @dre@secateurs@dbl@ too");

    case ^fairy_magic :
        $text = "@str@Magic secateurs: a very small amount of the Fairy Queen, and|";
        $text = append($text, "@str@the only thing in either realm that will kill a Tanglefoot.|");
        $text = append($text, "@dbl@Nuff wants one more thing and it is a @dre@skull@dbl@, from|");
        $text = append($text, "@dbl@@dre@Draynor");

    case ^fairy_skull :
        $text = "@str@A skull, from the Draynor graveyard. Bring a @str@spade@str@.|";
        $text = append($text, "@dbl@Then @dre@three things@dbl@ that grew on this side of the door and|");
        $text = append($text, "@dbl@were not grown by her: @dre@logs@dbl@, an @dre@onion@dbl@ and a @dre@potato");

    case ^fairy_patches :
        $text = "@str@Three dull things from a world that did not need her.|";
        $text = append($text, "@dbl@Take them to @dre@Nuff");

    case ^fairy_tanglefoot :
        $text = "@str@The Tanglefoot had been under the floor of that room since|";
        $text = append($text, "@str@the day she stopped waking up.|");
        $text = append($text, "@dbl@Nuff wants the @dre@Queen's secateurs@dbl@ and the @dre@skull");

    case ^fairy_complete :
        $text = "@str@The Fairy Godfather did not do anything to her. He took the|";
        $text = append($text, "@str@thing she keeps herself in and locked it in a chest that no|");
        $text = append($text, "@str@fairy could look at, and every growing thing on the other|");
        $text = append($text, "@str@side of the door began to die the same day.|");
        $text = append($text, "@str@She woke up, complained that the room was damp, and went|");
        $text = append($text, "@str@back to work.||");
        $text = append($text, "@red@QUEST COMPLETE!");

    case default :
        $text = "@dbl@@dre@Martin the Master Farmer@dbl@ is at the @dre@Draynor@dbl@ field";
}

~quest_journal("A Fairy Tale Part I - Growing Pains", $text);
