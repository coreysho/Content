// FIXED 2026-09-08 (combat-stat audit): op2=Attack and no combat stats at all - unkillable.
// Levels and bonuses read off the OSRS wiki page for Ice wolf (level 96), the same source this repo's drop
// tables already cite. Anything the wiki does not supply is omitted so the engine default
// applies (attackrate 4, respawnrate 100, the generic human attack/defend/death anims).
[trollromance_ice_wolf_1]
name=Ice wolf
desc=Not mans' best friend.
model1=npc_wolf
recol1s=15855
recol1d=23254
recol2s=23254
recol2d=28539
size=2
walkanim=dog_walk
readyanim=dog_ready
op2=Attack
vislevel=96
hitpoints=70
attack=100
strength=90
defence=70
param=damagetype,^stab_style

