/*
TODO LIST - what no source settles, so the current behaviour stands:
- The quest journal line for the sled says "yew or maple logs" whichever was given. The only log of the
  OSRS journal came from a player who gave yew logs and it read 'yew'; nothing says what a maple giver
  sees, or whether a varp remembers the log. Nothing in the 377 cache tracks it either.
- Chill: re-entering the snow keeps the timer's phase (the 10-tick timer runs on while you are in the
  map square and only strikes inside the chill zone); no source says whether re-entry restarts it.
- Teleporting from Trollweiss with the sled worn: the sled comes off after the teleport lands, into
  the pack, or is lost with a full pack (the OSRS wiki's warning). The order of the messages is ours.
- Ug's last lines keep the neutral chatheads: nothing records which mesanims they had.
- The bottom slope's route and crash point are ours: the 377 map gives its start and end slopes and
  the rocks by the tunnel it crashes into, the OSRS wiki the crash itself and its lines, but no log
  of the ride's tiles or camera survives. The top ride keeps the tiles, sounds and camera it had.
*/


[debugproc,trcs] // Teleport to first slope cutscene
if (p_finduid(uid) = true) p_teleport(0_43_59_20_60);

[debugproc,trarrg] // Teleport to Arrg in Stronghold
if (p_finduid(uid) = true) p_teleport(1_44_157_12_46);

// Both slopes use this loc: 0_43_59 is the top one (the summit down to the Trollweiss plateau), 0_43_58
// the one below the plateau (down to the tunnel out to Rellekka). 25 Agility experience a ride (OSRS
// wiki, Slope); 28 Agility is the quest's own requirement, already asked for by Ug.
[oploc1,trollromance_piste_walk_barrier_down]
if (inv_total(worn, trollromance_toboggon_waxed) < 1) {
    mes("You need to have a waxed sled equipped!");
    return;
}
if (coordz(loc_coord) >= coordz(0_43_59_0_0)) {
    ~trollromance_sled_ride_top;
} else {
    ~trollromance_sled_ride_bottom;
}

// Sliding up from the bottom: "Nothing interesting happens." (OSRS wiki, Slope)
[oploc1,trollromance_piste_walk_barrier_up]
~displaymessage(^dm_default);

[oploc1,trollromance_caveentrance] // Tunnel entrance north-west of Trollheim
p_teleport(0_43_159_51_11);

[oploc1,trollromance_piste_tunnel_bottom] // Tunnel entrance in cave from Trollheim, back to Trollheim
p_teleport(0_44_58_6_32);

[oploc1,trollromance_snow_cavewall_crevis] // Crevasse out to Trollweiss Mountain
p_teleport(0_43_60_26_29);

[oploc1,trollromance_piste_top] // Tunnel entrance back towards Trollheim from Trollweiss Mountain
~trollromance_leave_with_sled;
p_teleport(0_43_159_20_55);

[oploc1,trollromance_piste_exit_tunnel_exit] // Tunnel entrance towards Rellekka cave from Trollweiss Mountain
~trollromance_leave_with_sled;
p_teleport(0_43_158_47_22);

[oploc1,trollromance_piste_exit_tunnel_top] // Tunnel entrance towards Trollweiss Mountain from Rellekka cave
p_teleport(0_43_58_45_7);

[oploc1,trollromance_piste_exit_tunnel_bottom] // Tunnel entrance towards Rellekka from Rellekka cave
p_teleport(0_42_58_42_1);

[oploc1,trollromance_stronghold_exit_tunnel] // Tunnel entrance towards Rellekka cave from Rellekka
p_teleport(0_43_158_21_50);

[oploc2,trollromance_rareflowers]
if (inv_freespace(inv) = 0) {
    ~chatplayer("<p,sad>I know it's only a flower, but I haven't got enough space...");
    return;
}
if (%troll_love = ^troll_love_waxed_sled) %troll_love = ^troll_love_picked_trollweiss;
anim(human_pickuptrollweiss_down, 0);
p_delay(0);
anim(human_pickuptrollweiss_up, 0);
inv_add(inv, trollromance_rare_flower, 1);

[proc,trollromance_dunstan_has_materials]()(boolean)
if (inv_total(inv, yew_logs) > 0 | inv_total(inv, maple_logs) > 0) {
    if (inv_total(inv, iron_bar) > 0 & inv_total(inv, rope) > 0) {
        return (true);
    }
}
return (false);

[opheldu,bucket_wax]
if(last_useitem = swamp_tar) { // Troll Romance quest
    @make_sled_wax;
}
~displaymessage(^dm_default);

[label,make_sled_wax]
if (inv_total(inv, cake_tin) < 1) {
    mes("You need something to put the wax in... like a cake tin.");
    return;
}
mes("You make some sled wax.");
inv_del(inv, bucket_wax, 1);
inv_del(inv, swamp_tar, 1);
inv_del(inv, cake_tin, 1);
inv_add(inv, trollromance_wax, 1);

[opheldu,trollromance_wax]
if(last_useitem = trollromance_toboggon) { // Troll Romance quest
    @make_waxed_sled;
}
~displaymessage(^dm_default);

[label,make_waxed_sled]
mes("You wax the sled. You're now ready to go.");
if (%troll_love = ^troll_love_dunstan_made_sled) %troll_love = ^troll_love_waxed_sled;
anim(trollromance_toboggan_waxing, 0);
inv_del(inv, trollromance_toboggon, 1);
inv_del(inv, trollromance_wax, 1);
inv_add(inv, trollromance_toboggon_waxed, 1);
inv_add(inv, cake_tin, 1);
sound_synth(wax_sled, 1, 0);

[proc,unequip_trollromance_sled]
if (inv_getobj(worn, ^wearpos_rhand) = trollromance_toboggon_waxed) {
    ~unequip(^wearpos_rhand);
    ~update_bas;
}

// Leaving the mountain - a tunnel or a teleport - takes the sled off: into the pack, or, with no room
// for it, it is lost ("If you teleport away while using the sled and you have full inventory, you will
// lose it and have to get a new one!" - OSRS wiki, Sled). The tunnels used to try the unequip alone,
// which a full pack refuses, so the sled stayed worn - and ridden - all the way to Trollheim.
[proc,trollromance_leave_with_sled]
if (inv_getobj(worn, ^wearpos_rhand) = trollromance_toboggon_waxed) {
    if (inv_freespace(inv) > 0) {
        ~unequip_trollromance_sled;
        mes("You remove the sled.");
    } else {
        inv_del(worn, trollromance_toboggon_waxed, 1);
        p_animprotect(^false);
        ~update_bas;
        mes("You drop the sled.");
    }
}

[proc,can_ride_sled]()(boolean)
if (inzone(^sled_lower_coord, ^sled_upper_coord, coord) = true) {
    ~equip(last_slot);
    ~update_bas;
    p_animprotect(^true);
    return(true);
}
mes("You cannot use that here!");
~unequip_trollromance_sled; // Safety, but shouldn't really be hit
return(false);

[opheld2,trollromance_toboggon_waxed]
~can_ride_sled;

// One leg of a ride: two tiles a tick, the sled's own run animation. A real run (p_temprun + p_walk)
// rather than a p_teleport every tick - a short teleport reaches the client as a walk, so the rider
// crept along at walking pace a tile behind where the server had him, in the walk animation.
[proc,trollromance_sled_run](coord $dest)
p_temprun;
p_walk($dest);
p_delay(0);

[proc,trollromance_sled_bas](seq $run)
~bas_set(trollromance_toboggan_ready, $run, $run, $run, $run, $run, $run);

// The top slope, the quest's: over the snow banks with a jump, into the clearing above the Trollweiss
// ("You'll see your character sledding down the mountain, jumping over snow banks, and you'll
// eventually end up in a clearing" - Sal's Realm, 2006). Tiles, sounds and camera as they were.
[proc,trollromance_sled_ride_top]
if_close;
p_teleport(0_43_59_20_58);
~trollromance_sled_bas(trollromance_toboggan_moving);
say("Here we go!");
sound_synth(sled_start, 1, 0);
p_delay(0);
~trollromance_sled_run(0_43_59_18_56);
~trollromance_sled_run(0_43_59_18_54);
~trollromance_sled_run(0_43_59_18_52);
~trollromance_sled_run(0_43_59_17_50);
sound_synth(sled_loop, 5, 0);
~trollromance_sled_run(0_43_59_17_48);
~trollromance_sled_run(0_43_59_17_46);
~trollromance_sled_run(0_43_59_17_44);
~trollromance_sled_run(0_43_59_17_42);
~trollromance_sled_run(0_43_59_19_40);
cam_moveto(0_43_59_18_46, 300, 20, 50);
cam_lookat(0_43_59_21_33, 300, 50, 50);
~trollromance_sled_run(0_43_59_21_38);
~trollromance_sled_run(0_43_59_23_36);
~trollromance_sled_run(0_43_59_25_34);
cam_moveto(0_43_59_35_36, 300, 20, 50);
cam_lookat(0_43_59_28_31, 300, 50, 50);
~trollromance_sled_run(0_43_59_27_32);
~trollromance_sled_run(0_43_59_29_30);
sound_synth(sled_jump, 1, 0);
~trollromance_sled_bas(trollromance_toboggan_flying);
~trollromance_sled_run(0_43_59_31_28);
~trollromance_sled_run(0_43_59_33_26);
~trollromance_sled_bas(trollromance_toboggan_moving);
~trollromance_sled_run(0_43_59_34_24);
sound_synth(sled_stop, 1, 0);
cam_reset;
p_delay(1);
say("That was quite a ride!");
p_delay(1);
~update_bas;
p_teleport(0_43_59_38_18);
facesquare(movecoord(coord, 0, 0, -1));
stat_advance(agility, 250);

// The bottom slope: down the west side of the ridge and between the ice rocks, along its foot to the
// one-tile chute that ends at the bottom slope, and over that into the rocks above the tunnel
// (troll_romance_rocknoblock, placed there in the 377 map). Every leg is a clear two-tile run. The
// crash and everything said are the OSRS wiki's (Transcript:Troll Romance, "Crashing"; Trollweiss
// Mountain: "Crashing into rocks causes no damage to the player").
[proc,trollromance_sled_ride_bottom]
if_close;
p_teleport(0_43_58_34_58);
~trollromance_sled_bas(trollromance_toboggan_moving);
say("Here we go!");
sound_synth(sled_start, 1, 0);
p_delay(0);
~trollromance_sled_run(0_43_58_33_56);
~trollromance_sled_run(0_43_58_32_54);
sound_synth(sled_loop, 5, 0);
~trollromance_sled_run(0_43_58_31_52);
~trollromance_sled_run(0_43_58_30_50);
~trollromance_sled_run(0_43_58_29_48);
~trollromance_sled_run(0_43_58_28_46);
cam_moveto(0_43_58_20_40, 300, 20, 50);
cam_lookat(0_43_58_26_32, 300, 50, 50);
~trollromance_sled_run(0_43_58_27_44);
~trollromance_sled_run(0_43_58_27_42);
~trollromance_sled_run(0_43_58_27_40);
~trollromance_sled_run(0_43_58_26_38);
~trollromance_sled_run(0_43_58_25_36);
~trollromance_sled_run(0_43_58_25_34);
~trollromance_sled_run(0_43_58_25_32);
~trollromance_sled_run(0_43_58_26_30);
cam_moveto(0_43_58_24_24, 300, 20, 50);
cam_lookat(0_43_58_36_22, 300, 50, 50);
~trollromance_sled_run(0_43_58_27_28);
~trollromance_sled_run(0_43_58_29_26);
~trollromance_sled_run(0_43_58_31_24);
~trollromance_sled_run(0_43_58_33_23);
~trollromance_sled_run(0_43_58_35_22);
~trollromance_sled_run(0_43_58_37_21);
~trollromance_sled_run(0_43_58_39_21);
say("O-oh, this doesn't look good!");
cam_moveto(0_43_58_46_18, 300, 20, 50);
cam_lookat(0_43_58_41_13, 300, 50, 50);
~trollromance_sled_run(0_43_58_41_21);
~trollromance_sled_run(0_43_58_41_19);
~trollromance_sled_run(0_43_58_41_17);
// over the end of the slope and into the rocks; the sled's pose blocks anims while it is worn
p_animprotect(^false);
anim(trollromance_toboggan_crashing, 0);
sound_synth(sledcrash, 1, 0);
p_exactmove(coord, 0_43_58_41_13, 0, 30, ^exact_south);
p_delay(2);
anim(trollromance_toboggan_getup, 0);
p_delay(1);
cam_reset;
~update_bas;
p_animprotect(^true);
stat_advance(agility, 250);
~chatplayer("<p,sad>And I thought snow was soft...");
~chatplayer("<p,neutral>Although it was a little softer than the rock I hit.");


[queue,trollromance_quest_complete]
// https://web.archive.org/web/20060428042217/http://runescape.salmoneus.net/quests/TrollRomance/trollrmcecomplt.png
session_log(^log_adventure, "Quest complete: Troll Romance");
%troll_love = ^troll_love_complete;
// Gems given in the below order as per: https://youtu.be/V88fh4k0Po4?si=Gyb2h6BI9566rs3Z&t=969
inv_add(inv, uncut_diamond, 1);
inv_add(inv, uncut_ruby, 2);
inv_add(inv, uncut_emerald, 4);
stat_advance(agility, 80000);
stat_advance(strength, 40000);
// The scroll's reward lines (OSRS wiki, Troll Romance reward scroll): 8,000 Agility, 4,000 Strength and
// the gems. They are '|'-separated like every other quest's; the "\\n" tried before ran them together.
~send_quest_complete(questlist:troll_love, trollromance_rare_flower, 250, ^troll_love_questpoints, "You have completed the\\nTroll Romance Quest!", "8,000 Agility XP|4,000 Strength XP|7 Uncut Gems");
