[if_button,questlist:misc]
def_string $text;
def_string $child = "Princess Astrid";
if (~misc_courting_brand = true) {
    $child = "Prince Brand";
}

if (%misc_quest = ^misc_not_started) {
    $text = "@dbl@I can start this quest by speaking to @dre@King Vargas@dbl@ in the|";
    $text = append($text, "@dre@Miscellania@dbl@ castle, on the island north of @dre@Rellekka@dbl@.|");
    $text = append($text, "@dbl@To start this quest I will need:|");
    $text = append($text, "@dre@Heroes' Quest@dbl@ and @dre@The Fremennik Trials@dbl@ completed.");
    ~quest_journal("Throne of Miscellania", $text);
    return;
}

if (%misc_quest >= ^misc_complete) {
    $text = "@str@King Vargas, cursed into a yeti in the icelands, needed a regent.|";
    $text = append($text, "@str@I made peace with Queen Sigrid of Etceteria, won the trust|");
    $text = append($text, "@str@of <$child>, and the support of the people.|");
    $text = append($text, "@str@I am now the Regent of Miscellania.||");
    $text = append($text, "@red@QUEST COMPLETE!||");
    $text = append($text, "@dbl@Approval: @dre@<tostring(~misc_approval_percent)>%@dbl@   Coffers: @dre@<~misc_commas(%misc_coffers)>@dbl@ coins");
    ~quest_journal("Throne of Miscellania", $text);
    return;
}

$text = "@str@King Vargas, cursed into a yeti in the icelands, needs a regent.|";

// the peace deal
switch_int (%misc_quest) {
    case ^misc_started :
        $text = append($text, "@dbl@He wants me to make peace with @dre@Etceteria@dbl@. I should speak|");
        $text = append($text, "@dbl@to @dre@Queen Sigrid@dbl@ in the castle there.|");
    case ^misc_sigrid_terms :
        $text = append($text, "@str@Queen Sigrid will make peace if Miscellania recognises|");
        $text = append($text, "@str@Etceteria as a sovereign nation.|");
        $text = append($text, "@dbl@I should tell @dre@King Vargas@dbl@.|");
    case ^misc_anthem_demand :
        $text = append($text, "@str@Vargas will recognise Etceteria when Sigrid changes her|");
        $text = append($text, "@str@national anthem, 'You're Stupid, We're the Best'.|");
        $text = append($text, "@dbl@I should tell @dre@Queen Sigrid@dbl@.|");
    case ^misc_new_anthem :
        $text = append($text, "@str@Queen Sigrid will change her anthem if somebody writes a|");
        $text = append($text, "@str@new one, and there is not a bard to be had in Etceteria.|");
        if (inv_total(inv, misc_good_anthem) > 0) {
            $text = append($text, "@dbl@Advisor Ghrim has improved @dre@Prince Brand@dbl@'s anthem. I should|");
            $text = append($text, "@dbl@take it to @dre@Queen Sigrid@dbl@.|");
        } else if (inv_total(inv, misc_awful_anthem) > 0) {
            $text = append($text, "@dbl@@dre@Prince Brand@dbl@ wrote one. It is awful; perhaps @dre@Advisor Ghrim@dbl@|");
            $text = append($text, "@dbl@can do something with it.|");
        } else {
            $text = append($text, "@dbl@I need somebody to compose a @dre@new anthem@dbl@.|");
        }
    case ^misc_treaty :
        $text = append($text, "@str@Queen Sigrid liked the new anthem and signed a treaty.|");
        $text = append($text, "@dbl@I should take the @dre@treaty@dbl@ to @dre@King Vargas@dbl@.|");
    case ^misc_pen :
        $text = append($text, "@str@Queen Sigrid signed a treaty, but King Vargas cannot hold|");
        $text = append($text, "@str@an ordinary pen.|");
        $text = append($text, "@dbl@I need a @dre@giant nib@dbl@ and some @dre@logs@dbl@ to make him one.|");
    case ^misc_support :
        $text = append($text, "@str@Etceteria and Miscellania are at peace.|");
        $text = append($text, "@dbl@I need @dre@75%@dbl@ of the people behind me. Helping them with their|");
        $text = append($text, "@dbl@work will win them over. @dbl@Approval: @dre@<tostring(~misc_approval_percent)>%|");
}

// the royal family
if (%misc_court_stage >= ^misc_court_trusted) {
    $text = append($text, "@str@<$child> trusts me to rule.|");
} else if (%misc_court_stage > ^misc_court_none) {
    $text = append($text, "@dbl@I am trying to win the trust of @dre@<$child>@dbl@.|");
} else {
    $text = append($text, "@dbl@I must also win the trust of @dre@<$child>@dbl@.|");
}
~quest_journal("Throne of Miscellania", $text);
