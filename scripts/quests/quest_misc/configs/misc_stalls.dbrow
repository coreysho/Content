// The Miscellania and Etceteria market stalls (skill_thieving/configs/stalls/stealing.dbtable).
// The OSRS wiki's Fish stall and Veg stall: 42 Thieving for 42 xp every 12 ticks, 2 Thieving for
// 10 xp every 2. pet_base is the Rocky's B in 1 in (B - level*25), worked back from the wiki's
// 1/35,440 at level 42 and 1/206,727 at level 2.
[stealing_misc_fish_stall]
table=stealing
data=loc,misc_fish_market
data=owner,misc_fish_monger
data=level,42
data=experience,420
data=respawn_ticks,12
data=loot,raw_salmon,1,1,14,a raw salmon
data=loot,raw_tuna,1,1,5,a raw tuna
data=loot,raw_lobster,1,1,1,a raw lobster
data=loot_total,20
data=stall,fish stall
data=pet_base,36490

