// Throne of Miscellania.
//
// Five varps. misc_quest is the spine and the other four are a kingdom:
//
//   misc_restotal    18 bits   the resource yield
//   misc_approval     7 bits   0-100, which is exactly the range seven bits wants
//   misc_affection    7 bits   the same, for the heir
//   misc_coffers     27 bits   the treasury
//   misc_points_wood / _herb / _fish / _mine   4 bits each - how the workers are split
//   misc_visited, misc_grantedaudience, misc_toldking, misc_acceptedtomarry,
//   misc_know_sigrid, misc_killed, and six misc_sN_dM dialogue bits
//
// Two seven-bit counters that top out at a hundred are a percentage each, and four four-bit
// counters that have to add up are a labour allocation. The post-quest kingdom management is
// declared in the varbits before a line of it is written.
//
// ---------------------------------------------------------------------------- the approval work
// Three "dummy" resources are placed one tile from the three tradesmen who stand next to them:
//
//   misc_dummy_mapletree  op1=Chop down  at 2550,3867 - the lumberjack is at 2550,3869
//   misc_dummy_coalrock1  op1=Mine       at 2526,3892 - the miner is at 2526,3893
//   misc_dummy_heather_normal op1=Weed   at 2526,3851 - the gardener is at 2525,3850
//
// and then thirty-six real misc_heather_light/normal/dark patches across the island, every one of
// them carrying op1=Weed and none of them a handler. That is the approval: you do the island's
// work until the island approves of you.
//
// ---------------------------------------------------------------------------- the treaty
//   Treaty     "Just needs the King's signature."
//   Giant nib  "For making a giant pen."
//   Giant pen  "The King should be able to use this."
//
// Three obj descriptions and a complete sub-plot: King Vargas cannot sign anything with a normal
// pen, so somebody has to make him one he can hold.
//
// ---------------------------------------------------------------------------- the anthem
//   Awful anthem  "It's not very good."
//   Good anthem   "Much better."
//
// ---------------------------------------------------------------------------- the crossing
// misc_ship_gangplank is placed twice: 1_41_57_4_45, which is Rellekka, and 1_40_60_21_6, which is
// Miscellania, with misc_sailor standing on the next tile along.
^misc_not_started = 0
^misc_arrived = 1        // Ghrim has explained
^misc_working = 2        // out earning approval
^misc_approved = 3       // 100%
^misc_audience = 4       // through the throne room door
^misc_pen = 5            // the King can hold a pen
^misc_sigrid = 6         // Etceteria will sign
^misc_complete = 7

^misc_off = 0
^misc_on = 1

^misc_approval_target = 100
^misc_approval_per_job = 5
^misc_affection_target = 100
^misc_affection_per_gift = 20

// ---------------------------------------------------------------------------- places
^misc_gangplank_rellekka = 1_41_57_4_45    // 2628,3693
^misc_gangplank_island = 1_40_60_21_6      // 2581,3846
^misc_sailor_coord = 0_40_60_21_7
^misc_vargas = 1_39_60_5_19                // 2501,3859
^misc_ghrim = 1_39_60_3_17
^misc_brand = 1_39_60_6_12
^misc_astrid = 1_39_60_6_28
^misc_sigrid_coord = 1_40_60_52_37         // 2612,3877  Etceteria
^misc_throne_door_n = 1_39_60_10_17
^misc_throne_door_s = 1_39_60_10_23
^misc_throne_inside = 1_39_60_8_20
^misc_throne_outside = 1_39_60_12_20
