[if_button,questlist:swansong]
def_string $text;

switch_int (%swansong) {
    case ^swan_not_started :
        $text = "@dbl@The @dre@fishing colony@dbl@ north-west of the @dre@Gnome Stronghold|";
        $text = append($text, "@dbl@has been under siege for eleven days and there is one|");
        $text = append($text, "@dbl@boat and seventy-one people|");
        $text = append($text, "@dbl@@dre@Herman Caranos@dbl@ is outside the gate");

    case ^swan_walls :
        $text = "@str@Sea trolls came up out of the fishing grounds eleven days|";
        $text = append($text, "@str@ago and have not gone back down. The palisade has five|");
        $text = append($text, "@str@holes in it.|");
        $text = append($text, "@dbl@@dre@Franklin@dbl@ wants @dre@5 iron sheets@dbl@ off his @dre@metal press@dbl@:|");
        $text = append($text, "@dre@logs@dbl@ in the firebox, a @dre@tinderbox@dbl@ to light it, then @dre@iron|");
        $text = append($text, "@dre@bars@dbl@ through the press, and each sheet on a broken|");
        $text = append($text, "@dbl@section of the west wall with a @dre@hammer");

    case ^swan_fish :
        $text = "@str@Five sections up, and nobody has eaten since the trolls|";
        $text = append($text, "@str@came, because the fishing grounds are where the trolls are.|");
        $text = append($text, "@dbl@@dre@Monkfish@dbl@, on the north shore. @dre@62 Fishing");

    case ^swan_fed :
        $text = "@str@Seventy-one people fed.|";
        $text = append($text, "@dbl@Talk to @dre@Herman");

    case ^swan_letter :
        $text = "@str@Herman has written to the best magician alive, who has spent|";
        $text = append($text, "@str@thirty years pretending to be a pensioner in Draynor, for|");
        $text = append($text, "@str@the fifth time.");

    case ^swan_wom :
        $text = "@str@The boat came back with one passenger, who is eighty-one and|";
        $text = append($text, "@str@carrying nothing at all.|");
        $text = append($text, "@dbl@Speak to him @dre@outside the gate");

    case ^swan_wom_looked :
        $text = "@str@He has never seen a sea troll and would like to look at one|";
        $text = append($text, "@str@first.|");
        $text = append($text, "@dbl@Stand behind him");

    case ^swan_coma :
        $text = "@str@It was worth watching for about four seconds.|";
        $text = append($text, "@str@He is breathing and he is not waking up, he is eighty-one,|");
        $text = append($text, "@str@and the colony's entire plan was him.|");
        $text = append($text, "@dbl@There is a @dre@book@dbl@ on Herman's desk. @dre@Arnold@dbl@ keeps the|");
        $text = append($text, "@dbl@stores");

    case ^swan_seeds :
        $text = "@str@The last six pages of Herman's book are not Herman's and|";
        $text = append($text, "@str@were written on a floor by a man losing consciousness.|");
        $text = append($text, "@str@BONE SEEDS. Bury them, they come up, they fight. They want|");
        $text = append($text, "@str@a LOT of bones.|");
        $text = append($text, "@dbl@Use @dre@bones@dbl@ on the @dre@bone seeds@dbl@, then @dre@Open@dbl@ them");

    case ^swan_planted :
        $text = "@str@Forty yards of ground started moving all at once and|";
        $text = append($text, "@str@seventy-one people went indoors.|");
        $text = append($text, "@dbl@Find the @dre@skeleton@dbl@ that has been practising");

    case ^swan_battle :
        $text = "@str@Something came out of the water that the small ones were in|";
        $text = append($text, "@str@front of.");

    case ^swan_queen :
        $text = "@str@She went back into the water and did not come up.|";
        $text = append($text, "@dbl@Tell @dre@Herman");

    case ^swan_told :
        $text = "@str@Seventy-one people came out of the buildings very slowly.|";
        $text = append($text, "@dbl@Tell @dre@Herman");

    case ^swan_complete :
        $text = "@str@Twelve days, one boat, seventy-one people and a palisade|";
        $text = append($text, "@str@with five holes in it.|");
        $text = append($text, "@str@Herman counted them twice, and then went and counted the one|");
        $text = append($text, "@str@in his office, who is still asleep.||");
        $text = append($text, "@red@QUEST COMPLETE!");

    case default :
        $text = "@dbl@The @dre@fishing colony@dbl@ has been under siege for eleven days";
}

~quest_journal("Swan Song", $text);
