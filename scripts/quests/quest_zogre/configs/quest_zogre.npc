// Zogre Flesh Eaters - Slash Bash.
//
// Moved here out of _unpack/377/all.npc (redeclaring would be a duplicate-config error), the same
// migration quest_deserttreasure_combat.npc uses. Everything down to vislevel is untouched cache
// appearance data; the stat block below it is new.

[zogre_slash_bash]
name=Slash Bash
desc=A powerful looking Zogre.
model1=npc_2060
model2=npc_2045i2
recol1s=25264
recol1d=15851
recol2s=7362
recol2d=7398
recol3s=25368
recol3d=30757
recol4s=24207
recol4d=13737
recol5s=32634
recol5d=26360
resizeh=256
resizev=240
walkanim=ogre_walk
readyanim=ogre_ready
size=3
op2=Attack
vislevel=111
// Zogre Flesh Eaters' boss had no combat stats at all, so he went down in one hit on 1 hitpoint.
// OSRS values: level 111, 100 hp, 100 attack, 120 strength, 60 defence, +22 attack, +30 stab/slash/
// crush defence, max hit 13, 6-tick crush. His ranged attack and the disease are not built.
// max hit: ((120+9) * (0+64) + 320) / 640 = 13.
hitpoints=100
attack=100
strength=120
defence=60
magic=1
ranged=100
param=attackbonus,22
param=strengthbonus,0
param=stabdefence,30
param=slashdefence,30
param=crushdefence,30
param=attackrate,6
param=damagetype,^crush_style
param=attack_anim,ogre_attack
param=defend_anim,ogre_block
param=death_anim,ogre_death
