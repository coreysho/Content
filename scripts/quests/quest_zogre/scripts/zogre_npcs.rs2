// Zogre Flesh Eaters - Grish at Jiggig, Zavistic Rarve at the Yanille guild, and Irwin's bookcase.

// =========================================================================== Grish

[opnpc1,zogre_ogre_shaman]
switch_int (%zogre) {
    case ^zogre_not_started : @zogre_grish_start;
    case ^zogre_bash_dead : @zogre_grish_finish;
    case default :
        if (%zogre >= ^zogre_complete) {
            ~chatnpc("<p,happy>Ancestors quiet. Grish sleep now. You come back any time.");
            return;
        }
        ~chatnpc("<p,neutral>Dead still walking. You still looking.");
}

[label,zogre_grish_start]
~chatnpc("<p,angry>Human. You go now. Not safe.");
switch_int (~p_choice2("What's happening here?", 1, "Fine, I'm going.", 2)) {
    case 2 :
        ~chatplayer("<p,neutral>Fine, I'm going.");
        ~chatnpc("<p,neutral>Good. Is best.");
        return;
    case 1 :
        ~chatplayer("<p,quiz>What's happening here?");
}
~chatnpc("<p,sad>Jiggig is burial place. Ogres bury own dead here for long time, very long.");
~chatnpc("<p,angry>Now dead not stay buried. Walk about. Attack own people. Is not natural, is not ogre magic - is human magic.");
~chatplayer("<p,quiz>What makes you say human?");
~chatnpc("<p,angry>Because ogres not do this! Somebody come, somebody take thing from deep tomb, somebody wake everything up.");
~chatnpc("<p,neutral>You want help? Go in tomb. Find what taken. Bring back. Then maybe ancestors lie down again.");
~chatnpc("<p,shifty>Warning, human. Things down there not die like normal things. Blunt arrows work best on them - Uglug sell you some.");
%zogre = ^zogre_warned;
%thzfe_grish_warning_yes = 1;
// The barricade's collapsed state. Collision comes from the placed shell and does not change with
// the varbit, so this is the look of the place opening up rather than a gate being lifted.
%thzfe_blocking_barricade = ^zogre_barricade_down;
~send_quest_progress(questlist:zogre, %zogre, ^zogre_complete);

[label,zogre_grish_finish]
if (inv_total(inv, zogre_artifacts) = 0) {
    ~chatnpc("<p,quiz>You kill big one. Where is thing?");
    ~chatplayer("<p,sad>Not on me.");
    ~chatnpc("<p,neutral>Then go get. Is heavy, is not far.");
    return;
}
~chatplayer("<p,happy>Your artefact. It was on a stand in the deepest chamber, and something called Slash Bash was sitting on top of it.");
mes("You hand Grish the ogre artefact.");
inv_del(inv, zogre_artifacts, 1);
~chatnpc("<p,shock>...this. Is this. Is been gone since before my mother.");
~chatnpc("<p,sad>Human took it. Human woke everything. Grish knew.");
~chatnpc("<p,happy>You put right. Grish teach you ogre way of arrows and potions - is useful for killing things that already dead.");
queue(zogre_quest_complete, 0, 0);

// =========================================================================== Zavistic Rarve

[opnpc1,zogre_human_zavistic_rarve]
// The Hand in the Sand runs through Rarve too - he is the guild's sand contract and the dead man
// was one of his. @handsand_rarve_talk is in quests/quest_handsand/scripts/handsand_npcs.rs2 and
// only claims the conversation while that quest actually wants him.
if (%handsand_quest >= ^handsand_rarve & %handsand_quest < ^handsand_complete) {
    @handsand_rarve_talk;
}
if (%zogre = ^zogre_found_evidence) {
    @zogre_rarve_identify;
}
if (%zogre = ^zogre_has_potion & inv_total(inv, zogre_ogre_trans_potion) = 0) {
    ~chatnpc("<p,neutral>Lost it already? Honestly.");
    if (inv_freespace(inv) = 0) {
        ~chatnpc("<p,neutral>Make room and I shall mix another.");
        return;
    }
    inv_add(inv, zogre_ogre_trans_potion, 1);
    mes("Rarve hands you another vial.");
    return;
}
if (%zogre >= ^zogre_complete) {
    ~chatnpc("<p,happy>I hear Jiggig is quiet again. And that Sithik is still an ogre.");
    ~chatplayer("<p,neutral>He'll get over it.");
    ~chatnpc("<p,happy>He will not, and it will do him good.");
    return;
}
~chatnpc("<p,neutral>The guild is not open to sightseers.");

[label,zogre_rarve_identify]
if (inv_total(inv, zogre_black_prism) = 0 | inv_total(inv, zogre_brentle_vahn_backpack) = 0) {
    ~chatnpc("<p,quiz>You have the look of someone about to show me something unpleasant. Get on with it.");
    ~chatplayer("<p,sad>I haven't got it on me.");
    return;
}
~chatplayer("<p,neutral>I found these under Jiggig.");
mes("You show Rarve the prism and the backpack.");
~chatnpc("<p,shock>Brentle Vahn. He has been missing two years and everyone assumed the obvious.");
~chatnpc("<p,angry>And a focusing prism. Cut by somebody who knew exactly what they were doing and had no licence to do it.");
~chatplayer("<p,quiz>Can you tell who?");
~chatnpc("<p,neutral>I can tell you who drinks in the Dragon Inn with a tankard like the one you are also carrying, and who has been selling maps of places he has never been.");
~chatnpc("<p,angry>Sithik Ints. Portrait painter, allegedly.");
~chatplayer("<p,neutral>He'll deny it.");
~chatnpc("<p,happy>He will. So take him this. It is a tonic for his nerves, and it will turn him into an ogre for about a day.");
~chatnpc("<p,neutral>He is upstairs in the house south-east of here, in bed, being ill at people.");
if (inv_freespace(inv) = 0) {
    ~chatnpc("<p,neutral>When you have somewhere to put it.");
    return;
}
%zogre = ^zogre_has_potion;
~send_quest_progress(questlist:zogre, %zogre, ^zogre_complete);
inv_add(inv, zogre_ogre_trans_potion, 1);
mes("Rarve gives you a strange potion.");

// =========================================================================== Irwin and the bookcase

[opnpc1,zogre_necromancers_assistant]
if (%zogre < ^zogre_in_tomb) {
    ~chatnpc("<p,happy>I only assist. I do not practise. There is a difference and I would like it noted.");
    return;
}
~chatnpc("<p,neutral>You have the look of somebody who has been reading things they found on the floor.");
~chatplayer("<p,quiz>Is there a book on it?");
~chatnpc("<p,happy>There is always a book on it. That is rather the problem with necromancy. Help yourself to the shelf.");

[oploc1,thzfe_necro_bookcase]
p_arrivedelay;
if (%zogre < ^zogre_in_tomb) {
    mes("Books on subjects you would rather not read about before lunch.");
    return;
}
if (~obj_gettotal(zogre_necrobook) > 0) {
    mes("You have taken the book you needed.");
    return;
}
if (inv_freespace(inv) = 0) {
    mes("There is a book here you want, and no room for it.");
    return;
}
inv_add(inv, zogre_necrobook, 1);
~mesbox("You take down a book of necromantic spells. The torn page from the tomb fits a gap about two thirds of the way through it.");

// =========================================================================== the signposts

[oploc1,zogre_signpost]
~mesbox("JIGGIG.|Beyond this point the dead do not stay where they are put.");
