// The eight monkey greegrees.
//
// Moved out of _unpack/377/all.obj so they can carry what the cache never gave them. Since the
// Monkey Madness port from PlagueCityRS 349 these are the original's gameplay lines:
//   category=mm_greegree        drives [opheld2,_mm_greegree] (mm_greegree.rs2) and every
//                               ~mm_wearing_greegree check
//   param=next_npc_type         the mm_transmogrification_* npc the wearer turns into
//   param=*_baseanim            the monkey's walk/ready/run set, picked up by ~update_bas
//   param=transform_sound/revert_sound   the synths played on hold and release
// Zooknock carves all eight (mm_zooknock.rs2): the relic's param=mm_bones_type picks the head
// through enum mm_bones_mapping.
//
// wearpos=righthand and iop2=Hold are the cache's own values: a greegree occupies the weapon slot.


[mm_monkey_greegree_for_small_ninja_monkey]
name=Monkey greegree
desc=A magical talisman in the shape of a small ninja monkey head.
recol1s=17969
recol1d=5285
recol2s=32767
recol2d=15749
recol3s=0
recol3d=30753
members=yes
cost=3000
model=obj_mm_monkey_talisman
2dyof=13
2dzoom=750
2dyan=4
2dxan=456
iop2=Hold
weight=3oz
wearpos=righthand
category=mm_greegree
// Monkey Madness (PlagueCityRS 349 original): gameplay properties merged in
tradeable=no
param=ready_baseanim,m_monkey_ready
param=turnonspot_baseanim,m_monkey_walk
param=walk_f_baseanim,m_monkey_walk
param=walk_b_baseanim,m_monkey_walk
param=walk_l_baseanim,m_monkey_walk
param=walk_r_baseanim,m_monkey_walk
param=running_baseanim,m_monkey_run
param=next_npc_type,mm_transmogrification_small_ninja_monkey
param=transform_sound,human_into_smallmonkey
param=revert_sound,smallmonkey_into_human

