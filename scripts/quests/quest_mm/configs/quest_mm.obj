// The eight monkey greegrees.
//
// MOVED OUT OF _unpack/377/all.obj, verbatim, so they can carry two lines the cache never gave them:
//   category=mm_greegree   drives [opheld2,_mm_greegree] and [opheld1,_mm_greegree]
//   param=mm_transmog_npc  names the mm_transmogrification_* npc the wearer turns into
// The cache ships all eight objs AND all thirteen mm_transmogrification_* npcs and links them to
// nothing at all, which is the one gap that stopped the greegrees being buildable.
//
// Only mm_monkey_greegree_for_normal_monkey is obtainable in this quest, which is correct - Monkey
// Madness gives you the one greegree. The other seven are Monkey Madness II content that this cache
// happens to ship early; they are configured here so the mechanic is uniform, not so they can be got.
//
// wearpos=righthand and iop2=Hold are the cache's own values and are untouched: a greegree occupies
// the weapon slot, which is what stops you fighting while you are a monkey.


[mm_monkey_greegree_for_small_ninja_monkey]
name=Monkey greegree
desc=A magical talisman in the shape of a small ninja monkey head.
recol1s=17969
recol1d=5285
recol2s=32767
recol2d=15749
recol3s=0
recol3d=30753
members=yes
cost=3000
model=obj_mm_monkey_talisman
2dyof=13
2dzoom=750
2dyan=4
2dxan=456
iop2=Hold
weight=3oz
wearpos=righthand
category=mm_greegree
param=mm_transmog_npc,mm_transmogrification_small_ninja_monkey

