// Ape Atoll's ladders and the dungeon entrance.
//
// Ape Atoll is built vertically - the island is a ground level with bamboo walkways on p1 and
// watchtowers on p2, and m43_43 alone carries nine ladder pairs. All twelve of the ladder loc types
// shipped with a Climb-up or Climb-down option and NOT ONE had a handler, so the island was a single
// flat floor with a lot of decorative ladders on it. Found by the dead-op audit's loc sweep.
//
// Every one of these moves the player relative to their own level rather than to a fixed
// destination, which is what makes one handler serve a loc that is placed on three floors at once:
// mm_bamboo_ladder_watchtower_east, for instance, sits at p0 AND p1 with Climb-up on both.
//
// ~climb_ladder is the repo's own helper (ladders+stairs/scripts/ladders.rs2), and p_arrivedelay
// before it is the convention every other ladder in that file follows.

[oploc1,mm_bamboo_ladder]
p_arrivedelay;
~climb_ladder(movecoord(coord(), 0, 1, 0), true);

// FIXED 2026-09-09: "reverse" means the two ends are approached from OPPOSITE sides -
// the bottom is forceapproach=east, the top west - so the landing tile is two tiles ACROSS
// the ladder, not the same tile. Straight up put the player in open air off the walkway.
[oploc1,mm_bamboo_ladder_reverse]
p_arrivedelay;
switch_int (loc_angle) {
    case 0 : ~climb_ladder(movecoord(coord(), -2, 1, 0), true);
    case 1 : ~climb_ladder(movecoord(coord(), 0, 1, 2), true);
    case 2 : ~climb_ladder(movecoord(coord(), 2, 1, 0), true);
    case 3 : ~climb_ladder(movecoord(coord(), 0, 1, -2), true);
}

// FIXED 2026-09-09: BOTH watchtowers have a SOLID p1 - mm_watchtower_middle fills every
// tile around the ladder there - so the tower runs p0 <-> p2 directly. The +/-1 version
// dropped the player inside the middle section, and because the west tower is the only
// way onto the p2 plank walk that leads to the east tower, it also made KRUK unreachable:
// his 87-tile pocket at m42_43 x38-45 connects to nothing else on the island.
[oploc1,mm_bamboo_ladder_watchtower_east]
p_arrivedelay;
~climb_ladder(movecoord(coord(), 0, 2, 0), true);

[oploc1,mm_bamboo_ladder_watchtower_west]
p_arrivedelay;
~climb_ladder(movecoord(coord(), 0, 2, 0), true);

// FIXED 2026-09-09: one placement, m43_42 (51,46). The deck is bamboo_bridge1 on p2, not
// p1 - p1 there is only bridge understructure - and the two ends are approached from
// opposite sides, so this is wrong on both counts. Fixed destinations, since there is
// exactly one pair.
[oploc1,mm_bridge_ladder]
p_arrivedelay;
~climb_ladder(2_43_42_51_45, true);

[oploc1,mm_bamboo_ladder_top]
p_arrivedelay;
~climb_ladder(movecoord(coord(), 0, -1, 0), false);

[oploc1,mm_bamboo_ladder_top_reverse]
p_arrivedelay;
switch_int (loc_angle) {
    case 0 : ~climb_ladder(movecoord(coord(), 2, -1, 0), false);
    case 1 : ~climb_ladder(movecoord(coord(), 0, -1, -2), false);
    case 2 : ~climb_ladder(movecoord(coord(), -2, -1, 0), false);
    case 3 : ~climb_ladder(movecoord(coord(), 0, -1, 2), false);
}

[oploc1,mm_bamboo_ladder_top_watchtower_east]
p_arrivedelay;
~climb_ladder(movecoord(coord(), 0, -2, 0), false);

[oploc1,mm_bamboo_ladder_top_watchtower_west]
p_arrivedelay;
~climb_ladder(movecoord(coord(), 0, -2, 0), false);

[oploc1,mm_bridge_ladder_top]
p_arrivedelay;
~climb_ladder(0_43_42_51_47, false);

// The dungeon. Its entrance on the surface at m43_42 (11,15) and its exit at m43_142 (11,15) are the
// same tile a hundred map squares apart, which is the 6400-tile underground offset every trapdoor in
// general_use/scripts/trapdoors.rs2 uses, so the move is the same relative one in both directions.

[oploc1,mm_bamboo_ladder_dungeon_entrance]
if (%mm_main < ^mm_met_garkor) {
    mes("You have no reason to go down there.");
    return;
}
p_arrivedelay;
~climb_ladder(movecoord(coord(), 0, 0, 6400), false);

[oploc1,mm_bamboo_ladder_dungeon_exit]
p_arrivedelay;
~climb_ladder(movecoord(coord(), 0, 0, -6400), true);

// The temple's trapdoor and the crypt under it. mm_temple_trapdoor sits in the hole at m43_43
// (55,33) - that tile is blocked in the map, so the trapdoor is only ever worked from beside it -
// and forceapproach=east turned by the loc's angle 2 puts the approach on its WEST side, the open
// ground floor under the hut at (54,33), which is reached on foot from Marim. The cache ships the
// open state (mm_temple_trapdoor_open, Climb-down/Close) and the rope back up in the crypt,
// mm_climbing_rope_bottom_temple at m43_143 (56,49); none of the three had a trigger, so the crypt
// - and the nut cave off it that Recipe for Disaster's Awowogei needs - could not be reached.
//
// Neither end is the 6400-tile offset of the other: straight down from the trapdoor is solid rock,
// so both landings are fixed tiles next to the loc at the other end (see quest_mm.constant). No
// quest gate beyond the island itself: you only reach Ape Atoll through Monkey Madness, and the
// temple and its crypt were open to anyone standing in Marim.

[oploc1,mm_temple_trapdoor]
mes("The trapdoor opens...");
sound_synth(door_open, 1, 0);
loc_change(mm_temple_trapdoor_open, 500);

[oploc1,mm_temple_trapdoor_open]
mes("You climb down through the trapdoor...");
~climb_ladder(^mm_temple_crypt_arrive, false);

[oploc2,mm_temple_trapdoor_open]
mes("You close the trapdoor.");
sound_synth(door_close, 1, 0);
loc_change(mm_temple_trapdoor, 500);

[oploc1,mm_climbing_rope_bottom_temple]
p_arrivedelay;
mes("You climb up the rope.");
~climb_ladder(^mm_temple_trapdoor_side, true);
