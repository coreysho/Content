// Recipe for Disaster. Wiki: https://oldschool.runescape.wiki/w/Recipe_for_Disaster
// Released March 2006, so era-appropriate for a 377 build.
//
// PASS 1 (2026-09-09) BUILDS THE FRAME ONLY - the Cook, Aris, the way into the frozen dining room,
// the nine frozen victims, the Culinaromancer's chest and the quest journal. The ten sub-quests are
// each their own pass; see the SUB-QUESTS section at the bottom for what the cache already ships
// for each one and where it lives.
//
// ---------------------------------------------------------------------------------------------
// What the cache already ships - which is very nearly everything
// ---------------------------------------------------------------------------------------------
// * The whole dining room, twice, at m29_83 p0. Copy A (z4-19) is the frozen room: the nine victim
//   plinths, Aris, the time-bubble wall along x=4. Copy B (z28-43) is the same room with the nine
//   FREED heroes already placed as npcs - it is the after picture, and the quest ends by sending
//   the player there. Room interior is x5..x10; the walls are castlewall at x=3 and x=11-12.
// * The Lumbridge side: hundred_lumbridge_door at 0_50_50_7_17 (the kitchen door),
//   hundred_lumbridge_doubledoorl/r at (13,21)/(13,22), and hundred_portal_multi at 0_50_50_9_18 -
//   a multiloc on hundred_main_quest_var that becomes hundred_portal_active at state 4.
// * The Culinaromancer's chest: hundred_goodchest at 0_50_150_19_23 in the Lumbridge cellar, a
//   multiloc on hundred_main_quest_var (states 3, 4, 5) resolving to hundred_goodchest_base with
//   op1=Bank, op2=Buy-food, op3=Buy-items.
// * BOTH SHOPS, ten tiers each: hundred_foodchest1..10 and hundred_rewardchest1..10 in
//   _unpack/727/all.inv, all twenty already in pack/inv.pack. Tier N is unlocked by N completed
//   sub-quests, which is exactly what hundred_subquest_tally counts. rewardchestN stocks gauntlet
//   levels 1..N and the first N of the ten cooking weapons.
// * The ten gauntlet levels, the ten cooking weapons (spoon, whisk, spork, spatula, frying pan,
//   skewer, rolling pin, knife, hammer, cleaver), hundred_rewardlamp, and the ten
//   100_journal_head_* icons.
// * Every sub-quest's npcs, objs, locs and varbits. Nothing in this quest is blocked on missing
//   data - it is blocked only on the amount of scripting.
//
// ---------------------------------------------------------------------------------------------
// Stages - %hundred_main_quest_var (100intro bits 0-6)
// ---------------------------------------------------------------------------------------------
// The two multilocs above pin three of these values, so the numbering is not free: the chest must
// be 3, 4 or 5 and the portal must be 4. Everything else is arranged around that.
^hundred_not_started = 0
^hundred_told_by_cook = 1        // the Cook has explained; the castle is inside a time bubble
^hundred_seen_dining_room = 2    // been through the barrier and seen the nine victims
^hundred_met_aris = 3            // Aris has explained; the chest appears in the cellar
^hundred_in_progress = 4         // the portal stands in the dining hall; the ten sub-quests run
^hundred_complete = 5

// ---------------------------------------------------------------------------------------------
// Sub-quest bits - %hundred_subquest_tally (100intro bits 11-20, ten bits, one per sub-quest)
// ---------------------------------------------------------------------------------------------
// Ten bits for ten sub-quests, which is also exactly the number of chest tiers, gauntlet levels and
// cooking weapons the cache ships. One quest point each.
^hundred_bit_cook = 0            // Another Cook's Quest - the start
^hundred_bit_dwarf = 1           // Freeing the Mountain Dwarf
^hundred_bit_goblins = 2         // Freeing the Goblin generals
^hundred_bit_pirate = 3          // Freeing Pirate Pete
^hundred_bit_guide = 4           // Freeing the Lumbridge Guide
^hundred_bit_dave = 5            // Freeing Evil Dave
^hundred_bit_ogre = 6            // Freeing Skrach Uglogwee
^hundred_bit_varze = 7           // Freeing Sir Amik Varze
^hundred_bit_monkey = 8          // Freeing King Awowogei
^hundred_bit_culinaromancer = 9  // Defeating the Culinaromancer
^hundred_subquest_count = 10

// ---------------------------------------------------------------------------------------------
// Coordinates
// ---------------------------------------------------------------------------------------------
// Into the frozen room: (5,5) is the tile immediately inside hundred_lumbridge_door at (5,4), and
// the only loc on it is nothing at all. (4,z) carries the 100_bubble3 time-barrier wall, so do not
// land anyone on x=4.
^hundred_dining_room = 0_29_83_5_5
// The finished room is the same layout 24 tiles north.
^hundred_dining_room_after = 0_29_83_5_29
// Back out: 0_50_50_8_18 is beside the portal at (9,18) in the Lumbridge dining hall and carries no
// loc. (9,19) is a throne and (9,17) is the kitchen wall row.
^hundred_lumbridge_return = 0_50_50_8_18

// Requirement: Cook's Assistant, which is what puts the Cook on speaking terms with you at all.

// ---------------------------------------------------------------------------------------------
// Sub-quest 2: Freeing the Mountain Dwarf - %hundred_dwarf_quest (varp hundred_dwarf, bits 0-10)
// ---------------------------------------------------------------------------------------------
// Rohak is at 0_44_154_49_20, in the dwarf camp at the east end of the tunnel under White Wolf
// Mountain - the same tunnel the Fishing Contest quest opens, whose east exit lands at
// 0_44_154_60_22, eleven tiles away. He is two npcs, not one: hundred_dwarf_dad_multi
// (multivar=hundred_dwarf_multi_dad, 0 -> "An old Dwarf", 1 -> Rohak) at (49,20) and
// hundred_dwarf_drunk_multi (state 2 -> drunk Rohak, with the dwarf_drunk* anims) at (49,21). At
// state 2 the first shell resolves to no child and vanishes, so the swap is clean.
^hundred_dwarf_not_started = 0
^hundred_dwarf_told = 1          // the plinth showed me what he was holding
^hundred_dwarf_met_rohak = 2     // found the old dwarf and learned his name
^hundred_dwarf_needs_ale = 3     // he wants an ale with a coin in the bottom
^hundred_dwarf_drunk_rohak = 4   // he has drunk it
^hundred_dwarf_has_hot = 5       // holding the red-hot cake
^hundred_dwarf_has_cool = 6      // cooled it in water
^hundred_dwarf_done = 7

// %hundred_dwarf_multi_dad drives both of Rohak's shells.
^hundred_rohak_stranger = 0
^hundred_rohak_named = 1
^hundred_rohak_drunk = 2

// ---------------------------------------------------------------------------------------------
// Sub-quest 5: Freeing the Lumbridge Guide - %100guide_prog (varp 100_pirate_quest, bits 12-15)
// ---------------------------------------------------------------------------------------------
// The dish is a cake, and the cache says so without ambiguity: 100guide_flourdone, 100guide_milkdone
// and 100guide_eggdone are the three ingredients of one, and the repo's cooking skill already builds
// cake_tin + pot_flour + bucket_milk + egg -> uncooked_cake -> range -> cake.
//
// The three ingredients come from the three people in Lumbridge who would have them: the Cook, and
// the two local farmers Gee (lumbridge_guide2_man) and Donie (lumbridge_guide2_woman). Both farmers
// are placed twice each around Lumbridge - 0_50_50_19_30 and (45,61) for Gee, (16,54) and (35,25)
// for Donie - with op1=Talk-to and, before this pass, no handler anywhere in the repo. Their whole
// dialogue is new.
//
// NOT USED, and why: 100guide_q1 (5 bits), 100guide_q2 (4), 100guide_tot (4) and 100guide_lastgame
// (3) describe some kind of repeated number game with a running total. What the rules were is not
// recoverable from the data - the ranges do not add up as a sum, there is no interface for it, and
// no npc in the cache carries a param that would drive one - so rather than invent a minigame and
// call it faithful, they are left at zero and recorded here.
^hundred_guide_not_started = 0
^hundred_guide_told = 1          // the plinth showed me what he was reaching for
^hundred_guide_done = 2

// ---------------------------------------------------------------------------------------------
// Sub-quest 9: Freeing King Awowogei - %hundred_ilm_quest (varp hundred_ilm_var_1, bits 0-6)
// ---------------------------------------------------------------------------------------------
// "ilm" is the cache's own prefix for this one - the three wise monkeys Mizaru, Kikazaru and
// Iwazaru (see, hear and speak no evil) stand side by side at 0_43_43_35_43, 36_43 and 37_43 on
// Ape Atoll. Every step is on or under Ape Atoll, so this sub-quest needs Monkey Madness.
//
// The dish is named by the objs and needs no guessing: snake corpse + sliced red banana + Tchiki nut
// paste -> "Raw stuffed snake" -> cook -> "Stuffed snake / Fit for a Monkey King".
//
//   loc_12610   the banana tree at 0_42_43_8_33. A multiloc on hundred_ilm_red_banana_tree:
//               0 and 1 -> "Banana tree" (op1=Pick), 2 -> "Red Banana Tree" with
//               anim=100_ilm_banana_tree_pull_down and NO ops, 3 -> "Red Banana Tree" (op1=Pick).
//               State 2 having the pull-down animation and no ops is what says what the mechanic is:
//               the red ones grow at the crown, out of reach, and you haul the crown down to get at
//               them. Nothing in the cache reddens an ordinary banana, and nothing needed to.
//   loc_12602   "Pit", op1=Enter, 0_45_42_41_33 - in the south-east jungle, among the mm_jungle_snakes
//   loc_12601   "Rope", op1=Climb, 0_47_85_15_48 - the way back out of the snake pit
//   loc_12617   "Exit", op1=Enter, 0_43_143_53_47 - off the Monkey Madness dungeon
//   loc_12616   "Exit", op1=Climb-up, 0_47_85_17_17 - the way back out of the nut cave
//   loc_12615   "Bush", op1=Pick, 0_47_85_12_17 - "A Bush with monkey nuts growing on it"
//   hundred_ilm_snake  npc "Big Snake" lvl 84, three of them at 0_47_85_13_48 / 15_46 / 17_49
//
// NOT USED: hundred_ilm_incorrectly_stuffed_snake ("Odd stuffed snake / Is this really what you
// wanted to do?"). Making one would hand the player an obj with no iops at all - not even Drop - and
// no way to undo it. The wrong-ingredient cases refuse instead.
^hundred_monkey_not_started = 0
^hundred_monkey_told = 1         // the plinth showed me what was on his platter
^hundred_monkey_recipe = 2       // the three monkeys have given me the recipe
^hundred_monkey_done = 3

// %hundred_ilm_red_banana_tree, straight off the multiloc above.
^hundred_banana_tree_normal = 0
^hundred_banana_tree_pulling = 2
^hundred_banana_tree_down = 3

// Landing tiles, all read out of the .jm2 LOC sections.
// (15,49) is inside the snake pit next to the rope at (15,48); the pit interior is x12-18, z45-51.
^hundred_snakepit_bottom = 0_47_85_15_49
// (40,33) is clear ground west of the 2x2 Pit at (41,33)-(42,34).
^hundred_snakepit_top = 0_45_42_40_33
// (16,17) is between the nut bush at (12,17) and the exit at (17,17).
^hundred_nutcave_in = 0_47_85_16_17
// (52,47) is the tile a player stands on to use the cave mouth at 0_43_143_53_47.
^hundred_nutcave_out = 0_43_143_52_47

// ---------------------------------------------------------------------------------------------
// Sub-quest 7: Freeing Skrach Uglogwee - %100_ogre_prog (varp 100_ogre, bits 3-10)
// ---------------------------------------------------------------------------------------------
// The cache put a SECOND Rantz on the Feldip shore for this one: 100_rantz_multi_npc at
// 0_41_46_27_18, multivar=100_ogre_rantz_visible, state 1 -> 100_rantz. Big Chompy's Rantz is a
// different npc entirely, at 0_41_46_6_37, and keeps its own handler. The shore Rantz appears when
// this sub-quest starts, which is what his multivar exists for.
//
// The whole boat is spelled out by one six-state multiloc. 100_jubbly_multi_push_tree at
// 0_41_46_29_19 (width 4) resolves to:
//     0  "Old tree - A large old tree."
//     1  "Old tree" + anim=100_jubbly_tree_fall            (transient)
//     2  "Old tree, pushed over by Rantz."
//     3  "Old tree that's been felled, with the roots cut off."
//     4  "Crude boat - A very crude boat, made from an old tree."
//     5  "Roots - The roots of a large old tree."
// None of the six declares an op, so every interaction with it is [oplocu] (which needs none) or
// comes from Rantz. The seq 100_jubbly_root_chopping is what state 2 -> 3 is animated with.
//
// Once the boat is launched, 100_ogre_jubbly_boat_visible reveals BOTH boat npcs at once -
// 100_jubbly_multi_boat_feldip at 0_41_46_31_20 and 100_jubbly_multi_boat_karamja at 0_43_48_1_9,
// each op1=Board. One varbit, a ferry in both directions.
//
// 100_jubbly_multi_arrow_tree at 0_43_48_10_9 is scenery: state 0 "A small palm tree", state 1 "A
// small palm tree with an ogre arrow in it", and NEITHER declares an op. It is set when the first
// shot is fired and never clicked.
//
// NOT USED: 100_jubbly_spitroast / _cooked / _ruined and 100_jubbly_rock_and_string_brown / _white
// are defined but placed nowhere and declare no ops, so using them would mean loc_add-ing scenery
// for its own sake. The meat cooks on any open fire instead, through a cooking_generic dbrow, and
// the bait is shown by the balloon-toad npc the cache already has.
^hundred_ogre_not_started = 0
^hundred_ogre_told = 1           // the plinth showed me what was on the spit
^hundred_ogre_met_rantz = 2      // Rantz will take me, but he has no boat
^hundred_ogre_tree_pushed = 3    // Rantz put the tree over
^hundred_ogre_roots_cut = 4      // roots off
^hundred_ogre_boat_made = 5      // hollowed out; Rantz drags it to the water
^hundred_ogre_hunting = 6        // the boat runs, and I have bait
^hundred_ogre_has_meat = 7
^hundred_ogre_done = 8

// %100_ogre_jubbly_push_tree, straight off the multiloc above.
^hundred_tree_standing = 0
^hundred_tree_falling = 1
^hundred_tree_over = 2
^hundred_tree_trimmed = 3
^hundred_tree_boat = 4
^hundred_tree_roots = 5

// Landing tiles. The Feldip shore around the tree and boat is open ground; (30,18) carries no loc.
// The Karamja island is empty apart from the palm at (10,9), so (3,9) is clear.
^hundred_jubbly_island = 0_43_48_3_9
^hundred_jubbly_shore = 0_41_46_30_18
// The island itself, for the bait check. It is a sandbar: the boat lands at (1,9), the only loc on
// it is the palm at (10,9), and everything from z4 to z16 is open.
^hundred_jubbly_island_sw = 0_43_48_0_2
^hundred_jubbly_island_ne = 0_43_48_16_18
