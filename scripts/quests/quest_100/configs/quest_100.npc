// Recipe for Disaster - npcs this quest needs that the 377 cache does not have.
//
// THE ONE MISSING PIECE. Freeing Evil Dave is built entirely out of data the cache already ships -
// the four spice shakers in four doses each, the Spicy stew with its Smell option, the four dose
// varbits and their four target varbits, the eighteen Hell-Rats, the cellar, Doris, Dave, and a
// hell-cat form for every stage of the pet cat. Everything except the thing that carries the spice.
//
// In the original the hell-cat's hunting is what flushes out a Hell-Rat Behemoth, and the behemoth is
// what drops the spice. The cache has hundred_dave_hellrat and stops there, so the behemoth is
// written here rather than inventing some other way for spice to appear. It reuses the hell-rat's own
// model at twice the size, which is what the original one is.
//
// Registered as id 3858 in pack/npc.pack.

[hundred_dave_hellrat_behemoth]
name=Hell-Rat Behemoth
desc=A Hell-Rat that has been eating the others.
model1=npc_3382
size=2
resizeh=190
resizev=190
readyanim=mouse_ready
walkanim=mouse_walk
op2=Attack
vislevel=85
hitpoints=40
attack=60
strength=60
defence=50
wanderrange=4
maxrange=10
huntrange=6
huntmode=aggressive_melee
param=damagetype,^crush_style
param=attack_anim,rat_attack
param=defend_anim,rat_block
param=death_anim,rat_death
param=attack_sound,rat_attack
param=defend_sound,rat_hit
param=death_sound,rat_death
