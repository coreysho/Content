// Oronwen, the Lletya seamstress - moved out of _unpack/377/all.npc so her real cache op3=Trade can
// be wired up. Same defect, and the same fix, as Jossik in quest_horror: the cache gives her both
// op1=Talk-to and op3=Trade, but nothing in the repo bound a shop to the second one, so clicking
// Trade did nothing at all. category=shop_keeper + param=owned_shop is what shop/scripts/shop.rs2's
// generic [opnpc3,_shop_keeper] binds against.
//
// CORRECTED 2026-09-08: this first shipped with an invented stock list, because the cache's own shop
// inventories had not been looked for. They exist - _unpack/727/all.inv ships [lletyaseamstressshop1]
// (thread, needle, ball of wool and the six dyes) along with a shop for every other Lletya trader.
// The invented mourning_oronwen_shop.inv was deleted and this now points at the real one.
//
// Everything above category= is a byte-for-byte copy of the original all.npc block.
[mourning_seamstress]
name=Oronwen
desc=An Elven Seamstress.
model1=npc_1679
model2=npc_2353
model3=npc_customs_officeri2
model4=npc_2353i2
model5=npc_2353i3
recol1s=15750
recol1d=21001
recol2s=28464
recol2d=17036
walkanim=human_walk_f,human_walk_b,human_walk_l,human_walk_r
readyanim=human_ready
resizev=129
op1=Talk-to
op3=Trade
vislevel=hide
head1=npc_1679_head
category=shop_keeper
param=owned_shop,lletyaseamstressshop1
param=shop_sell_multiplier,1000
param=shop_buy_multiplier,550
param=shop_delta,10
param=shop_title,Oronwen's Silk Shop
