// Mourning's End Part I. Wiki: https://oldschool.runescape.wiki/w/Mourning%27s_End_Part_I
// Released October 2005, so era-appropriate for a 377 build.
//
// The first half is documented immediately below; the second half (stages 5-20, written 2026-09-09)
// is documented in the SECOND HALF section at the bottom, together with the two blockers this file
// used to record that turned out on re-checking to be wrong.
//
// --- What the cache already ships ---
// Far more than for Regicide. Every npc, loc and obj this half needs is already defined and placed:
//
//   questlist:mourning            component 13974 in pack/interface.pack
//   [mourning_quest]              varp, declared in all.varp - but WITH NO SCOPE LINE (fixed)
//   [mourning_quest_bits]         varp, transmit=yes, also with no scope line (fixed)
//   mourning_can_see_eluned       varbit, mourning_quest_bits bit 0
//   mourning_mourner_disguise     varbit, mourning_quest_bits bit 7  <- used by this half
//   mourning_gnome / _sheep_* / _gun_ammo / _elena / _food_poison* / _eluned_chant
//                                 varbits for the SECOND half, bits 8-28, all already laid out
//
//   mourning_arianwyn      npc 2358, placed  m36_49 (48,36)   Lletya, by the fountain
//   roving_female_woodelf_temp    2375, placed  m36_49 (48,35)   the Lletya copy of Eluned
//   mourning_seamstress    npc 2353, placed  m36_49 (20,43)   Oronwen, op1=Talk-to op3=Trade
//   mourning_stores_man    npc 2352, placed  m36_49 (30,46)
//   mourning_overpass_mourner1  npc 2349, placed  m35_52 (57,2)
//   mourning_overpass_mourner2  npc 2350, placed  m36_51 (27,58)
//   mourning_overpass_mourner3  npc 2351, placed  m36_51 (55,55)
//   eadgar_laundry_basket  loc 4039, placed  m45_53 (32,26)   Taverley, op1=Search
//
//   mourning_bloody_mourner_top  -> mourning_mourner_top   (wearpos=torso, wearpos2=arms)
//   mourning_ripped_mourner_legs -> mourning_mourner_legs  (wearpos=legs)
//   mourning_mourner_gloves / _boots / _cloak, and gasmask
//   mourning_soap                "Tegid's soap", desc "A bar of soap taken from Tegid."
//   mourning_teleport_crystal_4..1, iop1=Activate, "return the user to Lletya"
//
// The mourner drop table in drop_tables/scripts/mourner.rs2 was already wired to all three overpass
// mourners and already dropped the whole outfit. Two things were wrong with it for this quest and
// are fixed there: the three overpass mourners dropped the CLEAN top and trousers, which skipped the
// entire soap-and-seamstress chain, and none of the three had any combat stats at all (vislevel=11
// with no hitpoints/attack/strength/defence line), so they were unkillable in the same way Sir Leye
// and the Tyras guard were before those were fixed.
//
// --- Deviations, flagged rather than hidden ---
// * Tegid does not exist in this cache. There is no npc anywhere in all.npc that gives soap, but
//   eadgar_laundry_basket ("It's full of dirty robes", op1=Search) is placed in Taverley beside
//   where Tegid stands in later revisions. The soap is taken from the basket instead of from him.
//   The obj name and description still say "Tegid's soap", which reads correctly either way.
// * Oronwen repairs the trousers for free. Some accounts have her charge silk for the work; nothing
//   in the cache settles it, and a step that can strand a player who has spent their silk is worse
//   than a step that is too generous.
// * The disguise is checked as worn equipment at the Mourner HQ gate rather than by a quest stage,
//   which is how the gate behaves in game and also means the disguise keeps working afterwards.

^mourning_not_started = 0
^mourning_started = 1           // Islwyn agreed to send you to Lletya
^mourning_told_arianwyn = 2     // Arianwyn briefed you; go and get a mourner's uniform
^mourning_has_disguise = 3      // clean top, repaired trousers, and the rest of the set
^mourning_entered_hq = 4        // walked through the West Ardougne gates wearing it
// 5..19 are the second half; they are listed in the SECOND HALF section at the bottom of this file.
// ^mourning_complete = 20 is declared once, globally, in general/configs/quest.constant.

// --- Requirements ---
// Roving Elves (which itself requires Regicide and Waterfall Quest), 60 Ranged and 50 Thieving.
^mourning_req_ranged = 60
^mourning_req_thieving = 50

// --- Coordinates ---
// A clear tile beside Arianwyn. Everything on (48,34)-(48,37) and (49,36) is shape-22 ground
// decoration, and (49,33)-(49,35) and (49,37)-(49,38) have no loc on them at all - the blocking
// elf_village_* furniture starts at x=50. Verified against the LOC section of maps/m36_49.jm2.
^mourning_lletya_arrive = 0_36_49_49_34

// Where Eluned puts you back down. Islwyn stands at m35_49 (51,11) beside his campfire at
// (50,10); (52,11) is the nearest tile with no loc on it at all in that map square.
^mourning_isafdar_return = 0_35_49_52_11

// Documentation only - these are where the cache put things, and nothing below reads them.
// mourner A  0_35_52_57_2      mourner B  0_36_51_27_58      mourner C  0_36_51_55_55
// laundry basket  0_45_53_32_26      Mourner HQ gates  1_39_51_55_61 and (55,62)

// --- Teleport crystal ---
// Four charges, counting down through the four objs the cache ships, then crumbling. The generic
// [opheld1,...] stubs for all four used to live in general_use/scripts/item_ops_generated.rs2 and
// printed a message without teleporting anyone; they were moved here, since a trigger can only be
// declared once and the real behaviour belongs with the quest.
^mourning_crystal_delay = 3

// --- Rewards ---
// 2 quest points and 25,000 Ranged XP. stat_advance takes tenths.
^mourning_reward_xp = 250000

// ===================================================================================================
// SECOND HALF - stages 5 to 20
// ===================================================================================================
// Written 2026-09-09. The three "NOT BUILT" blockers this file used to carry were re-checked against
// the map and config data and two of the three were wrong. What follows is what is actually there.
//
// CORRECTED: THE HQ IS NOT A DEAD END. The earlier pass looked at m39_51 *p1*, the upper floor. The
//   trapdoor is on p0: mourning_hideout_trap_door [8783] "Trapdoor", op1=Open, at 0_39_51_46_63, in
//   the walled yard behind the door at (50,61), which is reached from the quarters by the p1<->p0
//   staircase pair at 1_39_51_47_61 / 0_39_51_46_60 - both of which ladders+stairs/scripts/stairs.rs2
//   already handles (lines 201 and 303). The return leg is mourner_hideout_ladder1 [8785]
//   op1=Climb-up at 0_31_72_60_42. Neither loc had a handler in any .rs2; both do now.
//
// CORRECTED: THE PLAGUE SHEEP ARE NOT UNPLACED. plaguesheep_1..4 are placed three to a pen in four
//   pens on m40_52, and each one is a multi-npc keyed on its own sheep varbit whose state-1 child is
//   the corresponding mourning_plaguesheep_*. Dyeing a flock is one varbit write. The four dyed
//   variants did ship with no ops at all, which would have made Sheep Herder unfinishable for anyone
//   who dyed a flock first; op1=Prod was added to them in scripts/_unpack/377/all.npc.
//   (The bit ORDER in mourning_quest_bits is blue/red/yellow/green while the pens run red/green/
//   blue/yellow. That is only the bit numbering; every pen is paired with its own varbit and its own
//   dyed child correctly, so nothing needed changing.)
//
// STILL TRUE: THERE IS NO CROSSHAIR INTERFACE. Nothing in pack/interface.pack is an aiming interface,
//   so the sheep-dyeing is not the real minigame. It is implemented as the documented mitigation:
//   use the loaded device on a sheep. The device is still wieldable (iop2=Wield) because the cache
//   gives it wear models, but wielding it is cosmetic.
//
// --- Deviations in this half, flagged rather than hidden ---
// * ELENA IS IN EAST ARDOUGNE, NOT WEST. There is no post-Plague-City West Ardougne placement of her
//   anywhere in this cache; elena2 stands in her house at 0_40_52_32_8. That house is a two minute
//   walk from the plague sheep field on the same map square, so the sieve step and the "come and look
//   at the sheep" step both happen there. She is not npc_add-ed anywhere. (mourner_elena_guard, at
//   0_39_51_38_9 and 0_39_51_43_9, is the pair of mourners outside the Plague City house - not this
//   quest's, despite the name.)
// * THE HEAD MOURNER STAYS AT HIS DESK. He is a plain npc with no multivar, so there is no way to
//   remove him for a while without npc_del on a map spawn. Rather than fake it, the poisoned food is
//   what incapacitates him: he is still standing there, and the desk search says why he is not
//   stopping you. His dialogue changes to match while he is ill.
// * THE NAPHTHA COMES FROM THE REGICIDE STILL, which is already built and stays available after
//   Regicide. Mourning's End requires Roving Elves, which requires Regicide, so this is never a
//   dead end - but it is a longer trip than the wiki route.
// * TEGID'S SOAP still comes from the Taverley laundry basket (see the first-half notes above).
//
// --- Stages ---
// 0..4 are the first half and are documented above.
^mourning_met_gnome = 5         // found the gnome on the rack under the quarters
^mourning_has_sieve = 6         // Elena handed over her sieve
^mourning_has_toxin = 7         // three doses of toxic powder made
^mourning_poisoned_food = 8     // all three food stores in the quarters poisoned
^mourning_has_keys = 9          // searched the head mourner's desk
^mourning_freed_gnome = 10      // unlocked the rack with the tarnished key
^mourning_has_gun = 11          // the gnome repaired his device
^mourning_dyed_sheep = 12       // all four flocks dyed
^mourning_told_elena = 13       // Elena has seen the flocks and will testify
// 14..19 are spare.
// ^mourning_complete = 20 is declared once, globally, in general/configs/quest.constant.

// --- mourning_gnome ---
// The varbit is 4 bits wide and drives two things at once: mourning_gnome_rack's multiloc (0-6
// occupied, 7-13 empty) and mourner_hideout_gnome's multinpc (7-17 resolve to the talking gnome).
// So one write both empties the rack and puts the gnome on his feet. 0 is "still racked".
^mourning_gnome_freed = 7

// --- Paint device ammunition ---
// %mourning_gun_ammo is 3 bits. The order matches plaguesheep_1..4.
^mourning_ammo_empty = 0
^mourning_ammo_red = 1
^mourning_ammo_green = 2
^mourning_ammo_blue = 3
^mourning_ammo_yellow = 4

// --- Coordinates ---
// Down the trapdoor: the ladder room under the quarters is walled at x=58 and x=62, z=39..43, with
// the ladder itself on (60,42). (60,41) carries only poorrug1side, a shape-22 ground decoration.
^mourning_hideout_bottom = 0_31_72_60_41
// Back up: (46,62) is the only tile in the walled yard between the trapdoor at (46,63) and the
// staircase footprint at (46,60)-(47,61) that has no loc on it at all.
^mourning_hideout_top = 0_39_51_46_62

// The Mourner quarters, for the one food-store handler that hangs off a common decorative loc
// (cookingshelves, placed all over Gielinor). Covers both map squares the quarters straddle.
^mourning_quarters_sw = 0_39_51_44_55
^mourning_quarters_ne = 0_39_52_63_10
