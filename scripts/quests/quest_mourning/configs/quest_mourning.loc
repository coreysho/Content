// The gate into the orchard west of West Ardougne, where the rotten apple pile and the cider press
// are. It had Open and nothing behind it, and the orchard is fenced all round, so the apples - and
// with them the toxin - could not be reached on foot. An ordinary double gate now.
[mourning_orchard_fencegate_l]
name=Gate
desc=A wooden gate.
model=plaguesheep_gatel
op1=Open
active=yes
blockrange=no
raiseobject=no
category=door_left_closed
param=next_loc_stage,mourning_orchard_fencegate_open_l

[mourning_orchard_fencegate_r]
name=Gate
desc=A wooden gate.
model=plaguesheep_gatel
mirror=yes
op1=Open
active=yes
blockrange=no
raiseobject=no
