// The four doors of the mourner hideout under West Ardougne. The cache gave each an Open op and
// nothing behind it, so the office - the gnome on his rack, the head mourner's desk and the chest -
// was walled off from the ladder down. The *_open variants carry no ops, which is the cache saying
// these are walk-through doors: they open, let the player through and shut again.
[mourner_hideout_door1]
name=Door
desc=The door is closed.
model=door1
retex1s=wall
retex1d=door
recol2s=6342
recol2d=11458
active=yes
op1=Open
raiseobject=no
category=door_open_and_close
param=next_loc_stage,mourner_hideout_door1_open

