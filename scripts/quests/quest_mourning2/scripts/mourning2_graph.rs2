// Each pillar has its own <floor>_<room>_up varbit on mourning_quest_vert_beams1-5, and the
// pillar loc is a multiloc on it: 0 is dark and 1-7 are the seven colours. Lighting the pillar
// is what the player actually sees, so the trace sets this as it goes.
[proc,m2_pillar_up](int $pillar, int $colour)()
switch_int ($pillar) {
    case 1 : %mourning_light_temple_1_1_up = $colour;
