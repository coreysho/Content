[label,mt_use_mirror](int $pillar)
if (last_useitem ! mourning_mirror) {
    ~displaymessage(^dm_default);
    return;
}
p_arrivedelay;
if (%mourning_quest_main < ^mt_inside) {
    ~mesbox("An octagonal pillar with a socket at head height, and no reason yet to put anything in it.");
    return;
}
def_int $rot = ~mt_mirror_at($pillar);
if ($rot = 0) {
    if (~mt_mirror_count >= ^mt_mirror_slots) {
        ~mesbox("You have no more mirrors out of the cupboards, and this temple was built by people who did not expect anybody to need more than five.");
        return;
    }
    if (~mt_mirror_put($pillar, 0) = false) {
        ~mesbox("There is nowhere to put it.");
        return;
    }
    mes("You set the mirror in the socket.");
    ~mt_retrace;
    return;
}
if ($rot >= 4) {
    ~mt_mirror_clear($pillar);
    mes("You take the mirror back out.");
    ~mt_retrace;
    return;
}
~mt_mirror_put($pillar, $rot);
mes("You turn the mirror a quarter turn.");
~mt_retrace;
