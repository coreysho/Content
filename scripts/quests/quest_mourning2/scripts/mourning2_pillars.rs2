// Every lit state of a pillar carries op1=Search, and none had a trigger. Searching one with the
// hand mirror does what using the mirror on it does; without one it says what is in the socket.
[oploc1,mourning_temple_pillar_1_1] @mt_search_pillar(1);
[oploc1,mourning_temple_pillar_1_3] @mt_search_pillar(2);
