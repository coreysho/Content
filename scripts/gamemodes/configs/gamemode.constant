// XP rate modes (Corey, 2026-09-18) - see claude/xp-rate-modes.md.
//
// THE VARP HOLDS THE RATE ITSELF, not a mode index. That is the whole trick: Player.addXp reads
// the number and multiplies by it, so the ENGINE needs no table of modes and these three values
// are the only place the rates are written down. A mode index would have meant the same three
// numbers living in the engine too, where content cannot see them drift.
//
// 0 means never chosen, and the engine reads it as 1 - the authentic rate, which is exactly what
// the server did before this existed. So every character that already exists is untouched, and a
// player who closes the window without choosing plays at 1x and is asked again.
^xprate_unset = 0
^xprate_realism = 1
^xprate_5x = 5
^xprate_10x = 10

// The three the chooser offers, in the order it draws them. Read by tools/genxpratechooser.py.
^xprate_modes = 3


// ---- the drop-rate boost (droprate.rs2; 2026-09-21, reworked 2026-09-24) ----
// The second half of backlog item 6. How much more often a monster's OWN drop table pays, in
// percent: realism +25%, 5x +10%, 10x nothing. The shared rare drop table is never boosted. Like the
// xp rates, this is the only place the numbers are written down, and like ^poh_range_xp they are
// the tunable part rather than anything out of a cache.
//
// ^xprate_unset (0) is read as realism here for the same reason the engine reads it as 1x: a
// character who has never been asked is playing the authentic rate, and it would be a poor trade to
// hand every existing account the slowest xp and none of the compensation.
^droprate_boost_realism = 25
^droprate_boost_5x = 10
^droprate_boost_10x = 0
// npc_drops:bonus's chances are in ten millionths (tools/gennpcdrops.py, BONUS_UNITS)
^droprate_units = 10000000
// ...and its kinds: an obj, a pet, a clue of each tier
^droprate_kind_obj = 0
^droprate_kind_pet = 1
^droprate_kind_clue_easy = 2
^droprate_kind_clue_medium = 3
^droprate_kind_clue_hard = 4


// ---- the XP lock (xplock.rs2) ----
// GENERATED by tools/genxplock.py.
//
// The bit each skill owns in %xp_locked. It is the skill's index in the ENGINE's stat
// order (PlayerStat.ts, and the identical list the packer resolves a `stat` symbol
// through), because Player.addXp tests bit `stat` directly and keeps no table of its
// own. gamemode_battery.py reads the engine's file and fails if these drift.
^xplock_skills = 23
^xplock_attack = 0
^xplock_hitpoints = 3
^xplock_mining = 14
^xplock_strength = 2
^xplock_agility = 16
^xplock_smithing = 13
^xplock_defence = 1
^xplock_herblore = 15
^xplock_fishing = 10
^xplock_ranged = 4
^xplock_thieving = 17
^xplock_cooking = 7
^xplock_prayer = 5
^xplock_crafting = 12
^xplock_firemaking = 11
^xplock_magic = 6
^xplock_fletching = 9
^xplock_woodcutting = 8
^xplock_runecraft = 20
^xplock_slayer = 18
^xplock_farming = 19
^xplock_construction = 21
^xplock_hunter = 22
