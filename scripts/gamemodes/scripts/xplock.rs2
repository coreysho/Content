// when it runs. Taking the pointer fixes both and keeps the varp protected. Same shape
// as [label,magic_teleport], which the spellbook buttons reach.
if (p_finduid(uid) = true) {
    if (~xplock_is(^xplock_fletching) = true) {
        if (~p_choice2("Unlock Fletching experience?", 1, "No, keep it locked.", 2) = 1) {
            %xp_locked = clearbit(%xp_locked, ^xplock_fletching);
            if_settext(stats:com_191, "Next Level At:");
            mes("Your Fletching experience is no longer locked.");
        }
        return;
    }
    if (~p_choice2("Lock Fletching experience?", 1, "No, leave it.", 2) = 1) {
        %xp_locked = setbit(%xp_locked, ^xplock_fletching);
        if_settext(stats:com_191, "@red@XP locked");
        mes("Your Fletching experience is locked. You will gain no more of it.");
    }
}

