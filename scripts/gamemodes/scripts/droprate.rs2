// Drop-rate boost: the second half of backlog item 6, and the companion to xprate.rs2.
//
// A boosted kill makes the monster's OWN drop table pay more often: realism +25%, 5x +10%, 10x
// nothing (gamemode.constant). A 1/128 drop is about 1/102 on realism. The shared rare drop table is
// left exactly as it is - an earlier version of this gave the slow modes extra draws on it instead,
// and that is what this replaced (2026-09-24).
//
// HOW. The monster's death script runs as it always has, and then, from [proc,npc_death], this rolls
// each row of the monster's bonus list (npc_drops:bonus, written by tools/gennpcdrops.py) once, at
// the row's own chance times the boost. The generator reads that chance out of the death scripts
// themselves, less whatever part of it comes through ~ultrarare_getitem / ~megararetable, so a row
// the rare table can give is boosted only by what the monster's own table gives of it. The expected
// number of every drop therefore goes up by exactly the boost, the drop the table rolled is untouched,
// and nothing can drop that the monster could not already drop.
//
// WHAT IS NOT BOOSTED: what the monster always drops (bones, ashes - there is no rate to raise), the
// rare drop table, and a drop the table picks per killer (the next essence pouch).
//
// WHY ONE HOOK AND NOT 214 EDITS: the drop tables are [ai_queue3] triggers, not procs, so nothing
// outside them can add to one; [proc,npc_death] is the one funnel every death passes through, as it
// is for ~barrows_potential and ~boss_kill_record.

[proc,droprate_bonus]
// npc_findhero sets the active player, which is both who the drop belongs to and whose %xp_rate
// decides the boost. It clones before it sorts and the hero list is fixed-length and pre-filled, so
// calling it here as well as in the monster's own table changes nothing.
if (npc_findhero = ^false) {
    return;
}
def_int $percent = ~droprate_boost_percent;
if ($percent <= 0) {
    return;
}
db_find(npc_drops:npc, npc_type);
def_dbrow $row = db_findnext;
if ($row = null) {
    return;
}
def_coord $at = ~droprate_coord;
def_namedobj $obj;
def_int $least;
def_int $most;
def_int $chance;
def_int $kind;
def_int $count = db_getfieldcount($row, npc_drops:bonus);
def_int $i = 0;
while ($i < $count) {
    $obj, $least, $most, $chance, $kind = db_getfield($row, npc_drops:bonus, $i);
    // the row's chance (in ^droprate_units) times the boost
    if (random(^droprate_units) < scale($percent, 100, $chance)) {
        ~droprate_give($obj, $least, $most, $kind, $at);
    }
    $i = add($i, 1);
}

// One bonus drop, the way the monster's table would have made it.
[proc,droprate_give](namedobj $obj, int $least, int $most, int $kind, coord $at)
switch_int ($kind) {
    // a pet is received the way every pet is (~pet_receive, npc/scripts/follower.rs2), queued on the
    // killer because this runs as the npc
    case ^droprate_kind_pet : ~pet_receive_later($obj, 0);
    // a clue goes through its tier's own drop proc at a chance of 1, which picks the clue and keeps
    // the one-clue-at-a-time rule
    case ^droprate_kind_clue_easy : ~trail_easycluedrop(1, $at);
    case ^droprate_kind_clue_medium : ~trail_mediumcluedrop(1, $at);
    case ^droprate_kind_clue_hard : ~trail_hardcluedrop(1, $at);
    case default :
        obj_add($at, $obj, add($least, random(add(sub($most, $least), 1))), ^lootdrop_duration);
        // announced and logged if the collection log lists it, as the tables do their rares -
        // ~broadcast_drop is the collection log's way in (general/scripts/broadcast.rs2)
        if (enum(obj, int, collection_log_item_index, oc_uncert($obj)) ! -1) {
            ~broadcast_drop($obj);
        }
}

// Where the monster's own loot lands. The Kraken's two die in the water and drop under the player
// (area_kraken_cove/scripts/kraken_drops.rs2); everything else drops where it died.
[proc,droprate_coord]()(coord)
if (npc_type = kraken | npc_type = cave_kraken) {
    return(~kraken_loot_coord);
}
return(npc_coord);

// The boost for this player's mode, in percent. %xp_rate holds the RATE, not a mode index, so this
// compares against the same three constants the engine multiplies by.
//
// Realism is the DEFAULT branch on purpose: ^xprate_unset is 0, the engine already reads that as 1x,
// and a character who has never been asked should get the compensation that goes with the slow rate
// rather than silently getting neither.
[proc,droprate_boost_percent]()(int)
if (%xp_rate = ^xprate_10x) {
    return(^droprate_boost_10x);
}
if (%xp_rate = ^xprate_5x) {
    return(^droprate_boost_5x);
}
return(^droprate_boost_realism);
