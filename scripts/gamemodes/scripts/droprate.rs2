// Drop-rate boost: the second half of backlog item 6, and the companion to xprate.rs2.
//
// A boosted kill gets EXTRA DRAWS on ~ultrarare_getitem - realism two, 5x one, 10x none. The rest of
// the monster's table is untouched, so nothing about a normal kill changes.
//
// WHY ONE HOOK AND NOT 363 EDITS. The xp half put its multiplier in the engine because there are 288
// stat_advance call sites and no wrapper proc, so doing it content-side would have meant editing all
// of them and the next skill anybody wrote would have missed it. The same argument decides this one:
// there are 363 random() calls across 214 drop-table scripts, most of them not even the main ladder,
// and [proc,npc_death] is the single funnel every death already passes through - ~barrows_potential
// and ~boss_kill_record are both hooked there for exactly that reason. One hook means the boost
// means the same thing on every table, including the ones written after this.
//
// WHY IT IS GATED. ~ultrarare_getitem is the SHARED rare table. Granting a draw on it from any
// monster would let a goblin pay out a dragon med helm, which is a new drop source rather than a
// rate boost, and it would read worst in realism - the mode that is supposed to be the authentic
// one. droprate_shared_rare lists the 182 monsters whose own table already reaches that proc, so a
// boosted kill can only ever produce a drop that monster could already have produced.
//
// WHY IT IS ALLOWED TO WHIFF. ~ultrarare_getitem gives nothing on about 10.3% of draws - 15/128 of
// its ladder delegates to ~megararetable, which itself only pays on 15/128 and falls through the
// rest of the time, returning (null, 0) that obj_add discards. A bonus draw has exactly the odds a
// natural draw has, which is what makes the whole thing statable as "the rare slot is rolled twice".
// Re-rolling until it paid would make a bonus draw strictly better than a natural one - a different
// mechanic wearing the same name - and would mean editing the proc all 63 callers depend on.

[proc,droprate_bonus]
// the gate first: a miss on this table answers 0, which is the correct "no shared rare slot here"
if (enum(npc, int, droprate_shared_rare, npc_type) ! 1) {
    return;
}
// npc_findhero sets the active player, which is both who the drop belongs to and whose %xp_rate
// decides the count. It clones before it sorts and the hero list is fixed-length and pre-filled, so
// calling it here as well as in the monster's own table changes nothing and cannot throw on a kill
// nobody is credited with.
if (npc_findhero = ^false) {
    return;
}
def_int $rolls = ~droprate_bonus_rolls;
def_int $i = 0;
while ($i < $rolls) {
    obj_add(npc_coord, ~ultrarare_getitem, ^lootdrop_duration);
    $i = calc($i + 1);
}

// How many extra draws this player's mode is worth. %xp_rate holds the RATE, not a mode index, so
// this compares against the same three constants the engine multiplies by.
//
// Realism is the DEFAULT branch on purpose: ^xprate_unset is 0, the engine already reads that as 1x,
// and a character who has never been asked should get the compensation that goes with the slow rate
// rather than silently getting neither.
[proc,droprate_bonus_rolls]()(int)
if (%xp_rate = ^xprate_10x) {
    return(^droprate_bonus_10x);
}
if (%xp_rate = ^xprate_5x) {
    return(^droprate_bonus_5x);
}
return(^droprate_bonus_realism);
