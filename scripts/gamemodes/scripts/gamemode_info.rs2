// What the quest tab says about the player's game mode (questtab/scripts/questtab.rs2). Here rather
// there because %xp_rate and %xp_locked are read nowhere outside gamemodes/ - gamemode_battery holds
// the tree to that, so nothing can multiply experience or test a lock behind the engine's back.
//
// THE GAME MODE IS THE XP RATE. There is no other mode on this server: Realism, 5x or 10x, chosen
// once on Tutorial Island (xprate.rs2), with the slow modes paid in better drop rates (droprate.rs2).

// How many skills refuse experience.
[proc,xplock_count]()(int)
def_int $count = 0;
def_int $bit = 0;
while ($bit < ^xplock_skills) {
    if (testbit(%xp_locked, $bit) = ^true) {
        $count = add($count, 1);
    }
    $bit = add($bit, 1);
}
return($count);

// The quest tab's Quick actions: what the mode means, in a message box.
[proc,gamemode_explain]
def_int $rate = ~xprate_current;
def_int $percent = ~droprate_boost_percent;
def_string $drops = "and normal drop rates";
if ($percent > 0) {
    $drops = "and <tostring($percent)>% better drop rates from every monster's own drop table";
}
def_string $locks = "No skill is XP locked.";
def_int $locked = ~xplock_count;
if ($locked = 1) {
    $locks = "One skill is XP locked.";
} else if ($locked > 1) {
    $locks = "<tostring($locked)> skills are XP locked.";
}
~mesbox("Your game mode is <~xprate_name($rate)>: <tostring($rate)>x experience, <$drops>. It was chosen on Tutorial Island and cannot be changed. <$locks>");
