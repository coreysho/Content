// THE DRAYNOR VILLAGE - PORT SARIM UNDERWALL TUNNEL (2026-09-21). OSRS's, at Agility 42: the dry-stone
// wall that runs north-south at x=3068 west of Draynor (m47_50, column 60) has a hole either side of
// it. Same model and shape as the Varrock tunnel under its north-south wall (loc_9311/9312), whose
// script this one's follows (skill_agility/scripts/shortcuts.rs2).
[draynor_underwall_tunnel_w]
name=Underwall tunnel
desc=A tunnel leading under the wall.
model=loc_9302
sharelight=yes
wallwidth=32
occlude=yes
op1=Climb-into
active=yes

[draynor_underwall_tunnel_e]
name=Underwall tunnel
desc=A tunnel leading under the wall.
model=loc_9302
sharelight=yes
wallwidth=32
occlude=yes
op1=Climb-into
active=yes
