// Agility skill guide, shown on the original RS2 skill guide interface
// (see content/scripts/interfaces/skill_guide.rs2 for the generic driver).
// Obstacles are not objs; the icons are stand-ins.
[proc,open_agility_guide]
~skillguide_begin(^guide_agility, "Agility");
~skillguide_members;
def_int $lvl = stat(agility);
~skillguide_row(1, $lvl, 1, logs, "Gnome Stronghold Course");
~skillguide_row(2, $lvl, 5, leather_boots, "Crumbling wall (Falador)");
~skillguide_row(3, $lvl, 5, leather_boots, "Climbing rocks");
~skillguide_row(4, $lvl, 10, rope, "Karamja vine swing");
~skillguide_row(5, $lvl, 15, rope, "Monkeybars (Brimhaven)");
~skillguide_row(6, $lvl, 20, logs, "Log balance");
~skillguide_row(7, $lvl, 20, agilityarena_ticket, "Agility Arena - first traps");
~skillguide_row(8, $lvl, 21, leather_boots, "Underwall tunnel");
~skillguide_row(9, $lvl, 25, leather_boots, "Grand Tree vine");
~skillguide_row(10, $lvl, 26, leather_boots, "Underwall tunnel");
~skillguide_row(11, $lvl, 29, leather_boots, "Broken fence");
~skillguide_row(12, $lvl, 32, leather_boots, "Zombie Queen obstacle");
~skillguide_row(13, $lvl, 35, logs, "Barbarian Outpost Course");
~skillguide_row(14, $lvl, 40, agilityarena_ticket, "Agility Arena - later traps");
~skillguide_row(15, $lvl, 40, leather_boots, "Yanille dungeon ledge");
~skillguide_row(16, $lvl, 42, leather_boots, "Crevice");
~skillguide_row(17, $lvl, 49, leather_boots, "Yanille dungeon pipe");
~skillguide_row(18, $lvl, 49, skull, "Wilderness obstacle pipe");
~skillguide_row(19, $lvl, 50, leather_boots, "Legends' jungle obstacle");
~skillguide_row(20, $lvl, 52, skull, "Wilderness Agility Course");
~skillguide_row(21, $lvl, 56, leather_boots, "Isafdar dense forest");
~skillguide_row(22, $lvl, 57, rope, "Monkeybars (Isafdar)");
~skillguide_row(23, $lvl, 67, leather_boots, "Yanille rubble climb");
~skillguide_show;
