// Prayer skill guide, shown on the original RS2 skill guide interface
// (see content/scripts/interfaces/skill_guide.rs2 for the generic driver).
// Prayers have no obj of their own; the bone icons are stand-ins tiered by level.
[proc,open_prayer_guide]
~skillguide_begin(^guide_prayer, "Prayer");
def_int $lvl = stat(prayer);
~skillguide_row(1, $lvl, 1, bones, "Thick Skin");
~skillguide_row(2, $lvl, 4, bones, "Burst of Strength");
~skillguide_row(3, $lvl, 7, bones, "Clarity of Thought");
~skillguide_row(4, $lvl, 10, bones, "Rock Skin");
~skillguide_row(5, $lvl, 13, bones, "Superhuman Strength");
~skillguide_row(6, $lvl, 16, bones, "Improved Reflexes");
~skillguide_row(7, $lvl, 19, bones, "Rapid Restore");
~skillguide_row(8, $lvl, 22, bones, "Rapid Heal");
~skillguide_row(9, $lvl, 25, big_bones, "Protect Item");
~skillguide_row(10, $lvl, 28, big_bones, "Steel Skin");
~skillguide_row(11, $lvl, 31, big_bones, "Ultimate Strength");
~skillguide_row(12, $lvl, 34, big_bones, "Incredible Reflexes");
~skillguide_row(13, $lvl, 37, big_bones, "Protect from Magic");
~skillguide_row(14, $lvl, 40, big_bones, "Protect from Missiles");
~skillguide_row(15, $lvl, 43, big_bones, "Protect from Melee");
~skillguide_row(16, $lvl, 46, dragon_bones, "Retribution");
~skillguide_row(17, $lvl, 49, dragon_bones, "Redemption");
~skillguide_row(18, $lvl, 52, dragon_bones, "Smite");
~skillguide_show;
