[if_button,prayer:prayer_redemption]
if_close;
if (p_finduid(uid) = true) {
    @activate_prayer_redemption;
}
%prayer16 = %prayer16;

[label,activate_prayer_redemption]
p_clearpendingaction;
def_dbrow $data = ~get_prayer_data(^prayer_redemption);
if ($data = null) {
    return;
}
if (%prayer16 = ^true) {
    %prayer16 = ^false;
    ~prayer_deactivate(^prayer_redemption);
    return;
}
if (~prayer_checks($data) = false) {
    %prayer16 = ^false;
    return;
}
def_int $levelreq = db_getfield($data, prayers:level, 0);
if (stat_base(prayer) < $levelreq){
    %prayer16 = ^false;
    sound_synth(prayer_off, 1, 0);
    ~mesbox("You need a @dbl@Prayer level of <tostring($levelreq)> to use <db_getfield($data, prayers:name, 0)>.");
    return;
}
%prayer16 = ^true;
~prayer_activate($data);

// osrs: https://oldschool.runescape.wiki/w/Redemption - triggers when a hit leaves you at or below 10%
// of max HP (but does not prevent a lethal hit), healing floor(prayer level / 4) HP and draining all
// remaining prayer points.
[proc,redemption_check]
if (%prayer16 = ^false) {
    return;
}
if (stat(hitpoints) <= 0) {
    return;
}
if (stat(hitpoints) > divide(stat_base(hitpoints), 10)) {
    return;
}
def_int $heal = divide(stat_base(prayer), 4);
$heal = min($heal, sub(stat_base(hitpoints), stat(hitpoints)));
if ($heal > 0) {
    stat_add(hitpoints, $heal, 0);
    spotanim_pl(redemption_spotanim, 0, 0);
}
stat_sub(prayer, stat(prayer), 0);
~prayer_deactivate_all;
