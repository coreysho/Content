[if_button,prayer:prayer_clarity]
if_close;
if (p_finduid(uid) = true) {
    @activate_prayer_clarity;
    return;
}
// PRESSED WHILE DELAYED USED TO DO NOTHING AT ALL. p_finduid(uid) fails whenever canAccess()
// does - Player.busy() is delayed || containsModalInterface - so a prayer pressed during a spec,
// a teleport or a skilling swing fell straight through to the resync that used to be here, and
// the orb the client had already lit flicked back off. Reported from play 2026-09-21 as "prayer
// activation has bad delays".
//
// A queue gets protected access AND only runs once canAccess() is true again (Player.processQueue
// checks it every tick), so the prayer comes on the moment the delay ends rather than being
// thrown away. The button is buttontype=toggle with pushvar, so the CLIENT flips the varp on
// every press - queueing one toggle per press keeps the parity the player can see, and the
// activate label writes the varp itself either way, which is the resync.
//
// This does NOT change whether praying interrupts what you were doing; see the
// p_clearpendingaction below, which upstream cites period footage for.
queue(retry_prayer_clarity, 0, 0);

[queue,retry_prayer_clarity]
@activate_prayer_clarity;

[label,activate_prayer_clarity]
p_clearpendingaction; // https://youtu.be/j-Z-43CzpZQ?t=120, https://youtu.be/NT74s7nJwAo?t=21, https://www.youtube.com/watch?v=fcRgR_4ZbdA
def_dbrow $data = ~get_prayer_data(^prayer_clarity);
if ($data = null) {
    return;
}
if (%prayer2 = ^true) {
    %prayer2 = ^false;
    ~prayer_deactivate(^prayer_clarity);
    return;
}
if (~prayer_checks($data) = false) {
    %prayer2 = ^false;
    return;
}
def_int $levelreq = db_getfield($data, prayers:level, 0);
if (stat_base(prayer) < $levelreq){
    %prayer2 = ^false;
    sound_synth(prayer_off, 1, 0);
    ~mesbox("You need a @dbl@Prayer level of <tostring($levelreq)> to use <db_getfield($data, prayers:name, 0)>.");
    return;
}
%prayer2 = ^true;
~prayer_activate($data);
