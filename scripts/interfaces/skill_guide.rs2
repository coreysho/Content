// Generic driver for the original RS2 skill guide interface (skill_guide.if,
// dumped from the 377 cache as inter_183 and previously unused).
//
// Layout: a 40-row scrolling list (skill_guide:list) holding a level column
// (lvl1..lvl40), an icon column backed by the 'skillguide' inv, and a name
// column (name1..name40); plus up to 13 category buttons (btn1..btn13)
// revealed by stacking the panel0..panel12 layers.
//
// Usage from a skill's guide script:
//   ~skillguide_begin("Cooking");
//   def_int $lvl = stat(cooking);
//   ~skillguide_row(1, $lvl, 1, cooked_meat, "Cooked meat");
//   ...
//   ~skillguide_show;

// The category buttons are revealed by stacking panel layers cumulatively:
// panel1 adds btn2+btn3, panel2 adds btn4, panel3 btn5, panel4 btn6, panel5 btn7,
// panel6 btn1 (which sits ABOVE btn2 - that is how the original Smithing guide got
// "Smelting" on top), then panel7..panel12 add btn8..btn13. No skill uses them yet.
//
// Resets every row, clears the icon inv and hides all optional chrome.
// Call this first, before any ~skillguide_row.
[proc,skillguide_begin](string $title)
inv_clear(skillguide);
if_settext(skill_guide:title, $title);
if_sethide(skill_guide:skill_model, true);
if_sethide(skill_guide:members, true);
if_sethide(skill_guide:panel0, true);
if_sethide(skill_guide:panel1, true);
if_sethide(skill_guide:panel2, true);
if_sethide(skill_guide:panel3, true);
if_sethide(skill_guide:panel4, true);
if_sethide(skill_guide:panel5, true);
if_sethide(skill_guide:panel6, true);
if_sethide(skill_guide:panel7, true);
if_sethide(skill_guide:panel8, true);
if_sethide(skill_guide:panel9, true);
if_sethide(skill_guide:panel10, true);
if_sethide(skill_guide:panel11, true);
if_sethide(skill_guide:panel12, true);
~skillguide_clearrows;

// Blanks all 40 level/name slots so a shorter guide never shows stale rows.
[proc,skillguide_clearrows]
if_settext(skill_guide:lvl1, "");
if_settext(skill_guide:name1, "");
