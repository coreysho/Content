// Fills one row. $row is 1-based. $curlevel is the player's current level in
// the skill; $level is the level this entry needs - the row is drawn green
// when it is unlocked and red when it is not.
[proc,skillguide_row](int $row, int $curlevel, int $level, namedobj $obj, string $name)
def_int $colour = ^skillguide_locked;
if ($curlevel >= $level) {
    $colour = ^skillguide_unlocked;
}
inv_setslot(skillguide, calc($row - 1), $obj, 1);
switch_int ($row) {
    case 1 : ~skillguide_setrow(skill_guide:lvl1, skill_guide:name1, $level, $name, $colour);
    case 2 : ~skillguide_setrow(skill_guide:lvl2, skill_guide:name2, $level, $name, $colour);
    case 3 : ~skillguide_setrow(skill_guide:lvl3, skill_guide:name3, $level, $name, $colour);
    case 4 : ~skillguide_setrow(skill_guide:lvl4, skill_guide:name4, $level, $name, $colour);
    case 5 : ~skillguide_setrow(skill_guide:lvl5, skill_guide:name5, $level, $name, $colour);
    case 6 : ~skillguide_setrow(skill_guide:lvl6, skill_guide:name6, $level, $name, $colour);
    case 7 : ~skillguide_setrow(skill_guide:lvl7, skill_guide:name7, $level, $name, $colour);
    case 8 : ~skillguide_setrow(skill_guide:lvl8, skill_guide:name8, $level, $name, $colour);
    case 9 : ~skillguide_setrow(skill_guide:lvl9, skill_guide:name9, $level, $name, $colour);
    case 10 : ~skillguide_setrow(skill_guide:lvl10, skill_guide:name10, $level, $name, $colour);
    case 11 : ~skillguide_setrow(skill_guide:lvl11, skill_guide:name11, $level, $name, $colour);
    case 12 : ~skillguide_setrow(skill_guide:lvl12, skill_guide:name12, $level, $name, $colour);
    case 13 : ~skillguide_setrow(skill_guide:lvl13, skill_guide:name13, $level, $name, $colour);
    case 14 : ~skillguide_setrow(skill_guide:lvl14, skill_guide:name14, $level, $name, $colour);
    case 15 : ~skillguide_setrow(skill_guide:lvl15, skill_guide:name15, $level, $name, $colour);
    case 16 : ~skillguide_setrow(skill_guide:lvl16, skill_guide:name16, $level, $name, $colour);
    case 17 : ~skillguide_setrow(skill_guide:lvl17, skill_guide:name17, $level, $name, $colour);
    case 18 : ~skillguide_setrow(skill_guide:lvl18, skill_guide:name18, $level, $name, $colour);
    case 19 : ~skillguide_setrow(skill_guide:lvl19, skill_guide:name19, $level, $name, $colour);
    case 20 : ~skillguide_setrow(skill_guide:lvl20, skill_guide:name20, $level, $name, $colour);
    case 21 : ~skillguide_setrow(skill_guide:lvl21, skill_guide:name21, $level, $name, $colour);
    case 22 : ~skillguide_setrow(skill_guide:lvl22, skill_guide:name22, $level, $name, $colour);
    case 23 : ~skillguide_setrow(skill_guide:lvl23, skill_guide:name23, $level, $name, $colour);
    case 24 : ~skillguide_setrow(skill_guide:lvl24, skill_guide:name24, $level, $name, $colour);
    case 25 : ~skillguide_setrow(skill_guide:lvl25, skill_guide:name25, $level, $name, $colour);
    case 26 : ~skillguide_setrow(skill_guide:lvl26, skill_guide:name26, $level, $name, $colour);
    case 27 : ~skillguide_setrow(skill_guide:lvl27, skill_guide:name27, $level, $name, $colour);
    case 28 : ~skillguide_setrow(skill_guide:lvl28, skill_guide:name28, $level, $name, $colour);
    case 29 : ~skillguide_setrow(skill_guide:lvl29, skill_guide:name29, $level, $name, $colour);
    case 30 : ~skillguide_setrow(skill_guide:lvl30, skill_guide:name30, $level, $name, $colour);
    case 31 : ~skillguide_setrow(skill_guide:lvl31, skill_guide:name31, $level, $name, $colour);
    case 32 : ~skillguide_setrow(skill_guide:lvl32, skill_guide:name32, $level, $name, $colour);
    case 33 : ~skillguide_setrow(skill_guide:lvl33, skill_guide:name33, $level, $name, $colour);
    case 34 : ~skillguide_setrow(skill_guide:lvl34, skill_guide:name34, $level, $name, $colour);
    case 35 : ~skillguide_setrow(skill_guide:lvl35, skill_guide:name35, $level, $name, $colour);
    case 36 : ~skillguide_setrow(skill_guide:lvl36, skill_guide:name36, $level, $name, $colour);
    case 37 : ~skillguide_setrow(skill_guide:lvl37, skill_guide:name37, $level, $name, $colour);
    case 38 : ~skillguide_setrow(skill_guide:lvl38, skill_guide:name38, $level, $name, $colour);
    case 39 : ~skillguide_setrow(skill_guide:lvl39, skill_guide:name39, $level, $name, $colour);
    case 40 : ~skillguide_setrow(skill_guide:lvl40, skill_guide:name40, $level, $name, $colour);
}

[proc,skillguide_setrow](component $lvlcom, component $namecom, int $level, string $name, int $colour)
if_settext($lvlcom, "<tostring($level)>");
if_setcolour($lvlcom, $colour);
if_settext($namecom, $name);
if_setcolour($namecom, $colour);

// Pushes the icon column and opens the guide. Call after the last ~skillguide_row.
[proc,skillguide_show]
inv_transmit(skillguide, skill_guide:icons);
if_setscrollpos(skill_guide:list, 0);
if_openmain(skill_guide);

[if_close,skill_guide]
inv_stoptransmit(skill_guide:icons);
inv_clear(skillguide);
