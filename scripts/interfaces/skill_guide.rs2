// Generic driver for the original RS2 skill guide interface (skill_guide.if,
// dumped from the 377 cache as inter_183 and unused until now).
//
// Layout: a 40-row scrolling list (skill_guide:list) holding a level column
// (lvl1..lvl40), an icon column backed by the 'skillguide' inv, and a name
// column (name1..name40); plus up to 13 category buttons (btn1..btn13).
//
// CATEGORY BUTTONS. The panel layers stack cumulatively: ~skillguide_panels($n)
// shows panel1..panel($n-1), which reveals exactly $n buttons. Which btn indices
// those are is not linear, because panel6 adds a button ABOVE the rest - that is
// how the original Smithing guide put "Smelting" on top:
//   2..6 buttons -> btn2 .. btn($n+1)   (top of the column is btn2, at y=67)
//   7+   buttons -> btn1 .. btn($n)     (btn1 appears at y=48, above btn2)
// Clicking a button stores its index in %skillguide_page and re-renders through
// ~skillguide_selectpage, so a categorised guide needs an open_<skill>_guide entry
// that sets the default page plus a <skill>_guide_render that both it and the
// buttons call - and a case in ~skillguide_selectpage at the bottom of this file.

[proc,skillguide_begin](int $skill, string $title)
%skillguide_skill = $skill;
inv_clear(skillguide);
if_settext(skill_guide:title, $title);
// skill_model is the parchment backdrop, not a stray model - never hide it.
// panel0 is the stone frame the Close Window button sits on, so it always shows.
// The client only honours the hide flag on type=layer components (Client.java,
// drawInterface early-returns unless type == 0), so text like :members has to be
// blanked with if_settext rather than hidden.
if_settext(skill_guide:members, "");
~skillguide_headers("Level", "Advancement");
if_sethide(skill_guide:panel0, false);
if_sethide(skill_guide:panel1, true);
if_sethide(skill_guide:panel2, true);
if_sethide(skill_guide:panel3, true);
if_sethide(skill_guide:panel4, true);
if_sethide(skill_guide:panel5, true);
if_sethide(skill_guide:panel6, true);
if_sethide(skill_guide:panel7, true);
if_sethide(skill_guide:panel8, true);
if_sethide(skill_guide:panel9, true);
if_sethide(skill_guide:panel10, true);
if_sethide(skill_guide:panel11, true);
if_sethide(skill_guide:panel12, true);
~skillguide_clearrows;
~skillguide_clearbuttons;

// Relabels the two column headers. Reset to Level/Advancement by ~skillguide_begin,
// so only a guide that lists something other than levels needs to call it.
[proc,skillguide_headers](string $left, string $right)
if_settext(skill_guide:hdr_level, $left);
if_settext(skill_guide:hdr_advancement, $right);

