// Row colours for the skill guide list, picked to stay legible on the
// parchment rather than using the stock full-brightness rgb constants.
^skillguide_unlocked = 0x1F5E1F
^skillguide_locked = 0x8B1A1A

// Identifies the open guide so ~skillguide_selectpage can re-render it.
// Only the guides with category buttons actually need a dispatch entry.
^guide_combat = 1
^guide_mining = 2
^guide_agility = 3
^guide_smithing = 4
^guide_herblore = 5
^guide_fishing = 6
^guide_ranged = 7
^guide_thieving = 8
^guide_cooking = 9
^guide_prayer = 10
^guide_crafting = 11
^guide_firemaking = 12
^guide_magic = 13
^guide_fletching = 14
^guide_woodcutting = 15
^guide_runecraft = 16
^guide_slayer = 17
