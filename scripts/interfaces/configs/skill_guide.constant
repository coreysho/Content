// Row colours for the skill guide list, picked to stay legible on the
// parchment rather than using the stock full-brightness rgb constants.
^skillguide_unlocked = 0x1F5E1F
^skillguide_locked = 0x8B1A1A

// Identifies the open guide so ~skillguide_selectpage can re-render it.
// Only the guides with category buttons need a dispatch entry there.
^guide_attack = 1
^guide_strength = 2
^guide_defence = 3
^guide_hitpoints = 4
^guide_mining = 5
^guide_agility = 6
^guide_smithing = 7
^guide_herblore = 8
^guide_fishing = 9
^guide_ranged = 10
^guide_thieving = 11
^guide_cooking = 12
^guide_prayer = 13
^guide_crafting = 14
^guide_firemaking = 15
^guide_magic = 16
^guide_fletching = 17
^guide_woodcutting = 18
^guide_runecraft = 19
^guide_slayer = 20
