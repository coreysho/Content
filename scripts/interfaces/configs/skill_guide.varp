// Which guide is open and which category page it is showing, so the category
// buttons can re-render the right skill. Temp scope - nothing here should persist.
//
// protect=no is required: varps are protected by default, and writing a protected
// varp needs the p_active_player pointer, which [if_button,...] triggers do not
// grant. Compare game_options.varp, which does the same for the same reason.
[skillguide_skill]
scope=temp
protect=no

[skillguide_page]
scope=temp
protect=no
