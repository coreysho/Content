// Handles the "View <skill> guide" buttons on the stats (skills) interface.
// NOTE the component numbering: the stats tab is drawn in three columns but the
// components are numbered ROW-wise, so it goes com_68 Attack, com_69 Hitpoints,
// com_70 Mining, com_71 Strength, com_72 Agility, com_73 Smithing, com_74 Defence.
// It is not Attack/Strength/Defence/Hitpoints in a run. This was invisible while all
// four combat stats opened one shared ~book("Combat Guide") popup.
// Attack, Strength, Defence and Hitpoints share a single combined Combat guide,
// matching how the real 2006 Skill Guides grouped the four core combat stats.
// Most skills still get the old single-page text guide, shown via the existing
// general-purpose book popup (see general/scripts/book.rs2). Cooking is the
// pilot for a newer-RuneScape-style scrollable icon list instead (see
// content/scripts/skill_cooking/interfaces/cooking_guide.if and
// content/scripts/skill_cooking/scripts/cooking_guide.rs2) - more skills are
// expected to move to that pattern over time.
//
// Note: each ~book(...) entry below is kept short enough to fit on a single
// book page. proc,book's automatic multi-page split only shows the final page
// once split, so longer text should not be passed to a single ~book(...) call.

[if_button,stats:com_68]
~open_attack_guide;

[if_button,stats:com_69]
~open_hitpoints_guide;

[if_button,stats:com_71]
~open_strength_guide;

[if_button,stats:com_74]
~open_defence_guide;

[if_button,stats:com_70]
~open_mining_guide;

[if_button,stats:com_72]
~open_agility_guide;

[if_button,stats:com_73]
~open_smithing_guide;

[if_button,stats:com_75]
~open_herblore_guide;

[if_button,stats:com_76]
~open_fishing_guide;

[if_button,stats:com_77]
~open_ranged_guide;

[if_button,stats:com_78]
~open_thieving_guide;

[if_button,stats:com_79]
~open_cooking_guide;

[if_button,stats:com_80]
~open_prayer_guide;

[if_button,stats:com_81]
~open_crafting_guide;

[if_button,stats:com_82]
~open_firemaking_guide;

[if_button,stats:com_83]
~open_magic_guide;

[if_button,stats:com_84]
~open_fletching_guide;

[if_button,stats:com_85]
~open_woodcutting_guide;

[if_button,stats:com_240]
~open_runecraft_guide;

[if_button,stats:com_244]
~open_slayer_guide;

[if_button,stats:com_266]
~book("Farming Guide", "@red@Farming@bla@||Grow crops - herbs, trees, fruit and vegetables - by planting seeds in patches around RuneScape.||Most patches need weeding before planting, and some crops benefit from protection against disease.||Crops take real time to grow, so check back on your patches to tend and harvest them.");
