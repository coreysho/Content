// The original RS2 skill guide, dumped from the 377 cache as inter_183 and
// unused until now. Renamed and driven by content/scripts/interfaces/skill_guide.rs2.
//
// This is the untouched cache geometry. Note [skill_model]: it looks like a stray
// 55x81 model at x=200,y=90, but the client draws interface models UNCLIPPED, so
// com_i161 is the torn-parchment backdrop the whole guide sits on - it renders
// roughly x36-421, y16-304. That is why there is no background graphic in here,
// and why [list] is 342 wide: 48+342 = 390, which keeps the scrollbar on the paper.
// Do not hide skill_model and do not widen the list past ~370.
// The panel0..panel12 stone frame and [close] sit 10px right of where the cache put
// them (413 -> 423, 424 -> 434): at 413 the frame's left edge overlapped the paper,
// which ends at x=414. 423+88 = 511, still inside the 512-wide viewport.
// [list] height is 232 rather than the cache's 200: the paper runs to y=307 and
// the list starts at y=65, so 232 fills it with 7 rows instead of leaving 42px bare.

[skill_model]
type=model
x=200
y=90
width=55
height=81
model=com_i161
zoom=643
xan=512

[title]
type=text
x=53
y=30
width=72
height=17
font=q8_full
text=Skill Name

[list]
type=layer
x=48
y=65
width=342
height=232
scroll=1290

