// Christmas 2004 (Santa and the yo-yo), ported from PlagueCityRS 349.
//
// The event is a seasonal one, so it is held to a window around Christmas and is inert the rest of
// the year: outside it Santa (if an admin has put him in the world at all - nothing spawns him, the
// same as in 349) says nothing and gives nothing. The yo-yo itself, once a player has one, plays all
// year and Diango reclaims it all year, the way Jagex's holiday items always worked.
//
// The window is by UTC calendar day (world_minute): from ^xmas2004_first_day of December to
// ^xmas2004_last_day of January, inclusive. Set ^xmas2004_enabled to 0 to switch the event
// off completely, even in December.
^xmas2004_enabled = 1
^xmas2004_first_day = 18
^xmas2004_last_day = 3
