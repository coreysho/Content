// Melee
[opheld2,dragon_dagger] @levelrequire_zanaris_quest_attack(60, last_slot);
[opheld2,dragon_dagger_p] @levelrequire_zanaris_quest_attack(60, last_slot);
[opheld2,dragon_dagger_p+] @levelrequire_zanaris_quest_attack(60, last_slot);
[opheld2,dragon_dagger_p++] @levelrequire_zanaris_quest_attack(60, last_slot);
[opheld2,dragon_mace] @levelrequire_heroes_quest_attack(60, last_slot);
[opheld2,dragon_longsword] @levelrequire_zanaris_quest_attack(60, last_slot);
[opheld2,dragon_battleaxe] @levelrequire_heroes_quest_attack(60, last_slot);
[opheld2,dragon_spear] @levelrequire_attack_caps(60, last_slot);
[opheld2,dragon_spear_p] @levelrequire_attack_caps(60, last_slot);
[opheld2,dragon_spear_p+] @levelrequire_attack_caps(60, last_slot);
[opheld2,dragon_spear_p++] @levelrequire_attack_caps(60, last_slot);
[opheld2,dragon_halberd] @levelrequire_regicide_quest_attack_strength(60, 30, last_slot);
[opheld2,dragon_scimitar] @levelrequire_mm_quest_attack(60, last_slot);

[opheld2,dragon_med_helm] @levelrequire_defence_caps(60, last_slot);
[opheld2,dragon_sq_shield] @levelrequire_legends_quest_defence(60, last_slot);
[opheld2,dragon_chainbody] @levelrequire_defence_caps(60, last_slot);
[opheld2,dragon_platelegs] @levelrequire_defence_caps(60, last_slot);
[opheld2,dragon_plateskirt] @levelrequire_defence_caps(60, last_slot);

// Ranged
[opheld2,red_dragon_vambraces] @levelrequire_ranged_lower(60, last_slot);
[opheld2,red_dragonhide_chaps] @levelrequire_ranged_lower(60, last_slot);
[opheld2,red_dragonhide_body] @levelrequire_ranged_and_defence(60, 40, last_slot);

// Magic

// --- 60 Attack / 60 Magic gear (2026-09-04) ---
[opheld2,dragon_2h_sword] @levelrequire_attack(60, last_slot);
// The dragon axe was the only axe with no wearpos, so it could never be wielded at all.
// wearpos=righthand added in skill_woodcutting/configs/axes/axes.obj; it needs the same
// 60 Attack gate as the other 60-tier weapons (61 Woodcutting to chop is separate and is
// handled by woodcut.rs2).
[opheld2,dragon_axe] @levelrequire_attack(60, last_slot);
// The three god staves are deliberately NOT gated here. They already have an [opheld2,...]
// in areas/area_mage_arena/scripts/god_gear.rs2 which enforces the god-staff/god-cape
// mutual-exclusion rule, and a second definition is a duplicate-trigger build error.
// A hard 60 Magic wield check would also be wrong: the wiki says the staves require
// 60 Magic "to acquire and therefore wield" - the real gate is Mage Arena entry, not the
// wield itself, so leaving god_gear.rs2 as the sole owner is the accurate behaviour.
[opheld2,tzhaar_staff] @levelrequire_magic_and_attack(60, 60, last_slot);
[opheld2,magictraining_bookofmagic] @levelrequire_magic(60, last_slot);
[opheld2,magictraining_wand_master] @levelrequire_magic(60, last_slot);
