// The 2006 crossbows' Ranged requirements (skill_combat/configs/ranged/crossbows.obj) and the Armadyl
// crossbow's (bosses/godwars/configs/armadyl_crossbow.obj), in one place because most of their tiers
// have no file of their own here. Bolts, like arrows in this build, need none to wield.
[opheld2,bronze_crossbow] @levelrequire_ranged(1, last_slot);
[opheld2,blurite_crossbow] @levelrequire_ranged(16, last_slot);
[opheld2,iron_crossbow] @levelrequire_ranged(26, last_slot);
[opheld2,steel_crossbow] @levelrequire_ranged(31, last_slot);
[opheld2,mithril_crossbow] @levelrequire_ranged(36, last_slot);
[opheld2,adamant_crossbow] @levelrequire_ranged(46, last_slot);
[opheld2,rune_crossbow] @levelrequire_ranged(61, last_slot);
[opheld2,armadyl_crossbow] @levelrequire_ranged(70, last_slot);
