// Void Knight equipment - equip gates.
//
// Every piece needs the same seven levels, so one label rather than seven copies.
//
// NOT IMPLEMENTED: the set effects (+45% magic accuracy on the mage helm, +10% damage and accuracy
// on the melee and ranger helms) are script work in the combat path, not config, and are
// deliberately left out - these items are asset + stats only. The helms are otherwise identical,
// so until the set effects exist the three differ in name and inventory model alone.

[label,void_require](int $slot)
if (stat_base(attack) < 42 | stat_base(strength) < 42 | stat_base(defence) < 42
    | stat_base(hitpoints) < 42 | stat_base(ranged) < 42 | stat_base(magic) < 42) {
    mes("You need level 42 Attack, Strength, Defence, Hitpoints, Ranged and Magic to wear this.");
    return;
}
if (stat_base(prayer) < 22) {
    mes("You need level 22 Prayer to wear this.");
    return;
}
~equip($slot);

[opheld2,void_knight_top] @void_require(last_slot);
[opheld2,void_knight_robe] @void_require(last_slot);
[opheld2,void_knight_gloves] @void_require(last_slot);
[opheld2,void_knight_mace] @void_require(last_slot);
[opheld2,void_mage_helm] @void_require(last_slot);
[opheld2,void_ranger_helm] @void_require(last_slot);
[opheld2,void_melee_helm] @void_require(last_slot);
