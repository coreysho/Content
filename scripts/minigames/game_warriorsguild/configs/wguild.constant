// Warriors' Guild (OSRS rules - oldschool.runescape.wiki/w/Warriors'_Guild)
^wguild_tokens_to_enter = 100
^wguild_token_charge = 10
^wguild_token_interval = 100
^wguild_defender_rate = 50
^wguild_dragon_defender_rate = 100
// %wguild_target: 1 + the wguild_defenders index this visit's cyclopes drop, 0 when not in a room
// (0 so that someone who logs back in inside a room gets nothing until they walk in properly)
^wguild_target_none = 0
