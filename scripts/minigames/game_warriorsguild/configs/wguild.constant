// Warriors' Guild (OSRS rules - oldschool.runescape.wiki/w/Warriors'_Guild)
^wguild_tokens_to_enter = 100
^wguild_token_charge = 10
^wguild_token_interval = 100
^wguild_defender_rate = 50
^wguild_dragon_defender_rate = 100
// %wguild_target: 1 + the wguild_defenders index this visit's cyclopes drop, 0 when not in a room
// (0 so that someone who logs back in inside a room gets nothing until they walk in properly)
^wguild_target_none = 0

// Dummy room (ground floor). OSRS: 2 tokens and 15 Attack xp for the right style; wrong style
// stuns for 3 ticks and still gives the xp.
^wguild_dummy_tokens = 2
^wguild_dummy_xp = 150
^wguild_dummy_up = 8
^wguild_dummy_max_up = 2
^wguild_dummy_stun = 3

// Catapult room (first floor). OSRS: 1 token and 10 Defence xp per block, one missile every 8 ticks.
^wguild_catapult_coord = 1_44_55_24_32
^wguild_catapult_spot = 1_44_55_26_25
^wguild_catapult_polls = 4
^wguild_catapult_tokens = 1
^wguild_catapult_xp = 100

// Shot put (first floor, behind the heavy doors, 50 Strength). Lanes run east from the foul line at
// x 2863; the north lane uses the 18lb shot (yards + 1 tokens), the south the 22lb (yards + 3).
^wguild_shot_strength = 50
^wguild_shot_line_x = 2863
^wguild_shot_max_yards = 13
^wguild_shot_dust_throws = 5

// Jimmy's challenge (first floor, north-east). Every interval each keg drains energy and pays out.
^wguild_keg_interval = 12
^wguild_keg_respawn = 100
