[wguild_defenders]
inputtype=int
outputtype=namedobj
val=0,bronze_defender
val=1,iron_defender
val=2,steel_defender
val=3,black_defender
val=4,mithril_defender
val=5,adamant_defender
val=6,rune_defender
val=7,dragon_defender

// Animated armour: npc -> the three pieces it was made from, and the tokens it is worth.
[wguild_armour_helm]
inputtype=npc
outputtype=namedobj
val=wguild_armour_bronze,bronze_full_helm
val=wguild_armour_iron,iron_full_helm
val=wguild_armour_steel,steel_full_helm
val=wguild_armour_black,black_full_helm
val=wguild_armour_mithril,mithril_full_helm
val=wguild_armour_adamant,adamant_full_helm
val=wguild_armour_rune,rune_full_helm

[wguild_armour_body]
inputtype=npc
outputtype=namedobj
val=wguild_armour_bronze,bronze_platebody
val=wguild_armour_iron,iron_platebody
val=wguild_armour_steel,steel_platebody
val=wguild_armour_black,black_platebody
val=wguild_armour_mithril,mithril_platebody
val=wguild_armour_adamant,adamant_platebody
val=wguild_armour_rune,rune_platebody

[wguild_armour_legs]
inputtype=npc
outputtype=namedobj
val=wguild_armour_bronze,bronze_platelegs
val=wguild_armour_iron,iron_platelegs
val=wguild_armour_steel,steel_platelegs
val=wguild_armour_black,black_platelegs
val=wguild_armour_mithril,mithril_platelegs
val=wguild_armour_adamant,adamant_platelegs
val=wguild_armour_rune,rune_platelegs

[wguild_armour_tokens]
inputtype=npc
outputtype=int
val=wguild_armour_bronze,5
val=wguild_armour_iron,10
val=wguild_armour_steel,15
val=wguild_armour_black,20
val=wguild_armour_mithril,25
val=wguild_armour_adamant,30
val=wguild_armour_rune,40

// animator: set index (0 bronze .. 6 rune) -> armour npc
[wguild_armour_npc]
inputtype=int
outputtype=npc
val=0,wguild_armour_bronze
val=1,wguild_armour_iron
val=2,wguild_armour_steel
val=3,wguild_armour_black
val=4,wguild_armour_mithril
val=5,wguild_armour_adamant
val=6,wguild_armour_rune
