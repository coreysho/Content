// 1 + the defender the cyclopes drop for this visit to a cyclops room (wguild_defenders index), 0 = none,
// fixed when you walk in - OSRS makes you leave and re-enter after each new defender.
[wguild_target]
type=int
protect=no

// 1 once you have shown Lorelai a rune defender: the basement stays open after that.
[wguild_basement]
type=int
scope=perm
protect=no
