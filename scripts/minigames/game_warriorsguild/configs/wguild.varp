// 1 + the defender the cyclopes drop for this visit to a cyclops room (wguild_defenders index), 0 = none,
// fixed when you walk in - OSRS makes you leave and re-enter after each new defender.
[wguild_target]
type=int
protect=no

// 1 once you have shown Lorelai a rune defender: the basement stays open after that.
[wguild_basement]
type=int
scope=perm
protect=no

// Catapult room: which defence the player has picked on the wguild_defence tab
// (0 none, 1 stab, 2 crush, 3 slash, 4 magic). Transmitted so the tab can highlight it.
[wguild_catapult_style]
type=int
transmit=yes
protect=no

// Catapult room: 2-tick polls since the player stepped onto the platform (fires every 4th).
[wguild_catapult_count]
type=int
protect=no

// Shot put: throws left with dusted hands (ground ashes), which fouls less often.
[wguild_shot_dust]
type=int
protect=no

// Jimmy's challenge: kegs balanced on the player's head right now (0-5).
[wguild_kegs]
type=int
protect=no
