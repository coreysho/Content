// The Infernal cape, OSRS obj 21295, imported by tools/models/importosrs.py.
//
// THE TWELVE BONUSES ARE THE CACHE'S OWN, and the proof that the param ids are read correctly is
// sitting next door: OSRS obj 6570 is the Fire cape, and its params are
// {0:1, 1:1, 2:1, 3:1, 4:1, 5:11, 6:11, 7:11, 8:11, 9:11, 10:4, 11:2} - exactly the twelve numbers
// _unpack/377/all.obj already carries on [tzhaar_cape_fire] by name. So 0-4 are the five attack
// bonuses, 5-9 the five defences, 10 melee strength and 11 prayer, and the Infernal cape's
// {0-2:4, 3:1, 4:1, 5-9:12, 10:8, 11:2} needs no interpretation at all.
//
// Everything else is a deliberate line-for-line copy of the Fire cape's record - same fields in the
// same order, same weight, same tradeable=no - so a diff of the two records shows the bonuses, the
// cost and the three model names and nothing else. The cost is the cache's 80,000.
[tzhaar_cape_infernal]
name=Infernal cape
desc=Whose idea was it to have a cape made of lava anyway?
members=yes
iop2=Wear
cost=80000
model=obj_tzhaar_cape_infernal
2dxof=-4
2dzoom=2086
2dyan=2031
2dxan=567
manwear=obj_tzhaar_cape_infernal_manwear,0
womanwear=obj_tzhaar_cape_infernal_womanwear,0
category=armour_cape
wearpos=back
weight=4lb
param=stabattack,4
param=slashattack,4
param=crushattack,4
param=magicattack,1
param=rangeattack,1
param=stabdefence,12
param=slashdefence,12
param=crushdefence,12
param=magicdefence,12
param=rangedefence,12
param=strengthbonus,8
param=prayerbonus,2
tradeable=no
