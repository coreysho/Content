// Which Fight Cave monster an npc is. 1-5 are the wave tiers in ascending order, 6 is TzTok-Jad and
// 7 is a Yt-HurKot healer.
//
// It is a param rather than a category because it carries the TIER as well as the membership: the
// wave builder reads it to know what it just spawned, and ~fightcave_alive counts anything with a
// non-null value, so one lookup answers both "is this a cave monster" and "which one".
[fightcave_tier]
type=int
default=null

// Flat prayer points drained by a landed melee hit (skill_combat/scripts/npc/npc_combat_melee.rs2).
// Tz-Kih's is 1, which is OSRS's. Damis in Desert Treasure drains too but drains HALF THE DAMAGE
// rather than a flat amount, so it stays keyed on its own npc type rather than sharing this - two
// mechanics that look alike, not one.
[prayer_drain]
type=int
default=null
