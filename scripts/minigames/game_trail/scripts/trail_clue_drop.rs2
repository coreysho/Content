// Unused by anything in the tree today; kept for a script that wants to hand a clue straight over.
// One of a tier at a time, as ever - the others arrive as scroll boxes (trail_clue_helper.rs2).
[proc,trail_geteasyclue]()(boolean)
return(~trail_giveclue(^trail_tier_easy));

[proc,trail_getmediumclue]()(boolean)
return(~trail_giveclue(^trail_tier_medium));

[proc,trail_gethardclue]()(boolean)
return(~trail_giveclue(^trail_tier_hard));

[proc,trail_giveclue](int $tier)(boolean)
if (~trail_hasclue($tier) = false) {
    inv_add(inv, ~trail_clue_getrandom($tier), 1);
    return(true);
}
return(false);

// The three names the drop tables call. What a drop turns into - the clue, a scroll box, or
// nothing at the stack limit - is ~trail_cluedrop's, in trail_clue_helper.rs2.
[proc,trail_easycluedrop](int $rarity, coord $coord)
if_close;
if (p_finduid(uid) = true & map_members = ^true) {
    ~trail_cluedrop(^trail_tier_easy, $rarity, $coord);
}

[proc,trail_mediumcluedrop](int $rarity, coord $coord)
if_close;
if (p_finduid(uid) = true & map_members = ^true) {
    ~trail_cluedrop(^trail_tier_medium, $rarity, $coord);
}

[proc,trail_hardcluedrop](int $rarity, coord $coord) // Name leaked from bronze dragon droptable script.
if_close;
if (p_finduid(uid) = true & map_members = ^true) {
    ~trail_cluedrop(^trail_tier_hard, $rarity, $coord);
}

[opobj3,_trail_challenge]
if(inv_totalcat(inv, trail_challenge) > 0 | inv_totalcat(bank, trail_challenge) > 0) {
    mes("You already have a challenge scroll."); // OSRS
    return;
}
@pickup_obj;

[opobj3,_trail_puzzle]
if(inv_totalcat(inv, trail_puzzle) > 0 | inv_totalcat(bank, trail_puzzle) > 0) {
    mes("You already have a puzzle box."); // OSRS
    return;
}
@pickup_obj;

[opobj3,_trail_clue_easy] @pickup_cluescroll;
[opobj3,_trail_clue_medium] @pickup_cluescroll;
[opobj3,_trail_clue_hard] @pickup_cluescroll;
[opobj3,_trail_casket_easy] @pickup_cluescroll;
[opobj3,_trail_casket_medium] @pickup_cluescroll;
[opobj3,_trail_casket_hard] @pickup_cluescroll;
[opobj3,_trail_scrollbox] @pickup_cluescroll;

// One of a tier at a time, and no more of a tier than the scroll box stack limit - ~trail_take_refused.
[label,pickup_cluescroll]
if (~trail_take_refused(obj_type, obj_count) = true) {
    return;
}
@pickup_obj;
