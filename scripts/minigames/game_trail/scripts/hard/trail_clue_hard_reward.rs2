[proc,trail_clue_hard_reward]
// Collect anything left over from a previous casket before rolling into the reward inv;
// otherwise these inv_adds overflow a still-full size=9 inv and the loot is lost.
~trail_prepare_rewardinv;
def_int $rolls = calc(4 + random(3));
// THE CLUE HUNTER OUTFIT'S DOUBLE CASKET. Twice the rolls on this same table is exactly two
// caskets' worth, which is the only precise reading of "double casket" when a casket is a roll
// count. Asked for by name; OSRS's outfit does nothing like it.
if (~clue_hunter_doubles = true) {
    $rolls = calc($rolls * 2);
    mes("Your clue hunter outfit turns up a second casket's worth of loot!");
}
def_int $roll = 0;
def_int $rare = 0;

while ($roll < $rolls) {
    // Rare drop chance was 1/21 in 2006. @https://twitter.com/JagexTide/status/1131933683714330624
    // the chances have been scaled down over time to accomodate for more uniques being in the list, there are 25 uniques in May 2004
    // 67 by 2006, (67/25) * 21 ~= 57
    if(random(57) = 0) {
        $rare = calc($rare + 1);
        gosub(trail_clue_hard_rare);
    } else {
        gosub(trail_clue_hard_normal);
    }
    // AND THE OUTFIT'S OWN PIECES, once per roll, for whichever the player still lacks. Not in
    // the rare table above: that table's 1/97 is derived arithmetic with a comment explaining it,
    // and six new entries would move every existing rare's rate and make the comment wrong.
    ~clue_hunter_droproll;
    $roll = calc($roll + 1);
}
if ($rare > 0) {
    session_log(^log_adventure, "Completed a Hard Clue Scroll and received <tostring($rare)> Rare Reward(s)!");
} else {
    session_log(^log_adventure, "Completed a Hard Clue Scroll.");
}
~trail_complete(^trail_tier_hard);
~collection_log_casket(^collection_log_counter_clue_hard, "hard");

[proc,trail_clue_hard_normal]
def_int $random = random(21); // the last case is 349's god book page

switch_int ($random) {
    case 0 : inv_add(trail_rewardinv, coins, calc(1000 + random(4001)));
    case 1 : inv_add(trail_rewardinv, cert_lobster, calc(12 + random(4)));
    case 2 : inv_add(trail_rewardinv, cert_shark, calc(12 + random(4)));
    case 3 : inv_add(trail_rewardinv, naturerune, calc(30 + random(21)));
    case 4 : inv_add(trail_rewardinv, lawrune, calc(30 + random(21)));
    case 5 : inv_add(trail_rewardinv, bloodrune, calc(20 + random(11)));
    case 6 : inv_add(trail_rewardinv, rune_full_helm, 1);
    case 7 : inv_add(trail_rewardinv, rune_platebody, 1);
    case 8 : inv_add(trail_rewardinv, rune_platelegs, 1);
    case 9 : inv_add(trail_rewardinv, rune_plateskirt, 1);
    case 10 : inv_add(trail_rewardinv, rune_kiteshield, 1);
    case 11 : inv_add(trail_rewardinv, rune_longsword, 1);
    case 12 : inv_add(trail_rewardinv, rune_dagger, 1);
    case 13 : inv_add(trail_rewardinv, rune_battleaxe, 1);
    case 14 : inv_add(trail_rewardinv, rune_axe, 1);
    case 15 : inv_add(trail_rewardinv, rune_pickaxe, 1);
    case 16 : inv_add(trail_rewardinv, black_dragonhide_body, 1);
    case 17 : inv_add(trail_rewardinv, black_dragonhide_chaps, 1);
    case 18 : inv_add(trail_rewardinv, magic_shortbow, 1);
    case 19 : inv_add(trail_rewardinv, magic_longbow, 1);
    case 20 : inv_add(trail_rewardinv, ~trail_reward_godpage);
}

[proc,trail_clue_hard_rare]
// 40 rares: 33, the Thread of Elidinis (case 33), and 349's six after it (the trimmed and god rune
// plateskirts, and its ultrarare roll: gilded rune or a stack of noted potions). The Thread of Elidinis: OSRS puts it in Tombs of Amascut, a
// 2022 raid, and the top clue tier is where this build keeps one-off upgrades that have no
// content of their own to come from - there is no elite tier here, hard IS the top.
def_int $random = random(40); // the last six are 349's: the trimmed and god plateskirts, and its gilded-or-potions roll

switch_int ($random) {
    case 0 : inv_add(trail_rewardinv, robinhoodhat, 1);
    case 1 : inv_add(trail_rewardinv, rune_full_helm_trim, 1);
    case 2 : inv_add(trail_rewardinv, rune_platebody_trim, 1);
    case 3 : inv_add(trail_rewardinv, rune_platelegs_trim, 1);
    case 4 : inv_add(trail_rewardinv, rune_kiteshield_trim, 1);
    case 5 : inv_add(trail_rewardinv, rune_full_helm_gold, 1);
    case 6 : inv_add(trail_rewardinv, rune_platebody_gold, 1);
    case 7 : inv_add(trail_rewardinv, rune_platelegs_gold, 1);
    case 8 : inv_add(trail_rewardinv, rune_kiteshield_gold, 1);
    case 9 : inv_add(trail_rewardinv, piratehat, 1);
    case 10 : inv_add(trail_rewardinv, cavalier_brown, 1);
    case 11 : inv_add(trail_rewardinv, cavalier_dark, 1);
    case 12 : inv_add(trail_rewardinv, cavalier_black, 1);
    case 13 : inv_add(trail_rewardinv, rune_full_helm_zamorak, 1);
    case 14 : inv_add(trail_rewardinv, rune_platebody_zamorak, 1);
    case 15 : inv_add(trail_rewardinv, rune_platelegs_zamorak, 1);
    case 16 : inv_add(trail_rewardinv, rune_kiteshield_zamorak, 1);
    case 17 : inv_add(trail_rewardinv, rune_full_helm_guthix, 1);
    case 18 : inv_add(trail_rewardinv, rune_platebody_guthix, 1);
    case 19 : inv_add(trail_rewardinv, rune_platelegs_guthix, 1);
    case 20 : inv_add(trail_rewardinv, rune_kiteshield_guthix, 1);
    case 21 : inv_add(trail_rewardinv, rune_full_helm_saradomin, 1);
    case 22 : inv_add(trail_rewardinv, rune_platebody_saradomin, 1);
    case 23 : inv_add(trail_rewardinv, rune_platelegs_saradomin, 1);
    case 24 : inv_add(trail_rewardinv, rune_kiteshield_saradomin, 1);
    case 25 : inv_add(trail_rewardinv, enchanted_hat, 1);
    case 26 : inv_add(trail_rewardinv, enchanted_robetop, 1);
    case 27 : inv_add(trail_rewardinv, enchanted_robelegs, 1);
    case 28 : inv_add(trail_rewardinv, rune_heraldic_kiteshield1, 1);
    case 29 : inv_add(trail_rewardinv, rune_heraldic_kiteshield2, 1);
    case 30 : inv_add(trail_rewardinv, rune_heraldic_kiteshield3, 1);
    case 31 : inv_add(trail_rewardinv, rune_heraldic_kiteshield4, 1);
    case 32 : inv_add(trail_rewardinv, rune_heraldic_kiteshield5, 1);
    case 33 : inv_add(trail_rewardinv, thread_of_elidinis, 1);
    case 34 : inv_add(trail_rewardinv, rune_plateskirt_guthix, 1);
    case 35 : inv_add(trail_rewardinv, rune_plateskirt_saradomin, 1);
    case 36 : inv_add(trail_rewardinv, rune_plateskirt_zamorak, 1);
    case 37 : inv_add(trail_rewardinv, rune_plateskirt_trim, 1);
    case 38 : inv_add(trail_rewardinv, rune_plateskirt_gold, 1);
    case 39 : ~trail_clue_hard_ultrarare;
}

// 349's ultrarare: half the time a stack of noted potions, half the time a piece of gilded rune.
[proc,trail_clue_hard_ultrarare]
def_int $rand = random(2);
if($rand = 0) { // junk table
    $rand = random(4);
    switch_int ($rand) {
        case 0 : inv_add(trail_rewardinv, cert_4dose2energy, 15);
        case 1 : inv_add(trail_rewardinv, cert_4dose2restore, 15);
        case 2 : inv_add(trail_rewardinv, cert_4dose1antidragon, 15);
        case 3 :
            inv_add(trail_rewardinv, cert_4dose2attack, 5);
            inv_add(trail_rewardinv, cert_4dose2strength, 5);
            inv_add(trail_rewardinv, cert_4dose2defense, 5);
    }
} else { // gilded table
    $rand = random(5);
    switch_int ($rand) {
        case 0 : inv_add(trail_rewardinv, rune_platebody_goldplate, 1);
        case 1 : inv_add(trail_rewardinv, rune_platelegs_goldplate, 1);
        case 2 : inv_add(trail_rewardinv, rune_full_helm_goldplate, 1);
        case 3 : inv_add(trail_rewardinv, rune_plateskirt_goldplate, 1);
        case 4 : inv_add(trail_rewardinv, rune_kiteshield_goldplate, 1);
    }
}
