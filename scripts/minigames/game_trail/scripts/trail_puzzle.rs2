[opheld1,_trail_puzzle] @trail_open_puzzle(last_item);

// 349: a puzzle box holds one of three pictures (param trail_puzzle, ^trail_puzzleb/c/d), and the
// window's Hint button shows the finished picture from trail_puzzlehintinv. The grid is the inv
// component com_2 - com_3 is the Hint button's model, so a grid sent there was never drawn.
[label,trail_open_puzzle](obj $puzzle)
if(inv_freespace(trail_puzzleinv) > 1) {
    inv_clear(trail_puzzleinv); // prob shouldn't ever need this
    ~init_trail_puzzle($puzzle);
}
inv_transmit(trail_puzzleinv, trail_puzzle:com_2);
inv_transmit(trail_puzzlehintinv, trail_puzzle:com_8);
if_openmain(trail_puzzle);

[proc,init_trail_puzzle](obj $puzzle)
def_int $puztype = oc_param($puzzle, trail_puzzle);
if ($puztype = 0) {
    $puztype = ^trail_puzzleb; // a box with no picture set holds the one every box had before
