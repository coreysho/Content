// SCROLL BOXES - how a player holds more than one clue of a tier.
//
// Imported from a modern OSRS cache by tools/models/importosrs.py (items 24362-24364); the models
// are re-encoded into the 317-family format and round-trip verified. Everything above the
// category line is the cache's own record, so re-running the import reproduces it.
//
// https://oldschool.runescape.wiki/w/Scroll_box - a clue that drops while you already have that
// tier's clue arrives as a box instead, the boxes stack, and one is opened for the next clue once
// the current one is done. The rules live in scripts/trail_clue_helper.rs2; the stack limit is
// ^trail_stack_cap in trail.constant.
//
// category=trail_scrollbox lets one [opheld1,_trail_scrollbox] serve all three, and trail_tier
// tells it which tier's clue to roll - the same ^trail_tier_* numbers the helper procs take.
// Stackable and untradeable, as OSRS has them. No Destroy op: opheld5 is Drop in this build
// (player/scripts/drop.rs2).

[trail_scrollbox_easy]
name=Scroll box (easy)
desc=Contains an easy clue scroll.
model=obj_trail_scrollbox_easy
2dzoom=770
2dxan=236
2dyan=1697
2dxof=1
2dyof=-6
weight=1000g
cost=50
members=yes
stackable=yes
tradeable=no
iop1=Open
category=trail_scrollbox
param=trail_tier,^trail_tier_easy

[trail_scrollbox_medium]
