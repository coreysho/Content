^trail_easy_maxsteps = 4
^trail_medium_maxsteps = 5
^trail_hard_maxsteps = 6

^trail_sextant_frame_max = 14

^trail_chart_not_started = 0
^trail_chart_spoken_prof = 1
^trail_chart_spoken_murphy = 2
^trail_chart_spoken_kojo = 3
^trail_chart_complete = 4

^trail_easy_droprate = 128
^trail_medium_droprate = 128
^trail_hard_droprate = 128

// THE CLUE HUNTER OUTFIT. None of these three numbers is OSRS's - the outfit does nothing for
// clues there at all - so they are Corey's, and tools/cluehunterspec.json says so beside them.
//
// The two percentages are full-set only and are rolled separately, at different moments: the
// skip when a clue is handed in, the double when a trail finishes. So they never share a draw.
^clue_hunter_double_pct = 10
^clue_hunter_skip_pct = 10

// PER CASKET ROLL, for each piece not already owned. Six independent waits at 1/750 is about
// 1837 rolls for the whole set. The three tiers do not roll the same number of times - easy is
// 2 + random(3), medium 3 + random(3), hard 4 + random(3) - so that is roughly 612 easy caskets,
// 459 medium or 367 hard. The 600 is the point of the number: it was 1/1500 first and was halved
// to land there.
^clue_hunter_drop_denom = 750
^clue_hunter_pieces = 6

// The clue scroll window (scripts/trail_clue_read.rs2) holds eight lines - trail_cluelong:com_2
// through com_9.
^trail_clue_lines = 8

// THE TIERS, as numbers, so one proc can serve all three: the helper procs in
// trail_clue_helper.rs2 take one of these, and so does the trail_tier param on the scroll boxes.
^trail_tier_easy = 0
^trail_tier_medium = 1
^trail_tier_hard = 2

// SCROLL BOX STACK LIMITS. https://oldschool.runescape.wiki/w/Scroll_box - the base limit is 2 for
// every tier, and it is "shared across boxes and scrolls": the clue you are working on counts as
// one of the two. OSRS raises it to 5 with scroll cases, which this build does not have, so these
// are the base values. One per tier so a tier can be raised without touching the others.
^trail_easy_stackcap = 2
^trail_medium_stackcap = 2
^trail_hard_stackcap = 2

// %trail_progress (configs/trail.varp): four bits of step count per tier from bit 0, and each
// tier's guardian-beaten flag at ^trail_guardian_bit + tier.
^trail_progress_bits = 4
^trail_guardian_bit = 12

// THE THREE SLIDING PICTURES a puzzle box can hold (param trail_puzzle), from 349. b is the one
// every puzzle box had before; c and d are the two more 349 has, each with its own set of pieces
// (trail_slidingpuzzlec01-24, d01-24).
^trail_puzzleb = 1
^trail_puzzlec = 2
^trail_puzzled = 3
