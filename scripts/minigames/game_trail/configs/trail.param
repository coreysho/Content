[trail_coord]
type=coord
default=null

[trail_sextant]
type=boolean
default=null

[trail_desc]
type=string
default=null

[trail_casket]
type=namedobj
default=null

[trail_guardian]
type=npc
default=null

[puzzle_piece_id]
type=int
default=0

[trail_challenge_answer]
type=int
default=0

// Which tier a scroll box holds - one of the ^trail_tier_* constants.
[trail_tier]
type=int
default=0

// 349: a clue solved by searching the loc (crate, drawers, chest, boxes) at its trail_coord, rather
// than by digging there. ~trail_loc_clue_search (trail_clue_helper.rs2) is the one place it is read.
[trail_loc]
type=boolean
default=false

// 349: which sliding picture a puzzle box holds - one of the ^trail_puzzle* constants.
[trail_puzzle]
type=int
default=0
