// Equipment degradation tunables (Corey, 2026-09-05).
//
// Authentic 2006 values. Barrows equipment lasts 1000 degradation points = 15 hours of combat:
// one point the moment you enter combat, then one more every 90 ticks (54s) you stay in it.
// 1000 points / 4 visible states = 250 points per state = 3.75 hours each.
//
// How long each step lasts is derived from the items' own degrade_points, so there is a single
// knob here instead of one per item family: every step is divided by this. 1 = authentic. 15 hours
// is a long time to wait to see degradation work, so raise this to speed everything up at once -
// 10 makes a barrows set last about 90 minutes and a crystal bow 250 shots. ::~degrade forces a
// step immediately regardless, for testing.
^degrade_speed_divisor = 1

// Ticks between degradation points while a fight continues. 90 ticks = 54 seconds.
^barrows_degrade_interval = 90

// Islwyn's recharge prices. He charges less each time he enchants a seed for you, bottoming out on
// the fifth. The bow starts at 900k dropping by 180k; the shield at 750k dropping by 150k.
^crystal_bow_recharge_base = 900000
^crystal_bow_recharge_step = 180000
^crystal_shield_recharge_base = 750000
^crystal_shield_recharge_step = 150000
^crystal_recharge_min_tier = 4
