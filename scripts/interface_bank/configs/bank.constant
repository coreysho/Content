// Bank capacity (Corey, 2026-09-18) - see claude/bank-space.md.
// OSRS's ceilings: 1410 spaces on a members world (900 base + 60 for the security features + 450
// from the nine purchasable blocks) and 910 on a free world (400 + 60 + 450). An inv's size is a
// static config - the engine has no way to give one player a bigger inv than another - so the inv
// IS the members ceiling and the free limit stays what it already was: a check in
// ~bank_check_nobreak against ^bank_free_slots, taken on playermember rather than world type.
^bank_total_slots = 1410
^bank_free_slots = 910

^bankpin_flow_none = 0
^bankpin_flow_verify_change = 1
^bankpin_flow_verify_delete = 2
^bankpin_flow_enter_new = 3
^bankpin_flow_confirm_new = 4
^bankpin_flow_verify_access = 5

// ---- bank tabs (Corey, 2026-09-12) - see claude/bank-tabs.md
^bank_tabs = 8              // numbered tabs; tab 0 is the "all items" view and is not one of them
^bank_tab_all = 0
// The drag-onto-a-tab gesture rides the INV_BUTTOND packet's existing mode byte, which the
// engine decoded and then threw away ("todo: is it necessary to pass message.mode to script?").
// mode 0 = swap, 1 = insert, and now ^bank_drag_tab + k = "dropped on tab k". Reusing the byte
// avoided allocating a new client packet opcode for one gesture.
^bank_drag_tab = 100
// if_setobject's scale: zoom = 2dzoom * 100 / scale, and zoom is a DIVISOR, so a smaller scale
// draws smaller. 80 fits a normal 32px inventory icon into the 25px-tall tab box without it
// clipping through the bottom - model components are clipped at the bottom and nowhere else.
^bank_tab_icon_scale = 80
// "this item is in no tab yet" - a fresh deposit, before ~banktab_place decides where it goes.
// Distinct from ^bank_tab_all, which means the untabbed block, a real place an item can already be.
^bank_tab_none = -1

// Dragging one tab onto another swaps the two. Rides the same INV_BUTTOND mode byte as
// ^bank_drag_tab, in a range above it: ^bank_drag_swap + (from - 1) * 8 + (to - 1), which for
// 1..8 x 1..8 is 150..213 and still fits one byte.
^bank_drag_swap = 150

// Dropped on the PADDING after a tab's items - the blanks between the end of one tab and the row
// the next one starts on. That means "put it on the end of this tab", which is not the same place
// as "insert it at this tab's last item": inserting lands one short of the end. Above the tab-swap
// range, which tops out at 213.
^bank_drag_append = 220

// ---- the bottom button bar (Corey, 2026-09-12)
// The five quantity buttons are radio buttons over %bankquantity, so these are its values and
// nothing else: tools/genbankbar.py writes them straight into each button's script1=eq,K.
^bank_qty_1 = 0
^bank_qty_5 = 1
^bank_qty_10 = 2
^bank_qty_x = 3
^bank_qty_all = 4
