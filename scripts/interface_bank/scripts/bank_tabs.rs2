// ===================================================================================================
// Bank tabs
// ===================================================================================================
// The bank is ONE ordered 352-slot list and a tab is a contiguous range of it:
//
//     [ everything else ][ tab1 ][ tab2 ] ... [ tab8 ]
//       the untabbed block   c1      c2           c8
//
// The untabbed block leads. That is what "All" means as a section of the bank rather than as a
// button: the items you have not filed are the first thing you see, and the tabs follow. It also
// makes the untabbed block the only range whose length is DERIVED rather than stored - it is
// whatever is left over - which is why there is no %banktab_c0.      <- the "all items" tab, whatever is left
//
// Nothing tags an item with a tab. POSITION is the tab, and %banktab_c1..c8 are just how long
// each range is. Two consequences run through everything below:
//
//   1. The list must never be left with a gap. Every removal closes the gap immediately and
//      decrements the count of whichever tab the hole was in, or every range after it shifts and
//      the whole filing silently scrambles.
//   2. Nothing has to be copied anywhere. The grid still shows the real bank inv, so every
//      existing withdraw/deposit/drag handler keeps addressing real bank slots. That is the whole
//      reason for this design - see claude/bank-tabs.md for the two approaches it replaced, both
//      of which needed a second inv and one of which could strand items on a disconnect.
//
// Filtering is done by if_setinvwindow, which tells the client to draw only $count slots starting
// at $first and to report real slot numbers back. There is no way to do it in content alone:
// inv_transmit binds a WHOLE inv to a component and has no offset, and nothing can copy a runtime
// obj into another inv (inv_setslot and inv_add both take namedobj, and an obj does not widen to
// one - see the commented-out attempt at skill_crafting/scripts/pottery/pottery.rs2:111).

[proc,banktab_count](int $tab)(int)
switch_int ($tab) {
    case 1 : return(%banktab_c1);
    case 2 : return(%banktab_c2);
    case 3 : return(%banktab_c3);
    case 4 : return(%banktab_c4);
    case 5 : return(%banktab_c5);
    case 6 : return(%banktab_c6);
    case 7 : return(%banktab_c7);
    case 8 : return(%banktab_c8);
}
return(0);

[proc,banktab_setcount](int $tab, int $count)
if ($count < 0) {
    $count = 0;
}
switch_int ($tab) {
    case 1 : %banktab_c1 = $count;
    case 2 : %banktab_c2 = $count;
    case 3 : %banktab_c3 = $count;
    case 4 : %banktab_c4 = $count;
    case 5 : %banktab_c5 = $count;
    case 6 : %banktab_c6 = $count;
    case 7 : %banktab_c7 = $count;
    case 8 : %banktab_c8 = $count;
}

// First bank slot of $tab. Tab 0 starts at 0 because it is the whole list.
// How many items are in no numbered tab. Derived, not stored: whatever the tabs do not claim.
[proc,banktab_untabbed](int $unused)(int)
return(sub(sub(inv_size(bank), inv_freespace(bank)), ~banktab_numbered_total(0)));

// First bank slot of $tab. The untabbed block leads, so every numbered tab sits after it, and
// tab 0 starts at 0 because the untabbed block IS the front of the list.
[proc,banktab_start](int $tab)(int)
if ($tab = ^bank_tab_all) {
    return(0);
}
def_int $start = ~banktab_untabbed(0);
def_int $i = 1;
while ($i < $tab) {
    $start = add($start, ~banktab_count($i));
    $i = add($i, 1);
}
return($start);

// How many items the numbered tabs claim between them.
[proc,banktab_numbered_total](int $unused)(int)
def_int $total = 0;
def_int $i = 1;
while ($i <= ^bank_tabs) {
    $total = add($total, ~banktab_count($i));
    $i = add($i, 1);
}
return($total);

// Which tab owns $slot. 0 = untabbed, and the untabbed block is everything below the first tab.
[proc,banktab_of_slot](int $slot)(int)
def_int $end = ~banktab_untabbed(0);
if ($slot < $end) {
    return(^bank_tab_all);
}
def_int $i = 1;
while ($i <= ^bank_tabs) {
    $end = add($end, ~banktab_count($i));
    if ($slot < $end) {
        return($i);
    }
    $i = add($i, 1);
}
return(^bank_tab_all);

// ---------------------------------------------------------------------------------------------
// Showing a tab
// ---------------------------------------------------------------------------------------------
// Tab 0 is the whole inv, which is also the state the window is in before any of this existed -
// so a player who never touches a tab sees exactly the bank they had.
// Filing something should not yank the view back to the top. Only a deliberate tab CHANGE resets
// the scroll; a repaint after a deposit, a withdrawal or a drag leaves the player where they were.
[proc,banktab_show](int $tab)
~banktab_show2($tab, ^false);

[proc,banktab_show2](int $tab, boolean $keepscroll)
%banktab = $tab;
~banktab_icons;
if ($tab = ^bank_tab_all) {
    // The "all items" view is the whole list, but it must not run the tabs together - OSRS starts
    // each tab on a fresh row. The untabbed block leads and starts at 0, so it needs no break of
    // its own; the eight values are the starts of tabs 1..8. An empty tab makes two of them equal,
    // which the client treats as one break, not two.
    if_setinvwindow(bank_main:bank, 0, inv_size(bank));
    if_setinvbreaks(bank_main:bank, ~banktab_start(1), ~banktab_start(2), ~banktab_start(3),
        ~banktab_start(4), ~banktab_start(5), ~banktab_start(6), ~banktab_start(7),
        ~banktab_start(8));
    if ($keepscroll = ^false) {
        if_setscrollpos(bank_main:com_92, 0);
    }
    return;
}
// A single tab is already contiguous, so it needs no breaks - and they have to be cleared, or the
// last "all" view's boundaries would keep punching holes in it.
if_setinvwindow(bank_main:bank, ~banktab_start($tab), ~banktab_count($tab));
if_setinvbreaks(bank_main:bank, 0, 0, 0, 0, 0, 0, 0, 0);
if ($keepscroll = ^false) {
    if_setscrollpos(bank_main:com_92, 0);
}

// Repaint the current tab. Called after anything that changes the bank, because the window is
// expressed in slot numbers and those move whenever the list shifts.
[proc,banktab_refresh]
~banktab_compact;
// the tab being looked at may have just been emptied, or renumbered out from under the player
if (%banktab ! ^bank_tab_all) {
    if (~banktab_count(%banktab) = 0) {
        %banktab = ^bank_tab_all;
    }
}
~banktab_show2(%banktab, ^true);

[if_button,bank_main:banktab0] ~banktab_show(0);
[if_button,bank_main:banktab1] ~banktab_show(1);
[if_button,bank_main:banktab2] ~banktab_show(2);
[if_button,bank_main:banktab3] ~banktab_show(3);
[if_button,bank_main:banktab4] ~banktab_show(4);
[if_button,bank_main:banktab5] ~banktab_show(5);
[if_button,bank_main:banktab6] ~banktab_show(6);
[if_button,bank_main:banktab7] ~banktab_show(7);
[if_button,bank_main:banktab8] ~banktab_show(8);

// ---------------------------------------------------------------------------------------------
// Keeping the list contiguous
// ---------------------------------------------------------------------------------------------
// Shift everything above $slot down one, so the hole at $slot closes. Bounded by inv_size, and it
// stops at the first empty pair rather than walking all 352 slots every time.
[proc,banktab_closegap](int $slot)
def_int $i = $slot;
def_int $size = inv_size(bank);
while ($i < sub($size, 1)) {
    if (inv_getobj(bank, add($i, 1)) = null) {
        return;
    }
    inv_movetoslot(bank, bank, add($i, 1), $i);
    $i = add($i, 1);
}

// An item has just left $slot. Decrement whichever tab owned it and close the gap. Order matters:
// the owning tab has to be worked out BEFORE the gap closes, or the slot has already moved.
[proc,banktab_removed](int $slot)
if (inv_getobj(bank, $slot) ! null) {
    return;
}
def_int $tab = ~banktab_of_slot($slot);
if ($tab ! ^bank_tab_all) {
    ~banktab_setcount($tab, sub(~banktab_count($tab), 1));
}
~banktab_closegap($slot);

// Move the item at $from to $to, shifting everything between along by one - an insert, not a swap,
// so the ranges either side stay contiguous. Same shape as [label,insert_bank].
[proc,banktab_insert](int $from, int $to)
def_int $src = $from;
while ($src ! $to) {
    if ($src > $to) {
        inv_movetoslot(bank, bank, sub($src, 1), $src);
        $src = sub($src, 1);
    } else {
        inv_movetoslot(bank, bank, add($src, 1), $src);
        $src = add($src, 1);
    }
}

// ---------------------------------------------------------------------------------------------
// Filing an item into a tab
// ---------------------------------------------------------------------------------------------
// The drag-onto-a-tab gesture, and the only way an item changes tab. Moving into tab $tab means
// inserting at the END of that tab's range; moving to tab 0 means pushing past the end of the
// numbered tabs into the remainder.
[proc,banktab_move_to](int $slot, int $tab)
if (inv_getobj(bank, $slot) = null) {
    return;
}
def_int $from_tab = ~banktab_of_slot($slot);
if ($from_tab = $tab) {
    return;
}
~banktab_place($slot, $tab, $from_tab);

// Put the item at $slot into $tab. $in_tab is the tab it belongs to now, or ^bank_tab_none if it
// belongs to none yet - a fresh deposit sitting on the end of the list.
//
// The destination is computed as the item's FINAL index, not as "one past the end of the range",
// because ~banktab_insert lands the item exactly on the index it is given. Working in final
// indices is what removes the off-by-one correction this used to need when moving rightwards.
[proc,banktab_place](int $slot, int $tab, int $in_tab)
if ($in_tab > ^bank_tab_all) {
    // take it out of its old tab first, so every count below describes the list WITHOUT this item
    ~banktab_setcount($in_tab, sub(~banktab_count($in_tab), 1));
}
def_int $n = sub(inv_size(bank), inv_freespace(bank));
def_int $numbered = ~banktab_numbered_total(0);
def_int $dest = sub(sub($n, $numbered), 1);
if ($tab ! ^bank_tab_all) {
    // the untabbed block will be one shorter once this item joins a tab, so tab 1 starts one
    // earlier than it does right now
    $dest = sub($n, add($numbered, 1));
    def_int $i = 1;
    while ($i <= $tab) {
        $dest = add($dest, ~banktab_count($i));
        $i = add($i, 1);
    }
    ~banktab_setcount($tab, add(~banktab_count($tab), 1));
}
~banktab_insert($slot, $dest);
~banktab_refresh;

// A freshly deposited item lands on the END of the list, which in this layout is the end of the
// last numbered tab - never where it belongs. Untabbed, it goes to the end of the leading untabbed
// block; with a tab open, OSRS files it into that tab, so it goes there. Either way it has to move,
// which is why there is no early return for tab 0 here.
[proc,banktab_deposited](int $slot)
~banktab_place($slot, %banktab, ^bank_tab_none);

// ---------------------------------------------------------------------------------------------
// The safety net
// ---------------------------------------------------------------------------------------------
// Everything above keeps the list gapless as long as items enter and leave through the bank
// window. They do not always: deaths, other scripts and ~reorganize_inv (which runs on open and
// on close and closes holes without knowing tabs exist) can all shorten the list behind our back.
// If that happens the counts describe ranges that run off the end of the real items, and every
// tab after the damage shows the wrong things.
//
// So before the window is built, clamp. Shrink the numbered tabs from the LAST one down until
// they fit inside what is actually there. Losing the filing of the highest tabs is recoverable by
// dragging; ranges pointing at nothing are not obviously wrong to a player, which is worse.
[proc,banktab_validate]
def_int $occupied = sub(inv_size(bank), inv_freespace(bank));
def_int $total = ~banktab_numbered_total(0);
if ($total <= $occupied) {
    return;
}
def_int $tab = ^bank_tabs;
while ($tab > 0) {
    if ($total <= $occupied) {
        return;
    }
    def_int $count = ~banktab_count($tab);
    def_int $excess = sub($total, $occupied);
    if ($count <= $excess) {
        ~banktab_setcount($tab, 0);
        $total = sub($total, $count);
    } else {
        ~banktab_setcount($tab, sub($count, $excess));
        $total = $occupied;
    }
    $tab = sub($tab, 1);
}
// Compaction otherwise only runs from ~banktab_refresh, i.e. on a bank CHANGE - so a filing that
// already had a hole in it kept the hole through every open until the player happened to deposit
// something. Opening the bank is when a player looks at the tab row, so it is when the row has to
// be right. It also covers a hole the clamp above can punch by emptying a tab in the middle.
~banktab_compact;

// ---------------------------------------------------------------------------------------------
// Tab icons
// ---------------------------------------------------------------------------------------------
// OSRS shows the first item of a tab as that tab's icon. The icon sits in its own layer per tab
// (banktabNicon) purely so it can be hidden - if_sethide does nothing on a model component, only
// on a layer, so an empty tab could not otherwise be blanked.
[proc,banktab_icons]
def_int $tab = 1;
while ($tab <= ^bank_tabs) {
    ~banktab_icon($tab);
    $tab = add($tab, 1);
}

[proc,banktab_icon](int $tab)
def_obj $icon = null;
if (~banktab_count($tab) > 0) {
    $icon = inv_getobj(bank, ~banktab_start($tab));
}
switch_int ($tab) {
    case 1 :
        if ($icon = null) { if_sethide(bank_main:banktab1icon, true); return; }
        if_sethide(bank_main:banktab1icon, false);
        if_setobject(bank_main:banktab1obj, $icon, ^bank_tab_icon_scale);
    case 2 :
        if ($icon = null) { if_sethide(bank_main:banktab2icon, true); return; }
        if_sethide(bank_main:banktab2icon, false);
        if_setobject(bank_main:banktab2obj, $icon, ^bank_tab_icon_scale);
    case 3 :
        if ($icon = null) { if_sethide(bank_main:banktab3icon, true); return; }
        if_sethide(bank_main:banktab3icon, false);
        if_setobject(bank_main:banktab3obj, $icon, ^bank_tab_icon_scale);
    case 4 :
        if ($icon = null) { if_sethide(bank_main:banktab4icon, true); return; }
        if_sethide(bank_main:banktab4icon, false);
        if_setobject(bank_main:banktab4obj, $icon, ^bank_tab_icon_scale);
    case 5 :
        if ($icon = null) { if_sethide(bank_main:banktab5icon, true); return; }
        if_sethide(bank_main:banktab5icon, false);
        if_setobject(bank_main:banktab5obj, $icon, ^bank_tab_icon_scale);
    case 6 :
        if ($icon = null) { if_sethide(bank_main:banktab6icon, true); return; }
        if_sethide(bank_main:banktab6icon, false);
        if_setobject(bank_main:banktab6obj, $icon, ^bank_tab_icon_scale);
    case 7 :
        if ($icon = null) { if_sethide(bank_main:banktab7icon, true); return; }
        if_sethide(bank_main:banktab7icon, false);
        if_setobject(bank_main:banktab7obj, $icon, ^bank_tab_icon_scale);
    case 8 :
        if ($icon = null) { if_sethide(bank_main:banktab8icon, true); return; }
        if_sethide(bank_main:banktab8icon, false);
        if_setobject(bank_main:banktab8obj, $icon, ^bank_tab_icon_scale);
}

// ---------------------------------------------------------------------------------------------
// Keeping the tab NUMBERS contiguous
// ---------------------------------------------------------------------------------------------
// The tabs in use must be 1..n with no holes, the way OSRS has them: All, then 1, 2, 3, 4. Without
// this, emptying tab 2 leaves a gap and the row reads All _ 1 _ 3 4, which is what it did in game.
//
// Nothing moves. An empty tab occupies ZERO slots, so renumbering the tabs above it down by one
// leaves every item exactly where it was - the counts are the only thing that changes. That is a
// property of tabs-as-ranges, and it is the reason this is four lines rather than a repack.
//
// It also gives "drag onto any empty tab" the right behaviour for free: drop something on tab 7
// while only tab 1 is in use and the compaction pulls it straight back to tab 2, so an empty tab
// anywhere in the row acts as OSRS's "+" button.
[proc,banktab_compact]
def_int $dst = 1;
def_int $src = 1;
while ($src <= ^bank_tabs) {
    def_int $count = ~banktab_count($src);
    if ($count > 0) {
        // $dst is never ahead of $src, so this only ever writes over a tab already read
        ~banktab_setcount($dst, $count);
        $dst = add($dst, 1);
    }
    $src = add($src, 1);
}
while ($dst <= ^bank_tabs) {
    ~banktab_setcount($dst, 0);
    $dst = add($dst, 1);
}

// An insert-mode drag from $from to $to. Insert shifts every item between them along by one, so an
// item that crosses a break leaves one tab and joins another and the counts have to follow. Called
// before the shift, while the slot numbers still mean what they say.
[proc,banktab_dragged](int $from, int $to)
def_int $from_tab = ~banktab_of_slot($from);
def_int $to_tab = ~banktab_of_slot($to);
if ($from_tab = $to_tab) {
    return;
}
if ($from_tab ! ^bank_tab_all) {
    ~banktab_setcount($from_tab, sub(~banktab_count($from_tab), 1));
}
if ($to_tab ! ^bank_tab_all) {
    ~banktab_setcount($to_tab, add(~banktab_count($to_tab), 1));
}

// ---------------------------------------------------------------------------------------------
// Swapping two tabs
// ---------------------------------------------------------------------------------------------
// Dragging tab A onto tab B trades their contents. The items really do have to move, because a tab
// IS its position in the list - swapping only the counts would hand each tab the wrong items.
//
// The trick is that inv_movetoslot SWAPS rather than overwrites (Player.invMoveToSlot writes each
// slot's obj into the other), so reversing a run of slots costs half its length. And reversing the
// three parts of [A][middle][B] and then reversing the whole span leaves [B][middle][A]:
// reversing a concatenation of already-reversed parts puts the parts back in order, backwards.
// The whole swap is therefore one pass over the span - a few hundred moves at the very worst -
// rather than lifting items across one at a time.
[proc,banktab_reverse](int $from, int $to)
def_int $a = $from;
def_int $b = $to;
while ($a < $b) {
    inv_movetoslot(bank, bank, $a, $b);
    $a = add($a, 1);
    $b = sub($b, 1);
}

[proc,banktab_swap](int $x, int $y)
if ($x = $y) {
    return;
}
if ($x < ^bank_tab_all | $y < ^bank_tab_all) {
    return;
}
// order them so $lo is the one nearer the front of the list
def_int $lo = $x;
def_int $hi = $y;
if ($lo > $hi) {
    $lo = $y;
    $hi = $x;
}
def_int $lo_start = ~banktab_start($lo);
def_int $lo_count = ~banktab_count($lo);
def_int $hi_start = ~banktab_start($hi);
def_int $hi_count = ~banktab_count($hi);
if ($lo_count = 0 & $hi_count = 0) {
    return;
}
if ($lo_count > 0) {
    ~banktab_reverse($lo_start, sub(add($lo_start, $lo_count), 1));
}
if ($hi_start > add($lo_start, $lo_count)) {
    ~banktab_reverse(add($lo_start, $lo_count), sub($hi_start, 1));
}
if ($hi_count > 0) {
    ~banktab_reverse($hi_start, sub(add($hi_start, $hi_count), 1));
}
~banktab_reverse($lo_start, sub(add($hi_start, $hi_count), 1));
// the tabs between them keep their own counts and their order; only the two ends trade
~banktab_setcount($lo, $hi_count);
~banktab_setcount($hi, $lo_count);
~banktab_refresh;
