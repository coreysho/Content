// Option 1 is the one the quantity buttons rewrite (see bank_bar.rs2); options 2-5 keep the
// fixed wording they have always had, the way OSRS keeps its explicit entries under the default.
[inv_button1,bank_main:bank] @bank_withdraw(last_slot, ~bank_quantity_amount);
[inv_button2,bank_main:bank] @bank_withdraw(last_slot, 5);
[inv_button3,bank_main:bank] @bank_withdraw(last_slot, 10);
[inv_button4,bank_main:bank] @bank_withdraw(last_slot, ^max_32bit_int);
[inv_button5,bank_main:bank] @bank_withdraw(last_slot, null);
[inv_buttond,bank_main:bank] 
// Dropped on a tab button rather than on another slot. The client cannot express that in the
// packet's component/slot fields - both slots have to be valid slots of the SAME inv or the
// engine rejects it - so it rides the mode byte instead. See claude/bank-tabs.md.
if(last_dragmode >= ^bank_drag_swap) {
    // one tab dragged onto another: swap them. The mode byte carries both tab numbers.
    def_int $pair = sub(last_dragmode, ^bank_drag_swap);
    ~banktab_swap(add(divide($pair, 8), 1), add(modulo($pair, 8), 1));
} else if(last_dragmode >= ^bank_drag_tab) {
    ~banktab_move_to(last_slot, sub(last_dragmode, ^bank_drag_tab));
} else if(%bankinsert = 1 | ~banktab_of_slot(last_slot) ! ~banktab_of_slot(last_targetslot)) {
    // INSERT, always, when the drag crosses a tab boundary - whatever the rearrange mode says.
    //
    // Swap is the right gesture WITHIN a tab: two items trade places, the tab keeps its length,
    // no count moves. Across a break it is the wrong one, because the player did not ask for
    // anything to come back the other way. Dragging a rune from tab 1 onto a spot in tab 2 means
    // "put it here" - so the rune leaves tab 1, tab 2 shifts down to make room, and tab 1 loses
    // one while tab 2 gains one. A swap sent whatever was under the cursor back into tab 1 in
    // exchange, which is the "it swaps the last item with it" Corey hit.
    //
    // ~banktab_dragged does the count arithmetic BEFORE the shift, while the slot numbers still
    // mean what they say.
    ~banktab_dragged(last_slot, last_targetslot);
    @insert_bank(last_slot, last_targetslot);
    // The client only inserts optimistically when ITS rearrange mode is insert. On a cross-tab
    // drag in swap mode it has already drawn a swap, so the grid it is showing is not the list
    // the server now holds - hence a full resend rather than a plain refresh. Without this the
    // two items look duplicated until the bank is closed and reopened.
    if (%bankinsert ! 1) {
        ~banktab_resend;
    }
    ~banktab_refresh;
} else {
    // Same tab, swap mode: a real swap, and the tab keeps its length so no count moves at all.
    inv_movetoslot(bank, bank, last_slot, last_targetslot);
    ~banktab_refresh;
}
[if_button,bank_main:com_94] %bankcert = 0;
[if_button,bank_main:com_93] %bankcert = 1;
[if_button,bank_main:com_99] %bankinsert = 0;
[if_button,bank_main:com_100] %bankinsert = 1;
[if_close,bank_main] @closebank;

// Gate: every call site that used to open the bank directly (@openbank; from bank_booth.rs2 and
// banker.rs2) now comes through here first. If a PIN is set and hasn't been verified yet THIS
// login session (%bankpin_verified resets to 0 on every login since it has no scope=perm), start
// the keypad instead of opening the bank; bankpin_finalize_entry's verify_access case calls
// ~bankpin_open_bank_real once the correct PIN is entered. (bankpin_open_bank_real is a PROC, not
// a label - a proc can't @jump to a label, "Unable to jump to labels from within a proc", so the
// real bank-opening logic has to be callable with ~ from finalize_entry.)
[label,openbank]
if (~bankpin_has_pin = false) {
    %bankpin_verified = 1;
    ~bankpin_open_bank_real;
    return;
}
if (%bankpin_verified = 1) {
    ~bankpin_open_bank_real;
    return;
}
~bankpin_start_entry(^bankpin_flow_verify_access);

[proc,bankpin_open_bank_real]
%bankcert = 0;
~reorganize_inv(bank);
inv_transmit(inv, bank_side:inv);
inv_transmit(bank, bank_main:bank);
// Always open on the "all items" tab. %banktab is temp for this reason: a bank that opened on
// tab 7 the next day would look empty. ~banktab_show also sets the inv window, so this is what
// puts the grid into its unfiltered state rather than relying on the client's default.
~banktab_validate;
~banktab_show(^bank_tab_all);
~bank_apply_quantity;
if_openmain_side(bank_main, bank_side);

[label,closebank]
inv_stoptransmit(bank_side:inv);
inv_stoptransmit(bank_main:bank);
queue(reorganize_bank, 0, 0); // confirmed queued

// reorganize the bank like when you open the bank.
// this is because a player can move objs around in the bank
// to any slot that is available. so when they open the bank
// we reorganize all of the slots towards the left of the bank.
[queue,reorganize_bank]
~reorganize_inv(bank);

[label,bank_withdraw](int $slot, int $requested_number)
// Check if the slot was empty.
def_obj $item = inv_getobj(bank, $slot);
// How many did they want to withdraw?
if ($requested_number <= 0) {
    p_countdialog;
    if (last_int <= 0) return;
    $requested_number = last_int;
}
// How many have they got?
def_int $number = inv_total(bank, $item);
// How many should we withdraw?
if ($requested_number < $number) $number = $requested_number;
// Okay, withdraw it from the bank.
~bank_withdraw_request(inv, $item, $number, $slot);

[proc,bank_withdraw_request](inv $inv, obj $obj, int $amount, int $slot)
def_obj $cert_or_uncert = oc_uncert($obj);
if (%bankcert ! 0) {
    $cert_or_uncert = oc_cert($obj);
}

if (%bankcert = ^true & oc_cert($obj) = $obj) {
    mes("This item can not be withdrawn as a note."); // 2005
}

if (inv_itemspace($inv, $cert_or_uncert, $amount, inv_size($inv)) = false){
    if (inv_freespace($inv) = 0) {
        // https://youtu.be/Zv7Wh3TIDOc?t=22
        mes("You don't have enough inventory space.");
        return;
    } else if (oc_stackable($cert_or_uncert) = true) {
        // https://youtu.be/8vNeG5bHg0Q?t=443
        mes("You're not going to be able to carry all that!");
    } else {
        // https://youtu.be/HnEZFSGbYqM?t=79
        mes("You don't have enough inventory space to withdraw that many.");
    }
}

def_int $overflow = inv_itemspace2($inv, $cert_or_uncert, $amount, inv_size($inv));
def_int $withdraw = sub($amount, $overflow);
if ($withdraw > 0) {
    session_log(^log_moderator, "Withdrew <oc_debugname($obj)> x<tostring($withdraw)> from bank");
    switch_int (%bankcert) {
        case 0 : inv_moveitem_uncert(bank, $inv, $obj, $withdraw);
        case default : inv_moveitem_cert(bank, $inv, $obj, $withdraw);
    }
    // $slot has been a dead parameter since this proc was written; tabs give it a job. If the
    // withdrawal emptied the slot the list now has a hole in it, and a hole shifts every range
    // above it - so close it here and decrement whichever tab owned it.
    ~banktab_removed($slot);
    ~banktab_refresh;
}

[proc,bank_deposit_request](inv $inv, obj $obj, int $amount, int $slot)
def_int $overflow = inv_itemspace2(bank, oc_uncert($obj), $amount, ^max_32bit_int);
if (sub(^max_32bit_int, $amount) < inv_total(bank, $obj)) {
    mes("You already have a full stack of that item in the bank."); // 2024 osrs
} else if ($overflow >= $amount) {
    // https://youtu.be/2BgXLZD-xgo?t=28
    // https://youtu.be/Ep4gaI5ic1s?t=197
    mes("You don't have enough space in your bank account."); // osrs
    return;
}
def_int $deposit = sub($amount, $overflow);
if ($deposit > 0) {
    session_log(^log_moderator, "Deposited <oc_debugname($obj)> x<tostring($deposit)> into bank");
    // Occupied-slot count either side of the move tells us whether this landed in a NEW slot or
    // stacked onto one the player already had. There is no inv_findslot, and this works only
    // because the list is kept gapless: occupied slots are always 0..n-1, so a new one is n-1.
    def_int $before = sub(inv_size(bank), inv_freespace(bank));
    inv_moveitem_uncert($inv, bank, $obj, $deposit);
    def_int $after = sub(inv_size(bank), inv_freespace(bank));
    if ($after > $before) {
        ~banktab_deposited(sub($after, 1));
    } else {
        ~banktab_refresh;
    }
}

[proc,bank_check_nobreak](obj $obj)(boolean)
if (~bank_find_obj_unbankable($obj) = true) {
    mes("A magical force prevents you from banking this item!"); // osrs
    return(true);
}

// https://www.youtube.com/watch?v=W5iZgykts2A // No mes when creating boxes via actions
if ($obj = macro_cube) {
    ~try_add_macro_cube;
    return(true);
}

if (playermember = ^false) {
    // check for f2p bank limits, use the player's membership status rather than world type
    if ((inv_total(bank, oc_uncert($obj)) = 0) & (sub(inv_size(bank), inv_freespace(bank)) >= ^bank_free_slots)) {
        // https://youtu.be/yv-H5-IoRLs?t=9 (2006)
        // https://web.archive.org/web/20041126073829/http://img39.imageshack.us/img39/3412/firemaking.jpg (2004)
        mes("You need to subscribe for a members account if you want to");
        mes("store any more items in the bank.");
        return(true);
    }
}
return(false);

// returns if an obj is considered to be unbankable.
// experience lamps, quest items, etc.
[proc,bank_find_obj_unbankable](obj $obj)(boolean)
switch_obj ($obj) {
    case macro_genilamp : return(true); // cant bank xp lamps
    case hundred_rewardlamp : return(true); // Recipe for Disaster's antique lamp is one too
    case default : return(false);
}

[label,insert_bank](int $start_slot, int $target_slot)
def_int $src = $start_slot;
def_int $dst = $target_slot;

while ($src ! $dst) {
    if ($src > $dst) {
        inv_movetoslot(bank, bank, sub($src, 1), $src);
        $src = sub($src, 1);
    } else if ($src < $dst) {
        inv_movetoslot(bank, bank, add($src, 1), $src);
        $src = add($src, 1);
    }
}
