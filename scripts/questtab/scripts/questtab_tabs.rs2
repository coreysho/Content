// GENERATED by tools/genquesttab.py - do not hand-edit.
//
// The quest tab's button row: on every page, each of the other four buttons selects its page.
// The page's own button is not a button, so it has no trigger.

// Show a page's interface in the quest tab slot. ~questtab_show fills its texts first.
[proc,questtab_settab](int $page)
switch_int ($page) {
    case ^questtab_summary : if_settab(questtab_summary, ^tab_quest_journal);
    case ^questtab_quests : if_settab(questlist, ^tab_quest_journal);
    case ^questtab_collection : if_settab(questtab_collection, ^tab_quest_journal);
    case ^questtab_pstats : if_settab(questtab_pstats, ^tab_quest_journal);
    case ^questtab_sstats : if_settab(questtab_sstats, ^tab_quest_journal);
}

[if_button,questtab_summary:tab_quests] ~questtab_select(^questtab_quests);
[if_button,questtab_summary:tab_collection] ~questtab_select(^questtab_collection);
[if_button,questtab_summary:tab_pstats] ~questtab_select(^questtab_pstats);
[if_button,questtab_summary:tab_sstats] ~questtab_select(^questtab_sstats);

[if_button,questlist:tab_summary] ~questtab_select(^questtab_summary);
[if_button,questlist:tab_collection] ~questtab_select(^questtab_collection);
[if_button,questlist:tab_pstats] ~questtab_select(^questtab_pstats);
[if_button,questlist:tab_sstats] ~questtab_select(^questtab_sstats);

[if_button,questtab_collection:tab_summary] ~questtab_select(^questtab_summary);
[if_button,questtab_collection:tab_quests] ~questtab_select(^questtab_quests);
[if_button,questtab_collection:tab_pstats] ~questtab_select(^questtab_pstats);
[if_button,questtab_collection:tab_sstats] ~questtab_select(^questtab_sstats);

[if_button,questtab_pstats:tab_summary] ~questtab_select(^questtab_summary);
[if_button,questtab_pstats:tab_quests] ~questtab_select(^questtab_quests);
[if_button,questtab_pstats:tab_collection] ~questtab_select(^questtab_collection);
[if_button,questtab_pstats:tab_sstats] ~questtab_select(^questtab_sstats);

[if_button,questtab_sstats:tab_summary] ~questtab_select(^questtab_summary);
[if_button,questtab_sstats:tab_quests] ~questtab_select(^questtab_quests);
[if_button,questtab_sstats:tab_collection] ~questtab_select(^questtab_collection);
[if_button,questtab_sstats:tab_pstats] ~questtab_select(^questtab_pstats);
