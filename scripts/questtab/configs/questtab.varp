// THE QUEST TAB (questtab/scripts/questtab.rs2).

// Which of its five pages is showing (^questtab_* in questtab.constant). Temp, so every login opens
// on the Character Summary.
//
// All three are protect=no: they are display state, and ~send_quest_progress - which re-shows the
// page and recounts the quests - is called from plenty of scripts without protected access (the
// debug quest setters among them). Nothing is gained by refusing those a write.
[questtab_page]
protect=no

// How many quests the quest list shows, and how many of them are finished (green), counted by
// ~questlist_recolour as it colours the rows - at login and whenever a quest is completed - so the
// Character Summary can say "Quests Done" without walking every quest again each time it opens.
[questlist_total]
protect=no

[questlist_done]
protect=no
