[proc,combat_clearqueue]
clearqueue(playerhit_n_retaliate);
clearqueue(combat_damage_player);
clearqueue(pvp_damage);
clearqueue(damage_player);
clearqueue(pvp_retaliate);
clearqueue(recoil_damage);
clearqueue(vengeance_damage);
clearqueue(poison_damage);
// The arkan blade's burn is damage-over-time on a queue of its own, and a player keeps their queue
// through death - so without this, a burn landed just before a kill followed the player out of the
// fight and kept hitting them after they respawned.
~arkan_burn_clear;

[proc,.combat_clearqueue]
.clearqueue(playerhit_n_retaliate);
.clearqueue(combat_damage_player);
.clearqueue(pvp_damage);
.clearqueue(damage_player);
.clearqueue(pvp_retaliate);
.clearqueue(recoil_damage);
.clearqueue(vengeance_damage);
.clearqueue(poison_damage);
~.arkan_burn_clear;
