// The two screens 474 put behind the Worn Equipment tab's buttons.

// ---- EQUIPMENT STATS (equipment_stats.if). The bonuses that used to be on the tab itself, your
// worn items (Remove works on them as it does on the tab), what you carry, and you in it.
[if_button,wornitems:stats_button]
if (p_finduid(uid) = true) {
    if_openmain(equipment_stats);
    inv_transmit(worn, equipment_stats:worn);
    ~update_bonuses;
}

[inv_button1,equipment_stats:worn]
if (p_finduid(uid) = true) {
    p_clearpendingaction;
    ~unequip(last_slot);
}

// ---- ITEMS KEPT ON DEATH (items_kept.if). The same rules as player/scripts/death.rs2 - the three
// dearest things you have unless you are skulled, one more under Protect Item, nothing that is
// destroyed on death - worked out on copies of your inventory and equipment, so looking changes
// nothing.
[if_button,wornitems:kept_button]
if (p_finduid(uid) = true) {
    ~items_kept_open;
}

[proc,items_kept_open]
inv_clear(deathpreview_keep);
inv_clear(deathpreview_lose);
inv_copy(inv, deathpreview_lose);
inv_copy(worn, deathpreview_lose);

def_boolean $skulled = false;
if (%pk_skull > 0) {
    $skulled = true;
}
def_boolean $protecting = false;
if (%prayer8 = ^true) {
    $protecting = true;
}
def_int $keep = 3;
if ($skulled = true) {
    $keep = 0;
}
if ($protecting = true) {
    $keep = calc($keep + 1);
}
def_int $i = 0;
while ($i < $keep) {
    ~deathpreview_take_priciest;
    $i = calc($i + 1);
}
~deathpreview_compact;

if ($skulled = true) {
    if_settext(items_kept:keep_title, "Items you will keep on death (you are skulled):");
    if_settext(items_kept:lose_title, "Items you will lose on death (you are skulled):");
} else {
    if_settext(items_kept:keep_title, "Items you will keep on death if not skulled:");
    if_settext(items_kept:lose_title, "Items you will lose on death if not skulled:");
}
// this client does not wrap text, so the lines are broken here to fit the 149-pixel panel
def_string $info = "You keep the three items\\nyou are carrying or\\nwearing that are worth\\nthe most.";
if ($skulled = true) {
    $info = "You are skulled, so you\\nkeep nothing unless you\\nare praying.";
}
if ($protecting = true) {
    $info = append($info, "\\n\\nProtect Item is on, so\\nyou keep one more item.");
} else {
    $info = append($info, "\\n\\nThe Protect Item prayer\\nkeeps one more item.");
}
if_settext(items_kept:info, $info);
if_settext(items_kept:info2, "");
if_settext(items_kept:info3, "");
inv_transmit(deathpreview_keep, items_kept:kept);
inv_transmit(deathpreview_lose, items_kept:lost);
if_openmain(items_kept);

// death.rs2's ~move_priciest_item_on_hero_to_death, over the copy
[proc,deathpreview_take_priciest]
def_obj $priciest;
def_int $price = 0;
def_int $i = 0;
def_int $size = inv_size(deathpreview_lose);
while ($i < $size) {
    if (inv_getnum(deathpreview_lose, $i) > 0) {
        def_obj $obj = inv_getobj(deathpreview_lose, $i);
        if (oc_param($obj, destroy_death) ! ^true & oc_cost($obj) > $price) {
            $price = oc_cost($obj);
            $priciest = $obj;
        }
    }
    $i = calc($i + 1);
}
if ($priciest ! null) {
    inv_moveitem(deathpreview_lose, deathpreview_keep, $priciest, 1);
}

// taking the kept items out of the copy leaves holes where they were; close them up, so the lost
// items are drawn one after another rather than with gaps
[proc,deathpreview_compact]
def_int $size = inv_size(deathpreview_lose);
def_int $to = 0;
def_int $from = 0;
while ($from < $size) {
    if (inv_getnum(deathpreview_lose, $from) > 0) {
        if ($from ! $to) {
            inv_movetoslot(deathpreview_lose, deathpreview_lose, $from, $to);
        }
        $to = calc($to + 1);
    }
    $from = calc($from + 1);
}

[if_close,items_kept]
inv_stoptransmit(items_kept:kept);
inv_stoptransmit(items_kept:lost);
inv_clear(deathpreview_keep);
inv_clear(deathpreview_lose);
