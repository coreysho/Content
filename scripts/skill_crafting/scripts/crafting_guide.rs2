// Crafting skill guide, shown on the original RS2 skill guide interface
// (see content/scripts/interfaces/skill_guide.rs2 for the generic driver).
// Trimmed to 40 of the ~70 level-gated crafting entries this repo implements.
[proc,open_crafting_guide]
~skillguide_begin(^guide_crafting, "Crafting");
def_int $lvl = stat(crafting);
~skillguide_row(1, $lvl, 1, leather_gloves, "Leather gloves");
~skillguide_row(2, $lvl, 1, pot_empty, "Pot");
~skillguide_row(3, $lvl, 1, ball_of_wool, "Ball of wool");
~skillguide_row(4, $lvl, 1, opal, "Opal");
~skillguide_row(5, $lvl, 1, beer_glass, "Beer glass");
~skillguide_row(6, $lvl, 5, gold_ring, "Gold ring");
~skillguide_row(7, $lvl, 7, leather_boots, "Leather boots");
~skillguide_row(8, $lvl, 8, bowl_empty, "Bowl");
~skillguide_row(9, $lvl, 8, unstrung_gold_amulet, "Gold amulet");
~skillguide_row(10, $lvl, 9, leather_cowl, "Leather cowl");
~skillguide_row(11, $lvl, 10, bow_string, "Bow string");
~skillguide_row(12, $lvl, 11, leather_vambraces, "Leather vambraces");
~skillguide_row(13, $lvl, 12, oil_lamp_empty, "Oil lamp");
~skillguide_row(14, $lvl, 13, jade, "Jade");
~skillguide_row(15, $lvl, 14, leather_armour, "Leather body");
~skillguide_row(16, $lvl, 16, nostringstar, "Holy symbol");
~skillguide_row(17, $lvl, 17, nostringsnake, "Unholy symbol");
~skillguide_row(18, $lvl, 18, leather_chaps, "Leather chaps");
~skillguide_row(19, $lvl, 18, silver_sickle, "Silver sickle");
~skillguide_row(20, $lvl, 20, sapphire, "Sapphire");
~skillguide_row(21, $lvl, 20, sapphire_ring, "Sapphire ring");
~skillguide_row(22, $lvl, 25, potlid, "Pot lid");
~skillguide_row(23, $lvl, 27, emerald, "Emerald");
~skillguide_row(24, $lvl, 27, emerald_ring, "Emerald ring");
~skillguide_row(25, $lvl, 28, hardleather_body, "Hardleather body");
~skillguide_row(26, $lvl, 33, vial_empty, "Vial");
~skillguide_row(27, $lvl, 34, ruby, "Ruby");
~skillguide_row(28, $lvl, 34, ruby_ring, "Ruby ring");
~skillguide_row(29, $lvl, 38, coif, "Coif");
~skillguide_row(30, $lvl, 41, studded_body, "Studded body");
~skillguide_row(31, $lvl, 43, diamond, "Diamond");
~skillguide_row(32, $lvl, 43, diamond_ring, "Diamond ring");
~skillguide_row(33, $lvl, 44, studded_chaps, "Studded chaps");
~skillguide_row(34, $lvl, 49, bullseye_lantern_lens, "Lantern lens");
~skillguide_row(35, $lvl, 55, dragonstone, "Dragonstone");
~skillguide_row(36, $lvl, 57, dragon_vambraces, "Green d'hide vamb");
~skillguide_row(37, $lvl, 60, dragonhide_chaps, "Green d'hide chaps");
~skillguide_row(38, $lvl, 63, dragonhide_body, "Green d'hide body");
~skillguide_row(39, $lvl, 67, onyx, "Onyx");
~skillguide_row(40, $lvl, 71, blue_dragonhide_body, "Blue d'hide body");
~skillguide_show;
