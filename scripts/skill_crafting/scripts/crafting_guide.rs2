// Crafting skill guide. Four category buttons - the repo implements around 90
// level-gated crafting entries, well past the interface's 40-row list.
[proc,open_crafting_guide]
%skillguide_page = 2;
~crafting_guide_render;

[proc,crafting_guide_render]
~skillguide_begin(^guide_crafting, "Crafting");
~skillguide_panels(4);
~skillguide_button(2, "Leather");
~skillguide_button(3, "D'hide");
~skillguide_button(4, "Jewellery");
~skillguide_button(5, "Other");
def_int $lvl = stat(crafting);
switch_int (%skillguide_page) {
    case 3 : ~crafting_guide_dhide($lvl);
    case 4 : ~crafting_guide_jewellery($lvl);
    case 5 : ~crafting_guide_other($lvl);
    case default : ~crafting_guide_leather($lvl);
}
~skillguide_show;

[proc,crafting_guide_leather](int $lvl)
~skillguide_row(1, $lvl, 1, leather_gloves, "Leather gloves");
~skillguide_row(2, $lvl, 7, leather_boots, "Leather boots");
~skillguide_row(3, $lvl, 9, leather_cowl, "Leather cowl");
~skillguide_row(4, $lvl, 11, leather_vambraces, "Leather vambraces");
~skillguide_row(5, $lvl, 14, leather_armour, "Leather body");
~skillguide_row(6, $lvl, 18, leather_chaps, "Leather chaps");
~skillguide_row(7, $lvl, 28, hardleather_body, "Hardleather body");
~skillguide_row(8, $lvl, 38, coif, "Coif");
~skillguide_row(9, $lvl, 41, studded_body, "Studded body");
~skillguide_row(10, $lvl, 44, studded_chaps, "Studded chaps");

