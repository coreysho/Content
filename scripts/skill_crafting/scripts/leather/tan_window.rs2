// The tanner's window.
// 
// GENERATED by tools/genwindows.py. Edit tools/adoptspec.json, not this file.
// 
// ELLIS HAS ADVERTISED Trade SINCE THE FORK BEGAN and nothing answered opnpc3 on him. The
// Canifis tanner's Trade option does work - it jumps straight to the chat cascade - so the
// two tanners have disagreed about whether their own right-click menu does anything.
// 
// The panel is generic: eight cells, each with a placeholder "Hide" and "Cost" label the
// server overwrites. Six hides are tannable in this build; the two snake hides have no obj
// in pack/obj.pack, so their cells are hidden rather than drawn dead.
// 
// The costs come from tanner.constant, and WHICH SET depends on the npc - Canifis charges
// 2/5/45 against Al Kharid's 1/3/20 - so the Cost line is filled per tanner, not per hide.
// Overwriting a LABEL and never a number: neither of those two texts carries a %1.

[opnpc3,ellis_tanner]
~tan_window_open;

// ASK WHICH TANNER HERE, NOT IN A BUTTON. npc_type needs the active_npc pointer. An
// [opnpc3,...] trigger has it; an [if_button,...] trigger does not, and the build says
// so on all 32 buttons at once. So the question is asked once, while the npc is still
// in scope, and the answer lives in %tan_window_canifis until the window closes.
[proc,tan_window_open]
def_int $cost;
%tan_window_canifis = false;
if (npc_type = werewolftanner) {
    %tan_window_canifis = true;
}
if_sethide(tan_window:cell1, false);
if_setobject(tan_window:hide1, cow_hide, ^tan_window_scale);
if_settext(tan_window:name1, "Soft leather");
$cost = ~tan_window_cost(^tanner_soft_leather_cost, ^werewolftanner_soft_leather_cost);
// ~pluralise so a soft leather reads "1 coin" and not "1 coins".
if_settext(tan_window:cost1, "<~pluralise($cost, "coin")>");
if_sethide(tan_window:cell2, false);
if_setobject(tan_window:hide2, cow_hide, ^tan_window_scale);
if_settext(tan_window:name2, "Hard leather");
$cost = ~tan_window_cost(^tanner_hard_leather_cost, ^werewolftanner_hard_leather_cost);
// ~pluralise so a soft leather reads "1 coin" and not "1 coins".
if_settext(tan_window:cost2, "<~pluralise($cost, "coin")>");
if_sethide(tan_window:cell3, false);
if_setobject(tan_window:hide3, dragonhide_green, ^tan_window_scale);
if_settext(tan_window:name3, "Green d'hide");
$cost = ~tan_window_cost(^tanner_dragonhide_cost, ^werewolftanner_dragonhide_cost);
// ~pluralise so a soft leather reads "1 coin" and not "1 coins".
if_settext(tan_window:cost3, "<~pluralise($cost, "coin")>");
if_sethide(tan_window:cell4, false);
if_setobject(tan_window:hide4, dragonhide_blue, ^tan_window_scale);
if_settext(tan_window:name4, "Blue d'hide");
$cost = ~tan_window_cost(^tanner_dragonhide_cost, ^werewolftanner_dragonhide_cost);
// ~pluralise so a soft leather reads "1 coin" and not "1 coins".
if_settext(tan_window:cost4, "<~pluralise($cost, "coin")>");
if_sethide(tan_window:cell5, false);
if_setobject(tan_window:hide5, dragonhide_red, ^tan_window_scale);
if_settext(tan_window:name5, "Red d'hide");
$cost = ~tan_window_cost(^tanner_dragonhide_cost, ^werewolftanner_dragonhide_cost);
// ~pluralise so a soft leather reads "1 coin" and not "1 coins".
if_settext(tan_window:cost5, "<~pluralise($cost, "coin")>");
if_sethide(tan_window:cell6, false);
if_setobject(tan_window:hide6, dragonhide_black, ^tan_window_scale);
if_settext(tan_window:name6, "Black d'hide");
$cost = ~tan_window_cost(^tanner_dragonhide_cost, ^werewolftanner_dragonhide_cost);
// ~pluralise so a soft leather reads "1 coin" and not "1 coins".
if_settext(tan_window:cost6, "<~pluralise($cost, "coin")>");
// no obj in this build for the snake hides - the cell is hidden, not left dead
if_sethide(tan_window:cell7, true);
// no obj in this build for the snake hides - the cell is hidden, not left dead
if_sethide(tan_window:cell8, true);
if_openmain(tan_window);

// Which tanner's prices. Canifis is not a markup on Al Kharid - it is 2/5/45 against
// 1/3/20 - so both constants are read and the tanner that opened the window picks.
// This reads the varp and NOT npc_type, because the buttons reach it with no npc.
[proc,tan_window_cost](int $al_kharid, int $canifis)(int)
if (%tan_window_canifis = true) {
    return($canifis);
}
return($al_kharid);

[if_button,tan_window:tan_all_1]
if (p_finduid(uid) = true) {
    @tan_window_go(cow_hide, leather, ^tanner_soft_leather_cost, ^werewolftanner_soft_leather_cost, ^max_32bit_int);
}

