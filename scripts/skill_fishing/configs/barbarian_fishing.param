// Barbarian Fishing's extra requirements and experience, per leaping fish (on its fishing_struct).
// Every catch also needs these Agility and Strength levels and pays this in each of the two - the
// wiki's table: trout 15/15 and 5 each, salmon 30/30 and 6, sturgeon 45/45 and 7.
[barbfish_fishing_level]
type=int
default=0

[barbfish_agil_str_level]
type=int
default=0

[barbfish_agil_str_exp]
type=int
default=0
