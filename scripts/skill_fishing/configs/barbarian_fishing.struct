// The three leaping fish, read by ~barbfish_roll (scripts/barbarian_fishing.rs2). success_low/high are
// the wiki's Skilling success chart for the barbarian rod (sturgeon 8/64, salmon 16/96, trout
// 32/192, rolled in that order - "cascade"); experience is in tenths like every other fishing_struct.
// fishing_pet_base is the Heron's figure for Barbarian Fishing (OSRS wiki, Heron: 1,280,862).
[fishing_struct_leaping_trout]
param=productexp,500
param=productmessage,You catch a leaping trout.
param=success_low,32
param=success_high,192
param=fishing_pet_base,1280862
param=barbfish_fishing_level,48
param=barbfish_agil_str_level,15
param=barbfish_agil_str_exp,50

[fishing_struct_leaping_salmon]
param=productexp,700
param=productmessage,You catch a leaping salmon.
param=success_low,16
param=success_high,96
param=fishing_pet_base,1280862
param=barbfish_fishing_level,58
param=barbfish_agil_str_level,30
param=barbfish_agil_str_exp,60

[fishing_struct_leaping_sturgeon]
param=productexp,800
param=productmessage,You catch a leaping sturgeon.
param=success_low,8
param=success_high,64
param=fishing_pet_base,1280862
param=barbfish_fishing_level,70
param=barbfish_agil_str_level,45
param=barbfish_agil_str_exp,70
