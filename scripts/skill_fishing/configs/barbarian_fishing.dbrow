// The eggs from gutting leaping fish (scripts/barbarian_gutting.rs2) can be eaten: "Roe can also be
// eaten to restore 3 hitpoints", caviar "can also be eaten on its own to heal 5 Hitpoints" (wiki).
[heal_roe]
table=consume_table
data=consumable,roe
data=stat_heal,hitpoints,3,0
data=consume_sound,eat

[heal_caviar]
table=consume_table
data=consumable,caviar
data=stat_heal,hitpoints,5,0
data=consume_sound,eat
