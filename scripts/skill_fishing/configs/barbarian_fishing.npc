// The leaping-fish spots in the lake at Otto's Grotto (474 npc 2722: "Use-rod", and a hidden op4 the
// catch loop re-arms itself on, as every other spot does). The same ripples as the river spots.
// category drives the move timer in fishing_movement.rs2 and keeps two spots off one tile. The river
// spots' configs carry no timer=, so their ai_timer never fires and they never move; these do, as
// they do in OSRS: the first move comes after timer= ticks, and @move_fishing_spot then sets the
// next one itself (280-529 ticks).
[barbarian_fishing_spot]
name=Fishing spot
desc=I can see fish swimming in the water.
model1=compofishspot_8
vislevel=hide
readyanim=fishingspot_ready
walkanim=fishingspot_walk
minimap=no
op1=Use-rod
op4=hidden
moverestrict=nomove
category=barbfish
timer=280
param=fishing_movement_enum,fishing_movement_ottos_grotto_enum
