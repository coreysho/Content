// The Heron's base chance for this fish - B in 1 in (B - level*25), the OSRS wiki's own figure.
// Zero is ^skillpet_no_roll and so means "this fish gives no pet", which is the direction a
// missing entry should fall in: a lava eel, a manta ray and a sea turtle give none in OSRS either.
[fishing_pet_base]
type=int
default=0
