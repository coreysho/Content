// Barbarian Fishing (Barbarian Training, 3 July 2007) - the rod from under Otto's bed, the three
// leaping fish, and what a knife gets out of them. Imported from the rev 474 cache by
// tools/models/import474.py (models copied byte-for-byte); names, examines, weights and noteability
// are the OSRS wiki's, costs are 474's own (the 2007 values - OSRS cut the fish to 2/3/4 in 2017).

// "A heavier version of the fishing rod" - it is only a rod, never wielded, so its manwear model only
// shows if a seq ever holds it. Fishing with it looked like fishing with a plain rod until OSRS gave it
// its own art in 2022 (wiki, Barbarian rod: Changes), so skill_fishing's seqs are used as they are.
[barbarian_rod]
name=Barbarian rod
desc=A heavy barbarian Fishing rod.
model=obj_barbarian_rod
manwear=obj_barbarian_rod_manwear,0
womanwear=obj_barbarian_rod_manwear,6
2dxof=-8
2dyof=7
2dzoom=1308
2dxan=622
2dyan=207
cost=1
weight=1360g
members=yes
tradeable=no

// Roe and caviar heal 3 and 5 (wiki); scripts/barbarian_fishing.rs2 eats them, the dbrows are in
// barbarian_fishing.dbrow. Both are also bait for the leaping fish, used last.
[roe]
name=Roe
desc=Roe, or cheap fishy eggs.
model=obj_roe
2dxof=1
2dyof=15
2dzoom=530
2dxan=318
2dyan=2024
iop1=Eat
cost=20
weight=50g
members=yes

[cert_roe]
certlink=roe
certtemplate=template_for_cert

// 474 keeps one model for both kinds of eggs and recolours it dark for caviar.
[caviar]
name=Caviar
desc=Caviar, or expensive fishy eggs.
model=obj_roe
2dxof=1
2dyof=15
2dzoom=530
2dxan=318
2dyan=2024
recol1s=25231
recol1d=19026
recol2s=23017
recol2d=14765
recol3s=26048
recol3d=5251
recol4s=16641
recol4d=3137
recol5s=14528
recol5d=2080
iop1=Eat
cost=50
weight=50g
members=yes

[cert_caviar]
certlink=caviar
certtemplate=template_for_cert

// Leaping fish cannot be cooked, only gutted with a knife (wiki, Leaping trout); they carry
// fishing_struct like every other catch so the rod's roll reads the same params.
[leaping_trout]
name=Leaping trout
desc=A sad-looking trout.
model=obj_leaping_trout
2dxof=-1
2dyof=1
2dzoom=1308
2dxan=500
2dyan=1881
cost=25
weight=500g
members=yes
param=fishing_struct,fishing_struct_leaping_trout

[cert_leaping_trout]
certlink=leaping_trout
certtemplate=template_for_cert

[leaping_salmon]
name=Leaping salmon
desc=Some non-tasty salmon.
model=obj_leaping_salmon
2dxof=-5
2dzoom=1762
2dxan=500
2dyan=1978
cost=50
weight=500g
members=yes
param=fishing_struct,fishing_struct_leaping_salmon

[cert_leaping_salmon]
certlink=leaping_salmon
certtemplate=template_for_cert

[leaping_sturgeon]
name=Leaping sturgeon
desc=A bloated sturgeon.
model=obj_leaping_sturgeon
2dxof=-4
2dyof=3
2dzoom=1568
2dxan=600
2dyan=1560
cost=75
weight=1kg
members=yes
param=fishing_struct,fishing_struct_leaping_sturgeon

[cert_leaping_sturgeon]
certlink=leaping_sturgeon
certtemplate=template_for_cert

// "Slices of inedible fish" - bait, stackable, and the bait a barbarian rod reaches for first.
[fish_offcuts]
name=Fish offcuts
desc=Slices of inedible fish.
model=obj_fish_offcuts
2dxof=7
2dyof=-16
2dzoom=984
2dxan=111
2dyan=1770
2dzan=124
cost=1
members=yes
stackable=yes
