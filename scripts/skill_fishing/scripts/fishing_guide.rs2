// Fishing skill guide, shown on the original RS2 skill guide interface
// (see content/scripts/interfaces/skill_guide.rs2 for the generic driver).
// Sea turtle and manta ray come from the Fishing Trawler, not from a spot.
[proc,open_fishing_guide]
~skillguide_begin(^guide_fishing, "Fishing");
def_int $lvl = stat(fishing);
~skillguide_row(1, $lvl, 1, net, "Small fishing net");
~skillguide_row(2, $lvl, 1, fishing_rod, "Fishing rod");
~skillguide_row(3, $lvl, 1, fishing_bait, "Fishing bait");
~skillguide_row(4, $lvl, 1, fly_fishing_rod, "Fly fishing rod");
~skillguide_row(5, $lvl, 1, feather, "Feather");
~skillguide_row(6, $lvl, 1, big_net, "Big fishing net");
~skillguide_row(7, $lvl, 1, harpoon, "Harpoon");
~skillguide_row(8, $lvl, 1, lobster_pot, "Lobster pot");
~skillguide_row(9, $lvl, 1, oily_fishing_rod, "Oily fishing rod");
~skillguide_row(10, $lvl, 1, raw_shrimp, "Raw shrimps");
~skillguide_row(11, $lvl, 5, raw_sardine, "Raw sardine");
~skillguide_row(12, $lvl, 10, raw_herring, "Raw herring");
~skillguide_row(13, $lvl, 15, raw_anchovies, "Raw anchovies");
~skillguide_row(14, $lvl, 16, raw_mackerel, "Raw mackerel");
~skillguide_row(15, $lvl, 16, oystershell, "Oyster");
~skillguide_row(16, $lvl, 16, casket, "Casket");
~skillguide_row(17, $lvl, 20, raw_trout, "Raw trout");
~skillguide_row(18, $lvl, 23, raw_cod, "Raw cod");
~skillguide_row(19, $lvl, 25, raw_pike, "Raw pike");
~skillguide_row(20, $lvl, 30, raw_salmon, "Raw salmon");
~skillguide_row(21, $lvl, 35, raw_tuna, "Raw tuna");
~skillguide_row(22, $lvl, 40, raw_lobster, "Raw lobster");
~skillguide_row(23, $lvl, 46, raw_bass, "Raw bass");
~skillguide_row(24, $lvl, 50, raw_swordfish, "Raw swordfish");
~skillguide_row(25, $lvl, 53, raw_lava_eel, "Raw lava eel");
~skillguide_row(26, $lvl, 76, raw_shark, "Raw shark");
~skillguide_row(27, $lvl, 79, raw_seaturtle, "Raw sea turtle");
~skillguide_row(28, $lvl, 81, raw_mantaray, "Raw manta ray");
~skillguide_show;
