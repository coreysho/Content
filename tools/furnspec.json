 "shape_allowances": [
  {
   "family": "chair",
   "hotspot": 15214,
   "why": "The parlour has three Chair spaces and two of them are centrepiece_diagonal while the third is centrepiece_straight. A family carries one shape, and storing a second would change the packed record every save already holds. Both shapes are LocLayer.GROUND (engine routefinder/flags.ts), so loc_add still REPLACES the hotspot rather than standing beside it - the only difference is that the chair in those two corners renders square to the room instead of at 45 degrees."
  },
  {
   "family": "chair",
   "hotspot": 15215,
   "why": "As 15214."
  }
 ],
 "labels": {
  "_": "Per-loc label overrides. Two reasons a loc is on this list: a cache name that does not fit the Furniture creation window's 126px name column, and a cache name that is not the thing's real name - all seven lecterns come out of the 474 import called just 'Lectern', when they are the oak / eagle / demon / teak / mahogany ladder OSRS names and the models plainly show it. The two mahogany ones lose the word 'lectern' because the full name is 135px; genfurn.py measures every label in the client's own font and refuses to emit one that overflows, which is why this list is short and exact.",
  "poh_armour_castlewars_red_6": "Red Castlewars",
